  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/puppeteer": "^1.3.0",
    "@cloudflare/vitest-pool-workers": "^0.5.33",
    "@cloudflare/workers-types": "^4.20241205.0",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.149.0"
  },
  "pnpm": {
