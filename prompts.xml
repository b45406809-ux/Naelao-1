7:     if ScanForInjectionPatterns(c.text) == SAFE then
8:         FilteredChunks.append(EscapeXMLTags(c.text))
9:     else
10:        FilteredChunks.append(MaskInjectionPayload(c.text))
11:    end if
12: end for
13: K_safe ← ConcatenateBoundaryEnvelopes(FilteredChunks)
14: return K_safe
```
