{
  "id": "ext_trading_mentor_student_helper",
  "type": "extension",
  "declaredPermissions": [],
  "capabilityRequirements": ["extension.project_canvas", "extension.workflow", "channel.invoke"],
  "gadgets": [],
  "daemons": [],
  "commands": [],
  "bundle": {
    "schemaVersion": "1.0",
    "kind": "extension_bundle",
    "id": "ext_trading_mentor_student_helper",
    "version": "1.1.0",
    "primitives": [
      {
        "schemaVersion": "1.0", "kind": "canvas", "id": "mentor_console", "version": "1.1.0",
        "permissions": [], "capabilityRequirements": [], "lifecycle": {}, "layout": "CanvasMount",
        "component": "./console.html", "dynamicPage": false
      },
      {
        "schemaVersion": "1.0", "kind": "gadget", "id": "trade_journal", "version": "1.1.0",
        "permissions": [], "capabilityRequirements": [], "lifecycle": {}, "scope": "PROJECT_BOUND",
        "schemaSql": "CREATE TABLE IF NOT EXISTS trade_journal (id TEXT PRIMARY KEY, created_at TEXT NOT NULL, symbol TEXT NOT NULL, side TEXT NOT NULL, quantity REAL NOT NULL, status TEXT NOT NULL, workflow_run_id TEXT NOT NULL)"
      },
      {
        "schemaVersion": "1.0", "kind": "channel", "id": "student_whatsapp", "version": "1.1.0",
        "permissions": [], "capabilityRequirements": [], "lifecycle": {}, "provider": "whatsapp",
        "connectionId": "student_whatsapp_connection", "handlerScript": "./student-answer.ts", "context": "channel_only",
        "inboundEvents": ["message.received"], "outboundEvents": ["message.reply"],
        "knowledgeCollections": ["course_material"], "session": { "enabled": true, "maxBytes": 1024, "ttlDays": 30 }
      },
      {
        "schemaVersion": "1.0", "kind": "workflow", "id": "place_order", "version": "1.1.0",
        "permissions": [], "capabilityRequirements": [], "lifecycle": {}, "executionMode": "headless",
        "entry": "./place-order.ts", "steps": [], "toolNames": ["orders.place"]
      }
    ],
    "workerRoles": [
      { "id": "order_worker", "principal": "project_member", "invocation": "workflow_step", "execution": "worker", "entry": "./place-order.ts", "primitiveIds": ["place_order"] }
    ],
    "connections": [
      { "id": "student_whatsapp_connection", "provider": "whatsapp", "purpose": "Receive student questions and send grounded replies", "required": true }
    ],
    "knowledge": [
      { "id": "course_material", "purpose": "Answer questions from material the mentor explicitly published", "access": "owner_published_external" }
    ]
  }
}
