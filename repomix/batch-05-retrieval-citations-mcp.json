{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 5000000
  },
  "output": {
    "filePath": ".repomix-cache/batch-05-retrieval-citations-mcp.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "topFilesLength": 40,
    "instructionFilePath": ".repomix-cache/authority-batch-5.md"
  },
  "include": [
    "package.json",
    "pnpm-workspace.yaml",
    "turbo.json",
    "vitest.workspace.ts",
    "biome.json",
    "tsconfig*.json",
    ".github/workflows/**",
    "infra/migrations/**",
    "infra/terraform/**",
    "docs/requirements-trace-matrix.md",
    "docs/DEPLOYMENT_SECRETS.md",
    "docs/DEPLOY_SECRETS.md",
    "docs/staging-smoke-test.md",
    "packages/types/**",
    "packages/config/**",
    "packages/db/**",
    "packages/http/**",
    "packages/auth/**",
    "packages/crypto/**",
    "packages/security/**",
    "packages/testing/**",
    "packages/tracing/**",
    "packages/events/**",
    "workers/router/**",
    "workers/knowledge/**",
    "workers/mcp-hub/**",
    "workers/credentials/**",
    "workers/search/**",
    "workers/spaces/src/do/SpaceDO.ts",
    "workers/spaces/src/index.ts",
    "workers/agents/src/script-engine/prebuilt/knowledge-base.ts",
    "workers/agents/src/script-engine/prebuilt/web-search.ts",
    "workers/agents/src/do/NaelaoAgentDO.ts",
    "packages/rag/**",
    "packages/agent-sdk/src/avos-features.ts",
    "packages/llm-gateway/**",
    "apps/shell/src/components/Chat.tsx",
    "apps/shell/src/components/Markdown.tsx",
    "apps/shell/src/components/**/*Citation*",
    "apps/shell/src/lib/api.ts",
    "apps/shell/package.json",
    "tests/**/*knowledge*",
    "tests/**/*kb-*",
    "tests/**/*rag*",
    "tests/**/*grounded*",
    "tests/**/*citation*",
    "tests/**/*mcp*",
    "tests/**/*composio*",
    "tests/**/*pipedream*"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.next/**",
      "**/.wrangler/**",
      "**/dist/**",
      "**/coverage/**",
      "**/*.tsbuildinfo",
      "**/*.map",
      "**/.env*",
      "**/.dev.vars*",
      "**/*.local",
      "pnpm-lock.yaml",
      "naelao_expanded_gaps_resolved.html",
      "naelao_whop_businesses_spec.html",
      "_BUILD_PLAN/**",
      ".repomix-cache/**",
      "repomix-output*",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.woff",
      "**/*.woff2",
      "**/*.pdf"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
