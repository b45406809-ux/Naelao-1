{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 5000000
  },
  "output": {
    "filePath": "repomix/outputs/batch-03-connectors-delegation.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "topFilesLength": 40,
    "instructionFilePath": "repomix/prompts/batch-03-items-25-38.md"
  },
  "include": [
    "package.json",
    "pnpm-workspace.yaml",
    "turbo.json",
    "vitest.workspace.ts",
    "biome.json",
    "tsconfig*.json",
    ".github/workflows/**",
    "infra/migrations/**",
    "infra/terraform/**",
    "docs/requirements-trace-matrix.md",
    "docs/DEPLOYMENT_SECRETS.md",
    "docs/DEPLOY_SECRETS.md",
    "docs/staging-smoke-test.md",
    "packages/types/**",
    "packages/config/**",
    "packages/db/**",
    "packages/http/**",
    "packages/auth/**",
    "packages/crypto/**",
    "packages/security/**",
    "packages/testing/**",
    "packages/tracing/**",
    "packages/events/**",
    "workers/router/**",
    "workers/credentials/**",
    "workers/security-gateway/**",
    "workers/mcp-hub/**",
    "workers/spaces/src/do/SpaceDO.ts",
    "workers/spaces/src/index.ts",
    "packages/tool-runtime/**",
    "packages/agent-sdk/**",
    "packages/llm-gateway/**",
    "packages/moderation/**",
    "packages/idempotency/**",
    "tests/**/*credential*",
    "tests/**/*connector*",
    "tests/**/*capabilit*",
    "tests/**/*delegat*",
    "tests/**/*security*",
    "tests/**/*role*",
    "tests/**/*skill*",
    "workers/agents/src/index.ts",
    "workers/agents/src/connectors/**",
    "workers/agents/src/launchpad/channels.ts",
    "workers/agents/src/script-engine/tool-surface.ts",
    "workers/agents/src/script-engine/assistant-access.ts",
    "workers/agents/src/script-engine/prebuilt/connectors.ts",
    "workers/agents/src/do/NaelaoAgentDO.ts",
    "workers/connector-gumroad/**",
    "workers/connector-whop/**",
    "workers/assistant/**",
    "workers/agents/src/do/ConcurrencyDO.ts",
    "workers/agents/src/script-engine/prebuilt/sub-agent.ts",
    "workers/agents/src/workflows/**",
    "apps/shell/src/app/p/[slug]/(shell)/connectors/**",
    "apps/shell/src/lib/connectorActions.ts"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.next/**",
      "**/.wrangler/**",
      "**/dist/**",
      "**/coverage/**",
      "**/*.tsbuildinfo",
      "**/*.map",
      "**/.env*",
      "**/.dev.vars*",
      "**/*.local",
      "pnpm-lock.yaml",
      "naelao_expanded_gaps_resolved.html",
      "naelao_whop_businesses_spec.html",
      "_BUILD_PLAN/**",
      ".repomix-cache/**",
      "repomix-output*",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.woff",
      "**/*.woff2",
      "**/*.pdf"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
