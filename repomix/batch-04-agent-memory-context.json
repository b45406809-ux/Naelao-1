{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 5000000
  },
  "output": {
    "filePath": "repomix/outputs/batch-04-agent-memory-context.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "topFilesLength": 40,
    "instructionFilePath": "repomix/prompts/batch-04-items-39-46.md"
  },
  "include": [
    "package.json",
    "pnpm-workspace.yaml",
    "turbo.json",
    "vitest.workspace.ts",
    "biome.json",
    "tsconfig*.json",
    "infra/migrations/**",
    "docs/requirements-trace-matrix.md",
    "packages/types/**",
    "packages/config/**",
    "packages/db/**",
    "packages/http/**",
    "packages/auth/**",
    "packages/crypto/**",
    "packages/security/**",
    "packages/testing/**",
    "packages/tracing/**",
    "packages/events/**",
    "workers/router/**",
    "workers/spaces/src/do/SpaceDO.ts",
    "workers/spaces/src/index.ts",
    "packages/agent-sdk/**",
    "packages/tool-runtime/**",
    "packages/rag/**",
    "packages/llm-gateway/**",
    "packages/moderation/**",
    "tests/**/*memory*",
    "tests/**/*compact*",
    "workers/agents/src/index.ts",
    "workers/agents/src/do/NaelaoAgentDO.ts",
    "workers/agents/src/script-engine/**",
    "workers/agents/src/workflows/**",
    "workers/agents/src/shared/**",
    "workers/agents/src/env.ts",
    "workers/agents/wrangler.toml",
    "workers/agents/package.json",
    "workers/assistant/**",
    "workers/mini-agi/**",
    "workers/workflows/**",
    "workers/agents/src/do/TaskDO.ts",
    "workers/agents/src/do/ConcurrencyDO.ts",
    "workers/agents/src/script-engine/prebuilt/**",
    "workers/agents/src/script-engine/sub-agent-output.ts",
    "packages/billing-core/**",
    "apps/shell/src/components/AssistantDelegationCard.tsx"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.next/**",
      "**/.wrangler/**",
      "**/dist/**",
      "**/coverage/**",
      "**/*.tsbuildinfo",
      "**/*.map",
      "**/.env*",
      "**/.dev.vars*",
      "**/*.local",
      "pnpm-lock.yaml",
      "naelao_expanded_gaps_resolved.html",
      "naelao_whop_businesses_spec.html",
      "_BUILD_PLAN/**",
      ".repomix-cache/**",
      "repomix-output*",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.woff",
      "**/*.woff2",
      "**/*.pdf"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
