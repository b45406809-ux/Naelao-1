{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 5000000
  },
  "output": {
    "filePath": "repomix/outputs/batch-12-billing-export.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "topFilesLength": 40,
    "instructionFilePath": "repomix/prompts/batch-12-items-112-119.md"
  },
  "include": [
    "package.json",
    "pnpm-workspace.yaml",
    "turbo.json",
    "vitest.workspace.ts",
    "biome.json",
    "tsconfig*.json",
    ".github/workflows/**",
    "infra/migrations/**",
    "infra/terraform/**",
    "docs/requirements-trace-matrix.md",
    "docs/DEPLOYMENT_SECRETS.md",
    "docs/DEPLOY_SECRETS.md",
    "docs/staging-smoke-test.md",
    "packages/types/**",
    "packages/config/**",
    "packages/db/**",
    "packages/http/**",
    "packages/auth/**",
    "packages/crypto/**",
    "packages/security/**",
    "packages/testing/**",
    "packages/tracing/**",
    "packages/events/**",
    "workers/router/**",
    "workers/billing/**",
    "workers/provisioner/**",
    "workers/eval/**",
    "workers/admin/**",
    "packages/billing-core/**",
    "packages/entitlements/**",
    "packages/idempotency/**",
    "packages/webhooks/**",
    "packages/agent-sdk/**",
    "apps/shell/src/app/p/[slug]/(shell)/settings/**",
    "apps/shell/src/app/p/[slug]/(shell)/analytics/**",
    "apps/shell/src/lib/api.ts",
    "tests/**/*billing*",
    "tests/**/*credit*",
    "tests/**/*quota*",
    "tests/**/*wallet*",
    "tests/**/*commerce*",
    "tests/**/*export*",
    "tests/**/*blueprint*",
    "tests/**/*subscription*",
    "tests/**/*checkout*",
    "workers/agents/src/index.ts",
    "workers/agents/src/script-engine/prebuilt/wallet.ts",
    "workers/agents/src/script-engine/prebuilt/commerce.ts",
    "workers/agents/src/script-engine/prebuilt/workspace-admin.ts",
    "workers/agents/src/env.ts",
    "workers/agents/wrangler.toml",
    "workers/spaces/src/index.ts",
    "workers/spaces/src/do/SpaceDO.ts",
    "workers/spaces/src/builder-routes.ts",
    "workers/spaces/src/business-routes.ts",
    "workers/spaces/wrangler.toml",
    "apps/dashboard/src/app/**/billing/**",
    "apps/dashboard/src/lib/**",
    "apps/dashboard/package.json",
    "workers/agents/src/do/TaskDO.ts",
    "workers/agents/src/script-engine/prebuilt/sub-agent.ts",
    "workers/agents/src/workflows/**"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.next/**",
      "**/.wrangler/**",
      "**/dist/**",
      "**/coverage/**",
      "**/*.tsbuildinfo",
      "**/*.map",
      "**/.env*",
      "**/.dev.vars*",
      "**/*.local",
      "pnpm-lock.yaml",
      "naelao_expanded_gaps_resolved.html",
      "naelao_whop_businesses_spec.html",
      "_BUILD_PLAN/**",
      ".repomix-cache/**",
      "repomix-output*",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.woff",
      "**/*.woff2",
      "**/*.pdf"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
