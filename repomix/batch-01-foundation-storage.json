{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 5000000
  },
  "output": {
    "filePath": ".repomix-cache/batch-01-foundation-storage.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "topFilesLength": 40,
    "instructionFilePath": ".repomix-cache/authority-batch-1.md"
  },
  "include": [
    "package.json",
    "pnpm-workspace.yaml",
    "turbo.json",
    "vitest.workspace.ts",
    "biome.json",
    "tsconfig*.json",
    ".github/workflows/**",
    "infra/migrations/**",
    "infra/terraform/**",
    "docs/requirements-trace-matrix.md",
    "docs/DEPLOYMENT_SECRETS.md",
    "docs/DEPLOY_SECRETS.md",
    "docs/staging-smoke-test.md",
    "packages/types/**",
    "packages/config/**",
    "packages/db/**",
    "packages/http/**",
    "packages/auth/**",
    "packages/crypto/**",
    "packages/security/**",
    "packages/testing/**",
    "packages/tracing/**",
    "packages/events/**",
    "workers/router/**",
    "workers/spaces/**",
    "workers/artifact/**",
    "workers/browser/**",
    "workers/agents/container/**",
    "workers/agents/src/do/ToolSandboxDO.ts",
    "workers/agents/src/script-engine/code-runner.ts",
    "workers/agents/src/script-engine/state-coordinator.ts",
    "packages/tool-runtime/**",
    "packages/agent-sdk/src/launchpad-runtime.ts",
    "tests/**/*space*",
    "tests/**/*tenant*",
    "tests/**/*project*",
    "tests/**/*artifact*",
    "tests/**/*workspace*",
    "tests/**/*container*",
    "tests/**/*execution*",
    "workers/auth/**",
    "packages/agent-sdk/src/canvas-runtime.ts",
    "apps/shell/src/components/FileViewer.tsx",
    "apps/shell/src/components/InlineArtifactCard.tsx"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.next/**",
      "**/.wrangler/**",
      "**/dist/**",
      "**/coverage/**",
      "**/*.tsbuildinfo",
      "**/*.map",
      "**/.env*",
      "**/.dev.vars*",
      "**/*.local",
      "pnpm-lock.yaml",
      "naelao_expanded_gaps_resolved.html",
      "naelao_whop_businesses_spec.html",
      "_BUILD_PLAN/**",
      ".repomix-cache/**",
      "repomix-output*",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.woff",
      "**/*.woff2",
      "**/*.pdf"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
