{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 5000000
  },
  "output": {
    "filePath": "repomix/outputs/batch-13-marketplace-distribution.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "topFilesLength": 40,
    "instructionFilePath": "repomix/prompts/batch-13-items-120-130.md"
  },
  "include": [
    "package.json",
    "pnpm-workspace.yaml",
    "turbo.json",
    "vitest.workspace.ts",
    "biome.json",
    "tsconfig*.json",
    ".github/workflows/**",
    "infra/migrations/**",
    "infra/terraform/**",
    "docs/requirements-trace-matrix.md",
    "docs/DEPLOYMENT_SECRETS.md",
    "docs/DEPLOY_SECRETS.md",
    "docs/staging-smoke-test.md",
    "packages/types/**",
    "packages/config/**",
    "packages/db/**",
    "packages/http/**",
    "packages/auth/**",
    "packages/crypto/**",
    "packages/security/**",
    "packages/testing/**",
    "packages/tracing/**",
    "packages/events/**",
    "workers/router/**",
    "workers/billing/**",
    "workers/marketplace/**",
    "workers/provisioner/**",
    "workers/analytics/**",
    "workers/portal-router/**",
    "workers/notifications/**",
    "packages/billing-core/**",
    "packages/entitlements/**",
    "packages/idempotency/**",
    "packages/analytics-schema/**",
    "packages/ui/**",
    "packages/agent-sdk/**",
    "apps/marketplace-web/**",
    "tests/**/*marketplace*",
    "tests/**/*pricing*",
    "tests/**/*commission*",
    "tests/**/*revenue*",
    "tests/**/*reseller*",
    "tests/**/*partner*",
    "tests/**/*portal*",
    "tests/**/*analytics*",
    "tests/**/*payout*",
    "workers/spaces/src/index.ts",
    "workers/spaces/src/do/SpaceDO.ts",
    "workers/spaces/src/builder-routes.ts",
    "workers/spaces/src/business-routes.ts",
    "workers/spaces/src/template-catalog.ts",
    "workers/spaces/wrangler.toml",
    "apps/dashboard/src/app/**/marketplace/**",
    "apps/dashboard/src/app/**/reseller/**",
    "apps/dashboard/src/lib/**",
    "apps/dashboard/package.json",
    "apps/portal/src/**",
    "apps/portal/package.json",
    "apps/shell/src/app/p/[slug]/(shell)/plugins/**",
    "apps/shell/src/app/p/[slug]/(shell)/spaces/**",
    "apps/shell/src/lib/api.ts",
    "apps/shell/package.json",
    "workers/synthetics/**",
    "apps/dashboard/src/app/dashboard/products/**/configuration/**"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.next/**",
      "**/.wrangler/**",
      "**/dist/**",
      "**/coverage/**",
      "**/*.tsbuildinfo",
      "**/*.map",
      "**/.env*",
      "**/.dev.vars*",
      "**/*.local",
      "pnpm-lock.yaml",
      "naelao_expanded_gaps_resolved.html",
      "naelao_whop_businesses_spec.html",
      "_BUILD_PLAN/**",
      ".repomix-cache/**",
      "repomix-output*",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.woff",
      "**/*.woff2",
      "**/*.pdf"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
