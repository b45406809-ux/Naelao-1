{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 5000000
  },
  "output": {
    "filePath": ".repomix-cache/batch-08-model-policy-airgap-sleep.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "topFilesLength": 40,
    "instructionFilePath": ".repomix-cache/authority-batch-8.md"
  },
  "include": [
    "package.json",
    "pnpm-workspace.yaml",
    "turbo.json",
    "vitest.workspace.ts",
    "biome.json",
    "tsconfig*.json",
    ".github/workflows/**",
    "infra/migrations/**",
    "infra/terraform/**",
    "docs/requirements-trace-matrix.md",
    "docs/DEPLOYMENT_SECRETS.md",
    "docs/DEPLOY_SECRETS.md",
    "docs/staging-smoke-test.md",
    "packages/types/**",
    "packages/config/**",
    "packages/db/**",
    "packages/http/**",
    "packages/auth/**",
    "packages/crypto/**",
    "packages/security/**",
    "packages/testing/**",
    "packages/tracing/**",
    "packages/events/**",
    "workers/router/**",
    "workers/workflows/**",
    "workers/mcp-hub/**",
    "workers/browser/**",
    "workers/security-gateway/**",
    "workers/ws-gateway/**",
    "packages/agent-sdk/**",
    "packages/tool-runtime/**",
    "packages/llm-gateway/**",
    "packages/billing-core/**",
    "apps/shell/src/components/ModelSelector.tsx",
    "apps/shell/src/components/Chat.tsx",
    "apps/shell/src/lib/api.ts",
    "tests/**/*model*",
    "tests/**/*air*",
    "tests/**/*tunnel*",
    "tests/**/*terminal*",
    "tests/**/*completion*",
    "workers/agents/src/index.ts",
    "workers/agents/src/do/NaelaoAgentDO.ts",
    "workers/agents/src/script-engine/reasoner.ts",
    "workers/agents/src/script-engine/profiles.ts",
    "workers/agents/src/script-engine/code-runner.ts",
    "workers/agents/src/script-engine/local-tunnel.ts",
    "workers/agents/src/env.ts",
    "workers/agents/wrangler.toml",
    "workers/spaces/src/index.ts",
    "workers/spaces/src/do/SpaceDO.ts",
    "workers/spaces/wrangler.toml",
    "workers/together-ai/**"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.next/**",
      "**/.wrangler/**",
      "**/dist/**",
      "**/coverage/**",
      "**/*.tsbuildinfo",
      "**/*.map",
      "**/.env*",
      "**/.dev.vars*",
      "**/*.local",
      "pnpm-lock.yaml",
      "naelao_expanded_gaps_resolved.html",
      "naelao_whop_businesses_spec.html",
      "_BUILD_PLAN/**",
      ".repomix-cache/**",
      "repomix-output*",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.woff",
      "**/*.woff2",
      "**/*.pdf"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
