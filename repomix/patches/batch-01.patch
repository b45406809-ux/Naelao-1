+export class MultiplexedBridge implements RuntimeBridge {
+  private pending = new Map();
+
+  constructor(
+    private readonly sendRaw,
+    private readonly timeoutMs = 30_000
+  ) {}
+
+  async call(
+    stream,
+    method,
+    payload,
+    signal
+  ) {
+    if (signal?.aborted) throw new Error("aborted");
+    const id = crypto.randomUUID();
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => {
+        this.pending.delete(id);
+        reject(new Error(`bridge_call_timeout:${stream}:${method}`));
+      }, this.timeoutMs);
+
+      this.pending.set(id, {
+        resolve,
+        reject,
+        timer,
+      });
+
+      Promise.resolve(
+        this.sendRaw(JSON.stringify({ id, stream, method, payload }))
+      ).catch((err) => {
+        clearTimeout(timer);
+        this.pending.delete(id);
+        reject(err);
+      });
+    });
+  }
+
+  handleMessage(raw) {
+    let parsed;
+    try {
+      parsed = JSON.parse(raw);
+    } catch {
+      return;
+    }
+    if (!parsed || typeof parsed !== "object" || !("id" in parsed)) return;
+    const msg = parsed;
+    if (!msg.id) return;
+    const pending = this.pending.get(msg.id);
+    if (!pending) return;
+    clearTimeout(pending.timer);
+    this.pending.delete(msg.id);
+    if (msg.error) {
+      pending.reject(new Error(msg.error));
+    } else {
+      pending.resolve(msg.result);
+    }
+  }
+}
