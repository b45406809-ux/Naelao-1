  // ── Authoritative per-project daily spend (F9) ──────────────────────────────────────────
  // Every agent-DO thread against a project (each its own NaelaoAgentDO instance) debits
  // through this one SpaceDO instead of keeping its own zero-based local tally — single
  // writer, so concurrent threads on the same customer-bot project share one real total.
  private getProjectSpend(projectId: string, params: URLSearchParams): Response {
    const project = queryOne<{ daily_spend_cap_credits: number }>(
      this.ctx.storage.sql as never, "SELECT daily_spend_cap_credits FROM projects WHERE id = ?", projectId
    );
    if (!project) return Response.json({ error_code: "not_found", message: "Project not found" }, { status: 404 });
    const day = params.get("day") ?? todaySpendKey();
    const row = queryOne<{ credits: number }>(
      this.ctx.storage.sql as never, "SELECT credits FROM project_spend WHERE project_id = ? AND day = ?", projectId, day
    );
    const spentToday = row?.credits ?? 0;
    const cap = project.daily_spend_cap_credits;
    return Response.json({ project_id: projectId, day, spent_today: spentToday, cap, capped: cap > 0 && spentToday >= cap });
  }

  // POST /projects/:projectId/spend { credits } — adds `credits` (if any) to today's tally and
  // returns the updated total. Called with credits=0 as a pure pre-run gate check, and again
  // post-run with the actual token cost — both trips serialized through this single DO, so
  // spend recorded by one thread is immediately visible to the next thread's gate check.
  private async debitProjectSpend(projectId: string, request: Request): Promise<Response> {
    const project = queryOne<{ daily_spend_cap_credits: number }>(
      this.ctx.storage.sql as never, "SELECT daily_spend_cap_credits FROM projects WHERE id = ?", projectId
    );
    if (!project) return Response.json({ error_code: "not_found", message: "Project not found" }, { status: 404 });
    const body = await request.json<{ credits?: number }>().catch(() => ({}) as Record<string, never>);
    const credits = typeof body.credits === "number" && body.credits > 0 ? body.credits : 0;
    const day = todaySpendKey();
    if (credits > 0) {
      execute(
        this.ctx.storage.sql as never,
        `INSERT INTO project_spend (project_id, day, credits) VALUES (?, ?, ?)
         ON CONFLICT (project_id, day) DO UPDATE SET credits = credits + excluded.credits`,
        projectId, day, credits
      );
    }
    const row = queryOne<{ credits: number }>(
      this.ctx.storage.sql as never, "SELECT credits FROM project_spend WHERE project_id = ? AND day = ?", projectId, day
    );
    const spentToday = row?.credits ?? 0;
    const cap = project.daily_spend_cap_credits;
    return Response.json({ project_id: projectId, day, spent_today: spentToday, cap, capped: cap > 0 && spentToday >= cap });
  }

  // ── Builder observability surface (security audit follow-up) ───────────────
  // POST /agent-activity — internal only (NaelaoAgentDO posts one row per run completion/
  // failure and per approval request/resolution). Never blocks the caller's own response on a
  // write failure — see NaelaoAgentDO's logAgentActivity, which wraps every call in its own
  // best-effort try/catch, same posture as notifyApprovalRequested.
  private async recordAgentActivity(request: Request): Promise<Response> {
    const body = await request.json<{
      space_id: string;
      project_id?: string | null;
      thread_id?: string | null;
      agent_id: string;
      event_type: "run_completed" | "run_failed" | "approval_requested" | "approval_resolved" | "moderation_blocked";
      summary?: string;
      tokens_used?: number | null;
      cost_credits?: number | null;
      /** Classification from @naelao/events classifyFailure — set by the agent DO at the moment
       *  of failure, so the diagnostics rollup never has to re-parse free text. */
      failure_kind?: string | null;
      /** The thread and run this happened in, so a reader can actually go and continue it. */
      session_id?: string | null;
      run_id?: string | null;
      /** What woke this run: chat, heartbeat, scheduled_job, connector_poll, trigger. */
      trigger_source?: string | null;
    }>().catch(() => null);
    if (!body?.space_id || !body.agent_id || !body.event_type) {
      return Response.json({ error_code: "bad_request", message: "space_id, agent_id, event_type are required" }, { status: 400 });
    }
    execute(
      this.ctx.storage.sql as never,
      `INSERT INTO agent_activity_log (id, space_id, project_id, thread_id, agent_id, event_type, summary, tokens_used, cost_credits,
                                       failure_kind, session_id, run_id, trigger_source)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      crypto.randomUUID(), body.space_id, body.project_id ?? null, body.thread_id ?? null,
      body.agent_id, body.event_type, (body.summary ?? "").slice(0, 2000),
      body.tokens_used ?? null, body.cost_credits ?? null,
      isFailureKind(body.failure_kind) ? body.failure_kind : null,
      body.session_id ?? null, body.run_id ?? null, body.trigger_source ?? null
    );
    return Response.json({ ok: true }, { status: 201 });
  }

  // GET /agent-activity?project_id=&limit= — builder-facing paginated read (newest first), gated
  // builder-only at the spaces-worker route (product_end_user callers never reach this).
  private listAgentActivity(params: URLSearchParams): Response {
    const projectId = params.get("project_id");
    const limit = Math.min(Math.max(parseInt(params.get("limit") ?? "50", 10) || 50, 1), 200);
    // failure_kind / event_type are the drill-down the diagnostics summary points at: the summary
    // says "4 tool_error failures in Lead Generation", and this is how the assistant then reads
    // those four rows specifically instead of paging the whole log looking for them.
    const failureKind = params.get("failure_kind");
    const eventType = params.get("event_type");

    const where: string[] = [];
    const binds: Array<string | number> = [];
    if (projectId) { where.push("project_id = ?"); binds.push(projectId); }
    if (failureKind && isFailureKind(failureKind)) { where.push("failure_kind = ?"); binds.push(failureKind); }
    if (eventType) { where.push("event_type = ?"); binds.push(eventType); }
    binds.push(limit);

    const rows = queryAll(
      this.ctx.storage.sql as never,
      `SELECT * FROM agent_activity_log${where.length ? ` WHERE ${where.join(" AND ")}` : ""}
       ORDER BY created_at DESC LIMIT ?`,
      ...binds
    );
    return Response.json({ data: rows, count: rows.length });
  }

  // ── Notifications inbox ─────────────────────────────────────────────────────
  // POST /notifications — either a CREATE (kind/title present, called internal-only by
  // NaelaoAgentDO — see its createSpaceNotification helper) or a mark-read ACTION
  // ({action:"mark_read", notification_id}, reachable by any business member for their own
  // space's notifications). The spaces-worker route restricts a caller without an internal HMAC
  // token to ONLY the mark_read shape (see index.ts) — this method still checks defensively so a
  // bug at that layer can't turn into a forged notification.
  private async createOrActOnNotification(request: Request): Promise<Response> {
    const body = await request.json<{
      action?: string;
      notification_id?: string;
      space_id?: string;
      project_id?: string | null;
      kind?: string;
      title?: string;
      body?: string;
      severity?: "info" | "warning" | "critical";
      source_agent_id?: string | null;
      related_id?: string | null;
    }>().catch(() => null);
    if (!body) return Response.json({ error_code: "bad_request", message: "Invalid body" }, { status: 400 });

    if (body.action === "mark_read") {
      if (!body.notification_id) {
        return Response.json({ error_code: "bad_request", message: "notification_id is required" }, { status: 400 });
      }
      execute(
        this.ctx.storage.sql as never,
        "UPDATE notifications SET status = 'read', read_at = datetime('now') WHERE id = ? AND status != 'read'",
        body.notification_id
      );
      return Response.json({ ok: true });
    }

    // Internal-only in practice (the heartbeat sweep, after it actually sends the channel
    // message) — marks a row so it's never re-escalated on the next sweep. Deliberately does NOT
    // require internal auth at this DO layer (the spaces-worker route in front of it does), same
    // posture as mark_read.
    if (body.action === "mark_delivered") {
      if (!body.notification_id) {
        return Response.json({ error_code: "bad_request", message: "notification_id is required" }, { status: 400 });
      }
      execute(
        this.ctx.storage.sql as never,
        "UPDATE notifications SET delivered_at = datetime('now') WHERE id = ? AND delivered_at IS NULL",
        body.notification_id
      );
      return Response.json({ ok: true });
    }

    if (!body.space_id || !body.kind || !body.title) {
      return Response.json({ error_code: "bad_request", message: "space_id, kind, title are required" }, { status: 400 });
    }
    const id = crypto.randomUUID();
    execute(
      this.ctx.storage.sql as never,
      `INSERT INTO notifications (id, space_id, project_id, kind, title, body, severity, source_agent_id, related_id)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      id, body.space_id, body.project_id ?? null, body.kind, body.title.slice(0, 300),
      (body.body ?? "").slice(0, 2000), body.severity ?? "info",
      body.source_agent_id ?? null, body.related_id ?? null
    );
    return Response.json({ ok: true, id }, { status: 201 });
  }

  // GET /notifications?status=&limit=&undelivered_only=&stale_after_minutes= — the same read path
  // serves both the business-member-facing inbox (status/limit only) and the heartbeat sweep's
  // "what still needs escalating to a channel" query (undelivered_only + stale_after_minutes),
  // rather than a second route — see the dispatcher comment above for why.
  // project_id filtering: the assistant/Home chat view wants ALL notifications (the Space
  // Assistant oversees the whole business), so omitting project_id keeps the prior unfiltered
  // behavior. A project thread's own sidebar wants only THAT project's agent's notifications —
  // pass project_id to scope to it. There's no "assistant-only" (project_id IS NULL) mode here,
  // unlike scheduled_jobs/channel_links, because the ask for this tab was explicitly "all
  // notifications" for the assistant view, not "just the space-level ones."
  private listNotifications(params: URLSearchParams): Response {
    const status = params.get("status");
    const projectId = params.get("project_id");
    const limit = Math.min(Math.max(parseInt(params.get("limit") ?? "50", 10) || 50, 1), 200);
    if (params.get("undelivered_only") === "true") {
      const staleMinutesRaw = parseInt(params.get("stale_after_minutes") ?? "15", 10);
      const staleMinutes = Number.isFinite(staleMinutesRaw) && staleMinutesRaw >= 0 ? staleMinutesRaw : 15;
      const rows = queryAll(
        this.ctx.storage.sql as never,
        `SELECT * FROM notifications
         WHERE status = 'unread' AND delivered_at IS NULL
           AND created_at <= datetime('now', ?)
         ORDER BY created_at ASC LIMIT ?`,
        `-${staleMinutes} minutes`, limit
      );
      return Response.json({ data: rows, count: rows.length });
    }
    const clauses: string[] = [];
    const args: unknown[] = [];
    if (status) { clauses.push("status = ?"); args.push(status); }
    if (projectId) { clauses.push("project_id = ?"); args.push(projectId); }
    const where = clauses.length ? `WHERE ${clauses.join(" AND ")}` : "";
    const rows = queryAll(
      this.ctx.storage.sql as never,
      `SELECT * FROM notifications ${where} ORDER BY created_at DESC LIMIT ?`,
      ...args, limit
    );
    return Response.json({ data: rows, count: rows.length });
  }

  // ── §A1 Harness Excellence Phase HX2: signals + session token-budget guard ─────
  // GET /agent-signals?project_id=&window_hours= — explicit signals computed on read from
  // agent_activity_log (item 40's cross-DO observability mirror). No new ingestion: error
  // rate and avg/total cost are a straight rollup; "regenerations" (a proxy for the user
  // hitting retry/regenerate) is computed in application code from ordered per-thread rows
  // rather than a SQL window function, since DO SQLite's window-function support isn't
  // something this codebase otherwise relies on and the row counts here are always small.
  private computeAgentSignals(params: URLSearchParams): Response {
    const projectId = params.get("project_id");
    const windowHours = Math.min(Math.max(parseInt(params.get("window_hours") ?? "24", 10) || 24, 1), 24 * 30);
    const since = `datetime('now', '-${windowHours} hours')`;

    const rollup = projectId
      ? queryAll<{ event_type: string; cnt: number; avg_cost: number | null; total_cost: number | null }>(
          this.ctx.storage.sql as never,
          `SELECT event_type, COUNT(*) as cnt, AVG(cost_credits) as avg_cost, SUM(cost_credits) as total_cost
           FROM agent_activity_log WHERE project_id = ? AND created_at >= ${since} GROUP BY event_type`,
          projectId
        )
      : queryAll<{ event_type: string; cnt: number; avg_cost: number | null; total_cost: number | null }>(
          this.ctx.storage.sql as never,
          `SELECT event_type, COUNT(*) as cnt, AVG(cost_credits) as avg_cost, SUM(cost_credits) as total_cost
           FROM agent_activity_log WHERE created_at >= ${since} GROUP BY event_type`
        );

    const byType = new Map(rollup.map((r) => [r.event_type, r]));
    const runsCompleted = byType.get("run_completed")?.cnt ?? 0;
    const runsFailed = byType.get("run_failed")?.cnt ?? 0;
    const runsTotal = runsCompleted + runsFailed;
    const completedRow = byType.get("run_completed");

    // Regeneration proxy: 2+ run_completed/run_failed events on the SAME thread within 5
    // minutes of each other. Small result sets expected (bounded by the window above), so an
    // in-memory pass over ordered rows is simpler and more portable than a SQL window function.
    const threadRows = projectId
      ? queryAll<{ thread_id: string | null; created_at: string }>(
          this.ctx.storage.sql as never,
          `SELECT thread_id, created_at FROM agent_activity_log
           WHERE project_id = ? AND created_at >= ${since} AND event_type IN ('run_completed','run_failed')
           ORDER BY thread_id, created_at ASC`,
          projectId
        )
      : queryAll<{ thread_id: string | null; created_at: string }>(
          this.ctx.storage.sql as never,
          `SELECT thread_id, created_at FROM agent_activity_log
           WHERE created_at >= ${since} AND event_type IN ('run_completed','run_failed')
           ORDER BY thread_id, created_at ASC`
        );
    const REGEN_WINDOW_MS = 5 * 60 * 1000;
    let regenerations = 0;
    let prevThread: string | null = null;
    let prevMs = 0;
    for (const row of threadRows) {
      if (!row.thread_id) continue;
      // Safe here specifically: agent_activity_log.created_at is written ONLY by this table's own
      // `datetime('now')` default, i.e. SQLite's bare "YYYY-MM-DD HH:MM:SS", which V8 parses with
      // a Z appended. Do not copy this pattern to a column an application also writes explicitly:
      // scheduled_jobs binds new Date().toISOString() over its identical default, so the same
      // line there produced "…Z" + "Z" = NaN and silently disabled every schedule on the platform.
      const ms = Date.parse(row.created_at + "Z");
      if (row.thread_id === prevThread && ms - prevMs <= REGEN_WINDOW_MS) regenerations++;
      prevThread = row.thread_id;
      prevMs = ms;
    }

    return Response.json({
      window_hours: windowHours,
      runs_total: runsTotal,
      runs_completed: runsCompleted,
      runs_failed: runsFailed,
      error_rate: runsTotal > 0 ? runsFailed / runsTotal : 0,
      avg_cost_credits: completedRow?.avg_cost ?? 0,
      total_cost_credits: completedRow?.total_cost ?? 0,
      approvals_requested: byType.get("approval_requested")?.cnt ?? 0,
      regenerations,
    });
  }

  /**
   * GET /agent-diagnostics?window_hours= — the whole business in one bounded summary.
   *
   * The Space Assistant is woken by a heartbeat, a cron, a channel message — and each of those
   * used to arrive with no idea what had happened since last time. It could read
   * /agent-activity, but that is raw rows: "48 events" is not something to act on, and reading
   * enough of them to find the pattern costs more context than the whole wake-up is worth.
   *
   * So this is deliberately a SUMMARY, not a feed. Counts, the failure kinds that actually
   * occurred, the per-project shape of it, and — the part that makes it actionable — the ids
   * needed to go deeper: which thread stopped, which run to continue, which project to read.
   * Drilling down is a separate, explicit call the assistant makes only where it sees something
   * wrong (GET /agent-activity?failure_kind=, project_journal.read, the interrupted-run route).
   *
   * Everything is capped: at most 8 projects, 6 recent failures, 5 stalls. A brief that grows
   * with the business stops being a brief.
   */
  private computeAgentDiagnostics(params: URLSearchParams): Response {
    const windowHours = Math.min(Math.max(parseInt(params.get("window_hours") ?? "24", 10) || 24, 1), 24 * 30);
    const since = `datetime('now', '-${windowHours} hours')`;
    const sql = this.ctx.storage.sql as never;

    const byType = queryAll<{ event_type: string; cnt: number; tokens: number | null; credits: number | null }>(
      sql,
      `SELECT event_type, COUNT(*) as cnt, SUM(tokens_used) as tokens, SUM(cost_credits) as credits
         FROM agent_activity_log WHERE created_at >= ${since} GROUP BY event_type`
    );
    const counts: Record<string, number> = {};
    let totalTokens = 0;
    let totalCredits = 0;
    for (const r of byType) {
      counts[r.event_type] = r.cnt;
      totalTokens += r.tokens ?? 0;
      totalCredits += r.credits ?? 0;
    }

    // Why runs failed, most common first. This is the single most useful line in the brief: an
    // agent that knows its failures were all quota_exhausted behaves very differently from one
    // whose failures were all tool_error, and neither behaviour is reachable from a bare count.
    const failures = queryAll<{ failure_kind: string | null; cnt: number }>(
      sql,
      `SELECT failure_kind, COUNT(*) as cnt FROM agent_activity_log
        WHERE event_type = 'run_failed' AND created_at >= ${since}
        GROUP BY failure_kind ORDER BY cnt DESC LIMIT 8`
    ).map((r) => ({ kind: r.failure_kind ?? "unknown", count: r.cnt }));

    // Where the work is, per project — including which projects are burning tokens without
    // finishing anything, which is exactly the "which project thread stopped and why" question.
    const projects = queryAll<{
      project_id: string | null; completed: number; failed: number; tokens: number | null; credits: number | null;
    }>(
      sql,
      `SELECT project_id,
              SUM(CASE WHEN event_type = 'run_completed' THEN 1 ELSE 0 END) as completed,
              SUM(CASE WHEN event_type = 'run_failed'    THEN 1 ELSE 0 END) as failed,
              SUM(tokens_used) as tokens, SUM(cost_credits) as credits
         FROM agent_activity_log
        WHERE created_at >= ${since} AND event_type IN ('run_completed','run_failed')
        GROUP BY project_id
        ORDER BY (failed * 3 + completed) DESC LIMIT 8`
    );

    // Project names, so the brief reads as "Lead Generation stalled" and not a bare uuid the
    // assistant would have to spend another call resolving.
    const nameById = new Map<string, string>();
    for (const p of queryAll<{ id: string; name: string }>(sql, `SELECT id, name FROM projects`)) {
      nameById.set(p.id, p.name);
    }

    // The stalls worth resuming: the most recent failures that still name a thread. Capped hard —
    // this is a pointer list, not a log.
    const stalls = queryAll<{
      project_id: string | null; thread_id: string | null; session_id: string | null; run_id: string | null;
      failure_kind: string | null; summary: string; trigger_source: string | null; created_at: string;
      tokens_used: number | null;
    }>(
      sql,
      `SELECT project_id, thread_id, session_id, run_id, failure_kind, summary, trigger_source, created_at, tokens_used
         FROM agent_activity_log
        WHERE event_type = 'run_failed' AND created_at >= ${since}
        ORDER BY created_at DESC LIMIT 6`
    ).map((r) => ({
      project_id: r.project_id,
      project_name: r.project_id ? nameById.get(r.project_id) ?? null : null,
      thread_id: r.thread_id,
      session_id: r.session_id,
      run_id: r.run_id,
      failure_kind: r.failure_kind ?? "unknown",
      // The summary is already capped at 2000 on write; 240 is what fits a brief without turning
      // it into a log dump. The full text stays available via /agent-activity.
      summary: (r.summary ?? "").slice(0, 240),
      woken_by: r.trigger_source,
      tokens_used: r.tokens_used,
      at: r.created_at,
    }));

    // How many wake-ups never got anywhere. A recurring "the heartbeat fired and immediately hit
    // a limit" pattern is invisible in a per-run view and obvious here.
    const wakeFailures = queryAll<{ trigger_source: string | null; cnt: number }>(
      sql,
      `SELECT trigger_source, COUNT(*) as cnt FROM agent_activity_log
        WHERE event_type = 'run_failed' AND created_at >= ${since}
          AND trigger_source IS NOT NULL AND trigger_source != 'chat'
        GROUP BY trigger_source ORDER BY cnt DESC LIMIT 5`
    ).map((r) => ({ trigger: r.trigger_source ?? "unknown", failed_runs: r.cnt }));

    const unreadNotifications = queryOne<{ cnt: number }>(
      sql, `SELECT COUNT(*) as cnt FROM notifications WHERE status = 'unread'`
    )?.cnt ?? 0;
    const criticalUnread = queryOne<{ cnt: number }>(
      sql, `SELECT COUNT(*) as cnt FROM notifications WHERE status = 'unread' AND severity = 'critical'`
    )?.cnt ?? 0;

    const runsCompleted = counts["run_completed"] ?? 0;
    const runsFailed = counts["run_failed"] ?? 0;
    const runsTotal = runsCompleted + runsFailed;

    return Response.json({
      window_hours: windowHours,
      runs: {
        total: runsTotal,
        completed: runsCompleted,
        failed: runsFailed,
        error_rate: runsTotal > 0 ? Number((runsFailed / runsTotal).toFixed(3)) : 0,
      },
      spend: { tokens_used: totalTokens, credits: totalCredits },
      approvals: {
        requested: counts["approval_requested"] ?? 0,
        resolved: counts["approval_resolved"] ?? 0,
        // A gap here means work is parked on a person who hasn't answered.
        outstanding: Math.max(0, (counts["approval_requested"] ?? 0) - (counts["approval_resolved"] ?? 0)),
      },
      moderation_blocked: counts["moderation_blocked"] ?? 0,
      failures_by_kind: failures,
      wake_failures: wakeFailures,
      projects: projects.map((p) => ({
        project_id: p.project_id,
        name: p.project_id ? nameById.get(p.project_id) ?? null : "(space assistant)",
        completed: p.completed,
        failed: p.failed,
        tokens_used: p.tokens ?? 0,
        credits: p.credits ?? 0,
      })),
      recent_stalls: stalls,
      notifications: { unread: unreadNotifications, unread_critical: criticalUnread },
    });
  }

  // GET /business-analytics?window=7d|30d|90d — the Analytics page's data (apps/shell's Settings-
  // adjacent business dashboard, mirroring the mockup's Analytics view). Pure aggregate — counts,
  // sums, and per-day/per-agent rollups, never a raw row with a session id, thread id, or summary
  // text attached — which is what makes this safe for ANY business member, unlike the
  // builder-only agent-activity/agent-diagnostics endpoints this shares its table with.
  //
  // "Heartbeat pass/fail": only FAILURES are ever logged for an idle heartbeat tick (see
  // handleAgentTick in workers/agents — a heartbeat with nothing to do writes nothing, since
  // logging a no-op tick for every space every hour platform-wide would dwarf the table for zero
  // signal). So "passes" here honestly means "wake-ups that did real work and it completed", not
  // "every tick that happened to run" — there is no record of a silent, work-free tick succeeding,
  // and this deliberately does not invent one.
  private computeBusinessAnalytics(params: URLSearchParams): Response {
    const windowDays = params.get("window") === "30d" ? 30 : params.get("window") === "90d" ? 90 : 7;
    const since = `datetime('now', '-${windowDays} days')`;
    const prevSince = `datetime('now', '-${windowDays * 2} days')`;
    const sql = this.ctx.storage.sql as never;

    const byType = queryAll<{ event_type: string; cnt: number; tokens: number | null; credits: number | null }>(
      sql,
      `SELECT event_type, COUNT(*) as cnt, SUM(tokens_used) as tokens, SUM(cost_credits) as credits
         FROM agent_activity_log WHERE created_at >= ${since} GROUP BY event_type`
    );
    const counts: Record<string, number> = {};
    let totalTokens = 0;
    let totalCredits = 0;
    for (const r of byType) {
      counts[r.event_type] = r.cnt;
      totalTokens += r.tokens ?? 0;
      totalCredits += r.credits ?? 0;
    }
    const runsCompleted = counts["run_completed"] ?? 0;
    const runsFailed = counts["run_failed"] ?? 0;
    const runsTotal = runsCompleted + runsFailed;

    // Prior window, for the "vs last period" deltas the mockup's cards show — a real comparison,
    // not a fabricated percentage.
    const prevCredits = queryOne<{ credits: number | null }>(
      sql,
      `SELECT SUM(cost_credits) as credits FROM agent_activity_log
        WHERE created_at >= ${prevSince} AND created_at < ${since}`
    )?.credits ?? 0;
    const prevRuns = queryOne<{ cnt: number }>(
      sql,
      `SELECT COUNT(*) as cnt FROM agent_activity_log
        WHERE created_at >= ${prevSince} AND created_at < ${since} AND event_type IN ('run_completed','run_failed')`
    )?.cnt ?? 0;

    // Per-agent breakdown for the mockup's "Usage by Agent" table — runs/credits/success rate.
    // No avg-duration column exists on this table (nothing measures wall time per run today), so
    // this deliberately omits that field rather than fabricating one.
    const byAgent = queryAll<{ agent_id: string; completed: number; failed: number; credits: number | null; tokens: number | null }>(
      sql,
      `SELECT agent_id,
              SUM(CASE WHEN event_type = 'run_completed' THEN 1 ELSE 0 END) as completed,
              SUM(CASE WHEN event_type = 'run_failed'    THEN 1 ELSE 0 END) as failed,
              SUM(cost_credits) as credits, SUM(tokens_used) as tokens
         FROM agent_activity_log
        WHERE created_at >= ${since} AND event_type IN ('run_completed','run_failed')
        GROUP BY agent_id ORDER BY (completed + failed) DESC LIMIT 12`
    );

    // Daily credit usage for the bar chart — one row per day even when a day had zero activity,
    // computed in application code rather than a SQL date-series generator DO SQLite doesn't have.
    const dailyRows = queryAll<{ day: string; credits: number | null; runs: number }>(
      sql,
      `SELECT substr(created_at, 1, 10) as day, SUM(cost_credits) as credits, COUNT(*) as runs
         FROM agent_activity_log
        WHERE created_at >= ${since} AND event_type IN ('run_completed','run_failed')
        GROUP BY day`
    );
    const dailyByDay = new Map(dailyRows.map((r) => [r.day, { credits: r.credits ?? 0, runs: r.runs }]));
    const daily: { day: string; credits: number; runs: number }[] = [];
    const bucketDays = Math.min(windowDays, 30); // cap the series at 30 points even for the 90d window
    const step = windowDays / bucketDays;
    for (let i = bucketDays - 1; i >= 0; i--) {
      const d = new Date(Date.now() - Math.round(i * step) * 24 * 60 * 60 * 1000);
      const key = d.toISOString().slice(0, 10);
      const found = dailyByDay.get(key);
      daily.push({ day: key, credits: found?.credits ?? 0, runs: found?.runs ?? 0 });
    }

    // Heartbeat/scheduled wake-ups: failures by trigger, honestly labeled per the header comment
    // above (no fabricated "pass" count for a silent no-op tick).
    const wakeFailures = queryAll<{ trigger_source: string | null; cnt: number }>(
      sql,
      `SELECT trigger_source, COUNT(*) as cnt FROM agent_activity_log
        WHERE event_type = 'run_failed' AND created_at >= ${since}
          AND trigger_source IS NOT NULL AND trigger_source != 'chat'
        GROUP BY trigger_source ORDER BY cnt DESC LIMIT 8`
    ).map((r) => ({ trigger: r.trigger_source ?? "unknown", failed: r.cnt }));
    const wakeCompleted = queryOne<{ cnt: number }>(
      sql,
      `SELECT COUNT(*) as cnt FROM agent_activity_log
        WHERE event_type = 'run_completed' AND created_at >= ${since}
          AND trigger_source IS NOT NULL AND trigger_source != 'chat'`
    )?.cnt ?? 0;
    const wakeFailedTotal = wakeFailures.reduce((sum, w) => sum + w.failed, 0);

    const projectsTotal = queryOne<{ cnt: number }>(sql, `SELECT COUNT(*) as cnt FROM projects WHERE status != 'archived'`)?.cnt ?? 0;
    const threadsTotal = queryOne<{ cnt: number }>(sql, `SELECT COUNT(*) as cnt FROM threads`)?.cnt ?? 0;

    return Response.json({
      window_days: windowDays,
      runs: {
        total: runsTotal,
        completed: runsCompleted,
        failed: runsFailed,
        success_rate: runsTotal > 0 ? Number((runsCompleted / runsTotal).toFixed(3)) : null,
        vs_prior_period: prevRuns > 0 ? Number((((runsTotal - prevRuns) / prevRuns) * 100).toFixed(1)) : null,
      },
      credits: {
        used: totalCredits,
        vs_prior_period: prevCredits > 0 ? Number((((totalCredits - prevCredits) / prevCredits) * 100).toFixed(1)) : null,
      },
      tokens_used: totalTokens,
      by_agent: byAgent.map((a) => ({
        agent_id: a.agent_id,
        runs: a.completed + a.failed,
        completed: a.completed,
        failed: a.failed,
        success_rate: (a.completed + a.failed) > 0 ? Number((a.completed / (a.completed + a.failed)).toFixed(3)) : null,
        credits: a.credits ?? 0,
      })),
      daily,
      heartbeats: {
        completed_with_work: wakeCompleted,
        failed: wakeFailedTotal,
        by_trigger: wakeFailures,
      },
      structure: { projects: projectsTotal, threads: threadsTotal },
    });
  }

  // POST /signal-events — internal only (implicit signals: user-frustration / agent-forgot
  // markers detected by @naelao/events' detectImplicitSignals against a run's goal text).
  // Mirrors recordAgentActivity's shape/posture exactly — never blocks the caller's own run.
  private async recordSignalEvent(request: Request): Promise<Response> {
    const body = await request.json<{
      space_id: string;
      project_id?: string | null;
      thread_id?: string | null;
      agent_id: string;
      signal_type: string;
      detail?: string;
    }>().catch(() => null);
    if (!body?.space_id || !body.agent_id || !body.signal_type) {
      return Response.json({ error_code: "bad_request", message: "space_id, agent_id, signal_type are required" }, { status: 400 });
    }
    execute(
      this.ctx.storage.sql as never,
      `INSERT INTO agent_signal_events (id, space_id, project_id, thread_id, agent_id, signal_type, detail)
       VALUES (?, ?, ?, ?, ?, ?, ?)`,
      crypto.randomUUID(), body.space_id, body.project_id ?? null, body.thread_id ?? null,
      body.agent_id, body.signal_type, (body.detail ?? "").slice(0, 500)
    );
    return Response.json({ ok: true }, { status: 201 });
  }

  // GET /signal-events?project_id=&signal_type=&limit= — builder-facing paginated read.
  private listSignalEvents(params: URLSearchParams): Response {
    const projectId = params.get("project_id");
    const signalType = params.get("signal_type");
    const limit = Math.min(Math.max(parseInt(params.get("limit") ?? "50", 10) || 50, 1), 200);
    const clauses: string[] = [];
    const args: unknown[] = [];
    if (projectId) { clauses.push("project_id = ?"); args.push(projectId); }
    if (signalType) { clauses.push("signal_type = ?"); args.push(signalType); }
    const where = clauses.length ? `WHERE ${clauses.join(" AND ")}` : "";
    const rows = queryAll(
      this.ctx.storage.sql as never,
      `SELECT * FROM agent_signal_events ${where} ORDER BY created_at DESC LIMIT ?`,
      ...args, limit
    );
    return Response.json({ data: rows, count: rows.length });
  }

  // POST /session-spend — internal only: increments a session's cumulative credit tally.
  // Upsert rather than a blind INSERT since the same session accumulates across many runs.
  private async incrementSessionSpend(request: Request): Promise<Response> {
    const body = await request.json<{
      session_id: string; space_id: string; project_id?: string | null; credits: number;
    }>().catch(() => null);
    if (!body?.session_id || !body.space_id || typeof body.credits !== "number") {
      return Response.json({ error_code: "bad_request", message: "session_id, space_id, credits are required" }, { status: 400 });
    }
    execute(
      this.ctx.storage.sql as never,
      `INSERT INTO session_spend (session_id, space_id, project_id, credits_used, updated_at)
       VALUES (?, ?, ?, ?, datetime('now'))
       ON CONFLICT(session_id) DO UPDATE SET
         credits_used = credits_used + excluded.credits_used,
         updated_at = datetime('now')`,
      body.session_id, body.space_id, body.project_id ?? null, Math.max(0, Math.round(body.credits))
    );
    return Response.json({ ok: true }, { status: 201 });
  }

  // GET /session-spend/:sessionId — read the current tally; a session with no rows yet (never
  // ran, or the budget guard is off) reads as an honest zeroed default, not a 404.
  private getSessionSpend(sessionId: string): Response {
    const row = queryOne<{ session_id: string; space_id: string; project_id: string | null; credits_used: number; warned_80: number; updated_at: string }>(
      this.ctx.storage.sql as never,
      "SELECT * FROM session_spend WHERE session_id = ?",
      sessionId
    );
    if (!row) {
      return Response.json({ session_id: sessionId, credits_used: 0, warned_80: false });
    }
    return Response.json({ session_id: row.session_id, credits_used: row.credits_used, warned_80: row.warned_80 === 1, updated_at: row.updated_at });
  }

  // POST /session-spend/:sessionId/continue — a human approved continuing past the ceiling.
  // Resets the tally to 0 (a fresh spending cycle) rather than tracking an ever-growing
  // "extensions" count — simpler mental model, and the next cycle re-crosses the SAME ceiling
  // rather than a compounding one, so nothing needs the un-bounded-growth edge case guarded.
  private continueSessionSpend(sessionId: string): Response {
    // A no-op UPDATE (0 rows) when the session has no spend record yet is fine — there's
    // nothing to reset. Never creates a placeholder row (which would need a fake space_id).
    execute(
      this.ctx.storage.sql as never,
      `UPDATE session_spend SET credits_used = 0, warned_80 = 0, updated_at = datetime('now') WHERE session_id = ?`,
      sessionId
    );
    return Response.json({ ok: true });
  }

  // POST /session-spend/:sessionId/mark-warned — idempotent single-fire flag.
  private markSessionSpendWarned(sessionId: string): Response {
    execute(
      this.ctx.storage.sql as never,
      `UPDATE session_spend SET warned_80 = 1, updated_at = datetime('now') WHERE session_id = ?`,
      sessionId
    );
    return Response.json({ ok: true });
  }

  // ── Launchpad Wallet (user-directed feature) ────────────────────────────────
  // A project flagged kind='wallet' carries a stored-value balance in wallet_ledger — an
  // append-only ledger (balance is SUM(delta_cents), never a cached column), same
  // never-double-credit-on-replay shape as ProductUserDO's credit_ledger. Every op below 404s
  // for a project that isn't actually kind='wallet' — deliberately strict, since these are
  // money-adjacent ops and a workspace/customer_bot project should never accumulate a balance
  // by accident. See wallet.ts (script-engine prebuilt) for the agent-facing surface and the
  // full custody-boundary writeup this feature keeps to.
  private requireWalletProject(projectId: string): { space_id: string } | null {
    const row = queryOne<{ space_id: string; kind: string }>(
      this.ctx.storage.sql as never, "SELECT space_id, kind FROM projects WHERE id = ?", projectId
    );
    if (!row || row.kind !== "wallet") return null;
    return { space_id: row.space_id };
  }

  private walletBalance(projectId: string): number {
    const row = queryOne<{ bal: number | null }>(
      this.ctx.storage.sql as never, "SELECT SUM(delta_cents) AS bal FROM wallet_ledger WHERE project_id = ?", projectId
    );
    return row?.bal ?? 0;
  }

  private findWalletProject(spaceId: string): Response {
    if (!spaceId) return Response.json({ project_id: null });
    const row = queryOne<{ id: string }>(
      this.ctx.storage.sql as never,
      "SELECT id FROM projects WHERE space_id = ? AND kind = 'wallet' AND status != 'archived' ORDER BY created_at ASC LIMIT 1",
      spaceId
    );
    return Response.json({ project_id: row?.id ?? null });
  }

  // External revenue tracker (Whop-native business cut): the revenue-tracker prebuilt reports
  // a period's observed gross revenue here (upsert — re-tracking the same period overwrites the
  // prior observation, since more of a period's payments can complete between checks).
  // F-27: a correction NO LONGER reverts billed→0 and re-bills the full figure. `billed_cents`
  // (what was actually charged) persists across corrections; the checkout bills only
  // max(0, cut(new_revenue) − billed_cents), so correcting 100k→120k bills the 20k×cut delta, not
  // the full 120k×cut on top of what was already collected. We only update revenue_cents/tracked_at
  // here — billed/billed_cents are owned by the mark-billed/unmark-billed payment webhooks.
  private async recordExternalRevenue(request: Request): Promise<Response> {
    const body = await request.json<{ space_id?: string; period?: string; provider?: string; revenue_cents?: number }>()
      .catch(() => ({}) as Record<string, never>);
    const spaceId = body.space_id ?? "";
    const period = body.period ?? "";
    const provider = body.provider ?? "whop";
    const revenueCents = Number.isFinite(body.revenue_cents) ? Math.max(0, Math.round(body.revenue_cents!)) : NaN;
    if (!spaceId || !/^\d{4}-\d{2}$/.test(period) || !Number.isFinite(revenueCents)) {
      return Response.json({ error_code: "bad_request", message: "space_id, period ('YYYY-MM'), and revenue_cents are required" }, { status: 400 });
    }

    execute(
      this.ctx.storage.sql as never,
      // On a first observation, billed/billed_cents default to 0/0 (fully billable). On a re-track
      // (correction), ONLY revenue_cents + tracked_at change — the accumulated billed_cents stays,
      // which is exactly what makes the checkout's delta computation correct.
      `INSERT INTO external_revenue_snapshots (id, space_id, period, provider, revenue_cents, billed, tracked_at)
       VALUES (?, ?, ?, ?, ?, 0, datetime('now'))
       ON CONFLICT(space_id, period, provider) DO UPDATE SET
         revenue_cents = excluded.revenue_cents, tracked_at = excluded.tracked_at`,
      crypto.randomUUID(), spaceId, period, provider, revenueCents
    );
    const row = queryOne<{ billed: number; billed_cents: number }>(
      this.ctx.storage.sql as never,
      "SELECT billed, billed_cents FROM external_revenue_snapshots WHERE space_id = ? AND period = ? AND provider = ?",
      spaceId, period, provider
    );
    return Response.json({ space_id: spaceId, period, provider, revenue_cents: revenueCents, billed: row?.billed === 1, billed_cents: row?.billed_cents ?? 0 }, { status: 201 });
  }

  private getExternalRevenue(params: URLSearchParams): Response {
    const spaceId = params.get("space_id") ?? "";
    if (!spaceId) return Response.json({ error_code: "bad_request", message: "space_id is required" }, { status: 400 });
    const provider = params.get("provider") ?? "whop";
    const period = params.get("period");

    if (period) {
      const row = queryOne<{ revenue_cents: number; billed: number; billed_cents: number; pending_checkout_at: string | null; tracked_at: string }>(
        this.ctx.storage.sql as never,
        "SELECT revenue_cents, billed, billed_cents, pending_checkout_at, tracked_at FROM external_revenue_snapshots WHERE space_id = ? AND period = ? AND provider = ?",
        spaceId, period, provider
      );
      if (!row) return Response.json({ space_id: spaceId, period, provider, revenue_cents: 0, billed: false, billed_cents: 0, pending_checkout_at: null, tracked_at: null });
      return Response.json({ space_id: spaceId, period, provider, revenue_cents: row.revenue_cents, billed: row.billed === 1, billed_cents: row.billed_cents, pending_checkout_at: row.pending_checkout_at, tracked_at: row.tracked_at });
    }

    const rows = queryAll<{ period: string; revenue_cents: number; billed: number; billed_cents: number; pending_checkout_at: string | null; tracked_at: string }>(
      this.ctx.storage.sql as never,
      "SELECT period, revenue_cents, billed, billed_cents, pending_checkout_at, tracked_at FROM external_revenue_snapshots WHERE space_id = ? AND provider = ? ORDER BY period DESC LIMIT 24",
      spaceId, provider
    );
    return Response.json({
      space_id: spaceId, provider,
      snapshots: rows.map((r) => ({ period: r.period, revenue_cents: r.revenue_cents, billed: r.billed === 1, billed_cents: r.billed_cents, pending_checkout_at: r.pending_checkout_at, tracked_at: r.tracked_at })),
      last_tracked_at: rows[0]?.tracked_at ?? null,
    });
  }

  // Marks specific periods billed after a successful revenue-cut surcharge payment (the billing
  // worker's webhook handler calls this, never the tracker) — distinct from recordExternalRevenue
  // (which upserts a REVENUE OBSERVATION) since this only ever flips the billed flag, never
  // touches revenue_cents. Idempotent: an already-billed period is a no-op.
  private async markRevenueBilled(request: Request): Promise<Response> {
    const body = await request.json<{ space_id?: string; periods?: string[]; charges?: number[]; provider?: string }>()
      .catch(() => ({}) as Record<string, never>);
    const spaceId = body.space_id ?? "";
    const provider = body.provider ?? "whop";
    const periods = Array.isArray(body.periods) ? body.periods.filter((p) => /^\d{4}-\d{2}$/.test(p)) : [];
    if (!spaceId || periods.length === 0) {
      return Response.json({ error_code: "bad_request", message: "space_id and at least one valid period are required" }, { status: 400 });
    }
    // F-27: `charges` (parallel to periods) is the delta actually charged for each period — ADDED
    // to billed_cents so a later correction bills only the new delta. A caller that omits charges
    // (legacy) falls back to marking the period fully billed (billed_cents = revenue_cents, a
    // ceiling that's never re-billed). F-31: clear pending_checkout_at now that it's paid.
    const charges = Array.isArray(body.charges) ? body.charges : [];
    periods.forEach((period, i) => {
      const charge = Number.isFinite(charges[i]) ? Math.max(0, Math.round(charges[i]!)) : null;
      if (charge !== null) {
        execute(
          this.ctx.storage.sql as never,
          "UPDATE external_revenue_snapshots SET billed = 1, billed_cents = billed_cents + ?, pending_checkout_at = NULL WHERE space_id = ? AND period = ? AND provider = ?",
          charge, spaceId, period, provider
        );
      } else {
        execute(
          this.ctx.storage.sql as never,
          "UPDATE external_revenue_snapshots SET billed = 1, billed_cents = revenue_cents, pending_checkout_at = NULL WHERE space_id = ? AND period = ? AND provider = ?",
          spaceId, period, provider
        );
      }
    });
    return Response.json({ space_id: spaceId, provider, billed_periods: periods });
  }

  // F-29: the inverse of markRevenueBilled — the billing worker calls this when a revenue-cut
  // surcharge payment is refunded, so the periods it covered revert to unbilled and become
  // re-billable on the next checkout. Idempotent: an already-unbilled period is a no-op.
  private async markRevenueUnbilled(request: Request): Promise<Response> {
    const body = await request.json<{ space_id?: string; periods?: string[]; charges?: number[]; provider?: string }>()
      .catch(() => ({}) as Record<string, never>);
    const spaceId = body.space_id ?? "";
    const provider = body.provider ?? "whop";
    const periods = Array.isArray(body.periods) ? body.periods.filter((p) => /^\d{4}-\d{2}$/.test(p)) : [];
    if (!spaceId || periods.length === 0) {
      return Response.json({ error_code: "bad_request", message: "space_id and at least one valid period are required" }, { status: 400 });
    }
    // F-27: reverse exactly the charge that was collected (billed_cents -= charge), so a refunded
    // surcharge re-opens only that much for re-billing — not the whole period from scratch. Legacy
    // callers (no charges) zero billed_cents. billed flips to 0 once nothing is left charged.
    const charges = Array.isArray(body.charges) ? body.charges : [];
    periods.forEach((period, i) => {
      const charge = Number.isFinite(charges[i]) ? Math.max(0, Math.round(charges[i]!)) : null;
      if (charge !== null) {
        execute(
          this.ctx.storage.sql as never,
          "UPDATE external_revenue_snapshots SET billed_cents = MAX(0, billed_cents - ?) WHERE space_id = ? AND period = ? AND provider = ?",
          charge, spaceId, period, provider
        );
      } else {
        execute(
          this.ctx.storage.sql as never,
          "UPDATE external_revenue_snapshots SET billed_cents = 0 WHERE space_id = ? AND period = ? AND provider = ?",
          spaceId, period, provider
        );
      }
      execute(
        this.ctx.storage.sql as never,
        "UPDATE external_revenue_snapshots SET billed = CASE WHEN billed_cents > 0 THEN 1 ELSE 0 END WHERE space_id = ? AND period = ? AND provider = ?",
        spaceId, period, provider
      );
    });
    return Response.json({ space_id: spaceId, provider, unbilled_periods: periods });
  }

  // F-31: mark periods as having an in-flight surcharge checkout (skipped for ~24h so two checkouts
  // minted before either is paid don't both bill the same periods). The billing worker calls this
  // right after minting a checkout URL. Cleared on pay (mark-billed) or refund. A stale pending
  // (>24h) is treated as abandoned and re-billable by the checkout's own filter.
  private async markRevenuePending(request: Request): Promise<Response> {
    const body = await request.json<{ space_id?: string; periods?: string[]; provider?: string }>()
      .catch(() => ({}) as Record<string, never>);
    const spaceId = body.space_id ?? "";
    const provider = body.provider ?? "whop";
    const periods = Array.isArray(body.periods) ? body.periods.filter((p) => /^\d{4}-\d{2}$/.test(p)) : [];
    if (!spaceId || periods.length === 0) {
      return Response.json({ error_code: "bad_request", message: "space_id and at least one valid period are required" }, { status: 400 });
    }
    for (const period of periods) {
      execute(
        this.ctx.storage.sql as never,
        "UPDATE external_revenue_snapshots SET pending_checkout_at = datetime('now') WHERE space_id = ? AND period = ? AND provider = ?",
        spaceId, period, provider
      );
    }
    return Response.json({ space_id: spaceId, provider, pending_periods: periods });
  }

  private getWalletBalance(projectId: string): Response {
    const project = this.requireWalletProject(projectId);
    if (!project) return Response.json({ error_code: "not_found", message: "Not a wallet project" }, { status: 404 });
    // `credited_cents` is what makes a NEVER-FUNDED wallet distinguishable from a DEPLETED one.
    // Both are a zero balance, and the run gate used to block on the balance alone — so a business
    // created five seconds ago, whose wallet is auto-provisioned empty by design, was refused all
    // project-agent work with "top up to keep this agent running" before its owner had done
    // anything. Reproduced live on a real business. See checkProjectWallet in NaelaoAgentDO.
    const credited = queryOne<{ total: number | null }>(
      this.ctx.storage.sql as never,
      "SELECT SUM(delta_cents) AS total FROM wallet_ledger WHERE project_id = ? AND delta_cents > 0",
      projectId
    );
    return Response.json({
      project_id: projectId,
      balance_cents: this.walletBalance(projectId),
      credited_cents: credited?.total ?? 0,
      currency: "USD",
    });
  }

  private async creditWallet(projectId: string, request: Request): Promise<Response> {
    const project = this.requireWalletProject(projectId);
    if (!project) return Response.json({ error_code: "not_found", message: "Not a wallet project" }, { status: 404 });
    const tenantId = new URL(request.url).searchParams.get("tenant_id") ?? "";
    const body = await request.json<{ cents?: number; reason?: string; idempotency_key?: string; currency?: string }>()
      .catch(() => ({}) as Record<string, never>);
    if (!Number.isFinite(body.cents) || (body.cents ?? 0) <= 0) {
      return Response.json({ error_code: "bad_request", message: "cents must be a positive number" }, { status: 400 });
    }
    // walletBalance/getWalletBalance sum delta_cents across the whole ledger with no currency
    // filter — a single-currency ledger (USD only) is the only thing that's actually correct
    // today. Rather than silently accept a non-USD row that a currency-blind SUM would then
    // conflate with USD balances (cf. the builder-payout multi-currency bug, item 39), reject it
    // outright with a clear error until multi-currency wallets are actually built (which would
    // need per-currency balances/gates, not just a per-row column).
    if (body.currency && body.currency !== "USD") {
      return Response.json({ error_code: "unsupported_currency", message: "Wallet ledger is single-currency (USD) only" }, { status: 400 });
    }
    if (body.idempotency_key) {
      const existing = queryOne<{ balance_after_cents: number }>(
        this.ctx.storage.sql as never,
        "SELECT balance_after_cents FROM wallet_ledger WHERE project_id = ? AND idempotency_key = ?",
        projectId, body.idempotency_key
      );
      if (existing) return Response.json({ balance_cents: existing.balance_after_cents, deduplicated: true });
    }
    const credit = Math.floor(body.cents!);
    const balanceAfter = this.walletBalance(projectId) + credit;
    execute(
      this.ctx.storage.sql as never,
      `INSERT INTO wallet_ledger (id, project_id, space_id, delta_cents, currency, reason, balance_after_cents, idempotency_key)
       VALUES (?, ?, ?, ?, 'USD', ?, ?, ?)`,
      crypto.randomUUID(), projectId, project.space_id, credit,
      body.reason ?? "top_up", balanceAfter, body.idempotency_key ?? null
    );
    await this.fireMatchingTriggers(
      { type: "wallet.credited", space_id: project.space_id, project_id: projectId, occurred_at: Date.now(), payload: { cents: credit, balance_cents: balanceAfter } },
      tenantId
    );
    await broadcastSpaceEvent(this.env, tenantId, project.space_id, "wallet.credited", { project_id: projectId, balance_cents: balanceAfter });
    return Response.json({ balance_cents: balanceAfter }, { status: 201 });
  }

  // Fails CLOSED: an over-draw is rejected (402), never silently allowed to go negative — same
  // contract as ProductUserDO's /credits/deduct.
  private async debitWallet(projectId: string, request: Request): Promise<Response> {
    const project = this.requireWalletProject(projectId);
    if (!project) return Response.json({ error_code: "not_found", message: "Not a wallet project" }, { status: 404 });
    const tenantId = new URL(request.url).searchParams.get("tenant_id") ?? "";
    const body = await request.json<{ cents?: number; reason?: string; idempotency_key?: string }>()
      .catch(() => ({}) as Record<string, never>);
    if (!Number.isFinite(body.cents) || (body.cents ?? 0) <= 0) {
      return Response.json({ error_code: "bad_request", message: "cents must be a positive number" }, { status: 400 });
    }
    if (body.idempotency_key) {
      const existing = queryOne<{ balance_after_cents: number }>(
        this.ctx.storage.sql as never,
        "SELECT balance_after_cents FROM wallet_ledger WHERE project_id = ? AND idempotency_key = ?",
        projectId, body.idempotency_key
      );
      if (existing) return Response.json({ balance_cents: existing.balance_after_cents, deduplicated: true });
    }
    const debit = Math.ceil(body.cents!);
    const balance = this.walletBalance(projectId);
    if (debit > balance) {
      return Response.json({ error_code: "insufficient_balance", balance_cents: balance }, { status: 402 });
    }
    const balanceAfter = balance - debit;
    execute(
      this.ctx.storage.sql as never,
      `INSERT INTO wallet_ledger (id, project_id, space_id, delta_cents, currency, reason, balance_after_cents, idempotency_key)
       VALUES (?, ?, ?, ?, 'USD', ?, ?, ?)`,
      crypto.randomUUID(), projectId, project.space_id, -debit, body.reason ?? "wallet_charge", balanceAfter, body.idempotency_key ?? null
    );
    await this.fireMatchingTriggers(
      { type: "wallet.debited", space_id: project.space_id, project_id: projectId, occurred_at: Date.now(), payload: { cents: debit, balance_cents: balanceAfter, reason: body.reason ?? null } },
      tenantId
    );
    await broadcastSpaceEvent(this.env, tenantId, project.space_id, "wallet.debited", { project_id: projectId, balance_cents: balanceAfter });
    // Low-balance signal (fixed $5 threshold) — lets a builder wire a no-code trigger to prompt
    // a top-up before the wallet actually runs dry and starts rejecting debits.
    if (balanceAfter < 500) {
      await this.fireMatchingTriggers(
        { type: "wallet.low_balance", space_id: project.space_id, project_id: projectId, occurred_at: Date.now(), payload: { balance_cents: balanceAfter } },
        tenantId
      );
    }
    return Response.json({ balance_cents: balanceAfter }, { status: 200 });
  }

  private listWalletHistory(projectId: string, params: URLSearchParams): Response {
    const project = this.requireWalletProject(projectId);
    if (!project) return Response.json({ error_code: "not_found", message: "Not a wallet project" }, { status: 404 });
    const limit = Math.min(parseInt(params.get("limit") ?? "50", 10) || 50, 200);
    const rows = queryAll<{ id: string; delta_cents: number; currency: string; reason: string; balance_after_cents: number; created_at: string }>(
      this.ctx.storage.sql as never,
      "SELECT id, delta_cents, currency, reason, balance_after_cents, created_at FROM wallet_ledger WHERE project_id = ? ORDER BY created_at DESC LIMIT ?",
      projectId, limit
    );
    return Response.json({ data: rows });
  }

  // ── project_rules — no-code "after the customer says X, this happens" triggers ─────────
  private listProjectRules(projectId: string): Response {
    const rows = queryAll<{
      id: string; project_id: string; trigger_pattern: string; action: string;
      reply_text: string | null; script_name: string | null; enabled: number; priority: number; created_at: string;
    }>(
      this.ctx.storage.sql as never,
      "SELECT * FROM project_rules WHERE project_id = ? ORDER BY priority DESC, created_at",
      projectId
    );
    return Response.json({ data: rows, count: rows.length });
  }

  private async createProjectRule(projectId: string, request: Request): Promise<Response> {
    const project = queryOne<{ id: string; space_id: string }>(this.ctx.storage.sql as never, "SELECT id, space_id FROM projects WHERE id = ?", projectId);
    if (!project) return Response.json({ error_code: "not_found", message: "Project not found" }, { status: 404 });

    const body = await request.json<{
      trigger_pattern: string;
      action: "reply" | "run_script" | "human_takeover";
      reply_text?: string;
      script_name?: string;
      priority?: number;
    }>().catch(() => ({}) as Record<string, never>);

    if (!body.trigger_pattern || !body.action) {
      return Response.json({ error_code: "bad_request", message: "trigger_pattern and action are required" }, { status: 400 });
    }
    if (!["reply", "run_script", "human_takeover"].includes(body.action)) {
      return Response.json({ error_code: "bad_request", message: "action must be 'reply', 'run_script', or 'human_takeover'" }, { status: 400 });
    }
    if (body.action === "reply" && !body.reply_text) {
      return Response.json({ error_code: "bad_request", message: "reply_text is required when action is 'reply'" }, { status: 400 });
    }
    if (body.action === "run_script" && !body.script_name) {
      return Response.json({ error_code: "bad_request", message: "script_name is required when action is 'run_script'" }, { status: 400 });
    }

    const id = crypto.randomUUID();
    const now = new Date().toISOString();
    execute(
      this.ctx.storage.sql as never,
      `INSERT INTO project_rules (id, project_id, space_id, trigger_pattern, action, reply_text, script_name, enabled, priority, created_at)
       VALUES (?, ?, ?, ?, ?, ?, ?, 1, ?, ?)`,
      id, projectId, project.space_id, body.trigger_pattern, body.action, body.reply_text ?? null, body.script_name ?? null, body.priority ?? 0, now
    );
    return Response.json({ id, project_id: projectId, trigger_pattern: body.trigger_pattern, action: body.action, created_at: now }, { status: 201 });
  }

  private deleteProjectRule(projectId: string, ruleId: string): Response {
    execute(this.ctx.storage.sql as never, "DELETE FROM project_rules WHERE id = ? AND project_id = ?", ruleId, projectId);
    return Response.json({ deleted: true });
  }

  // ── Container Marketplace slots (§A1.17 Phase L) ────────────────────────────────────────
  // Catalogue validation (does image_id exist? is it available? does the space's plan allow
  // another slot?) happens at the spaces-worker route level, which owns the cross-worker
  // catalogue lookup (mirrors project templates' own split: SpaceDO is dumb CRUD, the worker
  // layer holds business rules). This DO still enforces a hard sanity ceiling independently —
  // defense in depth, same precedent as reserved-capabilities.ts's belt-and-suspenders checks.
  private static readonly MAX_SLOTS_PER_PROJECT_HARD_CEILING = 10;

  private listContainerSlots(projectId: string): Response {
    const rows = queryAll<{
      id: string; project_id: string; image_id: string; slot_name: string; status: string; created_at: string; updated_at: string;
    }>(
      this.ctx.storage.sql as never,
      "SELECT * FROM container_slots WHERE project_id = ? ORDER BY created_at",
      projectId
    );
    return Response.json({ data: rows, count: rows.length });
  }

  private async createContainerSlot(projectId: string, request: Request): Promise<Response> {
    const project = queryOne<{ id: string; space_id: string }>(this.ctx.storage.sql as never, "SELECT id, space_id FROM projects WHERE id = ?", projectId);
    if (!project) return Response.json({ error_code: "not_found", message: "Project not found" }, { status: 404 });

    const body = await request.json<{ image_id: string; slot_name?: string }>().catch(() => ({}) as Record<string, never>);
    if (!body.image_id) return Response.json({ error_code: "bad_request", message: "image_id is required" }, { status: 400 });

    const existing = queryAll<{ id: string }>(this.ctx.storage.sql as never, "SELECT id FROM container_slots WHERE project_id = ?", projectId);
    if (existing.length >= SpaceDO.MAX_SLOTS_PER_PROJECT_HARD_CEILING) {
      return Response.json({ error_code: "slot_limit_reached", message: `A project may not exceed ${SpaceDO.MAX_SLOTS_PER_PROJECT_HARD_CEILING} container slots` }, { status: 409 });
    }

    const id = crypto.randomUUID();
    const now = new Date().toISOString();
    execute(
      this.ctx.storage.sql as never,
      `INSERT INTO container_slots (id, project_id, space_id, image_id, slot_name, status, created_at, updated_at)
       VALUES (?, ?, ?, ?, ?, 'provisioning', ?, ?)`,
      id, projectId, project.space_id, body.image_id, body.slot_name ?? "", now, now
    );
    return Response.json({ id, project_id: projectId, image_id: body.image_id, status: "provisioning", created_at: now }, { status: 201 });
  }

  private deleteContainerSlot(projectId: string, slotId: string): Response {
    execute(this.ctx.storage.sql as never, "DELETE FROM container_slots WHERE id = ? AND project_id = ?", slotId, projectId);
    return Response.json({ deleted: true });
  }

  // ── Local-machine-as-container permission grants (§A1.17 Phase M) ───────────────
  // Business-rule validation (grant_type shape, directory/commands requirements) lives in the
  // spaces worker, same split as container-slots above; this DO independently enforces a hard
  // per-space ceiling as defense in depth.
  private static readonly MAX_LOCAL_GRANTS_PER_SPACE_HARD_CEILING = 25;

  // §A1.17 Phase S: filterUserId narrows the list to one user's own grants — the spaces-worker
  // route sets this from the CALLER's own verified identity for a product_end_user (a business
  // member), never a client-supplied field, so one member can't browse another's local-machine
  // grants (directory paths are sensitive). A builder/owner JWT caller sees the whole space's
  // grants unfiltered, unchanged from before this pass.
  // filterProjectId mirrors local-machine.ts's own grant-resolution rule exactly (a grant with
  // project_id NULL applies space-wide/to any project; one with project_id set applies only to
  // that project) — so a project-scoped panel sees the grants that would actually apply to a run
  // in that project, not a naive exact-match that would hide the space-wide ones.
  private listLocalGrants(spaceId: string, filterUserId?: string, filterProjectId?: string): Response {
    const conditions = ["space_id = ?"];
    const params: unknown[] = [spaceId];
    if (filterUserId) {
      conditions.push("user_id = ?");
      params.push(filterUserId);
    }
    if (filterProjectId) {
      conditions.push("(project_id IS NULL OR project_id = ?)");
      params.push(filterProjectId);
    }
    const rows = queryAll<{
      id: string; space_id: string; project_id: string | null; user_id: string;
      grant_type: string; directory: string | null; commands_json: string; created_at: string;
    }>(
      this.ctx.storage.sql as never,
      `SELECT * FROM local_grants WHERE ${conditions.join(" AND ")} ORDER BY created_at`,
      ...params
    );
    const data = rows.map((r) => ({ ...r, commands: JSON.parse(r.commands_json || "[]") as string[] }));
    return Response.json({ data, count: data.length });
  }

  private async createLocalGrant(spaceId: string, request: Request): Promise<Response> {
    const body = await request
      .json<{ user_id: string; grant_type: string; directory?: string | null; commands?: string[]; project_id?: string | null }>()
      .catch(() => ({}) as Record<string, never>);
    if (!body.user_id || !body.grant_type) {
      return Response.json({ error_code: "bad_request", message: "user_id and grant_type are required" }, { status: 400 });
    }

    const existing = queryAll<{ id: string }>(this.ctx.storage.sql as never, "SELECT id FROM local_grants WHERE space_id = ?", spaceId);
    if (existing.length >= SpaceDO.MAX_LOCAL_GRANTS_PER_SPACE_HARD_CEILING) {
      return Response.json(
        { error_code: "grant_limit_reached", message: `A space may not exceed ${SpaceDO.MAX_LOCAL_GRANTS_PER_SPACE_HARD_CEILING} local grants` },
        { status: 409 }
      );
    }

    const id = crypto.randomUUID();
    const now = new Date().toISOString();
    execute(
      this.ctx.storage.sql as never,
      `INSERT INTO local_grants (id, space_id, project_id, user_id, grant_type, directory, commands_json, created_at)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
      id, spaceId, body.project_id ?? null, body.user_id, body.grant_type, body.directory ?? null,
      JSON.stringify(body.commands ?? []), now
    );
    return Response.json(
      { id, space_id: spaceId, project_id: body.project_id ?? null, user_id: body.user_id, grant_type: body.grant_type, created_at: now },
      { status: 201 }
    );
  }

  private deleteLocalGrant(spaceId: string, grantId: string): Response {
    execute(this.ctx.storage.sql as never, "DELETE FROM local_grants WHERE id = ? AND space_id = ?", grantId, spaceId);
    return Response.json({ deleted: true });
  }

  // ── Space Assistant approval policy ──────────────────────────────────────────
  // "Same access as the owning user, but ask before acting unless the user has explicitly
  // trusted this action." always_ask (default) gates everything except auto_approved_actions;
  // yolo skips asking entirely. User-controlled, never settable by the assistant itself —
  // only this space-worker route (owner-authenticated) can change it.
  private getAssistantPolicy(spaceId: string): Response {
    const row = queryOne<{ space_id: string; approval_mode: string; auto_approved_actions: string; updated_at: string }>(
      this.ctx.storage.sql as never,
      "SELECT * FROM assistant_policy WHERE space_id = ?",
      spaceId
    );
    if (!row) {
      return Response.json({ space_id: spaceId, approval_mode: "always_ask", auto_approved_actions: [] });
    }
    return Response.json({ ...row, auto_approved_actions: safeJsonParseArr(row.auto_approved_actions) });
  }

  private async updateAssistantPolicy(spaceId: string, request: Request): Promise<Response> {
    const body = await request.json<{
      approval_mode?: "always_ask" | "yolo";
      auto_approved_actions?: string[];
    }>().catch(() => ({}) as Record<string, never>);

    if (body.approval_mode !== undefined && body.approval_mode !== "always_ask" && body.approval_mode !== "yolo") {
      return Response.json({ error_code: "bad_request", message: "approval_mode must be 'always_ask' or 'yolo'" }, { status: 400 });
    }

    const existing = queryOne<{ approval_mode: string; auto_approved_actions: string }>(
      this.ctx.storage.sql as never,
      "SELECT approval_mode, auto_approved_actions FROM assistant_policy WHERE space_id = ?",
      spaceId
    );
    const approvalMode = body.approval_mode ?? existing?.approval_mode ?? "always_ask";
    const autoApproved = body.auto_approved_actions ?? (existing ? safeJsonParseArr(existing.auto_approved_actions) : []);
    const now = new Date().toISOString();

    execute(
      this.ctx.storage.sql as never,
      `INSERT INTO assistant_policy (space_id, approval_mode, auto_approved_actions, updated_at) VALUES (?, ?, ?, ?)
       ON CONFLICT(space_id) DO UPDATE SET approval_mode = excluded.approval_mode, auto_approved_actions = excluded.auto_approved_actions, updated_at = excluded.updated_at`,
      spaceId, approvalMode, JSON.stringify(autoApproved), now
    );
    return this.getAssistantPolicy(spaceId);
  }

  // ── Agent API keys (§A1.17 Phase O) ──────────────────────────────────────────
  // Mirrors BuilderAccountDO's api_keys pattern exactly (hash + short prefix persisted, raw
  // key returned exactly once at mint time and never stored). One space's agent_api_keys table
  // holds keys for every agent provisioned in this space — an agentId is not itself unique
  // cross-space, but this DO only ever sees its own space's rows.
  private async createAgentApiKey(agentId: string): Promise<Response> {
    const id = crypto.randomUUID();
    const rawKey = `nak_${crypto.randomUUID().replace(/-/g, "")}`;
    const keyHash = await sha256Hex(rawKey);
    const keyPrefix = rawKey.slice(0, 11); // "nak_" + 7 chars
    const now = new Date().toISOString();
    execute(
      this.ctx.storage.sql as never,
      `INSERT INTO agent_api_keys (id, agent_id, key_hash, key_prefix, created_at) VALUES (?, ?, ?, ?, ?)`,
      id, agentId, keyHash, keyPrefix, now
    );
    return Response.json(
      { id, agent_id: agentId, key: rawKey, key_prefix: keyPrefix, created_at: now },
      { status: 201 }
    );
  }

  private listAgentApiKeys(agentId: string): Response {
    const rows = queryAll<{ id: string; agent_id: string; key_prefix: string; last_used_at: string | null; revoked_at: string | null; created_at: string }>(
      this.ctx.storage.sql as never,
      `SELECT id, agent_id, key_prefix, last_used_at, revoked_at, created_at FROM agent_api_keys WHERE agent_id = ? ORDER BY created_at DESC`,
      agentId
    );
    return Response.json({ data: rows });
  }

  private revokeAgentApiKey(agentId: string, keyId: string): Response {
    execute(
      this.ctx.storage.sql as never,
      "UPDATE agent_api_keys SET revoked_at = ? WHERE id = ? AND agent_id = ? AND revoked_at IS NULL",
      new Date().toISOString(), keyId, agentId
    );
    return Response.json({ revoked: true, id: keyId });
  }

  /** POST /internal/agent-keys/verify — { space_id, key } -> { valid, agent_id?, approval_mode?,
   *  auto_approved_actions? }. The approval-policy fields are folded into the SAME round trip
   *  the router already makes to verify the key, rather than a second call per request. */
  private async verifyAgentApiKey(request: Request): Promise<Response> {
    const body = await request.json<{ space_id?: string; key?: string }>().catch(() => ({}) as Record<string, never>);
    if (!body.key || !body.key.startsWith("nak_") || !body.space_id) return Response.json({ valid: false });
    const keyHash = await sha256Hex(body.key);
    const row = queryOne<{ id: string; agent_id: string }>(
      this.ctx.storage.sql as never,
      "SELECT id, agent_id FROM agent_api_keys WHERE key_hash = ? AND revoked_at IS NULL",
      keyHash
    );
    if (!row) return Response.json({ valid: false });
    execute(this.ctx.storage.sql as never, "UPDATE agent_api_keys SET last_used_at = ? WHERE id = ?", new Date().toISOString(), row.id);
    const policy = this.resolveAgentPolicy(body.space_id, row.agent_id);
    return Response.json({ valid: true, agent_id: row.agent_id, ...policy });
  }

  /** Resolve an agent's effective approval policy: its own agent_policy_overrides row if one
   *  exists, else the space-wide assistant_policy row, else the fail-closed default
   *  (always_ask, nothing pre-approved) — same three-step fallback fetchAssistantPolicy already
   *  documents for the Space Assistant itself. */
  private resolveAgentPolicy(spaceId: string, agentId: string): { approval_mode: "always_ask" | "yolo"; auto_approved_actions: string[] } {
    const override = queryOne<{ approval_mode: string; auto_approved_actions: string }>(
      this.ctx.storage.sql as never,
      "SELECT approval_mode, auto_approved_actions FROM agent_policy_overrides WHERE space_id = ? AND agent_id = ?",
      spaceId, agentId
    );
    if (override) {
      return { approval_mode: override.approval_mode as "always_ask" | "yolo", auto_approved_actions: safeJsonParseArr(override.auto_approved_actions) as string[] };
    }
    const spaceWide = queryOne<{ approval_mode: string; auto_approved_actions: string }>(
      this.ctx.storage.sql as never,
      "SELECT approval_mode, auto_approved_actions FROM assistant_policy WHERE space_id = ?",
      spaceId
    );
    if (spaceWide) {
      return { approval_mode: spaceWide.approval_mode as "always_ask" | "yolo", auto_approved_actions: safeJsonParseArr(spaceWide.auto_approved_actions) as string[] };
    }
    return { approval_mode: "always_ask", auto_approved_actions: [] };
  }

  private getAgentPolicy(spaceId: string, agentId: string): Response {
    const policy = this.resolveAgentPolicy(spaceId, agentId);
    return Response.json({ space_id: spaceId, agent_id: agentId, ...policy });
  }

  private async updateAgentPolicy(spaceId: string, agentId: string, request: Request): Promise<Response> {
    const body = await request.json<{ approval_mode?: "always_ask" | "yolo"; auto_approved_actions?: string[] }>().catch(() => ({}) as Record<string, never>);
    if (body.approval_mode !== undefined && body.approval_mode !== "always_ask" && body.approval_mode !== "yolo") {
      return Response.json({ error_code: "bad_request", message: "approval_mode must be 'always_ask' or 'yolo'" }, { status: 400 });
    }
    const existing = this.resolveAgentPolicy(spaceId, agentId);
    const approvalMode = body.approval_mode ?? existing.approval_mode;
    const autoApproved = body.auto_approved_actions ?? existing.auto_approved_actions;
    const now = new Date().toISOString();
    execute(
      this.ctx.storage.sql as never,
      `INSERT INTO agent_policy_overrides (space_id, agent_id, approval_mode, auto_approved_actions, updated_at) VALUES (?, ?, ?, ?, ?)
       ON CONFLICT(space_id, agent_id) DO UPDATE SET approval_mode = excluded.approval_mode, auto_approved_actions = excluded.auto_approved_actions, updated_at = excluded.updated_at`,
      spaceId, agentId, approvalMode, JSON.stringify(autoApproved), now
    );
    return this.getAgentPolicy(spaceId, agentId);
  }

  // ── Threads (spec-canonical) ─────────────────────────────────────────────────
  // A sub-agent run or a channel conversation mirrors in here as an ordinary thread —
  // thread_kind='sub_agent'/'channel' plus parent_thread_id, not a separate concept. Default
  // listing hides them (thread_kind != 'primary') so a project's builder-facing thread list
  // isn't flooded by a 16-way sub-agent fan-out or a busy WhatsApp bot; a project can opt in
  // via show_sub_threads, or any caller can ask for them explicitly via include_sub_threads.
  private listThreads(params: URLSearchParams): Response {
    const spaceId = params.get("space_id") ?? "";
    const projectId = params.get("project_id");
    const parentThreadId = params.get("parent_thread_id");
    let showSubThreads = params.get("include_sub_threads") === "true";
    if (!showSubThreads && projectId) {
      const project = queryOne<{ show_sub_threads: number }>(
        this.ctx.storage.sql as never,
        "SELECT show_sub_threads FROM projects WHERE id = ?",
        projectId
      );
      showSubThreads = project?.show_sub_threads === 1;
    }

    const clauses = ["space_id = ?"];
    const args: unknown[] = [spaceId];
    if (projectId) {
      clauses.push("project_id = ?");
      args.push(projectId);
    }
    // An explicit parent_thread_id ask (the shell's "show what the assistant discussed with the
    // agent about this thread" panel, or the assistant's own thread.list op) is always answered
    // in full regardless of the project's show_sub_threads default — the caller named exactly
    // which subthreads it wants, not "give me everything hidden by default".
    if (parentThreadId) {
      clauses.push("parent_thread_id = ?");
      args.push(parentThreadId);
    } else if (!showSubThreads) {
      clauses.push("thread_kind = 'primary'");
    }

    const rows = queryAll(
      this.ctx.storage.sql as never,
      `SELECT * FROM threads WHERE ${clauses.join(" AND ")} ORDER BY created_at DESC LIMIT 200`,
      ...args
    );
    return Response.json({ data: rows, count: rows.length });
  }

  /**
   * projects.max_threads (0 = unlimited) caps how many "real" conversations a project hosts at
   * once — primary threads and channel sessions, deliberately NOT sub_agent fan-out (that's
   * already bounded by MAX_SUB_AGENTS_PER_SPAWN/ConcurrencyDO, and counting ephemeral
   * orchestration threads toward a builder-facing limit would be surprising). Only archived
   * threads don't count, so archiving old conversations reopens room under the cap.
   */
  private isThreadLimitReached(projectId: string | null | undefined, kind: string): boolean {
    if (!projectId || kind === "sub_agent") return false;
    const project = queryOne<{ max_threads: number }>(
      this.ctx.storage.sql as never, "SELECT max_threads FROM projects WHERE id = ?", projectId
    );
    if (!project || project.max_threads <= 0) return false;
    const countRow = queryOne<{ n: number }>(
      this.ctx.storage.sql as never,
      "SELECT COUNT(*) as n FROM threads WHERE project_id = ? AND status = 'active' AND thread_kind IN ('primary','channel')",
      projectId
    );
    return (countRow?.n ?? 0) >= project.max_threads;
  }

  private async createThread(request: Request): Promise<Response> {
    const body = await request.json<{
      id?: string;
      space_id: string;
      user_id?: string;
      project_id: string;
      title?: string;
      parent_thread_id?: string;
      thread_kind?: "primary" | "sub_agent" | "channel";
      channel?: string;
      channel_session_id?: string;
      tenant_id?: string;
      session_id?: string;
    }>().catch(() => ({}) as Record<string, never>);
    if (!body.space_id) {
      return Response.json({ error_code: "bad_request", message: "space_id is required" }, { status: 400 });
    }
    const kind = body.thread_kind ?? "primary";
    if (!["primary", "sub_agent", "channel"].includes(kind)) {
      return Response.json({ error_code: "bad_request", message: "thread_kind must be 'primary', 'sub_agent', or 'channel'" }, { status: 400 });
    }
    const id = body.id ?? crypto.randomUUID();
    const now = new Date().toISOString();
    const tenantId = body.tenant_id ?? request.headers.get("x-naelao-tenant-id") ?? "";
    // thread.created only fires for a genuinely NEW thread — never on the idempotent
    // update/re-mirror branches below (a webhook retry or a repeat mirrorThread() call must
    // not re-fire triggers for a thread that already existed).
    const fireCreated = (threadId: string, projectId: string | null) =>
      this.fireMatchingTriggers({ type: "thread.created", space_id: body.space_id, ...(projectId ? { project_id: projectId } : {}), thread_id: threadId, occurred_at: Date.now() }, tenantId);

    if (body.channel_session_id) {
      // Idempotent on channel_session_id — a channel's inbound webhook retries safely and
      // re-mirroring the same session never duplicates its thread. Explicit select-then-
      // insert/update rather than ON CONFLICT: the conflict target is a partial unique index
      // (WHERE channel_session_id IS NOT NULL), which isn't a reliably portable upsert target
      // across SQLite builds — this is unambiguous everywhere.
      const existing = queryOne<{ id: string }>(
        this.ctx.storage.sql as never,
        "SELECT id FROM threads WHERE channel_session_id = ?",
        body.channel_session_id
      );
      if (existing) {
        execute(this.ctx.storage.sql as never, "UPDATE threads SET updated_at = ? WHERE id = ?", now, existing.id);
        const row = queryOne(this.ctx.storage.sql as never, "SELECT * FROM threads WHERE id = ?", existing.id);
        return Response.json(row, { status: 201 });
      }
      if (this.isThreadLimitReached(body.project_id, kind)) {
        return Response.json({ error_code: "thread_limit_reached", message: "This project has reached its configured max_threads" }, { status: 409 });
      }
      execute(
        this.ctx.storage.sql as never,
        `INSERT INTO threads (id, space_id, user_id, project_id, title, status, parent_thread_id, thread_kind, channel, channel_session_id, session_id, created_at, updated_at)
         VALUES (?, ?, ?, ?, ?, 'active', ?, ?, ?, ?, ?, ?, ?)`,
        id, body.space_id, body.user_id ?? null, body.project_id ?? null, body.title ?? null,
        body.parent_thread_id ?? null, kind, body.channel ?? null, body.channel_session_id, body.session_id ?? null, now, now
      );
      await fireCreated(id, body.project_id ?? null);
      const row = queryOne(this.ctx.storage.sql as never, "SELECT * FROM threads WHERE id = ?", id);
      return Response.json(row, { status: 201 });
    }

    const existingById = queryOne<{ id: string }>(this.ctx.storage.sql as never, "SELECT id FROM threads WHERE id = ?", id);
    if (existingById) {
      execute(this.ctx.storage.sql as never, "UPDATE threads SET updated_at = ? WHERE id = ?", now, id);
    } else {
      if (this.isThreadLimitReached(body.project_id, kind)) {
        return Response.json({ error_code: "thread_limit_reached", message: "This project has reached its configured max_threads" }, { status: 409 });
      }
      execute(
        this.ctx.storage.sql as never,
        `INSERT INTO threads (id, space_id, user_id, project_id, title, status, parent_thread_id, thread_kind, channel, channel_session_id, session_id, created_at, updated_at)
         VALUES (?, ?, ?, ?, ?, 'active', ?, ?, ?, ?, ?, ?, ?)`,
        id, body.space_id, body.user_id ?? null, body.project_id ?? null, body.title ?? null,
        body.parent_thread_id ?? null, kind, body.channel ?? null, body.channel_session_id ?? null, body.session_id ?? null, now, now
      );
      await fireCreated(id, body.project_id ?? null);
    }
    const row = queryOne(this.ctx.storage.sql as never, "SELECT * FROM threads WHERE id = ?", id);
    return Response.json(row, { status: 201 });
  }

  private getThread(threadId: string): Response {
    const row = queryOne(this.ctx.storage.sql as never, "SELECT * FROM threads WHERE id = ?", threadId);
    if (!row) return Response.json({ error_code: "not_found", message: "Thread not found" }, { status: 404 });
    return Response.json(row);
  }

  /**
   * PATCH /threads/:id — rename and/or archive a thread. There is no hard DELETE for a thread,
   * same convention `projects` already established (see updateProject): a thread's messages are
   * real conversation history, and destroying them because someone clicked "delete" is a worse
   * failure mode than leaving an inert archived row behind. `status: 'archived'` is what a
   * "delete this thread" action in the UI (or the assistant's own thread.delete op) actually
   * does — `isThreadLimitReached` already treats an archived thread as not counting toward a
   * project's max_threads, so archiving genuinely frees up room the same way a real delete would.
   */
  private async updateThread(threadId: string, request: Request): Promise<Response> {
    const body = await request.json<{ title?: string; status?: "active" | "archived" }>().catch(() => ({}) as Record<string, never>);
    if (body.status !== undefined && body.status !== "active" && body.status !== "archived") {
      return Response.json({ error_code: "bad_request", message: "status must be 'active' or 'archived'" }, { status: 400 });
    }
    const existing = queryOne<{ id: string }>(this.ctx.storage.sql as never, "SELECT id FROM threads WHERE id = ?", threadId);
    if (!existing) return Response.json({ error_code: "not_found", message: "Thread not found" }, { status: 404 });

    const sets: string[] = [];
    const args: unknown[] = [];
    if (body.title !== undefined) {
      sets.push("title = ?");
      args.push(body.title);
    }
    if (body.status !== undefined) {
      sets.push("status = ?");
      args.push(body.status);
    }
    if (sets.length === 0) {
      return Response.json({ error_code: "bad_request", message: "nothing to update — provide title and/or status" }, { status: 400 });
    }
    sets.push("updated_at = ?");
    args.push(new Date().toISOString());
    args.push(threadId);
    execute(this.ctx.storage.sql as never, `UPDATE threads SET ${sets.join(", ")} WHERE id = ?`, ...args);
    const row = queryOne(this.ctx.storage.sql as never, "SELECT * FROM threads WHERE id = ?", threadId);
    return Response.json(row);
  }

  // ── tasks (AVOS plan step 4 — a per-project task DAG) ──────────────────────────────────
  // Deliberately DUMB CRUD: whether a task's dependencies are actually satisfied before it may
  // move to in_progress is a business rule the `tasks` prebuilt script checks BEFORE calling
  // PATCH here (same separation project-coordination.ts's own validateModel/validateAgentId
  // already establish — a business rule lives with the agent-facing caller, not the store).
  private static readonly TASK_STATUSES = ["pending", "in_progress", "completed", "blocked", "cancelled"] as const;

  private listTasks(params: URLSearchParams): Response {
    const spaceId = params.get("space_id") ?? "";
    const projectId = params.get("project_id");
    const threadId = params.get("thread_id");
    const status = params.get("status");
    const clauses = ["space_id = ?"];
    const args: unknown[] = [spaceId];
    if (projectId) { clauses.push("project_id = ?"); args.push(projectId); }
    if (threadId) { clauses.push("thread_id = ?"); args.push(threadId); }
    if (status) { clauses.push("status = ?"); args.push(status); }
    const rows = queryAll<{ dependencies: string }>(
      this.ctx.storage.sql as never,
      `SELECT * FROM tasks WHERE ${clauses.join(" AND ")} ORDER BY created_at ASC LIMIT 200`,
      ...args
    );
    return Response.json({ data: rows.map((r) => ({ ...r, dependencies: safeJsonParseArr(r.dependencies) as string[] })), count: rows.length });
  }

  private async createTask(request: Request): Promise<Response> {
    const body = await request.json<{
      id?: string;
      space_id: string;
      project_id?: string;
      thread_id?: string;
      title?: string;
      status?: string;
      dependencies?: string[];
      assigned_agent?: string;
    }>().catch(() => ({}) as Record<string, never>);
    if (!body.space_id) return Response.json({ error_code: "bad_request", message: "space_id is required" }, { status: 400 });
    if (!body.title) return Response.json({ error_code: "bad_request", message: "title is required" }, { status: 400 });
    const status = body.status ?? "pending";
    if (!SpaceDO.TASK_STATUSES.includes(status as (typeof SpaceDO.TASK_STATUSES)[number])) {
      return Response.json({ error_code: "bad_request", message: `status must be one of: ${SpaceDO.TASK_STATUSES.join(", ")}` }, { status: 400 });
    }
    const id = body.id ?? crypto.randomUUID();
    const now = new Date().toISOString();
    execute(
      this.ctx.storage.sql as never,
      `INSERT INTO tasks (id, space_id, project_id, thread_id, title, status, dependencies, assigned_agent, created_at, updated_at)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      id, body.space_id, body.project_id ?? null, body.thread_id ?? null, body.title, status,
      JSON.stringify(Array.isArray(body.dependencies) ? body.dependencies.map(String) : []),
      body.assigned_agent ?? null, now, now
    );
    const row = queryOne<{ dependencies: string }>(this.ctx.storage.sql as never, "SELECT * FROM tasks WHERE id = ?", id);
    return Response.json({ ...row, dependencies: safeJsonParseArr(row!.dependencies) as string[] }, { status: 201 });
  }

  private async updateTask(taskId: string, request: Request): Promise<Response> {
    const body = await request.json<{
      title?: string;
      status?: string;
      dependencies?: string[];
      assigned_agent?: string | null;
    }>().catch(() => ({}) as Record<string, never>);
    const existing = queryOne<{ id: string }>(this.ctx.storage.sql as never, "SELECT id FROM tasks WHERE id = ?", taskId);
    if (!existing) return Response.json({ error_code: "not_found", message: "Task not found" }, { status: 404 });
    if (body.status !== undefined && !SpaceDO.TASK_STATUSES.includes(body.status as (typeof SpaceDO.TASK_STATUSES)[number])) {
      return Response.json({ error_code: "bad_request", message: `status must be one of: ${SpaceDO.TASK_STATUSES.join(", ")}` }, { status: 400 });
    }
    const sets: string[] = [];
    const args: unknown[] = [];
    if (body.title !== undefined) { sets.push("title = ?"); args.push(body.title); }
    if (body.status !== undefined) { sets.push("status = ?"); args.push(body.status); }
    if (body.dependencies !== undefined) { sets.push("dependencies = ?"); args.push(JSON.stringify(body.dependencies.map(String))); }
    if (body.assigned_agent !== undefined) { sets.push("assigned_agent = ?"); args.push(body.assigned_agent); }
    if (sets.length === 0) {
      return Response.json({ error_code: "bad_request", message: "nothing to update — provide title, status, dependencies, and/or assigned_agent" }, { status: 400 });
    }
    sets.push("updated_at = ?");
    args.push(new Date().toISOString());
    args.push(taskId);
    execute(this.ctx.storage.sql as never, `UPDATE tasks SET ${sets.join(", ")} WHERE id = ?`, ...args);
    const row = queryOne<{ dependencies: string }>(this.ctx.storage.sql as never, "SELECT * FROM tasks WHERE id = ?", taskId);
    return Response.json({ ...row, dependencies: safeJsonParseArr(row!.dependencies) as string[] });
  }

  private deleteTask(taskId: string): Response {
    const existing = queryOne<{ id: string }>(this.ctx.storage.sql as never, "SELECT id FROM tasks WHERE id = ?", taskId);
    if (!existing) return Response.json({ error_code: "not_found", message: "Task not found" }, { status: 404 });
    execute(this.ctx.storage.sql as never, "DELETE FROM tasks WHERE id = ?", taskId);
    return Response.json({ ok: true, deleted: taskId });
  }

  // ── Event triggers (@naelao/events) — no-code "after X happens, run script Y" ─────────────
  private listEventTriggers(params: URLSearchParams): Response {
    const spaceId = params.get("space_id") ?? "";
    const projectId = params.get("project_id");
    const clauses = ["space_id = ?"];
    const args: unknown[] = [spaceId];
    if (projectId) {
      clauses.push("(project_id = ? OR project_id IS NULL)");
      args.push(projectId);
    }
    const rows = queryAll<EventTriggerRow>(
      this.ctx.storage.sql as never,
      `SELECT * FROM event_triggers WHERE ${clauses.join(" AND ")} ORDER BY priority DESC, created_at`,
      ...args
    );
    const data = rows.map(rowToTriggerRule);
    return Response.json({ data, count: data.length });
  }

  private async createEventTrigger(request: Request): Promise<Response> {
    const body = await request.json<{
      space_id: string;
      project_id?: string;
      event_type: string;
      condition?: TriggerCondition;
      script_name: string;
      params?: Record<string, unknown>;
      priority?: number;
    }>().catch(() => ({}) as Record<string, never>);

    if (!body.space_id || !body.project_id || !body.event_type || !body.script_name) {
      return Response.json({ error_code: "bad_request", message: "space_id, project_id, event_type, and script_name are required" }, { status: 400 });
    }
    const project = queryOne<{ space_id: string; status: string }>(this.ctx.storage.sql as never,
      "SELECT space_id, status FROM projects WHERE id = ?", body.project_id);
    if (!project || project.space_id !== body.space_id || project.status !== "active") {
      return Response.json({ error_code: "not_found", message: "Project not found in this space" }, { status: 404 });
    }

    const id = crypto.randomUUID();
    const now = new Date().toISOString();
    execute(
      this.ctx.storage.sql as never,
      `INSERT INTO event_triggers (id, space_id, project_id, event_type, condition, script_name, params, enabled, priority, created_at)
       VALUES (?, ?, ?, ?, ?, ?, ?, 1, ?, ?)`,
      id, body.space_id, body.project_id, body.event_type,
      JSON.stringify(body.condition ?? { type: "always" }), body.script_name,
      JSON.stringify(body.params ?? {}), body.priority ?? 0, now
    );
    return Response.json(
      { id, space_id: body.space_id, project_id: body.project_id, event_type: body.event_type, script_name: body.script_name, created_at: now },
      { status: 201 }
    );
  }

  private deleteEventTrigger(spaceId: string, triggerId: string): Response {
    execute(this.ctx.storage.sql as never, "DELETE FROM event_triggers WHERE id = ? AND space_id = ?", triggerId, spaceId);
    return Response.json({ deleted: true });
  }

  /**
   * Resolves what `last_active_thread_idle` needs: the most recently updated OTHER thread in
   * the SAME scope as the trigger (its project, or the whole space when the trigger is
   * space-wide), excluding the thread that fired the event. Scoped by construction — this
   * query can never see a different project's threads, so a project-scoped trigger can never
   * resolve (and therefore never fire against) a thread outside its own project.
   */
  private resolveLastActiveOtherThread(spaceId: string, projectId: string | undefined, excludeThreadId: string): { id: string; updated_at_ms: number } | undefined {
    const clauses = ["space_id = ?", "id != ?", "thread_kind = 'primary'"];
    const args: unknown[] = [spaceId, excludeThreadId];
    if (projectId) {
      clauses.push("project_id = ?");
      args.push(projectId);
    }
    const row = queryOne<{ id: string; updated_at: string }>(
      this.ctx.storage.sql as never,
      `SELECT id, updated_at FROM threads WHERE ${clauses.join(" AND ")} ORDER BY updated_at DESC, rowid DESC LIMIT 1`,
      ...args
    );
    if (!row) return undefined;
    return { id: row.id, updated_at_ms: Date.parse(row.updated_at) };
  }

  /**
   * POST /internal/events/fire body — an external caller (outside this DO) supplying an event
   * for fireMatchingTriggers to evaluate. tenantId comes from the caller's own verified
   * internal token (requireInternalHmac already checked it matches x-naelao-tenant-id before
   * this request reached the DO), same trust boundary as every other internal-only route.
   *
   * Read from the QUERY STRING, not a header — forwardToSpaceDO (workers/spaces/src/index.ts)
   * builds a fresh Request carrying only content-type, the same reason /projects/:projectId's
   * own PATCH route already rides tenant_id on the query string (see that route's own comment).
   * A previous version of this method read x-naelao-tenant-id off request.headers, which
   * forwardToSpaceDO never actually sets — every real call (including the agents worker's
   * scheduled_job.disabled auto-disable event) would 400 here and never fire, undetected by
   * space-fire-external-event.test.ts because that suite calls doInstance.fetch() directly with
   * a hand-set header, never exercising the real HTTP round trip through the worker. Falls back
   * to the header too, in case some future caller reaches this DO directly with one set.
   */
  private async fireExternalEvent(request: Request): Promise<Response> {
    const url = new URL(request.url);
    const tenantId = request.headers.get("x-naelao-tenant-id") || url.searchParams.get("tenant_id") || "";
    const body = await request.json<{
      type: string;
      space_id: string;
      project_id?: string;
      thread_id?: string;
      occurred_at?: number;
      payload?: Record<string, unknown>;
    }>();
    if (!tenantId || !body.type || !body.space_id) {
      return Response.json({ error_code: "bad_request", message: "type and space_id are required" }, { status: 400 });
    }
    await this.fireMatchingTriggers(
      {
        type: body.type,
        space_id: body.space_id,
        ...(body.project_id ? { project_id: body.project_id } : {}),
        ...(body.thread_id ? { thread_id: body.thread_id } : {}),
        occurred_at: body.occurred_at ?? Date.now(),
        ...(body.payload ? { payload: body.payload } : {}),
      },
      tenantId
    );
    return Response.json({ fired: true });
  }

  /**
   * Evaluates and fires every event_triggers row that matches `event` — best-effort, never
   * blocks or fails the state change (thread/project creation) that produced the event.
   * Firing means calling out to the agents worker's internal script.run route; the actual
   * work is entirely in whatever script the trigger names (@naelao/events: "the action is
   * always run_script, not a new action-type surface to keep in sync with the engine").
   */
  private async fireMatchingTriggers(event: EventEnvelope, tenantId: string): Promise<void> {
    if (!this.env.AGENTS_WORKER || !tenantId) return;
    try {
      const rows = queryAll<EventTriggerRow>(
        this.ctx.storage.sql as never,
        "SELECT * FROM event_triggers WHERE space_id = ? AND event_type = ? AND enabled = 1",
        event.space_id, event.type
      );
      const rules = selectMatchingRules(rows.map(rowToTriggerRule), event);
      for (const rule of rules.slice(0, 5)) { // bound worst-case fan-out per single event
        let ctx: ConditionContext = {};
        if (rule.condition.type === "last_active_thread_idle") {
          const other = this.resolveLastActiveOtherThread(event.space_id, rule.project_id ?? undefined, event.thread_id ?? "");
          if (other) ctx = { lastActiveOtherThread: other };
        }
        const result = evaluateCondition(rule.condition, ctx);
        if (!result.matched) continue;
        const params = buildFireParams(rule.action, event, result);
        // B3 fix: the static "x-naelao-internal: spaces-trigger" string was forgeable by
        // anyone who could reach the agents worker directly. Mint the same HMAC token
        // naelao-router's proxyTo attaches, verified by requireInternalHmac on the target route.
        const internalToken = await mintInternalToken(this.env.PLATFORM_SECRET, tenantId);
        await this.env.AGENTS_WORKER.fetch(new Request("http://agents-worker/internal/triggers/fire", {
          method: "POST",
          headers: {
            "content-type": "application/json",
            "x-naelao-tenant-id": tenantId,
            "x-naelao-internal-token": internalToken,
          },
          body: JSON.stringify({
            spaceId: event.space_id,
            tenantId,
            scriptName: rule.action.script_name,
            params,
            // The fired script inherits its trigger's own project scoping (e.g. so a
            // project's compact script reads/writes that project's workspace, not the
            // space-wide one) — never the event's, in case a space-wide trigger fires for a
            // project-scoped event.
            ...(rule.project_id ? { projectId: rule.project_id } : {}),
          }),
        }));
      }
    } catch {
      /* best-effort — a firing failure must never surface as a failure of the thing that happened */
    }
  }

  // G-AO17: Record a prompt injection attempt for a user and check if they are now rate-limited.
  // Rate limit: 3 attempts within 1 hour triggers block.
  private async recordInjectionAttempt(request: Request): Promise<Response> {
    const body = await request.json<{ end_user_id: string; space_id: string }>();
    if (!body.end_user_id) {
      return Response.json({ error_code: "bad_request", message: "end_user_id is required" }, { status: 400 });
    }

    const id = crypto.randomUUID();
    const now = new Date().toISOString();
    execute(
      this.ctx.storage.sql as never,
      "INSERT INTO injection_attempts (id, space_id, end_user_id, detected_at) VALUES (?, ?, ?, ?)",
      id,
      body.space_id ?? "",
      body.end_user_id,
      now
    );

    // Count attempts within the last 1 hour
    const oneHourAgo = new Date(Date.now() - 3_600_000).toISOString();
    const row = queryOne<{ cnt: number }>(
      this.ctx.storage.sql as never,
      "SELECT COUNT(*) as cnt FROM injection_attempts WHERE end_user_id = ? AND detected_at > ?",
      body.end_user_id,
      oneHourAgo
    );
    const count = row?.cnt ?? 0;
    const rateLimited = count >= 3;

    if (rateLimited) {
      // Cache the deny to fast-path future requests
      this.cacheDeny(body.end_user_id, body.space_id ?? "");
    }

    return Response.json({ recorded: true, attempts_last_hour: count, rate_limited: rateLimited });
  }

  // ── space registry / hierarchy methods (spec §10 SpaceDO + §49) ──────────────

  // POST /spaces — register/refresh the root space row. Idempotent: the provisioner
  // calls this at step N so the SpaceDO knows its own tenancy + agency_shell. depth=0.
  private async upsertRootSpace(request: Request): Promise<Response> {
    const body = await request.json<{
      id: string;
      name: string;
      space_type: string;
      tenancy_mode?: "single" | "team" | "saas";
      agency_shell?: boolean;
      parent_id?: string | null;
      depth?: number;
      settings?: Record<string, unknown>;
    }>();
    if (!body.id || !body.name || !body.space_type) {
      return Response.json({ error_code: "bad_request", message: "id, name, space_type are required" }, { status: 400 });
    }
    if (body.space_type !== "launchpad") {
      return Response.json({ error_code: "invalid_hierarchy", message: "Only Launchpad spaces are supported" }, { status: 400 });
    }
    if (body.parent_id || (body.depth !== undefined && body.depth !== 0)) {
      return Response.json({ error_code: "invalid_hierarchy", message: "A root space cannot have a parent or non-zero depth" }, { status: 400 });
    }
    execute(
      this.ctx.storage.sql as never,
      `INSERT INTO spaces (id, parent_id, name, space_type, tenancy_mode, agency_shell, depth, scenario_type, status, settings, created_at)
       VALUES (?, NULL, ?, ?, ?, ?, 0, NULL, 'active', ?, ?)
       ON CONFLICT(id) DO UPDATE SET
         name = excluded.name,
         space_type = excluded.space_type,
         tenancy_mode = excluded.tenancy_mode,
         agency_shell = excluded.agency_shell,
         settings = excluded.settings`,
      body.id,
      body.name,
      body.space_type,
      body.tenancy_mode ?? "team",
      body.agency_shell ? 1 : 0,
      JSON.stringify(body.settings ?? {}),
      new Date().toISOString()
    );
    return Response.json({ id: body.id, depth: 0, status: "active" }, { status: 201 });
  }

  private listSpaceRows(): Response {
    const rows = queryAll<SpaceRow>(
      this.ctx.storage.sql as never,
      "SELECT * FROM spaces WHERE status != 'deleted' ORDER BY depth ASC, created_at ASC"
    );
    return Response.json({ data: rows.map(this.serializeSpaceRow) });
  }

  // POST /sub-spaces — create an in-DO sub-space (department) for tenancy_mode='team'.
  // Enforces: parent exists, depth <= 2, mixed space_type only when parent.agency_shell,
  // end-user sessions (forceParentType=true) always inherit the parent's space_type.
  private async createSubSpaceRow(request: Request): Promise<Response> {
    const body = await request.json<{
      id?: string;
      parent_id: string;
      name: string;
      space_type?: string;
      scenario_type?: "organizational" | "agency-child" | "user-workspace";
      force_parent_type?: boolean;
      settings?: Record<string, unknown>;
    }>();
    if (!body.parent_id || !body.name) {
      return Response.json({ error_code: "bad_request", message: "parent_id and name are required" }, { status: 400 });
    }

    const parent = queryOne<SpaceRow>(
      this.ctx.storage.sql as never,
      "SELECT * FROM spaces WHERE id = ? AND status != 'deleted'",
      body.parent_id
    );
    if (!parent) {
      return Response.json({ error_code: "not_found", message: "Parent space not found" }, { status: 404 });
    }

    if (parent.space_type !== "launchpad") {
      return Response.json({ error_code: "invalid_hierarchy", message: "Departments require a Launchpad parent" }, { status: 400 });
    }
    if (body.space_type && body.space_type !== "launchpad") {
      return Response.json({ error_code: "invalid_hierarchy", message: "Only Launchpad departments are supported" }, { status: 400 });
    }
    // The hierarchy policy is exactly two levels: root plus direct departments.
    if (parent.depth >= 1 || parent.parent_id !== null) {
      return Response.json(
        { error_code: "max_depth_exceeded", message: "A department cannot have child spaces." },
        { status: 400 }
      );
    }

    // Mixed-type rule (§49): only an agency_shell parent may host a different space_type.
    // End-user-originated requests can never select a type and never create agency shells.
    let effectiveType: string;
    if (body.force_parent_type) {
      effectiveType = parent.space_type;
    } else if (body.space_type && body.space_type !== parent.space_type) {
      if (!parent.agency_shell) {
        return Response.json({
          error_code: "mixed_space_type_not_permitted",
          message: `Mixed space types are only permitted when the parent space is an agency shell. ` +
                   `Parent ${parent.id} is type '${parent.space_type}'.`,
        }, { status: 400 });
      }
      effectiveType = body.space_type;
    } else {
      effectiveType = parent.space_type;
    }

    const id = body.id ?? crypto.randomUUID();
    const depth = parent.depth + 1;
    const scenario = body.scenario_type ?? (parent.agency_shell ? "agency-child" : "organizational");
    const now = new Date().toISOString();
    execute(
      this.ctx.storage.sql as never,
      `INSERT INTO spaces (id, parent_id, name, space_type, tenancy_mode, agency_shell, depth, scenario_type, status, settings, created_at)
       VALUES (?, ?, ?, ?, ?, 0, ?, ?, 'active', ?, ?)`,
      id,
      parent.id,
      body.name,
      effectiveType,
      parent.tenancy_mode,
      depth,
      scenario,
      JSON.stringify(body.settings ?? {}),
      now
    );
    return Response.json(
      { id, parent_id: parent.id, name: body.name, space_type: effectiveType, depth, scenario_type: scenario, status: "active", created_at: now },
      { status: 201 }
    );
  }

  private getSpaceRow(id: string): Response {
    const row = queryOne<SpaceRow>(
      this.ctx.storage.sql as never,
      "SELECT * FROM spaces WHERE id = ?",
      id
    );
    if (!row) return Response.json({ error_code: "not_found", message: "Space not found" }, { status: 404 });
    return Response.json(this.serializeSpaceRow(row));
  }

  private async updateSpaceRow(id: string, request: Request): Promise<Response> {
    const body = await request.json<{ status?: string; name?: string; settings?: Record<string, unknown> }>();
    if (body.status && !["active", "suspended", "deleted"].includes(body.status)) {
      return Response.json({ error_code: "bad_request", message: "Invalid status" }, { status: 400 });
    }
    execute(
      this.ctx.storage.sql as never,
      `UPDATE spaces SET
         status   = COALESCE(?, status),
         name     = COALESCE(?, name),
         settings = COALESCE(?, settings)
       WHERE id = ?`,
      body.status ?? null,
      body.name ?? null,
      body.settings ? JSON.stringify(body.settings) : null,
      id
    );
    return Response.json({ id, updated: true });
  }

  private serializeSpaceRow(row: SpaceRow): Record<string, unknown> {
    return {
      ...row,
      agency_shell: row.agency_shell === 1,
      settings: (() => { try { return JSON.parse(row.settings) as unknown; } catch { return {}; } })(),
    };
  }

  /** Authoritative hierarchy RBAC. Membership is intentionally read only from the requested
   * space and (for a direct department) its direct parent; it is never copied or inferred in the
   * opposite direction, which prevents upward and sibling privilege propagation. */
  private authorizeHierarchy(params: URLSearchParams): Response {
    const userId = params.get("user_id") ?? "";
    const targetId = params.get("target_space_id") ?? "";
    if (!userId || !targetId) {
      return Response.json({ permitted: false, reason: "user_id and target_space_id are required" }, { status: 400 });
    }
    const target = queryOne<SpaceRow>(this.ctx.storage.sql as never,
      "SELECT * FROM spaces WHERE id = ? AND status != 'deleted'", targetId);
    if (!target || target.space_type !== "launchpad" || (target.depth === 0) !== (target.parent_id === null)) {
      return Response.json({ permitted: false, reason: "Target is not a valid Launchpad hierarchy space" }, { status: 404 });
    }
    const direct = queryOne<{ role: string }>(this.ctx.storage.sql as never,
      "SELECT role FROM space_members WHERE space_id = ? AND user_id = ?", target.id, userId);
    if (direct && (direct.role === "owner" || direct.role === "admin")) {
      return Response.json({ permitted: true, source_space_id: target.id, role: direct.role });
    }
    if (target.depth === 1 && target.parent_id) {
      const parent = queryOne<SpaceRow>(this.ctx.storage.sql as never,
        "SELECT * FROM spaces WHERE id = ? AND depth = 0 AND parent_id IS NULL AND status != 'deleted'", target.parent_id);
      const inherited = parent && queryOne<{ role: string }>(this.ctx.storage.sql as never,
        "SELECT role FROM space_members WHERE space_id = ? AND user_id = ?", parent.id, userId);
      if (inherited && (inherited.role === "owner" || inherited.role === "admin")) {
        return Response.json({ permitted: true, source_space_id: parent.id, role: inherited.role });
      }
    }
    return Response.json({ permitted: false, reason: "No administrative membership on the space or its direct parent" }, { status: 403 });
  }

  // ── cross-space grants (§49 checkPermission — fail closed) ───────────────────

  private async grantCrossSpace(request: Request): Promise<Response> {
    const body = await request.json<{
      granting_space_id: string;
      receiving_space_id: string;
      grant_type: "read-knowledge" | "read-threads" | "full-access";
      granted_by: string;
      expires_at?: string;
    }>();
    if (!body.granting_space_id || !body.receiving_space_id || !body.grant_type || !body.granted_by) {
      return Response.json({ error_code: "bad_request", message: "granting_space_id, receiving_space_id, grant_type, granted_by are required" }, { status: 400 });
    }
    if (body.granting_space_id === body.receiving_space_id) {
      return Response.json({ error_code: "bad_request", message: "Cannot grant a space access to itself" }, { status: 400 });
    }
    const id = crypto.randomUUID();
    execute(
      this.ctx.storage.sql as never,
      `INSERT INTO cross_space_grants (id, granting_space_id, receiving_space_id, grant_type, granted_by, granted_at, expires_at)
       VALUES (?, ?, ?, ?, ?, ?, ?)`,
      id, body.granting_space_id, body.receiving_space_id, body.grant_type, body.granted_by, new Date().toISOString(), body.expires_at ?? null
    );
    return Response.json({ id, grant_type: body.grant_type }, { status: 201 });
  }

  private listCrossSpaceGrants(params: URLSearchParams): Response {
    const spaceId = params.get("space_id");
    const rows = spaceId
      ? queryAll<CrossSpaceGrantRow>(
          this.ctx.storage.sql as never,
          `SELECT * FROM cross_space_grants
           WHERE (granting_space_id = ? OR receiving_space_id = ?) AND revoked_at IS NULL
           ORDER BY granted_at DESC`,
          spaceId, spaceId
        )
      : queryAll<CrossSpaceGrantRow>(
          this.ctx.storage.sql as never,
          "SELECT * FROM cross_space_grants WHERE revoked_at IS NULL ORDER BY granted_at DESC"
        );
    return Response.json({ data: rows });
  }

  private revokeCrossSpace(id: string): Response {
    execute(
      this.ctx.storage.sql as never,
      "UPDATE cross_space_grants SET revoked_at = ? WHERE id = ?",
      new Date().toISOString(), id
    );
    return Response.json({ revoked: true, id });
  }

  // GET /cross-space-check — THE CRITICAL PATH (§49). Default DENIED on any error.
  // A user gets access if they are a direct member of the target space, OR a valid
  // (unexpired, unrevoked) grant exists from the requesting space to the target.
  private checkCrossSpace(params: URLSearchParams): Response {
    const userId = params.get("user_id") ?? "";
    const requestingSpaceId = params.get("requesting_space_id") ?? "";
    const targetSpaceId = params.get("target_space_id") ?? "";
    const grantType = params.get("grant_type") ?? "read-knowledge";

    try {
      if (!userId || !targetSpaceId) {
        return Response.json({ permitted: false, reason: "user_id and target_space_id are required", grant_type: null }, { status: 400 });
      }

      // Direct membership of the target space → permitted.
      const member = queryOne<{ role: string }>(
        this.ctx.storage.sql as never,
        "SELECT role FROM space_members WHERE space_id = ? AND user_id = ?",
        targetSpaceId, userId
      );
      if (member) {
        return Response.json({ permitted: true, reason: `Direct member with role '${member.role}'.`, grant_type: null });
      }

      // Valid cross-space grant from requesting → target.
      const now = new Date().toISOString();
      const grant = queryOne<{ id: string; grant_type: string }>(
        this.ctx.storage.sql as never,
        `SELECT id, grant_type FROM cross_space_grants
         WHERE granting_space_id = ? AND receiving_space_id = ?
           AND (grant_type = ? OR grant_type = 'full-access')
           AND revoked_at IS NULL AND (expires_at IS NULL OR expires_at > ?)
         LIMIT 1`,
        targetSpaceId, requestingSpaceId, grantType, now
      );
      if (!grant) {
        return Response.json({
          permitted: false,
          reason: `User ${userId} is not a member of ${targetSpaceId} and no '${grantType}' grant exists from ${requestingSpaceId}.`,
          grant_type: null,
        });
      }
      return Response.json({ permitted: true, reason: `Cross-space grant '${grant.grant_type}' applies.`, grant_type: grant.grant_type });
    } catch (err) {
      // ANY unexpected error → DENIED. Never permit on error.
      console.error("[SpaceDO] checkCrossSpace UNEXPECTED ERROR — defaulting to DENIED", err);
      return Response.json({ permitted: false, reason: "Permission check failed; access denied as a safety default.", grant_type: null });
    }
  }
}
</file>

<file path="workers/spaces/src/business-create.ts">
// Shared business-creation logic — a customer creates their own business under a reseller-mode
// product (spec G-AS34/G-AS35, §49 Scenario C). Extracted from the original POST /reseller/spaces
// handler (index.ts) so the Three-Tier Platform Model's Phase C product-scoped wrapper
// (POST /spaces/:productSpaceId/businesses, business-routes.ts) can reuse the exact same
// security-sensitive gating/tenant-hierarchy logic instead of re-implementing it — "reuse, don't
// reinvent." Both callers now share this one path; there is no second copy of this logic anywhere.
//
// Kept dependency-free of index.ts's own Env/types (declares its own minimal structural Env), so
// index.ts -> business-create.ts and business-routes.ts -> business-create.ts both stay one-way —
// no circular import.

import type { SpaceTypeProductConfig, NaelaoSpaceTypeManifestV2, SpaceTypeRegistryDO } from "./do/SpaceTypeRegistryDO.js";
import { checkFreeTierTemplateEligibility } from "./template-catalog.js";
import { resolveEffectiveBusinessLimit, isPersonalPlanTier, type PersonalPlanTier } from "@naelao/billing-core";
import { getDOName } from "@naelao/crypto";

export interface ProvisionMessage {
  type: "space_provision" | "space_deprovision";
  spaceId: string;
  tenantId: string;
  spaceTypeId: string;
  spaceName: string;
  templateId?: string;
  templateIds?: string[];
  requestedAt: string;
  userId?: string;
}

export interface BusinessCreateEnv {
  PLATFORM_DB: D1Database;
  PLATFORM_SECRET: string;
  PROVISION_QUEUE?: Queue<ProvisionMessage>;
  SPACE_TYPE_REGISTRY_DO: DurableObjectNamespace<SpaceTypeRegistryDO>;
  NAELAO_CONFIG_KV: KVNamespace;
  /** G-BF08: the free-tier template gate resolves the real catalogue (free_tier_eligible) from
   *  the agents worker. Optional — absent (dev/test), the gate degrades open; see
   *  checkFreeTierTemplateEligibility. */
  AGENTS_WORKER?: Fetcher;
  /** Phase 4 (money): resolves the CALLING end user's own personal-plan tier
   *  (ProductUserDO's /plan-tier), which narrows or widens their slice of
   *  productConfig.maxBusinessesPerEndUser — see resolveEffectiveBusinessLimit. Optional so
   *  dev/test environments without this binding degrade to the pre-existing flat-ceiling-only
   *  behavior (every existing caller/test that doesn't set this is unaffected). */
  PRODUCT_USER_DO?: DurableObjectNamespace;
}

export interface CreateBusinessOptions {
  resellerProductSpaceId: string;
  userId: string;
  name: string;
  spacetypeId: string;
  /** Back-compat single template. Ignored when templateIds is non-empty. */
  templateId?: string;
  /** Phase C: a business built from more than one template. */
  templateIds?: string[];
  configOverrides?: Record<string, unknown>;
}

export interface CreateBusinessOk {
  ok: true;
  tenantId: string;
  spaceId: string;
  status: string;
  parentTenantId: string;
}

export interface CreateBusinessErr {
  ok: false;
  error_code: string;
  message: string;
  status: 400 | 403 | 404 | 429;
}

export type CreateBusinessResult = CreateBusinessOk | CreateBusinessErr;

function getRegistryDO(env: BusinessCreateEnv): DurableObjectStub<SpaceTypeRegistryDO> {
  return env.SPACE_TYPE_REGISTRY_DO.get(env.SPACE_TYPE_REGISTRY_DO.idFromName("global-space-type-registry"));
}

/** Phase 4 (money): resolve the calling end user's own personal-plan tier from their
 *  ProductUserDO (one instance per productId×endUserId — productId here is the PRODUCT ROOT,
 *  which resellerProductSpaceId already is by this file's own established invariant, matching
 *  productUserDoStub's addressing in workers/spaces/src/index.ts exactly, without importing that
 *  file — this stays intentionally self-contained per this file's own "no circular import" rule).
 *  Never throws; degrades to 'free' (the more restrictive tier, matching every other billing gate
 *  in this codebase's fail-closed posture) on any binding/network/shape error. */
export async function resolvePersonalPlanTier(
  env: BusinessCreateEnv,
  productRootSpaceId: string,
  endUserId: string,
  tenantId: string
): Promise<PersonalPlanTier> {
  if (!env.PRODUCT_USER_DO) return "free";
  try {
    const doName = await getDOName("produser", `${productRootSpaceId}:${endUserId}`, tenantId, env.PLATFORM_SECRET);
    const stub = env.PRODUCT_USER_DO.get(env.PRODUCT_USER_DO.idFromName(doName));
    const resp = await stub.fetch(new Request("http://produser/plan-tier"));
    if (!resp.ok) return "free";
    const body = await resp.json<{ plan_tier?: string }>();
    return isPersonalPlanTier(body.plan_tier) ? body.plan_tier : "free";
  } catch {
    return "free";
  }
}

async function loadManifest(env: BusinessCreateEnv, spaceTypeId: string): Promise<NaelaoSpaceTypeManifestV2 | null> {
  const cacheKey = `space-type-manifest:${spaceTypeId}`;
  const cached = (await env.NAELAO_CONFIG_KV.get(cacheKey, "json")) as NaelaoSpaceTypeManifestV2 | null;
  if (cached) return cached;
  const registry = getRegistryDO(env);
  const resp = await registry.fetch(new Request(`http://registry/type/${spaceTypeId}`));
  if (!resp.ok) return null;
  const manifest = await resp.json<NaelaoSpaceTypeManifestV2>();
  await env.NAELAO_CONFIG_KV.put(cacheKey, JSON.stringify(manifest), { expirationTtl: 3600 });
  return manifest;
}

export async function loadEffectiveProductConfig(
  env: BusinessCreateEnv,
  spaceTypeId: string,
  spaceConfigJson: string | null
): Promise<SpaceTypeProductConfig | null> {
  const manifest = await loadManifest(env, spaceTypeId);
  const base = manifest?.productConfig ?? null;
  let override: Partial<SpaceTypeProductConfig> | undefined;
  if (spaceConfigJson) {
    try {
      const cfg = JSON.parse(spaceConfigJson) as { productConfig?: Partial<SpaceTypeProductConfig> };
      override = cfg.productConfig;
    } catch { /* ignore malformed */ }
  }
  if (!base && !override) return null;
  return { ...(base ?? {}), ...(override ?? {}) } as SpaceTypeProductConfig;
}

/** Create a customer's own business (space) under a reseller-mode product. Shared by
 *  POST /reseller/spaces (index.ts, no path spaceId — legacy) and
 *  POST /spaces/:productSpaceId/businesses (business-routes.ts, Phase C's product-scoped,
 *  router-allowlistable wrapper). Identical gating + tenant-hierarchy + provisioning-queue logic
 *  either way; callers differ only in how they resolve `resellerProductSpaceId` and what they do
 *  with the result (the wrapper additionally dual-writes business_memberships for the owner). */
export async function createBusinessForEndUser(
  env: BusinessCreateEnv,
  opts: CreateBusinessOptions
): Promise<CreateBusinessResult> {
  if (!opts.resellerProductSpaceId || !opts.name || !opts.spacetypeId) {
    return { ok: false, error_code: "bad_request", message: "reseller_product_space_id, name, spacetype_id are required", status: 400 };
  }

  // 1. Resolve the reseller (parent tenant) from the product space.
  const product = await env.PLATFORM_DB.prepare(
    "SELECT tenant_id, spacetype_id, config_json FROM spaces WHERE id = ? AND status = 'active'"
  ).bind(opts.resellerProductSpaceId).first<{ tenant_id: string; spacetype_id: string; config_json: string | null }>();
  if (!product) return { ok: false, error_code: "not_found", message: "Reseller product not found", status: 404 };
  const parentTenantId = product.tenant_id;

  // 2. Load effective productConfig and gate the request.
  const pc = await loadEffectiveProductConfig(env, product.spacetype_id, product.config_json);
  if (!pc || (pc.membershipModel !== "tenant" && pc.membershipModel !== "hybrid")) {
    return { ok: false, error_code: "not_allowed", message: "This product does not allow customers to create their own businesses", status: 403 };
  }
  if (!pc.allowPublicSignup) {
    // Says what this flag ACTUALLY gates. It was "Public signup is disabled for this product",
    // which is wrong in the most confusing way: end-user signup is a different route entirely
    // (product-end-user-routes.ts) and never consults this flag — so a builder hitting this saw
    // "signup is disabled" moments after watching a customer sign up successfully, and would go
    // looking for a signup setting that does not exist. This flag only decides whether a signed-in
    // customer may create their OWN business, which is exactly how the dashboard already labels it
    // ("Allow end users to sign up and create their own business").
    return {
      ok: false,
      error_code: "business_creation_disabled",
      message: "This product does not let customers create their own businesses yet. A builder can enable it under Configuration → Product Mode.",
      status: 403,
    };
  }
  const allowed = pc.allowedChildSpaceTypes ?? [];
  if (!allowed.includes(opts.spacetypeId)) {
    return { ok: false, error_code: "spacetype_not_allowed", message: `SpaceType '${opts.spacetypeId}' is not offered by this product`, status: 403 };
  }

  // 2b. G-GRW08 (Appendix AJ): on the free plan only free_tier_eligible templates may be
  // instantiated. The plan that matters is the OWNING builder org's (parentTenantId) — end-user
  // claims already resolve to it, and the child tenant minted below has no org/plan of its own.
  // Checked BEFORE any side effect (reseller_accounts upsert, tenant mint) so a rejected create
  // leaves nothing behind.
  const requestedTemplates = opts.templateIds && opts.templateIds.length > 0
    ? opts.templateIds
    : opts.templateId ? [opts.templateId] : [];
  const gate = await checkFreeTierTemplateEligibility(env.PLATFORM_DB, env, parentTenantId, requestedTemplates);
  if (!gate.ok) {
    return { ok: false, error_code: gate.error_code, message: gate.message, status: gate.status };
  }

  // 3. Find or mint the customer's child tenant (one per customer per reseller).
  const existing = await env.PLATFORM_DB.prepare(
    "SELECT child_tenant_id FROM tenant_hierarchy WHERE parent_tenant_id = ? AND child_owner_user_id = ? LIMIT 1"
  ).bind(parentTenantId, opts.userId).first<{ child_tenant_id: string }>();
  const childTenantId = existing?.child_tenant_id ?? `ten_${crypto.randomUUID().replace(/-/g, "")}`;
  const now = new Date().toISOString();

  // Ensure a reseller_accounts row exists for the parent (lazily, from productConfig). WS-3:
  // previously hardcoded wholesale_cents=NULL/referral_share_pct=0.0 literals with no rate
  // fields anywhere in productConfig to seed from — now reads pc.resellerRates (set via PATCH
  // /builder/products/:id/reseller). The ON CONFLICT branch only refreshes product_space_id, not
  // the rates: a builder's rate change is applied directly to this row by that same PATCH
  // endpoint (immediate effect on the existing row), not deferred until the next business is
  // created under this reseller — re-seeding rates here on every conflict would silently
  // overwrite a rate the builder set AFTER this tenant's account row already existed.
  await env.PLATFORM_DB.prepare(
    `INSERT INTO reseller_accounts (tenant_id, product_space_id, billing_relationship, wholesale_cents, referral_share_pct, updated_at)
     VALUES (?, ?, ?, ?, ?, ?)
     ON CONFLICT(tenant_id) DO UPDATE SET product_space_id = excluded.product_space_id, updated_at = excluded.updated_at`
  ).bind(
    parentTenantId,
    opts.resellerProductSpaceId,
    pc.billingRelationship ?? "platform",
    pc.resellerRates?.wholesaleCents ?? null,
    pc.resellerRates?.referralSharePct ?? 0.0,
    now
  ).run();

  // F-19 (abuse/DoS): bound how many businesses a single end user can create under this reseller
  // product. Without this, one verified free-tier email could loop POST /businesses and provision
  // unlimited spaces (SpaceDO init, agent installs, R2 writes, wallet seed each) — the rate limiter
  // only slows it, never caps it. Counts this user's OWN existing non-deleted businesses under this
  // product; a builder can tune the ceiling via productConfig.maxBusinessesPerEndUser (default 10).
  //
  // Phase 4 (money): combined with the caller's OWN personal-plan tier
  // (resolveEffectiveBusinessLimit) — a free-tier user gets only a SLICE of the builder's own
  // ceiling (never more than PERSONAL_PLAN_LIMITS.free.maxBusinessesOwned) unless they upgrade to
  // 'plus', which then unlocks the full builder-configured ceiling. The builder's own ceiling is
  // always the outer bound either way — a personal plan can never let a user exceed what the
  // builder allowed. Fails open to the flat ceiling (tier "free") on any resolution error or a
  // missing PRODUCT_USER_DO binding (dev/test) — never blocks MORE than the pre-existing behavior
  // already did, only ever the same or less restrictive.
  const productCeiling = (pc as { maxBusinessesPerEndUser?: number }).maxBusinessesPerEndUser ?? 10;
  const personalTier = await resolvePersonalPlanTier(env, opts.resellerProductSpaceId, opts.userId, parentTenantId);
  const maxBusinesses = resolveEffectiveBusinessLimit(personalTier, productCeiling);
  const existingCount = await env.PLATFORM_DB.prepare(
    "SELECT COUNT(*) AS cnt FROM spaces WHERE parent_space_id = ? AND created_by = ? AND status != 'deleted'"
  ).bind(opts.resellerProductSpaceId, opts.userId).first<{ cnt: number }>();
  if ((existingCount?.cnt ?? 0) >= maxBusinesses) {
    const upgradeHint = personalTier === "free" && maxBusinesses < productCeiling
      ? ` Upgrade your personal plan to own up to ${productCeiling}.`
      : "";
    return {
      ok: false,
      error_code: "business_limit_reached",
      message: `You have reached the maximum of ${maxBusinesses} businesses for this product.${upgradeHint}`,
      status: 429,
    };
  }

  // 4. Create the child business (space) under the child tenant.
  const spaceId = crypto.randomUUID();
  const initialStatus = env.PROVISION_QUEUE ? "provisioning" : "active";
  const templateIds = opts.templateIds && opts.templateIds.length > 0 ? opts.templateIds : opts.templateId ? [opts.templateId] : [];
  const configJson = JSON.stringify({
    ...(opts.configOverrides ?? {}),
    ...(templateIds.length > 0 ? { template_id: templateIds[0], template_ids: templateIds } : {}),
  });
  // The child business is its OWN top-level space under its OWN tenant (saas per-end-user
  // isolation, G-Y16): own SpaceDO, own SQLite. parent_space_id links it to the reseller's
  // product for portfolio/promotion queries; scenario_type marks it a user-created business.
  await env.PLATFORM_DB.prepare(
    `INSERT INTO spaces (id, tenant_id, spacetype_id, name, status, config_json, parent_space_id, depth, tenancy_mode, scenario_type, created_at, updated_at, created_by)
     VALUES (?, ?, ?, ?, ?, ?, ?, 1, 'saas', 'user-workspace', ?, ?, ?)`
  ).bind(spaceId, childTenantId, opts.spacetypeId, opts.name, initialStatus, configJson, opts.resellerProductSpaceId, now, now, opts.userId).run();

  // 5. Record the hierarchy on first business for this child tenant.
  if (!existing) {
    await env.PLATFORM_DB.prepare(
      `INSERT INTO tenant_hierarchy (child_tenant_id, parent_tenant_id, reseller_product_space_id, child_space_id, child_owner_user_id)
       VALUES (?, ?, ?, ?, ?)`
    ).bind(childTenantId, parentTenantId, opts.resellerProductSpaceId, spaceId, opts.userId).run();
  }

  // 6. Provision under the CHILD tenant (reuses the 10-step provisioner unchanged).
  if (env.PROVISION_QUEUE) {
    await env.PROVISION_QUEUE.send({
      type: "space_provision",
      spaceId,
      tenantId: childTenantId,
      spaceTypeId: opts.spacetypeId,
      spaceName: opts.name,
      ...(templateIds.length > 0 ? { templateId: templateIds[0]!, templateIds } : {}),
      userId: opts.userId,
      requestedAt: now,
    });
  }

  // Every business auto-provisions a Whop sub-merchant wallet. Deliberately NOT wired here yet:
  // unlike the builder-created paths (createSpaceRecord's callers, which resolve a real email
  // from the platform `users` table), this business's owner is a ProductUserDO end user — there
  // is no D1 row with their email, and resolving it needs a ProductUserDO round trip this file
  // doesn't have wired (business-create.ts is deliberately kept dependency-free of index.ts's own
  // DO-stub helpers). Documented gap, not silently dropped — tracked as a real follow-up rather
  // than fabricating a placeholder email Whop would send real payout-approval mail to.

  return { ok: true, tenantId: childTenantId, spaceId, status: initialStatus, parentTenantId };
}
</file>

<file path="workers/spaces/src/create-space.ts">
// Shared space-creation logic — extracted so `/builder/products` (Three-Tier Platform Model,
// builder-routes.ts) doesn't reimplement a second, incomplete creation path. Phase 3 originally
// did exactly that (a bare INSERT with no quota check, no config-schema validation, no
// provisioning-queue enqueue, no template_id support) — a real split-brain with the existing,
// fully-working `POST /spaces` route this file now backs too. Both routes call the SAME
// createSpaceRecord(); there is exactly one space-creation code path.

import { mintInternalToken } from "@naelao/http";
import { checkFreeTierTemplateEligibility } from "./template-catalog.js";

export interface ProvisionMessage {
  type: "space_provision" | "space_deprovision";
  spaceId: string;
  tenantId: string;
  spaceTypeId: string;
  spaceName: string;
  templateId?: string;
  requestedAt: string;
  userId?: string;
}

export interface CreateSpaceEnv {
  PLATFORM_DB: D1Database;
  PROVISION_QUEUE?: Queue<ProvisionMessage>;
  /** G-BF08: the free-tier template gate resolves the real catalogue (free_tier_eligible) from
   *  the agents worker, KV-cached. Both optional — absent (dev/test), the gate degrades open;
   *  see checkFreeTierTemplateEligibility. */
  NAELAO_CONFIG_KV?: KVNamespace;
  AGENTS_WORKER?: Fetcher;
  /** Every business auto-provisions a Whop sub-merchant wallet — no builder action, no OAuth.
   *  Both optional: absent (dev/test), provisioning is skipped and the wallet stays
   *  unprovisioned until an operator retries (see provisionBusinessWallet). */
  BILLING_WORKER?: Fetcher;
  PLATFORM_SECRET?: string;
}

/**
 * Fire off Whop sub-merchant provisioning for a freshly-created business. Best-effort and
 * non-blocking of the caller's own success path (matches seedOwnerMember's own "idempotent and
 * non-fatal on failure" precedent) — a business is usable immediately even if wallet
 * provisioning is still in flight or the billing worker is briefly unavailable; the wallet
 * balance read surfaces `status: "not_provisioned"`/`"error"` honestly rather than pretending.
 */
export async function provisionBusinessWallet(
  env: CreateSpaceEnv,
  params: { tenantId: string; spaceId: string; ownerEmail: string; businessName: string }
): Promise<void> {
  if (!env.BILLING_WORKER || !env.PLATFORM_SECRET || !params.ownerEmail) return;
  try {
    await env.BILLING_WORKER.fetch(
      new Request("http://billing-worker/billing/whop-wallet/provision", {
        method: "POST",
        headers: {
          "content-type": "application/json",
          "x-naelao-tenant-id": params.tenantId,
          "x-naelao-internal-token": await mintInternalToken(env.PLATFORM_SECRET, params.tenantId),
        },
        body: JSON.stringify({
          space_id: params.spaceId,
          owner_email: params.ownerEmail,
          business_name: params.businessName,
        }),
      })
    );
  } catch (err) {
    console.error(`[create-space] wallet provisioning request failed for space ${params.spaceId}:`, (err as Error).message);
  }
}

export interface SchemaValidationError {
  field: string;
  error: string;
}

// G-I13: quota enforcement — matches the values index.ts's /spaces route used before this
// extraction verbatim (do not "improve" these without checking billing/entitlements agree).
const SPACE_LIMITS: Record<string, number> = {
  free: 3,
  starter: 25,
  pro: 100,
  enterprise: 1000,
};

export class SpaceCreationError extends Error {
  constructor(public status: number, public error_code: string, message: string, public errors?: SchemaValidationError[]) {
    super(message);
  }
}

async function enforceSpaceQuota(db: D1Database, tenantId: string): Promise<void> {
  // BUG FOUND during Phase 4 (Three-Tier Platform Model): this queried a table called
  // "organizations", which no migration anywhere creates — the real table is `orgs`
  // (infra/migrations/0002_orgs.sql, id == tenantId, plan_tier column). Since this function is
  // called unconditionally on every space creation and its caller only special-cases the
  // `quota_exceeded` error code (rethrowing everything else), this meant POST /spaces has likely
  // been hard-500ing on every single call in any real deployment — nothing in this codebase's
  // test suite exercised POST /spaces before this phase, so nothing caught it until now.
  const org = await db.prepare("SELECT plan_tier FROM orgs WHERE id = ?").bind(tenantId).first<{ plan_tier: string }>();
  const tier = org?.plan_tier ?? "free";
  const limit = SPACE_LIMITS[tier] ?? SPACE_LIMITS["free"]!;
  const row = await db.prepare("SELECT COUNT(*) as count FROM spaces WHERE tenant_id = ? AND status != 'deleted'").bind(tenantId).first<{ count: number }>();
  const count = row?.count ?? 0;
  if (count >= limit) {
    throw new SpaceCreationError(402, "quota_exceeded", `Space limit reached for ${tier} plan (${limit} spaces)`);
  }
}

// G-AV02: Lightweight JSON Schema (draft-07 subset) validator for SpaceType config. Validates:
// type, required, properties (type+enum), minLength/maxLength, minimum/maximum. No ajv import —
// keeps the Workers bundle small.
export function validateConfigSchema(config: Record<string, unknown>, schema: Record<string, unknown>): SchemaValidationError[] {
  const errors: SchemaValidationError[] = [];
  const properties = schema["properties"] as Record<string, Record<string, unknown>> | undefined;
  const required = schema["required"] as string[] | undefined;

  if (required) {
    for (const field of required) {
      if (config[field] === undefined || config[field] === null || config[field] === "") {
        errors.push({ field, error: "required field missing" });
      }
    }
  }
  if (properties) {
    for (const [field, fieldSchema] of Object.entries(properties)) {
      const value = config[field];
      if (value === undefined || value === null) continue;
      const expectedType = fieldSchema["type"] as string | undefined;
      if (expectedType) {
        const actualType = Array.isArray(value) ? "array" : typeof value;
        if (actualType !== expectedType) {
          errors.push({ field, error: `expected type ${expectedType}, got ${actualType}` });
          continue;
        }
      }
      const enumValues = fieldSchema["enum"] as unknown[] | undefined;
      if (enumValues && !enumValues.includes(value)) {
        errors.push({ field, error: `value must be one of: ${enumValues.join(", ")}` });
      }
      if (typeof value === "string") {
        const minLen = fieldSchema["minLength"] as number | undefined;
        if (minLen !== undefined && value.length < minLen) errors.push({ field, error: `minimum length is ${minLen}` });
        const maxLen = fieldSchema["maxLength"] as number | undefined;
        if (maxLen !== undefined && value.length > maxLen) errors.push({ field, error: `maximum length is ${maxLen}` });
      }
      if (typeof value === "number") {
        const minimum = fieldSchema["minimum"] as number | undefined;
        if (minimum !== undefined && value < minimum) errors.push({ field, error: `minimum value is ${minimum}` });
        const maximum = fieldSchema["maximum"] as number | undefined;
        if (maximum !== undefined && value > maximum) errors.push({ field, error: `maximum value is ${maximum}` });
      }
    }
  }
  return errors;
}

/** Subdomains that collide with Naelao infrastructure or enable phishing. Module-scoped so the
 *  explicit-slug validator and the name-derived fallback below can never disagree about what is
 *  allowed — a derived slug reaching the insert unchecked would bypass this entirely. */
const RESERVED_SLUGS = new Set([
  "www", "api", "api2", "app", "mail", "email", "smtp", "imap", "pop",
  "admin", "superadmin", "root", "naelao", "naelao-admin", "dashboard",
  "login", "signin", "signup", "register", "auth", "oauth", "sso",
  "billing", "payments", "pay", "checkout", "subscribe", "pricing",
  "status", "uptime", "health", "monitor", "metrics", "telemetry",
  "support", "help", "docs", "documentation", "legal", "terms", "privacy",
  "blog", "news", "press", "media", "marketing", "careers", "jobs",
  "cdn", "static", "assets", "files", "upload", "downloads",
  "dev", "staging", "preview", "prod", "production", "sandbox", "test",
  "internal", "intranet", "corp", "enterprise", "security",
  "webhooks", "webhook", "events", "queue", "pubsub",
  "socket", "ws", "wss", "stream", "sse",
]);

export interface CreateSpaceParams {
  tenantId: string;
  userId?: string;
  name: string;
  spacetypeId: string;
  /** Launchpad hierarchy coordinates. Omit both for a root; departments must provide both. */
  parentSpaceId?: string;
  depth?: number;
  /** For Launchpad: the selected product template (e.g. "creator-store"). */
  templateId?: string;
  /** Three-Tier Platform Model: the platform-subdomain identity (migration 0044, unique). */
  productSlug?: string;
  configOverrides?: Record<string, unknown>;
}

export interface CreateSpaceResult {
  id: string;
  status: string;
  created_at: string;
}


/**
 * Turn a product name into a usable, free platform slug.
 *
 * Collisions are resolved by suffixing rather than by rejecting: a builder naming their product
 * "Launchpad" when someone else already has that slug should still end up with a working product,
 * not a 409 on a field they never filled in. Returns undefined only if nothing usable can be
 * derived at all (a name of pure punctuation), in which case the product is created slugless
 * exactly as before — degrading, never blocking creation over a derived convenience value.
 */
export async function deriveAvailableSlug(db: D1Database, name: string): Promise<string | undefined> {
  const base = name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 32);
  if (base.length < 2) return undefined;

  for (let attempt = 0; attempt < 6; attempt++) {
    // First try the clean slug, then progressively-random suffixes. Random rather than an
    // incrementing counter so two products created at once can't race onto the same candidate.
    const candidate = attempt === 0 ? base : `${base}-${Math.random().toString(36).slice(2, 6)}`;
    if (RESERVED_SLUGS.has(candidate)) continue;
    try {
      const taken = await db
        .prepare("SELECT 1 AS x FROM spaces WHERE product_slug = ?")
        .bind(candidate)
        .first<{ x: number }>();
      if (!taken) return candidate;
    } catch {
      // Can't check: fall through to slugless rather than risk a UNIQUE failure that would turn
      // a valid creation into an error.
      return undefined;
    }
  }
  return undefined;
}

/** The one space-creation code path: quota check, config-schema validation, insert (as
 *  'provisioning' when a queue is bound, else immediately 'active' — matches local-dev behavior
 *  when PROVISION_QUEUE isn't configured), and provisioning-queue enqueue with template_id.
 *  Throws SpaceCreationError on any validation/quota failure; callers translate to their own
 *  response shape (the plain /spaces route and /builder/products use different JSON shapes). */
export async function createSpaceRecord(env: CreateSpaceEnv, params: CreateSpaceParams): Promise<CreateSpaceResult> {
  if (!params.name || !params.spacetypeId) {
    throw new SpaceCreationError(400, "bad_request", "name and spacetype_id are required");
  }

  // Launchpad has one deliberately small hierarchy: product roots (depth 0) and their direct
  // departments (depth 1). Do not trust a caller to describe ancestry: resolve the parent in D1
  // and derive the stored depth from that authoritative row.
  if (params.spacetypeId !== "launchpad") {
    throw new SpaceCreationError(400, "invalid_hierarchy", "Only Launchpad spaces are supported");
  }
  const requestedDepth = params.depth ?? (params.parentSpaceId ? 1 : 0);
  if (requestedDepth === 0 && params.parentSpaceId) {
    throw new SpaceCreationError(400, "invalid_hierarchy", "A root space cannot have a parent");
  }
  if (requestedDepth === 1 && !params.parentSpaceId) {
    throw new SpaceCreationError(400, "invalid_hierarchy", "A department must have a parent");
  }
  if (requestedDepth !== 0 && requestedDepth !== 1) {
    throw new SpaceCreationError(400, "invalid_hierarchy", "Spaces may only be roots or direct departments");
  }
  let derivedDepth = 0;
  if (params.parentSpaceId) {
    const parent = await env.PLATFORM_DB.prepare(
      "SELECT tenant_id, spacetype_id, depth, parent_space_id FROM spaces WHERE id = ? AND status != 'deleted'"
    ).bind(params.parentSpaceId).first<{ tenant_id: string; spacetype_id: string; depth: number; parent_space_id: string | null }>();
    if (!parent || parent.tenant_id !== params.tenantId) {
      // Deliberately do not disclose whether a parent in another tenant exists.
      throw new SpaceCreationError(404, "parent_not_found", "Parent space not found");
    }
    if (parent.spacetype_id !== "launchpad" || parent.depth !== 0 || parent.parent_space_id) {
      throw new SpaceCreationError(400, "invalid_hierarchy", "A department's parent must be a Launchpad root");
    }
    derivedDepth = parent.depth + 1;
  }

  if (params.configOverrides) {
    try {
      // NOTE: the real migration (infra/migrations/0003_spaces.sql) names this column
      // schema_json, never config_schema — a prior version of this query used the wrong
      // name and threw a D1 "no such column" error on every call that reached here
      // (i.e. every product-wizard launch, since the wizard always sets configOverrides),
      // surfacing as a generic "An unexpected error occurred" 500 with no other symptom.
      const spaceTypeRow = await env.PLATFORM_DB.prepare("SELECT schema_json FROM spacetypes WHERE id = ?").bind(params.spacetypeId).first<{ schema_json: string | null }>();
      if (spaceTypeRow?.schema_json) {
        const schema = JSON.parse(spaceTypeRow.schema_json) as Record<string, unknown>;
        const validationErrors = validateConfigSchema(params.configOverrides, schema);
        if (validationErrors.length > 0) {
          throw new SpaceCreationError(400, "config_validation_failed", "SpaceType config validation failed", validationErrors);
        }
      }
    } catch (err) {
      if (err instanceof SpaceCreationError) throw err;
      // Missing/malformed schema, or a lookup failure — skip validation, don't block creation.
    }
  }

  await enforceSpaceQuota(env.PLATFORM_DB, params.tenantId);

  // G-GRW08 (Appendix AJ): on the free plan only free_tier_eligible templates may be
  // instantiated — the flag existed since Phase F but no creation path ever checked it.
  if (params.templateId) {
    const gate = await checkFreeTierTemplateEligibility(env.PLATFORM_DB, env, params.tenantId, [params.templateId]);
    if (!gate.ok) {
      throw new SpaceCreationError(gate.status, gate.error_code, gate.message);
    }
  }

  // A product with no slug is not "a product without a subdomain yet" — it is a product nobody
  // can reach. The Product Shell resolves every end-user URL as /p/{product_slug}, and nothing
  // anywhere lets a builder set the slug after creation, so a blank one produced a product that
  // provisioned successfully, reported `active`, and could never be opened by its owner or by a
  // single customer. Derived from the name instead, which is always present.
  // Both callers of this function (POST /spaces and POST /builder/products) create top-level
  // products; a child business goes through createBusinessForEndUser and has no slug of its own.
  if (!params.productSlug) {
    const derived = await deriveAvailableSlug(env.PLATFORM_DB, params.name);
    if (derived) params = { ...params, productSlug: derived };
  }

  if (params.productSlug) {
    if (!/^[a-z0-9-]{2,40}$/.test(params.productSlug)) {
      throw new SpaceCreationError(400, "bad_request", "product_slug must match ^[a-z0-9-]{2,40}$");
    }
    if (RESERVED_SLUGS.has(params.productSlug)) {
      throw new SpaceCreationError(400, "bad_request", `product_slug '${params.productSlug}' is reserved`);
    }
  }

  const id = crypto.randomUUID();
  const now = new Date().toISOString();
  // Default the daily digest ON for every new product — Naelao's proactive tick infrastructure
  // (hourly cron + near-real-time channel triggers, workers/agents/src/index.ts enqueueAgentTicks)
  // already runs more continuously than a Polsia-style nightly batch, but the digest email that
  // reports it was opt-in and off by default, so a builder who never found the toggle got zero
  // visibility into it. Only defaults when the caller hasn't already set it explicitly — a wizard
  // or API caller that deliberately opted out keeps that choice.
  const productConfig = (params.configOverrides?.["productConfig"] ?? {}) as Record<string, unknown>;
  const notificationsConfig = (productConfig["notificationsConfig"] ?? {}) as Record<string, unknown>;
  const mergedConfigOverrides =
    notificationsConfig["dailyDigestEnabled"] === undefined
      ? {
          ...(params.configOverrides ?? {}),
          productConfig: { ...productConfig, notificationsConfig: { ...notificationsConfig, dailyDigestEnabled: true } },
        }
      : (params.configOverrides ?? {});
  const configJson = JSON.stringify({
    ...mergedConfigOverrides,
    ...(params.templateId ? { template_id: params.templateId } : {}),
  });
  const initialStatus = env.PROVISION_QUEUE ? "provisioning" : "active";

  try {
    await env.PLATFORM_DB.prepare(
      `INSERT INTO spaces (id, tenant_id, spacetype_id, name, status, config_json, product_slug, parent_space_id, depth, created_at, updated_at, created_by)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`
    ).bind(id, params.tenantId, params.spacetypeId, params.name, initialStatus, configJson, params.productSlug ?? null,
      params.parentSpaceId ?? null, derivedDepth, now, now, params.userId ?? null).run();
  } catch (err) {
    if ((err as Error).message?.includes("UNIQUE")) {
      throw new SpaceCreationError(409, "conflict", "product_slug is already taken");
    }
    throw err;
  }

  if (env.PROVISION_QUEUE) {
    await env.PROVISION_QUEUE.send({
      type: "space_provision",
      spaceId: id,
      tenantId: params.tenantId,
      spaceTypeId: params.spacetypeId,
      spaceName: params.name,
      ...(params.templateId ? { templateId: params.templateId } : {}),
      ...(params.userId ? { userId: params.userId } : {}),
      requestedAt: now,
    });
  }

  return { id, status: initialStatus, created_at: now };
}
