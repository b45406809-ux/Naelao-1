<file path="workers/agents/container/server.mjs">
// Tier-5 harness — runs INSIDE the Cloudflare Container.
// Listens on :8080. Two routes:
//
// POST /build  { code }  ->  { built, tests_passed, logs }
//   The §02 micro-tool build/test gate (BusinessDO legacy path):
//   1. write the submitted code to a temp module
//   2. type-check / transpile it (esbuild)
//   3. import it and run its exported runTests() -> { passed, results[] }
//
// POST /exec  { name, code, args }  ->  { ok, result?, error?, logs? }
//   General Tier-5 script execution (script-engine execution-ladder §8): the script
//   exports `export async function run(args, ctx) { ... return result; }`. Bundled with
//   esbuild (so it can use Node builtins/npm deps installed in the image) then imported
//   and invoked with the agent's args. `ctx.workspaceDir` (also the process cwd for the
//   duration of the run) is /workspace — Tier-5 scripts get a real OS (filesystem,
//   child_process), unlike Tiers 2-4.
//
//   §A1.17 Phase R: /workspace is this container's OWN local disk — it persists across calls
//   to the SAME warm container instance with NO R2 round-trip, and starts genuinely EMPTY on a
//   cold start. Phase K's every-/exec-call blind full materialize/collect (workspace_files /
//   workspace_files_out, bounded 300 files / 2MB / 25MB) is gone: an agent explicitly moves
//   what it needs via the workspace.copy/move/list prebuilt (POST /workspace/{read,write,list,
//   delete} below), the same way it would reason about two genuinely different filesystems.
//
// POST /workspace/write  { files: {relPath: content} }        -> { ok }
// POST /workspace/read   { paths?: [relPath, ...] }            -> { files: {relPath: content} }
//   (paths omitted = every file currently under /workspace, same bound as before)
// POST /workspace/list   {}                                    -> { files: [relPath, ...] }
// POST /workspace/delete { paths: [relPath, ...] }              -> { ok }

import { createServer } from "node:http";
import { writeFile, mkdir, mkdtemp, readdir, readFile, rm, stat } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join, dirname, relative } from "node:path";
import { build } from "esbuild";

const PORT = 8080;
const EXEC_TIMEOUT_MS = 55_000;
const WORKSPACE_DIR = "/workspace";
// Mirrors ToolSandboxDO's own sync bounds — the harness enforces its side independently so a
// runaway script can't OOM/hang the container even if the DO's caps were somehow bypassed.
const MAX_WORKSPACE_FILES = 300;
const MAX_WORKSPACE_FILE_BYTES = 2 * 1024 * 1024;

async function materializeWorkspace(files) {
  await mkdir(WORKSPACE_DIR, { recursive: true });
  for (const [relPath, content] of Object.entries(files ?? {})) {
    const dest = join(WORKSPACE_DIR, relPath);
    await mkdir(dirname(dest), { recursive: true });
    await writeFile(dest, content, "utf8");
  }
}

async function collectWorkspace() {
  const out = {};
  let count = 0;
  async function walk(dir) {
    let entries;
    try {
      entries = await readdir(dir, { withFileTypes: true });
    } catch {
      return;
    }
    for (const entry of entries) {
      if (count >= MAX_WORKSPACE_FILES) return;
      const full = join(dir, entry.name);
      if (entry.isDirectory()) {
        await walk(full);
      } else if (entry.isFile()) {
        const info = await stat(full).catch(() => null);
        if (!info || info.size > MAX_WORKSPACE_FILE_BYTES) continue;
        try {
          out[relative(WORKSPACE_DIR, full)] = await readFile(full, "utf8");
          count++;
        } catch {
          // Binary/unreadable-as-utf8 file — skip rather than corrupt it (matches the
          // platform's existing R2-workspace convention of text-only content).
        }
      }
    }
  }
  await mkdir(WORKSPACE_DIR, { recursive: true });
  await walk(WORKSPACE_DIR);
  return out;
}

// §A1.17 Phase R: explicit read of specific paths (workspace.copy('container','r2', path)) —
// falls back to collectWorkspace()'s full walk when no paths are given (workspace.list-adjacent
// callers that want everything).
async function readWorkspacePaths(paths) {
  if (!paths || paths.length === 0) return collectWorkspace();
  const out = {};
  for (const relPath of paths.slice(0, MAX_WORKSPACE_FILES)) {
    try {
      const full = join(WORKSPACE_DIR, relPath);
      const info = await stat(full);
      if (info.size > MAX_WORKSPACE_FILE_BYTES) continue;
      out[relPath] = await readFile(full, "utf8");
    } catch {
      // missing/unreadable — simply absent from the result, not an error for the whole batch
    }
  }
  return out;
}

async function listWorkspacePaths() {
  const names = [];
  async function walk(dir) {
    let entries;
    try {
      entries = await readdir(dir, { withFileTypes: true });
    } catch {
      return;
    }
    for (const entry of entries) {
      if (names.length >= MAX_WORKSPACE_FILES) return;
      const full = join(dir, entry.name);
      if (entry.isDirectory()) await walk(full);
      else if (entry.isFile()) names.push(relative(WORKSPACE_DIR, full));
    }
  }
  await mkdir(WORKSPACE_DIR, { recursive: true });
  await walk(WORKSPACE_DIR);
  return names;
}

async function deleteWorkspacePaths(paths) {
  for (const relPath of paths ?? []) {
    await rm(join(WORKSPACE_DIR, relPath), { force: true }).catch(() => {});
  }
}

async function buildAndTest(code) {
  const logs = [];
  const dir = await mkdtemp(join(tmpdir(), "tool-"));
  const src = join(dir, "tool.ts");
  const out = join(dir, "tool.mjs");
  try {
    await writeFile(src, code, "utf8");

    // 1+2. Build (this is also the type/transpile gate).
    try {
      await build({ entryPoints: [src], outfile: out, bundle: true, format: "esm", platform: "node", logLevel: "silent" });
      logs.push("build: ok");
    } catch (err) {
      logs.push(`build: failed — ${String(err).slice(0, 1000)}`);
      return { built: false, tests_passed: false, logs: logs.join("\n") };
    }

    // 3. Run the tool's own tests.
    const mod = await import(`file://${out}`);
    if (typeof mod.runTests !== "function") {
      logs.push("tests: tool exports no runTests() — cannot verify it works");
      return { built: true, tests_passed: false, logs: logs.join("\n") };
    }
    const result = await mod.runTests();
    const passed = !!(result && result.passed);
    logs.push(`tests: ${passed ? "passed" : "failed"}`);
    if (Array.isArray(result?.results)) logs.push(...result.results.map(String));
    return { built: true, tests_passed: passed, logs: logs.join("\n") };
  } catch (err) {
    logs.push(`harness error: ${String(err).slice(0, 1000)}`);
    return { built: false, tests_passed: false, logs: logs.join("\n") };
  } finally {
    await rm(dir, { recursive: true, force: true }).catch(() => {});
  }
}

async function execScript(name, code, args) {
  const dir = await mkdtemp(join(tmpdir(), "exec-"));
  const src = join(dir, "script.ts");
  const out = join(dir, "script.mjs");
  // §A1.17 Phase R: /workspace is untouched here — it's whatever this warm container's own
  // disk already has from a prior call plus whatever workspace.copy explicitly staged in. No
  // implicit materialize/collect around the run anymore (see the file header comment).
  try {
    await writeFile(src, code, "utf8");
    try {
      await build({ entryPoints: [src], outfile: out, bundle: true, format: "esm", platform: "node", logLevel: "silent" });
    } catch (err) {
      return { ok: false, error: `build failed: ${String(err).slice(0, 1000)}` };
    }
    const mod = await import(`file://${out}`);
    if (typeof mod.run !== "function") {
      return { ok: false, error: `script '${name}' does not export an async function named 'run'` };
    }
    const timeout = new Promise((_, reject) =>
      setTimeout(() => reject(new Error("execution timed out")), EXEC_TIMEOUT_MS)
    );
    const result = await Promise.race([mod.run(args ?? {}, { workspaceDir: WORKSPACE_DIR }), timeout]);
    return { ok: true, result };
  } catch (err) {
    return { ok: false, error: String(err).slice(0, 2000) };
  } finally {
    await rm(dir, { recursive: true, force: true }).catch(() => {});
  }
}

const WORKSPACE_ROUTES = new Set(["/workspace/read", "/workspace/write", "/workspace/list", "/workspace/delete"]);

createServer((req, res) => {
  const path = req.url ?? "";
  const isWorkspaceRoute = [...WORKSPACE_ROUTES].some((r) => path.endsWith(r));
  if (req.method !== "POST" || (!path.endsWith("/build") && !path.endsWith("/exec") && !isWorkspaceRoute)) {
    res.writeHead(404).end(JSON.stringify({ error: "not_found" }));
    return;
  }
  const isExec = path.endsWith("/exec");
  const MAX_BODY_BYTES = 10_000_000; // §A1.17 Phase R: no more bundled workspace_files, back to a script-code-sized budget
  let body = "";
  req.on("data", (c) => { body += c; if (body.length > MAX_BODY_BYTES) req.destroy(); });
  req.on("end", async () => {
    try {
      const parsed = JSON.parse(body || "{}");
      if (isWorkspaceRoute) {
        let result;
        if (path.endsWith("/workspace/write")) { await materializeWorkspace(parsed.files); result = { ok: true }; }
        else if (path.endsWith("/workspace/read")) result = { files: await readWorkspacePaths(parsed.paths) };
        else if (path.endsWith("/workspace/list")) result = { files: await listWorkspacePaths() };
        else { await deleteWorkspacePaths(parsed.paths); result = { ok: true }; }
        res.writeHead(200, { "content-type": "application/json" }).end(JSON.stringify(result));
        return;
      }
      if (!parsed.code) { res.writeHead(400).end(JSON.stringify({ error: "code required" })); return; }
      const result = isExec
        ? await execScript(parsed.name ?? "script", parsed.code, parsed.args)
        : await buildAndTest(parsed.code);
      res.writeHead(200, { "content-type": "application/json" }).end(JSON.stringify(result));
    } catch (err) {
      res.writeHead(500).end(JSON.stringify(
        isExec || isWorkspaceRoute ? { ok: false, error: String(err) } : { built: false, tests_passed: false, logs: String(err) }
      ));
    }
  });
}).listen(PORT, () => console.log(`tool-sandbox harness listening on :${PORT}`));
</file>

<file path="workers/agents/src/do/LocalTunnelDO.ts">
/**
 * LocalTunnelDO — the server side of "Local PC as a Container Target" (spec gap G-3;
 * §A1.17 Phase M). One instance per (spaceId, userId) — a builder opts THEIR OWN machine in by
 * running the Naelao Local Agent (a small native client, see local-agent/naelao-local-agent.mjs)
 * which opens a persistent WebSocket to this DO's /connect route. Once connected, the
 * local-machine prebuilt (script-engine/prebuilt/local-machine.ts) can forward a grant-checked
 * read_file/write_file/exec request over that tunnel and wait for the client's reply.
 *
 * Uses the CF Hibernation API (ctx.acceptWebSocket), the same pattern as workers/ws-gateway's
 * WsHubDO, so the DO can sleep between requests rather than holding the connection open at cost.
 * Correlation of an /exec call to its eventual WS response is done with an in-memory pending map
 * — safe because a call is always awaited synchronously within one live invocation; if the DO
 * hibernates and wakes mid-wait the pending promise simply times out and the caller sees a clean
 * "tunnel disconnected" error rather than hanging forever.
 *
 * Security: grant checking (which paths/commands are allowed) happens ENTIRELY in the
 * local-machine prebuilt, before this DO is ever called — this DO has no opinion on what an
 * `exec`'s params mean, it only relays bytes between the reasoning loop and the connected client.
 * The WS connection itself requires a short-lived, HMAC-signed connect token (see
 * mintLocalTunnelToken/verifyLocalTunnelToken, @naelao/http) scoped to exactly this
 * (spaceId, userId) pair — stolen or forged tokens for a different space/user never verify.
 *
 * WS-7 (audit plan) — DO-naming exception, documented not normalized: this DO is addressed by a
 * plain `(spaceId, userId)` key, not the HMAC-SHA256(tenantId, secret):type:id convention
 * SpaceDO/NaelaoAgentDO use (G-BA01). Lower risk than most: even if the DO name were guessed, the
 * connect-token check above (a SEPARATE HMAC scoped to the same pair) is the real gate — knowing
 * the name alone grants nothing. Same server-derived-key rationale as TaskDO's exception applies
 * too. Deferred, not dropped, pending a live-migration plan for already-provisioned instances.
 */

import { DurableObject } from "cloudflare:workers";
import { verifyLocalTunnelToken } from "@naelao/http";

interface LocalTunnelEnv {
  PLATFORM_SECRET: string;
}

interface PendingRequest {
  resolve: (value: { ok: boolean; result?: unknown; error?: string }) => void;
  timer: ReturnType<typeof setTimeout>;
}

const EXEC_TIMEOUT_MS = 30_000;

export class LocalTunnelDO extends DurableObject<LocalTunnelEnv> {
  private pending = new Map<string, PendingRequest>();

  override async fetch(request: Request): Promise<Response> {
    const url = new URL(request.url);

    if (url.pathname === "/connect") {
      if (request.headers.get("Upgrade") !== "websocket") {
        return Response.json({ error_code: "bad_request", message: "Expected WebSocket upgrade" }, { status: 400 });
      }
      const spaceId = url.searchParams.get("space") ?? "";
      const userId = url.searchParams.get("user") ?? "";
      const token = url.searchParams.get("token") ?? undefined;
      if (!spaceId || !userId) {
        return Response.json({ error_code: "bad_request", message: "space and user are required" }, { status: 400 });
      }
      const ok = await verifyLocalTunnelToken(token, spaceId, userId, this.env.PLATFORM_SECRET);
      if (!ok) {
        return Response.json({ error_code: "forbidden", message: "Missing or invalid connect token" }, { status: 403 });
      }

      const pair = new WebSocketPair();
      const [client, server] = [pair[0], pair[1]] as [WebSocket, WebSocket];
      // Hibernation API — tags let the DO re-identify this socket after waking from sleep,
      // matching WsHubDO's precedent (this DO never actually needs to re-identify sockets today
      // since it always targets "the" connected client for this space/user pair, but tagging
      // costs nothing and keeps the door open for multi-connection scenarios later).
      this.ctx.acceptWebSocket(server, [`space:${spaceId}`, `user:${userId}`]);
      return new Response(null, { status: 101, webSocket: client });
    }

    if (url.pathname === "/exec" && request.method === "POST") {
      const sockets = this.ctx.getWebSockets();
      if (sockets.length === 0) {
        return Response.json({ ok: false, error: "not_connected: no Naelao Local Agent is currently connected for this machine" });
      }
      const body = await request.json<{ op: string; params: Record<string, unknown> }>().catch(() => null);
      if (!body || !body.op) {
        return Response.json({ error_code: "bad_request", message: "op is required" }, { status: 400 });
      }

      const requestId = crypto.randomUUID();
      const resultPromise = new Promise<{ ok: boolean; result?: unknown; error?: string }>((resolve) => {
        const timer = setTimeout(() => {
          this.pending.delete(requestId);
          resolve({ ok: false, error: "timeout: the Local Agent did not respond within 30s" });
        }, EXEC_TIMEOUT_MS);
        this.pending.set(requestId, { resolve, timer });
      });

      // Most recent socket only — a (space, user) tunnel is meant to be one machine, one live
      // connection at a time; if an older connection is still technically open (e.g. the client
      // reconnected without a clean close) the newest one is the one actually listening.
      const target = sockets[sockets.length - 1]!;
      try {
        target.send(JSON.stringify({ type: "request", request_id: requestId, op: body.op, params: body.params ?? {} }));
      } catch {
        const pending = this.pending.get(requestId);
        if (pending) { clearTimeout(pending.timer); this.pending.delete(requestId); }
        return Response.json({ ok: false, error: "not_connected: failed to send to the Local Agent" });
      }

      const result = await resultPromise;
      return Response.json(result);
    }

    if (url.pathname === "/status" && request.method === "GET") {
      const sockets = this.ctx.getWebSockets();
      return Response.json({ connected: sockets.length > 0 });
    }

    return Response.json({ error_code: "not_found", message: "Not found" }, { status: 404 });
  }

  override webSocketMessage(_ws: WebSocket, message: string | ArrayBuffer): void {
    if (typeof message !== "string") return;
    let parsed: unknown;
    try {
      parsed = JSON.parse(message);
    } catch {
      return;
    }
    if (parsed === null || typeof parsed !== "object") return;
    const msg = parsed as { type?: string; request_id?: string; ok?: boolean; result?: unknown; error?: string };
    if (msg.type === "response" && msg.request_id) {
      const pending = this.pending.get(msg.request_id);
      if (pending) {
        clearTimeout(pending.timer);
        this.pending.delete(msg.request_id);
        pending.resolve({ ok: msg.ok !== false, ...(msg.result !== undefined ? { result: msg.result } : {}), ...(msg.error ? { error: msg.error } : {}) });
      }
    }
  }

  override webSocketClose(_ws: WebSocket, _code: number, _reason: string, _wasClean: boolean): void {
    // Any request still waiting on this connection will never get a response — resolve it now
    // with an honest error instead of making the caller wait out the full 30s timeout.
    for (const [id, pending] of this.pending) {
      clearTimeout(pending.timer);
      pending.resolve({ ok: false, error: "not_connected: the Local Agent disconnected" });
      this.pending.delete(id);
    }
  }

  override webSocketError(ws: WebSocket, _error: unknown): void {
    this.webSocketClose(ws, 1006, "error", false);
  }
}
</file>

