<file path="workers/agents/src/script-engine/tool-surface.ts">
/**
 * The complete agent tool surface (spec §3) — exactly six operations. Everything the agent
 * can do flows through these; there are no other hardcoded tools.
 *
 *   script.create(name, code, metadata)
 *   script.read(name)
 *   script.update(name, patch, reason)
 *   script.delete(name)
 *   script.find(query, fingerprint?)
 *   script.run(name, params)
 *
 * script.run resolves `name` in this order:
 *   1. a prebuilt operation (bundled platform code, e.g. read_file, notify.email)
 *   2. a stored script in the skill library (executed via the execution ladder)
 */

import type {
  ScriptEngineEnv,
  ScriptMetadata,
  StoredScript,
  ScriptRunResult,
  FindCandidate,
  ObserveSnapshot,
  ScriptDomain,
  ExecutionTier,
} from "./types.js";
import { SkillLibrary } from "./skill-library.js";
import { scriptFind, indexScriptEmbedding, removeScriptEmbedding } from "./script-find.js";
import { runStoredScript } from "./execution-ladder.js";
import { buildOperationMap, type PrebuiltOp, type PrebuiltScript } from "./prebuilt/index.js";
import { assertNoReservedViolation } from "./reserved-capabilities.js";
import { isReadSafeOperation } from "./assistant-access.js";
import { enforceWriteGuard, requiresMutationGrant } from "@naelao/agent-sdk";
import { interceptPlatformCli } from "./virtual-cli.js";

/** Plain edit distance — used only to rank "did you mean" suggestions by how close a guess
 *  actually is, never for anything security-relevant. Op names are short (well under 40 chars),
 *  so the O(n*m) table is trivial here. */
function levenshtein(a: string, b: string): number {
  if (a === b) return 0;
  if (a.length === 0) return b.length;
  if (b.length === 0) return a.length;
  const prev = Array.from({ length: b.length + 1 }, (_, j) => j);
  for (let i = 1; i <= a.length; i++) {
    let diagonal = prev[0]!;
    prev[0] = i;
    for (let j = 1; j <= b.length; j++) {
      const temp = prev[j]!;
      prev[j] = a[i - 1] === b[j - 1]
        ? diagonal
        : 1 + Math.min(diagonal, prev[j]!, prev[j - 1]!);
      diagonal = temp;
    }
  }
  return prev[b.length]!;
}

/** Shape of one entry in the reasoner's `available_operations` — shared by both full and
 *  reduced (progressive-disclosure) payloads so the two can never drift apart in shape. */
export interface OperationGroup {
  script: string;
  description: string;
  operations: string[];
  /** opName → one-line parameter hint, only for ops this agent actually has enabled AND whose
   *  owning script declares one — see PrebuiltScript.paramHints's own doc for why this exists. */
  paramHints?: Record<string, string>;
}

/**
 * Progressive tool disclosure's always-visible core set (see disclosureGroups()'s own doc).
 * Deliberately small — the handful of cross-cutting operations useful in nearly every run.
 * Every name here is verified against the OWNING SCRIPT's real `operations` map key, not
 * assumed — this file's own history has a real, previously-shipped bug where an allowlist used
 * a dot-prefixed guess ("web-search.search") instead of the actual bare key ("search"), which
 * silently never matched anything a model could call. Get this list wrong and these operations
 * simply vanish from the reduced payload with no error to signal it.
 */
const CORE_OPERATIONS = new Set<string>([
  "search",               // web-search.ts (bare key)
  "knowledge.search",     // knowledge-base.ts
  "memory.recall",        // memory.ts
  "project_journal.read", // project-journal.ts
  "notify.email",         // notifications.ts
  "conversation.search",  // conversation.ts
  // Claude-Code-shaped REPL primitives (r2-workspace.ts / code-exec.ts) — kept visible even under
  // reduced disclosure since these are the most-used verbs in any multi-step run, mirroring how a
  // coding agent's own default tool list always shows its file/search/exec primitives. This only
  // controls what the REDUCED payload shows, never permission — the HITL gate/approval allowlist
  // is a separate mechanism (assistant_policy.auto_approved_actions), untouched by this set.
  "Read",
  "Edit",
  "Write",
  "Grep",
  "Glob",
  "Bash",
]);

/** Consecutive "unknown operation" misses in reduced-disclosure mode before this run
 *  automatically falls back to showing every available operation (see disclosureGroups' doc). */
const MISS_FALLBACK_THRESHOLD = 2;

/**
 * Old operation name → the name it was renamed to.
 *
 * Renaming an operation is not just an edit to this repo: learned skills are stored CODE in R2 that
 * a deploy cannot rewrite, so any skill already written against the old spelling would start failing
 * on businesses that were working fine before. Entries here keep those calls resolving. Deliberately
 * NOT advertised in the operation listing — the old name works, it just isn't offered.
 */
const RENAMED_OPERATIONS: Record<string, string> = {
  // Every thread-scoped operation is namespaced `thread.*`; consulting an agent privately is one of
  // them, and being the lone `agent.*` member of that script made it read like a different subsystem.
  "agent.consult": "thread.consult",
  // Lowercase spellings of the REPL primitives — a model reaching for the more familiar casing
  // (matching how it would type a shell verb) still resolves to the real, PascalCase op name.
  "read": "Read",
  "edit": "Edit",
  "write": "Write",
  "grep": "Grep",
  "glob": "Glob",
  "bash": "Bash",
  "execute_bash": "Bash",
  "patch_file": "Edit",
};

// ── Tool-result pagination (step 9) ─────────────────────────────────────────────────────────
// Some ops (thread.list, agent.list, knowledge.search, analytics, …) can return far more data
// than a run's context can hold. Rather than make every op re-implement paging, run() applies a
// generic, opt-out size-guard: when a result is oversized OR the caller explicitly passed a paging
// arg, page the result's primary list and attach a `_pagination` note telling the model exactly how
// to fetch the next page (call the SAME op with the same args + a bumped offset). Never drops data
// silently — the note always carries the true total and the next-offset instruction.
const MAX_TOOL_RESULT_BYTES = 16_000; // ~4k tokens — a safety ceiling, not a hard per-op contract.
const DEFAULT_TOOL_PAGE_SIZE = 50;

/** Read a numeric paging arg, accepting both `limit`/`offset` and `_limit`/`_offset` spellings. */
function pageArg(params: Record<string, unknown>, ...names: string[]): number | undefined {
  for (const n of names) {
    const v = params[n];
    if (typeof v === "number" && Number.isFinite(v)) return v;
    if (typeof v === "string" && v.trim() !== "" && Number.isFinite(Number(v))) return Number(v);
  }
  return undefined;
}

/** Locate the "primary" array in an op's output: the output itself if it's an array, else the
 *  longest array-valued field of a plain object. Returns null when there's nothing list-shaped. */
function findPrimaryArray(
  output: unknown
): { arr: unknown[]; rebuild: (page: unknown[], note: unknown) => unknown } | null {
  if (Array.isArray(output)) {
    return { arr: output, rebuild: (page, note) => ({ items: page, _pagination: note }) };
  }
  if (output && typeof output === "object") {
    const obj = output as Record<string, unknown>;
    let bestKey: string | null = null;
    let bestLen = -1;
    for (const [k, v] of Object.entries(obj)) {
      if (Array.isArray(v) && v.length > bestLen) {
        bestKey = k;
        bestLen = v.length;
      }
    }
    if (bestKey !== null) {
      const key = bestKey;
      return { arr: obj[key] as unknown[], rebuild: (page, note) => ({ ...obj, [key]: page, _pagination: note }) };
    }
  }
  return null;
}

/**
 * Apply the generic result limit. Untouched (byte-identical) when the result is small AND the
 * caller passed no paging arg — so ordinary small results keep their exact shape. Otherwise pages
 * the primary list, or (no list to page) truncates a genuinely oversized blob with an instruction.
 * Exported for direct unit testing — it must behave the same in isolation as inside run().
 */
export function applyToolResultLimit(output: unknown, params: Record<string, unknown>): unknown {
  const explicitLimit = pageArg(params, "limit", "_limit");
  const explicitOffset = pageArg(params, "offset", "_offset");
  let bytes: number;
  try {
    bytes = JSON.stringify(output ?? null).length;
  } catch {
    return output; // Non-serializable (shouldn't happen for a real op result) — leave it be.
  }
  const oversized = bytes > MAX_TOOL_RESULT_BYTES;
  const pagingRequested = explicitLimit !== undefined || explicitOffset !== undefined;
  if (!oversized && !pagingRequested) return output;

  const primary = findPrimaryArray(output);
  if (primary) {
    const total = primary.arr.length;
    let limit = explicitLimit ?? DEFAULT_TOOL_PAGE_SIZE;
    if (explicitLimit === undefined && oversized && total > 0) {
      // Shrink the page until it fits the byte budget: average per-item bytes → items that fit.
      const perItem = Math.max(1, Math.floor(bytes / total));
      limit = Math.max(1, Math.floor(MAX_TOOL_RESULT_BYTES / perItem));
    }
    const offset = Math.max(0, explicitOffset ?? 0);
    const page = primary.arr.slice(offset, offset + limit);
    const hasMore = offset + limit < total;
    const note: Record<string, unknown> = {
      total,
      offset,
      limit,
      returned: page.length,
      has_more: hasMore,
    };
    if (hasMore) {
      note["next_offset"] = offset + limit;
      note["instruction"] =
        `Showing ${page.length} of ${total} items. To see more, call this SAME operation again ` +
        `with the same arguments plus offset=${offset + limit} (add limit=<n> to change the page size).`;
    }
    return primary.rebuild(page, note);
  }

  // No list to page, but genuinely oversized — a large scalar/blob. Truncate the string view.
  if (oversized) {
    let s: string;
    try {
      s = typeof output === "string" ? output : JSON.stringify(output);
    } catch {
      s = String(output);
    }
    return {
      _truncated: true,
      _total_bytes: bytes,
      preview: s.slice(0, MAX_TOOL_RESULT_BYTES),
      instruction:
        `This result is ${bytes} bytes and was truncated to ${MAX_TOOL_RESULT_BYTES}. ` +
        `Use a search/read operation with a query or offset to fetch only the part you need ` +
        `rather than the whole thing.`,
    };
  }
  return output;
}

export class ScriptToolSurface {
  private readonly library: SkillLibrary;
  private readonly ops: Map<string, { op: PrebuiltOp; prebuilt: PrebuiltScript }>;
  /** Progressive tool disclosure mode for THIS run — see disclosureGroups()'s own doc. Starts
   *  "reduced" only when the caller opted in (env.progressiveToolDisclosure); can only ever
   *  move toward "full" during a run (the automatic miss-streak fallback), never the reverse. */
  private disclosureMode: "full" | "reduced";
  /** Consecutive "unknown operation" errors since the last successfully-resolved call, tracked
   *  only while disclosureMode is "reduced" — see the miss-streak comment in run(). */
  private missStreak = 0;

  constructor(
    private readonly env: ScriptEngineEnv,
    /** Enabled prebuilt scripts from the agent's scripts.json `prebuilt` list. */
    enabledPrebuilt: string[]
  ) {
    this.library = new SkillLibrary(env.scriptsBucket, env.spaceId);
    this.ops = buildOperationMap(enabledPrebuilt);
    this.disclosureMode = env.progressiveToolDisclosure ? "reduced" : "full";
    // tools.search/tools.describe are meta-operations ABOUT whatever is already enabled — always
    // registered (regardless of disclosureMode) so they're callable even in full-disclosure mode,
    // and so a test/caller doesn't need to special-case their existence. They cost nothing and
    // touch no external system; requires_tier 1 (the cheapest) reflects that honestly.
    const toolsMeta: PrebuiltScript = {
      name: "tools",
      description:
        "Search for an operation by what it does, or look up its exact parameters by name — " +
        "for anything not already shown in available_operations.",
      domain: "api",
      requires_tier: 1,
      operations: {},
      paramHints: {
        "tools.search": "query is required — what you're trying to do, in plain words (e.g. 'send an email', 'list projects'). Always returns at least a few results, never empty.",
        "tools.describe": "name is required — the exact operation name (e.g. 'thread.send_message'), usually one tools.search already gave you.",
      },
    };
    this.ops.set("tools.search", { prebuilt: toolsMeta, op: async (args) => this.searchOperations(String(args["query"] ?? "")) });
    this.ops.set("tools.describe", { prebuilt: toolsMeta, op: async (args) => this.describeOperation(String(args["name"] ?? "")) });
  }

  /**
   * Rank every enabled operation (INCLUDING ones not in CORE_OPERATIONS) against `query` by
   * simple token overlap against its name, owning script, description, and param hint. Never
   * returns empty: a zero-hit search falls back to the core set, and if that's somehow empty
   * too, the first 8 operations overall — a search must always give the model somewhere to go
   * next rather than a dead end.
   */
  private searchOperations(query: string): { query: string; results: Array<{ name: string; script: string; description: string; param_hint?: string }> } {
    const tokenize = (s: string) => s.toLowerCase().split(/[^a-z0-9]+/i).filter(Boolean);
    const wanted = tokenize(query);
    const scored: Array<{ name: string; script: string; description: string; paramHint?: string; hits: number }> = [];
    for (const [opName, { prebuilt }] of this.ops) {
      const hint = prebuilt.paramHints?.[opName];
      const haystack = new Set(tokenize(`${opName} ${prebuilt.name} ${prebuilt.description} ${hint ?? ""}`));
      const hits = wanted.length === 0 ? 0 : wanted.filter((w) => haystack.has(w)).length;
      scored.push({ name: opName, script: prebuilt.name, description: prebuilt.description, ...(hint ? { paramHint: hint } : {}), hits });
    }
    scored.sort((a, b) => b.hits - a.hits || a.name.localeCompare(b.name));
    let top = scored.filter((s) => s.hits > 0).slice(0, 8);
    if (top.length === 0) top = scored.filter((s) => CORE_OPERATIONS.has(s.name)).slice(0, 8);
    if (top.length === 0) top = scored.slice(0, 8);
    return {
      query,
      results: top.map(({ name, script, description, paramHint }) => ({
        name,
        script,
        description,
        ...(paramHint ? { param_hint: paramHint } : {}),
      })),
    };
  }

  /** Full detail for one named operation — its owning script, tier, and exact parameter hint
   *  when one is declared. An unknown name reuses the same "did you mean" suggestion run() gives
   *  a bad script.run call, so tools.describe and script.run never disagree about what exists. */
  private describeOperation(name: string): unknown {
    const entry = this.ops.get(name);
    if (!entry) return { ok: false, error: `Unknown operation: ${name}.${this.suggestOperations(name)}` };
    return {
      name,
      script: entry.prebuilt.name,
      script_description: entry.prebuilt.description,
      requires_tier: entry.prebuilt.requires_tier,
      ...(entry.prebuilt.paramHints?.[name] ? { param_hint: entry.prebuilt.paramHints[name] } : {}),
    };
  }

  get skillLibrary(): SkillLibrary {
    return this.library;
  }

  /** Names of all available prebuilt operations (for prompt construction / discovery). */
  availableOperations(): string[] {
    return [...this.ops.keys()];
  }

  /**
   * Live-reported bug: `available_operations` reached the reasoner as a bare flat list of op
   * NAMES with no description or grouping (e.g. "thread.create", "thread.send_message" sitting
   * unexplained among 60+ other names). A model asked to "communicate with an agent directly in
   * a thread" reasonably concluded no such capability existed — it never had enough context to
   * recognize those two names as the answer, and had no parameter schema to call them correctly
   * even if it guessed right. Grouped by owning prebuilt SCRIPT with that script's own
   * (already-written) description gives the model the same "what is this for" context
   * `candidate_scripts` already carries for the skill library, without writing a new description
   * per individual operation — one line of real, already-maintained prose per group is enough to
   * make "thread.send_message" legible as "the thing that lets me chat inside an existing
   * thread" instead of an opaque string.
   */
  availableOperationsGrouped(): OperationGroup[] {
    const byScript = new Map<
      string,
      { description: string; operations: string[]; paramHints: Record<string, string> }
    >();
    for (const [opName, { prebuilt }] of this.ops) {
      const existing = byScript.get(prebuilt.name);
      const hint = prebuilt.paramHints?.[opName];
      if (existing) {
        existing.operations.push(opName);
        if (hint) existing.paramHints[opName] = hint;
      } else {
        byScript.set(prebuilt.name, {
          description: prebuilt.description,
          operations: [opName],
          paramHints: hint ? { [opName]: hint } : {},
        });
      }
    }
    return [...byScript.entries()].map(([script, v]) => ({
      script,
      description: v.description,
      operations: v.operations,
      ...(Object.keys(v.paramHints).length > 0 ? { paramHints: v.paramHints } : {}),
    }));
  }

  /**
   * What actually reaches the reasoner payload as `available_operations` — see
   * ScriptEngineEnv.progressiveToolDisclosure's own doc for the design rationale.
   *
   * "full" mode (default): byte-identical to availableOperationsGrouped() — every enabled
   * operation, every turn, unchanged from before this feature existed.
   *
   * "reduced" mode (opt-in): only CORE_OPERATIONS, plus a synthetic "tools" group describing
   * tools.search/tools.describe for finding everything else. Execution is NOT restricted either
   * way — script.run still accepts any enabled operation whether or not it was shown here, so
   * this can only ever shrink what the model reads, never block a call it correctly guesses or
   * finds via tools.search.
   *
   * Automatic fallback: once run() records MISS_FALLBACK_THRESHOLD consecutive "unknown
   * operation" errors while in reduced mode, disclosureMode flips to "full" — since loop.ts
   * calls this fresh every reasoning turn, the very next call returns the full dump with no
   * further plumbing needed. A model that can't find what it needs through search is never
   * permanently stuck; it falls back to the old, proven-reliable behavior for the rest of the run.
   */
  disclosureGroups(): OperationGroup[] {
    const full = this.availableOperationsGrouped();
    if (this.disclosureMode === "full") return full;

    const core = full
      .map((g) => {
        const operations = g.operations.filter((op) => CORE_OPERATIONS.has(op));
        const paramHints = g.paramHints
          ? Object.fromEntries(Object.entries(g.paramHints).filter(([op]) => CORE_OPERATIONS.has(op)))
          : undefined;
        return { ...g, operations, ...(paramHints && Object.keys(paramHints).length ? { paramHints } : {}) };
      })
      .filter((g) => g.operations.length > 0);
    const shownCount = core.reduce((n, g) => n + g.operations.length, 0);
    const remaining = this.ops.size - shownCount - 2; // -2: tools.search/tools.describe themselves
    core.push({
      script: "tools",
      description:
        `${Math.max(remaining, 0)} more operation(s) exist across other scripts, not shown here to ` +
        `keep this list short. Call tools.search({query}) to find one by what it does (never empty ` +
        `— always returns the nearest matches), or tools.describe({name}) for its exact parameters ` +
        `once you know the name.`,
      operations: ["tools.search", "tools.describe"],
    });
    return core;
  }

  /**
   * Restricted-project execution ceiling (e.g. a customer-bot project capped at Tier 2) —
   * fail closed on any tier above it, for both authoring (script.create/update) and running
   * (script.run). Structural, not a prompt instruction: a compromised or over-eager reasoner
   * cannot talk its way past this.
   */
  private assertWithinCeiling(tier: ExecutionTier, context: string): void {
    if (this.env.maxTier !== undefined && tier > this.env.maxTier) {
      throw new Error(
        `Tier ${tier} exceeds this project's execution ceiling (${this.env.maxTier}) for ${context}. ` +
        `This project is configured as a restricted customer-facing bot — ask an admin to raise ` +
        `its execution ceiling if this capability is actually needed.`
      );
    }
  }

  /**
   * F-36 read-only clamp (see assistant-access.ts / ScriptEngineEnv.effectiveRole) — this run
   * acts on behalf of a user whose effective role in the bound project is `viewer`, so every
   * mutation is structurally refused. Same posture as assertWithinCeiling: a compromised or
   * over-eager reasoner cannot talk its way past this, and the error tells the agent to relay
   * the limitation honestly instead of retrying.
   */
  private assertWritable(context: string): void {
    if (this.env.effectiveRole === "viewer") {
      throw new Error(
        `${context} refused: this run acts on behalf of a user whose assistant access to this ` +
        `project is read-only (F-36 clamp). Only read operations are permitted — tell the user ` +
        `a project owner/editor must make this change (or adjust their assistant_mode).`
      );
    }
  }

  // ── script.create ──────────────────────────────────────────────────────────
  async create(input: {
    name: string;
    code?: string;
    metadata: Partial<ScriptMetadata> & Pick<ScriptMetadata, "description" | "domain" | "requires_tier">;
  }): Promise<ScriptMetadata> {
    this.assertWritable(`script.create('${input.name}')`);
    this.assertWithinCeiling(input.metadata.requires_tier, `script.create('${input.name}')`);

    // Income-wallet protection: a user/agent script may never collect money. Only the
    // prebuilt commerce op (Naelao's Lemon Squeezy store) may — that is how the platform
    // fee is guaranteed. Reject reserved-capability authoring at create time (fail-closed).
    assertNoReservedViolation({
      name: input.name,
      code: input.code,
      tags: input.metadata.tags,
      domain: input.metadata.domain,
    });

    // Embed at create time (spec §16) so script.find can retrieve it.
    if (this.env.embedder && !input.metadata.embedding_vector) {
      try {
        input.metadata.embedding_vector = await this.env.embedder.embed(
          `${input.metadata.description}\n${input.code ?? ""}`.slice(0, 4000)
        );
      } catch {
        /* embedding is best-effort; find degrades to tag/text scan */
      }
    }
    const meta = await this.library.create(input);
    await indexScriptEmbedding(this.env, meta);
    return meta;
  }

  // ── script.read ────────────────────────────────────────────────────────────
  read(name: string): Promise<StoredScript | null> {
    return this.library.read(name);
  }

  // ── script.update ──────────────────────────────────────────────────────────
  async update(
    name: string,
    patch: { code?: string; metadata?: Partial<ScriptMetadata> },
    reason: string
  ): Promise<ScriptMetadata> {
    this.assertWritable(`script.update('${name}')`);
    // Re-check on update so a benign script can't be edited into a money-in bypass — and so a
    // ceiling lowered AFTER creation (admin restricts a project) is enforced retroactively.
    if (patch.metadata?.requires_tier !== undefined) {
      this.assertWithinCeiling(patch.metadata.requires_tier, `script.update('${name}')`);
    } else {
      const existing = await this.library.read(name);
      if (existing) this.assertWithinCeiling(existing.metadata.requires_tier, `script.update('${name}')`);
    }
    assertNoReservedViolation({
      name,
      code: patch.code,
      tags: patch.metadata?.tags,
      domain: patch.metadata?.domain,
    });
    const meta = await this.library.update(name, patch, reason);
    await indexScriptEmbedding(this.env, meta);
    return meta;
  }

  // ── script.delete ──────────────────────────────────────────────────────────
  async delete(name: string): Promise<void> {
    this.assertWritable(`script.delete('${name}')`);
    await this.library.delete(name);
    await removeScriptEmbedding(this.env, name);
  }

  // ── script.find ────────────────────────────────────────────────────────────
  find(
    query: string,
    opts?: { snapshot?: ObserveSnapshot; domain?: ScriptDomain; limit?: number }
  ): Promise<FindCandidate[]> {
    return scriptFind(this.env, query, opts);
  }

  // ── script.run ─────────────────────────────────────────────────────────────
  /**
   * Name the real operations closest to one a model got wrong, so the next turn can correct
   * itself instead of re-guessing until the stall budget runs out. A bare "Unknown script or
   * operation: X" gives a model nothing to work with — and the observed real failure was a
   * model writing a prebuilt's descriptive phrase ("notifications prebuilt") rather than an op
   * name, which shares a token with the answer it wanted. Prebuilt ops only: they're already in
   * memory, so a miss costs nothing, whereas listing the R2 skill library would turn every
   * mistyped name into a bucket listing.
   *
   * Live-reported: a namespaced guess like "project-coordination:thread.create" tokenizes to
   * include the PREBUILT's own name ("project", "coordination"), which gives every single op in
   * that one script the same inflated hit count purely from matching the prefix the model added —
   * and the old alphabetical tie-break then arbitrarily excluded whichever op sorted last among
   * the tied group once the top-6 cap was hit. In the observed case that was
   * "thread.send_message", the one op that was actually the answer, cut from a list of 7 tied
   * siblings by nothing more than its name coming last alphabetically. Most of THIS specific
   * failure mode is now resolved upstream (reasoner.ts's stripNamespacePrefix runs a colon-guess
   * directly rather than ever reaching this error path) — this fixes the suggestion quality for
   * every OTHER wrong-name guess, which still reaches here.
   */
  private suggestOperations(name: string): string {
    const tokenize = (s: string) => s.toLowerCase().split(/[^a-z0-9]+/i).filter(Boolean);
    // Prefer the part after a colon, if there is one — that is the model's actual guess at the
    // OP name; the prefix before it (if any) is its guess at the owning script, already captured
    // separately below. Tokenizing the whole raw string here is what inflated every op in one
    // script to the same score in the first place.
    const hasNamespace = name.includes(":");
    const opPart = hasNamespace ? name.slice(name.lastIndexOf(":") + 1).trim() || name : name;
    const wanted = tokenize(opPart);
    if (wanted.length === 0) return "";
    // Match against the owning PREBUILT's name as well as the op name — but only from the
    // NAMESPACE part of a colon-guess (already captured separately, not re-added into `wanted`),
    // so a genuine descriptive-phrase miss ("notifications prebuilt", no colon — covered by
    // `wanted` already equalling the whole name) still benefits from this without a colon-guess
    // getting its script-name tokens counted twice.
    const namespaceTokens = hasNamespace ? tokenize(name.slice(0, name.lastIndexOf(":"))) : [];
    const scored: Array<{ op: string; hits: number; distance: number }> = [];
    for (const [op, entry] of this.ops) {
      const tokens = new Set([...tokenize(op), ...tokenize(entry.prebuilt.name)]);
      const hits = wanted.filter((w) => tokens.has(w)).length + namespaceTokens.filter((w) => tokens.has(w)).length;
      if (hits > 0) scored.push({ op, hits, distance: levenshtein(opPart.toLowerCase(), op.toLowerCase()) });
    }
    if (scored.length === 0) return "";
    // Ties broken on edit distance to the actual guess — closer string wins — instead of
    // alphabetical order, which had no relationship to relevance and is what silently dropped the
    // real answer from the live-reported case above.
    scored.sort((a, b) => b.hits - a.hits || a.distance - b.distance || a.op.localeCompare(b.op));
    const names = scored.slice(0, 8).map((s) => s.op);
    return ` Did you mean one of: ${names.join(", ")}? Use the exact operation name.`;
  }

  /**
   * Run a prebuilt operation or a stored script. Records success/failure health on stored
   * scripts so stability_score stays accurate.
   */
  /**
   * Resolve the two ways a model addresses an operation THROUGH the script that owns it.
   *
   * `available_operations` is grouped by script, so a model reading it sees both names and
   * reaches for the pair. Observed live in a single unattended run, twice, each costing two
   * steps: `workspace-admin.project.list` (owning script, dot, real op) and `business-diagnostics`
   * with `params.operation = "diagnostics.overview"` (owning script alone, operation moved into
   * the arguments). Both name a real script AND a real operation of it — the intent is not in
   * doubt, only the spelling — so failing them wastes a reasoning turn on a self-correction the
   * platform can just do.
   *
   * Deliberately narrow: a prefix is only stripped when it matches a script that actually exists
   * AND the remainder is an operation that script actually owns. That is what makes this
   * incapable of inventing an action — it can only ever map onto something already callable. It
   * must also run UPSTREAM of the HITL gate (see the loop's call site and stripNamespacePrefix's
   * own doc): resolving here rather than inside run() is what stops an alias of a gated action
   * slipping past a `gate_listed` allowlist unapproved.
   */
  resolveOperationAlias(
    name: string,
    params: Record<string, unknown>
  ): { name: string; params: Record<string, unknown> } {
    if (this.ops.has(name)) return { name, params };

    // An operation that has been RENAMED still answers to its old name. Learned skills live in R2
    // as stored code that this deploy cannot rewrite, and an agent profile's wording is only ever
    // advisory — so a rename that isn't aliased silently breaks every skill already written against
    // the old spelling, on businesses that were working fine yesterday.
    const renamed = RENAMED_OPERATIONS[name];
    if (renamed && this.ops.has(renamed)) return { name: renamed, params };

    // "<script>.<op>" / "<script>:<op>" — a real op cannot be found by splitting on the last dot
    // (op names are themselves dotted: project.list, notify.email), so match the script instead.
    for (const [opName, { prebuilt }] of this.ops) {
      for (const sep of [".", ":"]) {
        if (name === `${prebuilt.name}${sep}${opName}`) return { name: opName, params };
      }
    }

    // The bare script name, with the operation named in the arguments.
    for (const key of ["operation", "op", "action", "name"]) {
      const candidate = params[key];
      if (typeof candidate !== "string") continue;
      const entry = this.ops.get(candidate);
      if (!entry || entry.prebuilt.name !== name) continue;
      const { [key]: _moved, ...rest } = params;
      return { name: candidate, params: rest };
    }

    // The bare script name, with the operation used as a KEY whose value is the real argument
    // object: `workspace-admin` + `{"project.create": {name: "..."}}`. Seen live, and the most
    // expensive of the three spellings — the model had assembled correct arguments, lost them
    // when the call was refused, and then retried the right operation with nothing in it.
    const opKeys = Object.keys(params).filter(
      (k) => this.ops.get(k)?.prebuilt.name === name && params[k] !== null && typeof params[k] === "object"
    );
    if (opKeys.length === 1) {
      const key = opKeys[0]!;
      return { name: key, params: params[key] as Record<string, unknown> };
    }

    return { name, params };
  }

  async run(name: string, params: Record<string, unknown> = {}): Promise<ScriptRunResult> {
    const started = Date.now();
    const mutationIntent = name === "Bash"
      ? String(params["commands"] ?? params["command"] ?? params["cmd"] ?? "")
      : `${name} ${JSON.stringify(params)}`;
    try {
      await enforceWriteGuard(mutationIntent, this.env.mutationGrant, this.env.platformSecret ?? "", {
        subject: this.env.humanInvokerId ?? "system",
        resource: this.env.projectId ?? this.env.spaceId,
      });
      if (requiresMutationGrant(mutationIntent) && this.env.consumeMutationGrant && !(await this.env.consumeMutationGrant())) {
        throw new Error("mutation_grant_replayed");
      }
    } catch {
      return { ok: false, error: "destructive_mutation_denied", tier: 1, duration_ms: Date.now() - started, tokens_used: 0 };
    }
    if (name === "Bash") {
      try {
        const intercepted = interceptPlatformCli(mutationIntent);
        if (intercepted) return this.run(intercepted.operation, intercepted.params);
      } catch (error) {
        return { ok: false, error: error instanceof Error ? error.message : "invalid_cli_command", tier: 2, duration_ms: Date.now() - started, tokens_used: 0 };
      }
    }

    // F-36 read-only clamp: a viewer-clamped run may execute only explicitly read-safe
    // prebuilt ops — never a stored script (arbitrary agent-authored code is assumed to
    // mutate; fail closed). Checked before resolution so a refused name never even reads
    // the library (no outcome recorded against the script's stability score).
    if (this.env.effectiveRole === "viewer" && !isReadSafeOperation(name)) {
      return {
        ok: false,
        error:
          `script.run('${name}') refused: this run acts on behalf of a user whose assistant ` +
          `access to this project is read-only (F-36 clamp). Only read operations are ` +
          `permitted — tell the user a project owner/editor must perform this action ` +
          `(or adjust their assistant_mode).`,
        tier: 1,
        duration_ms: Date.now() - started,
        tokens_used: 0,
      };
    }

    // 1. Prebuilt operation?
    const prebuilt = this.ops.get(name);
    if (prebuilt) {
      // A resolved name — whatever happens next, this was not a "guessed the wrong name" miss.
      // See the miss-streak comment at the "Unknown script or operation" branch below.
      this.missStreak = 0;
      if (this.env.maxTier !== undefined && prebuilt.prebuilt.requires_tier > this.env.maxTier) {
        return {
          ok: false,
          error: `Tier ${prebuilt.prebuilt.requires_tier} exceeds this project's execution ceiling (${this.env.maxTier}) for script.run('${name}').`,
          tier: prebuilt.prebuilt.requires_tier,
          duration_ms: Date.now() - started,
          tokens_used: 0,
        };
      }
      try {
        const output = await prebuilt.op(params, {
          env: this.env,
          // skills calling skills (§7): a prebuilt op may invoke another op/script.
          run: async (n, p) => {
            const r = await this.run(n, p ?? {});
            if (!r.ok) throw new Error(r.error ?? `nested script ${n} failed`);
            return r.output;
          },
        });
        // §A1.25: a prebuilt op that made its OWN LLM call internally (e.g. web-search's
        // grounded_answer, which calls the native-web-search-enabled LLM directly rather than
        // going through the reasoner) reports its real usage in `output.usage` — surfaced here
        // so it's billed exactly like reasoner-driven tokens are (settleRunBilling reads
        // ScriptRunResult.tokens_used/input_tokens/output_tokens via withTokenUsage). An op that
        // never touches an LLM leaves this at 0, unchanged from before this feature existed.
        const usage = (output as { usage?: { tokens_used?: number; input_tokens?: number; output_tokens?: number } } | null)?.usage;
        // Step 9: generic result-size guard. Read usage from the ORIGINAL output above (the
        // paginated view may replace the primary list), then hand the model the size-limited view.
        const limited = applyToolResultLimit(output, params);
        return {
          ok: true,
          output: limited,
          tier: prebuilt.prebuilt.requires_tier,
          duration_ms: Date.now() - started,
          tokens_used: usage?.tokens_used ?? 0,
          ...(usage?.input_tokens !== undefined ? { input_tokens: usage.input_tokens } : {}),
          ...(usage?.output_tokens !== undefined ? { output_tokens: usage.output_tokens } : {}),
        };
      } catch (err) {
        // Growth-layer "click Install" onboarding (mcp-connector.ts's resolveServerId): a thrown
        // Error can carry needsConnector/connectorId/connectorName metadata (same precedent as
        // reserved-capabilities.ts's `reserved` flag) — surfaced as real result fields so the
        // reasoning loop's answer, and any future UI, sees a structured signal rather than only
        // free text buried in the error message.
        const meta = err as unknown as Record<string, unknown>;
        return {
          ok: false,
          error: err instanceof Error ? err.message : String(err),
          tier: prebuilt.prebuilt.requires_tier,
          duration_ms: Date.now() - started,
          tokens_used: 0,
          ...(typeof meta["needsConnector"] === "boolean" ? { needs_connector: meta["needsConnector"] as boolean } : {}),
          ...(typeof meta["connectorId"] === "string" ? { connector_id: meta["connectorId"] as string } : {}),
          ...(typeof meta["connectorName"] === "string" ? { connector_name: meta["connectorName"] as string } : {}),
        };
      }
    }

    // 2. Stored script in the skill library?
    const stored = await this.library.read(name);
    if (!stored) {
      // Genuinely unresolvable name. In reduced-disclosure mode this is the one real risk of
      // showing less up front — a model that can't find something through tools.search might
      // otherwise just keep guessing. Track it, and once it happens MISS_FALLBACK_THRESHOLD
      // times in a row (reset by any successfully-resolved call above), permanently widen this
      // run to full disclosure — disclosureGroups() is called fresh every turn, so the very next
      // reasoning call sees everything, no further plumbing required.
      let fallbackNote = "";
      if (this.disclosureMode === "reduced") {
        this.missStreak++;
        if (this.missStreak >= MISS_FALLBACK_THRESHOLD) {
          this.disclosureMode = "full";
          fallbackNote = " Switched to showing every available operation for the rest of this run.";
        }
      }
      return {
        ok: false,
        error: `Unknown script or operation: ${name}.${this.suggestOperations(name)}${fallbackNote}`,
        tier: 1,
        duration_ms: Date.now() - started,
        tokens_used: 0,
      };
    }
    this.missStreak = 0;
    if (this.env.maxTier !== undefined && stored.metadata.requires_tier > this.env.maxTier) {
      return {
        ok: false,
        error: `Tier ${stored.metadata.requires_tier} exceeds this project's execution ceiling (${this.env.maxTier}) for script.run('${name}').`,
        tier: stored.metadata.requires_tier,
        duration_ms: Date.now() - started,
        tokens_used: 0,
      };
    }
    const result = await runStoredScript(this.env, stored, params);
    // The error, not just the boolean: it is what a later repair is aimed at, and what lets the
    // next run see "failed its last three times, and here is why" instead of a lower number.
    await this.library.recordOutcome(name, result.ok, result.error);
    return result;
  }
}
</file>

<file path="workers/agents/src/script-engine/types.ts">
/**
 * Script-First Agent Engine — core types.
 *
 * Authoritative source: original spec, bottom appendix "Script-First General Agent
 * Architecture" (byte ~6672k). This appendix OVERRIDES the early ReAct/hardcoded-tools
 * framing of NaelaoAgentDO. See docs/spec-appendix/A1-script-agents-and-space-assistants.md
 * §A1.7 and CLAUDE.md CURRENT DIRECTION #8.
 *
 * The agent's entire tool surface is six operations:
 *   script.create / read / update / delete / find / run
 * Every capability (browser, filesystem, API, container, comms, MCP) is a SCRIPT in a
 * library, not a built-in tool. The loop is:
 *   OBSERVE → FINGERPRINT → FIND → GATE → EXECUTE → VERIFY → DISTILL
 */

/** Execution tier a script declares (the orchestrator routes script.run by this). */
export type ExecutionTier = 1 | 2 | 3 | 4 | 5 | 6;

/** Domains an observe/action script can target. Open-ended by design. */
export type ScriptDomain =
  | "browser"
  | "filesystem"
  | "api"
  | "container"
  | "comms"
  | "compute"
  | "knowledge"
  | "orchestration"
  | string;

/** A single parameter the script accepts. */
export interface ScriptParameter {
  name: string;
  type: string;
  description: string;
  required: boolean;
  default?: unknown;
}

/**
 * One recorded run of a stored skill (see `ScriptMetadata.recent_outcomes`). The error is kept
 * on failures only, truncated — it is the input a repair is aimed at, not a log line.
 */
export interface SkillOutcome {
  ok: boolean;
  at: number;
  error?: string;
}

/** Recency verdict for a stored skill. Derived in skill-health.ts (all the logic lives there;
 *  the shape lives here so `FindCandidate` can carry it without a circular import). */
export type SkillHealthState = "unproven" | "proven" | "degrading" | "broken";

export interface SkillHealth {
  state: SkillHealthState;
  /** Failures at the head of the recent window — the streak, which is what actually predicts
   *  the next run. */
  consecutive_failures: number;
  recent_runs: number;
  recent_failures: number;
  /** The most recent failure's error, when there is one. What a repair is aimed at. */
  last_error?: string;
  /** One sentence written for the model, not for a dashboard. */
  recommendation: string;
}

/** Why and how a version came to be (one entry per version in patch_history). */
export interface PatchRecord {
  version: number;
  created_at: number;
  patch_type:
    | "initial"
    | "minor_fix"
    | "re_derivation"
    | "split"
    | "failed_patch";
  reason: string;
  fingerprint_before?: string;
  fingerprint_after?: string;
  success_count_at_patch: number;
  failure_count_at_patch: number;
}

/**
 * Full metadata stored alongside a script's code (spec §4.1).
 * Persisted as SCRIPT.md (human + JSON front-matter) in R2; the JSON form is the source
 * of truth the engine reads.
 */
export interface ScriptMetadata {
  // Identity
  name: string;
  version: number;
  domain: ScriptDomain;

  // Retrieval
  description: string;
  /** Embedding of description + code summary (for script.find ANN search). */
  embedding_vector?: number[];
  tags: string[];

  // Preconditions
  /** JSON-schema-like shape the OBSERVE snapshot must satisfy for this script to apply. */
  fingerprint_schema: Record<string, unknown>;
  preconditions: string[];

  // Parameters
  parameters: ScriptParameter[];

  // Dependencies (skill graph)
  calls: string[];
  requires_tier: ExecutionTier;
  /**
   * §A1.17 Phase J: "isolate" (default) executes synchronously in the Tier 2-5 runner and
   * blocks the calling script.run for the result. "workflow" dispatches to a durable CF
   * Workflow instance instead (step retries, survives restarts, can run for hours/days) and
   * returns immediately with a workflow id to poll — for long-running/cron automations that
   * must not hold an isolate or a DO awake the whole time. Orthogonal to requires_tier (which
   * still governs what the eventual execution is allowed to do).
   */
  runtime?: "isolate" | "workflow";
  /**
   * §A1.17 Phase L: when set on a `requires_tier: 5` script, execution routes to the named
   * Container Marketplace image's own DO/binding instead of the base per-project ToolSandboxDO
   * (Phase K) — a dedicated, long-running container (a database, a cache) rather than the shared
   * ephemeral sandbox. Fails closed with a clear error if the image isn't wired to a live binding
   * yet (see `container-catalogue.ts`'s `available` flag — every image ships unavailable this
   * pass; this field's routing hook is real ahead of any image actually going live).
   */
  container_image?: string;

  // Required credentials (resolved via credentials worker before L1 execution; A1.1)
  required_credentials?: string[];

  // Health
  success_count: number;
  failure_count: number;
  patch_history: PatchRecord[];
  /** Derived signal in [0,1]; gates L1 candidacy and sorts script.find results. */
  stability_score: number;
  /**
   * Bounded rolling window of the most recent runs, newest first (see skill-health.ts).
   * `stability_score` is a lifetime ratio and cannot express recency — 20 successes and 4
   * failures scores the same whether those failures are spread over a year or are the last
   * four in a row. This is what makes "failed its last three runs, and here is what it said"
   * knowable, which is the difference between demoting a skill and repairing it.
   * Optional: absent on scripts written before this existed, which read as unproven.
   */
  recent_outcomes?: SkillOutcome[];

  // Provenance
  /** "prebuilt" = bundled platform script; "distilled" = authored by an agent at L4;
   *  "authored" = installed by a builder/space. */
  origin: "prebuilt" | "distilled" | "authored";
  created_at: number;
  updated_at: number;
}

/** A script as stored: metadata + code. Prebuilt scripts carry a handler instead of code. */
export interface StoredScript {
  metadata: ScriptMetadata;
  /** TypeScript/JS source for tiered execution (agent-distilled / authored scripts). */
  code?: string;
}

/** Environment observation snapshot (spec §9). The `fingerprint` is the gating hash. */
export interface ObserveSnapshot {
  type: ScriptDomain;
  timestamp: number;
  /** Deterministic hash of the state properties that matter for script validity. */
  fingerprint: string;
  /** Arbitrary domain-specific fields (dom_hash, file_mtimes, schema_hash, …). */
  [field: string]: unknown;
}

/** Result of running a script at any tier. */
export interface ScriptRunResult {
  ok: boolean;
  /** Script return value (JSON-serializable). */
  output?: unknown;
  error?: string;
  tier: ExecutionTier;
  /** Milliseconds of wall-clock execution. */
  duration_ms: number;
  /** Reasoning-model tokens consumed by this run (0 for pure script execution). */
  tokens_used: number;
  /** Directional breakdown of tokens_used, when the reasoner reported it — lets the host
   *  compute a real per-model USD/credit cost (input and output are priced differently).
   *  Absent for pure script execution, where tokens_used is already 0. */
  input_tokens?: number;
  output_tokens?: number;
  /** Growth-layer "click Install" onboarding (mcp-connector.ts's resolveServerId): set when the
   *  op failed because a KNOWN catalogue connector isn't connected for this space yet — lets the
   *  reasoning loop's answer name the exact app to install instead of a bare "not found" error,
   *  and gives a future UI a structured signal to render a Connect action from (not just prose). */
  needs_connector?: boolean;
  connector_id?: string;
  connector_name?: string;
  /**
   * Who authored `error`: the MODEL (its own `give_up` reason, in its own words) or the
   * infrastructure around it (a gateway 429, a thrown exception, a budget gate).
   *
   * Load-bearing for the proactive loop, and found the hard way. A model that stops and explains
   * itself is describing a situation; it is not itself evidence that the situation is real. When
   * its prose was fed to classifyFailure like any other error string, a give_up that merely
   * MENTIONED running out of allowance was classified `quota_exhausted` — a kind whose whole
   * meaning is "this clears on its own, do not retry." The next wake-up's brief then told the
   * assistant its quota was spent, so it gave up again, and that give_up was classified the same
   * way. One genuine outage poisoned every future wake-up, permanently, long after capacity
   * returned — observed live: an assistant running fine on a completely different provider
   * refused to work because of a Workers AI failure from the previous day.
   */
  failure_origin?: "model" | "infrastructure";
}

/** A candidate returned by script.find. */
export interface FindCandidate {
  name: string;
  metadata: ScriptMetadata;
  semantic_similarity: number;
  /**
   * stability_score × semantic_similarity — "is this skill about the right thing?", with no
   * recency judgment folded in. The GATE tests THIS against the confidence floor, because a
   * broken skill is still the relevant one: reading it as "nothing found" would send the agent
   * off to write a second skill for a job it already has one for, instead of fixing that one.
   */
  relevance: number;
  /** relevance × health multiplier — "and can I trust it as it stands?". The sort key, so
   *  anything that actually works out-ranks something that has been failing. */
  confidence: number;
  /**
   * Recency verdict derived from `metadata.recent_outcomes` (skill-health.ts). Carried on the
   * candidate so the GATE can refuse to auto-run something broken and the reasoner can see WHY
   * — without either re-deriving it from raw counters.
   */
  health?: SkillHealth;
}

/** Escalation level chosen by GATE (spec §5). */
export type EscalationLevel = "L1" | "L2" | "L3" | "L4";

/** Outcome of one OBSERVE→…→DISTILL pass. */
/**
 * One structured step of a run's execution — the persisted counterpart to `notes: string[]`
 * (which stays as a human-readable log line, unchanged). Phase HX1: this is what makes a run's
 * timing/tokens/tier/outcome queryable per-step (a builder trace view, and the input SkillOpt-
 * style skill evolution mines for consensus failure attributes), instead of only living in the
 * ephemeral response body.
 */
export interface TraceStep {
  seq: number;
  /** "observe" | "find" | "gate" | "reason" | "run" | "answer" | "give_up" */
  phase: string;
  /** Script name, when the step concerns one (find top candidate, reason decision, run). */
  name?: string | undefined;
  tier?: number | undefined;
  duration_ms?: number | undefined;
  tokens?: number | undefined;
  ok?: boolean | undefined;
  detail?: string | undefined;
  /** A reasoning-capable model's own chain-of-thought for this "reason" step, when the model
   *  returned one — see billing-core's MODEL_CAPABILITIES doc header for which models this
   *  applies to. Rendered as a collapsed "Thoughts" block a user can expand, distinct from
   *  `detail` (which stays a short label like the chosen action). */
  thinking?: string | undefined;
  /** The live STATUS for this step's action — the model's own `doing` parameter, e.g. "Checking
   *  what's already in your store". Rendered beside the action while it runs and REPLACED by the
   *  next action's own, so a run of tool calls shows one status line rather than one per call.
   *  See GatewayReasoner.lastNarration. Distinct from `thinking` (collapsed internal reasoning)
   *  and from `message` (a real, permanent message — see below). */
  narration?: string | undefined;
  /** A real MESSAGE the model chose to write to the person on this step — its optional `say`
   *  parameter. Unlike `narration` this is never replaced: it renders as its own line in the
   *  conversation, in order, and a run reads as message → tool calls → message → tool calls
   *  (Claude Code's own shape). Present only on turns where the model judged one was warranted,
   *  which is what keeps a long run readable. See GatewayReasoner.lastMessage. */
  message?: string | undefined;
  /** For a "run" phase step: the exact arguments the tool was called with — what lets an
   *  expanded tool call show the real command, not just a duration. Attached at both the "begin"
   *  checkpoint (before the call resolves) and the "complete" one (unchanged). */
  params?: unknown;
  /** For a "run" phase step that succeeded: a size-capped, stringified view of the tool's raw
   *  return value (see loop.ts's `formatToolOutput`). A failed call's outcome lives in `detail`/
   *  `error` instead — this is only ever set on success. */
  output?: string | undefined;
  /** Date.now() at the moment the step was recorded. */
  ts: number;
}

/**
 * A live progress checkpoint — a TraceStep before it has a place in the trace, plus the two fields
 * that only make sense WHILE something is happening and are therefore never persisted.
 *
 * The distinction matters: `TraceStep` is the durable record of what a run did, read back long
 * after the fact from `run_traces`. This is the transient view of a run in flight, and it carries
 * text that is still growing — so a consumer has to know whether what it is holding is finished.
 */
export type LiveCheckpoint = Omit<TraceStep, "seq" | "ts"> & {
  /**
   * This checkpoint UPDATES the step already in flight rather than describing a new one — the
   * model is mid-sentence and this is the sentence so far. A consumer replaces its current step
   * in place instead of appending, or a single reasoning turn would produce dozens of rows.
   */
  partial?: boolean | undefined;
  /**
   * The final answer as it is being written, for a turn where the model chose to answer.
   *
   * Kept apart from `narration` because the two end up in different places on screen: narration is
   * a line inside the activity sequence, whereas this becomes the assistant's actual reply bubble.
   * Merging them would print the answer twice.
   */
  answer_preview?: string | undefined;
};

export interface LoopResult {
  level: EscalationLevel;
  script_name?: string;
  result?: ScriptRunResult;
  /** Set when a new/patched script was produced and queued for async compile. */
  distilled_script?: string;
  notes: string[];
  /** Structured per-phase/per-script.run trace (Phase HX1) — same run, richer than `notes`. */
  trace: TraceStep[];
  /**
   * Set only when the run stopped because a gated action is waiting on a human. This is NOT a
   * failure and must never be rendered as one: the work is intact, paused at the point just
   * before the gated action, and resumable once someone answers. `steps_completed` is what the
   * run had already done, carried so a resume can hand it back to the model rather than
   * re-deriving (or worse, re-executing) it.
   */
  pending_approval?: {
    approval_id: string;
    action_name: string;
    params: Record<string, unknown>;
    expires_at?: number;
    steps_completed: Array<{
      name: string;
      params: Record<string, unknown>;
      ok: boolean;
      output?: unknown;
      error?: string;
    }>;
  };
  /**
   * Actions parked mid-run because they need a human, on a run that CARRIED ON around them and
   * finished. Distinct from `pending_approval`, which is the whole run stopping: here the agent
   * did everything else it could, so there is a real answer AND some outstanding work.
   *
   * Blocking on the first thing that needs permission is what makes an agent useless in practice —
   * an assistant with five jobs stops dead on the one that needs a signature and stays stopped
   * until somebody happens to look. Each entry carries its own checkpoint so it resumes alone.
   */
  deferred_approvals?: Array<{
    approval_id: string;
    action_name: string;
    params: Record<string, unknown>;
    expires_at?: number;
    steps_completed: Array<{
      name: string;
      params: Record<string, unknown>;
      ok: boolean;
      output?: unknown;
      error?: string;
    }>;
  }>;
  /**
   * The ungated work this run completed, on EVERY exit — success, failure or exhaustion.
   *
   * A failed run used to hand back an error and nothing else, so the only thing a caller could
   * offer was "start over", which redoes side effects that already happened. With this, a failure
   * is resumable: the caller checkpoints these steps and a Continue picks up from them.
   */
  steps_completed?: Array<{
    name: string;
    params: Record<string, unknown>;
    ok: boolean;
    output?: unknown;
    error?: string;
  }>;
}

// ── Engine bindings (dependency-injected so the engine is testable + DO-agnostic) ──────

/** Embeds text into a vector for script.find. Backed by Workers AI or an external model. */
export interface Embedder {
  embed(text: string): Promise<number[]>;
}

/** Minimal Vectorize surface the engine needs (avoids a hard dep on the CF type). */
export interface VectorIndex {
  upsert(
    vectors: Array<{
      id: string;
      values: number[];
      metadata?: Record<string, unknown>;
    }>
  ): Promise<unknown>;
  query(
    vector: number[],
    opts: {
      topK: number;
      filter?: Record<string, unknown>;
      returnMetadata?: boolean;
    }
  ): Promise<{
    matches: Array<{
      id: string;
      score: number;
      metadata?: Record<string, unknown>;
    }>;
  }>;
  deleteByIds(ids: string[]): Promise<unknown>;
}

/**
 * Runs arbitrary stored script code at a given tier. Injected because the concrete
 * mechanism differs by environment: Dynamic Worker Loader (T2/T3), CF Browser proxy (T4),
 * SandboxDO/Containers (T5). T1 is handled in-process by the R2 store.
 */
export interface TieredCodeRunner {
  run(params: {
    name: string;
    code: string;
    tier: ExecutionTier;
    args: Record<string, unknown>;
    spaceId: string;
    agentId: string;
    /** §A1.17 Phase I: needed so Tier 2-4 isolates can mint a scoped internal token for the
     *  ctx.mcp loopback (mcp-hub is HMAC-gated) without ever exposing the platform secret itself
     *  to the isolate. */
    tenantId: string;
    /** Original human invoker, preserved for user-private connector resolution. */
    userId?: string;
    /** §A1.17 Phase K: which R2 workspace (see workspacePrefix()) a Tier 5 container syncs
     *  files with — project-scoped when set, space-scoped (the Space Assistant) when absent.
     *  Only consumed by Tier 5 today; Tiers 2-4 don't touch a filesystem. */
    projectId?: string;
    /** §A1.17 Phase L: routes a Tier 5 run to this Container Marketplace image's own binding
     *  instead of the base per-project ToolSandboxDO. Absent = the ordinary Phase K sandbox. */
    containerImage?: string;
  }): Promise<ScriptRunResult>;
}

/**
 * Orchestration hooks the host (NaelaoAgentDO) provides for prebuilt scripts that need
 * platform primitives the engine itself does not own (sub-agents, workflows). Optional —
 * when absent the corresponding prebuilt operations report themselves unavailable.
 */
export interface OrchestrationHooks {
  spawnSubAgent?(config: Record<string, unknown>): Promise<{ id: string }>;
  sendToSubAgent?(id: string, task: unknown): Promise<unknown>;
  receiveFromSubAgent?(id: string): Promise<unknown>;
  terminateSubAgent?(id: string): Promise<void>;
  workflowCreate?(name: string, code: string): Promise<{ id: string }>;
  workflowRun?(name: string, params: Record<string, unknown>): Promise<unknown>;
  workflowSchedule?(name: string, cron: string): Promise<{ id: string }>;
  workflowStatus?(id: string): Promise<unknown>;
  /**
   * Assistant<->project-agent coordination lane (§A1.18 thread model). Unlike spawnSubAgent
   * (a throwaway, isolated child with no identity of its own), this dispatches to an EXISTING
   * named project agent definition, addressed the same way @mention dispatch does
   * (`{sessionId}:{agentId}`) so the two share the agent's normal per-thread memory/state — the
   * exchange lives in its own subthread (thread_kind='sub_agent', parent_thread_id), hidden by
   * default and expandable in the UI, never mixed into the visible user<->agent transcript.
   */
  consultAgent?(params: {
    agentId: string;
    message: string;
    spaceId: string;
    projectId?: string;
    parentThreadId?: string;
    threadId?: string;
  }): Promise<{
    ok: boolean;
    thread_id?: string;
    session_id?: string;
    reply?: string;
    error?: string;
  }>;
  /**
   * The other half of the §A1.18 thread model: post a message into an EXISTING, visible thread
   * (never a private sub_agent thread) and, unless `respond:false`, dispatch the named agent to
   * reply IN THAT SAME thread — what "chat with an ai inside the thread" looks like from the
   * assistant's side, as opposed to consultAgent's private, hidden coordination channel.
   */
  sendToThread?(params: {
    threadId: string;
    message: string;
    spaceId: string;
    agentId?: string;
    respond?: boolean;
    /** Run the replying agent on a specific model for this one dispatch. Omit to use that
     *  agent's own configured default. Valid ids come from sub-agent's agent.list_models. */
    model?: string;
  }): Promise<{
    ok: boolean;
    session_id?: string;
    reply?: string;
    dispatched: boolean;
    error?: string;
  }>;
}

/**
 * §A1.17 Phase J — dispatches a stored script tagged `metadata.runtime === "workflow"` to a
 * durable CF Workflow instance instead of running it synchronously in an isolate. The runner
 * re-resolves the script BY NAME inside the workflow step (the same path a trigger fire or
 * scheduled job already uses — see `fireScriptDirectly`/`agent-do/triggers/fire`), so it never
 * needs to carry code through workflow instance params and a script edited between schedule and
 * fire is picked up automatically, matching the skill library's own versioning semantics.
 */
export interface WorkflowRunner {
  start(params: {
    name: string;
    args: Record<string, unknown>;
    spaceId: string;
    agentId: string;
    tenantId: string;
    projectId?: string;
  }): Promise<{ id: string }>;
  status(
    id: string
  ): Promise<{ status: string; output?: unknown; error?: string }>;
}

// ── Memory OS (spec "Space Assistants — OpenClaw + CF Thinker + Memory OS", byte ~141822) ──
// Layer 3 (Structured Facts) + Layer 5 (Vector DB) of the 6-layer pipeline, implemented as
// NaelaoAgentDO SQLite + Vectorize and injected here the same way codeRunner/hitlGateway are.
// Layers 1 (Workspace/R2) and 2 (Sessions/FTS5) already exist (r2-workspace, messages_fts).

/** A single recalled memory, regardless of which layer it came from. */
export interface MemoryRecallResult {
  id: string;
  layer: "structured_fact" | "episodic" | "semantic";
  text: string;
  /** entity/relation/attribute when layer === "structured_fact". */
  entity?: string;
  relation?: string;
  attribute?: string;
  score: number;
  user_id?: string;
}

/** A Layer 4 (Fabric) entry — a cross-session consolidated summary (spec: Icarus framework). */
export interface FabricEntry {
  id: string;
  sessionId: string;
  summary: string;
  keyInsights: string[];
  /** Relevance to a recallFabric() query in [0,1]; 0 for briefFabric() (no query, just recency). */
  score: number;
  createdAt: number;
}

/** A Layer 6 (LLM Wiki) article — an auto-curated concept/entity definition. */
export interface WikiArticle {
  concept: string;
  definition: string;
  relationships: string[];
  updatedAt: number;
}

export interface MemoryStore {
  /**
   * Layer 3: remember a durable fact (entity/relation/attribute triple) OR Layer 5-bound
   * episodic note when entity/relation/attribute are omitted (free-text, scored by
   * `importance` for later promotion to semantic memory).
   */
  remember(entry: {
    userId?: string;
    text: string;
    entity?: string;
    relation?: string;
    attribute?: string;
    /** 0-1; gates promotion to the Vectorize semantic layer. Default 0.5. */
    importance?: number;
  }): Promise<{ id: string }>;
  /** Surgical recall (spec "Pre-Flight Check"): structured facts + episodic + semantic, merged. */
  recall(query: { userId?: string; text: string; limit?: number }): Promise<
    MemoryRecallResult[]
  >;
  forget(id: string): Promise<void>;

  /**
   * Layer 4 (Fabric) — cross-session context consolidator. Records a post-run summary + key
   * insights (spec: "Runs LLM-driven session extraction post-run"); the host calls this once
   * per completed run, not per message — see NaelaoAgentDO's handleScriptRun.
   */
  recordFabric(entry: {
    userId?: string;
    sessionId: string;
    summary: string;
    keyInsights?: string[];
  }): Promise<{ id: string }>;
  /** spec's `fabric_recall` tool — matched + score-filtered (>0.70 floor) against past summaries. */
  recallFabric(query: {
    userId?: string;
    text: string;
    limit?: number;
  }): Promise<FabricEntry[]>;
  /** spec's `fabric_brief` tool — the N most recent cross-session summaries, no query needed. */
  briefFabric(
    userId: string | undefined,
    limit?: number
  ): Promise<FabricEntry[]>;

  /**
   * Layer 6 (LLM Wiki) — auto-curated concept/entity vault (spec: `wiki-continuous-ingest`).
   * Upsert is keyed on (userId, concept): re-stating a concept refreshes its definition rather
   * than duplicating it, the same merge behavior as Layer 3 structured facts.
   */
  upsertWikiConcept(entry: {
    userId?: string;
    concept: string;
    definition: string;
    relationships?: string[];
  }): Promise<{ concept: string }>;
  lookupWikiConcept(
    userId: string | undefined,
    concept: string
  ): Promise<WikiArticle | null>;
  searchWiki(query: { userId?: string; text: string; limit?: number }): Promise<
    WikiArticle[]
  >;
}

/**
 * Generic named-lock primitive, exposed to scripts via the `lock` prebuilt. Deliberately
 * minimal (acquire/release/status) — Naelao does not ship a bespoke locking mechanism per
 * use case (e.g. "CSV row locking"); an assistant/agent composes its OWN concurrency
 * strategy out of this primitive (a script that acquires a lock keyed by row number before
 * writing, checks/aborts if not granted, releases after). Backed by ConcurrencyDO,
 * generalized beyond its original sub-agent-tree-gating use.
 */
export interface LockGateway {
  acquire(params: {
    key: string;
    holderId: string;
    limit?: number;
    ttlMs?: number;
  }): Promise<{
    granted: boolean;
    active: number;
    limit?: number;
    degraded?: boolean;
  }>;
  release(params: { key: string; holderId: string }): Promise<void>;
  status(key: string): Promise<{ active: number }>;
}

/**
 * §A1.25: lets a prebuilt op make its OWN direct LLM call rather than going through the
 * reasoner's decide() loop — needed for web-search's `grounded_answer` op, which wants
 * Anthropic's native web-search tool (proxied by CF AI Gateway, billed through the same Unified
 * Billing as every other LLM call — no separate provider key). Returns real token usage so the
 * caller (ScriptToolSurface.run's success branch) can fold it into ScriptRunResult and have it
 * billed exactly like reasoner-driven tokens are, instead of being a free, unmetered LLM call.
 */
export interface LlmCallerGateway {
  callWithNativeWebSearch(args: {
    model: string;
    query: string;
    maxUses?: number | undefined;
  }): Promise<{
    answer: string;
    citations: Array<{ title?: string | undefined; url?: string | undefined }>;
    tokens_used: number;
    input_tokens: number;
    output_tokens: number;
  }>;
  /**
   * A plain single-turn completion, for prebuilts that do their own small LLM work rather than
   * reasoning (today: project-journal compaction condensing old activity into an archive).
   * Optional — a caller without it degrades to that op's non-LLM fallback rather than failing,
   * matching how every other optional gateway in this file behaves.
   */
  complete?(args: {
    model: string;
    prompt: string;
    maxTokens?: number | undefined;
  }): Promise<{
    text: string;
    tokens_used: number;
    input_tokens: number;
    output_tokens: number;
  }>;
}

/**
 * Local-machine-as-container (spec "Local PC as a Container Target", gap G-3; §A1.17 Phase M).
 * Relays a grant-checked op (read_file/write_file/exec) to a builder's own machine over the
 * WebSocket tunnel LocalTunnelDO holds. `userId` addresses WHICH (space, user) tunnel to use —
 * the local-machine prebuilt resolves it from the matching grant's own user_id, never from a
 * caller-supplied field. Grant checking happens entirely in the prebuilt, before this gateway is
 * ever called; this interface has no opinion on what an op's params mean.
 */
export interface LocalTunnelGateway {
  exec(params: {
    userId: string;
    op: string;
    params: Record<string, unknown>;
  }): Promise<{ ok: boolean; result?: unknown; error?: string }>;
  status(userId: string): Promise<{ connected: boolean }>;
}

/**
 * §A1.17 Phase R: the container side of the explicit multi-workspace model — R2 (always
 * available, small/text files, durable across restarts) and the Tier-5 container's own local
 * disk (large/binary/stateful-capable, but only persists while that specific container instance
 * stays warm) are DIFFERENT filesystems an agent explicitly moves files between via the
 * `workspace` prebuilt's copy/move/list ops, rather than one being silently kept in sync with
 * the other on every call. This gateway is only the container half; the R2 half of a copy is an
 * ordinary R2 read/write in that same prebuilt (same bucket/prefix Tier 1's r2-workspace uses) —
 * there is no DO-side R2 logic left in ToolSandboxDO at all. Addressed the SAME way
 * code-runner.ts's runContainer addresses the DO for /exec (sandbox:{space}:{project|_assistant}),
 * so copy/list/exec all operate on the one container instance a project's threads share.
 */
export interface ContainerWorkspaceGateway {
  list(): Promise<{ files: string[] }>;
  read(paths?: string[]): Promise<{ files: Record<string, string> }>;
  write(files: Record<string, string>): Promise<{ ok: boolean }>;
  remove(paths: string[]): Promise<{ ok: boolean }>;
}

/**
 * HITL (Human-in-the-Loop) gateway interface (spec §10 / CLAUDE.md task #10).
 * Injected by NaelaoAgentDO when HITL_APPROVAL_DO is bound; absent in unit tests.
 */
export interface HITLGateway {
  /**
   * Pause execution and wait for a human to approve or reject the named action.
   *
   * Three outcomes, not two. `approved: false` means a human said no. `pending: true` means
   * nobody has answered YET and the request is still open — the run must suspend, not fail.
   * Collapsing those two into one boolean is what made "human in the loop" mean "the human has
   * a few seconds to answer or the action is refused": an owner who is asleep, at work, or
   * simply on another screen could never approve anything, and the agent reported their absence
   * as a refusal. An autonomous business that must ask before a payout or an ad spend cannot
   * work on that timescale.
   */
  requestApproval(params: {
    runId: string;
    sessionId: string;
    actionName: string;
    actionInput: Record<string, unknown>;
    description: string;
  }): Promise<{
    approvalId: string;
    approved: boolean;
    pending?: boolean;
    expiresAt?: number;
    reason?: string;
  }>;
}

/**
 * A record of actions that have actually been executed, so the same one is never executed twice.
 *
 * The gap this closes is replay. A run can be re-entered — a Workflow restart, or a resume after
 * someone approves a gated action hours later — and re-entering means the loop walks the task
 * again from the top. Handing the model its completed steps helps it not to repeat them, but
 * "the model should know better" is not a guarantee, and the cost of being wrong is a second
 * email, a second charge, a second payout.
 *
 * This is the ledger half of the durable-execution pattern (Palantir's Orchestrator names it
 * exactly that): an action is recorded when it runs, and a later attempt at the SAME action with
 * the SAME arguments under the SAME ledger key returns the recorded result instead of executing.
 * The ledger key is what ties an original run to its own resumes — a genuinely new run doing the
 * same work again is ordinary, and must not short-circuit.
 *
 * Optional: an unwired ledger degrades to today's behavior (the model's judgment plus the
 * within-run repeat guard), never to a blocked run.
 */
export interface ActionLedger {
  /** The recorded result of this exact action, if it has already run under this key. */
  lookup(
    key: string,
    actionName: string,
    paramsHash: string
  ): Promise<ScriptRunResult | null>;
  /** Record an action that just executed. Never throws — a ledger write failure must not fail a
   *  run that already succeeded (the cost is a possible repeat on replay, not a lost result). */
  record(
    key: string,
    actionName: string,
    paramsHash: string,
    result: ScriptRunResult
  ): Promise<void>;
}

/**
 * One committed step of the agent's own plan for THIS run — the Claude-Code-TodoWrite model, not
 * the durable per-project `tasks` DAG (which is for coordinating work ACROSS agents/runs and lives
 * in SpaceDO). A plan is run-scoped: it exists to keep a multi-step agent honest about finishing
 * what it said it would do before it stops. See the `plan` prebuilt and loop.ts's plan gate.
 */
export interface PlanStep {
  /** Stable id (an index-derived slug), so complete_step can name a specific step. */
  id: string;
  text: string;
  done: boolean;
}

/**
 * The live plan for the current run. A single mutable object shared by reference between the `plan`
 * prebuilt ops (which write it — plan.set/add_step/complete_step) and the loop (which reads it at
 * terminal-decision time to refuse a premature stop). Run-scoped: the loop creates it fresh per run
 * and reconstructs it from resumeSteps on a resume, so a plan set before an approval-suspend
 * survives the resume. Absent on env until the loop initializes it.
 */
export interface PlanState {
  steps: PlanStep[];
}

/** Everything the engine needs from the host (NaelaoAgentDO) to operate. */
export interface ScriptEngineEnv {
  /** R2 bucket holding the skill library (spaces/{spaceId}/scripts/...). */
  scriptsBucket: R2Bucket;
  /** R2 bucket for the agent's persistent workspace (spaces/{spaceId}/workspace/...).
   *  Defaults to scriptsBucket when not separately provisioned. */
  workspaceBucket?: R2Bucket;
  /** Vectorize index for script.find (optional — engine degrades to tag/text search). */
  vectorIndex?: VectorIndex;
  embedder?: Embedder;
  /** Runner for stored-code tiers (T2-T5). Optional — T1 always works without it. */
  codeRunner?: TieredCodeRunner;
  /** Dispatches `runtime:"workflow"` scripts to a durable CF Workflow. Optional — such scripts
   *  fail closed with an honest "unavailable" when absent, same precedent as codeRunner. */
  workflowRunner?: WorkflowRunner;
  /** Service bindings used by prebuilt scripts. */
  knowledgeWorker?: Fetcher;
  spacesWorker?: Fetcher;
  notificationsWorker?: Fetcher;
  /** The agents worker's own self-binding (AGENTS_WORKER). Lets a prebuilt reach an internal
   *  route on this same worker that holds a secret the isolate must never see — currently the
   *  business-email prebuilt calling /internal/business-email/{provision,send} for the AgentMail
   *  path (AGENTMAIL_API_KEY lives on the worker, not in the isolate env). */
  agentsWorker?: Fetcher;
  /** Billing worker — holds Lemon Squeezy creds + Naelao store; the only money-in path. */
  billingWorker?: Fetcher;
  /** MCP hub worker — registry + tool proxy for external-platform connectors (mcp-connector). */
  mcpHubWorker?: Fetcher;
  /** Credentials worker — the wallet prebuilt's check_bypass op reads a business's own
   *  credential list to detect a connected third-party payment provider. */
  credentialsWorker?: Fetcher;
  /** Artifact worker — agent-authored deliverables (rendered HTML, a report), space-scoped R2
   *  storage distinct from r2-workspace's own scratch files. The `artifacts` prebuilt degrades
   *  honestly when unbound. */
  artifactWorker?: Fetcher;
  /** Host-provided primitives for sub-agent / workflow prebuilt scripts. */
  orchestration?: OrchestrationHooks;
  /** HITL approval gateway — present when HITLApprovalDO is wired up. */
  hitlGateway?: HITLGateway;
  /** Exactly-once record of executed actions — present when the host provides one. See
   *  ActionLedger for why "the model can see it already ran" is not on its own a guarantee. */
  actionLedger?: ActionLedger;
  /**
   * The current run's plan (Claude-Code TodoWrite-style checklist) — a mutable object the loop
   * initializes at the start of every L3/L4 run and the `plan` prebuilt ops write to. Shared by
   * reference so the loop can enforce "don't stop with incomplete plan steps" against the SAME
   * state the model updated. Set by runScriptLoop, never by the host — a caller/test that never
   * runs the loop leaves it absent, and the plan ops degrade to a clear "no active run" message.
   */
  plan?: PlanState;
  /**
   * Called after a project workspace file is written or removed, so the host can fire a
   * `workspace.file_changed` event.
   *
   * This is what turns a file into a handoff between projects: the lead-generation agent records
   * a customer, that write fires the event, and a no-code rule wakes the agent that owns the next
   * stage. Passing the work as an event payload instead would leave the receiving agent with only
   * a message to remember — a file is state both sides can re-read, and it outlives the run that
   * produced it.
   *
   * Fire-and-forget by contract: the write has already succeeded by the time this is called, and
   * a listener failing must never turn it into a failure. Absent when the host wires no events.
   */
  onWorkspaceChange?: (change: {
    path: string;
    operation: "write" | "delete";
  }) => void;
  /** Runs the SAME Memory OS maintenance pass (decay/promote/prune) the client-driven
   *  POST .../sessions/:id/compact HTTP route triggers — as a tool the model itself can call mid-
   *  run (see the `memory` prebuilt's `memory.compact` op), not only from the shell UI. Present
   *  whenever the host DO wires it (always, in practice — see NaelaoAgentDO.buildScriptEngineEnv);
   *  the op degrades honestly rather than throwing when it isn't. */
  compactMemory?: () => Promise<unknown>;
  /** Generic named-lock primitive — present when CONCURRENCY_DO is wired up (the `lock`
   *  prebuilt reports itself degraded, not unavailable, when absent — see LockGateway). */
  lockGateway?: LockGateway;
  /** Local-machine-as-container (§A1.17 Phase M) — present when LOCAL_TUNNEL is wired up. The
   *  `local-machine` prebuilt reports itself unavailable, not degraded, when absent (unlike
   *  lockGateway, there's no safe fallback behavior for "pretend the local machine exists"). */
  localTunnel?: LocalTunnelGateway;
  /** §A1.17 Phase R — the container half of the explicit multi-workspace model. Present when
   *  TOOL_SANDBOX is wired up; the `workspace` prebuilt reports itself unavailable, not
   *  degraded, when absent (same posture as localTunnel — no safe fallback for "pretend the
   *  container exists"). */
  containerWorkspace?: ContainerWorkspaceGateway;
  /** Memory OS (structured facts + episodic + semantic recall) — present when the host DO
   *  has initialized its memory tables. Absent in environments that haven't wired it yet. */
  memoryStore?: MemoryStore;
  /** §A1.25 — present when the host DO can make its own direct LLM calls (native web search).
   *  Absent → web-search's grounded_answer op reports itself unavailable, same posture as every
   *  other optional gateway here. */
  llmCaller?: LlmCallerGateway;
  /** Identity for scoping R2 keys + Vectorize filters. */
  spaceId: string;
  agentId: string;
  tenantId: string;
  /** For minting the internal HMAC token any direct (non-router) service-binding call to
   *  another worker (spacesWorker, knowledgeWorker, ...) needs — see mintInternalToken,
   *  @naelao/http. Optional so environments that never make such a call (most script tests)
   *  don't need to supply it. */
  platformSecret?: string;
  /** Signed grant and immutable human subject for destructive operations. */
  mutationGrant?: string;
  humanInvokerId?: string;
  /** Atomically consumes a verified single-use destructive grant in durable state. */
  consumeMutationGrant?: () => Promise<boolean>;
  /** The end-user this run is on behalf of (set per /script/run call). Scopes the user model
   *  (Memory OS) and per-(channel,user) sessions. Absent for space-level/system-triggered runs. */
  userId?: string;
  /**
   * §A1 connector default-vs-personal switch: this session's chosen mode per connector id
   * ("business" — the default, use the shared account; "personal" — require the caller's own
   * connected account, refuse rather than silently fall back). Read once by NaelaoAgentDO at run
   * start (best-effort GET to SpaceDO's connector-mode store) and forwarded by the mcp-connector
   * prebuilt as `x-naelao-connector-scope` on each mcp-hub call for the referenced server. Absent
   * entries (the common case — most connectors never had a user switch away from business) mean
   * "resolve exactly as before this feature existed."
   */
  connectorAccountMode?: Record<string, "business" | "personal">;
  /**
   * The project this run is bound to, when it's an ordinary (project-scoped) Naelao Agent
   * thread rather than the Space Assistant. Determines the R2 workspace prefix (see
   * `workspacePrefix()` below) — every thread's agent in the SAME project shares one
   * filesystem (e.g. a project-wide ledger.csv), while the Space Assistant's workspace stays
   * space-wide. Absent = space-scoped (the Space Assistant, or a legacy unscoped run).
   */
  projectId?: string;
  /**
   * Execution ladder ceiling (1-5) for this run — set on customer-facing bot projects
   * (SpaceDO `projects.execution_ceiling`) so a restricted bot can never use a tier above
   * what the admin configured (e.g. ceiling=2 means "talk and look things up, never touch a
   * container or browser"). Absent = unrestricted (the normal builder-workspace default).
   * Enforced structurally in ScriptToolSurface — not a prompt instruction.
   */
  maxTier?: ExecutionTier;
  /**
   * F-36 — the assistant's clamped effective role when this run acts ON BEHALF OF a specific
   * user in a project (resolved from SpaceDO's `/projects/:id/assistant-access`, the min of
   * that user's own project_members role and the row's assistant_mode). `"viewer"` makes the
   * run read-only: ScriptToolSurface structurally refuses script.create/update/delete,
   * stored-script execution, and any prebuilt op not on the read-safe allowlist (see
   * assistant-access.ts). Absent = unclamped — a system/autonomous run with no acting user,
   * or an acting user whose effective role is editor/owner. A `null` effective role
   * (assistant_mode='none', or a plain non-member) never reaches this env: the run is refused
   * before the engine is invoked. Enforced structurally (the maxTier precedent), not a prompt
   * instruction.
   */
  effectiveRole?: "owner" | "editor" | "viewer";
  /**
   * Progressive tool disclosure (Phase 2 item 13) — when true, `available_operations` in the
   * reasoner payload is REDUCED to a small always-visible core set plus `tools.search`/
   * `tools.describe` for discovering the rest, instead of the full grouped dump every turn.
   * Execution itself is UNCHANGED either way — script.run still accepts any enabled operation
   * regardless of whether it was shown, so this can only ever shrink the payload, never block a
   * valid call. Default false (absent) = today's full-disclosure behavior, byte-identical.
   * Deliberately NOT default-on anywhere yet: this session's own history (items 133-139) is a
   * record of how fragile this exact reasoning-loop surface is on the platform's small models,
   * so this ships opt-in per space/run until proven live on a real business. See
   * ScriptToolSurface.disclosureGroups' own doc for the automatic full-disclosure fallback.
   */
  progressiveToolDisclosure?: boolean;
}

/**
 * The single place that decides whether a run's R2 workspace is space-scoped or
 * project-scoped — every workspace-touching prebuilt (r2-workspace, file-manager,
 * observe_filesystem) and any future one must call this rather than re-deriving the prefix,
 * so the space/project boundary is enforced in exactly one place.
 *
 * Space-scoped (`env.projectId` absent) = the Space Assistant, or a legacy unscoped run.
 * Project-scoped (`env.projectId` set) = an ordinary Naelao Agent thread — every thread's
 * agent within the SAME project reads/writes the SAME filesystem (spec: a project is
 * workspace-scoped; threads within it share one R2 workspace).
 */
export function workspacePrefix(
  env: Pick<ScriptEngineEnv, "spaceId" | "projectId">
): string {
  return env.projectId
    ? `spaces/${env.spaceId}/projects/${env.projectId}/workspace/`
    : `spaces/${env.spaceId}/workspace/`;
}
