{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 5000000
  },
  "output": {
    "filePath": ".repomix-cache/batch-10-workflows-webhooks-scheduling.xml",
    "style": "xml",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "topFilesLength": 40,
    "instructionFilePath": ".repomix-cache/authority-batch-10.md"
  },
  "include": [
    "package.json",
    "pnpm-workspace.yaml",
    "turbo.json",
    "vitest.workspace.ts",
    "biome.json",
    "tsconfig*.json",
    ".github/workflows/**",
    "infra/migrations/**",
    "infra/terraform/**",
    "docs/requirements-trace-matrix.md",
    "docs/DEPLOYMENT_SECRETS.md",
    "docs/DEPLOY_SECRETS.md",
    "docs/staging-smoke-test.md",
    "packages/types/**",
    "packages/config/**",
    "packages/db/**",
    "packages/http/**",
    "packages/auth/**",
    "packages/crypto/**",
    "packages/security/**",
    "packages/testing/**",
    "packages/tracing/**",
    "packages/events/**",
    "workers/router/**",
    "workers/workflows/**",
    "workers/triggers/**",
    "workers/channels/**",
    "workers/mcp-hub/**",
    "workers/notifications/**",
    "packages/agent-sdk/**",
    "packages/tool-runtime/**",
    "packages/idempotency/**",
    "packages/webhooks/**",
    "tests/**/*sub-agent*",
    "tests/**/*workflow*",
    "tests/**/*webhook*",
    "tests/**/*queue*",
    "tests/**/*scheduled*",
    "tests/**/*cron*",
    "tests/**/*idempot*",
    "tests/**/*calendar*",
    "workers/agents/src/index.ts",
    "workers/agents/src/workflows/**",
    "workers/agents/src/launchpad/channels.ts",
    "workers/agents/src/script-engine/prebuilt/**",
    "workers/agents/src/script-engine/types.ts",
    "workers/agents/src/env.ts",
    "workers/agents/wrangler.toml",
    "workers/spaces/src/index.ts",
    "workers/spaces/src/do/SpaceDO.ts",
    "workers/spaces/wrangler.toml",
    "workers/sweeper/**",
    "workers/agents/src/do/ConcurrencyDO.ts",
    "workers/agents/src/connectors/**",
    "packages/billing-core/**",
    "apps/shell/src/app/p/[slug]/(shell)/workflows/**",
    "apps/shell/src/components/AssistantDelegationCard.tsx"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.next/**",
      "**/.wrangler/**",
      "**/dist/**",
      "**/coverage/**",
      "**/*.tsbuildinfo",
      "**/*.map",
      "**/.env*",
      "**/.dev.vars*",
      "**/*.local",
      "pnpm-lock.yaml",
      "naelao_expanded_gaps_resolved.html",
      "naelao_whop_businesses_spec.html",
      "_BUILD_PLAN/**",
      ".repomix-cache/**",
      "repomix-output*",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.woff",
      "**/*.woff2",
      "**/*.pdf"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
