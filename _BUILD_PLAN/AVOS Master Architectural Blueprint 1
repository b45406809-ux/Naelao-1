if (s.actionType \u003d\u003d\u003d \"NAVIGATE\") return `await ctx.browser.scrape(\"${s.target}\");`;\n    if (s.actionType \u003d\u003d\u003d \"CLICK\") return `await ctx.run(\"browser.click\", { selector: \"${s.target}\" });`;\n    if (s.actionType \u003d\u003d\u003d \"TYPE\") return `await ctx.run(\"browser.type\", { selector: \"${s.target}\", text: ${s.valueExpression} });`;\n    if (s.actionType \u003d\u003d\u003d \"BASH\") return `await ctx.cli.exec(${s.valueExpression});`;\n    return `// ${s.description}`;\n  }).join(\"\\n  \")}\n\n  return { ok: true, message: \"Successfully executed learned skill: ${skillName}\" };\n}\n`;\n\n  // 4. Save to project shared skills directory\n  await ctx.env.fs.write(`/.avos/shared/skills/${skillName}.ts`, synthesizedCode);\n\n  return {\n    ok: true,\n    skillName,\n    parameters: actionSequence.parameters,\n    message: `✔ Successfully learned skill \u0027${skillName}\u0027 from video demonstration.`\n  };\n}\n```\n\nVerify that all durable workflows execute via the harness pattern without leaking Cloudflare deployment complexity to the agent, and confirm that learned skills commit directly to `/.avos/shared/skills/`.\n```\n\n---\n\n# PROMPT 11: Unified Filesystem Synchronization \u0026 Script-Native CodeAct Execution\n*(Derived from `215 - 219 With.txt`, reconciled with the Minimalist 3-Tool Surface and Invisible Hypervisor)*\n\n```markdown\n# SYSTEM ARCHITECTURE PROMPT: UNIFIED FILESYSTEM SYNC \u0026 SCRIPT-NATIVE CODEACT\n\nYou are architecting the authoritative virtual filesystem synchronization engine and the script-native CodeAct execution pipeline across all 6 tiers of the AVOS ladder.\n\nEliminate the static JSON tool bloat of traditional agents. Implement an authoritative, single-source-of-truth virtual filesystem in Durable Object SQLite that synchronizes across V8 Isolates, Workflows, Headless Browsers, and Linux Containers without split-brain anomalies, while exposing a minimalist 3-tool surface to the model