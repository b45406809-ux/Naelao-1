{
  "name": "naelao-artifact",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    { "binding": "NAELAO_ARTIFACTS", "bucket_name": "naelao-artifacts" }
  ],
  "dispatch_namespaces": [
    { "binding": "NAELAO_DISPATCH_NS", "namespace": "naelao-workers" }
  ],
  "kv_namespaces": [
    { "binding": "NAELAO_ARTIFACT_KV", "id": "$NAELAO_ARTIFACT_KV_ID" },
    { "binding": "NAELAO_CONFIG_KV", "id": "$NAELAO_CONFIG_KV_ID" },
    { "binding": "NAELAO_CIRCUIT_KV", "id": "$NAELAO_CIRCUIT_KV_ID" }
  ]
}
