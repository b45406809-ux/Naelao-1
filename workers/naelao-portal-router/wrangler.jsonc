{
  "name": "naelao-portal-router",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "*.naelao.app/*" },
    { "pattern": "naelao.app/*" }
  ],
  "services": [
    { "binding": "NAELAO_SPACES", "service": "naelao-spaces" }
  ],
  "kv_namespaces": [
    { "binding": "NAELAO_PORTAL_ROUTES", "id": "$NAELAO_PORTAL_ROUTES_KV_ID" },
    { "binding": "NAELAO_CONFIG_KV", "id": "$NAELAO_CONFIG_KV_ID" },
    { "binding": "NAELAO_CIRCUIT_KV", "id": "$NAELAO_CIRCUIT_KV_ID" }
  ],
  "analytics_engine_datasets": [
    { "binding": "NAELAO_ANALYTICS", "dataset": "naelao_events" }
  ]
}
