{
  "name": "naelao-workflows",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    { "binding": "NAELAO_WORKFLOW_R2", "bucket_name": "naelao-workflows" }
  ],
  "dispatch_namespaces": [
    { "binding": "DISPATCH_NAMESPACE", "namespace": "naelao-workers" }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "naelao-workflow-dispatch",
        "max_batch_size": 10,
        "max_retries": 3
      }
    ]
  },
  "kv_namespaces": [
    { "binding": "NAELAO_CONFIG_KV", "id": "$NAELAO_CONFIG_KV_ID" },
    { "binding": "NAELAO_CIRCUIT_KV", "id": "$NAELAO_CIRCUIT_KV_ID" }
  ],
  "analytics_engine_datasets": [
    { "binding": "NAELAO_ANALYTICS", "dataset": "naelao_events" }
  ]
}
