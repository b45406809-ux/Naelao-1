{
  "name": "naelao-together-ai",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    { "binding": "NAELAO_SPACE_DO", "service": "naelao-spaces" },
    { "binding": "NAELAO_WALLET_DO", "service": "naelao-spaces" }
  ],
  "queues": {
    "producers": [
      { "binding": "NAELAO_ANALYTICS_QUEUE", "queue": "naelao-analytics-queue" }
    ]
  },
  "kv_namespaces": [
    { "binding": "NAELAO_CONFIG_KV", "id": "$NAELAO_CONFIG_KV_ID" },
    { "binding": "NAELAO_CIRCUIT_KV", "id": "$NAELAO_CIRCUIT_KV_ID" }
  ],
  "analytics_engine_datasets": [
    { "binding": "NAELAO_ANALYTICS", "dataset": "naelao_events" }
  ]
}
