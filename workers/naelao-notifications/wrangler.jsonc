{
  "name": "naelao-notifications",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    { "binding": "NAELAO_SPACE_DO", "service": "naelao-spaces" }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "naelao-notifications",
        "max_batch_size": 50,
        "max_retries": 3,
        "dead_letter_queue": "naelao-notifications-dlq"
      }
    ]
  },
  "kv_namespaces": [
    { "binding": "NAELAO_CONFIG_KV", "id": "$NAELAO_CONFIG_KV_ID" },
    { "binding": "NAELAO_CIRCUIT_KV", "id": "$NAELAO_CIRCUIT_KV_ID" }
  ]
}
