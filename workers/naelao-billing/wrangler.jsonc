{
  "name": "naelao-billing",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    { "binding": "NAELAO_SPACE_DO", "service": "naelao-spaces" },
    { "binding": "NAELAO_WALLET_DO", "service": "naelao-spaces" }
  ],
  "queues": {
    "producers": [
      { "binding": "NAELAO_NOTIFICATIONS_QUEUE", "queue": "naelao-notifications" }
    ],
    "consumers": [
      {
        "queue": "naelao-billing-events",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "naelao-billing-dlq"
      }
    ]
  },
  "kv_namespaces": [
    { "binding": "NAELAO_CONFIG_KV", "id": "$NAELAO_CONFIG_KV_ID" },
    { "binding": "NAELAO_CIRCUIT_KV", "id": "$NAELAO_CIRCUIT_KV_ID" }
  ]
}
