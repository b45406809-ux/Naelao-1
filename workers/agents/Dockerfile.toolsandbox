# Tier-5 build/test container for the Whop micro-tool. Node for the build/test
# harness; Python available for tools/scripts that need it. Spun up on demand by
# ToolSandboxDO and slept when idle.
FROM node:22-slim

# Python for tools/scripts that need a Python runtime.
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip util-linux \
      xvfb fluxbox xdotool imagemagick x11vnc websockify \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Harness deps (esbuild for build/transpile gate).
RUN npm install esbuild@0.24.0

COPY container/server.mjs /app/server.mjs
COPY container/child-runner.mjs /app/child-runner.mjs
COPY container/compile-runner.mjs /app/compile-runner.mjs
COPY container/process-supervisor.mjs /app/process-supervisor.mjs
COPY container/binary-bridge.mjs /app/binary-bridge.mjs
COPY container/artifact-fs.mjs /app/artifact-fs.mjs
COPY container/start.sh /app/start.sh

# §A1.17 Phase K: per-project workspace the harness materializes from R2 before each /exec and
# collects back into afterward — the container's own approximation of an R2-mounted filesystem.
RUN groupadd -g 10001 runtime && useradd -u 10001 -g 10001 -d /home/runtime -s /bin/bash runtime \
    && mkdir -p /workspace /home/runtime /tmp/guest /tmp/naelao-control \
    && chown -R 10001:10001 /workspace /home/runtime /tmp/guest \
    && chmod 700 /tmp/naelao-control \
    && chmod -R go-w /app \
    && find / -xdev -type f -perm /6000 -exec chmod a-s {} +

# Trusted supervisor only. process-supervisor.mjs runs every guest as UID/GID 10001,
# with no-new-privileges and empty Linux capability sets. Provider-native read-only rootfs
# is not claimed: OS and harness paths are root-owned and not writable by this UID.
USER root

EXPOSE 8080 8081 6080
CMD ["/app/start.sh"]
