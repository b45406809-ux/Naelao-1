# Tier-5 build/test container for the Whop micro-tool. Node for the build/test
# harness; Python available for tools/scripts that need it. Spun up on demand by
# ToolSandboxDO and slept when idle.
FROM node:22-slim

# Python for tools/scripts that need a Python runtime.
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
      xvfb fluxbox xdotool imagemagick x11vnc websockify \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Harness deps (esbuild for build/transpile gate).
RUN npm install esbuild@0.24.0

COPY container/server.mjs /app/server.mjs
COPY container/binary-bridge.mjs /app/binary-bridge.mjs
COPY container/artifact-fs.mjs /app/artifact-fs.mjs
COPY container/start.sh /app/start.sh

# §A1.17 Phase K: per-project workspace the harness materializes from R2 before each /exec and
# collects back into afterward — the container's own approximation of an R2-mounted filesystem.
RUN mkdir -p /workspace

EXPOSE 8080 8081 6080
CMD ["/app/start.sh"]
