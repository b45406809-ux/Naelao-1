# Tier-5 build/test container for the Whop micro-tool. Node for the build/test
# harness; Python available for tools/scripts that need it. Spun up on demand by
# ToolSandboxDO and slept when idle.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install Node.js, Python, build tools, Xvfb, Fluxbox, VNC, and input simulation (xdotool)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    python3 \
    python3-pip \
    build-essential \
    xvfb \
    fluxbox \
    x11vnc \
    novnc \
    websockify \
    xdotool \
    scrot \
    libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Harness deps (esbuild for build/transpile gate).
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && npm install esbuild@0.24.0 \
    && rm -rf /var/lib/apt/lists/*

COPY container/server.mjs /app/server.mjs

# §A1.17 Phase K: per-project workspace the harness materializes from R2 before each /exec and
# collects back into afterward — the container's own approximation of an R2-mounted filesystem.
RUN mkdir -p /workspace

EXPOSE 8080
EXPOSE 8081

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
