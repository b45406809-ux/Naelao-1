FROM node:22-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils=22.12.0-2+deb12u3 libreoffice-core libreoffice-writer libreoffice-calc libreoffice-impress util-linux fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY container/.vendor/node_modules /app/node_modules
COPY container/server.mjs container/process-supervisor.mjs container/child-runner.mjs container/compile-runner.mjs container/artifact-fs.mjs /app/
RUN groupadd -g 10001 runtime && useradd -u 10001 -g 10001 -d /home/runtime runtime \
    && mkdir -p /workspace /home/runtime /tmp/guest /tmp/naelao-control \
    && chown -R 10001:10001 /workspace /home/runtime /tmp/guest \
    && chmod 700 /tmp/naelao-control && chmod -R a+rX /app && chmod -R go-w /app \
    && find / -xdev -type f -perm /6000 -exec chmod a-s {} +
USER root
EXPOSE 8080
CMD ["node", "/app/server.mjs"]
