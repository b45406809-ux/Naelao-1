+// Cloudflare workerd intentionally has no browser Worker global. Consumers that only need
+// the decoder's synchronous WASM implementation still import this base class indirectly;
+// defer the unsupported-runtime failure until a caller actually tries to construct a Worker.
+module.exports = typeof Worker !== 'undefined'
+  ? Worker
+  : class UnsupportedWebWorker {
+      constructor() {
+        throw new Error('Web Workers are not available in this runtime');
