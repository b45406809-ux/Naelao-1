# Wrangler-compatible env file fragment
output "wrangler_env_fragment" {
  description = "Paste this into wrangler.toml [[env.production]] sections"
  sensitive   = false
  value       = <<-EOT
    # Generated by Terraform — do not edit manually
    # Paste into wrangler.toml bindings for each worker

    # D1
    [[d1_databases]]
    binding = "PLATFORM_DB"
    database_name = "${cloudflare_d1_database.platform.name}"
    database_id = "${cloudflare_d1_database.platform.id}"

    # KV
    [[kv_namespaces]]
    binding = "CONFIG_KV"
    id = "${cloudflare_workers_kv_namespace.config.id}"

    [[kv_namespaces]]
    binding = "SESSIONS_KV"
    id = "${cloudflare_workers_kv_namespace.sessions.id}"

    [[kv_namespaces]]
    binding = "RATE_LIMIT_KV"
    id = "${cloudflare_workers_kv_namespace.rate_limits.id}"

    [[kv_namespaces]]
    binding = "CIRCUIT_BREAKER_KV"
    id = "${cloudflare_workers_kv_namespace.circuit_breakers.id}"

    # R2
    [[r2_buckets]]
    binding = "KB_BUCKET"
    bucket_name = "${cloudflare_r2_bucket.kb_documents.name}"

    [[r2_buckets]]
    binding = "ARTIFACTS_BUCKET"
    bucket_name = "${cloudflare_r2_bucket.artifacts.name}"

    [[r2_buckets]]
    binding = "EXPORTS_BUCKET"
    bucket_name = "${cloudflare_r2_bucket.exports.name}"

    # Queues
    [[queues.producers]]
    binding = "EVENTS_QUEUE"
    queue = "${cloudflare_queue.events.name}"

    [[queues.producers]]
    binding = "WEBHOOKS_QUEUE"
    queue = "${cloudflare_queue.webhooks.name}"

    [[queues.producers]]
    binding = "ANALYTICS_QUEUE"
    queue = "${cloudflare_queue.analytics.name}"

    # Vectorize
    [[vectorize]]
    binding = "KB_INDEX"
    index_name = "${cloudflare_vectorize_index.kb.name}"

    [[vectorize]]
    binding = "MARKETPLACE_INDEX"
    index_name = "${cloudflare_vectorize_index.marketplace.name}"
  EOT
}
