  document.querySelectorAll('.modal-tab').forEach((t,i)=>t.classList.toggle('active',i===0));
}
function closeModal(){document.getElementById('modal-overlay').classList.remove('open');}
function handleOverlayClick(e){if(e.target===document.getElementById('modal-overlay'))closeModal();}
function switchTab(btn,tabId){document.querySelectorAll('.modal-tab').forEach(t=>t.classList.remove('active'));btn.classList.add('active');switchTabById(tabId);}
function switchTabById(id){['theme-tab','bg-tab','chat-tab'].forEach(t=>{const el=document.getElementById(t);if(el)el.style.display=t===id?'block':'none';});}
function toggleBgSetting(){pendingBgEnabled=!pendingBgEnabled;document.getElementById('bg-toggle')?.classList.toggle('on',pendingBgEnabled);document.getElementById('bg-toggle2')?.classList.toggle('on',pendingBgEnabled);}
function selectBg(id,el){pendingBg=id;pendingBgEnabled=true;document.querySelectorAll('.bg-thumb').forEach(t=>t.classList.remove('selected'));el.classList.add('selected');document.getElementById('bg-toggle')?.classList.add('on');document.getElementById('bg-toggle2')?.classList.add('on');const p=document.getElementById('bg-preview-box');p.className='bg-preview bg-'+id;p.innerHTML='';}
function generateBg(){const bgs=['landscape-1','landscape-2','landscape-3','landscape-4','abstract-1','abstract-2','abstract-3','abstract-4'];const pick=bgs[Math.floor(Math.random()*bgs.length)];const el=document.querySelector(`.bg-thumb[onclick*="${pick}"]`);if(el)selectBg(pick,el);showToast('Background generated!');}
function setChatColor(el,bg,fg){document.querySelectorAll('.color-dot').forEach(d=>d.classList.remove('selected'));el.classList.add('selected');document.documentElement.style.setProperty('--user-bubble',bg);document.documentElement.style.setProperty('--user-text',fg);}
function setFontSize(btn,size){btn.parentElement.querySelectorAll('button').forEach(b=>{b.style.background='var(--surface2)';b.style.borderColor='var(--border)';b.style.color='var(--text2)';});btn.style.background='var(--accent-dim)';btn.style.borderColor='var(--accent)';btn.style.color='var(--accent)';document.querySelectorAll('.bubble').forEach(b=>b.style.fontSize=size+'px');}
function saveAppearance(){currentTheme=pendingTheme;bgEnabled=pendingBgEnabled;currentBg=pendingBg;const effective=currentTheme==='system'?(window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light'):currentTheme;applyTheme(effective);applyBackground();closeModal();showToast('Appearance saved');}
function applyBackground(){const canvas=document.getElementById('bg-canvas');if(!bgEnabled){canvas.classList.remove('visible');return;}const isDark=document.documentElement.dataset.theme==='dark';const ctx=canvas.getContext('2d');canvas.width=window.innerWidth;canvas.height=window.innerHeight;const bgMap={'landscape-1':['#b8d4e8','#d4e8f5','#8ab0c8','#5a7a8a'],'landscape-2':['#d4845a','#c8a054','#8a6830','#4a3010'],'landscape-3':['#b8d8e8','#d8ecf5','#a0c8e0','#6090b0'],'landscape-4':['#1a2a3a','#2a3a5a','#4a2a3a','#c87850'],'abstract-1':['#2a4a8a','#3a3aba','#5a30c8','#3020a0'],'abstract-2':['#c85020','#d86030','#e8a030','#d08020'],'abstract-3':['#8030c8','#a030b8','#c030a0','#a02080'],'abstract-4':['#105040','#186050','#208060','#108050']};const cols=bgMap[currentBg]||bgMap['landscape-4'];const grad=ctx.createLinearGradient(0,0,canvas.width*0.4,canvas.height);grad.addColorStop(0,cols[0]);grad.addColorStop(0.35,cols[1]);grad.addColorStop(0.65,cols[2]);grad.addColorStop(1,cols[3]);ctx.fillStyle=grad;ctx.fillRect(0,0,canvas.width,canvas.height);if(isDark){ctx.fillStyle='rgba(0,0,0,0.3)';ctx.fillRect(0,0,canvas.width,canvas.height);}canvas.classList.add('visible');}

// ── SIDEBAR ──
