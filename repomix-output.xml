/**
 * schedule (step 12) — lets an agent wake ITSELF later with a follow-up goal, and list/cancel its
 * scheduled wakes. This is the "cron tool to set a trigger that wakes it after ~X" primitive from
 * the ask: the pattern is "kick off a long/background job (a sub-agent, a workflow, an external
 * task), do whatever else there is, and if there's nothing left to do but wait, schedule a wake to
 * come back and check on it" — the way Claude Code checks back on a background task.
 *
 * Implemented on the EXISTING goal-based scheduled_jobs dispatcher (migration 0043), NOT a second
 * scheduler: a due wake calls wakeAgentGoal against this same agent's own DO with the follow-up
 * goal, exactly as the seeded revenue-review cron does. A delay-based wake is one-shot — it fires
 * once (params._one_shot, which the dispatcher disables after firing) rather than recurring. A
 * `cron`-based wake is a real recurring schedule.
 *
 * Granularity: the platform sweeps scheduled jobs on an HOURLY heartbeat, so a wake scheduled
 * sooner than the next heartbeat fires on that next heartbeat (the dispatcher's isCronDue scans
 * the window since last_run_at, so it still fires — just no finer than ~hourly). wake_me says this.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";

async function spacesCall(
  ctx: PrebuiltOpContext,
  method: string,
  path: string,
  body?: Record<string, unknown>
): Promise<{ ok: boolean; status: number; json: unknown }> {
  if (!ctx.env.spacesWorker) throw new Error("schedule unavailable: spaces worker binding not configured");
  const token = await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId);
  const resp = await ctx.env.spacesWorker.fetch(
    new Request(`http://spaces-worker${path}`, {
      method,
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": token,
        ...(ctx.env.userId ? { "x-naelao-user-id": ctx.env.userId } : {}),
      },
      ...(body ? { body: JSON.stringify(body) } : {}),
    })
  );
  const json = await resp.json().catch(() => ({}));
  return { ok: resp.ok, status: resp.status, json };
}

function numArg(a: Record<string, unknown>, name: string): number | undefined {
  const v = a[name];
  if (typeof v === "number" && Number.isFinite(v)) return v;
  if (typeof v === "string" && v.trim() !== "" && Number.isFinite(Number(v))) return Number(v);
  return undefined;
}

/** A one-shot cron for a specific UTC minute ~delayMinutes from now: minute/hour/day-of-month/
 *  month pinned (fires at that date+time), day-of-week wildcard. Combined with params._one_shot,
 *  the dispatcher disables it after the first fire so it never recurs. */
export function cronForDelay(delayMinutes: number, now: Date = new Date()): string {
  const target = new Date(now.getTime() + Math.max(0, delayMinutes) * 60_000);
  return `${target.getUTCMinutes()} ${target.getUTCHours()} ${target.getUTCDate()} ${target.getUTCMonth() + 1} *`;
}

export const schedule: PrebuiltScript = {
  name: "schedule",
  description:
    "Wake yourself later with a follow-up goal (a cron trigger you set), and list or cancel your " +
    "scheduled wakes. Use this to check back on a long/background task (a sub-agent, a workflow, " +
    "an external job) after doing everything else: schedule a wake for roughly when you expect it " +
    "to be ready, then end this run; the wake re-runs you with the follow-up goal so you can check.",
  domain: "orchestration",
  requires_tier: 1,
  paramHints: {
    "schedule.wake_me":
      "goal (string, REQUIRED — the follow-up instruction to run when you wake, e.g. \"check " +
      "whether the research sub-agent finished and summarize it\"). ONE of: delay_minutes " +
      "(number) / delay_hours (number) for a one-shot wake, OR cron (5-field string) for a " +
      "recurring schedule. name (string, optional). Note: wakes fire on the platform's hourly " +
      "heartbeat, so anything sooner than ~1 hour fires on the next heartbeat.",
    "schedule.list": "no parameters. Lists your scheduled wakes/jobs in this project (or space-wide).",
    "schedule.cancel": "id (string, REQUIRED — a job id from schedule.list).",
  },
  operations: {
    "schedule.wake_me": async (a, c) => {
      const goal = String(a["goal"] ?? "").trim();
      if (!goal) throw new Error("schedule.wake_me requires a goal (what to do when you wake)");
      const explicitCron = typeof a["cron"] === "string" ? (a["cron"] as string).trim() : "";
      const delayMinutes = numArg(a, "delay_minutes");
      const delayHours = numArg(a, "delay_hours");
      let cron: string;
      let oneShot = false;
      if (explicitCron) {
        cron = explicitCron;
      } else if (delayHours !== undefined || delayMinutes !== undefined) {
        const mins = (delayHours ?? 0) * 60 + (delayMinutes ?? 0);
        if (mins <= 0) throw new Error("delay must be positive");
        cron = cronForDelay(mins);
        oneShot = true;
      } else {
        throw new Error("schedule.wake_me requires either delay_minutes/delay_hours or a cron expression");
      }
      const name = typeof a["name"] === "string" && a["name"] ? (a["name"] as string) : `wake: ${goal.slice(0, 40)}`;
      const res = await spacesCall(c, "POST", `/spaces/${c.env.spaceId}/scheduled-jobs`, {
        name,
        cron_expression: cron,
        goal,
        agent_id: c.env.agentId,
        ...(c.env.projectId ? { project_id: c.env.projectId } : {}),
        ...(oneShot ? { params: { _one_shot: true } } : {}),
      });
      if (!res.ok) return { ok: false, error: `failed to schedule wake: HTTP ${res.status}` };
      const created = res.json as { id?: string };
      return {
        ok: true,
        id: created.id ?? null,
        cron_expression: cron,
        one_shot: oneShot,
        note: oneShot
          ? "Scheduled a one-shot wake. It fires on the next hourly heartbeat at or after the target time, then disables itself."
          : "Scheduled a recurring wake. Use schedule.cancel with the id when it's no longer needed.",
      };
    },
    "schedule.list": async (_a, c) => {
      const qs = c.env.projectId ? `?project_id=${encodeURIComponent(c.env.projectId)}` : "";
      const res = await spacesCall(c, "GET", `/spaces/${c.env.spaceId}/scheduled-jobs${qs}`);
      if (!res.ok) return { ok: false, error: `failed to list wakes: HTTP ${res.status}` };
      return res.json;
    },
    "schedule.cancel": async (a, c) => {
      const id = String(a["id"] ?? "").trim();
      if (!id) throw new Error("schedule.cancel requires an id");
      const res = await spacesCall(c, "DELETE", `/spaces/${c.env.spaceId}/scheduled-jobs/${encodeURIComponent(id)}`);
      if (!res.ok) return { ok: false, error: `failed to cancel wake ${id}: HTTP ${res.status}` };
      return { ok: true, cancelled: id };
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/skill-manager.ts">
/**
 * skill-manager — the agent's own view of, and control over, the skills it has learned.
 *
 * The engine already records outcomes, derives a health verdict (skill-health.ts), demotes a
 * failing skill in `script.find`, and refuses to auto-run one at L1. That is the automatic half
 * of the loop, and it is enough to stop a broken skill being picked. It is NOT enough to get the
 * skill fixed: nothing decides to repair a skill that isn't currently being reached for, nothing
 * removes one that will never work again, and nothing shares one that has genuinely proven out.
 *
 * Those are judgment calls, which on this platform means they belong to the agent rather than to
 * a hardcoded sweep. So this is a real tool surface over the library:
 *
 *   skill.health    — what has been going wrong, what's proven, what's worth sharing
 *   skill.inspect   — one skill in full: version, health, patch history, recent errors
 *   skill.rollback  — undo a patch that made things worse
 *   skill.retire    — delete a skill that is beyond repair (and stop it being found)
 *   skill.promote   — publish a proven skill to the shared template library
 *
 * Read ops are safe and are auto-approved in guided mode. The three that change the library are
 * gated like any other mutation — retiring a skill another project depends on is exactly the kind
 * of thing an owner should get to see first.
 *
 * Promotion deliberately does NOT happen here: it needs the space's template id, which is a D1
 * lookup this DO has no binding for. `skill.promote` calls the agents worker's already-existing
 * `/skills/promote` route, which owns that lookup and the promotion threshold — one gate, not two
 * that can drift.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import type { ScriptMetadata } from "../types.js";
import { SkillLibrary } from "../skill-library.js";
import { assessSkillHealth } from "../skill-health.js";
import { isPromotable } from "../federation.js";
import { removeScriptEmbedding } from "../script-find.js";
import { mintInternalToken } from "@naelao/http";

function library(ctx: PrebuiltOpContext): SkillLibrary {
  return new SkillLibrary(ctx.env.scriptsBucket, ctx.env.spaceId);
}

/** How many recent errors to surface per skill. Enough to see a pattern, not a log dump. */
const ERRORS_SHOWN = 3;

function summarize(metadata: ScriptMetadata) {
  const health = assessSkillHealth(metadata);
  return {
    name: metadata.name,
    version: metadata.version,
    domain: metadata.domain,
    description: metadata.description,
    state: health.state,
    consecutive_failures: health.consecutive_failures,
    successes: metadata.success_count,
    failures: metadata.failure_count,
    ...(health.last_error ? { last_error: health.last_error } : {}),
    note: health.recommendation,
    promotable: isPromotable(metadata),
  };
}

async function loadAll(ctx: PrebuiltOpContext): Promise<ScriptMetadata[]> {
  const lib = library(ctx);
  const names = await lib.list();
  const metas = await Promise.all(names.map((n) => lib.readMetadata(n)));
  return metas.filter((m): m is ScriptMetadata => m !== null);
}

async function health(_a: Record<string, unknown>, ctx: PrebuiltOpContext): Promise<unknown> {
  const all = await loadAll(ctx);
  if (all.length === 0) {
    return {
      skills: [],
      count: 0,
      assessment: "No learned skills yet — nothing has been distilled in this space.",
    };
  }

  const rows = all.map(summarize);
  const broken = rows.filter((r) => r.state === "broken");
  const degrading = rows.filter((r) => r.state === "degrading");
  const promotable = rows.filter((r) => r.promotable);

  // The point of a summary is to say what to do about it, not to restate the table.
  const parts: string[] = [];
  if (broken.length > 0) {
    parts.push(
      `${broken.length} skill(s) are broken and will not be run unattended: ${broken.map((r) => r.name).join(", ")}. Fix them with a patch aimed at their last_error, or retire them.`
    );
  }
  if (degrading.length > 0) {
    parts.push(`${degrading.length} skill(s) are failing more than they should: ${degrading.map((r) => r.name).join(", ")}.`);
  }
  if (promotable.length > 0) {
    parts.push(`${promotable.length} skill(s) have proven out and could be shared with every business on this template: ${promotable.map((r) => r.name).join(", ")}.`);
  }
  if (parts.length === 0) parts.push(`All ${rows.length} learned skill(s) are healthy.`);

  return {
    skills: rows,
    count: rows.length,
    broken: broken.length,
    degrading: degrading.length,
    promotable: promotable.length,
    assessment: parts.join(" "),
  };
}

async function inspect(a: Record<string, unknown>, ctx: PrebuiltOpContext): Promise<unknown> {
  const name = String(a["name"] ?? "").trim();
  if (!name) throw new Error("skill.inspect requires a skill name");
  const stored = await library(ctx).read(name);
  if (!stored) return { found: false, name, message: `No learned skill named ${name} in this space.` };

  const m = stored.metadata;
  const recent = m.recent_outcomes ?? [];
  return {
    found: true,
    ...summarize(m),
    requires_tier: m.requires_tier,
    parameters: m.parameters,
    // The errors themselves, so a patch can be aimed rather than guessed.
    recent_errors: recent
      .filter((o) => !o.ok && o.error)
      .slice(0, ERRORS_SHOWN)
      .map((o) => ({ at: o.at, error: o.error })),
    recent_runs: recent.map((o) => ({ ok: o.ok, at: o.at })),
    patch_history: m.patch_history.map((p) => ({
      version: p.version,
      at: p.created_at,
      type: p.patch_type,
      reason: p.reason,
    })),
  };
}

async function rollback(a: Record<string, unknown>, ctx: PrebuiltOpContext): Promise<unknown> {
  const name = String(a["name"] ?? "").trim();
  if (!name) throw new Error("skill.rollback requires a skill name");
  const lib = library(ctx);
  const current = await lib.readMetadata(name);
  if (!current) return { ok: false, name, message: `No learned skill named ${name} in this space.` };
  if (current.version <= 1) {
    return { ok: false, name, message: `${name} is still on its first version — there is nothing to roll back to.` };
  }
  const target = a["to_version"] !== undefined ? Number(a["to_version"]) : current.version - 1;
  if (!Number.isInteger(target) || target < 1 || target >= current.version) {
    return { ok: false, name, message: `to_version must be a whole number between 1 and ${current.version - 1}.` };
  }
  const restored = await lib.rollback(name, target);
  return {
    ok: true,
    name,
    from_version: current.version,
    to_version: restored.version,
    message: `Rolled ${name} back to v${target}. Its health record is unchanged — run it to find out whether the older version actually works.`,
  };
}

async function retire(a: Record<string, unknown>, ctx: PrebuiltOpContext): Promise<unknown> {
  const name = String(a["name"] ?? "").trim();
  if (!name) throw new Error("skill.retire requires a skill name");
  const lib = library(ctx);
  const meta = await lib.readMetadata(name);
  if (!meta) return { ok: false, name, message: `No learned skill named ${name} in this space.` };

  await lib.delete(name);
  // Leaving the embedding behind would keep the skill turning up in script.find as a candidate
  // whose metadata no longer resolves — findable, unusable, and confusing.
  await removeScriptEmbedding(ctx.env, name);
  return {
    ok: true,
    name,
    retired_at_version: meta.version,
    message: `Retired ${name} (was v${meta.version}, ${meta.success_count} successes / ${meta.failure_count} failures). It will no longer be found or run. Anything that depended on it will need a new approach.`,
  };
}

async function promote(a: Record<string, unknown>, ctx: PrebuiltOpContext): Promise<unknown> {
  const name = String(a["name"] ?? "").trim();
  if (!name) throw new Error("skill.promote requires a skill name");
  if (!ctx.env.agentsWorker) {
    return { ok: false, name, message: "Skill promotion is not available in this environment." };
  }
  const meta = await library(ctx).readMetadata(name);
  if (!meta) return { ok: false, name, message: `No learned skill named ${name} in this space.` };
  if (!isPromotable(meta)) {
    const h = assessSkillHealth(meta);
    return {
      ok: false,
      name,
      message: `${name} is not proven enough to share yet (stability ${meta.stability_score.toFixed(2)}, ${meta.success_count} successes). ${h.recommendation}`,
    };
  }

  const resp = await ctx.env.agentsWorker.fetch(
    new Request("http://agents-worker/skills/promote", {
      method: "POST",
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId),
      },
      body: JSON.stringify({ space_id: ctx.env.spaceId, name }),
    })
  );
  const body = await resp.json<Record<string, unknown>>().catch(() => null);
  if (!resp.ok) {
    return {
      ok: false,
      name,
      message: String(body?.["message"] ?? `Could not promote ${name} (${resp.status}).`),
    };
  }
  return {
    ok: true,
    name,
    template_id: body?.["template_id"],
    message: `Promoted ${name} to the shared library — every business on this template inherits it from now on.`,
  };
}

export const skillManager: PrebuiltScript = {
  name: "skill-manager",
  description:
    "Inspect and maintain the skills this space has learned: see which are working, which are broken and why, roll back a bad patch, retire one that is beyond repair, or share a proven one with every business on this template.",
  domain: "compute",
  requires_tier: 1,
  operations: {
    "skill.health": health,
    "skill.inspect": inspect,
    "skill.rollback": rollback,
    "skill.retire": retire,
    "skill.promote": promote,
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/storefront.ts">
/**
 * storefront (spec §11 external portal) — provision a Naelao-hosted, multitenant storefront.
 * Tier 2.
 *
 * Architecture (Cloudflare for SaaS, confirmed against CF docs): storefronts are NOT a
 * Worker-per-tenant. They are ONE multitenant surface — a CF Pages static shell fronted by
 * the portal Worker (the fallback origin) which routes by Host header. Provisioning a
 * storefront therefore does not deploy anything; it just:
 *   1. allocates {slug}.naelao.com (covered by the zone's wildcard cert — no per-tenant cert)
 *   2. records a business_services row (space_id, kind='storefront', naelao_handle)
 *   3. registers the Host→spaceId route the portal Worker reads
 *
 * Custom domains are opt-in (productConfig.commerce.allowCustomDomain). They use the
 * Cloudflare for SaaS custom_hostnames API: the customer CNAMEs their domain to the
 * fallback origin and CF issues a DV cert. Until DNS validates, status is 'pending_dns'.
 *
 * Operations:
 *   storefront.provision(slug?)            → { handle: "{slug}.naelao.com", status }
 *   storefront.set_custom_domain(domain)   → { custom_domain, status: "pending_dns", dns }
 *   storefront.status()                    → current storefront service record
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";

async function bizService(
  ctx: PrebuiltOpContext,
  method: "POST" | "GET",
  body?: Record<string, unknown>
): Promise<unknown> {
  if (!ctx.env.spacesWorker) throw new Error("storefront unavailable: spaces worker binding not configured");
  const init: RequestInit = {
    method,
    headers: {
      "content-type": "application/json",
      "x-naelao-tenant-id": ctx.env.tenantId,
      "x-naelao-internal-token": await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId),
    },
  };
  if (body) init.body = JSON.stringify({ space_id: ctx.env.spaceId, ...body });
  const path = method === "GET"
    ? `/internal/business-services?space_id=${encodeURIComponent(ctx.env.spaceId)}&kind=storefront`
    : `/internal/business-services`;
  const resp = await ctx.env.spacesWorker.fetch(new Request(`http://spaces-worker${path}`, init));
  if (!resp.ok) throw new Error(`storefront op failed: ${resp.status} ${await resp.text()}`);
  return resp.json();
}

/** Normalise a free-text name into a DNS-safe slug. */
function toSlug(input: string): string {
  return (input || "shop").toLowerCase().replace(/[^a-z0-9-]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 40) || "shop";
}

export const storefront: PrebuiltScript = {
  name: "storefront",
  description:
    "Provision a Naelao-hosted storefront at {slug}.naelao.com (multitenant CF Pages + Worker) " +
    "and optionally attach the owner's custom domain via Cloudflare for SaaS.",
  domain: "api",
  requires_tier: 2,
  paramHints: {
    "storefront.provision": "slug (or name, slugified automatically) is optional — defaults to 'shop'. This is the {slug}.naelao.com handle, not a domain.",
    "storefront.set_custom_domain": "domain is required, e.g. 'shop.example.com'. A SEPARATE operation from storefront.provision — calling provision again after this would drop the custom domain, never re-provision to change a domain.",
  },
  operations: {
    "storefront.provision": (a, c) =>
      bizService(c, "POST", { kind: "storefront", slug: toSlug(String(a["slug"] ?? a["name"] ?? "shop")) }),
    "storefront.set_custom_domain": (a, c) =>
      // Custom domains are a separate business_services row (kind='custom_domain'); this is what
      // triggers the Cloudflare-for-SaaS apply (createCustomHostname + TXT DCV) on the spaces
      // worker. Posting kind='storefront' here would drop the domain and allocate a handle.
      bizService(c, "POST", { kind: "custom_domain", custom_domain: String(a["domain"] ?? "") }),
    "storefront.status": (_a, c) => bizService(c, "GET"),
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/sub-agent.ts">
/**
 * sub-agent (spec §12.1) — spawn and coordinate sub-agents for parallel task execution.
 * Operations: agent.spawn, agent.send, agent.receive, agent.terminate.
 *
 * Spawning a sub-agent needs the NaelaoAgentDO namespace, which the engine does not own,
 * so these operations delegate to host-provided orchestration hooks. When the host has
 * not wired them, the operation reports itself unavailable (honest degradation).
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import type { OrchestrationHooks } from "../types.js";
import {
  ALLOWED_MODELS,
  DEFAULT_WORKING_MODEL,
  capabilityForModel,
  contextWindowForModel,
  benchmarkForModel,
  isAllowedModel,
  suggestModels,
} from "@naelao/billing-core";

function hooks(ctx: PrebuiltOpContext): OrchestrationHooks {
  return ctx.env.orchestration ?? {};
}

export const subAgent: PrebuiltScript = {
  name: "sub-agent",
  description:
    "Spawn, message, and terminate sub-agents for parallel work, and see which models a spawn " +
    "can actually be given.",
  domain: "orchestration",
  requires_tier: 2,
  paramHints: {
    "agent.spawn":
      "tasks (array, required) — each {goal, model?, maxTokens?}. `model` must be one from " +
      "agent.list_models; an unavailable or too-expensive one is clamped to what the current " +
      "Effort setting allows and the result says so. Omit it to let the platform choose.",
    "agent.list_models":
      "No arguments. Returns every model a spawn may name, with its context window, whether it " +
      "supports a thinking budget, and its cost tier — call this before guessing a model id.",
  },
  operations: {
    // Every op that takes a model needs a way to find out what the real ones are. Without this an
    // agent either guesses an id (and gets a provider 404) or never sets one at all, which makes
    // the whole per-task model choice unusable in practice.
    async "agent.list_models"() {
      return {
        default: DEFAULT_WORKING_MODEL,
        models: ALLOWED_MODELS.map((m) => {
          const cap = capabilityForModel(m);
          const bench = benchmarkForModel(m);
          return {
            id: m,
            family: bench?.family ?? null,
            cost_tier: bench?.costTier ?? null,
            context_window: contextWindowForModel(m),
            supports_thinking: cap.reasoningLevels.length > 0,
            thinking_levels: cap.reasoningLevels,
            best_for: bench?.bestFor ?? [],
          };
        }),
      };
    },
    async "agent.spawn"(args, ctx) {
      const h = hooks(ctx);
      if (!h.spawnSubAgent) return { ok: false, reason: "sub-agent spawning not available in this environment" };
      // Validate any explicitly-named model BEFORE delegating. A wrong id must get a real
      // "not available / did you mean" answer, not a silent clamp (which read as a misleading
      // "too expensive for your Effort" reason, since resolveEscalationModel can't tell an
      // invalid id from a valid-but-pricey one) and never a bare provider 404 down the line.
      // This is the model-selector's own allowlist — the same list agent.list_models returns.
      const tasks = Array.isArray(args["tasks"]) ? (args["tasks"] as Array<Record<string, unknown>>) : [];
      for (const t of tasks) {
        const m = t && typeof t["model"] === "string" ? (t["model"] as string) : "";
        if (m && !isAllowedModel(m)) {
          const suggestions = suggestModels(m);
          return {
            ok: false,
            error:
              `model "${m}" is not available.` +
              (suggestions.length ? ` Did you mean: ${suggestions.join(", ")}?` : "") +
              ` Call agent.list_models to see every model a spawn may name (omit "model" to let the platform choose).`,
            did_you_mean: suggestions,
            available_models: ALLOWED_MODELS as readonly string[],
          };
        }
      }
      return await h.spawnSubAgent(args);
    },
    async "agent.send"(args, ctx) {
      const h = hooks(ctx);
      if (!h.sendToSubAgent) return { ok: false, reason: "sub-agent messaging not available" };
      return await h.sendToSubAgent(String(args["id"] ?? ""), args["task"]);
    },
    async "agent.receive"(args, ctx) {
      const h = hooks(ctx);
      if (!h.receiveFromSubAgent) return { ok: false, reason: "sub-agent receive not available" };
      return await h.receiveFromSubAgent(String(args["id"] ?? ""));
    },
    async "agent.terminate"(args, ctx) {
      const h = hooks(ctx);
      if (!h.terminateSubAgent) return { ok: false, reason: "sub-agent terminate not available" };
      await h.terminateSubAgent(String(args["id"] ?? ""));
      return { ok: true };
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/tasks.ts">
/**
 * tasks (AVOS plan step 4) — a per-project task DAG for multi-agent coordination, distinct from
 * project_journal's own todos (project-journal.ts): a journal todo is a loose personal checklist
 * item (text + done, no dependency graph, no assignment) — fine for "what I still need to do,"
 * useless for "my task is blocked on a DIFFERENT agent finishing theirs." A task here can declare
 * `dependencies` (other task ids) and an `assigned_agent`, and task.start refuses to move a task
 * to in_progress until every dependency is actually completed — the DAG's edges are enforced
 * HERE, in this prebuilt, not trusted to the model's own bookkeeping (the same "structure over
 * prompts" reasoning as every other hard gate in this engine).
 *
 * Storage is SpaceDO's own `tasks` table (dumb CRUD; see SpaceDO.ts's own header on that split).
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";

interface TaskRow {
  id: string;
  space_id: string;
  project_id: string | null;
  thread_id: string | null;
  title: string;
  status: "pending" | "in_progress" | "completed" | "blocked" | "cancelled";
  dependencies: string[];
  assigned_agent: string | null;
  created_at: string;
  updated_at: string;
}

async function spacesCall(
  ctx: PrebuiltOpContext,
  method: string,
  path: string,
  body?: Record<string, unknown>
): Promise<{ ok: boolean; status: number; json: unknown }> {
  if (!ctx.env.spacesWorker) throw new Error("tasks unavailable: spaces worker binding not configured");
  const token = await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId);
  const resp = await ctx.env.spacesWorker.fetch(
    new Request(`http://spaces-worker${path}`, {
      method,
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": token,
        // Act on behalf of the person who asked, when there is one — same reasoning as
        // schedule.ts/project-coordination.ts's own spacesCall: correct attribution, and the
        // assistant is clamped to what that person could do unaided.
        ...(ctx.env.userId ? { "x-naelao-user-id": ctx.env.userId } : {}),
      },
      ...(body ? { body: JSON.stringify(body) } : {}),
    })
  );
  const json = await resp.json().catch(() => ({}));
  return { ok: resp.ok, status: resp.status, json };
}

async function listRaw(ctx: PrebuiltOpContext, filters: Record<string, string> = {}): Promise<TaskRow[]> {
  const qs = new URLSearchParams({ ...(ctx.env.projectId ? { project_id: ctx.env.projectId } : {}), ...filters });
  const res = await spacesCall(ctx, "GET", `/spaces/${ctx.env.spaceId}/tasks?${qs.toString()}`);
  if (!res.ok) return [];
  return ((res.json as { data?: TaskRow[] }).data ?? []) as TaskRow[];
}

function reqId(a: Record<string, unknown>): string {
  const id = String(a["id"] ?? "").trim();
  if (!id) throw new Error("'id' (a task id from task.list) is required");
  return id;
}

async function setStatus(ctx: PrebuiltOpContext, id: string, status: TaskRow["status"]): Promise<unknown> {
  const res = await spacesCall(ctx, "PATCH", `/spaces/${ctx.env.spaceId}/tasks/${encodeURIComponent(id)}`, { status });
  if (!res.ok) return { ok: false, error: `failed to update task ${id}: HTTP ${res.status}` };
  return { ok: true, task: res.json };
}

export const tasks: PrebuiltScript = {
  name: "tasks",
  description:
    "A task DAG for coordinating work ACROSS agents in this project — declare a task, say what " +
    "it depends on and who owns it, and task.start refuses to begin it until its dependencies " +
    "are actually completed. Use project_journal for your own running notes; use this when " +
    "another agent's work genuinely depends on knowing this one is done.",
  domain: "orchestration",
  requires_tier: 1,
  paramHints: {
    "task.create": "title (string, REQUIRED). dependencies (string[], optional — other task ids " +
      "this one can't start until they're completed). assigned_agent (string, optional — an " +
      "agent id from thread.list_project_agents). thread_id (string, optional).",
    "task.start": "id (string, REQUIRED — from task.list). Refused (status stays 'pending') if any " +
      "dependency isn't completed yet.",
    "task.complete": "id (string, REQUIRED).",
    "task.block": "id (string, REQUIRED).",
    "task.list": "status (string, optional — pending/in_progress/completed/blocked/cancelled). " +
      "thread_id (string, optional). Omit both to list every task in this project.",
  },
  operations: {
    async "task.create"(a, c) {
      const title = String(a["title"] ?? "").trim();
      if (!title) throw new Error("task.create requires 'title'");
      const dependencies = Array.isArray(a["dependencies"]) ? (a["dependencies"] as unknown[]).map(String) : [];
      const res = await spacesCall(c, "POST", `/spaces/${c.env.spaceId}/tasks`, {
        title,
        ...(c.env.projectId ? { project_id: c.env.projectId } : {}),
        ...(typeof a["thread_id"] === "string" ? { thread_id: a["thread_id"] } : {}),
        ...(dependencies.length ? { dependencies } : {}),
        ...(typeof a["assigned_agent"] === "string" ? { assigned_agent: a["assigned_agent"] } : {}),
      });
      if (!res.ok) return { ok: false, error: `failed to create task: HTTP ${res.status}` };
      return { ok: true, task: res.json };
    },

    async "task.start"(a, c) {
      const id = reqId(a);
      const all = await listRaw(c);
      const target = all.find((t) => t.id === id);
      if (!target) return { ok: false, error: `task ${id} not found in this project` };
      const unmet = target.dependencies.filter((depId) => {
        const dep = all.find((t) => t.id === depId);
        return !dep || dep.status !== "completed";
      });
      if (unmet.length > 0) {
        return {
          ok: false,
          error: `task ${id} has unfinished dependencies: ${unmet.join(", ")}. It stays pending until those are completed.`,
          blocked_on: unmet,
        };
      }
      return setStatus(c, id, "in_progress");
    },

    async "task.complete"(a, c) {
      return setStatus(c, reqId(a), "completed");
    },

    async "task.block"(a, c) {
      return setStatus(c, reqId(a), "blocked");
    },

    async "task.list"(a, c) {
      const filters: Record<string, string> = {};
      if (typeof a["status"] === "string" && a["status"]) filters.status = a["status"] as string;
      if (typeof a["thread_id"] === "string" && a["thread_id"]) filters.thread_id = a["thread_id"] as string;
      const rows = await listRaw(c, filters);
      return { tasks: rows, count: rows.length };
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/wallet.ts">
/**
 * wallet (user-directed feature — Launchpad Wallet) — Tier 2.
 *
 * Lets an agent/Space Assistant check and top up a business's own stored-value balance
 * (a project flagged kind='wallet', SpaceDO's wallet_ledger — see SpaceDO.ts's "Launchpad
 * Wallet" section for the ledger implementation).
 *
 * SCOPE, READ THIS BEFORE EXTENDING: the wallet is an INTERNAL, Naelao-held ledger, funded via
 * a fixed-price Lemon Squeezy checkout (same "pick a pre-configured pack" shape as commerce
 * checkouts) and drawn down for NAELAO'S OWN metered platform costs. It is NOT, and is not meant
 * to become, a payment rail that pays a third party (Whop, Shopify, Stripe, PayPal...) on a
 * business's behalf — Lemon Squeezy has no API for funding an arbitrary outbound payment to a
 * vendor, and actually building that (a virtual card / ACH-push / money-transmission capability)
 * is a real regulatory undertaking (money-transmitter licensing, PCI scope) this build does not
 * attempt. The "cut Naelao gets" this feature supports is: a business that uses the Naelao
 * wallet for its own platform spend has no separate payment credential to configure; a business
 * that instead connects its OWN Stripe/Whop/Shopify key (check_bypass detects this) is a signal
 * for the assistant to have an honest conversation about it — never a hard block coded here.
 *
 * Operations:
 *   wallet.balance()                        → { balance_cents, currency }
 *   wallet.fund(topup_id, customer_email?)  → { checkout_url }               (money-in)
 *   wallet.history(limit?)                  → recent ledger entries
 *   wallet.check_bypass()                   → { using_own_payment_method, matched_providers }
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";

// Credential names a business might register for its OWN payment method instead of using the
// Naelao wallet. Deliberately a small, explicit allowlist (not a heuristic/regex over arbitrary
// names) — a false positive here would incorrectly flag an unrelated credential as a "bypass."
const THIRD_PARTY_PAYMENT_CREDENTIAL_NAMES = [
  "stripe_api_key",
  "whop_api_key",
  "shopify_api_key",
  "shopify_access_token",
  "paypal_api_key",
];

function requireProjectId(ctx: PrebuiltOpContext, args: Record<string, unknown>): string {
  const projectId = (args["project_id"] as string | undefined) ?? ctx.env.projectId;
  if (!projectId) throw new Error("wallet ops require a project-scoped run (or an explicit project_id)");
  return projectId;
}

async function spacesGet(ctx: PrebuiltOpContext, path: string): Promise<unknown> {
  if (!ctx.env.spacesWorker) throw new Error("wallet unavailable: spaces worker binding not configured");
  const resp = await ctx.env.spacesWorker.fetch(
    new Request(`http://spaces-worker${path}`, {
      headers: {
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId),
      },
    })
  );
  if (!resp.ok) throw new Error(`wallet read ${path} failed: ${resp.status}`);
  return resp.json();
}

async function billingPost(ctx: PrebuiltOpContext, path: string, body: Record<string, unknown>): Promise<unknown> {
  if (!ctx.env.billingWorker) throw new Error("wallet unavailable: billing worker binding not configured");
  const resp = await ctx.env.billingWorker.fetch(
    new Request(`http://billing-worker${path}`, {
      method: "POST",
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId),
      },
      body: JSON.stringify(body),
    })
  );
  if (!resp.ok) throw new Error(`wallet ${path} failed: ${resp.status} ${await resp.text()}`);
  return resp.json();
}

export const wallet: PrebuiltScript = {
  name: "wallet",
  description:
    "Check and top up this business's Naelao wallet balance (a Naelao-held stored-value ledger " +
    "used to pay for Naelao platform costs — not a rail for paying third parties like Whop or " +
    "Shopify). Also detects when a business has connected its own payment credential instead of " +
    "using the wallet.",
  domain: "api",
  requires_tier: 2,
  operations: {
    // async: requireProjectId's validation throw must surface as a rejected promise (matching
    // PrebuiltOp's Promise<unknown> contract), not a synchronous throw from a non-async arrow fn.
    "wallet.balance": async (a, c) =>
      spacesGet(c, `/spaces/${c.env.spaceId}/projects/${requireProjectId(c, a)}/wallet/balance`),

    "wallet.history": async (a, c) => {
      const limit = typeof a["limit"] === "number" ? a["limit"] : 50;
      return spacesGet(c, `/spaces/${c.env.spaceId}/projects/${requireProjectId(c, a)}/wallet/history?limit=${limit}`);
    },

    // Money-in: returns a Naelao-store Lemon Squeezy checkout URL for a pre-configured top-up
    // pack (productConfig.pricingConfig.walletTopups) — never an arbitrary custom amount.
    "wallet.fund": async (a, c) =>
      billingPost(c, "/internal/wallet-topups/checkout", {
        business_space_id: c.env.spaceId,
        project_id: requireProjectId(c, a),
        topup_id: a["topup_id"],
        ...(a["customer_email"] ? { customer_email: a["customer_email"] } : {}),
      }),

    // Detection only — reports what it found. It is deliberately the CALLER's job (the
    // assistant's own judgment / a builder-authored no-code trigger on wallet.bypass_detected)
    // to decide what to say or do about it, never a hardcoded gate here.
    "wallet.check_bypass": async (_a, c) => {
      if (!c.env.credentialsWorker) {
        return { using_own_payment_method: false, matched_providers: [], checked: false };
      }
      const resp = await c.env.credentialsWorker.fetch(
        new Request(`http://credentials-worker/spaces/${c.env.spaceId}/credentials`, {
          headers: {
            "x-naelao-tenant-id": c.env.tenantId,
            "x-naelao-internal-token": await mintInternalToken(c.env.platformSecret ?? "", c.env.tenantId),
          },
        })
      );
      if (!resp.ok) return { using_own_payment_method: false, matched_providers: [], checked: false };
      const { credentials } = await resp.json<{ credentials: Array<{ name: string }> }>();
      const matched = credentials
        .map((cred) => cred.name)
        .filter((name) => THIRD_PARTY_PAYMENT_CREDENTIAL_NAMES.includes(name));
      return { using_own_payment_method: matched.length > 0, matched_providers: matched, checked: true };
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/web-search.ts">
/**
 * web-search (spec §12.3) — Tier 2 isolate. search(query), fetch_page(url),
 * extract_content(url, schema), grounded_answer(query) (§A1.25).
 *
 * UNIVERSAL / PLATFORM-PROVIDED (CLAUDE.md "universal tools" principle): web search is bundled
 * by Naelao exactly like Claude/ChatGPT bundle it — the builder never brings their own search
 * API key. The platform holds ONE search-provider key (Tavily) as a Workers Secret on the
 * knowledge worker, and every agent gets search for free. This is NOT the BYO-key
 * `space_credentials` model (that is only for a builder's own external accounts, e.g. their
 * Whop/Gumroad via mcp-connector). The key never reaches the agent — the isolate only ever sees
 * normalized results.
 *
 * `search`/`extract_content` need the platform provider key; when it is unset the op reports
 * itself unconfigured (`configured:false`) rather than silently returning empty results.
 * `fetch_page` is a generic SSRF-guarded HTTP GET and needs no key — it works out of the box.
 *
 * The route is HMAC-gated (like every other /internal/* route on the knowledge worker), so we
 * mint a short-lived tenant-scoped internal token per call — the agent never gets the key.
 *
 * `grounded_answer` (§A1.25) is a DIFFERENT mechanism, not a Tavily proxy: it calls the LLM
 * directly with Anthropic's native web-search tool enabled (proxied transparently by CF AI
 * Gateway — Unified Billing, no separate provider key). Search-and-synthesize happens in one
 * gateway-billed call instead of a search round trip + a second summarization call. Its token
 * usage is real and gets billed exactly like any reasoner call (see ScriptToolSurface.run()).
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";
import { workspacePrefix } from "../types.js";

async function proxy(ctx: PrebuiltOpContext, path: string, body: unknown): Promise<unknown> {
  if (!ctx.env.knowledgeWorker) {
    throw new Error("web-search: search proxy (KNOWLEDGE_WORKER) not configured");
  }
  const token = await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId);
  const resp = await ctx.env.knowledgeWorker.fetch(
    new Request(`http://knowledge-worker${path}`, {
      method: "POST",
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": token,
      },
      body: JSON.stringify(body),
    })
  );
  if (!resp.ok) throw new Error(`web-search ${path} failed: ${resp.status}`);
  return await resp.json();
}

export const webSearch: PrebuiltScript = {
  name: "web-search",
  description:
    "Search the web, fetch a page, extract structured content, and download a file into the workspace (platform-provided, no key required).",
  domain: "api",
  requires_tier: 2,
  paramHints: {
    download_file: "url is required. filename is optional — defaults to the last path segment of the URL. Handles BINARY files (PDF, images, zip) as well as text. Saves to downloads/<filename> in the workspace; does not return the content, use read_file/stat_file to inspect it afterward (read_file only works on text).",
  },
  operations: {
    async search(args, ctx) {
      return proxy(ctx, "/internal/web-search/search", {
        query: String(args["query"] ?? ""),
        max_results: typeof args["max_results"] === "number" ? args["max_results"] : 10,
      });
    },
    async fetch_page(args, ctx) {
      return proxy(ctx, "/internal/web-search/fetch", { url: String(args["url"] ?? "") });
    },
    async extract_content(args, ctx) {
      return proxy(ctx, "/internal/web-search/extract", {
        url: String(args["url"] ?? ""),
        schema: args["schema"] ?? null,
      });
    },
    // §A1.25: search-and-synthesize in ONE gateway-billed call — a cheap model with Anthropic's
    // native web-search tool enabled (proxied transparently by CF AI Gateway, same Unified
    // Billing as every other LLM call, no separate Tavily round trip for this op). Real usage is
    // returned in `output.usage` so ScriptToolSurface.run() bills it like any reasoner call —
    // this is NOT a free LLM call just because it's invoked from inside a script.
    async grounded_answer(args, ctx) {
      if (!ctx.env.llmCaller) {
        return { ok: false, reason: "grounded_answer unavailable: no LLM credentials configured on this host" };
      }
      const query = String(args["query"] ?? "");
      if (!query) throw new Error("grounded_answer requires 'query'");
      const model = typeof args["model"] === "string" ? (args["model"] as string) : "claude-haiku-4-5-20251001";
      const maxUses = typeof args["max_results"] === "number" ? (args["max_results"] as number) : undefined;
      const result = await ctx.env.llmCaller.callWithNativeWebSearch({ model, query, maxUses });
      return {
        answer: result.answer,
        citations: result.citations,
        usage: { tokens_used: result.tokens_used, input_tokens: result.input_tokens, output_tokens: result.output_tokens },
      };
    },
    // Downloads a real file into the workspace, mirroring the existing `uploads/` convention —
    // the SAME r2-workspace bucket/prefix, under `downloads/` instead. Deliberately does NOT
    // return the content in the tool result (unlike fetch_page/extract_content): a download can
    // be up to 2MB (WEB_DOWNLOAD_CONTENT_CAP on the knowledge worker), and echoing that into the
    // reasoning payload would defeat the entire point of saving it to disk instead of reading it.
    // The caller gets a path and a size; use read_file/stat_file on it afterward if inspection is
    // actually needed — read_file's own size guard applies there too.
    async download_file(args, ctx) {
      const url = String(args["url"] ?? "").trim();
      if (!url) throw new Error("download_file requires 'url'");
      const result = (await proxy(ctx, "/internal/web-search/download", { url })) as {
        url: string; status: number; content: string | null; size?: number; truncated?: boolean;
        error?: string; encoding?: "text" | "base64"; content_type?: string;
      };
      if (!result.content) {
        return { ok: false, url, status: result.status, error: result.error ?? `download failed (status ${result.status})` };
      }
      // A failing server still sends a BODY — an error page, a rate-limit notice, a JSON error.
      // Only "was there content" was checked, so a 429/502 was written into the workspace as if it
      // were the requested file and reported as a successful download. Seen live: a GitHub 502 was
      // saved as a 16-byte `README.md` reading "error code: 502", and the agent told the user the
      // file had downloaded. Anything outside 2xx is a failed download, whatever came back with it.
      if (result.status < 200 || result.status >= 300) {
        return {
          ok: false,
          url,
          status: result.status,
          error: `download failed (status ${result.status}) — the server returned an error page, not the file`,
          body_preview: result.content.slice(0, 200),
        };
      }
      const explicitName = typeof args["filename"] === "string" && args["filename"] ? (args["filename"] as string) : undefined;
      // R2 keys are flat strings with no real directory-traversal semantics, but sanitized the
      // same defensive way r2-workspace.ts's own key() helper does for consistency: strip
      // anything but a safe character class, then collapse any run of 2+ dots (".." and longer)
      // so a filename can never even LOOK like a traversal attempt.
      const filename = (
        (explicitName ?? url.split("/").pop() ?? "download")
          .replace(/[^a-zA-Z0-9._-]/g, "_")
          .replace(/\.{2,}/g, "_")
          .replace(/^[._]+/, "")
      ) || "download";
      const bucket = ctx.env.workspaceBucket ?? ctx.env.scriptsBucket;
      const path = `downloads/${filename}`;
      // A base64 payload has to be decoded back to real bytes before it hits R2 — writing the
      // base64 STRING would store a file that is neither the original nor readable as text.
      const payload: string | Uint8Array =
        result.encoding === "base64"
          ? Uint8Array.from(atob(result.content), (ch) => ch.charCodeAt(0))
          : result.content;
      await bucket.put(`${workspacePrefix(ctx.env)}${path}`, payload, {
        // Recording the real content type is what lets the Files viewer decide between an
        // inline preview and a download, instead of guessing from the extension.
        ...(result.content_type ? { httpMetadata: { contentType: result.content_type } } : {}),
        customMetadata: { updatedAt: Date.now().toString(), sourceUrl: url },
      });
      ctx.env.onWorkspaceChange?.({ path, operation: "write" });
      return {
        ok: true, path,
        size: result.size ?? (payload instanceof Uint8Array ? payload.byteLength : payload.length),
        content_type: result.content_type ?? null,
        binary: result.encoding === "base64",
        truncated: result.truncated ?? false,
      };
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/wiki.ts">
/**
 * wiki (Memory OS Layer 6 — spec "6-Layer Memory OS", byte ~148238: "Auto-curated concept and
 * entity vault. An async background process (wiki-continuous-ingest) runs on session end to
 * structure new learnings into wiki articles, which are re-indexed into Layer 5.").
 *
 * Same self-managed pattern as fabric/memory: the agent calls wiki.upsert when it learns
 * something worth defining durably (a customer's product terminology, a recurring entity),
 * and wiki.lookup/wiki.search to consult what's already been curated before re-deriving it.
 * "Re-indexed into Layer 5" (Vectorize) is a further enhancement noted as future work — this
 * build makes the vault itself (the DO SQLite + R2 primitive per spec) real and queryable.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";

function userIdFor(args: Record<string, unknown>, ctx: PrebuiltOpContext): string | undefined {
  const explicit = args["user_id"];
  if (typeof explicit === "string" && explicit) return explicit;
  return ctx.env.userId;
}

function stringArray(v: unknown): string[] {
  return Array.isArray(v) ? v.filter((x): x is string => typeof x === "string") : [];
}

export const wiki: PrebuiltScript = {
  name: "wiki",
  description:
    "Auto-curated concept vault (Layer 6): define or update a concept/entity, look one up by name, or search definitions by keyword.",
  domain: "knowledge",
  requires_tier: 1,
  operations: {
    async "wiki.upsert"(args, ctx) {
      if (!ctx.env.memoryStore) return { ok: false, reason: "memory store not available in this environment" };
      const concept = String(args["concept"] ?? "");
      const definition = String(args["definition"] ?? "");
      if (!concept || !definition) throw new Error("wiki.upsert requires 'concept' and 'definition'");
      const userId = userIdFor(args, ctx);
      return ctx.env.memoryStore.upsertWikiConcept({
        ...(userId ? { userId } : {}),
        concept,
        definition,
        relationships: stringArray(args["relationships"]),
      });
    },
    async "wiki.lookup"(args, ctx) {
      if (!ctx.env.memoryStore) return { ok: false, reason: "memory store not available in this environment" };
      const concept = String(args["concept"] ?? "");
      if (!concept) throw new Error("wiki.lookup requires 'concept'");
      const userId = userIdFor(args, ctx);
      const article = await ctx.env.memoryStore.lookupWikiConcept(userId, concept);
      return article ?? { ok: false, reason: "concept not found" };
    },
    async "wiki.search"(args, ctx) {
      if (!ctx.env.memoryStore) return { ok: false, reason: "memory store not available in this environment" };
      const text = String(args["query"] ?? args["text"] ?? "");
      if (!text) throw new Error("wiki.search requires 'query'");
      const userId = userIdFor(args, ctx);
      return ctx.env.memoryStore.searchWiki({
        ...(userId ? { userId } : {}),
        text,
        limit: typeof args["limit"] === "number" ? (args["limit"] as number) : 5,
      });
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/workspace-admin.ts">
/**
 * workspace-admin (§A1.17 Phase G) — lets an agent (specifically the Launchpad business-builder
 * Space Assistant) actually SCAFFOLD a business: create/list/configure projects, manage who can
 * see a project, and read the space's agent roster. Tier 2 (pure orchestration over the
 * already-existing spaces-worker project routes — no new backend mechanism, per the "reuse, don't
 * reinvent" principle).
 *
 * `project.create_from_template` mirrors the exact 4-step sequence the agents worker's own
 * `POST /spaces/:spaceId/projects/from-template` route already performs (create → configure →
 * seed rules → seed scheduled jobs) rather than calling that route over HTTP — this prebuilt runs
 * inside the SAME Worker as that route (both in workers/agents), and a Durable Object has no
 * "call my own Worker's HTTP router" primitive, so the sequence is replicated against the spaces
 * worker binding directly, using the identical project-templates catalogue.
 * `project.create` is the ad-hoc counterpart: a plain named project for something the catalogue
 * has no template for, which is what a person clicking "New project" in the shell gets.
 *
 * ACTING USER (§A1.18 follow-up — this fixes a real bug, not just attribution). Every call below
 * forwards `x-naelao-user-id` when the run has an acting user. Without it the spaces worker
 * computes `created_by: undefined, system_caller: true`, and since a project defaults to
 * `visibility:'private'`, `SpaceDO.createProject`'s "creator is always an implicit project_members
 * owner" insert is skipped (`if (... && body.created_by)`) — so `listProjects`' viewer filter hid
 * every assistant-scaffolded project from everyone except a space owner/admin. The person who
 * asked for the project could not see it. Forwarding the user also correctly CLAMPS the assistant
 * to what that person could do unaided (a plain member asking for a project-member change now gets
 * the same 403 they would get themselves), which is the same principle F-36's
 * `resolveAssistantEffectiveRole` already established.
 *
 * All mutating ops (`project.create`, `project.create_from_template`, `project.configure`,
 * `project.add_member`, `project.remove_member`) are gate-worthy action names — under the default
 * guided policy the owner reviews structural changes before they happen. Read-only ops
 * (`project.list`, `project.list_members`, `agent.list`) are never gated. Archiving a project is
 * `project.configure` with `status: 'archived'` rather than its own op — the PATCH is a
 * passthrough, so name/description/visibility/caps/agent-bindings/status all go through one place.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";
import { getProjectTemplate } from "../../launchpad/project-templates.js";

async function spacesCall(ctx: PrebuiltOpContext, method: string, path: string, body?: Record<string, unknown>): Promise<unknown> {
  if (!ctx.env.spacesWorker) throw new Error("workspace-admin unavailable: spaces worker binding not configured");
  const token = await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId);
  const resp = await ctx.env.spacesWorker.fetch(
    new Request(`http://spaces-worker${path}`, {
      method,
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": token,
        // Act ON BEHALF OF the person who asked, whenever there is one. This is load-bearing, not
        // cosmetic — see the header note above. Omitted (byte-identical to the prior behavior) for
        // a genuinely system-initiated run: a cron tick, a channel drain, or provision-time
        // scaffolding, none of which have an acting user.
        ...(ctx.env.userId ? { "x-naelao-user-id": ctx.env.userId } : {}),
      },
      ...(body ? { body: JSON.stringify(body) } : {}),
    })
  );
  if (!resp.ok) throw new Error(`workspace-admin ${method} ${path} failed: ${resp.status} ${await resp.text()}`);
  return resp.json();
}

async function createFromTemplate(ctx: PrebuiltOpContext, templateId: string, name?: string): Promise<unknown> {
  const template = getProjectTemplate(templateId);
  if (!template) throw new Error(`Unknown project template: ${templateId}`);
  const spaceId = ctx.env.spaceId;

  // 1. Create the project.
  const project = (await spacesCall(ctx, "POST", `/spaces/${spaceId}/projects`, {
    name: name ?? template.name,
    description: template.description,
    ...(template.default_agent_id ? { default_agent_id: template.default_agent_id } : {}),
    ...(template.allowed_agent_ids && template.allowed_agent_ids.length > 0 ? { allowed_agent_ids: template.allowed_agent_ids } : {}),
  })) as { id: string; name: string };

  // 2. Configure it (kind, execution ceiling, spend cap, thread cap, suggested channel).
  await spacesCall(ctx, "PATCH", `/spaces/${spaceId}/projects/${project.id}`, {
    kind: template.kind,
    execution_ceiling: template.execution_ceiling,
    daily_spend_cap_credits: template.daily_spend_cap_credits,
    ...(template.max_threads !== undefined ? { max_threads: template.max_threads } : {}),
    ...(template.kind === "customer_bot" && template.suggested_channel
      ? { channel_config: { [template.suggested_channel]: { connected: false } } }
      : {}),
  });

  // 3. Seed starter rules.
  for (const rule of template.rules ?? []) {
    await spacesCall(ctx, "POST", `/spaces/${spaceId}/projects/${project.id}/rules`, { ...rule });
  }

  // 4. Seed scheduled jobs.
  for (const job of template.scheduled_jobs ?? []) {
    await spacesCall(ctx, "POST", `/spaces/${spaceId}/scheduled-jobs`, { ...job, project_id: project.id });
  }

  return project;
}

export const workspaceAdmin: PrebuiltScript = {
  name: "workspace-admin",
  description:
    "Scaffold and manage the business's workspace: create a new project (either a plain one, or " +
    "fully configured from the project-templates catalogue — customer support bots, community " +
    "monitoring, etc.), list and reconfigure existing projects (including renaming and archiving " +
    "them), control who can see a private project, and read the space's installed agent roster. " +
    "Creating or reconfiguring a project is a real structural change to the business — the owner " +
    "reviews it before it happens.",
  domain: "api",
  requires_tier: 2,
  operations: {
    // The ad-hoc counterpart to create_from_template: what "New project" in the shell does. Use
    // this whenever the person asks for a project the template catalogue has no entry for.
    "project.create": async (a, c) => {
      const name = String(a["name"] ?? "").trim();
      if (!name) throw new Error("project.create requires name");
      // A project created on a SYSTEM run (a cron wake, a channel drain) has no acting user, so
      // SpaceDO skips its "the creator is an implicit project_members owner" insert — and the
      // default `private` visibility then hides it from every business member except an
      // owner/admin. Observed live: an unattended wake-up built a real project, posted a real
      // brief into it, and produced something ordinary members could not see, belonging to
      // nobody. When the assistant acts for the business rather than for a person, the business
      // is the audience. An explicit visibility from the caller still wins.
      const systemRun = !c.env.userId;
      return spacesCall(c, "POST", `/spaces/${c.env.spaceId}/projects`, {
        name,
        ...(a["description"] ? { description: String(a["description"]) } : {}),
        ...(a["visibility"] ? { visibility: String(a["visibility"]) } : systemRun ? { visibility: "public" } : {}),
        ...(a["default_agent_id"] ? { default_agent_id: String(a["default_agent_id"]) } : {}),
        ...(Array.isArray(a["allowed_agent_ids"]) ? { allowed_agent_ids: a["allowed_agent_ids"] } : {}),
      });
    },
    "project.create_from_template": (a, c) => createFromTemplate(c, String(a["template_id"] ?? ""), a["name"] ? String(a["name"]) : undefined),
    "project.list": (_a, c) => spacesCall(c, "GET", `/spaces/${c.env.spaceId}/projects`),
    "project.configure": async (a, c) => {
      const { project_id, ...patch } = a;
      if (!project_id) throw new Error("project.configure requires project_id");
      return spacesCall(c, "PATCH", `/spaces/${c.env.spaceId}/projects/${String(project_id)}`, patch);
    },
    // Project membership (§A1.17 Phase T1 ACL) — who can see/work in a private project. Reaching
    // these at all requires the acting user to be an admin of the business, enforced by
    // requireBusinessMembership on the route, not re-implemented here.
    "project.list_members": async (a, c) => {
      const projectId = String(a["project_id"] ?? "") || c.env.projectId;
      if (!projectId) throw new Error("project.list_members requires project_id");
      return spacesCall(c, "GET", `/spaces/${c.env.spaceId}/projects/${encodeURIComponent(projectId)}/members`);
    },
    "project.add_member": async (a, c) => {
      const projectId = String(a["project_id"] ?? "") || c.env.projectId;
      const userId = String(a["user_id"] ?? "");
      if (!projectId || !userId) throw new Error("project.add_member requires project_id and user_id");
      return spacesCall(c, "POST", `/spaces/${c.env.spaceId}/projects/${encodeURIComponent(projectId)}/members`, {
        user_id: userId,
        ...(a["role"] ? { role: String(a["role"]) } : {}),
      });
    },
    "project.remove_member": async (a, c) => {
      const projectId = String(a["project_id"] ?? "") || c.env.projectId;
      const userId = String(a["user_id"] ?? "");
      if (!projectId || !userId) throw new Error("project.remove_member requires project_id and user_id");
      return spacesCall(
        c, "DELETE",
        `/spaces/${c.env.spaceId}/projects/${encodeURIComponent(projectId)}/members/${encodeURIComponent(userId)}`
      );
    },
    "agent.list": (_a, c) => spacesCall(c, "GET", `/spaces/${c.env.spaceId}/agent-definitions?space_id=${encodeURIComponent(c.env.spaceId)}`),
  },
  // See PrebuiltScript.paramHints's own doc (project-coordination.ts has the fuller story).
  paramHints: {
    "project.create": "name (string, REQUIRED). description (string, optional). visibility " +
      "(\"private\"|\"public\", optional). default_agent_id/allowed_agent_ids (optional).",
    "project.create_from_template": "template_id (string, REQUIRED — from the project-templates " +
      "catalogue). name (string, optional — a custom name instead of the template's default).",
    "project.list": "no parameters.",
    "project.configure": "project_id (string, REQUIRED — the project to change). Every other field " +
      "is a partial patch (e.g. name, description, status:\"archived\", visibility).",
    "project.list_members": "project_id (string, optional — defaults to this run's own project).",
    "project.add_member": "project_id (string, optional — defaults to this run's own project). " +
      "user_id (string, REQUIRED). role (string, optional).",
    "project.remove_member": "project_id (string, optional — defaults to this run's own project). " +
      "user_id (string, REQUIRED).",
    "agent.list": "no parameters.",
  },
};
