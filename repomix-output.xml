// workers/spaces/provisioner.ts
export async function provisionSpace(params: {
  spaceId: string; typeId: string; userId: string; name: string; env: Env;
}): Promise&lt;{ success: boolean; error?: string }&gt; {
  const { spaceId, typeId, userId, name, env } = params;
  const provisioned: string[] = [];
  try {
    // Step 1: Initialize SpaceDO — the DO itself creates the space record
    const spaceDO = env.NAELAO_SPACE_DO.get(env.NAELAO_SPACE_DO.idFromName('space:' + spaceId));
    await spaceDO.fetch(new Request('http://space/init', {
      method: 'POST',
      body: JSON.stringify({ spaceId, typeId, userId, name, manifestVersion: manifest.version })
    }));
    provisioned.push('space-do');
    // ... rest of steps
  } catch (error) {
    await deprovisionSpace({ spaceId, typeId, provisioned, env });
    return { success: false, error: (error as Error).message };
  }
}</p></div>
