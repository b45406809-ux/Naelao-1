// ── FILE EDITOR MODAL ──
function openFileEditor(name,content){
  document.getElementById('file-editor-overlay').style.display='flex';
  document.getElementById('file-editor-name').textContent=name||'untitled';
  document.getElementById('file-editor-body').value=content||'';
