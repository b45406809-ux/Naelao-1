    <h2>@naelao/agent-sdk — Complete API Reference</h2>
    <div class="bar"></div>
    <p class="lead">The Naelao Agent SDK is the npm package that developers use to build custom agents. It exposes all
      Naelao platform capabilities as typed TypeScript APIs. This section is the complete reference: every class, every
      method, every parameter, every return type.</p>

    <h3>NaelaoAgent Base Class</h3>
    <pre><code><span class="cm">// @naelao/agent-sdk — src/NaelaoAgent.ts
// Developers extend this class to build custom agents.
// All platform capabilities are accessible via this.* methods.</span>

export abstract class NaelaoAgent extends Agent&lt;Env, NaelaoAgentState&gt; {

  <span class="cm">// ── IDENTITY ─────────────────────────────────────────</span>
  readonly spaceId: string;
  readonly projectId: string | undefined;
  readonly agentId: string;

  <span class="cm">// ── SESSION MANAGEMENT (Project Think) ───────────────</span>

  <span class="cm">// Create a new conversation session</span>
  protected createSession(threadId: string): Session;

  <span class="cm">// Get an existing session by thread ID</span>
  protected getSession(threadId: string): Session | null;

  <span class="cm">// Add a message to a session</span>
  protected addMessage(sessionId: string, message: {
    role: 'user' | 'assistant' | 'tool' | 'system';
    content: string;
    parentId?: string;
    toolName?: string;
  }): string; <span class="cm">// returns messageId</span>

  <span class="cm">// Search messages via FTS5 full-text search</span>
  protected searchMessages(sessionId: string, query: string): Message[];

  <span class="cm">// Fork a session at a given message (creates parallel branch)</span>
  protected forkSession(sessionId: string, fromMessageId: string): Session;

  <span class="cm">// Compact session (summarize old messages to reduce token count)</span>
  protected compactSession(sessionId: string): Promise&lt;void&gt;;

  <span class="cm">// ── BACKGROUND EXECUTION (Project Think) ─────────────</span>

  <span class="cm">// Run a durable fiber — survives DO eviction, browser close</span>
  protected runFiber(name: string, fn: (ctx: FiberContext) =&gt; Promise&lt;void&gt;): Promise&lt;void&gt;;

  <span class="cm">// Called when a fiber is recovered after eviction</span>
  protected abstract onFiberRecovered(ctx: FiberContext): Promise&lt;void&gt;;

  <span class="cm">// Spawn a sub-agent (Facets — colocated, typed RPC)</span>
  protected spawnSubAgent&lt;T extends NaelaoAgent&gt;(
    AgentClass: new (...args: unknown[]) =&gt; T,
    name: string
  ): T;

  <span class="cm">// ── FILE OPERATIONS (R2) ─────────────────────────────</span>

  <span class="cm">// Read a file from R2 workspace</span>
  protected async readWorkspace(path: string): Promise&lt;string | null&gt;;

  <span class="cm">// Write a file to R2 workspace (with versioning)</span>
  protected async writeWorkspace(path: string, content: string, commitMsg?: string): Promise&lt;void&gt;;

  <span class="cm">// List files in R2 workspace directory</span>
  protected async listWorkspace(prefix?: string): Promise&lt;FileInfo[]&gt;;

  <span class="cm">// Delete a file from R2 workspace</span>
  protected async deleteWorkspace(path: string): Promise&lt;void&gt;;

  <span class="cm">// ── LLM CALLS (CF AI Gateway) ────────────────────────</span>

  <span class="cm">// Make a streaming LLM call with automatic billing and caching</span>
  protected async callLLM(params: {
    messages: MessageParam[];
    system?: TextBlockParam[];
    model?: string;
    maxTokens?: number;
    tools?: ToolDefinition[];
    onToken?: (delta: string) =&gt; void;
  }): Promise&lt;LLMResponse&gt;;

  <span class="cm">// ── ARTIFACTS ────────────────────────────────────────</span>

  <span class="cm">// Create a live HTML/React artifact (Dynamic Worker Loader)</span>
  protected async spinArtifact(name: string, code: string, type: 'html' | 'react' | 'chart'): Promise&lt;{ previewUrl: string; artifactId: string }&gt;;

  <span class="cm">// ── DYNAMIC WORKFLOWS ────────────────────────────────</span>

  <span class="cm">// Create and deploy an agent-authored Dynamic Workflow</span>
  protected async createWorkflow(params: {
    name: string;
    code: string;          <span class="cm">// TypeScript WorkflowEntrypoint class</span>
    schedule?: string;     <span class="cm">// cron expression for scheduled workflows</span>
    triggerType?: 'manual' | 'cron' | 'webhook';
  }): Promise&lt;{ workflowId: string; path: string }&gt;;

  <span class="cm">// Trigger a deployed workflow manually</span>
  protected async triggerWorkflow(workflowId: string, input?: unknown): Promise&lt;string&gt;; <span class="cm">// returns instanceId</span>

  <span class="cm">// ── MEMORY ───────────────────────────────────────────</span>

  <span class="cm">// Write a typed memory entry (schema-validated)</span>
  protected async rememberFact(key: string, subject: string, predicate: string, object: string): Promise&lt;void&gt;;
  protected async rememberPreference(key: string, domain: string, value: string): Promise&lt;void&gt;;
  protected async rememberTask(key: string, description: string, status: 'pending' | 'in_progress' | 'complete'): Promise&lt;void&gt;;

  <span class="cm">// Query memory entries</span>
  protected getMemory(category?: string, limit?: number): AgentMemory[];

  <span class="cm">// ── SKILLS ───────────────────────────────────────────</span>

  <span class="cm">// Execute a platform skill tool call</span>
  protected async callSkill(skillName: string, toolId: string, params: Record&lt;string, unknown&gt;): Promise&lt;ToolResult&gt;;

  <span class="cm">// Register a self-authored tool (callable in next LLM turn)</span>
  protected async registerTool(definition: {
    name: string;
    description: string;
    parameters: JSONSchema;
    implementation: string; <span class="cm">// TypeScript code</span>
  }): Promise&lt;void&gt;;

  <span class="cm">// ── ABSTRACT: Developer implements this ──────────────</span>

  <span class="cm">// Main entry point — called for every user message</span>
  abstract run(input: AgentInput): AsyncGenerator&lt;AgentEvent&gt;;
}</code></pre>

    <h3>Building a Custom Agent — Minimal Example</h3>
    <pre><code><span class="cm">// Example: A simple research agent that answers questions with citations
// Deployed to Cloudflare as a Worker, registered with Naelao marketplace</span>

import { NaelaoAgent, AgentInput, AgentEvent } from '@naelao/agent-sdk';

export class ResearchAgent extends NaelaoAgent {

  async *run(input: AgentInput): AsyncGenerator&lt;AgentEvent&gt; {
    const session = this.createSession(input.threadId);
    this.addMessage(session.id, { role: 'user', content: input.message });

    yield { type: 'thinking', content: 'Searching for information...' };

    <span class="cm">// Search the web for relevant information</span>
    const searchResult = await this.callSkill('web-search', 'search', {
      query: input.message,
      max_results: 5,
      include_answer: true
    });

    <span class="cm">// Build context with search results</span>
    const searchContext = JSON.stringify(searchResult.output);

    <span class="cm">// Call LLM with search results for grounded response</span>
    const llmResponse = await this.callLLM({
      messages: [
        { role: 'user', content: input.message }
      ],
      system: [{
        type: 'text',
        text: `You are a research assistant. Answer questions using the provided search results. Always cite your sources.

Search results:
${searchContext}`
      }],
      onToken: (delta) => {
        this.ctx.getWebSockets().forEach(ws =>
          ws.send(JSON.stringify({ type: 'token', delta }))
        );
      }
    });

    <span class="cm">// Save the response to the session</span>
    this.addMessage(session.id, {
      role: 'assistant',
      content: llmResponse.content,
      parentId: this.lastMessageId
    });

    <span class="cm">// Save any facts learned for future sessions</span>
    if (llmResponse.content.length > 100) {
      await this.rememberFact(
        `research-${Date.now()}`,
        'user inquiry',
        'asked about',
        input.message.slice(0, 200)
      );
    }

    yield { type: 'complete', content: llmResponse.content };
  }

  async onFiberRecovered(ctx: FiberContext): Promise&lt;void&gt; {
    <span class="cm">// This agent uses foreground mode only — no fiber recovery needed</span>
    <span class="cm">// For background mode, implement resumption logic here</span>
  }
}

export default ResearchAgent;</code></pre>
