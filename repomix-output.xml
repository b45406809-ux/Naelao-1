        <div class="box box-bl">
          <div class="box-lbl">Retry Backoff Strategy</div>
          <p>For errors where <code>shouldRetry: true</code>, the orchestrator uses exponential backoff with jitter:
            attempt 1 → 1s, attempt 2 → 2s, attempt 3 → 4s, max 3 retries. After the third failure, the error is
            downgraded to a non-retryable correction prompt. Rate limit errors (ERR_RATE_LIMIT) start at 5s to respect
            provider windows. LLM overload (ERR_LLM_OVERLOADED) uses the AI Gateway's built-in fallback routing first
            before invoking the retry logic.</p>
        </div>

        <h3>How the Orchestrator Uses This</h3>
        <p>Inside the Agent Loop (<code>AgentDO.run()</code>), errors caught during <code>executeTools()</code> are
          mapped through the processor before being appended to the conversation history.</p>
        <pre><code><span class="cm">// Inside agentpress/orchestrator.ts</span>

let retryCount = 0;

async function executeWithErrorHandling(toolCall: ParsedToolCall): Promise&lt;ToolResult&gt; {
  while (true) {
    try {
      const result = await dispatchTool(toolCall);
      session.add({ role: 'tool', content: result.output, toolName: toolCall.name });
      return result;
    } catch (error) {
      const processed = processAgentException(error as Error, {
        toolName: toolCall.name,
        stderr: (error as any).stderr,
        allowlist: spaceManifest.agentConfig?.networkPolicy?.allowlist
      });

      <span class="cm">// Log structured error to CF Analytics Engine</span>
      await env.ANALYTICS_QUEUE.send({
        type: 'agent_tool_error',
        errorCode: processed.code,
        category: processed.category,
        toolName: toolCall.name,
        spaceId, runId
      });

      if (processed.isFatal) {
        throw new Error(`FATAL:${processed.code}:${processed.agentMessage}`);
      }

      if (processed.shouldRetry && retryCount < 3) {
        retryCount++;
        const backoffMs = [1000, 2000, 4000][retryCount - 1];
        await new Promise(r => setTimeout(r, backoffMs));
        continue; <span class="cm">// retry the tool call</span>
      }

      <span class="cm">// Feed the correction prompt back to the LLM as a tool result</span>
      session.add({
        role: 'tool',
        content: processed.agentMessage,
        toolName: toolCall.name,
        isError: true
      });
      return { toolName: toolCall.name, output: { error: processed.agentMessage }, success: false };
    }
  }
}</code></pre>
