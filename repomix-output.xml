<file path="workers/agents/src/script-engine/conversation-context.ts">
/**
 * Conversation context — what the model actually knows about the thread it's replying in.
 *
 * The gap this closes
 * -------------------
 * The script-native reasoner's payload was rebuilt fresh on every turn from a fingerprint
 * snapshot, a candidate list, and this run's own steps. It contained NO conversation history at
 * all. So the agent could not answer "what did we decide earlier?", could not resolve "do that
 * again", and would happily re-ask something the user had already told it two messages ago. The
 * context-usage meter, meanwhile, measured the stored transcript — a transcript the model was
 * never given.
 *
 * This module is the bridge: it turns a session's stored messages into a bounded context block
 * the reasoner can carry, and it decides what to do when that history no longer fits.
 *
 * Compaction, and why the model is told about it
 * ----------------------------------------------
 * When history exceeds its budget, older messages are replaced by a summary and the context is
 * flagged `compacted: true`. Claude Code's own compaction has a well-known failure mode: after a
 * compact the assistant behaves as if anything not captured in the summary never happened, and
 * answers confidently from a partial record. That is worse than admitting the gap.
 *
 * So compaction here is explicit rather than silent. The model is told, in its instructions, that
 * (a) this history is compacted, (b) detail is therefore missing, and (c) there is a tool that
 * searches the FULL uncompacted transcript. An assumption about something not in the summary is a
 * cue to search, not to guess.
 *
 * Pure by design: no storage, no clock, no network — the budgeting and truncation edge cases are
 * where the bugs live, and they should be testable without a DO.
 */

export interface ConversationMessage {
  role: string;
  content: string;
  created_at?: string | undefined;
}

/** The bounded view of a conversation handed to the reasoner. */
export interface ConversationContext {
  /** Most recent messages, oldest first, that fit the budget. */
  recent: ConversationMessage[];
  /** Prose summary of everything older than `recent`. Empty when nothing was dropped. */
  summary: string;
  /** True when older messages were dropped — the model is told this explicitly. */
  compacted: boolean;
  /** How many messages exist in total, so "5 of 340" is expressible. */
  totalMessages: number;
  /** How many were folded away into `summary`. */
  omittedMessages: number;
}

export interface ConversationLimits {
  /** Token budget for the conversation block of the reasoner payload. */
  maxTokens: number;
  /** Never carry more than this many messages regardless of budget — a long tail of tiny
   *  messages is still noise, and each one costs structure tokens in the JSON payload. */
  maxMessages: number;
  /** Single messages longer than this are truncated rather than allowed to evict the rest of
   *  the conversation on their own. */
  maxMessageChars: number;
}

export const DEFAULT_CONVERSATION_LIMITS: ConversationLimits = {
  // Deliberately modest. The reasoner payload also carries the observation snapshot, candidate
  // scripts and this run's steps; conversation is context, not the whole budget. It is also sized
  // to stay usable on the small-context models this platform actually runs on today (a 24k-token
  // window, not a 200k one).
  maxTokens: 3000,
  maxMessages: 30,
  maxMessageChars: 2000,
};

/** Rough token estimate. chars/4 is the convention already used elsewhere in this codebase for
 *  budgeting; it is an estimate for sizing, never for billing. */
export function estimateTokens(text: string): number {
  return Math.ceil(text.length / 4);
}

function truncateMessage(m: ConversationMessage, maxChars: number): ConversationMessage {
  if (m.content.length <= maxChars) return m;
  return {
    ...m,
    // Say it was cut. A silently truncated message reads as a complete one that simply ended
    // oddly, which is exactly the kind of thing a model will confidently misinterpret.
    content: `${m.content.slice(0, maxChars)}… [truncated, ${m.content.length - maxChars} more characters — search the full history if this matters]`,
  };
}

/**
 * Select the most recent messages that fit the budget.
 *
 * Walks backwards from the newest so the recent past is always what survives — a conversation
 * where the last thing the user said got evicted would be actively harmful.
 */
export function buildConversationContext(
  messages: ConversationMessage[],
  summary = "",
  limits: ConversationLimits = DEFAULT_CONVERSATION_LIMITS
): ConversationContext {
  const all = Array.isArray(messages) ? messages.filter((m) => m && typeof m.content === "string") : [];
  const recent: ConversationMessage[] = [];
  let used = estimateTokens(summary);

  for (let i = all.length - 1; i >= 0; i--) {
    if (recent.length >= limits.maxMessages) break;
    const m = truncateMessage(all[i]!, limits.maxMessageChars);
    const cost = estimateTokens(m.content) + 8; // + rough per-message structural overhead
    if (used + cost > limits.maxTokens && recent.length > 0) break;
    recent.unshift(m);
    used += cost;
  }

  const omitted = all.length - recent.length;
  return {
    recent,
    summary: summary.trim(),
    // Compacted means "you are not seeing everything", whether or not a summary exists yet.
    compacted: omitted > 0,
    totalMessages: all.length,
    omittedMessages: omitted,
  };
}

/** Whether the conversation has grown enough that older messages should be summarised into a
 *  durable record rather than simply dropped on each turn. */
export function needsSummarization(
  messages: ConversationMessage[],
  limits: ConversationLimits = DEFAULT_CONVERSATION_LIMITS
): boolean {
  const ctx = buildConversationContext(messages, "", limits);
  return ctx.omittedMessages > 0;
}

/** The messages that fall outside the recent window — the ones a summary needs to cover. */
export function messagesToSummarize(
  messages: ConversationMessage[],
  limits: ConversationLimits = DEFAULT_CONVERSATION_LIMITS
): ConversationMessage[] {
  const ctx = buildConversationContext(messages, "", limits);
  return ctx.omittedMessages > 0 ? messages.slice(0, ctx.omittedMessages) : [];
}

/** Build the summarisation prompt. Kept here so the wording is testable and lives next to the
 *  rules it has to satisfy. */
export function buildSummaryPrompt(older: ConversationMessage[], existingSummary: string): string {
  const transcript = older
    .map((m) => `${m.role}: ${m.content.slice(0, 1500)}`)
    .join("\n");
  return [
    "You are compacting the earlier part of a conversation so an assistant can keep working.",
    "Rewrite the SUMMARY so it absorbs the OLDER MESSAGES below.",
    "",
    "Keep, above all else:",
    "- decisions made and instructions the user gave (these are commitments, not chatter)",
    "- concrete facts: names, files, amounts, dates, identifiers",
    "- anything still open or unresolved",
    "- the user's stated preferences and constraints",
    "Drop: pleasantries, repetition, and reasoning that led nowhere.",
    "Do not invent anything. Write plainly, under 300 words.",
    "",
    `SUMMARY:\n${existingSummary || "(none yet)"}`,
    "",
    `OLDER MESSAGES:\n${transcript}`,
  ].join("\n");
}

/** Render the context into the shape the reasoner payload carries. Separated from the payload
 *  builder so the "you are missing detail" framing is asserted in tests rather than buried. */
export function renderConversationForReasoner(ctx: ConversationContext): Record<string, unknown> {
  return {
    compacted: ctx.compacted,
    total_messages: ctx.totalMessages,
    omitted_messages: ctx.omittedMessages,
    ...(ctx.summary ? { earlier_summary: ctx.summary } : {}),
    recent_messages: ctx.recent.map((m) => ({ role: m.role, content: m.content })),
    ...(ctx.compacted
      ? {
          // Stated in the payload itself, not only in the system prompt: the model reads this
          // block right next to the history it is about to reason over.
          notice:
            `This conversation is COMPACTED — ${ctx.omittedMessages} earlier message(s) are not shown. ` +
            "If the user refers to something that is not in the summary or recent messages above, " +
            "do NOT guess and do NOT assume it never happened: run conversation.search to look it " +
            "up in the full transcript first.",
        }
      : {}),
  };
}
</file>

<file path="workers/agents/src/script-engine/execution-ladder.ts">
/**
 * The Execution Ladder (spec §8) — routes script.run to the right tier automatically.
 * The agent never picks a tier; it calls script.run(name, params) and the orchestrator
 * routes by the script's declared `requires_tier`.
 *
 *   Tier 1 — Direct R2 (Workspace)      ~0ms boot. File ops only. Handled in-process.
 *   Tier 2 — V8 Isolate (Dynamic Worker) TS/JS + HTTP fetch. No fs, no native bins.
 *   Tier 3 — npm (Dynamic Worker + pkg)  Tier 2 + npm package resolution.
 *   Tier 4 — Browser (CF Browser)        DOM/click/fill/screenshot via naelao-browser proxy.
 *                                        naelao-browser itself tries Kitesurf FIRST (a
 *                                        lightweight, agent-first browser Cloudflare announced
 *                                        2026-08-06 — 3-7x less CPU/memory than Chromium, ~1.7x
 *                                        slower wall time, real per @cloudflare/puppeteer 1.3.0's
 *                                        `WorkersLaunchOptions.browser: 'kitesurf'`) and falls
 *                                        back to Chromium on any failure — an internal detail of
 *                                        Tier 4, not a 6th tier, since it changes cost/reliability
 *                                        but not capability. Known Kitesurf gaps (still beta, no
 *                                        GA date): video playback, WebGL, bot-challenge/TLS-
 *                                        fingerprint handshakes, persistent authenticated
 *                                        sessions, pixel-perfect rendering — a caller that knows a
 *                                        target needs one of those can force `engine: "chromium"`.
 *   Tier 5 — Container (SandboxDO)        Full Linux, Python/bash, native bins, multi-container.
 *
 * Tiers 2-5 execute arbitrary stored code and so are delegated to an injected
 * TieredCodeRunner (the concrete mechanism — Dynamic Worker Loader, browser proxy,
 * SandboxDO — lives in the host worker, not here). Tier 1 is implemented directly because
 * it is pure R2 and must always work even with no runner wired.
 */

import type { ExecutionTier, ScriptEngineEnv, ScriptRunResult, StoredScript } from "./types.js";

/** Run a stored script (agent-distilled / authored code) at its declared tier. */
export async function runStoredScript(
  env: ScriptEngineEnv,
  script: StoredScript,
  args: Record<string, unknown>
): Promise<ScriptRunResult> {
  const tier = script.metadata.requires_tier;
  const started = Date.now();

  if (!script.code) {
    return {
      ok: false,
      error: `Script ${script.metadata.name} has no code to execute`,
      tier,
      duration_ms: Date.now() - started,
      tokens_used: 0,
    };
  }

  if (tier === 1) {
    // Tier 1 stored scripts are rare (most T1 work is a prebuilt op), but a stored T1
    // script is a pure R2 transform. We do not eval arbitrary code in the DO isolate for
    // safety; a T1 stored script must be expressed through prebuilt r2-workspace ops, so
    // reaching here means the script was mis-tiered.
    return {
      ok: false,
      error:
        `Tier 1 stored-code execution is not supported in-process; express file work as ` +
        `prebuilt r2-workspace ops or raise requires_tier to 2.`,
      tier,
      duration_ms: Date.now() - started,
      tokens_used: 0,
    };
  }

  // §A1.17 Phase J: a script tagged runtime:"workflow" dispatches to a durable CF Workflow
  // instance instead of running synchronously here — for long-running/cron automations that
  // must survive restarts or run for hours/days without holding an isolate or this DO awake.
  // Orthogonal to tier (which still governs what the eventual execution may do).
  if (script.metadata.runtime === "workflow") {
    if (!env.workflowRunner) {
      return {
        ok: false,
        error: `Script '${script.metadata.name}' is marked runtime:"workflow" but no workflow runner is wired in this environment`,
        tier,
        duration_ms: Date.now() - started,
        tokens_used: 0,
      };
    }
    try {
      const { id } = await env.workflowRunner.start({
        name: script.metadata.name,
        args,
        spaceId: env.spaceId,
        agentId: env.agentId,
        tenantId: env.tenantId,
        ...(env.projectId ? { projectId: env.projectId } : {}),
      });
      return {
        ok: true,
        output: { workflow_id: id, status: "started" },
        tier,
        duration_ms: Date.now() - started,
        tokens_used: 0,
      };
    } catch (err) {
      return {
        ok: false,
        error: err instanceof Error ? err.message : String(err),
        tier,
        duration_ms: Date.now() - started,
        tokens_used: 0,
      };
    }
  }

  // Tiers 2-5: delegate to the injected runner.
  if (!env.codeRunner) {
    return {
      ok: false,
      error: `Execution tier ${tier} is unavailable in this environment (no code runner wired)`,
      tier,
      duration_ms: Date.now() - started,
      tokens_used: 0,
    };
  }

  try {
    return await env.codeRunner.run({
      name: script.metadata.name,
      code: script.code,
      tier,
      args,
      spaceId: env.spaceId,
      agentId: env.agentId,
      tenantId: env.tenantId,
      ...(env.projectId ? { projectId: env.projectId } : {}),
      ...(script.metadata.container_image ? { containerImage: script.metadata.container_image } : {}),
    });
  } catch (err) {
    return {
      ok: false,
      error: err instanceof Error ? err.message : String(err),
      tier,
      duration_ms: Date.now() - started,
      tokens_used: 0,
    };
  }
}

/** Human-readable tier description (for logs/observability). */
export function tierLabel(tier: ExecutionTier): string {
  return (
    {
      1: "T1 direct-R2",
      2: "T2 v8-isolate",
      3: "T3 npm-isolate",
      4: "T4 browser",
      5: "T5 container",
    } as const
  )[tier];
}
</file>

<file path="workers/agents/src/script-engine/federation.ts">
/**
 * Federated template learning (A1.9 / the user's template vision).
 *
 * A template is a *living* skill library: it ships seeded skills, and as agents on that template
 * distill new working skills, the proven ones flow back up to the shared template library so
 * EVERY space on the template inherits them. The flywheel: one agent learns, everyone benefits.
 *
 *   promote(space → template)  — a proven space skill is copied up to the shared library
 *   inherit(template → space)  — a new/existing space pulls the shared library down
 *
 * Promotion is GATED: a skill must be genuinely proven on the space that derived it (high
 * stability + a track record) before it pollutes the shared library. Pure functions over two
 * SkillLibrary instances — no platform deps, unit-testable.
 */

import type { SkillLibrary } from "./skill-library.js";
import type { ScriptMetadata } from "./types.js";

/** Promotion threshold — a skill is worth sharing once it's proven (mirrors shouldPromote). */
export const PROMOTE_MIN_STABILITY = 0.8;
export const PROMOTE_MIN_SUCCESSES = 5;

export function isPromotable(m: Pick<ScriptMetadata, "stability_score" | "success_count">): boolean {
  return m.stability_score >= PROMOTE_MIN_STABILITY && m.success_count >= PROMOTE_MIN_SUCCESSES;
}

export interface PromoteResult {
  promoted: boolean;
  name: string;
  reason?: string;
  stability_score?: number;
  success_count?: number;
}

/**
 * Promote one proven skill from a space's library up to the shared template library. The promoted
 * copy is marked origin "authored" (it's now a curated template asset) and its health counters are
 * reset — the shared copy earns its own track record across the fleet.
 */
export async function promoteSkill(
  spaceLib: SkillLibrary,
  templateLib: SkillLibrary,
  name: string
): Promise<PromoteResult> {
  const stored = await spaceLib.read(name);
  if (!stored) return { promoted: false, name, reason: "not_found" };
  const m = stored.metadata;
  if (!isPromotable(m)) {
    return {
      promoted: false,
      name,
      reason: `not yet proven (needs stability ≥ ${PROMOTE_MIN_STABILITY} and ≥ ${PROMOTE_MIN_SUCCESSES} successes)`,
      stability_score: m.stability_score,
      success_count: m.success_count,
    };
  }
  const shared: ScriptMetadata = {
    ...m,
    origin: "authored",
    success_count: 0,
    failure_count: 0,
    stability_score: 0.5,
  };
  await templateLib.import(shared, stored.code, `promoted from a space (proven: stability ${m.stability_score.toFixed(2)}, ${m.success_count} successes)`);
  return { promoted: true, name, stability_score: m.stability_score, success_count: m.success_count };
}

export interface InheritResult {
  inherited: string[];
  skipped: string[];
}

/**
 * Inherit the shared template library into a space. By default only adds skills the space does not
 * already have (so a space's own learned/patched version is never clobbered). Called at
 * provisioning so a new space starts with everything the fleet has figured out.
 *
 * opts.names narrows to a specific subset (the "skills directory" add-dialog's per-skill Add
 * button) — omitted (the provisioning-time call's own usage) means "everything the space lacks",
 * unchanged from before this option existed.
 */
export async function inheritTemplateSkills(
  templateLib: SkillLibrary,
  spaceLib: SkillLibrary,
  opts: { overwrite?: boolean; names?: string[] } = {}
): Promise<InheritResult> {
  const allNames = await templateLib.list();
  const requestedNames = opts.names;
  const names = requestedNames ? allNames.filter((n) => requestedNames.includes(n)) : allNames;
  const inherited: string[] = [];
  const skipped: string[] = [];
  for (const name of names) {
    if (!opts.overwrite && (await spaceLib.exists(name))) {
      skipped.push(name);
      continue;
    }
    const stored = await templateLib.read(name);
    if (!stored) continue;
    const seed: ScriptMetadata = { ...stored.metadata, origin: "authored", success_count: 0, failure_count: 0, stability_score: 0.5 };
    await spaceLib.import(seed, stored.code, "inherited from the shared template library");
    inherited.push(name);
  }
  return { inherited, skipped };
}
