app.post('/system/circuit-breakers/reset', async (c) =&gt; {
  const { service } = await c.req.json();
  const adminEmail = c.get('adminEmail' as any);
  await c.env.NAELAO_CIRCUIT_KV.delete(`circuit:${service}`);
  await c.env.NAELAO_ANALYTICS_QUEUE.send({ type: 'circuit_breaker_reset', service, adminEmail });
  return c.json({ success: true, service, state: 'CLOSED' });
});

