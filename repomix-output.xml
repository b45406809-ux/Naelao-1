    /* ─── TEST SUITES ─────────────────────────────── */
    .ts {
      background: var(--bg2);
      border: 1px solid var(--brd);
      border-radius: 8px;
      margin: 10px 0;
      overflow: hidden;
    }

    .ts-hd {
      background: var(--bg3);
      padding: 10px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--brd);
    }

    .ts-name {
      font-family: 'DM Mono', monospace;
      font-size: 11.5px;
      color: var(--tx);
      font-weight: 500;
    }

    .ts-cnt {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      color: var(--gr);
    }

    .ts-body {
      padding: 12px 16px;
    }

    .tc {
      font-size: 12.5px;
      color: var(--dim);
      padding: 3.5px 0;
      border-bottom: 1px solid rgba(24, 46, 72, .5);
    }

    .tc:last-child {
      border-bottom: none;
    }

    .tc::before {
      content: '✓ ';
      color: var(--gr);
      font-family: 'DM Mono', monospace;
    }

    .tc.fail::before {
      content: '✗ ';
      color: var(--rd);
    }

    /* ─── PHASES ──────────────────────────────────── */
    .phases {
      display: flex;
      flex-direction: column;
      gap: 9px;
      margin: 18px 0;
    }

    .ph {
      display: grid;
      grid-template-columns: 52px 1fr 1fr;
      gap: 0;
      background: var(--bg2);
      border: 1px solid var(--brd);
      border-radius: 8px;
      overflow: hidden;
    }

    .ph-n {
      background: var(--bg3);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Fraunces', serif;
      font-size: 26px;
      font-weight: 700;
      color: var(--brd2);
      border-right: 1px solid var(--brd);
    }

    .ph-w {
      padding: 13px 16px;
      border-right: 1px solid var(--brd);
    }

    .ph-o {
      padding: 13px 16px;
    }

    .ph-name {
      font-size: 12.5px;
      font-weight: 600;
      color: var(--tx);
      margin-bottom: 3px;
    }

    .ph-desc {
      font-size: 12px;
      color: var(--mt);
      line-height: 1.52;
    }

    .ph-result {
      font-size: 12px;
      color: var(--gr);
      line-height: 1.52;
    }

    /* ─── WORKER CATALOG ──────────────────────────── */
    .wcat {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
      margin: 16px 0;
    }

    .wi {
      background: var(--bg2);
      border: 1px solid var(--brd);
      border-radius: 7px;
      padding: 14px;
    }

    .wi-name {
      font-family: 'DM Mono', monospace;
      font-size: 11.5px;
      color: var(--or);
      font-weight: 500;
      margin-bottom: 2px;
    }

    .wi-type {
      font-size: 9.5px;
      color: var(--mt);
      font-family: 'DM Mono', monospace;
      margin-bottom: 5px;
      text-transform: uppercase;
      letter-spacing: .08em;
    }

    .wi-desc {
      font-size: 12.5px;
      color: var(--mt);
      line-height: 1.55;
    }

    /* ─── MISC ────────────────────────────────────── */
    .sep {
      width: 100%;
      height: 1px;
      background: linear-gradient(to right, var(--brd2), transparent);
      margin: 80px 0;
    }

    .pull {
      font-family: 'Fraunces', serif;
      font-size: 23px;
      font-weight: 300;
      font-style: italic;
      color: var(--dim);
      border-left: 3px solid var(--or);
      padding: 6px 0 6px 24px;
      margin: 32px 0;
      line-height: 1.42;
    }

    .warn-box {
      background: rgba(239, 68, 68, .07);
      border: 1px solid rgba(239, 68, 68, .25);
      border-radius: 6px;
      padding: 14px 18px;
      margin: 16px 0;
    }

    .warn-box p {
      font-size: 13px;
      color: var(--dim);
      margin-bottom: 4px;
    }

    .warn-box p:last-child {
      margin-bottom: 0;
    }

    .warn-label {
      font-family: 'DM Mono', monospace;
      font-size: 9.5px;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: var(--rd);
      margin-bottom: 7px;
      font-weight: 500;
    }

    .info-box {
      background: rgba(59, 130, 246, .06);
      border: 1px solid rgba(59, 130, 246, .22);
      border-radius: 6px;
      padding: 14px 18px;
      margin: 16px 0;
    }

    .info-box p {
      font-size: 13px;
      color: var(--dim);
      margin-bottom: 4px;
    }

    .info-label {
      font-family: 'DM Mono', monospace;
      font-size: 9.5px;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: var(--bl);
      margin-bottom: 7px;
      font-weight: 500;
    }

    @media(max-width:760px) {

      .toc-grid,
      .g2,
      .g3,
      .g4,
      .wcat {
        grid-template-columns: 1fr;
      }

      .ph {
        grid-template-columns: 1fr;
      }

      .ph-n {
        display: none;
      }

      .sg {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

