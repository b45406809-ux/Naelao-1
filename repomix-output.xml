  ],
  mcp_configs: [
    { appId: 'stripe-payments', toolsAllowed: ['verify_payment', 'create_refund'] },
    { appId: 'email-sender',    toolsAllowed: ['send_email'] }
  ],

  resource_tier: 'isolate',  <span class="cm">// fulfillment doesn't need a container — API calls only</span>

  requires_approval_for: [
    'send_customer_email',  <span class="cm">// notify owner before emailing customers</span>
    'issue_refund'          <span class="cm">// always require approval for refunds</span>
  ],
  max_iterations: 10,        <span class="cm">// fulfillment is a short workflow — 10 iterations is plenty</span>
  timeout_ms:     60000,     <span class="cm">// 1 minute max per order</span>

  marketplace_visible:     true,
  price_usd_per_run:       null,   <span class="cm">// free platform agent</span>
