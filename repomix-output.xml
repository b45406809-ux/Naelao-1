    <span class="sec-ey">06 — Workers Space Type</span>
    <h2>Workers — Virtual Workforce Protocol</h2>
    <div class="bar"></div>
    <p class="lead">Workers are virtual employees. Not agents, not assistants — persistent virtual entities that learn,
      earn, and grow across every deployment. A Worker has a career. It can be hired by multiple companies, each
      deployment makes it smarter, and its creator earns revenue every time it is used. This is the most economically
      novel space type in Naelao.</p>

    <div class="pull">"A Worker is not a chatbot you spin up. It's a digital employee with a résumé, a salary, and a
      learning curve."</div>

    <h3>The Two-Layer Model: Definition vs Instance</h3>
    <p>Every junior developer building Workers must understand this distinction before writing a single line of code.
      Confusing Definition and Instance is the #1 architectural mistake in this space type.</p>

    <div class="g2">
      <div class="box box-pu">
        <div class="box-lbl">WorkerDefinitionDO — The Master Blueprint</div>
        <p><strong>Lives in:</strong> The Workers Space (the creator's space). One DO per Worker type.</p>
        <p><strong>Contains:</strong> Role description, skill set, personality configuration, capability model,
          aggregated federated learnings from all instances, earnings record, version history.</p>
        <p><strong>Who writes to it:</strong> Only the creator and the federated learning sync system. Company instances
          NEVER write directly to the definition.</p>
        <p><strong>DO ID:</strong> <span class="ic">idFromName(`workerdef:${workersSpaceId}:${workerId}`)</span></p>
      </div>
      <div class="box box-tl">
        <div class="box-lbl">WorkerInstanceDO — The Live Deployment</div>
        <p><strong>Lives in:</strong> The company's Space (the customer's space). One DO per company per Worker type.
        </p>
        <p><strong>Contains:</strong> Company-specific context, local task history, local memory, earnings record, sync
          log.</p>
        <p><strong>Who writes to it:</strong> The instance itself, the company, and the federated learning inbound sync.
        </p>
        <p><strong>DO ID:</strong> <span class="ic">idFromName(`workerinst:${companySpaceId}:${workerId}`)</span></p>
      </div>
    </div>

    <h3>WorkerDefinitionDO — Complete Schema and Implementation</h3>
    <pre><code><span class="cm">// durable-objects/worker-definition-do.ts
// The master blueprint for a Worker type. Lives in the creator's Workers Space.
// Creator can update the definition; all instances receive updates on next sync cycle.</span>

export class WorkerDefinitionDO extends DurableObject {
  private async initSchema() {
    this.ctx.storage.sql.exec(`
      <span class="cm">-- Core definition fields</span>
      CREATE TABLE IF NOT EXISTS definition (
        field   TEXT PRIMARY KEY,
        value   TEXT NOT NULL,
        updated_at INTEGER DEFAULT (unixepoch('now') * 1000)
      );

      <span class="cm">-- Version history (creator can push updates)</span>
      CREATE TABLE IF NOT EXISTS versions (
        version     INTEGER PRIMARY KEY AUTOINCREMENT,
        diff        TEXT NOT NULL,    <span class="cm">-- JSON diff from previous version</span>
        description TEXT,
        pushed_at   INTEGER DEFAULT (unixepoch('now') * 1000)
      );

      <span class="cm">-- Aggregated federated learnings from all instances
      -- These are SKILLS (patterns), never data (company info)</span>
      CREATE TABLE IF NOT EXISTS federated_learnings (
        id          TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
        category    TEXT NOT NULL,    <span class="cm">-- 'workflow'|'communication'|'tool_usage'|'efficiency'</span>
        learning    TEXT NOT NULL,    <span class="cm">-- JSON: the abstracted skill pattern</span>
        confidence  REAL DEFAULT 0.0, <span class="cm">-- 0.0-1.0, must reach 0.95 to be applied</span>
        source_count INTEGER DEFAULT 1, <span class="cm">-- how many instances contributed this</span>
        status      TEXT DEFAULT 'pending', <span class="cm">-- pending|approved|rejected</span>
        created_at  INTEGER DEFAULT (unixepoch('now') * 1000)
      );

      <span class="cm">-- Earnings record (creator revenue from deployments)</span>
      CREATE TABLE IF NOT EXISTS earnings (
        id          TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
        company_space_id TEXT NOT NULL,
        amount_usd  REAL NOT NULL,
        period      TEXT NOT NULL,    <span class="cm">-- YYYY-MM</span>
        recorded_at INTEGER DEFAULT (unixepoch('now') * 1000)
      );

      <span class="cm">-- Active instances (which company spaces have deployed this Worker)</span>
      CREATE TABLE IF NOT EXISTS instances (
        company_space_id TEXT PRIMARY KEY,
        deployed_at  INTEGER DEFAULT (unixepoch('now') * 1000),
        last_sync    INTEGER,
        status       TEXT DEFAULT 'active'   <span class="cm">-- active|suspended|terminated</span>
      );
    `);
  }

  <span class="cm">// Creator pushes an update to the Worker definition
  // All active instances receive the update on their next sync</span>
  async pushUpdate(update: WorkerUpdate): Promise&lt;void&gt; {
    const currentVersion = this.ctx.storage.sql
      .exec('SELECT MAX(version) as v FROM versions')
      .one()?.v as number ?? 0;

    <span class="cm">// Store the update as a diff</span>
    this.ctx.storage.sql.exec(
      'INSERT INTO versions (diff, description) VALUES (?, ?)',
      JSON.stringify(update.diff), update.description
    );

    <span class="cm">// Apply diff to current definition fields</span>
    for (const [field, value] of Object.entries(update.diff)) {
      this.ctx.storage.sql.exec(
        'INSERT OR REPLACE INTO definition (field, value, updated_at) VALUES (?, ?, ?)',
        field, JSON.stringify(value), Date.now()
      );
    }

    <span class="cm">// Notify all active instances via naelao-notifications queue
    // Instances will pick up the update on their next heartbeat</span>
    const instances = this.ctx.storage.sql
      .exec('SELECT company_space_id FROM instances WHERE status = ?', 'active')
      .toArray();

    for (const inst of instances) {
      await this.env.NAELAO_NOTIFICATIONS_QUEUE.send({
        type: 'worker_definition_update',
        workerId: this.workerId,
        version: currentVersion + 1,
        companySpaceId: inst.company_space_id as string
      });
    }
  }

  <span class="cm">// Called when a federated learning is proposed by an instance
  // CRITICAL: The LLM judge must validate this is data-free before accepting</span>
  async proposeLearning(proposal: FederatedLearningProposal): Promise&lt;boolean&gt; {
    <span class="cm">// Run LLM judge — this is NOT optional
    // If we skip this, proprietary company data can leak through skill patterns</span>
    const judgment = await this.env.NAELAO_AI_GATEWAY.messages.create({
      model: 'claude-sonnet-4-5',
      max_tokens: 200,
      messages: [{
        role: 'user',
        content: `You are a data privacy judge. Determine if this learning proposal 
contains any company-specific data (names, numbers, locations, product names, etc.).
If it contains ANY company-specific data, respond with JSON: {"safe": false, "reason": "..."}.
If it is a pure abstract skill pattern, respond with: {"safe": true, "confidence": 0.0-1.0}.

Learning proposal:
${JSON.stringify(proposal.learning)}`
      }]
    });

    const result = JSON.parse(judgment.content[0].text ?? '{"safe": false}');
    
    if (!result.safe || result.confidence &lt; 0.95) {
      <span class="cm">// Reject — log for audit but don't store the data</span>
      await this.env.NAELAO_ANALYTICS_QUEUE.send({
        type: 'federated_learning_rejected',
        workerId: this.workerId,
        reason: result.reason ?? 'Low confidence',
        proposalHash: await hashProposal(proposal) <span class="cm">// hash, not content</span>
      });
      return false;
    }

    <span class="cm">// Check if similar learning already exists (deduplication)</span>
    const existing = this.ctx.storage.sql
      .exec(
        'SELECT id, source_count FROM federated_learnings WHERE category = ? AND confidence >= 0.9',
        proposal.category
      )
      .toArray();

    if (existing.length > 0) {
      <span class="cm">// Reinforce existing learning</span>
      const existingId = existing[0].id as string;
      const newCount = (existing[0].source_count as number) + 1;
      const newConfidence = Math.min(1.0, result.confidence + (newCount * 0.05));
      
      this.ctx.storage.sql.exec(
        'UPDATE federated_learnings SET source_count = ?, confidence = ? WHERE id = ?',
        newCount, newConfidence, existingId
      );
    } else {
      <span class="cm">// New learning</span>
      this.ctx.storage.sql.exec(
        'INSERT INTO federated_learnings (category, learning, confidence, status) VALUES (?, ?, ?, ?)',
        proposal.category, JSON.stringify(proposal.learning), result.confidence,
        result.confidence >= 0.95 ? 'approved' : 'pending'
      );
    }

    return true;
  }
}</code></pre>

    <h3>WorkerInstanceDO — The Live Company Deployment</h3>
    <pre><code><span class="cm">// durable-objects/worker-instance-do.ts
// Lives in the company's Space. Handles all day-to-day work for that company.
// Syncs learnings UP to WorkerDefinitionDO, receives updates DOWN from it.</span>

export class WorkerInstanceDO extends DurableObject {
  private async initSchema() {
    this.ctx.storage.sql.exec(`
      <span class="cm">-- Local task queue (tasks assigned to this Worker)</span>
      CREATE TABLE IF NOT EXISTS tasks (
        id          TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
        assigned_by TEXT NOT NULL,    <span class="cm">-- userId who assigned the task</span>
        description TEXT NOT NULL,
        status      TEXT DEFAULT 'pending',  <span class="cm">-- pending|running|complete|failed</span>
        priority    INTEGER DEFAULT 5,
        deadline    INTEGER,          <span class="cm">-- Unix timestamp, nullable</span>
        result      TEXT,             <span class="cm">-- JSON result</span>
        created_at  INTEGER DEFAULT (unixepoch('now') * 1000),
        started_at  INTEGER,
        completed_at INTEGER
      );

      <span class="cm">-- Local memory (company-specific context)
      -- This NEVER syncs to the definition — it's company-private</span>
      CREATE TABLE IF NOT EXISTS local_memory (
        key         TEXT NOT NULL,
        category    TEXT NOT NULL,
        value       TEXT NOT NULL,    <span class="cm">-- JSON, schema-validated</span>
        updated_at  INTEGER DEFAULT (unixepoch('now') * 1000),
        PRIMARY KEY (key, category)
      );

      <span class="cm">-- Skill improvements learned at this company
      -- Candidates for federated sync — validated before upload</span>
      CREATE TABLE IF NOT EXISTS skill_candidates (
        id          TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
        category    TEXT NOT NULL,
        raw_learning TEXT NOT NULL,   <span class="cm">-- the raw pattern before anonymization</span>
        status      TEXT DEFAULT 'local', <span class="cm">-- local|proposed|accepted|rejected</span>
        created_at  INTEGER DEFAULT (unixepoch('now') * 1000)
      );

      <span class="cm">-- Earnings (what this instance has earned for the creator)</span>
      CREATE TABLE IF NOT EXISTS earnings (
        id          TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
        amount_usd  REAL NOT NULL,
        recorded_at INTEGER DEFAULT (unixepoch('now') * 1000)
      );

      <span class="cm">-- Sync log (when did we last sync with the definition)</span>
      CREATE TABLE IF NOT EXISTS sync_log (
        id          TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
        direction   TEXT NOT NULL,    <span class="cm">-- 'up' (learning) | 'down' (update)</span>
        version     INTEGER,
        status      TEXT NOT NULL,    <span class="cm">-- success|failed</span>
        synced_at   INTEGER DEFAULT (unixepoch('now') * 1000)
      );
    `);
  }

  <span class="cm">// Execute a task assigned by a company member</span>
  async executeTask(task: WorkerTask): Promise&lt;TaskResult&gt; {
    <span class="cm">// Record task in SQLite</span>
    this.ctx.storage.sql.exec(
      'INSERT INTO tasks (id, assigned_by, description, status, priority, deadline) VALUES (?, ?, ?, ?, ?, ?)',
      task.id, task.assignedBy, task.description, 'running', task.priority ?? 5, task.deadline ?? null
    );

    <span class="cm">// Build context from local memory + definition</span>
    const localMemory = this.ctx.storage.sql
      .exec('SELECT key, category, value FROM local_memory ORDER BY updated_at DESC LIMIT 50')
      .toArray();

    const definition = await this.getDefinition();
    
    <span class="cm">// Execute via AgentPress with the Worker's system prompt</span>
    const agentPress = new AgentPress(this.env, {
      spaceId: this.companySpaceId,
      systemPrompt: this.buildSystemPrompt(definition, localMemory),
      walletDO: this.env.NAELAO_WALLET_DO.get(
        this.env.NAELAO_WALLET_DO.idFromName(`wallet:${this.companySpaceId}:${this.workerId}`)
      )
    });

    try {
      const result = await agentPress.executeTask(task.description);
      
      this.ctx.storage.sql.exec(
        'UPDATE tasks SET status = ?, result = ?, completed_at = ? WHERE id = ?',
        'complete', JSON.stringify(result), Date.now(), task.id
      );

      <span class="cm">// Extract skill candidate from this task execution
      // This is what might get synced up to the definition</span>
      await this.extractSkillCandidate(task, result);

      return { success: true, result, taskId: task.id };
    } catch (error) {
      this.ctx.storage.sql.exec(
        'UPDATE tasks SET status = ?, result = ?, completed_at = ? WHERE id = ?',
        'failed', JSON.stringify({ error: (error as Error).message }), Date.now(), task.id
      );
      return { success: false, error: (error as Error).message, taskId: task.id };
    }
  }

  <span class="cm">// Extract a skill pattern from a completed task
  // CRITICAL: This must NEVER include company-specific data
  // We use an LLM to abstract the pattern, then validate it in WorkerDefinitionDO</span>
  private async extractSkillCandidate(task: WorkerTask, result: unknown): Promise&lt;void&gt; {
    const extraction = await this.env.NAELAO_AI_GATEWAY.messages.create({
      model: 'claude-haiku-4-5',
      max_tokens: 300,
      messages: [{
        role: 'user',
        content: `Extract the abstract skill pattern from this task execution.
Remove ALL company-specific information: names, products, numbers, locations, brands.
Return ONLY the general workflow pattern that could apply to any company in the same industry.

Task type: ${task.category ?? 'general'}
Execution pattern: ${JSON.stringify(result).slice(0, 500)}

Respond with JSON: {"pattern": "abstract description", "category": "workflow|communication|tool_usage|efficiency"}`
      }]
    });

    try {
      const { pattern, category } = JSON.parse(extraction.content[0].text ?? '{}');
      if (pattern && category) {
        this.ctx.storage.sql.exec(
          'INSERT INTO skill_candidates (category, raw_learning) VALUES (?, ?)',
          category, JSON.stringify({ pattern })
        );
      }
    } catch {
      <span class="cm">// Extraction failed — skip silently. Not every task yields a learnable pattern.</span>
    }
  }

  <span class="cm">// Sync learnings up to WorkerDefinitionDO
  // Run every 24 hours via heartbeat, or manually triggered</span>
  async syncLearningsUp(): Promise&lt;void&gt; {
    const candidates = this.ctx.storage.sql
      .exec("SELECT id, category, raw_learning FROM skill_candidates WHERE status = 'local'")
      .toArray();

    if (candidates.length === 0) return;

    const definitionDO = this.env.NAELAO_WORKER_DEFINITION_DO.get(
      this.env.NAELAO_WORKER_DEFINITION_DO.idFromName(
        `workerdef:${this.workersSpaceId}:${this.workerId}`
      )
    );

    for (const candidate of candidates) {
      const accepted = await definitionDO.fetch(new Request('http://definition/propose-learning', {
        method: 'POST',
        body: JSON.stringify({
          category: candidate.category,
          learning: JSON.parse(candidate.raw_learning as string)
        })
      })).then(r => r.json()) as { accepted: boolean };

      this.ctx.storage.sql.exec(
        'UPDATE skill_candidates SET status = ? WHERE id = ?',
        accepted.accepted ? 'accepted' : 'rejected', candidate.id
      );
    }

    this.ctx.storage.sql.exec(
      'INSERT INTO sync_log (direction, status) VALUES (?, ?)', 'up', 'success'
    );
  }
}</code></pre>

    <h3>WalletDO — The Economic Engine</h3>
    <p>Every Worker instance has a WalletDO. The company loads credits into it. The Worker spends autonomously within
      policy limits. The creator earns a fraction of every spend. This is the x402 protocol implemented inside Naelao's
      infrastructure.</p>
    <pre><code><span class="cm">// durable-objects/wallet-do.ts
// Critical: deductCredits() MUST be atomic.
// If you use two separate SQL statements for deduction + recording,
// a crash between them creates inconsistent state.
// Use a single SQL transaction — always.</span>

export class WalletDO extends DurableObject {
  private async initSchema() {
    this.ctx.storage.sql.exec(`
      CREATE TABLE IF NOT EXISTS wallet (
        id              TEXT PRIMARY KEY DEFAULT 'main',
        balance_usd     REAL NOT NULL DEFAULT 0.0,
        monthly_budget  REAL NOT NULL DEFAULT 100.0,
        spent_this_month REAL NOT NULL DEFAULT 0.0,
        month_start     INTEGER NOT NULL DEFAULT (unixepoch('now') * 1000)
      );

      CREATE TABLE IF NOT EXISTS transactions (
        id          TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
        type        TEXT NOT NULL,    <span class="cm">-- 'credit'|'debit'|'fee'</span>
        amount_usd  REAL NOT NULL,
        description TEXT NOT NULL,
        vendor      TEXT,             <span class="cm">-- who received the payment</span>
        balance_after REAL NOT NULL,
        created_at  INTEGER DEFAULT (unixepoch('now') * 1000)
      );

      CREATE TABLE IF NOT EXISTS policy (
        key   TEXT PRIMARY KEY,
        value TEXT NOT NULL
      );

      <span class="cm">-- Default policy: conservative limits</span>
      INSERT OR IGNORE INTO policy VALUES ('max_single_spend', '10.0');
      INSERT OR IGNORE INTO policy VALUES ('vendor_whitelist', '[]');
      INSERT OR IGNORE INTO policy VALUES ('category_caps', '{}');
      INSERT OR IGNORE INTO wallet (id, balance_usd) VALUES ('main', 0.0);
    `);
  }

  <span class="cm">// ATOMIC credit deduction — this is the most important method in WalletDO
  // DO NOT split into two queries. DO NOT add any await between the check and debit.</span>
  async deductCredits(params: {
    amount: number;
    description: string;
    vendor: string;
    category: string;
  }): Promise&lt;DeductResult&gt; {
    
    <span class="cm">// DurableObjects are single-threaded — no concurrent calls possible here.
    // This is why DO is the right primitive for a wallet: no race conditions by design.
    // In a regular database, this would need a SELECT FOR UPDATE. Here, we don't.</span>
    
    const wallet = this.ctx.storage.sql
      .exec('SELECT * FROM wallet WHERE id = ?', 'main')
      .one() as WalletRow;

    <span class="cm">// Policy check 1: max single spend</span>
    const maxSingle = parseFloat(this.ctx.storage.sql
      .exec("SELECT value FROM policy WHERE key = 'max_single_spend'")
      .one()?.value as string ?? '10.0');
    
    if (params.amount > maxSingle) {
      return { success: false, reason: `Exceeds max single spend of $${maxSingle}` };
    }

    <span class="cm">// Policy check 2: monthly budget</span>
    const monthStart = wallet.month_start as number;
    const now = Date.now();
    const isNewMonth = now - monthStart > 30 * 24 * 60 * 60 * 1000;
    
    const spentThisMonth = isNewMonth ? 0 : (wallet.spent_this_month as number);
    if (spentThisMonth + params.amount > (wallet.monthly_budget as number)) {
      return { success: false, reason: 'Monthly budget exceeded' };
    }

    <span class="cm">// Policy check 3: vendor whitelist (if set)</span>
    const whitelist = JSON.parse(this.ctx.storage.sql
      .exec("SELECT value FROM policy WHERE key = 'vendor_whitelist'")
      .one()?.value as string ?? '[]') as string[];
    
    if (whitelist.length > 0 && !whitelist.includes(params.vendor)) {
      return { success: false, reason: `Vendor '${params.vendor}' not in whitelist` };
    }

    <span class="cm">// All checks passed — perform atomic deduction
    // SQLite transaction inside DO — guaranteed atomic</span>
    const newBalance = (wallet.balance_usd as number) - params.amount;
    const newSpent = spentThisMonth + params.amount;
    
    this.ctx.storage.sql.exec(
      `UPDATE wallet SET 
        balance_usd = ?, 
        spent_this_month = ?,
        month_start = ?
       WHERE id = 'main'`,
      newBalance, newSpent, isNewMonth ? now : monthStart
    );

    this.ctx.storage.sql.exec(
      `INSERT INTO transactions (type, amount_usd, description, vendor, balance_after)
       VALUES ('debit', ?, ?, ?, ?)`,
      params.amount, params.description, params.vendor, newBalance
    );

    <span class="cm">// Creator earns 15% of every Worker spend (platform fee structure)
    // Send earnings to WorkerDefinitionDO — fire and forget</span>
    void this.recordCreatorEarning(params.amount * 0.15);

    return { success: true, newBalance, transactionId: crypto.randomUUID() };
  }
}</code></pre>

