```typescript
get r2BasePath(): string {
  return this.isSharedMode
    // Shared mode: userId is ALWAYS in the path, never omitted
    ? `spaces/${this.spaceId}/shared-assistant/${this.currentUserId}/`
    // Per-user mode: DO is already scoped to one user
    : `spaces/${this.spaceId}/assistants/${this.userId}/`;
