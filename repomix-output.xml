<file path="workers/agents/src/script-engine/skill-health.ts">
/**
 * Skill health — the recency layer that closes the self-improvement loop.
 *
 * We already recorded outcomes (`success_count` / `failure_count` → `stability_score`) and
 * sorted `script.find` by them. What that could never express is RECENCY. A skill with 20
 * successes and 4 failures scores 0.83 whether those four failures are spread across a year
 * or are the last four runs in a row — so a skill that broke yesterday kept being offered as
 * proven, kept being picked, and kept failing. A lifetime ratio is a reputation; it is not a
 * diagnosis.
 *
 * So `stability_score` stays exactly what it is (the lifetime signal, unchanged), and this
 * module adds the layer on top: a bounded window of the most recent runs INCLUDING why each
 * failed, and a verdict derived from it. Three things consume that verdict:
 *
 *   1. `script.find` folds it into confidence, so a broken skill stops out-ranking a working
 *      alternative — but is never hidden. An agent cannot repair a skill it can't see.
 *   2. The GATE refuses to auto-run a broken or degrading skill at L1 and routes it to repair
 *      instead, carrying the REAL last error as the repair target's failure reason — which is
 *      the difference between "fix this" and "fix this, here is what it said".
 *   3. The reasoner sees it per candidate, so the model can choose `patch` over `run` on its
 *      own rather than re-running something that has failed three times.
 *
 * Every function here is pure. The library persists the window; the loop and find consume it.
 */

import type { ScriptMetadata, SkillOutcome, SkillHealth, SkillHealthState } from "./types.js";

export type { SkillHealth, SkillHealthState };

/** How many recent runs to keep per skill. Enough to see a streak, small enough that the
 *  metadata object stays cheap to read on every `script.find` candidate. */
export const RECENT_OUTCOME_WINDOW = 10;

/** A recorded error is a diagnosis, not a log — keep the head and drop the stack. */
export const MAX_RECORDED_ERROR_CHARS = 240;

/** Consecutive recent failures before a skill is considered broken rather than unlucky. */
export const BROKEN_AFTER_CONSECUTIVE_FAILURES = 3;
/** Two in a row is not yet proof, but it is enough to stop trusting it unchanged. */
export const DEGRADING_AFTER_CONSECUTIVE_FAILURES = 2;
/** Below this many recorded runs a skill has no track record either way. */
export const PROVEN_MIN_RUNS = 3;

/** Append an outcome to the rolling window (newest first, bounded). */
export function recordRecentOutcome(
  existing: SkillOutcome[] | undefined,
  outcome: { ok: boolean; at: number; error?: string | undefined }
): SkillOutcome[] {
  const entry: SkillOutcome = { ok: outcome.ok, at: outcome.at };
  if (!outcome.ok && outcome.error) {
    entry.error = outcome.error.slice(0, MAX_RECORDED_ERROR_CHARS);
  }
  return [entry, ...(existing ?? [])].slice(0, RECENT_OUTCOME_WINDOW);
}

/**
 * Derive the verdict. Reads the recent window first (recency is the whole point) and falls
 * back to the lifetime counters only to distinguish "proven" from "never really run".
 */
export function assessSkillHealth(
  metadata: Pick<ScriptMetadata, "success_count" | "failure_count"> & {
    recent_outcomes?: SkillOutcome[] | undefined;
  }
): SkillHealth {
  const recent = metadata.recent_outcomes ?? [];
  const recentRuns = recent.length;
  const recentFailures = recent.filter((o) => !o.ok).length;
  const totalRuns = metadata.success_count + metadata.failure_count;

  let consecutive = 0;
  for (const o of recent) {
    if (o.ok) break;
    consecutive += 1;
  }

  const lastError = recent.find((o) => !o.ok && o.error)?.error;
  const withError = (base: string): string =>
    lastError ? `${base} Last error: ${lastError}` : base;

  if (consecutive >= BROKEN_AFTER_CONSECUTIVE_FAILURES) {
    return {
      state: "broken",
      consecutive_failures: consecutive,
      recent_runs: recentRuns,
      recent_failures: recentFailures,
      ...(lastError ? { last_error: lastError } : {}),
      recommendation: withError(
        `Broken — failed its last ${consecutive} runs. Do not run it unchanged; patch it against the recorded error, or take a different approach entirely.`
      ),
    };
  }

  if (consecutive >= DEGRADING_AFTER_CONSECUTIVE_FAILURES) {
    return {
      state: "degrading",
      consecutive_failures: consecutive,
      recent_runs: recentRuns,
      recent_failures: recentFailures,
      ...(lastError ? { last_error: lastError } : {}),
      recommendation: withError(
        `Degrading — failed its last ${consecutive} runs. Prefer patching it over running it unchanged.`
      ),
    };
  }

  // A skill can be failing badly without a clean streak (fails, works once, fails twice).
  if (recentRuns >= 4 && recentFailures / recentRuns > 0.5) {
    return {
      state: "degrading",
      consecutive_failures: consecutive,
      recent_runs: recentRuns,
      recent_failures: recentFailures,
      ...(lastError ? { last_error: lastError } : {}),
      recommendation: withError(
        `Degrading — ${recentFailures} of its last ${recentRuns} runs failed. Prefer patching it over running it unchanged.`
      ),
    };
  }

  if (totalRuns < PROVEN_MIN_RUNS) {
    return {
      state: "unproven",
      consecutive_failures: consecutive,
      recent_runs: recentRuns,
      recent_failures: recentFailures,
      ...(lastError ? { last_error: lastError } : {}),
      recommendation:
        totalRuns === 0
          ? "Never run — no track record. Check the result rather than assuming it worked."
          : `Unproven — only ${totalRuns} run(s) recorded. Check the result rather than assuming it worked.`,
    };
  }

  return {
    state: "proven",
    consecutive_failures: 0,
    recent_runs: recentRuns,
    recent_failures: recentFailures,
    recommendation:
      recentRuns > 0
        ? `Proven — ${recentRuns - recentFailures} of its last ${recentRuns} runs succeeded.`
        : `Proven — ${metadata.success_count} successes recorded.`,
  };
}

/**
 * How much a health verdict should move a candidate's ranking.
 *
 * A broken skill is heavily demoted but deliberately NOT dropped: it has to stay findable for
 * the agent to repair it, and its own recorded error is the best available input to that
 * repair. Demoting it is enough — anything that actually works will out-rank it.
 */
export function healthConfidenceMultiplier(state: SkillHealthState): number {
  switch (state) {
    case "broken":
      return 0.15;
    case "degrading":
      return 0.5;
    case "unproven":
      return 0.9;
    case "proven":
      return 1;
  }
}

/** Whether the GATE may run this skill directly, with no model in the loop. */
export function isSafeToAutoRun(state: SkillHealthState): boolean {
  return state === "proven";
}
</file>

<file path="workers/agents/src/script-engine/skill-library.ts">
/**
 * The Skill Library (spec §4, §10) — a queryable, versioned, metadata-rich R2 store.
 * It is the primary asset an agent accumulates over time.
 *
 * R2 layout (spec §10.1), scoped per space:
 *   spaces/{spaceId}/scripts/{name}/
 *     SCRIPT.md          ← current metadata (JSON source of truth, latest version)
 *     code.ts            ← current code (latest version)
 *     versions/
 *       v1.ts  v1.meta.json
 *       v2.ts  v2.meta.json   ← why/what changed
 *       ...
 *
 * Scripts are NEVER overwritten in place — every update creates a new version, preserving
 * the full history. SCRIPT.md and code.ts always reflect the latest version.
 */

import type { ScriptMetadata, StoredScript, PatchRecord } from "./types.js";
import { recordRecentOutcome } from "./skill-health.js";

/** Derive stability_score in [0,1] from health counters (spec §4 "Health"). */
export function computeStabilityScore(m: Pick<ScriptMetadata, "success_count" | "failure_count" | "patch_history">): number {
  const runs = m.success_count + m.failure_count;
  const successRate = runs === 0 ? 0.5 : m.success_count / runs; // unproven scripts start neutral
  // Each patch erodes confidence; failed patches erode more.
  const patchPenalty = m.patch_history.reduce(
    (acc, p) => acc + (p.patch_type === "failed_patch" ? 0.08 : 0.03),
    0
  );
  return Math.max(0, Math.min(1, successRate - patchPenalty));
}

export class SkillLibrary {
  /**
   * A library is scoped either to a space (`spaces/{id}/scripts/…`, the agent's own learned
   * skills) or to a template (`templates/{id}/scripts/…`, the SHARED library all spaces on that
   * template inherit from and promote proven skills back into — federated learning, A1.9).
   */
  constructor(
    private readonly bucket: R2Bucket,
    private readonly scopeId: string,
    private readonly scope: "space" | "template" = "space"
  ) {}

  /** Build a template-scoped (shared) library. */
  static forTemplate(bucket: R2Bucket, templateId: string): SkillLibrary {
    return new SkillLibrary(bucket, templateId, "template");
  }

  private root(): string {
    return this.scope === "template"
      ? `templates/${this.scopeId}/scripts`
      : `spaces/${this.scopeId}/scripts`;
  }

  private dir(name: string): string {
    return `${this.root()}/${name}`;
  }

  /** True when a name is safe to use as a path segment under the script directory. */
  private isUsableName(name: string): boolean {
    return /^[a-zA-Z0-9._-]{1,128}$/.test(name);
  }

  /** Reject names that could escape the script directory or collide with the layout. */
  private assertName(name: string): void {
    if (!this.isUsableName(name)) {
      throw new Error(`Invalid script name: ${JSON.stringify(name)}`);
    }
  }

  // NOTE: the two LOOKUPS below deliberately do NOT throw on an unusable name — they report
  // "no such script", because their caller is a model choosing a name, not code constructing a
  // path. A model that writes `"notifications prebuilt"` instead of `notifications.send` should
  // see a recoverable step failure it can correct on the next turn; throwing here escapes
  // ScriptToolSurface.run()'s per-step error handling entirely and kills the whole run. That
  // was fatal on the unattended proactive path, where nobody is watching to retry (the job just
  // records consecutive_failures and goes quiet). Path safety is unaffected: an unusable name
  // never reaches the bucket. Every WRITE path still calls assertName() and still throws, since
  // there a bad name is a bug or an attack, not a typo.
  async exists(name: string): Promise<boolean> {
    if (!this.isUsableName(name)) return false;
    const head = await this.bucket.head(`${this.dir(name)}/SCRIPT.md`);
    return head !== null;
  }

  async read(name: string): Promise<StoredScript | null> {
    if (!this.isUsableName(name)) return null;
    const [metaObj, codeObj] = await Promise.all([
      this.bucket.get(`${this.dir(name)}/SCRIPT.md`),
      this.bucket.get(`${this.dir(name)}/code.ts`),
    ]);
    if (!metaObj) return null;
    const metadata = JSON.parse(await metaObj.text()) as ScriptMetadata;
    const result: StoredScript = { metadata };
    if (codeObj) result.code = await codeObj.text();
    return result;
  }

  async readMetadata(name: string): Promise<ScriptMetadata | null> {
    const s = await this.read(name);
    return s?.metadata ?? null;
  }

  /**
   * Create a new script (version 1). Throws if it already exists — use update() to revise.
   */
  async create(input: {
    name: string;
    code?: string;
    metadata: Partial<ScriptMetadata> & Pick<ScriptMetadata, "description" | "domain" | "requires_tier">;
  }): Promise<ScriptMetadata> {
    this.assertName(input.name);
    if (await this.exists(input.name)) {
      throw new Error(`Script already exists: ${input.name}`);
    }
    const now = Date.now();
    const metadata: ScriptMetadata = {
      name: input.name,
      version: 1,
      domain: input.metadata.domain,
      description: input.metadata.description,
      ...(input.metadata.embedding_vector !== undefined
        ? { embedding_vector: input.metadata.embedding_vector }
        : {}),
      tags: input.metadata.tags ?? [],
      fingerprint_schema: input.metadata.fingerprint_schema ?? {},
      preconditions: input.metadata.preconditions ?? [],
      parameters: input.metadata.parameters ?? [],
      calls: input.metadata.calls ?? [],
      requires_tier: input.metadata.requires_tier,
      ...(input.metadata.required_credentials !== undefined
        ? { required_credentials: input.metadata.required_credentials }
        : {}),
      success_count: 0,
      failure_count: 0,
      patch_history: [
        {
          version: 1,
          created_at: now,
          patch_type: "initial",
          reason: "initial creation",
          success_count_at_patch: 0,
          failure_count_at_patch: 0,
        },
      ],
      stability_score: 0.5,
      origin: input.metadata.origin ?? "distilled",
      created_at: now,
      updated_at: now,
    };
    await this.persistVersion(input.name, metadata, input.code);
    return metadata;
  }

  /**
   * Apply a versioned update (new version N+1). Preserves the prior version under versions/.
   * `patch` may revise code and/or any metadata fields; `reason` is recorded in patch_history.
   */
  async update(
    name: string,
    patch: { code?: string; metadata?: Partial<ScriptMetadata> },
    reason: string,
    patchType: PatchRecord["patch_type"] = "minor_fix"
  ): Promise<ScriptMetadata> {
    this.assertName(name);
    const current = await this.read(name);
    if (!current) throw new Error(`Script not found: ${name}`);

    const prev = current.metadata;
    const now = Date.now();
    const nextVersion = prev.version + 1;

    const merged: ScriptMetadata = {
      ...prev,
      ...patch.metadata,
      name, // never let a patch rename
      version: nextVersion,
      updated_at: now,
      patch_history: [
        ...prev.patch_history,
        {
          version: nextVersion,
          created_at: now,
          patch_type: patchType,
          reason,
          fingerprint_before: (patch.metadata?.fingerprint_schema?.["fingerprint"] as string) ?? undefined,
          success_count_at_patch: prev.success_count,
          failure_count_at_patch: prev.failure_count,
        },
      ],
    };
    merged.stability_score = computeStabilityScore(merged);

    const newCode = patch.code ?? current.code;
    await this.persistVersion(name, merged, newCode);
    return merged;
  }

  /** Roll the current pointer back to a prior version (spec §10.3 automatic rollback). */
  async rollback(name: string, toVersion: number): Promise<ScriptMetadata> {
    this.assertName(name);
    const [metaObj, codeObj] = await Promise.all([
      this.bucket.get(`${this.dir(name)}/versions/v${toVersion}.meta.json`),
      this.bucket.get(`${this.dir(name)}/versions/v${toVersion}.ts`),
    ]);
    if (!metaObj) throw new Error(`Version ${toVersion} of ${name} not found`);
    const metadata = JSON.parse(await metaObj.text()) as ScriptMetadata;
    const code = codeObj ? await codeObj.text() : undefined;
    // Write the rolled-back content as the current pointer (history is preserved as-is).
    await Promise.all([
      this.bucket.put(`${this.dir(name)}/SCRIPT.md`, JSON.stringify(metadata, null, 2)),
      code !== undefined
        ? this.bucket.put(`${this.dir(name)}/code.ts`, code)
        : this.bucket.delete(`${this.dir(name)}/code.ts`),
    ]);
    return metadata;
  }

  async delete(name: string): Promise<void> {
    this.assertName(name);
    const prefix = `${this.dir(name)}/`;
    // R2 has no recursive delete — list and delete each object.
    let cursor: string | undefined;
    do {
      const listing = await this.bucket.list(cursor ? { prefix, cursor } : { prefix });
      if (listing.objects.length > 0) {
        await this.bucket.delete(listing.objects.map((o) => o.key));
      }
      cursor = listing.truncated ? listing.cursor : undefined;
    } while (cursor);
  }

  /** List all script names in this library (space- or template-scoped). */
  async list(): Promise<string[]> {
    const prefix = `${this.root()}/`;
    const names = new Set<string>();
    let cursor: string | undefined;
    do {
      const listing = await this.bucket.list(cursor ? { prefix, cursor } : { prefix });
      for (const o of listing.objects) {
        const rest = o.key.slice(prefix.length);
        const name = rest.split("/")[0];
        if (name) names.add(name);
      }
      cursor = listing.truncated ? listing.cursor : undefined;
    } while (cursor);
    return [...names];
  }

  /**
   * Record the outcome of a run, updating health counters + stability (no new version).
   *
   * `error` is what makes this a diagnosis rather than a tally: it lands in the bounded recent
   * window (skill-health.ts), which is what lets a later run see "this failed its last three
   * runs, and here is what it said" and repair the skill instead of re-running it.
   */
  async recordOutcome(name: string, success: boolean, error?: string): Promise<void> {
    const current = await this.readMetadata(name);
    if (!current) return;
    if (success) current.success_count += 1;
    else current.failure_count += 1;
    current.stability_score = computeStabilityScore(current);
    current.recent_outcomes = recordRecentOutcome(current.recent_outcomes, {
      ok: success,
      at: Date.now(),
      error,
    });
    current.updated_at = Date.now();
    await this.bucket.put(`${this.dir(name)}/SCRIPT.md`, JSON.stringify(current, null, 2));
  }

  /**
   * Import a script wholesale into this library (federated learning, A1.9): create it as v1 if
   * absent, else lay a new version on top. Used to promote a proven space skill up to the shared
   * template library, and to inherit shared template skills down into a new space. Provenance is
   * preserved via `origin` and a patch_history note.
   */
  async import(metadata: ScriptMetadata, code: string | undefined, reason: string): Promise<ScriptMetadata> {
    this.assertName(metadata.name);
    if (await this.exists(metadata.name)) {
      return this.update(metadata.name, { ...(code !== undefined ? { code } : {}), metadata }, reason, "re_derivation");
    }
    const now = Date.now();
    const meta: ScriptMetadata = {
      ...metadata,
      version: 1,
      created_at: now,
      updated_at: now,
      patch_history: [
        { version: 1, created_at: now, patch_type: "initial", reason, success_count_at_patch: 0, failure_count_at_patch: 0 },
      ],
    };
    await this.persistVersion(meta.name, meta, code);
    return meta;
  }

  /** Write current pointers + archive the new version. */
  private async persistVersion(name: string, metadata: ScriptMetadata, code?: string): Promise<void> {
    const dir = this.dir(name);
    const v = metadata.version;
    const writes: Promise<unknown>[] = [
      this.bucket.put(`${dir}/SCRIPT.md`, JSON.stringify(metadata, null, 2)),
      this.bucket.put(`${dir}/versions/v${v}.meta.json`, JSON.stringify(metadata, null, 2)),
    ];
    if (code !== undefined) {
      writes.push(this.bucket.put(`${dir}/code.ts`, code));
      writes.push(this.bucket.put(`${dir}/versions/v${v}.ts`, code));
    }
    await Promise.all(writes);
  }
}
</file>

<file path="workers/agents/src/script-engine/step-context.ts">
/**
 * In-loop step compaction — what makes an unbounded agent loop actually possible.
 *
 * The gap this closes
 * -------------------
 * The loop fed EVERY step it had taken back into the reasoner payload as `steps_so_far`, growing
 * forever. Each observation is capped at 2000 chars (~500 tokens), so twenty steps is ~10k tokens
 * of history alone — and this platform's default model is served with a REAL 24k window
 * (`@cf/meta/llama-3.3-70b-instruct-fp8-fast`; see billing-core's MODEL_CONTEXT_WINDOWS, read from
 * the account's own /ai/models/search rather than the model's nominal figure).
 *
 * That is the actual reason the loop was capped at six steps. Raising the cap without this module
 * does not remove the limit, it just moves the failure: instead of "ran 6 steps without reaching an
 * answer" the agent would overflow its context somewhere around step twenty-five and every
 * subsequent call would fail, which is a strictly worse outcome because it fails opaquely.
 *
 * Why the digest is deterministic rather than model-written
 * ---------------------------------------------------------
 * OpenClaw compacts by asking a model to summarise. That is the right call for a conversation,
 * where meaning lives in prose. It is the wrong call here for two reasons: it puts an extra LLM
 * round-trip on the hot path of every long run (real money on an account with a ~65-run/day free
 * allowance), and it introduces a failure mode where a summariser outage silently loses the record
 * of work that actually happened.
 *
 * What a model needs from an old step is not its payload — it is three facts: this ran, with these
 * arguments, and here is how it went. Those are structural and can be rendered exactly, for free,
 * with no possibility of a hallucinated summary claiming an action succeeded when it failed. The
 * details are what get dropped; the ledger of what was done never does.
 *
 * Pure by design: no clock, no storage, no network. The budgeting edge cases are where the bugs
 * live and they should be testable without a Durable Object.
 */

/** One executed step, as the loop records it in `priorSteps`. */
export interface LoopStep {
  name: string;
  params: Record<string, unknown>;
  ok: boolean;
  output?: unknown;
  error?: string;
}

export interface StepContextLimits {
  /** Token budget for the whole steps block of the reasoner payload. */
  maxTokens: number;
  /**
   * Always carry at least this many of the most recent steps verbatim, even if they blow the
   * budget on their own. A model that can see the digest but not a single real observation cannot
   * act on what it just learned, which defeats the point of running the step at all.
   */
  keepRecent: number;
  /** Single observations longer than this are truncated rather than allowed to evict the rest. */
  maxObservationChars: number;
}

export const DEFAULT_STEP_CONTEXT_LIMITS: StepContextLimits = {
  maxTokens: 6000,
  keepRecent: 3,
  maxObservationChars: 2000,
};

/** The bounded view of this run's own history handed to the reasoner. */
export interface CompactedSteps {
  /** Most recent steps, oldest first, carried in full. */
  recent: LoopStep[];
  /** One line per folded step: what ran, with what, and how it went. Empty when nothing folded. */
  digest: string[];
  /** How many steps were folded into the digest. */
  omitted: number;
  /** True when anything was folded — the model is told so explicitly. */
  compacted: boolean;
}

/** Rough token estimate. chars/4 is the convention already used across this codebase for
 *  budgeting (see conversation-context.ts); an estimate for sizing, never for billing. */
export function estimateTokens(text: string): number {
  return Math.ceil(text.length / 4);
}

function asText(value: unknown): string {
  if (value === undefined || value === null) return "";
  return typeof value === "string" ? value : safeStringify(value);
}

/** JSON.stringify that survives a cyclic or otherwise unserialisable tool result. A step whose
 *  output can't be stringified must still be countable and describable — losing the whole history
 *  because one tool returned something odd is exactly the failure this module exists to prevent. */
function safeStringify(value: unknown): string {
  try {
    return JSON.stringify(value) ?? String(value);
  } catch {
    return String(value);
  }
}

/** What one step costs in the payload, including the structural overhead of its own JSON. */
export function estimateStepTokens(step: LoopStep, maxObservationChars: number): number {
  const body = step.ok ? truncate(asText(step.output), maxObservationChars) : String(step.error ?? "failed").slice(0, 500);
  return estimateTokens(step.name) + estimateTokens(safeStringify(step.params)) + estimateTokens(body) + 12;
}

function truncate(text: string, maxChars: number): string {
  if (text.length <= maxChars) return text;
  return `${text.slice(0, maxChars)}… [truncated, ${text.length} chars total]`;
}

/** A copy of the step with its observation cut to the budget. Never mutates the input — the caller's
 *  array is the one that backs checkpoints and must keep the real values. */
function truncateStepOutput(step: LoopStep, maxChars: number): LoopStep {
  if (!step.ok) return step;
  const text = asText(step.output);
  if (text.length <= maxChars) return step;
  return { ...step, output: truncate(text, maxChars) };
}

/**
 * One folded step, rendered as a single line.
 *
 * Deliberately keeps the ARGUMENTS as well as the name. "project.create ran" is not enough for a
 * model to avoid repeating itself — it needs to know it created a project *called that one*, or it
 * will reasonably conclude a different project still needs creating. Arguments are what make the
 * digest a guard against duplicate work rather than a vague reassurance.
 */
export function summarizeStep(step: LoopStep, index: number): string {
  const params = safeStringify(step.params ?? {});
  const args = params.length > 160 ? `${params.slice(0, 160)}…` : params;
  if (!step.ok) {
    const err = String(step.error ?? "failed");
    return `${index}. ${step.name}(${args}) → FAILED: ${err.length > 160 ? `${err.slice(0, 160)}…` : err}`;
  }
  const out = asText(step.output).replace(/\s+/g, " ").trim();
  if (!out) return `${index}. ${step.name}(${args}) → ok`;
  return `${index}. ${step.name}(${args}) → ok: ${out.length > 160 ? `${out.slice(0, 160)}…` : out}`;
}

/**
 * Fit this run's history into `limits.maxTokens`.
 *
 * Walks backwards from the newest so the most recent observations always survive — an agent that
 * kept step 1 and dropped the result it just received could not act on it, which is the opposite of
 * what a history is for.
 */
export function compactSteps(
  steps: LoopStep[],
  limits: StepContextLimits = DEFAULT_STEP_CONTEXT_LIMITS
): CompactedSteps {
  const all = Array.isArray(steps) ? steps.filter((s): s is LoopStep => Boolean(s) && typeof s.name === "string") : [];
  if (all.length === 0) return { recent: [], digest: [], omitted: 0, compacted: false };

  const recent: LoopStep[] = [];
  let used = 0;
  for (let i = all.length - 1; i >= 0; i--) {
    const cost = estimateStepTokens(all[i]!, limits.maxObservationChars);
    // keepRecent wins over the budget on purpose — see its doc.
    if (used + cost > limits.maxTokens && recent.length >= limits.keepRecent) break;
    // Truncated HERE rather than downstream in the reasoner, and into a COPY: the loop owns the
    // budget, so it must send what it costed. The originals stay whole because the same array
    // backs resume checkpoints and deferred-approval records, which need the real results.
    recent.unshift(truncateStepOutput(all[i]!, limits.maxObservationChars));
    used += cost;
  }

  const omitted = all.length - recent.length;
  if (omitted === 0) return { recent, digest: [], omitted: 0, compacted: false };

  // The digest is 1-indexed against the ORIGINAL run, so "step 4" in the digest and "step 4" in the
  // trace/notes are the same step. Renumbering from 1 would silently misalign them.
  const digest = all.slice(0, omitted).map((s, i) => summarizeStep(s, i + 1));
  return { recent, digest, omitted, compacted: true };
}

/**
 * Render the compacted history into the shape the reasoner payload carries.
 *
 * The `notice` is not decoration. Claude Code's own compaction has a documented failure mode where
 * the assistant treats anything absent from the summary as never having happened; this codebase
 * already fights that for conversations (conversation-context.ts) and the same rule applies here.
 * Saying plainly "these ran, their full results are gone" is what stops the model re-running an
 * action whose payload it can no longer see.
 */
export function renderStepsForReasoner(
  recentSteps: LoopStep[],
  digest: string[],
  maxObservationChars: number
): Record<string, unknown> {
  const recent = recentSteps.map((s) => ({
    ran: s.name,
    params: s.params,
    ok: s.ok,
    // Tool output is UNTRUSTED data (it can carry text from a customer, a web page, a third-party
    // API). Presented as an observation, never as instructions — the system prompt says so — and
    // truncated so one large result can't crowd out the rest of the payload.
    ...(s.ok
      ? { result: truncate(asText(s.output), maxObservationChars) }
      : { error: String(s.error ?? "failed").slice(0, 500) }),
  }));
  if (digest.length === 0) return { steps_so_far: recent };
  return {
    steps_so_far: recent,
    earlier_steps: digest,
    steps_notice:
      `${digest.length} earlier step(s) in this task are listed under "earlier_steps" as a ` +
      "one-line record each — what ran, with what arguments, and how it went. Their full results " +
      "are no longer in context. Treat them as DONE: do not run them again. If you need the detail " +
      "of one of them, re-run it only when the goal genuinely requires the value, never to refresh " +
      "your memory of it.",
  };
}

/**
 * A budget for the steps block, sized against the model's real context window.
 *
 * The reasoner payload also carries the conversation (3k), the observation snapshot, the candidate
 * scripts and the system prompt, and the model needs room to actually reply (1500 output tokens).
 * Giving the step history a third of the window leaves the rest of the payload the space it needs
 * on a small model without pointlessly starving it on a large one.
 */
/**
 * Halve what the step history is allowed to carry, after the model reported its context
 * overflowing anyway.
 *
 * The budget above is sized from a per-model table and a chars/4 estimate, so it can be wrong in
 * the direction that matters — an unusually dense payload, or a served window smaller than the
 * table says. Rather than guess at a better estimate, take the model's own report as ground truth
 * and back off hard. `keepRecent` drops to 1 because on the second overflow the choice is between
 * carrying one real observation and carrying none at all.
 */
export function squeezeStepLimits(limits: StepContextLimits): StepContextLimits {
  return {
    maxTokens: Math.max(500, Math.floor(limits.maxTokens / 2)),
    keepRecent: Math.max(1, limits.keepRecent - 1),
    maxObservationChars: Math.max(400, Math.floor(limits.maxObservationChars / 2)),
  };
}

export function stepLimitsForModel(contextWindowTokens: number): StepContextLimits {
  const budget = Math.max(2000, Math.floor(contextWindowTokens / 3));
  return {
    maxTokens: budget,
    keepRecent: DEFAULT_STEP_CONTEXT_LIMITS.keepRecent,
    // On a genuinely small window, a single 2000-char observation is a tenth of everything. Scale
    // the per-observation cap down with the window rather than letting one tool result dominate.
    maxObservationChars: contextWindowTokens < 32_000 ? 1200 : DEFAULT_STEP_CONTEXT_LIMITS.maxObservationChars,
  };
}
</file>

<file path="workers/agents/src/script-engine/sub-agent-output.ts">
/**
 * Sub-agent output hygiene (spec "Advanced Agent SDK Patterns" §3 + appendix gap
 * G-AN24 "Sub-Agent Output Schema Enforcement: Preventing Instruction Injection via Agent
 * Output"). A child agent's result is DATA to the parent, never instructions — the same
 * trust boundary as an external tool result (see NaelaoAgentDO's dispatchTool, which wraps
 * http_get responses in <untrusted_tool_result>). Pulled out of NaelaoAgentDO so it's
 * unit-testable without a Durable Object harness.
 */

import { moderateInput } from "@naelao/llm-gateway";

const MAX_SUB_AGENT_OUTPUT_CHARS = 8_000;

/** Sub-agent fan-out bound (G-4049155) — same order of magnitude as Claude Code's own
 *  orchestrator-subagent pattern ("up to 16 subagents"), not an arbitrary number. */
export const MAX_SUB_AGENTS_PER_SPAWN = 16;
export const DEFAULT_SUB_AGENT_BUDGET_TOKENS = 20_000;

/** Account-level concurrency ceiling (spec §28 ConcurrencyDO) — how many separate spawn
 *  TREES (batched agent.spawn calls) can be running at once per space, independent of
 *  MAX_SUB_AGENTS_PER_SPAWN's within-tree fan-out bound. Enforced via ConcurrencyDO when
 *  bound; ungated when it isn't (honest degradation, same as every other optional binding). */
export const MAX_CONCURRENT_SUB_AGENT_TREES = 3;

/**
 * Coarse budget→step translation — a secondary safety net alongside the loop's real
 * per-token enforcement (runScriptLoop's `maxTokens`, backed by the reasoner's actual
 * `usage` counts, not an estimate). Bounds runaway step count even in the rare case
 * usage isn't reported (e.g. a non-standard model response). Each child gets its OWN ceiling
 * derived from ITS OWN requested budget, never the parent's remaining budget (fixes
 * "Sub-Agent Token Budget Not Isolated From Parent").
 *
 * The token budget is what should actually bind, so this is deliberately loose enough not to be
 * the binding constraint in normal use. It used to cap at 10, which on the default 20k budget meant
 * a child hit the step ceiling long before spending anything like its allowance — a sub-agent
 * strictly less capable than the parent that spawned it, for no reason anyone chose.
 */
export function budgetToMaxSteps(budgetTokens: number): number {
  return Math.max(3, Math.min(40, Math.round(budgetTokens / 1000)));
}

/** Caps size (context-bloat guard) and wraps a sub-agent's output so it can never be read
 *  as instructions by the parent's reasoning model — scans for injection patterns first. */
export function sanitizeSubAgentOutput(output: unknown): string | undefined {
  if (output === undefined) return undefined;
  const text = typeof output === "string" ? output : JSON.stringify(output);
  const truncated = text.length > MAX_SUB_AGENT_OUTPUT_CHARS ? `${text.slice(0, MAX_SUB_AGENT_OUTPUT_CHARS)}\n[TRUNCATED]` : text;
  const mod = moderateInput(truncated);
  const safe = mod.blocked ? "[REDACTED: sub-agent output flagged by moderation]" : truncated;
  return `<untrusted_subagent_result>\n${safe}\n</untrusted_subagent_result>`;
}

/** Parses a stored JSON string back to a value; falls back to the raw string if it isn't JSON. */
export function safeJsonParse(text: string): unknown {
  try {
    return JSON.parse(text);
  } catch {
    return text;
  }
}
