      <h3>Wallet-Gated Agent Loop Interception</h3>
      <p>In Enterprise spaces, agents can hire other agents, buy data, or spin up expensive resources. The platform
        injects a middleware check into the standard execution loop: before any tool executes, the <code>WalletDO</code>
        verifies the agent has sufficient budget for the operation.</p>

      <pre><code><span class="cm">// agentpress/orchestrator.ts — Enterprise Wallet Interceptor</span>
async function executeWalletGatedTool(
  tc: ParsedToolCall,
  agentDO: NaelaoAgentDO,
  env: Env
): Promise&lt;ToolResult&gt; {
  
  <span class="cm">// 1. Determine cost of the tool call (e.g., buying dataset vs free R2 read)</span>
  const estimatedCost = await estimateToolCost(tc);

  <span class="cm">// 2. If it costs money, check the Agent's WalletDO</span>
  if (estimatedCost > 0) {
    const walletDO = env.NAELAO_WALLET_DO.get(
      env.NAELAO_WALLET_DO.idFromName(`wallet:${agentDO.spaceId}:${agentDO.agentId}`)
    );

    const auth = await walletDO.fetch(new Request('http://wallet/pre-authorize', {
      method: 'POST',
      body: JSON.stringify({ amount: estimatedCost, tool: tc.toolName })
    })).then(r => r.json());

    if (!auth.authorized) {
      <span class="cm">// Agent's loop is interrupted. It must inform the user it needs more budget.</span>
      return { 
        toolName: tc.toolName, 
        output: { error: `Wallet denied: ${auth.reason}. Ask admin to increase budget.` } 
      };
    }
  }

  <span class="cm">// 3. Execute tool and log to CF Analytics Engine (Logpush for Enterprise)</span>
  const result = await standardExecuteTool(tc, agentDO, env);
  
  await env.NAELAO_ANALYTICS_QUEUE.send({
    type: 'audit_action',
    spaceId: agentDO.spaceId,
    agentId: agentDO.agentId,
    toolName: tc.toolName,
    cost: estimatedCost,
    timestamp: Date.now()
  });

  return result;
}</code></pre>
