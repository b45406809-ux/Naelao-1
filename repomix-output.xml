<file path="workers/agents/src/script-engine/prebuilt/approvals.ts">
/**
 * approvals — lets the Space Assistant see and act on pending approvals ANOTHER agent in this
 * business opened, not just its own.
 *
 * The existing HITL machinery (HITLApprovalDO, item 73/74's durable-suspend-and-resume) is
 * already space-wide by construction — a request opened by any project agent's own run is
 * visible from the SAME `GET /requests` list, addressed by space id alone. What was missing was a
 * caller: only a human clicking through `apps/shell`'s Approvals inbox page could ever act on one.
 * An autonomous business owner delegating day-to-day operation to its assistant reasonably expects
 * the assistant to be able to clear a routine, pre-understood approval on their behalf rather than
 * every single one waiting for them personally — the SAME judgment call the assistant already
 * makes for its own actions via assistant_policy, just now extended to another agent's.
 *
 * Reuses the exact HTTP routes `apps/shell`'s own Approvals page calls (GET .../sessions/inbox/
 * approvals, PUT .../approve, PUT .../reject) rather than reaching into HITLApprovalDO directly —
 * one gate (requireOwnedSpace), not two that could drift. `sessionId="inbox"` is not a real
 * session: the underlying DO's own `GET /requests` ignores session_id entirely when no run_id is
 * given (returns every pending approval for the space) — the same mechanism the shell's own
 * dedicated inbox page already depends on, confirmed by reading HITLApprovalDO's handler.
 *
 * `approvals.list` is read-only and safe by construction — auto-approved in guided mode, like
 * every other pure read in this codebase. `approvals.approve`/`approvals.decline` are real,
 * consequential actions (the approved action itself may move money or reach outside the
 * business) and stay gated like any other mutation.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";

async function agentsCall(ctx: PrebuiltOpContext, path: string, method: "GET" | "PUT", body?: Record<string, unknown>): Promise<unknown> {
  if (!ctx.env.agentsWorker) throw new Error("approvals unavailable: agents worker binding not configured");
  const token = await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId);
  const resp = await ctx.env.agentsWorker.fetch(
    new Request(`http://agents-worker${path}`, {
      method,
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": token,
      },
      ...(body ? { body: JSON.stringify(body) } : {}),
    })
  );
  if (!resp.ok) throw new Error(`approvals ${method} ${path} failed: ${resp.status} ${await resp.text()}`);
  return resp.json();
}

function requireApprovalId(a: Record<string, unknown>): string {
  const id = a["approval_id"];
  if (typeof id !== "string" || !id) throw new Error("approval_id is required");
  return id;
}

export const approvals: PrebuiltScript = {
  name: "approvals",
  description:
    "See and act on approvals waiting in this business — including ones a DIFFERENT project agent " +
    "opened, not just this conversation's own. approvals.list first; approve/decline only an " +
    "approval you actually understand (name, arguments) — never blind.",
  domain: "governance",
  requires_tier: 1,
  paramHints: {
    "approvals.approve": "approval_id (string, required) — from approvals.list's own 'id' field.",
    "approvals.decline": "approval_id (string, required); reason (string, optional) — why, for the audit trail.",
  },
  operations: {
    "approvals.list": async (_a, c) => {
      const data = (await agentsCall(c, `/spaces/${c.env.spaceId}/sessions/inbox/approvals`, "GET")) as { approvals?: unknown[] };
      return { pending: data.approvals ?? [], count: (data.approvals ?? []).length };
    },
    "approvals.approve": async (a, c) => {
      const approvalId = requireApprovalId(a);
      return agentsCall(c, `/spaces/${c.env.spaceId}/sessions/inbox/approvals/${encodeURIComponent(approvalId)}/approve`, "PUT");
    },
    "approvals.decline": async (a, c) => {
      const approvalId = requireApprovalId(a);
      const reason = typeof a["reason"] === "string" ? (a["reason"] as string) : undefined;
      return agentsCall(
        c,
        `/spaces/${c.env.spaceId}/sessions/inbox/approvals/${encodeURIComponent(approvalId)}/reject`,
        "PUT",
        reason ? { reason } : {}
      );
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/artifacts.ts">
/**
 * artifacts (Phase 5) — agent-authored deliverables (a rendered HTML page, a report, a document
 * meant to be SHOWN to the person, not scratch working storage). Distinct from r2-workspace's own
 * files: those are the agent's private working directory; an artifact is a finished thing the
 * shell's Artifacts tab lists and lets the person open/download.
 *
 * Routed through the artifact worker's own service binding (space-scoped R2, requireInternalHmac
 * gated — see workers/artifact's own header for the security history this replaced).
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";

function reqWorker(ctx: PrebuiltOpContext): Fetcher {
  if (!ctx.env.artifactWorker) {
    throw new Error("artifacts: ARTIFACT_WORKER binding not configured");
  }
  return ctx.env.artifactWorker;
}

async function internalHeaders(ctx: PrebuiltOpContext, extra?: Record<string, string>): Promise<Record<string, string>> {
  return {
    "x-naelao-tenant-id": ctx.env.tenantId,
    "x-naelao-internal-token": await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId),
    ...extra,
  };
}

export const artifacts: PrebuiltScript = {
  name: "artifacts",
  description: "Publish a finished deliverable (an HTML page, a report, a document) for the person to view or download, distinct from your own scratch workspace files.",
  domain: "workspace",
  requires_tier: 1,
  paramHints: {
    "artifacts.create": "{filename: string, content: string, content_type?: string} — content_type defaults to 'text/plain'; use 'text/html' for a page, 'text/markdown' for a report.",
    "artifacts.list": "{} — no arguments.",
    "artifacts.get": "{artifact_id: string} — the id returned by artifacts.create or artifacts.list.",
    "artifacts.delete": "{artifact_id: string}",
  },
  operations: {
    async "artifacts.create"(args, ctx) {
      const filename = String(args["filename"] ?? "").trim();
      const content = String(args["content"] ?? "");
      if (!filename) throw new Error("artifacts.create requires a non-empty 'filename'");
      if (!content) throw new Error("artifacts.create requires non-empty 'content'");
      const contentType = typeof args["content_type"] === "string" ? args["content_type"] : "text/plain";
      const resp = await reqWorker(ctx).fetch(
        new Request(`http://artifact-worker/spaces/${ctx.env.spaceId}/artifacts`, {
          method: "POST",
          headers: await internalHeaders(ctx, { "content-type": "application/json" }),
          body: JSON.stringify({ filename, content, content_type: contentType }),
        })
      );
      if (!resp.ok) {
        const body = await resp.text().catch(() => "");
        throw new Error(`artifacts.create failed: ${resp.status}${body ? ` — ${body}` : ""}`);
      }
      return await resp.json();
    },

    async "artifacts.list"(_args, ctx) {
      const resp = await reqWorker(ctx).fetch(
        new Request(`http://artifact-worker/spaces/${ctx.env.spaceId}/artifacts`, {
          headers: await internalHeaders(ctx),
        })
      );
      if (!resp.ok) throw new Error(`artifacts.list failed: ${resp.status}`);
      return await resp.json();
    },

    async "artifacts.get"(args, ctx) {
      const artifactId = String(args["artifact_id"] ?? "");
      if (!artifactId) throw new Error("artifacts.get requires 'artifact_id'");
      const resp = await reqWorker(ctx).fetch(
        new Request(`http://artifact-worker/spaces/${ctx.env.spaceId}/artifacts/${encodeURIComponent(artifactId)}`, {
          headers: await internalHeaders(ctx),
        })
      );
      if (!resp.ok) throw new Error(`artifacts.get failed: ${resp.status}`);
      const contentType = resp.headers.get("content-type") ?? "application/octet-stream";
      const filename = resp.headers.get("x-artifact-filename") ?? "";
      // Text content types come back readable; anything else reports metadata only (a script's
      // own return value is JSON — raw binary bytes have nowhere useful to go in this contract).
      if (/^text\/|json|xml/.test(contentType)) {
        return { artifact_id: artifactId, filename, content_type: contentType, content: await resp.text() };
      }
      return { artifact_id: artifactId, filename, content_type: contentType, binary: true };
    },

    async "artifacts.delete"(args, ctx) {
      const artifactId = String(args["artifact_id"] ?? "");
      if (!artifactId) throw new Error("artifacts.delete requires 'artifact_id'");
      const resp = await reqWorker(ctx).fetch(
        new Request(`http://artifact-worker/spaces/${ctx.env.spaceId}/artifacts/${encodeURIComponent(artifactId)}`, {
          method: "DELETE",
          headers: await internalHeaders(ctx),
        })
      );
      if (!resp.ok) throw new Error(`artifacts.delete failed: ${resp.status}`);
      return { ok: true };
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/browser-use.ts">
/**
 * browser-use (spec §8 Tier 4 + §12) — the agent's web browser. Operations: browser.navigate,
 * browser.click, browser.type, browser.extract, browser.screenshot.
 *
 * Routes through the Tier-4 isolate (code-runner.ts), which injects a `ctx.browser.navigate`
 * capability proxied to the naelao-browser Worker (CF Browser Rendering + SSRF guard). The
 * agent never gets raw CDP access (spec §8 note) — every call here goes through that proxy.
 *
 * The naelao-browser worker itself defaults every call to `engine: "auto"` — Cloudflare's
 * Kitesurf (a lightweight, agent-first browser announced 2026-08-06: 3-7x less CPU/memory than
 * Chromium, ~1.7x slower wall time) is tried FIRST and falls back to Chromium on any failure,
 * with zero change needed here since "auto" is the worker's own default. An agent can request a
 * specific engine explicitly via `engine: "chromium" | "kitesurf"` on any op below — useful when
 * it already knows the target needs something Kitesurf can't yet do (video playback, WebGL,
 * bot-challenge/TLS-fingerprint handshakes, a persistent authenticated session, or pixel-perfect
 * rendering) — but an explicit choice is honored strictly, with no silent fallback.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";

interface BrowserAction {
  type: "click" | "type" | "wait" | "scroll";
  selector?: string;
  text?: string;
  ms?: number;
}

type BrowserEngine = "auto" | "chromium" | "kitesurf";

/** Only forwards `engine` when the agent actually specified one, so the naelao-browser worker's
 *  own "auto" default (Kitesurf-first, Chromium fallback) is what applies otherwise — this
 *  function must never invent a default of its own that could drift from the worker's. */
function engineArg(a: Record<string, unknown>): { engine?: BrowserEngine } {
  const raw = a["engine"];
  return raw === "chromium" || raw === "kitesurf" || raw === "auto" ? { engine: raw } : {};
}

/** The Tier-4 isolate harness — forwards straight to the injected ctx.browser capability. */
const BROWSER_HARNESS = `
export async function run(args, ctx) {
  if (!ctx.browser) throw new Error("Tier 4 browser capability not available");
  return await ctx.browser.navigate(args);
}
`;

async function navigate(
  ctx: PrebuiltOpContext,
  body: { url: string; actions?: BrowserAction[]; take_screenshot?: boolean; extract_links?: boolean; engine?: BrowserEngine }
): Promise<unknown> {
  if (!ctx.env.codeRunner) {
    return { ok: false, reason: "Tier 4 (browser) unavailable: no code runner configured in this environment" };
  }
  const result = await ctx.env.codeRunner.run({
    name: "browser-use.navigate",
    code: BROWSER_HARNESS,
    tier: 4,
    args: body,
    spaceId: ctx.env.spaceId,
    agentId: ctx.env.agentId,
    tenantId: ctx.env.tenantId,
  });
  if (!result.ok) throw new Error(result.error ?? "browser navigation failed");
  return result.output;
}

export const browserUse: PrebuiltScript = {
  name: "browser-use",
  description: "Navigate, click, type, extract text/links, and screenshot real web pages.",
  domain: "browser",
  requires_tier: 4,
  operations: {
    "browser.navigate": (a, c) => navigate(c, { url: String(a["url"] ?? ""), ...engineArg(a) }),
    "browser.click": (a, c) =>
      navigate(c, {
        url: String(a["url"] ?? ""),
        actions: [{ type: "click", selector: String(a["selector"] ?? "") }],
        ...engineArg(a),
      }),
    "browser.type": (a, c) =>
      navigate(c, {
        url: String(a["url"] ?? ""),
        actions: [{ type: "type", selector: String(a["selector"] ?? ""), text: String(a["text"] ?? "") }],
        ...engineArg(a),
      }),
    "browser.extract": (a, c) =>
      navigate(c, { url: String(a["url"] ?? ""), extract_links: a["extract_links"] !== false, ...engineArg(a) }),
    "browser.screenshot": (a, c) => navigate(c, { url: String(a["url"] ?? ""), take_screenshot: true, ...engineArg(a) }),
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/business-diagnostics.ts">
/**
 * business-diagnostics — how the Space Assistant finds out what has been happening while it
 * wasn't looking, and what to do about it.
 *
 * The assistant is woken by a heartbeat, a cron, a channel message, a trigger. Each of those used
 * to arrive with no situational awareness at all: it knew its goal and nothing about the business
 * it was supposedly running. So a project could stall for a week and the assistant would cheerfully
 * report that everything was fine, because nothing had told it otherwise.
 *
 * The shape is deliberately summary-first. `overview` is one bounded rollup — counts, why runs
 * failed, which projects are burning tokens without finishing, which threads are stalled and can be
 * resumed. It is small enough to put in a wake-up brief on a cheap model. Everything else here is a
 * DRILL-DOWN the assistant calls only where the summary showed something worth looking at:
 * `failures` for the actual rows behind a count, `stalled_work` for what can be picked up again,
 * `limits` for whether it is about to run out of budget. That split is the whole point — an
 * assistant aware of everything at summary depth, able to go deeper anywhere, without paying for
 * the depth it doesn't need.
 *
 * All read-only. Everything here is already visible to the owner in the dashboard; this is the same
 * information reaching the agent that is meant to act on it.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";
import { classifyFailure, FAILURE_KINDS } from "@naelao/events";

async function spacesCall(ctx: PrebuiltOpContext, path: string): Promise<unknown> {
  if (!ctx.env.spacesWorker) throw new Error("business-diagnostics unavailable: spaces worker binding not configured");
  const token = await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId);
  const resp = await ctx.env.spacesWorker.fetch(
    new Request(`http://spaces-worker${path}`, {
      method: "GET",
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": token,
        // Deliberately NOT forwarding x-naelao-user-id here, unlike workspace-admin's spacesCall.
        // These routes refuse a product_end_user caller because they span every thread in the
        // business including other people's; the assistant reads them as the business's own agent,
        // which is exactly the posture agent-activity's writer already uses.
      },
    })
  );
  if (!resp.ok) throw new Error(`business-diagnostics GET ${path} failed: ${resp.status} ${await resp.text()}`);
  return resp.json();
}

function windowHours(a: Record<string, unknown>, fallback = 24): number {
  const raw = Number(a["window_hours"] ?? fallback);
  if (!Number.isFinite(raw)) return fallback;
  return Math.min(Math.max(Math.round(raw), 1), 24 * 30);
}

interface DiagnosticsOverview {
  window_hours: number;
  runs: { total: number; completed: number; failed: number; error_rate: number };
  spend: { tokens_used: number; credits: number };
  approvals: { requested: number; resolved: number; outstanding: number };
  failures_by_kind: Array<{ kind: string; count: number }>;
  wake_failures: Array<{ trigger: string; failed_runs: number }>;
  projects: Array<{ project_id: string | null; name: string | null; completed: number; failed: number; tokens_used: number }>;
  recent_stalls: Array<{ failure_kind: string; project_name: string | null; summary: string }>;
  notifications: { unread: number; unread_critical: number };
}

/**
 * Turn the rollup into the two or three sentences that actually change what the assistant does
 * next. A model handed a JSON blob will often summarise it back at the user instead of acting on
 * it; a model handed "your last 4 runs all hit the model allowance, which resets on its own" tends
 * to do the right thing.
 */
function readTheRoom(d: DiagnosticsOverview): { headline: string; suggested_focus: string[] } {
  const focus: string[] = [];
  const topFailure = d.failures_by_kind[0];

  if (d.runs.total === 0) {
    return {
      headline: `Nothing has run in the last ${d.window_hours} hours.`,
      suggested_focus: d.notifications.unread > 0 ? ["Read the unread notifications — something may be waiting."] : [],
    };
  }

  const parts = [`${d.runs.completed} of ${d.runs.total} runs finished in the last ${d.window_hours}h.`];

  if (topFailure && d.runs.failed > 0) {
    const c = classifyFailure(topFailure.kind);
    parts.push(`${d.runs.failed} failed, most often: ${topFailure.kind}.`);
    if (c.clears_on_its_own) {
      focus.push("The main failure clears on its own — don't rebuild anything, just resume the stalled work when it does.");
    } else if (c.agent_actionable) {
      focus.push("The main failure is something you can fix yourself — read the failing runs before retrying them.");
    } else {
      focus.push("The main failure needs the owner (settings, budget, or an approval) — tell them plainly rather than retrying.");
    }
  }

  if (d.approvals.outstanding > 0) {
    focus.push(`${d.approvals.outstanding} approval(s) still waiting on the owner — that work is parked, not broken.`);
  }
  if (d.notifications.unread_critical > 0) {
    focus.push(`${d.notifications.unread_critical} critical notification(s) unread — read those first.`);
  }
  const stalledProject = d.projects.find((p) => p.failed > 0 && p.completed === 0);
  if (stalledProject) {
    focus.push(`'${stalledProject.name ?? stalledProject.project_id}' has failed every run and completed none — look there first.`);
  }
  if (d.wake_failures.length > 0) {
    const w = d.wake_failures[0]!;
    focus.push(`${w.failed_runs} '${w.trigger}' wake-up(s) failed — recurring background work isn't getting through.`);
  }

  return { headline: parts.join(" "), suggested_focus: focus };
}

export const businessDiagnostics: PrebuiltScript = {
  name: "business-diagnostics",
  description:
    "See what has actually been happening in this business: how runs went, why they failed, which " +
    "projects are stuck, what is waiting on the owner, and how much budget is left. Start with " +
    "diagnostics.overview on any wake-up, then drill into failures/stalled_work/limits only where " +
    "the overview shows something wrong.",
  domain: "observability",
  requires_tier: 1,
  operations: {
    /**
     * The wake-up brief. One call, bounded, safe to run on every heartbeat.
     */
    "diagnostics.overview": async (a, c) => {
      const hours = windowHours(a);
      const data = (await spacesCall(c, `/spaces/${c.env.spaceId}/agent-diagnostics?window_hours=${hours}`)) as DiagnosticsOverview;
      const read = readTheRoom(data);
      return {
        ...data,
        // Put the interpretation next to the numbers rather than leaving the model to derive it —
        // on a small model that derivation is exactly where things go wrong.
        assessment: read.headline,
        suggested_focus: read.suggested_focus,
        how_to_go_deeper:
          "diagnostics.failures({kind}) for the rows behind a failure count · " +
          "diagnostics.stalled_work() for threads you can continue · " +
          "diagnostics.limits() for budget · " +
          "project_journal.read({project_id}) for a project's own state · " +
          "thread.read({thread_id}) for exactly what was said.",
      };
    },

    /**
     * The rows behind a count. `kind` filters to one classification — the usual next step after the
     * overview names a dominant failure.
     */
    "diagnostics.failures": async (a, c) => {
      const limit = Math.min(Math.max(Number(a["limit"] ?? 20) || 20, 1), 100);
      const qs = new URLSearchParams({ event_type: "run_failed", limit: String(limit) });
      const kind = a["kind"] ? String(a["kind"]) : "";
      if (kind) {
        if (!FAILURE_KINDS.includes(kind as never)) {
          throw new Error(`unknown failure kind '${kind}'. Known kinds: ${FAILURE_KINDS.join(", ")}`);
        }
        qs.set("failure_kind", kind);
      }
      if (a["project_id"]) qs.set("project_id", String(a["project_id"]));
      const res = (await spacesCall(c, `/spaces/${c.env.spaceId}/agent-activity?${qs.toString()}`)) as {
        data: Array<Record<string, unknown>>;
      };
      return {
        failures: res.data.map((row) => {
          const cls = classifyFailure(String(row["failure_kind"] ?? row["summary"] ?? ""));
          return {
            at: row["created_at"],
            agent_id: row["agent_id"],
            project_id: row["project_id"],
            session_id: row["session_id"],
            run_id: row["run_id"],
            woken_by: row["trigger_source"],
            kind: row["failure_kind"] ?? "unknown",
            error: row["summary"],
            tokens_used: row["tokens_used"],
            clears_on_its_own: cls.clears_on_its_own,
            you_can_fix_this: cls.agent_actionable,
            what_it_means: cls.summary,
          };
        }),
        count: res.data.length,
      };
    },

    /**
     * Work that stopped part-way and can be picked up. The session/run ids here are what a
     * continuation needs — resuming under the original run id is what stops already-completed
     * actions being redone (the action ledger keys on it).
     */
    "diagnostics.stalled_work": async (a, c) => {
      const hours = windowHours(a, 72);
      const data = (await spacesCall(c, `/spaces/${c.env.spaceId}/agent-diagnostics?window_hours=${hours}`)) as DiagnosticsOverview & {
        recent_stalls: Array<Record<string, unknown>>;
      };
      return {
        window_hours: hours,
        stalled: data.recent_stalls.map((s) => {
          const cls = classifyFailure(String(s["failure_kind"] ?? ""));
          return {
            ...s,
            clears_on_its_own: cls.clears_on_its_own,
            you_can_fix_this: cls.agent_actionable,
            what_it_means: cls.summary,
          };
        }),
        note:
          "To pick one up, work in its own thread (thread.read for context, then continue there). " +
          "Don't start the same goal in a fresh thread — that redoes work that already succeeded.",
      };
    },

    /**
     * Budget and headroom. Separate from the overview because it's the question worth asking
     * BEFORE starting something expensive, not only after something failed.
     */
    "diagnostics.limits": async (a, c) => {
      const hours = windowHours(a);
      const data = (await spacesCall(c, `/spaces/${c.env.spaceId}/agent-diagnostics?window_hours=${hours}`)) as DiagnosticsOverview;
      const limitFailures = data.failures_by_kind.filter(
        (f) => f.kind === "quota_exhausted" || f.kind === "budget_ceiling" || f.kind === "rate_limited" || f.kind === "context_overflow"
      );
      const hitAllowance = limitFailures.some((f) => f.kind === "quota_exhausted");
      const hitSpendCap = limitFailures.some((f) => f.kind === "budget_ceiling");
      const hitContext = limitFailures.some((f) => f.kind === "context_overflow");
      return {
        window_hours: hours,
        tokens_used: data.spend.tokens_used,
        credits_used: data.spend.credits,
        limit_failures: limitFailures,
        hit_model_allowance: hitAllowance,
        hit_spend_cap: hitSpendCap,
        hit_context_window: hitContext,
        guidance: [
          hitAllowance
            ? "The account's model allowance ran out. It resets on its own — pick the highest-value stalled work to do first when it does, rather than restarting everything at once."
            : null,
          hitSpendCap
            ? "A spend cap on this space stopped work. That's the owner's setting, not something to route around — tell them which project it's blocking."
            : null,
          hitContext
            ? "A request was too large for the model's context window. Break the work into smaller goals and lean on the Project Journal and memory instead of carrying everything in one prompt."
            : null,
          data.runs.failed > data.runs.completed && data.runs.total > 3
            ? "More runs are failing than succeeding. Diagnose before doing more work — repeating a failing approach just spends the remaining budget faster."
            : null,
        ].filter(Boolean),
      };
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/business-email.ts">
/**
 * business-email (spec §11) — a Naelao-provided business mailbox so the agent never has to
 * shop for a third-party email tool. Tier 2.
 *
 * TWO backends, chosen automatically:
 *   1. AgentMail (preferred when AGENTMAIL_API_KEY is configured on the agents worker): a REAL,
 *      inbound-capable mailbox on a domain AgentMail hosts — no Naelao DNS zone needed. Provision
 *      creates an inbox + inbound webhook; send goes out from that address; replies flow back into
 *      the business's channel inbox. Routed through the agents worker's own /internal/business-email/*
 *      routes, which hold the API key — the agent (this isolate) never sees it.
 *   2. Fallback (AgentMail not configured): the legacy behavior — a placeholder handle recorded in
 *      business_services + outbound-only send through the notifications worker (Resend). Honest:
 *      this address cannot RECEIVE, and provision says so.
 *
 * This is NOT a reserved capability — a builder may instead author their own email script — but the
 * Naelao service is the zero-config default.
 *
 * Operations:
 *   email.provision(slug?)             → { address, inbound, status }
 *   email.send(to, subject, body)      → delivery receipt (from the business address)
 *   email.status()                     → current business-email service record
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";

async function bizService(
  ctx: PrebuiltOpContext,
  method: "POST" | "GET",
  body?: Record<string, unknown>
): Promise<unknown> {
  if (!ctx.env.spacesWorker) throw new Error("business-email unavailable: spaces worker binding not configured");
  const init: RequestInit = {
    method,
    headers: {
      "content-type": "application/json",
      "x-naelao-tenant-id": ctx.env.tenantId,
      "x-naelao-internal-token": await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId),
    },
  };
  if (body) init.body = JSON.stringify({ space_id: ctx.env.spaceId, ...body });
  const path = method === "GET"
    ? `/internal/business-services?space_id=${encodeURIComponent(ctx.env.spaceId)}&kind=business_email`
    : `/internal/business-services`;
  const resp = await ctx.env.spacesWorker.fetch(new Request(`http://spaces-worker${path}`, init));
  if (!resp.ok) throw new Error(`business-email op failed: ${resp.status} ${await resp.text()}`);
  return resp.json();
}

/** Call an /internal/business-email/* route on the agents worker itself (holds AGENTMAIL_API_KEY).
 *  Returns null when the self-binding isn't wired (older env), so the caller falls back. */
async function agentMailCall(
  ctx: PrebuiltOpContext,
  path: string,
  body: Record<string, unknown>
): Promise<Record<string, unknown> | null> {
  if (!ctx.env.agentsWorker) return null;
  const resp = await ctx.env.agentsWorker.fetch(new Request(`http://agents-worker${path}`, {
    method: "POST",
    headers: {
      "content-type": "application/json",
      "x-naelao-tenant-id": ctx.env.tenantId,
      "x-naelao-internal-token": await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId),
    },
    body: JSON.stringify({ spaceId: ctx.env.spaceId, tenantId: ctx.env.tenantId, ...body }),
  }));
  return resp.json<Record<string, unknown>>().catch(() => null);
}

async function provision(ctx: PrebuiltOpContext, a: Record<string, unknown>): Promise<unknown> {
  const slug = String(a["slug"] ?? a["name"] ?? "team");
  // Prefer a REAL, inbound-capable AgentMail inbox.
  const am = await agentMailCall(ctx, "/internal/business-email/provision", {
    slug: toSlug(slug),
    ...(a["display_name"] ? { displayName: String(a["display_name"]) } : {}),
  });
  if (am && am["configured"] === true && am["ok"] === true) {
    return {
      address: am["email"],
      inbound: Boolean(am["inbound_wired"]) || Boolean(am["already"]),
      status: "active",
      provider: "agentmail",
    };
  }
  // Fallback: legacy placeholder (send-only). Say plainly it can't receive.
  const rec = (await bizService(ctx, "POST", { kind: "business_email", slug: toSlug(slug) })) as { naelao_handle?: string };
  return {
    address: rec?.naelao_handle,
    inbound: false,
    status: "active",
    provider: "placeholder",
    note: "This address can send but not receive yet (AgentMail is not configured on this deployment).",
  };
}

async function send(ctx: PrebuiltOpContext, a: Record<string, unknown>): Promise<unknown> {
  const to = a["to"];
  // Prefer sending from the real AgentMail inbox (a genuine, reply-able from-address).
  const am = await agentMailCall(ctx, "/internal/business-email/send", {
    to,
    ...(a["subject"] !== undefined ? { subject: a["subject"] } : {}),
    ...(a["body"] !== undefined ? { text: a["body"] } : {}),
    ...(a["html"] !== undefined ? { html: a["html"] } : {}),
  });
  if (am && am["ok"] === true) {
    return { delivered: true, provider: "agentmail", message_id: am["messageId"] ?? null };
  }
  // Fallback: outbound-only via the notifications worker (Resend).
  if (!ctx.env.notificationsWorker) {
    return { delivered: false, reason: "notifications worker binding not configured" };
  }
  let from: string | undefined;
  try {
    const svc = (await bizService(ctx, "GET")) as { naelao_handle?: string } | null;
    from = svc?.naelao_handle ?? undefined;
  } catch { /* best-effort */ }

  const resp = await ctx.env.notificationsWorker.fetch(
    new Request("http://notifications-worker/internal/notify", {
      method: "POST",
      headers: { "content-type": "application/json", "x-naelao-tenant-id": ctx.env.tenantId },
      body: JSON.stringify({
        channel: "email",
        space_id: ctx.env.spaceId,
        to,
        subject: a["subject"],
        body: a["body"],
        ...(from ? { from } : {}),
      }),
    })
  );
  if (!resp.ok) throw new Error(`email.send failed: ${resp.status}`);
  return { delivered: true, provider: "resend", from: from ?? "platform" };
}

function toSlug(input: string): string {
  return (input || "team").toLowerCase().replace(/[^a-z0-9-]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 40) || "team";
}

export const businessEmail: PrebuiltScript = {
  name: "business-email",
  description: "Send transactional and marketing email from a Naelao-provided business address (inbound-capable via AgentMail when configured).",
  domain: "comms",
  requires_tier: 2,
  operations: {
    "email.provision": (a, c) => provision(c, a),
    "email.send": (a, c) => send(c, a),
    "email.status": (_a, c) => bizService(c, "GET"),
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/business-wallet.ts">
/**
 * business-wallet — the autonomous business-bank-account rail (Whop sub-merchant wallets). Tier
 * 2, reserved: these operations are exactly the "wallet_balance"/"wallet_withdraw"/"payout"
 * capabilities `reserved-capabilities.ts` blocks user-authored scripts from replicating — only
 * this Naelao-authored prebuilt may call them, exactly like `commerce` is the only path to
 * money-in.
 *
 * This is the money-side counterpart to the `wallet` prebuilt (which is a DIFFERENT thing — a
 * Naelao-held stored-value balance for paying Naelao's OWN metered platform costs; see that
 * file's header). This wallet IS the business's own revenue: money in from Whop's own
 * storefront/checkout and connected 3rd-party platforms, expenses out for the business's own
 * operating costs, owner payouts on request. Every business gets one auto-provisioned the moment
 * it's created — no builder/end-user action, no API keys to configure.
 *
 * Scope: a business's wallet is SPACE-scoped (the whole business's bank account), not
 * project-scoped like the Naelao-cost wallet — a business has exactly one, backing its
 * `kind='business_wallet'` project (see packages/events/src/business-feature-kinds.ts).
 *
 * Operations:
 *   business_wallet.balance()                                    → { status, balance_cents, currency }
 *   business_wallet.history(limit?)                               → recent wallet_transactions
 *   business_wallet.list_destinations()                           → payout destinations on file
 *   business_wallet.add_destination(type, label, details)         → vault a new payout destination
 *   business_wallet.request_payout(destination_id, amount_cents, note?) → request a payout
 *   business_wallet.list_payouts()                                → payout request history
 *
 * The FIRST payout to a new destination always requires the owner to click a one-time emailed
 * approval link (safety invariant — never a silent first payout); subsequent payouts to an
 * already-verified destination execute directly from `request_payout` itself.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";

async function billingCall(
  ctx: PrebuiltOpContext,
  path: string,
  method: "GET" | "POST" = "GET",
  body?: Record<string, unknown>
): Promise<unknown> {
  if (!ctx.env.billingWorker) throw new Error("business-wallet unavailable: billing worker binding not configured");
  const resp = await ctx.env.billingWorker.fetch(
    new Request(`http://billing-worker${path}`, {
      method,
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-user-id": "assistant",
        "x-naelao-role": "admin",
        "x-naelao-internal-token": await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId),
      },
      ...(body !== undefined ? { body: JSON.stringify(body) } : {}),
    })
  );
  if (!resp.ok) throw new Error(`business-wallet ${path} failed: ${resp.status} ${await resp.text()}`);
  return resp.json();
}

export const businessWallet: PrebuiltScript = {
  name: "business-wallet",
  description:
    "Check this business's Whop sub-merchant wallet balance/history, manage payout destinations, " +
    "and request owner payouts. This IS the business's bank account — revenue from sales settles " +
    "here automatically; nothing here requires the owner's personal bank/card details up front.",
  domain: "commerce",
  requires_tier: 2,
  operations: {
    "business_wallet.balance": async (_a, c) =>
      billingCall(c, `/billing/whop-wallet/balance?space_id=${encodeURIComponent(c.env.spaceId)}`),

    "business_wallet.history": async (a, c) => {
      const limit = typeof a["limit"] === "number" ? a["limit"] : 50;
      return billingCall(c, `/billing/whop-wallet/transactions?space_id=${encodeURIComponent(c.env.spaceId)}&limit=${limit}`);
    },

    "business_wallet.list_destinations": async (_a, c) =>
      billingCall(c, `/billing/whop-wallet/destinations?space_id=${encodeURIComponent(c.env.spaceId)}`),

    "business_wallet.add_destination": async (a, c) => {
      if (!a["type"] || !a["label"] || !a["details"]) {
        throw new Error("add_destination requires type, label, and details");
      }
      return billingCall(c, "/billing/whop-wallet/destinations", "POST", {
        space_id: c.env.spaceId,
        type: a["type"],
        label: a["label"],
        details: a["details"],
      });
    },

    "business_wallet.request_payout": async (a, c) => {
      if (!a["destination_id"] || typeof a["amount_cents"] !== "number" || a["amount_cents"] <= 0) {
        throw new Error("request_payout requires destination_id and a positive amount_cents");
      }
      return billingCall(c, "/billing/whop-wallet/payouts", "POST", {
        space_id: c.env.spaceId,
        destination_id: a["destination_id"],
        amount_cents: a["amount_cents"],
        note: a["note"] ?? null,
        requested_by: "assistant",
      });
    },

    "business_wallet.list_payouts": async (_a, c) =>
      billingCall(c, `/billing/whop-wallet/payouts?space_id=${encodeURIComponent(c.env.spaceId)}`),
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/code-exec.ts">
/**
 * code-exec (spec "Platform Skills" §code-exec, byte ~676541) — execute code in Python,
 * Bash, or TypeScript. Operations: code.execute_python, code.execute_bash, code.run_js — plus
 * `Bash`, an alias for code.execute_bash matching the Claude-Code-shaped REPL primitive naming
 * r2-workspace.ts's Read/Edit/Write/Grep/Glob use (resolved via tool-surface.ts's
 * RENAMED_OPERATIONS, "bash"/"execute_bash" -> "Bash").
 *
 * Per the spec's own routing rule ("DO NOT use execute_python for simple JS calculations"):
 *   - run_js     → Tier 2 isolate (codemode) — fast, no container, no file I/O.
 *   - execute_python / execute_bash → Tier 5 container (SandboxDO) — real OS, files, pip/apt.
 *
 * The Tier-5 harnesses below are platform-authored (not agent-authored), so they carry the
 * same trust level as every other prebuilt op; the agent only ever supplies `args`, never code
 * that runs outside this fixed wrapper.
 *
 * BASH_HARNESS's failure path deliberately still THROWS (never returns a normal
 * `{exit_code, ...}` object on a non-zero exit) — runTier()'s outer wrapper below treats a
 * non-throwing harness result as `ok:true`, and this op's caller (ScriptToolSurface.run, the
 * loop's repeat-guard, the action ledger, distill-a-fix-for-a-failure guidance) all depend on a
 * genuinely failed command coming back as `ok:false`. What changed from the plain `execSync`
 * version: async `exec` (a blocking `execSync` call inside a long-lived, potentially warm
 * container harness process is a real concurrency hazard for any OTHER request that process is
 * serving concurrently — see NaelaoAgentDO/Phase-K's own note on this), stdout squashed to a
 * short confirmation on a genuinely-silent success (nothing for the model to parse), and a
 * failure's stderr trimmed to its last 15 lines (Node's raw exec error can otherwise be enormous).
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import type { ExecutionTier } from "../types.js";
import { assertNoReservedViolation } from "../reserved-capabilities.js";

const PYTHON_HARNESS = `
import { execFileSync } from "node:child_process";
import { writeFileSync, mkdtempSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";

export async function run(args, ctx) {
  const code = args.code;
  if (!code || typeof code !== "string") throw new Error("code is required");
  const timeoutMs = (Number(args.timeout) || 30) * 1000;
  const deps = Array.isArray(args.install_deps) ? args.install_deps.map(String) : [];
  if (deps.length > 0) {
    execFileSync("pip3", ["install", "--quiet", ...deps], { timeout: timeoutMs, encoding: "utf8" });
  }
  const dir = mkdtempSync(join(tmpdir(), "py-"));
  const file = join(dir, "script.py");
  writeFileSync(file, code, "utf8");
  // §A1.17 Phase K: run with cwd = the project's synced /workspace (ctx.workspaceDir) so a
  // Python script's relative file I/O reads/writes the same persistent, project-shared
  // filesystem BASH_HARNESS below already assumed — matches its existing cwd convention.
  const stdout = execFileSync("python3", [file], { timeout: timeoutMs, encoding: "utf8", cwd: (ctx && ctx.workspaceDir) || "/workspace" });
  return { stdout };
}
`;

const BASH_HARNESS = `
import { exec } from "node:child_process";
import { promisify } from "node:util";
const execAsync = promisify(exec);

export async function run(args, ctx) {
  const commands = args.commands || args.command || args.cmd;
  if (!commands || typeof commands !== "string") throw new Error("commands is required");
  const timeoutMs = (Number(args.timeout) || 30) * 1000;
  const cwd = args.working_dir || (ctx && ctx.workspaceDir) || "/workspace";

  try {
    const { stdout, stderr } = await execAsync(commands, {
      cwd,
      timeout: timeoutMs,
      encoding: "utf8",
      shell: "/bin/bash",
      maxBuffer: 4 * 1024 * 1024,
    });
    const cleanOut = (stdout || "").trim();
    // A genuinely silent success (no stdout, no stderr) — give the model something to read
    // rather than an empty string that reads as "did this even run?".
    if (!cleanOut && !stderr) {
      return { exit_code: 0, stdout: "(command produced no output — exit code 0)" };
    }
    return { exit_code: 0, stdout: cleanOut, stderr: (stderr || "").trim() };
  } catch (err) {
    // Deliberately still THROWS (never returns normally) — see this file's own header on why a
    // failed command must resolve to ok:false at the ScriptToolSurface level, not a normally-
    // returned "failure-shaped" object the outer wrapper would read as a success.
    const stderrText = String((err && (err.stderr || err.message)) || "Command failed");
    const last15 = stderrText.trim().split(/\\r?\\n/).slice(-15).join("\\n");
    const exitCode = (err && err.code) || 1;
    throw new Error(\`Command failed with exit code \${exitCode}:\\n\${last15}\`);
  }
}
`;

async function runTier(
  ctx: PrebuiltOpContext,
  name: string,
  harness: string,
  tier: ExecutionTier,
  args: Record<string, unknown>
): Promise<unknown> {
  if (!ctx.env.codeRunner) {
    return { ok: false, reason: `Tier ${tier} unavailable: no code runner configured in this environment` };
  }
  const result = await ctx.env.codeRunner.run({
    name,
    code: harness,
    tier,
    args,
    spaceId: ctx.env.spaceId,
    agentId: ctx.env.agentId,
    tenantId: ctx.env.tenantId,
    ...(ctx.env.projectId ? { projectId: ctx.env.projectId } : {}),
  });
  if (!result.ok) throw new Error(result.error ?? `${name} failed`);
  return result.output;
}

export const codeExec: PrebuiltScript = {
  name: "code-exec",
  description: "Execute Python or Bash in a real sandbox container, or fast JS in a V8 isolate.",
  domain: "container",
  requires_tier: 5,
  paramHints: {
    "code.execute_bash": "commands (string, REQUIRED — a bash command line). timeout (number, " +
      "optional seconds, default 30). working_dir (string, optional, default the synced project " +
      "workspace).",
    "Bash": "Same as code.execute_bash — commands (string, REQUIRED). timeout (number, optional " +
      "seconds). working_dir (string, optional).",
    "code.execute_python": "code (string, REQUIRED — a Python script body). timeout (number, " +
      "optional seconds, default 30). install_deps (string[], optional — pip packages to install " +
      "first).",
    "code.run_js": "code (string, REQUIRED — a `run(args, ctx)` module body, no file I/O). args " +
      "(object, optional — passed through to the module's own args param).",
  },
  operations: {
    "code.execute_python": (a, c) => runTier(c, "code-exec.execute_python", PYTHON_HARNESS, 5, a),
    "code.execute_bash": (a, c) => runTier(c, "code-exec.execute_bash", BASH_HARNESS, 5, a),
    // Same op as code.execute_bash — see RENAMED_OPERATIONS in tool-surface.ts ("bash"/
    // "execute_bash" -> "Bash") and this file's own header.
    "Bash": (a, c) => runTier(c, "code-exec.execute_bash", BASH_HARNESS, 5, a),
    // codemode (spec): JS/TS with no file I/O runs at Tier 2 — the agent supplies its own
    // `run(args, ctx)` module body directly (no fixed harness; this *is* the Tier-2 contract).
    // Same reserved-capability gate as script.create/update applies here too — ad hoc code
    // bypasses the library, so it must not bypass the money-in guard as well.
    async "code.run_js"(a, c) {
      const adHocCode = String(a["code"] ?? "");
      assertNoReservedViolation({ name: "code-exec.run_js", code: adHocCode });
      return runTier(c, "code-exec.run_js", adHocCode, 2, (a["args"] as Record<string, unknown>) ?? {});
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/commerce.ts">
/**
 * commerce (spec §11) — the ONLY money-in path. Tier 2.
 *
 * This is a RESERVED prebuilt script (see reserved-capabilities.ts): user/agent-authored
 * scripts can never collect payment. All checkouts go through Naelao's Lemon Squeezy store
 * via the billing worker, which holds the LS credentials (Workers Secret) and applies the
 * platform fee (productConfig.commerce.naelaoFeeBps). That is how Naelao always gets its cut
 * — the builder cannot strip the fee or substitute their own Stripe key.
 *
 * Operations:
 *   commerce.checkout(product_id, customer_email?) → { checkout_url }   (money-in)
 *   commerce.list_products()                       → owner's published products
 *   commerce.get_order(order_id)                   → one order
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";

async function billing(ctx: PrebuiltOpContext, path: string, body: Record<string, unknown>): Promise<unknown> {
  if (!ctx.env.billingWorker) {
    throw new Error("commerce unavailable: billing worker binding not configured");
  }
  // F20 / A1.16.8: the billing worker's /internal/* routes now require a verified
  // requireInternalHmac token (a static x-naelao-internal header was forgeable) — mint one the
  // same way the spaces() helper below already does.
  const resp = await ctx.env.billingWorker.fetch(
    new Request(`http://billing-worker${path}`, {
      method: "POST",
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId),
      },
      body: JSON.stringify({ space_id: ctx.env.spaceId, ...body }),
    })
  );
  if (!resp.ok) throw new Error(`commerce ${path} failed: ${resp.status} ${await resp.text()}`);
  return resp.json();
}

async function spaces(ctx: PrebuiltOpContext, path: string): Promise<unknown> {
  if (!ctx.env.spacesWorker) throw new Error("commerce unavailable: spaces worker binding not configured");
  const resp = await ctx.env.spacesWorker.fetch(
    new Request(`http://spaces-worker${path}`, {
      headers: {
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId),
      },
    })
  );
  if (!resp.ok) throw new Error(`commerce read ${path} failed: ${resp.status}`);
  return resp.json();
}

/**
 * A write against the space's own product catalogue.
 *
 * Separate from `billing()` above: these are the SAME routes the storefront UI already uses to
 * manage products, not a money-in call, so they go to the spaces worker and need no billing
 * binding. The error text deliberately carries the upstream body — an agent that is told only
 * "failed: 400" cannot report anything useful to the owner.
 */
async function spacesWrite(
  ctx: PrebuiltOpContext,
  path: string,
  method: "POST" | "PATCH",
  body: Record<string, unknown>
): Promise<unknown> {
  if (!ctx.env.spacesWorker) throw new Error("commerce unavailable: spaces worker binding not configured");
  const resp = await ctx.env.spacesWorker.fetch(
    new Request(`http://spaces-worker${path}`, {
      method,
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId),
      },
      body: JSON.stringify(body),
    })
  );
  if (!resp.ok) throw new Error(`commerce ${method} ${path} failed: ${resp.status} ${await resp.text()}`);
  return resp.json();
}

export const commerce: PrebuiltScript = {
  name: "commerce",
  description:
    "Sell products through Naelao's Lemon Squeezy store. Create customer checkouts (the only " +
    "money-in path — platform fee applied automatically), list products, and read orders.",
  domain: "api",
  requires_tier: 2,
  paramHints: {
    "commerce.create_product": "name is required. description, price_cents (a whole number of cents, e.g. 2000 for $20), and kind are optional. Creates a DRAFT — it is not for sale until commerce.update_product sets status to 'published'.",
    "commerce.update_product": "product_id is required — the id commerce.create_product or commerce.list_products returned, never guessed. status is the field that actually publishes it (e.g. status: 'published').",
    "commerce.checkout": "product_id is required — from commerce.list_products. customer_email is optional.",
    "commerce.get_order": "order_id is required — from commerce.list_orders. There is no way to look up an order by anything else.",
  },
  operations: {
    // Money-in: returns a Naelao-store Lemon Squeezy checkout URL for the product.
    "commerce.checkout": (a, c) =>
      billing(c, "/internal/commerce/checkout", {
        product_id: a["product_id"],
        ...(a["customer_email"] ? { customer_email: a["customer_email"] } : {}),
      }),
    // Money-in (seats): a join link for member/seat billing — fee applies, same as products.
    "commerce.seat_checkout": (a, c) =>
      billing(c, "/internal/seats/checkout", {
        ...(a["user_id"] ? { user_id: a["user_id"] } : {}),
        ...(a["customer_email"] ? { customer_email: a["customer_email"] } : {}),
      }),
    "commerce.list_products": (_a, c) => spaces(c, `/spaces/${c.env.spaceId}/products`),
    // Putting something up for sale.
    //
    // This did not exist, and its absence produced the worst failure this platform can have:
    // asked to create a product, the assistant could not, did not say so, and instead reported a
    // detailed success — title, price, "now live on your storefront at shop-…naelao.com". None of
    // it was real; `launchpad_products` was empty. An owner acting on that believes they are
    // selling something they are not. The storefront UI has always had these routes; the agent
    // simply was never given them, so "run a business" stopped at reading.
    "commerce.create_product": (a, c) =>
      spacesWrite(c, `/spaces/${c.env.spaceId}/products`, "POST", {
        name: a["name"],
        ...(a["description"] ? { description: a["description"] } : {}),
        ...(a["price_cents"] !== undefined ? { price_cents: a["price_cents"] } : {}),
        ...(a["kind"] ? { kind: a["kind"] } : {}),
      }),
    // Publishing is deliberately its own step rather than a flag on create: a product going on
    // sale is the moment customers can pay for it, and it should be a decision the agent (or the
    // owner approving it) makes explicitly, not a side effect of drafting.
    "commerce.update_product": (a, c) =>
      spacesWrite(c, `/spaces/${c.env.spaceId}/products/${String(a["product_id"])}`, "PATCH", {
        ...(a["status"] ? { status: a["status"] } : {}),
      }),
    // What actually sold. The seeded daily revenue-review cron asks the assistant to "check
    // business_wallet.balance/history and any storefront/commerce orders" — and there was no
    // operation to list orders at all, only `get_order`, which needs an id you could only have
    // got from a list. So the one recurring job every Launchpad business ships with could not do
    // half of what it was told to do. The route was already there; nothing exposed it.
    "commerce.list_orders": (_a, c) => spaces(c, `/spaces/${c.env.spaceId}/orders`),
    "commerce.get_order": (a, c) => spaces(c, `/spaces/${c.env.spaceId}/orders`).then((o) => {
      const orders = (o as { data?: Array<{ id: string }> }).data ?? [];
      return orders.find((x) => x.id === a["order_id"]) ?? null;
    }),
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/conversation.ts">
/**
 * conversation — search the FULL uncompacted transcript of the thread you are in.
 *
 * The counterpart to compaction. When a conversation outgrows its budget the reasoner sees a
 * summary plus recent messages, and is told so. This is what it does about it.
 *
 * Claude Code's compaction has a well-known failure mode: after a compact the assistant treats
 * anything absent from the summary as though it never happened, and answers confidently from a
 * partial record. The fix is not a better summary — no summary survives every future question —
 * it is giving the model a way to go and look, plus instructions that say to look rather than
 * guess. This prebuilt is the "go and look" half.
 *
 * Retrieval is keyword-scored over the stored messages rather than semantic. That is a deliberate
 * limit, not an oversight: the messages are held in SpaceDO, not in an R2 bucket, so Cloudflare AI
 * Search (which indexes R2 objects on a batch cadence) cannot see them, and a just-sent message
 * must be findable immediately — a reindex delay would break the exact case this exists for. If a
 * semantic index over transcripts is ever wanted it belongs behind this same op, so the model's
 * contract does not change.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";

interface StoredMessage {
  id?: string;
  role: string;
  content: string;
  created_at?: string;
}

/** Tokens worth matching on: drops the filler words that would otherwise match everything. */
const STOP_WORDS = new Set([
  "the", "a", "an", "and", "or", "but", "if", "then", "so", "of", "to", "in", "on", "at", "for",
  "with", "was", "were", "is", "are", "be", "been", "it", "this", "that", "what", "when", "did",
  "do", "does", "you", "i", "we", "my", "me", "about", "said", "say", "tell", "have", "has",
]);

function tokenize(text: string): string[] {
  return text
    .toLowerCase()
    .split(/[^a-z0-9]+/)
    .filter((t) => t.length > 2 && !STOP_WORDS.has(t));
}

/** Score a message against the query. Exported for tests — the ranking is the whole product
 *  here, and it should be assertable without standing up a DO and a spaces worker. */
export function scoreMessage(message: StoredMessage, queryTokens: string[]): number {
  // Filter here as well as in tokenize(): the guarantee that filler words cannot manufacture a
  // match should hold for any caller, not only one that remembered to tokenize first. Without
  // this, a query like "what did we say about the thing" scores against every message in the
  // conversation and the ranking becomes meaningless.
  const tokens = queryTokens.filter((t) => t.length > 2 && !STOP_WORDS.has(t.toLowerCase()));
  if (tokens.length === 0) return 0;
  const haystack = message.content.toLowerCase();
  const bodyTokens = new Set(tokenize(message.content));
  let score = 0;
  for (const q of tokens) {
    // Whole-token match is the strong signal; a substring hit still counts, so "invoice" finds
    // "invoices" without needing a stemmer. It does NOT catch every inflection ("invoicing" does
    // not contain "invoice") — a real stemmer is the fix if that ever matters.
    if (bodyTokens.has(q)) score += 2;
    else if (haystack.includes(q)) score += 1;
  }
  // Normalise by query length so a 2-word and a 6-word query produce comparable scores.
  return score / (tokens.length * 2);
}

function snippet(content: string, queryTokens: string[], radius = 160): string {
  const lower = content.toLowerCase();
  let idx = -1;
  for (const q of queryTokens) {
    const at = lower.indexOf(q);
    if (at !== -1 && (idx === -1 || at < idx)) idx = at;
  }
  if (idx === -1) return content.slice(0, radius * 2);
  const start = Math.max(0, idx - radius);
  const end = Math.min(content.length, idx + radius);
  return `${start > 0 ? "…" : ""}${content.slice(start, end)}${end < content.length ? "…" : ""}`;
}

async function loadMessages(ctx: PrebuiltOpContext, sessionId: string): Promise<StoredMessage[]> {
  if (!ctx.env.spacesWorker) return [];
  const token = await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId);
  const resp = await ctx.env.spacesWorker.fetch(
    new Request(
      `http://spaces-worker/spaces/${encodeURIComponent(ctx.env.spaceId)}/sessions/${encodeURIComponent(sessionId)}/messages`,
      { headers: { "x-naelao-tenant-id": ctx.env.tenantId, "x-naelao-internal-token": token } }
    )
  );
  if (!resp.ok) return [];
  const body = (await resp.json()) as { data?: StoredMessage[]; messages?: StoredMessage[] };
  return body.data ?? body.messages ?? [];
}

export const conversation: PrebuiltScript = {
  name: "conversation",
  description:
    "Search the full, uncompacted transcript of the current conversation. Use this whenever the user refers to something that isn't in your recent messages or summary — the earlier part of a long conversation is compacted away, and this is how you look it up instead of guessing.",
  domain: "knowledge",
  requires_tier: 1,
  operations: {
    async "conversation.search"(args, ctx) {
      const query = String(args["query"] ?? args["text"] ?? "").trim();
      if (!query) throw new Error("conversation.search requires 'query' — what are you looking for?");
      const sessionId = String(args["session_id"] ?? "").trim();
      if (!sessionId) {
        return {
          ok: false,
          reason:
            "conversation.search needs 'session_id' — the id of the thread to search. It is in your goal context; pass it through.",
        };
      }
      const limit = Math.min(Number(args["limit"] ?? 5) || 5, 20);

      const messages = await loadMessages(ctx, sessionId);
      if (messages.length === 0) {
        return { ok: true, query, results: [], searched_messages: 0, note: "No stored messages to search." };
      }

      const queryTokens = tokenize(query);
      const scored = messages
        .map((m, i) => ({ m, i, score: scoreMessage(m, queryTokens) }))
        .filter((r) => r.score > 0)
        .sort((a, b) => b.score - a.score || b.i - a.i)
        .slice(0, limit);

      return {
        ok: true,
        query,
        searched_messages: messages.length,
        results: scored.map((r) => ({
          role: r.m.role,
          // Position lets the model say "early in the conversation" rather than pretending to a
          // precision it does not have.
          position: `${r.i + 1} of ${messages.length}`,
          created_at: r.m.created_at ?? null,
          excerpt: snippet(r.m.content, queryTokens),
          relevance: Number(r.score.toFixed(3)),
        })),
        // An empty result is a real answer — it means the thing genuinely is not in this
        // conversation — and saying so is what stops the model inventing a memory of it.
        ...(scored.length === 0
          ? { note: `Nothing in this conversation matches "${query}". It was not discussed here.` }
          : {}),
      };
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/dynamic-workflow.ts">
/**
 * dynamic-workflow (spec §12.1) — author and deploy CF Workflows for recurring tasks that
 * should run without AgentDO being awake. Operations: workflow.create, workflow.run,
 * workflow.schedule, workflow.status.
 *
 * Workflow registration needs the platform workflow registry, which the engine does not
 * own; these delegate to host orchestration hooks and degrade honestly when unwired.
 *
 * This is how scheduled Launchpad agents (e.g. the Content agent's "0 9 * * *" cron) run:
 * the agent authors a workflow once and schedules it, rather than relying on a separate
 * trigger table.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import type { OrchestrationHooks } from "../types.js";

function hooks(ctx: PrebuiltOpContext): OrchestrationHooks {
  return ctx.env.orchestration ?? {};
}

export const dynamicWorkflow: PrebuiltScript = {
  name: "dynamic-workflow",
  description: "Create, run, schedule (cron), and check status of durable CF Workflows.",
  domain: "orchestration",
  requires_tier: 2,
  operations: {
    async "workflow.create"(args, ctx) {
      const h = hooks(ctx);
      if (!h.workflowCreate) return { ok: false, reason: "workflow registry not available in this environment" };
      return await h.workflowCreate(String(args["name"] ?? ""), String(args["code"] ?? ""));
    },
    async "workflow.run"(args, ctx) {
      const h = hooks(ctx);
      if (!h.workflowRun) return { ok: false, reason: "workflow run not available" };
      return await h.workflowRun(String(args["name"] ?? ""), (args["params"] as Record<string, unknown>) ?? {});
    },
    async "workflow.schedule"(args, ctx) {
      const h = hooks(ctx);
      if (!h.workflowSchedule) return { ok: false, reason: "workflow schedule not available" };
      return await h.workflowSchedule(String(args["name"] ?? ""), String(args["cron"] ?? ""));
    },
    async "workflow.status"(args, ctx) {
      const h = hooks(ctx);
      if (!h.workflowStatus) return { ok: false, reason: "workflow status not available" };
      return await h.workflowStatus(String(args["id"] ?? ""));
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/fabric.ts">
/**
 * fabric (Memory OS Layer 4 — spec "6-Layer Memory OS", byte ~148161: "Cross-session context
 * consolidator based on the Icarus framework. Runs LLM-driven session extraction post-run and
 * exposes tools such as fabric_recall and fabric_brief to summarize work.").
 *
 * The "LLM-driven session extraction" is the AGENT'S OWN job — it calls fabric.record with
 * whatever summary/key_insights it distills from the run it just finished, the same
 * self-managed pattern as memory.remember (Hermes pattern). NaelaoAgentDO also auto-records a
 * lightweight fabric entry after every successful /script/run so cross-session context exists
 * even for agents that never call this explicitly — see handleScriptRun.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";

function userIdFor(args: Record<string, unknown>, ctx: PrebuiltOpContext): string | undefined {
  const explicit = args["user_id"];
  if (typeof explicit === "string" && explicit) return explicit;
  return ctx.env.userId;
}

function stringArray(v: unknown): string[] {
  return Array.isArray(v) ? v.filter((x): x is string => typeof x === "string") : [];
}

export const fabric: PrebuiltScript = {
  name: "fabric",
  description:
    "Cross-session memory (Layer 4): record what this session accomplished, recall past sessions relevant to a topic, or get a quick brief of recent work.",
  domain: "knowledge",
  requires_tier: 1,
  operations: {
    async "fabric.record"(args, ctx) {
      if (!ctx.env.memoryStore) return { ok: false, reason: "memory store not available in this environment" };
      const summary = String(args["summary"] ?? "");
      if (!summary) throw new Error("fabric.record requires 'summary'");
      const sessionId = String(args["session_id"] ?? ctx.env.agentId ?? "unknown");
      const userId = userIdFor(args, ctx);
      return ctx.env.memoryStore.recordFabric({
        ...(userId ? { userId } : {}),
        sessionId,
        summary,
        keyInsights: stringArray(args["key_insights"]),
      });
    },
    async "fabric.recall"(args, ctx) {
      if (!ctx.env.memoryStore) return { ok: false, reason: "memory store not available in this environment" };
      const text = String(args["query"] ?? args["text"] ?? "");
      if (!text) throw new Error("fabric.recall requires 'query'");
      const userId = userIdFor(args, ctx);
      return ctx.env.memoryStore.recallFabric({
        ...(userId ? { userId } : {}),
        text,
        limit: typeof args["limit"] === "number" ? (args["limit"] as number) : 5,
      });
    },
    async "fabric.brief"(args, ctx) {
      if (!ctx.env.memoryStore) return { ok: false, reason: "memory store not available in this environment" };
      const userId = userIdFor(args, ctx);
      return ctx.env.memoryStore.briefFabric(userId, typeof args["limit"] === "number" ? (args["limit"] as number) : 5);
    },
  },
  paramHints: {
    "fabric.record": "summary (string, REQUIRED — the field is `summary`, NOT `content`/`text`/`note`). tags (string[], optional).",
    "fabric.recall": "query (string, REQUIRED — the field is `query`, not `text`). limit (number, optional).",
    "fabric.brief": "limit (number, optional) — no required fields.",
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/file-manager.ts">
/**
 * file-manager (spec §12.3) — advanced file operations extending r2-workspace with
 * diff tracking, append, and history. Tier 1 (R2) for reads/writes.
 *
 * Operations: file.append, file.diff, file.patch, file.history.
 * (file.lock / file.unlock are declared but use R2 conditional writes; kept minimal here.)
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { workspacePrefix } from "../types.js";

function bucket(ctx: PrebuiltOpContext): R2Bucket {
  return ctx.env.workspaceBucket ?? ctx.env.scriptsBucket;
}
function key(ctx: PrebuiltOpContext, path: string): string {
  const clean = String(path).replace(/^\/+/, "");
  if (clean.includes("..")) throw new Error(`Path traversal rejected: ${path}`);
  return `${workspacePrefix(ctx.env)}${clean}`;
}
function reqStr(args: Record<string, unknown>, name: string): string {
  const v = args[name];
  if (typeof v !== "string") throw new Error(`'${name}' (string) is required`);
  return v;
}

/** Naive line-level diff (added/removed line sets) — adequate for change tracking. */
function lineDiff(a: string, b: string): { added: string[]; removed: string[] } {
  const aLines = new Set(a.split("\n"));
  const bLines = new Set(b.split("\n"));
  return {
    added: [...bLines].filter((l) => !aLines.has(l)),
    removed: [...aLines].filter((l) => !bLines.has(l)),
  };
}

export const fileManager: PrebuiltScript = {
  name: "file-manager",
  description: "Advanced file ops: append, diff between two files, naive patch, change history.",
  domain: "filesystem",
  requires_tier: 1,
  operations: {
    async "file.append"(args, ctx) {
      const k = key(ctx, reqStr(args, "path"));
      const existing = await bucket(ctx).get(k);
      const prior = existing ? await existing.text() : "";
      const content = prior + reqStr(args, "content");
      await bucket(ctx).put(k, content, { customMetadata: { updatedAt: Date.now().toString() } });
      return { ok: true, size: content.length };
    },

    async "file.diff"(args, ctx) {
      const [a, b] = await Promise.all([
        bucket(ctx).get(key(ctx, reqStr(args, "path_a"))),
        bucket(ctx).get(key(ctx, reqStr(args, "path_b"))),
      ]);
      const aText = a ? await a.text() : "";
      const bText = b ? await b.text() : "";
      return lineDiff(aText, bText);
    },

    async "file.patch"(args, ctx) {
      // Apply a simple find/replace patch: { path, find, replace }.
      const k = key(ctx, reqStr(args, "path"));
      const obj = await bucket(ctx).get(k);
      if (!obj) throw new Error("file not found");
      const before = await obj.text();
      const find = reqStr(args, "find");
      const replace = reqStr(args, "replace");
      const after = before.split(find).join(replace);
      await bucket(ctx).put(k, after, { customMetadata: { updatedAt: Date.now().toString() } });
      return { ok: true, changed: before !== after };
    },

    async "file.history"(_args, _ctx) {
      // Workspace files are not versioned (only the skill library is). Return empty
      // history rather than fabricate one; agents that need history write to scripts/.
      return { versions: [] };
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/index.ts">
/**
 * Prebuilt Script & Skill Catalogue (spec §12).
 *
 * These ship with Naelao as platform-level scripts, available to all agents. A prebuilt
 * script contributes a set of named OPERATIONS that the agent invokes via
 * script.run(opName, params). Operations are bundled platform code (not stored per-agent
 * in R2) — the agent's distilled scripts compose them.
 *
 * Catalogue: r2-workspace, web-search, file-manager, knowledge-base, notifications,
 *   sub-agent, dynamic-workflow, commerce, storefront, business-email, mcp-connector,
 *   browser-use (Tier 4), code-exec (Tier 2/5), memory (episodic/semantic Memory OS).
 * Deferred: vision-delegate (Workers AI vision model wiring — needs a multimodal model
 * binding decision, tracked separately from the Tier 2-5 execution substrate).
 */

import type { ScriptDomain, ExecutionTier, ScriptEngineEnv } from "../types.js";
import { r2Workspace } from "./r2-workspace.js";
