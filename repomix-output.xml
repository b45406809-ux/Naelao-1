<file path="workers/spaces/src/business-auth.ts">
// Three-Tier Platform Model (§A1.17): the extra authorization floor a `product_end_user` caller
// needs on routes that were previously builder-only. These routes (projects, threads,
// agent-definitions, presence) are gated by `requireInternalHmac` for "did this request actually
// come through the router" — that check passes for a product_end_user exactly the same as a
// builder, since `proxyTo` mints the internal token off ANY verified claims, role included. What
// was MISSING is a floor on what a product_end_user is allowed to do once past that gate.
//
// Deliberately additive-only: a non-product_end_user caller (any builder JWT role) always passes
// unchanged — this file only adds a new floor for the new population, it never re-litigates
// existing builder authorization.
//
// Phase C (§A1.17) upgraded this from Phase B's flat "every product_end_user is a member"
// constant to a REAL per-business lookup — closing a genuine cross-business access hole the
// phased plan flagged in advance: `resolveProductEndUserClaims` only proves the caller holds a
// valid ProductUserDO session scoped to the PRODUCT (one ProductUserDO per productId×endUserId,
// not per-business), so a session verified for the product root would, without this lookup, also
// satisfy the identity check for ANY business under that product — a caller could simply change
// the :spaceId in the URL to reach a different end user's business. `resolveEndUserBusinessRole`
// closes this: the product ROOT space (no parent_space_id) keeps Phase B's behavior (a verified
// session for that exact space implies "member" — safe, since the session literally IS scoped to
// it), but a BUSINESS space (parent_space_id set) requires an ACTIVE row in `business_memberships`
// — no row, no access, regardless of whether the caller is a valid end user of the product.

import { createMiddleware } from "hono/factory";

export type BusinessRole = "viewer" | "member" | "admin" | "owner";

const ROLE_RANK: Record<BusinessRole, number> = { viewer: 0, member: 1, admin: 2, owner: 3 };

interface BusinessAuthEnv {
  PLATFORM_DB: D1Database;
}

/** Resolve the real role an end user holds on `spaceId`. Returns null when the caller has NO
 *  access at all (a business they aren't a member of) — callers must treat null as forbidden,
 *  never fall back to a default role. Fails closed on any lookup error. */
export async function resolveEndUserBusinessRole(
  db: D1Database,
  spaceId: string,
  endUserId: string
): Promise<BusinessRole | null> {
  if (!spaceId || !endUserId) return null;
  try {
    const space = await db.prepare("SELECT parent_space_id FROM spaces WHERE id = ? AND status != 'deleted'")
      .bind(spaceId).first<{ parent_space_id: string | null }>();
    if (!space) return null;
    if (!space.parent_space_id) {
      // The product root — resolveProductEndUserClaims already proved a valid session scoped to
      // exactly this space, so "member" is safe here (this is the Phase B behavior, unchanged).
      return "member";
    }
    const membership = await db.prepare(
      "SELECT role FROM business_memberships WHERE business_space_id = ? AND end_user_id = ? AND status = 'active'"
    ).bind(spaceId, endUserId).first<{ role: string }>();
    if (!membership) return null;
    return membership.role as BusinessRole;
  } catch {
    return null;
  }
}

// WS-7 (audit plan): this check runs on every business-scoped end-user request, doing 1-2
// PLATFORM_DB (single-instance D1, per CLAUDE.md) reads each time — a real chokepoint at
// "millions of end-users" scale. Short-TTL in-memory cache, same pattern as the router's own
// per-user token-version cache (5s TTL): a warm isolate skips the D1 round trip for a burst of
// requests from the same (spaceId, endUserId), while a revoked/changed membership is picked up
// again within a few seconds. Deliberately only wraps the MIDDLEWARE call site, not the exported
// `resolveEndUserBusinessRole` function itself — that function is called directly (uncached) by
// existing tests asserting on membership changes taking effect immediately after a DB mutation;
// caching belongs to the request-serving path, not the primitive.
const BUSINESS_ROLE_CACHE_TTL_MS = 5_000;
const BUSINESS_ROLE_CACHE_MAX = 2000;
const businessRoleCache = new Map<string, { role: BusinessRole | null; expiresAt: number }>();

async function resolveEndUserBusinessRoleCached(
  db: D1Database,
  spaceId: string,
  endUserId: string
): Promise<BusinessRole | null> {
  const cacheKey = `${spaceId}:${endUserId}`;
  const cached = businessRoleCache.get(cacheKey);
  if (cached && Date.now() < cached.expiresAt) return cached.role;
  const role = await resolveEndUserBusinessRole(db, spaceId, endUserId);
  if (businessRoleCache.size >= BUSINESS_ROLE_CACHE_MAX) {
    businessRoleCache.delete(businessRoleCache.keys().next().value!);
  }
  businessRoleCache.set(cacheKey, { role, expiresAt: Date.now() + BUSINESS_ROLE_CACHE_TTL_MS });
  return role;
}

/** Wallet-specific variant of resolveEndUserBusinessRole. The product ROOT space's wallet project
 *  (seeded by seedWallet, kind='wallet') is the BUILDER's own platform-cost ledger — unlike every
 *  other root-scoped resource, a verified end-user product session implies NO legitimate access to
 *  it, so the generic root-is-"member" shortcut must NOT apply here. A business (child) space's
 *  wallet is that business's own money, so it keeps the normal per-business membership lookup. */
export async function resolveWalletAccessRole(
  db: D1Database,
  spaceId: string,
  endUserId: string
): Promise<BusinessRole | null> {
  if (!spaceId || !endUserId) return null;
  try {
    const space = await db.prepare("SELECT parent_space_id FROM spaces WHERE id = ? AND status != 'deleted'")
      .bind(spaceId).first<{ parent_space_id: string | null }>();
    if (!space) return null;
    if (!space.parent_space_id) return null; // product root: builder-only, never a product_end_user
    const membership = await db.prepare(
      "SELECT role FROM business_memberships WHERE business_space_id = ? AND end_user_id = ? AND status = 'active'"
    ).bind(spaceId, endUserId).first<{ role: string }>();
    if (!membership) return null;
    return membership.role as BusinessRole;
  } catch {
    return null;
  }
}

const walletRoleCache = new Map<string, { role: BusinessRole | null; expiresAt: number }>();

async function resolveWalletAccessRoleCached(
  db: D1Database,
  spaceId: string,
  endUserId: string
): Promise<BusinessRole | null> {
  const cacheKey = `${spaceId}:${endUserId}`;
  const cached = walletRoleCache.get(cacheKey);
  if (cached && Date.now() < cached.expiresAt) return cached.role;
  const role = await resolveWalletAccessRole(db, spaceId, endUserId);
  if (walletRoleCache.size >= BUSINESS_ROLE_CACHE_MAX) {
    walletRoleCache.delete(walletRoleCache.keys().next().value!);
  }
  walletRoleCache.set(cacheKey, { role, expiresAt: Date.now() + BUSINESS_ROLE_CACHE_TTL_MS });
  return role;
}

/** Returns a Hono middleware that, ONLY for `x-naelao-role: product_end_user` callers, requires
 *  at least `methodMinRole[method]` (default: "admin", fail closed for methods not listed) on the
 *  space named by the `spaceId` route param. Every other role passes through untouched. */
export function requireBusinessMembership(methodMinRole: Partial<Record<string, BusinessRole>>) {
  return createMiddleware(async (c, next) => {
    const role = c.req.header("x-naelao-role") ?? "";
    if (role !== "product_end_user") return next();

    const spaceId = c.req.param("spaceId") ?? "";
    const endUserId = c.req.header("x-naelao-user-id") ?? "";
    const env = c.env as BusinessAuthEnv;
    const callerRole = await resolveEndUserBusinessRoleCached(env.PLATFORM_DB, spaceId, endUserId);
    if (!callerRole) {
      return c.json({ error_code: "forbidden", message: "Not a member of this business" }, 403);
    }
    const minRole = methodMinRole[c.req.method] ?? "admin";
    if (ROLE_RANK[callerRole] < ROLE_RANK[minRole]) {
      return c.json({ error_code: "forbidden", message: "Insufficient role for this action" }, 403);
    }
    return next();
  });
}

/** Wallet-only variant of requireBusinessMembership: uses resolveWalletAccessRole instead of
 *  resolveEndUserBusinessRole, so a product_end_user is refused OUTRIGHT on the product ROOT
 *  space's wallet (the builder's own platform-cost ledger) instead of passing at the generic
 *  root-implies-"member" floor. Business (child) space wallets are unaffected — same real
 *  business_memberships lookup as every other business-scoped route. Every non-product_end_user
 *  caller (builder JWT roles) passes through untouched, as with requireBusinessMembership. */
export function requireBusinessMembershipForWallet(methodMinRole: Partial<Record<string, BusinessRole>>) {
  return createMiddleware(async (c, next) => {
    const role = c.req.header("x-naelao-role") ?? "";
    if (role !== "product_end_user") return next();

    const spaceId = c.req.param("spaceId") ?? "";
    const endUserId = c.req.header("x-naelao-user-id") ?? "";
    const env = c.env as BusinessAuthEnv;
    const callerRole = await resolveWalletAccessRoleCached(env.PLATFORM_DB, spaceId, endUserId);
    if (!callerRole) {
      return c.json({ error_code: "forbidden", message: "Wallet is not accessible to end users on this space" }, 403);
    }
    const minRole = methodMinRole[c.req.method] ?? "admin";
    if (ROLE_RANK[callerRole] < ROLE_RANK[minRole]) {
      return c.json({ error_code: "forbidden", message: "Insufficient role for this action" }, 403);
    }
    return next();
  });
}
</file>

<file path="workers/spaces/src/business-create.ts">
// Shared business-creation logic — a customer creates their own business under a reseller-mode
// product (spec G-AS34/G-AS35, §49 Scenario C). Extracted from the original POST /reseller/spaces
// handler (index.ts) so the Three-Tier Platform Model's Phase C product-scoped wrapper
// (POST /spaces/:productSpaceId/businesses, business-routes.ts) can reuse the exact same
// security-sensitive gating/tenant-hierarchy logic instead of re-implementing it — "reuse, don't
// reinvent." Both callers now share this one path; there is no second copy of this logic anywhere.
//
// Kept dependency-free of index.ts's own Env/types (declares its own minimal structural Env), so
// index.ts -> business-create.ts and business-routes.ts -> business-create.ts both stay one-way —
// no circular import.

import type { SpaceTypeProductConfig, NaelaoSpaceTypeManifestV2, SpaceTypeRegistryDO } from "./do/SpaceTypeRegistryDO.js";
import { checkFreeTierTemplateEligibility } from "./template-catalog.js";
import { resolveEffectiveBusinessLimit, isPersonalPlanTier, type PersonalPlanTier } from "@naelao/billing-core";
import { getDOName } from "@naelao/crypto";

export interface ProvisionMessage {
  type: "space_provision" | "space_deprovision";
  spaceId: string;
  tenantId: string;
  spaceTypeId: string;
  spaceName: string;
  templateId?: string;
  templateIds?: string[];
  requestedAt: string;
  userId?: string;
}

export interface BusinessCreateEnv {
  PLATFORM_DB: D1Database;
  PLATFORM_SECRET: string;
  PROVISION_QUEUE?: Queue<ProvisionMessage>;
  SPACE_TYPE_REGISTRY_DO: DurableObjectNamespace<SpaceTypeRegistryDO>;
  NAELAO_CONFIG_KV: KVNamespace;
  /** G-BF08: the free-tier template gate resolves the real catalogue (free_tier_eligible) from
   *  the agents worker. Optional — absent (dev/test), the gate degrades open; see
   *  checkFreeTierTemplateEligibility. */
  AGENTS_WORKER?: Fetcher;
  /** Phase 4 (money): resolves the CALLING end user's own personal-plan tier
   *  (ProductUserDO's /plan-tier), which narrows or widens their slice of
   *  productConfig.maxBusinessesPerEndUser — see resolveEffectiveBusinessLimit. Optional so
   *  dev/test environments without this binding degrade to the pre-existing flat-ceiling-only
   *  behavior (every existing caller/test that doesn't set this is unaffected). */
  PRODUCT_USER_DO?: DurableObjectNamespace;
}

export interface CreateBusinessOptions {
  resellerProductSpaceId: string;
  userId: string;
  name: string;
  spacetypeId: string;
  /** Back-compat single template. Ignored when templateIds is non-empty. */
  templateId?: string;
  /** Phase C: a business built from more than one template. */
  templateIds?: string[];
  configOverrides?: Record<string, unknown>;
}

export interface CreateBusinessOk {
  ok: true;
  tenantId: string;
  spaceId: string;
  status: string;
  parentTenantId: string;
}

export interface CreateBusinessErr {
  ok: false;
  error_code: string;
  message: string;
  status: 400 | 403 | 404 | 429;
}

export type CreateBusinessResult = CreateBusinessOk | CreateBusinessErr;

function getRegistryDO(env: BusinessCreateEnv): DurableObjectStub<SpaceTypeRegistryDO> {
  return env.SPACE_TYPE_REGISTRY_DO.get(env.SPACE_TYPE_REGISTRY_DO.idFromName("global-space-type-registry"));
}

/** Phase 4 (money): resolve the calling end user's own personal-plan tier from their
 *  ProductUserDO (one instance per productId×endUserId — productId here is the PRODUCT ROOT,
 *  which resellerProductSpaceId already is by this file's own established invariant, matching
 *  productUserDoStub's addressing in workers/spaces/src/index.ts exactly, without importing that
 *  file — this stays intentionally self-contained per this file's own "no circular import" rule).
 *  Never throws; degrades to 'free' (the more restrictive tier, matching every other billing gate
 *  in this codebase's fail-closed posture) on any binding/network/shape error. */
export async function resolvePersonalPlanTier(
  env: BusinessCreateEnv,
  productRootSpaceId: string,
  endUserId: string,
  tenantId: string
): Promise<PersonalPlanTier> {
  if (!env.PRODUCT_USER_DO) return "free";
  try {
    const doName = await getDOName("produser", `${productRootSpaceId}:${endUserId}`, tenantId, env.PLATFORM_SECRET);
    const stub = env.PRODUCT_USER_DO.get(env.PRODUCT_USER_DO.idFromName(doName));
    const resp = await stub.fetch(new Request("http://produser/plan-tier"));
    if (!resp.ok) return "free";
    const body = await resp.json<{ plan_tier?: string }>();
    return isPersonalPlanTier(body.plan_tier) ? body.plan_tier : "free";
  } catch {
    return "free";
  }
}

async function loadManifest(env: BusinessCreateEnv, spaceTypeId: string): Promise<NaelaoSpaceTypeManifestV2 | null> {
  const cacheKey = `space-type-manifest:${spaceTypeId}`;
  const cached = (await env.NAELAO_CONFIG_KV.get(cacheKey, "json")) as NaelaoSpaceTypeManifestV2 | null;
  if (cached) return cached;
  const registry = getRegistryDO(env);
  const resp = await registry.fetch(new Request(`http://registry/type/${spaceTypeId}`));
  if (!resp.ok) return null;
  const manifest = await resp.json<NaelaoSpaceTypeManifestV2>();
  await env.NAELAO_CONFIG_KV.put(cacheKey, JSON.stringify(manifest), { expirationTtl: 3600 });
  return manifest;
}

export async function loadEffectiveProductConfig(
  env: BusinessCreateEnv,
  spaceTypeId: string,
  spaceConfigJson: string | null
): Promise<SpaceTypeProductConfig | null> {
  const manifest = await loadManifest(env, spaceTypeId);
  const base = manifest?.productConfig ?? null;
  let override: Partial<SpaceTypeProductConfig> | undefined;
  if (spaceConfigJson) {
    try {
      const cfg = JSON.parse(spaceConfigJson) as { productConfig?: Partial<SpaceTypeProductConfig> };
      override = cfg.productConfig;
    } catch { /* ignore malformed */ }
  }
  if (!base && !override) return null;
  return { ...(base ?? {}), ...(override ?? {}) } as SpaceTypeProductConfig;
}

/** Create a customer's own business (space) under a reseller-mode product. Shared by
 *  POST /reseller/spaces (index.ts, no path spaceId — legacy) and
 *  POST /spaces/:productSpaceId/businesses (business-routes.ts, Phase C's product-scoped,
 *  router-allowlistable wrapper). Identical gating + tenant-hierarchy + provisioning-queue logic
 *  either way; callers differ only in how they resolve `resellerProductSpaceId` and what they do
 *  with the result (the wrapper additionally dual-writes business_memberships for the owner). */
export async function createBusinessForEndUser(
  env: BusinessCreateEnv,
  opts: CreateBusinessOptions
): Promise<CreateBusinessResult> {
  if (!opts.resellerProductSpaceId || !opts.name || !opts.spacetypeId) {
    return { ok: false, error_code: "bad_request", message: "reseller_product_space_id, name, spacetype_id are required", status: 400 };
  }

  // 1. Resolve the reseller (parent tenant) from the product space.
  const product = await env.PLATFORM_DB.prepare(
    "SELECT tenant_id, spacetype_id, config_json FROM spaces WHERE id = ? AND status = 'active'"
  ).bind(opts.resellerProductSpaceId).first<{ tenant_id: string; spacetype_id: string; config_json: string | null }>();
  if (!product) return { ok: false, error_code: "not_found", message: "Reseller product not found", status: 404 };
  const parentTenantId = product.tenant_id;

  // 2. Load effective productConfig and gate the request.
  const pc = await loadEffectiveProductConfig(env, product.spacetype_id, product.config_json);
  if (!pc || (pc.membershipModel !== "tenant" && pc.membershipModel !== "hybrid")) {
    return { ok: false, error_code: "not_allowed", message: "This product does not allow customers to create their own businesses", status: 403 };
  }
  if (!pc.allowPublicSignup) {
    // Says what this flag ACTUALLY gates. It was "Public signup is disabled for this product",
    // which is wrong in the most confusing way: end-user signup is a different route entirely
    // (product-end-user-routes.ts) and never consults this flag — so a builder hitting this saw
    // "signup is disabled" moments after watching a customer sign up successfully, and would go
    // looking for a signup setting that does not exist. This flag only decides whether a signed-in
    // customer may create their OWN business, which is exactly how the dashboard already labels it
    // ("Allow end users to sign up and create their own business").
    return {
      ok: false,
      error_code: "business_creation_disabled",
      message: "This product does not let customers create their own businesses yet. A builder can enable it under Configuration → Product Mode.",
      status: 403,
    };
  }
  const allowed = pc.allowedChildSpaceTypes ?? [];
  if (!allowed.includes(opts.spacetypeId)) {
    return { ok: false, error_code: "spacetype_not_allowed", message: `SpaceType '${opts.spacetypeId}' is not offered by this product`, status: 403 };
  }

  // 2b. G-GRW08 (Appendix AJ): on the free plan only free_tier_eligible templates may be
  // instantiated. The plan that matters is the OWNING builder org's (parentTenantId) — end-user
  // claims already resolve to it, and the child tenant minted below has no org/plan of its own.
  // Checked BEFORE any side effect (reseller_accounts upsert, tenant mint) so a rejected create
  // leaves nothing behind.
  const requestedTemplates = opts.templateIds && opts.templateIds.length > 0
    ? opts.templateIds
    : opts.templateId ? [opts.templateId] : [];
  const gate = await checkFreeTierTemplateEligibility(env.PLATFORM_DB, env, parentTenantId, requestedTemplates);
  if (!gate.ok) {
    return { ok: false, error_code: gate.error_code, message: gate.message, status: gate.status };
  }

  // 3. Find or mint the customer's child tenant (one per customer per reseller).
  const existing = await env.PLATFORM_DB.prepare(
    "SELECT child_tenant_id FROM tenant_hierarchy WHERE parent_tenant_id = ? AND child_owner_user_id = ? LIMIT 1"
  ).bind(parentTenantId, opts.userId).first<{ child_tenant_id: string }>();
  const childTenantId = existing?.child_tenant_id ?? `ten_${crypto.randomUUID().replace(/-/g, "")}`;
  const now = new Date().toISOString();

  // Ensure a reseller_accounts row exists for the parent (lazily, from productConfig). WS-3:
  // previously hardcoded wholesale_cents=NULL/referral_share_pct=0.0 literals with no rate
  // fields anywhere in productConfig to seed from — now reads pc.resellerRates (set via PATCH
  // /builder/products/:id/reseller). The ON CONFLICT branch only refreshes product_space_id, not
  // the rates: a builder's rate change is applied directly to this row by that same PATCH
  // endpoint (immediate effect on the existing row), not deferred until the next business is
  // created under this reseller — re-seeding rates here on every conflict would silently
  // overwrite a rate the builder set AFTER this tenant's account row already existed.
  await env.PLATFORM_DB.prepare(
    `INSERT INTO reseller_accounts (tenant_id, product_space_id, billing_relationship, wholesale_cents, referral_share_pct, updated_at)
     VALUES (?, ?, ?, ?, ?, ?)
     ON CONFLICT(tenant_id) DO UPDATE SET product_space_id = excluded.product_space_id, updated_at = excluded.updated_at`
  ).bind(
    parentTenantId,
    opts.resellerProductSpaceId,
    pc.billingRelationship ?? "platform",
    pc.resellerRates?.wholesaleCents ?? null,
    pc.resellerRates?.referralSharePct ?? 0.0,
    now
  ).run();

  // F-19 (abuse/DoS): bound how many businesses a single end user can create under this reseller
  // product. Without this, one verified free-tier email could loop POST /businesses and provision
  // unlimited spaces (SpaceDO init, agent installs, R2 writes, wallet seed each) — the rate limiter
  // only slows it, never caps it. Counts this user's OWN existing non-deleted businesses under this
  // product; a builder can tune the ceiling via productConfig.maxBusinessesPerEndUser (default 10).
  //
  // Phase 4 (money): combined with the caller's OWN personal-plan tier
  // (resolveEffectiveBusinessLimit) — a free-tier user gets only a SLICE of the builder's own
  // ceiling (never more than PERSONAL_PLAN_LIMITS.free.maxBusinessesOwned) unless they upgrade to
  // 'plus', which then unlocks the full builder-configured ceiling. The builder's own ceiling is
  // always the outer bound either way — a personal plan can never let a user exceed what the
  // builder allowed. Fails open to the flat ceiling (tier "free") on any resolution error or a
  // missing PRODUCT_USER_DO binding (dev/test) — never blocks MORE than the pre-existing behavior
  // already did, only ever the same or less restrictive.
  const productCeiling = (pc as { maxBusinessesPerEndUser?: number }).maxBusinessesPerEndUser ?? 10;
  const personalTier = await resolvePersonalPlanTier(env, opts.resellerProductSpaceId, opts.userId, parentTenantId);
  const maxBusinesses = resolveEffectiveBusinessLimit(personalTier, productCeiling);
  const existingCount = await env.PLATFORM_DB.prepare(
    "SELECT COUNT(*) AS cnt FROM spaces WHERE parent_space_id = ? AND created_by = ? AND status != 'deleted'"
  ).bind(opts.resellerProductSpaceId, opts.userId).first<{ cnt: number }>();
  if ((existingCount?.cnt ?? 0) >= maxBusinesses) {
    const upgradeHint = personalTier === "free" && maxBusinesses < productCeiling
      ? ` Upgrade your personal plan to own up to ${productCeiling}.`
      : "";
    return {
      ok: false,
      error_code: "business_limit_reached",
      message: `You have reached the maximum of ${maxBusinesses} businesses for this product.${upgradeHint}`,
      status: 429,
    };
  }

  // 4. Create the child business (space) under the child tenant.
  const spaceId = crypto.randomUUID();
  const initialStatus = env.PROVISION_QUEUE ? "provisioning" : "active";
  const templateIds = opts.templateIds && opts.templateIds.length > 0 ? opts.templateIds : opts.templateId ? [opts.templateId] : [];
  const configJson = JSON.stringify({
    ...(opts.configOverrides ?? {}),
    ...(templateIds.length > 0 ? { template_id: templateIds[0], template_ids: templateIds } : {}),
  });
  // The child business is its OWN top-level space under its OWN tenant (saas per-end-user
  // isolation, G-Y16): own SpaceDO, own SQLite. parent_space_id links it to the reseller's
  // product for portfolio/promotion queries; scenario_type marks it a user-created business.
  await env.PLATFORM_DB.prepare(
    `INSERT INTO spaces (id, tenant_id, spacetype_id, name, status, config_json, parent_space_id, depth, tenancy_mode, scenario_type, created_at, updated_at, created_by)
     VALUES (?, ?, ?, ?, ?, ?, ?, 1, 'saas', 'user-workspace', ?, ?, ?)`
  ).bind(spaceId, childTenantId, opts.spacetypeId, opts.name, initialStatus, configJson, opts.resellerProductSpaceId, now, now, opts.userId).run();

  // 5. Record the hierarchy on first business for this child tenant.
  if (!existing) {
    await env.PLATFORM_DB.prepare(
      `INSERT INTO tenant_hierarchy (child_tenant_id, parent_tenant_id, reseller_product_space_id, child_space_id, child_owner_user_id)
       VALUES (?, ?, ?, ?, ?)`
    ).bind(childTenantId, parentTenantId, opts.resellerProductSpaceId, spaceId, opts.userId).run();
  }

  // 6. Provision under the CHILD tenant (reuses the 10-step provisioner unchanged).
  if (env.PROVISION_QUEUE) {
    await env.PROVISION_QUEUE.send({
      type: "space_provision",
      spaceId,
      tenantId: childTenantId,
      spaceTypeId: opts.spacetypeId,
      spaceName: opts.name,
      ...(templateIds.length > 0 ? { templateId: templateIds[0]!, templateIds } : {}),
      userId: opts.userId,
      requestedAt: now,
    });
  }

  // Every business auto-provisions a Whop sub-merchant wallet. Deliberately NOT wired here yet:
  // unlike the builder-created paths (createSpaceRecord's callers, which resolve a real email
  // from the platform `users` table), this business's owner is a ProductUserDO end user — there
  // is no D1 row with their email, and resolving it needs a ProductUserDO round trip this file
  // doesn't have wired (business-create.ts is deliberately kept dependency-free of index.ts's own
  // DO-stub helpers). Documented gap, not silently dropped — tracked as a real follow-up rather
  // than fabricating a placeholder email Whop would send real payout-approval mail to.

  return { ok: true, tenantId: childTenantId, spaceId, status: initialStatus, parentTenantId };
}
</file>

<file path="workers/spaces/src/business-routes.ts">
// Three-Tier Platform Model, Phase C (docs/spec-appendix/A1-script-agents-and-space-assistants.md
// §A1.17) — businesses, the space switcher, and invites.
//
// registerBusinessRoutes(app) is called once from index.ts, same convention as
// registerBuilderRoutes/registerProductEndUserRoutes: a self-contained module with its own
// minimal structural Env (avoids a circular import with index.ts).

import type { Hono } from "hono";
import { getDOName } from "@naelao/crypto";
import { createBusinessForEndUser, resolvePersonalPlanTier, loadEffectiveProductConfig, type BusinessCreateEnv } from "./business-create.js";
import { canPersonalPlanInvite } from "@naelao/billing-core";
import { resolveEndUserBusinessRole } from "./business-auth.js";

export interface BusinessRoutesEnv extends BusinessCreateEnv {
  SPACE_DO: DurableObjectNamespace;
  /** F-15: best-effort invite emails (same binding the product-end-user routes use). */
  NOTIFICATIONS_WORKER?: Fetcher;
  /** F-15: base URL for building a clickable accept link in the invite email. */
  PRODUCT_SHELL_URL?: string;
}

/**
 * F-15: email the invitee a best-effort invite with the accept link. Previously the invite route
 * stored the email + hashed token but sent nothing — "invite by email" collected an address it
 * never used, working only by manual link paste. Never blocks the caller's own response (a
 * notifications outage must not fail the invite creation), matching the product-end-user email
 * helper's posture exactly.
 */
async function sendInviteEmail(
  env: BusinessRoutesEnv, tenantId: string, spaceId: string, to: string,
  businessSpaceId: string, token: string, slug: string | null
): Promise<void> {
  if (!env.NOTIFICATIONS_WORKER) return;
  const link = env.PRODUCT_SHELL_URL && slug
    ? `${env.PRODUCT_SHELL_URL}/p/${slug}/invites/${businessSpaceId}/accept?token=${token}`
    : null;
  const body = link
    ? `You've been invited to join a business on Naelao. Sign in and open this link to accept:\n\n${link}`
    : `You've been invited to join a business on Naelao. Ask the person who invited you for the accept link, or use this invite token after signing in: ${token}`;
  try {
    await env.NOTIFICATIONS_WORKER.fetch(new Request("http://notifications-worker/internal/notify", {
      method: "POST",
      headers: { "content-type": "application/json", "x-naelao-tenant-id": tenantId },
      body: JSON.stringify({ channel: "email", space_id: spaceId, to, subject: "You've been invited to a business on Naelao", body }),
    }));
  } catch { /* best-effort — never blocks the caller's own response */ }
}

async function sha256Hex(input: string): Promise<string> {
  const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(input));
  return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, "0")).join("");
}

/** A cryptographically random, URL-safe invite token — high entropy, so a fast digest (not
 *  PBKDF2) is the correct hash for its index, same reasoning as builder_api_key_index. */
function randomToken(): string {
  const bytes = crypto.getRandomValues(new Uint8Array(24));
  return "inv_" + [...bytes].map((b) => b.toString(16).padStart(2, "0")).join("");
}

function callerIdentity(c: { req: { header(h: string): string | undefined } }): { tenantId: string; userId: string; role: string } {
  return {
    tenantId: c.req.header("x-naelao-tenant-id") ?? "",
    userId: c.req.header("x-naelao-user-id") ?? "",
    role: c.req.header("x-naelao-role") ?? "",
  };
}

async function seedSpaceDoMember(env: BusinessRoutesEnv, spaceId: string, tenantId: string, userId: string, role: string): Promise<void> {
  try {
    const doId = env.SPACE_DO.idFromName(await getDOName("space", spaceId, tenantId, env.PLATFORM_SECRET));
    const stub = env.SPACE_DO.get(doId);
    await stub.fetch(new Request("http://space-do/members", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ space_id: spaceId, user_id: userId, role }),
    }));
  } catch {
    // Best-effort — business_memberships (the D1 index) is the source of truth for the shell's
    // switcher/gating; a failed SpaceDO mirror is recoverable (same non-fatal precedent as
    // seedOwnerMember in the provisioner).
  }
}

export function registerBusinessRoutes(app: Hono<any>): void { // eslint-disable-line @typescript-eslint/no-explicit-any
  // POST /spaces/:productSpaceId/businesses — product-scoped wrapper over createBusinessForEndUser
  // (the same logic POST /reseller/spaces uses). Being product-scoped (a path spaceId) is what
  // lets the router's product_end_user allowlist capture it safely — the bare /reseller/spaces
  // route has no path spaceId to key a membership check off of. Dual-writes business_memberships
  // for the owner (Phase B's flat "member" floor becomes a real role once this row exists) and
  // best-effort mirrors into the business's own SpaceDO space_members (matches seedOwnerMember's
  // precedent — the provisioner does this too once the space finishes provisioning, so this call
  // is a head start, not a replacement).
  app.post("/spaces/:productSpaceId/businesses", async (c) => {
    const env = c.env as BusinessRoutesEnv;
    const productSpaceId = c.req.param("productSpaceId");
    const { userId } = callerIdentity(c);
    if (!userId) return c.json({ error_code: "unauthorized", message: "Missing user" }, 401);

    const body = await c.req.json<{
      name: string;
      spacetype_id: string;
      template_id?: string;
      template_ids?: string[];
      config_overrides?: Record<string, unknown>;
    }>().catch(() => null);
    if (!body?.name || !body.spacetype_id) {
      return c.json({ error_code: "bad_request", message: "name and spacetype_id are required" }, 400);
    }

    const result = await createBusinessForEndUser(env, {
      resellerProductSpaceId: productSpaceId,
      userId,
      name: body.name,
      spacetypeId: body.spacetype_id,
      ...(body.template_ids ? { templateIds: body.template_ids } : {}),
      ...(body.template_id ? { templateId: body.template_id } : {}),
      ...(body.config_overrides ? { configOverrides: body.config_overrides } : {}),
    });
    if (!result.ok) {
      return c.json({ error_code: result.error_code, message: result.message }, result.status);
    }

    await env.PLATFORM_DB.prepare(
      `INSERT INTO business_memberships (business_space_id, product_space_id, end_user_id, role, status, joined_at)
       VALUES (?, ?, ?, 'owner', 'active', datetime('now'))
       ON CONFLICT(business_space_id, end_user_id) DO NOTHING`
    ).bind(result.spaceId, productSpaceId, userId).run();
    await seedSpaceDoMember(env, result.spaceId, result.tenantId, userId, "owner");

    return c.json(
      { tenant_id: result.tenantId, space_id: result.spaceId, status: result.status, parent_tenant_id: result.parentTenantId },
      201
    );
  });

  // GET /spaces/:productSpaceId/my-businesses — the space switcher's list: every business (under
  // this product) the calling end user belongs to, from the business_memberships index (never
  // opens each business's own SpaceDO — that's exactly what this index exists to avoid at scale).
  app.get("/spaces/:productSpaceId/my-businesses", async (c) => {
    const env = c.env as BusinessRoutesEnv;
    const productSpaceId = c.req.param("productSpaceId");
    const { userId } = callerIdentity(c);
    if (!userId) return c.json({ error_code: "unauthorized", message: "Missing user" }, 401);

    // onboarding_status/template_id ride along from the space's own config_json rather than
    // costing a second round trip per business: Discover's most important call to action is
    // "finish setting this one up", and a business that was created but never configured does
    // nothing at all (its assistant has no account to read and no way to reach its owner). Both
    // are NULL for a business created before templates existed, which the UI reads as "nothing
    // left to do" — the honest default, since there is no checklist to point at.
    const { results } = await env.PLATFORM_DB.prepare(
      `SELECT m.business_space_id AS id, m.role, m.status AS membership_status, m.joined_at,
              s.name, s.status AS space_status,
              json_extract(s.config_json, '$.onboarding.status') AS onboarding_status,
              json_extract(s.config_json, '$.template_id') AS template_id
         FROM business_memberships m
         JOIN spaces s ON s.id = m.business_space_id
        WHERE m.product_space_id = ? AND m.end_user_id = ? AND m.status = 'active' AND s.status != 'deleted'
        ORDER BY m.joined_at ASC`
    ).bind(productSpaceId, userId).all();

    return c.json({ data: results, count: results.length });
  });

  // Step 18: GET /spaces/:productSpaceId/directory — a public-within-the-product directory of
  // ALL active businesses under this product (not just the caller's own), so a signed-in end user
  // can DISCOVER what others have built, but only NAVIGATE into their own. Deliberately scoped to
  // the product (businesses share one product root), NOT platform-wide — that would be a much
  // larger cross-product privacy decision (item 102's boundary). Safe projection only: id, name,
  // template_id, created_at — never owner identity, revenue, or any private metric. `is_mine` is
  // computed from the caller's own business_memberships so the shell can gate navigation.
  app.get("/spaces/:productSpaceId/directory", async (c) => {
    const env = c.env as BusinessRoutesEnv;
    const productSpaceId = c.req.param("productSpaceId");
    const { userId } = callerIdentity(c);
    if (!userId) return c.json({ error_code: "unauthorized", message: "Missing user" }, 401);
    const { results } = await env.PLATFORM_DB.prepare(
      `SELECT s.id, s.name,
              json_extract(s.config_json, '$.template_id') AS template_id,
              s.created_at,
              CASE WHEN m.end_user_id IS NOT NULL THEN 1 ELSE 0 END AS is_mine
         FROM spaces s
         LEFT JOIN business_memberships m
           ON m.business_space_id = s.id AND m.end_user_id = ? AND m.status = 'active'
        WHERE s.parent_space_id = ? AND s.status NOT IN ('deleted', 'error')
        ORDER BY s.created_at DESC
        LIMIT 200`
    ).bind(userId, productSpaceId).all();
    return c.json({ data: results, count: results.length });
  });

  // POST /spaces/:businessSpaceId/invites — owner/admin of the BUSINESS invites a collaborator by
  // email. Returns the raw token exactly once (never stored — only its hash, PBKDF2-password
  // precedent's lighter-weight sibling since this is a high-entropy random value, not a
  // user-chosen secret). The caller must resolve their OWN role on this business first, via the
  // same resolveEndUserBusinessRole gate requireBusinessMembership uses.
  app.post("/spaces/:businessSpaceId/invites", async (c) => {
    const env = c.env as BusinessRoutesEnv;
    const businessSpaceId = c.req.param("businessSpaceId");
    const { userId, role: callerPlatformRole } = callerIdentity(c);
    if (!userId) return c.json({ error_code: "unauthorized", message: "Missing user" }, 401);

    // Only a product_end_user caller needs the business-role check (a builder/team caller acting
    // on a business it owns is out of this phase's scope — invites are an end-user-business
    // feature).
    if (callerPlatformRole === "product_end_user") {
      const myRole = await resolveEndUserBusinessRole(env.PLATFORM_DB, businessSpaceId, userId);
      if (myRole !== "owner" && myRole !== "admin") {
        return c.json({ error_code: "forbidden", message: "Only a business owner or admin can invite" }, 403);
      }
    }

    const body = await c.req.json<{ email: string; role?: "member" | "admin" | "owner" }>().catch(() => null);
    if (!body?.email) return c.json({ error_code: "bad_request", message: "email is required" }, 400);

    const business = await env.PLATFORM_DB.prepare(
      "SELECT parent_space_id, tenant_id FROM spaces WHERE id = ? AND status != 'deleted'"
    ).bind(businessSpaceId).first<{ parent_space_id: string | null; tenant_id: string }>();
    if (!business?.parent_space_id) {
      return c.json({ error_code: "not_found", message: "Business not found" }, 404);
    }

    // Phase 4 (money): "a personal plan gates ... whether others may join" — the CALLER's own
    // personal-plan tier (the person issuing the invite, already confirmed owner/admin above)
    // must allow inviting at all. A builder/team caller (checked via callerPlatformRole above)
    // is unaffected — this only applies to a product_end_user acting as a business owner/admin.
    //
    // DELIBERATELY ONLY ENFORCED when the product actually has a real personalPlans checkout
    // configured (pc.pricingConfig.personalPlans non-empty) — this feature is brand new and no
    // existing end user has ever purchased a personal plan, so gating invites unconditionally
    // would instantly break every currently-working invite flow on every live business with no
    // way for anyone to fix it (there'd be nothing to upgrade TO). Matches this codebase's own
    // "never gate on a monetization control nobody can actually satisfy" precedent
    // (free_tier_eligible's own template-catalog gate has the identical shape).
    if (callerPlatformRole === "product_end_user") {
      const productRoot = await env.PLATFORM_DB.prepare(
        "SELECT tenant_id, spacetype_id, config_json FROM spaces WHERE id = ? AND status != 'deleted'"
      ).bind(business.parent_space_id).first<{ tenant_id: string; spacetype_id: string; config_json: string | null }>();
      if (productRoot) {
        const pc = await loadEffectiveProductConfig(env, productRoot.spacetype_id, productRoot.config_json);
        const hasRealUpgradePath = ((pc as { pricingConfig?: { personalPlans?: unknown[] } })?.pricingConfig?.personalPlans?.length ?? 0) > 0;
        if (hasRealUpgradePath) {
          const tier = await resolvePersonalPlanTier(env, business.parent_space_id, userId, productRoot.tenant_id);
          if (!canPersonalPlanInvite(tier)) {
            return c.json(
              { error_code: "personal_plan_invite_not_allowed", message: "Your personal plan doesn't allow inviting others yet — upgrade to invite collaborators." },
              403
            );
          }
        }
      }
    }

    const id = crypto.randomUUID();
    const token = randomToken();
    const tokenHash = await sha256Hex(token);
    const email = body.email.trim().toLowerCase();
    const expiresAt = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString();

    await env.PLATFORM_DB.prepare(
      `INSERT INTO business_invites (id, business_space_id, product_space_id, email, role, token_hash, invited_by, expires_at)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
    ).bind(id, businessSpaceId, business.parent_space_id, email, body.role ?? "member", tokenHash, userId, expiresAt).run();

    // F-15: email the invitee (best-effort). Resolve the product's slug for a clickable link.
    const product = await env.PLATFORM_DB.prepare(
      "SELECT product_slug FROM spaces WHERE id = ?"
    ).bind(business.parent_space_id).first<{ product_slug: string | null }>();
    await sendInviteEmail(env, business.tenant_id, businessSpaceId, email, businessSpaceId, token, product?.product_slug ?? null);

    return c.json({ id, token, expires_at: expiresAt }, 201);
  });

  // POST /spaces/:businessSpaceId/invites/:token/accept — the signed-in end user (their OWN
  // product session — see the router allowlist comment for why this is product_end_user-gated
  // rather than the plan's originally-sketched fully unauthenticated route: an invite grants
  // membership in something real, and this codebase's convention is to authenticate the accepting
  // identity rather than trust an emailed link alone) redeems a single-use, expiring token.
  app.post("/spaces/:businessSpaceId/invites/:token/accept", async (c) => {
    const env = c.env as BusinessRoutesEnv;
    const businessSpaceId = c.req.param("businessSpaceId");
    const token = c.req.param("token");
    const { userId } = callerIdentity(c);
    if (!userId) return c.json({ error_code: "unauthorized", message: "Missing user" }, 401);

    const tokenHash = await sha256Hex(token);
    const invite = await env.PLATFORM_DB.prepare(
      `SELECT id, role, expires_at, accepted_at FROM business_invites
        WHERE business_space_id = ? AND token_hash = ?`
    ).bind(businessSpaceId, tokenHash).first<{ id: string; role: string; expires_at: string; accepted_at: string | null }>();
    if (!invite) return c.json({ error_code: "not_found", message: "Invite not found" }, 404);
    if (invite.accepted_at) return c.json({ error_code: "already_accepted", message: "This invite has already been used" }, 409);
    if (new Date(invite.expires_at).getTime() < Date.now()) {
      return c.json({ error_code: "expired", message: "This invite has expired" }, 410);
    }

    const business = await env.PLATFORM_DB.prepare(
      "SELECT tenant_id, parent_space_id FROM spaces WHERE id = ? AND status != 'deleted'"
    ).bind(businessSpaceId).first<{ tenant_id: string; parent_space_id: string | null }>();
    if (!business?.parent_space_id) return c.json({ error_code: "not_found", message: "Business not found" }, 404);

    await env.PLATFORM_DB.prepare(
      "UPDATE business_invites SET accepted_at = datetime('now'), accepted_by = ? WHERE id = ?"
    ).bind(userId, invite.id).run();
    await env.PLATFORM_DB.prepare(
      `INSERT INTO business_memberships (business_space_id, product_space_id, end_user_id, role, status, invited_by, joined_at)
       VALUES (?, ?, ?, ?, 'active', NULL, datetime('now'))
       ON CONFLICT(business_space_id, end_user_id) DO UPDATE SET status = 'active', role = excluded.role`
    ).bind(businessSpaceId, business.parent_space_id, userId, invite.role).run();
    await seedSpaceDoMember(env, businessSpaceId, business.tenant_id, userId, invite.role);

    return c.json({ business_space_id: businessSpaceId, role: invite.role });
  });

  // GET /spaces/:businessSpaceId/business-members — a safe projection of business_memberships
  // (NOT the generic SpaceDO members proxy, which stays hardened builder-only per A1.16.10's
  // "never make product customers into SpaceDO members" rule — that rule is about the shared
  // PRODUCT ROOT, not a business the customer themselves owns; business_memberships is the
  // purpose-built index for exactly this population).
  app.get("/spaces/:businessSpaceId/business-members", async (c) => {
    const env = c.env as BusinessRoutesEnv;
    const businessSpaceId = c.req.param("businessSpaceId");
    const { userId, role: callerPlatformRole } = callerIdentity(c);
    if (!userId) return c.json({ error_code: "unauthorized", message: "Missing user" }, 401);

    if (callerPlatformRole === "product_end_user") {
      const myRole = await resolveEndUserBusinessRole(env.PLATFORM_DB, businessSpaceId, userId);
      if (!myRole) return c.json({ error_code: "forbidden", message: "Not a member of this business" }, 403);
    }

    const { results } = await env.PLATFORM_DB.prepare(
      "SELECT end_user_id, role, status, joined_at FROM business_memberships WHERE business_space_id = ? ORDER BY joined_at ASC"
    ).bind(businessSpaceId).all();
    return c.json({ data: results, count: results.length });
  });

  // DELETE /spaces/:businessSpaceId/business-members/:endUserId — owner/admin only; an owner can
  // never be removed this way (must transfer ownership first — out of this phase's scope, so
  // simply disallowed for now rather than left as a footgun).
  app.delete("/spaces/:businessSpaceId/business-members/:endUserId", async (c) => {
    const env = c.env as BusinessRoutesEnv;
    const businessSpaceId = c.req.param("businessSpaceId");
    const targetEndUserId = c.req.param("endUserId");
    const { userId, role: callerPlatformRole } = callerIdentity(c);
    if (!userId) return c.json({ error_code: "unauthorized", message: "Missing user" }, 401);

    if (callerPlatformRole === "product_end_user") {
      const myRole = await resolveEndUserBusinessRole(env.PLATFORM_DB, businessSpaceId, userId);
      if (myRole !== "owner" && myRole !== "admin") {
        return c.json({ error_code: "forbidden", message: "Only a business owner or admin can remove members" }, 403);
      }
    }

    const target = await env.PLATFORM_DB.prepare(
      "SELECT role FROM business_memberships WHERE business_space_id = ? AND end_user_id = ?"
    ).bind(businessSpaceId, targetEndUserId).first<{ role: string }>();
    if (!target) return c.json({ error_code: "not_found", message: "Not a member" }, 404);
    if (target.role === "owner") {
      return c.json({ error_code: "not_allowed", message: "The owner cannot be removed — transfer ownership first" }, 403);
    }

    await env.PLATFORM_DB.prepare(
      "DELETE FROM business_memberships WHERE business_space_id = ? AND end_user_id = ?"
    ).bind(businessSpaceId, targetEndUserId).run();

    return c.json({ deleted: true, business_space_id: businessSpaceId, end_user_id: targetEndUserId });
  });
}
