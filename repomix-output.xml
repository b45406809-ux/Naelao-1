// G-AX12: Token bucket rate limiter as a Durable Object.
// Replaces fixed-window counters — avoids boundary burst (N at end + N at start of window).
//
// Token bucket parameters per key:
//   capacity  = burst capacity (default: 2× per-minute rate)
//   rate      = refill rate in tokens/second = limit/60
//
// HTTP interface (internal):
//   POST /check  { key: string, limit: number } → { allowed: boolean, remaining: number, retry_after_ms: number }
//   POST /reset  { key: string }                → 204
//
// F7: the router used to route EVERY request on the platform through idFromName("global-rate-
// limiter") — a single DO serializing all traffic platform-wide. The router now shards by
// calling idFromName(bucketKey) itself, so each key gets its own DO instance and this table
// holds at most one row (this DO's own key). Since buckets were never pruned before (rows
// accumulated forever) and a sharded DO now holds exactly one key, an idle DO can free its
// storage entirely via an alarm instead of needing a sweeper.

import { DurableObject } from "cloudflare:workers";

interface BucketRow {
  key: string;
  tokens: number;
  last_refill_at: number; // unix ms
  capacity: number;
  rate_per_sec: number;
}

// How long a sharded bucket DO waits with no /check calls before it clears its own storage.
// Reset on every /check, so this only fires after genuine idle time, not mid-burst traffic.
const IDLE_CLEANUP_MS = 10 * 60 * 1000;

export class RateLimitDO extends DurableObject {
  private initialized = false;

  private ensureInit(): void {
    if (this.initialized) return;
    // Do NOT run PRAGMA journal_mode=WAL here — Cloudflare's SQLite-backed DO storage manages
    // its own journal mode and rejects this PRAGMA with "not authorized: SQLITE_AUTH", throwing
    // on every single call to this DO in production (confirmed via a live wrangler tail session
    // against a real deployment; the test suite's SQLite shim doesn't enforce this restriction,
    // so it was never caught by the ~1900 passing unit tests). CLAUDE.md's own DO SQLite Pattern
    // section used to instruct setting this — it does not apply to Cloudflare's real runtime.
    this.ctx.storage.sql.exec(`
      CREATE TABLE IF NOT EXISTS buckets (
        key           TEXT PRIMARY KEY,
        tokens        REAL NOT NULL,
        last_refill_at INTEGER NOT NULL,
        capacity      REAL NOT NULL,
        rate_per_sec  REAL NOT NULL
      )
    `);
    this.initialized = true;
  }

  override async fetch(request: Request): Promise<Response> {
    this.ensureInit();
    const url = new URL(request.url);

    if (request.method === "POST" && url.pathname === "/check") {
      const body = await request.json<{ key: string; limit: number }>();
      if (!body.key || !body.limit) {
        return Response.json({ error: "key and limit required" }, { status: 400 });
      }

      // Push the idle-cleanup alarm back on every call — it only actually fires once this
      // (now single-key) DO has seen no traffic for IDLE_CLEANUP_MS.
      await this.ctx.storage.setAlarm(Date.now() + IDLE_CLEANUP_MS);

      const perMinuteLimit = body.limit;
      const capacity = perMinuteLimit * 2; // allow burst up to 2× per-minute limit
      const ratePerSec = perMinuteLimit / 60;
      const nowMs = Date.now();

      // Fetch existing bucket or create default
      const rows = this.ctx.storage.sql
        .exec(`SELECT * FROM buckets WHERE key = ?`, body.key)
        .toArray() as unknown as BucketRow[];

      let bucket = rows[0];
      if (!bucket) {
        // New key — start with full bucket
        bucket = {
          key: body.key,
          tokens: capacity,
          last_refill_at: nowMs,
          capacity,
          rate_per_sec: ratePerSec,
        };
      }

      // Refill tokens based on elapsed time
      const elapsedSec = Math.max(0, (nowMs - bucket.last_refill_at) / 1000);
      const refilled = Math.min(capacity, bucket.tokens + elapsedSec * ratePerSec);

      if (refilled < 1) {
        // Not enough tokens — rate limited
        const retryAfterMs = Math.ceil((1 - refilled) / ratePerSec * 1000);
        this.ctx.storage.sql.exec(
          `INSERT OR REPLACE INTO buckets (key, tokens, last_refill_at, capacity, rate_per_sec)
           VALUES (?, ?, ?, ?, ?)`,
          body.key, refilled, nowMs, capacity, ratePerSec
        );
        return Response.json({ allowed: false, remaining: 0, retry_after_ms: retryAfterMs });
      }

      const newTokens = refilled - 1;
      this.ctx.storage.sql.exec(
        `INSERT OR REPLACE INTO buckets (key, tokens, last_refill_at, capacity, rate_per_sec)
         VALUES (?, ?, ?, ?, ?)`,
        body.key, newTokens, nowMs, capacity, ratePerSec
      );

      return Response.json({
        allowed: true,
        remaining: Math.floor(newTokens),
        retry_after_ms: 0,
      });
    }

    if (request.method === "POST" && url.pathname === "/reset") {
      const body = await request.json<{ key: string }>();
      if (body.key) {
        this.ctx.storage.sql.exec(`DELETE FROM buckets WHERE key = ?`, body.key);
      }
      return new Response(null, { status: 204 });
    }

    return Response.json({ error: "not_found" }, { status: 404 });
  }

  // Fires only after IDLE_CLEANUP_MS with no /check calls (each call reschedules it) — frees
  // this bucket's storage since a sharded DO holds exactly one key's row.
  override async alarm(): Promise<void> {
    this.ctx.storage.sql.exec("DELETE FROM buckets");
  }
}
</file>

<file path="workers/security-gateway/src/index.ts">
import { Hono } from "hono";
import { RateLimiterDO } from "@naelao/security/src/rate-limit-do.js";
import { wafMiddleware, securityHeaders } from "@naelao/security";
import { errorResponse } from "@naelao/http";

export { RateLimiterDO };

interface SecurityEnv {
  ENVIRONMENT: string;
  PLATFORM_SECRET: string;
  PLATFORM_DB: D1Database;
  RATE_LIMITER: DurableObjectNamespace;
  ROUTER_WORKER: Fetcher;
  RATE_LIMIT_GLOBAL: string;
  RATE_LIMIT_AUTH: string;
  RATE_LIMIT_TENANT: string;
}

// Private IP ranges that must not be fetched by tools
const PRIVATE_RANGES = [
  /^127\./,
  /^10\./,
  /^172\.(1[6-9]|2\d|3[01])\./,
  /^192\.168\./,
  /^169\.254\./,
  /^::1$/,
  /^fc00:/i,
  /^fe80:/i,
];

function isPrivateIp(ip: string): boolean {
  return PRIVATE_RANGES.some((r) => r.test(ip));
}

async function checkRateLimit(
  ns: DurableObjectNamespace,
  key: string,
  limit: number,
  windowMs: number
): Promise<{ allowed: boolean; retryAfterMs?: number }> {
  const doId = ns.idFromName(`rl:${key}`);
  const stub = ns.get(doId);
  const res = await stub.fetch("http://rl/", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ key, limit, windowMs }),
  });
  const data = await res.json<{ allowed: boolean; retryAfterMs?: number }>();
  return data;
}

// G-A11: Validate required secrets at startup
function validateEnv(env: SecurityEnv): void {
  if (!env.PLATFORM_SECRET) throw new Error("Missing required secret: PLATFORM_SECRET");
}

const app = new Hono<{ Bindings: SecurityEnv }>();

// Security headers on all responses
app.use("*", securityHeaders());
app.use("*", async (c, next) => { validateEnv(c.env); await next(); });

// WAF scan on all requests
app.use("*", wafMiddleware());

// Rate limit + proxy
app.all("*", async (c) => {
  const ip = c.req.header("cf-connecting-ip") ?? "unknown";
  const path = new URL(c.req.url).pathname;
  const tenantId = c.req.header("x-naelao-tenant-id");

  const globalLimit = Number(c.env.RATE_LIMIT_GLOBAL) || 1000;
  const authLimit = Number(c.env.RATE_LIMIT_AUTH) || 10;
  const tenantLimit = Number(c.env.RATE_LIMIT_TENANT) || 500;
  const windowMs = 60_000; // 1 minute

  // 1. IP-level global rate limit
  if (!isPrivateIp(ip)) {
    const globalCheck = await checkRateLimit(c.env.RATE_LIMITER, `ip:${ip}`, globalLimit, windowMs);
    if (!globalCheck.allowed) {
      const retryAfter = Math.ceil((globalCheck.retryAfterMs ?? windowMs) / 1000);
      return c.json(
        { error_code: "rate_limited", message: "Too many requests" },
        { status: 429, headers: { "Retry-After": String(retryAfter) } }
      );
    }
  }

  // 2. Stricter limit for auth endpoints
  if (path.startsWith("/v1/auth/")) {
    const authCheck = await checkRateLimit(c.env.RATE_LIMITER, `auth:${ip}`, authLimit, windowMs);
    if (!authCheck.allowed) {
      const retryAfter = Math.ceil((authCheck.retryAfterMs ?? windowMs) / 1000);
      return c.json(
        { error_code: "rate_limited", message: "Too many authentication attempts" },
        { status: 429, headers: { "Retry-After": String(retryAfter) } }
      );
    }
  }

  // 3. Per-tenant limit for authenticated requests
  if (tenantId) {
    const tenantCheck = await checkRateLimit(
      c.env.RATE_LIMITER,
      `tenant:${tenantId}`,
      tenantLimit,
      windowMs
    );
    if (!tenantCheck.allowed) {
      const retryAfter = Math.ceil((tenantCheck.retryAfterMs ?? windowMs) / 1000);
      return c.json(
        { error_code: "rate_limited", message: "Tenant rate limit exceeded" },
        { status: 429, headers: { "Retry-After": String(retryAfter) } }
      );
    }
  }

  // Forward to router worker
  return c.env.ROUTER_WORKER.fetch(c.req.raw);
});

app.onError((err, c) => errorResponse(err, c.req.header("x-request-id") ?? "unknown"));

export default {
  fetch: app.fetch,
} satisfies ExportedHandler<SecurityEnv>;
</file>

<file path="workers/spaces/src/do/BuilderAccountDO.ts">
// Three-Tier Platform Model (spec "Three-Tier Platform Model" / "How Builders Use Naelao"),
// Phase 1 (docs/spec-appendix/A1-script-agents-and-space-assistants.md §A1.17). One per builder
// (== tenant in this codebase's model), addressed via getDOName("builder", tenantId, tenantId,
// PLATFORM_SECRET) — the same HMAC-named pattern SpaceDO uses, so a builder account DO can't be
// enumerated by guessing a raw tenantId.
//
// Deliberately thin: this DO indexes a builder's products and holds their scoped API keys. It
// does NOT reimplement usage aggregation, invoicing, or rate limiting — those already exist
// platform-wide (@naelao/entitlements + Analytics Engine; reseller_ledger / GET
// /reseller/statement; workers/router/src/RateLimitDO.ts) and the Builder Dashboard API (Phase
// 3) calls into them directly rather than through this DO. Adding parallel tables here for any
// of the three would be the exact split-brain this whole effort is trying to avoid.
//
// Naming note: workers/agents/src/do/ProductDO.ts (a legacy Whop-niche singleton, distinct from
// this class) has since been retired entirely — this comment is left only as a historical marker
// in case old deployment docs still reference the name.

import { DurableObject } from "cloudflare:workers";

interface ApiKeyRow {
  id: string;
  name: string;
  key_hash: string;
  key_prefix: string;
  scopes: string; // JSON array
  last_used_at: string | null;
  expires_at: string | null;
  revoked_at: string | null;
  created_at: string;
}

async function sha256Hex(input: string): Promise<string> {
  const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(input));
  return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, "0")).join("");
}

export class BuilderAccountDO extends DurableObject {
  private initialized = false;

  private ensureInit(): void {
    if (this.initialized) return;
    this.ctx.storage.sql.exec(`
      CREATE TABLE IF NOT EXISTS products (
        product_space_id TEXT PRIMARY KEY,
        added_at          TEXT NOT NULL DEFAULT (datetime('now'))
      );

      CREATE TABLE IF NOT EXISTS api_keys (
        id            TEXT PRIMARY KEY,
        name          TEXT NOT NULL,
        key_hash      TEXT NOT NULL,
        key_prefix    TEXT NOT NULL,
        scopes        TEXT NOT NULL DEFAULT '[]',
        last_used_at  TEXT,
        expires_at    TEXT,
        revoked_at    TEXT,
        created_at    TEXT NOT NULL DEFAULT (datetime('now'))
      );
      CREATE INDEX IF NOT EXISTS idx_api_keys_hash ON api_keys(key_hash);
    `);
    this.initialized = true;
  }

  override async fetch(request: Request): Promise<Response> {
    this.ensureInit();
    const url = new URL(request.url);
    const method = request.method;

    // POST /products — index a product this builder owns (called once at launch).
    if (method === "POST" && url.pathname === "/products") {
      const body = await request.json<{ product_space_id: string }>();
      if (!body.product_space_id) {
        return Response.json({ error: "product_space_id is required" }, { status: 400 });
      }
      this.ctx.storage.sql.exec(
        "INSERT OR IGNORE INTO products (product_space_id) VALUES (?)",
        body.product_space_id
      );
      return Response.json({ ok: true }, { status: 201 });
    }

    // GET /products — this builder's product index.
    if (method === "GET" && url.pathname === "/products") {
      const rows = this.ctx.storage.sql
        .exec("SELECT product_space_id, added_at FROM products ORDER BY added_at DESC")
        .toArray() as unknown as { product_space_id: string; added_at: string }[];
      return Response.json({ data: rows });
    }

    // POST /api-keys — mint a new scoped builder API key. Returns the raw key exactly once;
    // only its SHA-256 hash and a short prefix (for UI display) are ever persisted.
    if (method === "POST" && url.pathname === "/api-keys") {
      const body = await request.json<{ name: string; scopes: string[]; expires_in_days?: number }>();
      if (!body.name || !Array.isArray(body.scopes) || body.scopes.length === 0) {
        return Response.json({ error: "name and at least one scope are required" }, { status: 400 });
      }
      const id = crypto.randomUUID();
      const rawKey = `nbk_${crypto.randomUUID().replace(/-/g, "")}`;
      const keyHash = await sha256Hex(rawKey);
      const keyPrefix = rawKey.slice(0, 11); // "nbk_" + 7 chars
      const now = new Date();
      const expiresAt = body.expires_in_days
        ? new Date(now.getTime() + body.expires_in_days * 86_400_000).toISOString()
        : null;
      this.ctx.storage.sql.exec(
        `INSERT INTO api_keys (id, name, key_hash, key_prefix, scopes, expires_at, created_at)
         VALUES (?, ?, ?, ?, ?, ?, ?)`,
        id, body.name, keyHash, keyPrefix, JSON.stringify(body.scopes), expiresAt, now.toISOString()
      );
      // key_hash is included for the calling worker route ONLY — it needs it to write the
      // builder_api_key_index routing row (migration 0045). The route strips it before the raw
      // client response goes out; it must never appear in a client-facing payload.
      return Response.json({
        id, key: rawKey, key_hash: keyHash, name: body.name, key_prefix: keyPrefix,
        scopes: body.scopes, last_used_at: null, expires_at: expiresAt, created_at: now.toISOString(),
      }, { status: 201 });
    }

    // GET /api-keys — list this builder's keys (never returns the raw key or its hash).
    if (method === "GET" && url.pathname === "/api-keys") {
      const rows = this.ctx.storage.sql
        .exec(
          `SELECT id, name, key_prefix, scopes, last_used_at, expires_at, created_at
           FROM api_keys WHERE revoked_at IS NULL ORDER BY created_at DESC`
        )
        .toArray() as unknown as ApiKeyRow[];
      return Response.json({
        data: rows.map((r) => ({ ...r, scopes: JSON.parse(r.scopes) as string[] })),
      });
    }

    // DELETE /api-keys/:id — revoke (soft delete; row kept for audit).
    const revokeMatch = url.pathname.match(/^\/api-keys\/([^/]+)$/);
    if (method === "DELETE" && revokeMatch?.[1]) {
      this.ctx.storage.sql.exec(
        "UPDATE api_keys SET revoked_at = ? WHERE id = ? AND revoked_at IS NULL",
        new Date().toISOString(), revokeMatch[1]
      );
      return new Response(null, { status: 204 });
    }

    // POST /api-keys/verify — internal: validateProductScope middleware (Phase 3) resolves a
    // Bearer nbk_... key to its scopes here before any /builder/* route runs.
    if (method === "POST" && url.pathname === "/api-keys/verify") {
      const body = await request.json<{ key: string }>();
      if (!body.key) return Response.json({ valid: false }, { status: 400 });
      const keyHash = await sha256Hex(body.key);
      const rows = this.ctx.storage.sql
        .exec(
          `SELECT id, scopes, expires_at FROM api_keys
           WHERE key_hash = ? AND revoked_at IS NULL`,
          keyHash
        )
        .toArray() as unknown as { id: string; scopes: string; expires_at: string | null }[];
      const row = rows[0];
      if (!row) return Response.json({ valid: false });
      if (row.expires_at && new Date(row.expires_at) < new Date()) {
        return Response.json({ valid: false });
      }
      this.ctx.storage.sql.exec(
        "UPDATE api_keys SET last_used_at = ? WHERE id = ?",
        new Date().toISOString(), row.id
      );
      return Response.json({ valid: true, key_id: row.id, scopes: JSON.parse(row.scopes) as string[] });
    }

    return Response.json({ error: "not_found" }, { status: 404 });
  }
}
</file>

<file path="workers/spaces/src/do/FeatureFlagDO.ts">
// G-AX08: Platform Feature Flag System for Gradual Rollouts.
// FeatureFlagDO stores all flags and evaluates them with targeting rules.
//
// Flag shape:
//   { flag_id, state: "on"|"off"|"rollout", enabled_pct, targeting_rules, updated_at }
// Targeting rule shape:
//   { attribute: "account_id"|"plan_tier"|"tenant_id", operator: "eq"|"in"|"ne", value: string|string[] }
//
// HTTP interface (internal):
//   POST /flags                  { flag_id, state, enabled_pct?, targeting_rules? } → 201
//   GET  /flags/:flagId          → flag row
//   DELETE /flags/:flagId        → 204
//   POST /evaluate               { flag_id, context: {account_id?, plan_tier?, tenant_id?} } → { enabled: boolean }
//
// Evaluation logic (O(1) for simple flags):
//   1. If state=off → false
//   2. If state=on → true
//   3. If state=rollout → check targeting_rules first; if matched → true, else hash(flag_id:account_id) % 100 < enabled_pct

import { DurableObject } from "cloudflare:workers";

interface FlagRow {
  flag_id: string;
  state: "on" | "off" | "rollout";
  enabled_pct: number;
  targeting_rules: string; // JSON array of TargetingRule
  updated_at: string;
}

interface TargetingRule {
  attribute: string;
  operator: "eq" | "in" | "ne";
  value: string | string[];
}

interface EvalContext {
  account_id?: string;
  plan_tier?: string;
  tenant_id?: string;
  [key: string]: string | undefined;
}

function evalRules(rules: TargetingRule[], ctx: EvalContext): boolean {
  for (const rule of rules) {
    const ctxVal = ctx[rule.attribute];
    if (ctxVal === undefined) continue;
    if (rule.operator === "eq" && ctxVal === rule.value) return true;
    if (rule.operator === "ne" && ctxVal !== rule.value) return true;
    if (rule.operator === "in" && Array.isArray(rule.value) && rule.value.includes(ctxVal)) return true;
  }
  return false;
}

async function deterministicPct(flagId: string, accountId: string): Promise<number> {
  const key = `${flagId}:${accountId}`;
  const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(key));
  const view = new DataView(buf);
  return view.getUint32(0, false) % 100;
}

export class FeatureFlagDO extends DurableObject {
  private initialized = false;

  private ensureInit(): void {
    if (this.initialized) return;
    this.ctx.storage.sql.exec(`
      CREATE TABLE IF NOT EXISTS flags (
        flag_id         TEXT PRIMARY KEY,
        state           TEXT NOT NULL DEFAULT 'off',
        enabled_pct     INTEGER NOT NULL DEFAULT 0,
        targeting_rules TEXT NOT NULL DEFAULT '[]',
        updated_at      TEXT NOT NULL DEFAULT (datetime('now'))
      )
    `);
    this.initialized = true;
  }

  override async fetch(request: Request): Promise<Response> {
    this.ensureInit();
    const url = new URL(request.url);
    const method = request.method;

    // POST /flags — create or update a flag
    if (method === "POST" && url.pathname === "/flags") {
      const body = await request.json<{
        flag_id: string;
        state: "on" | "off" | "rollout";
        enabled_pct?: number;
        targeting_rules?: TargetingRule[];
      }>();
      if (!body.flag_id || !body.state) {
        return Response.json({ error: "flag_id and state required" }, { status: 400 });
      }
      const now = new Date().toISOString();
      this.ctx.storage.sql.exec(
        `INSERT OR REPLACE INTO flags (flag_id, state, enabled_pct, targeting_rules, updated_at)
         VALUES (?, ?, ?, ?, ?)`,
        body.flag_id,
        body.state,
        body.enabled_pct ?? 0,
        JSON.stringify(body.targeting_rules ?? []),
        now
      );
      return Response.json({ flag_id: body.flag_id, state: body.state }, { status: 201 });
    }

    // GET /flags/:flagId
    const flagMatch = url.pathname.match(/^\/flags\/([^/]+)$/);
    if (method === "GET" && flagMatch?.[1]) {
      const rows = this.ctx.storage.sql
        .exec(`SELECT * FROM flags WHERE flag_id = ?`, flagMatch[1])
        .toArray() as unknown as FlagRow[];
      if (!rows[0]) return Response.json({ error: "not_found" }, { status: 404 });
      return Response.json({ ...rows[0], targeting_rules: JSON.parse(rows[0].targeting_rules) });
    }

    // DELETE /flags/:flagId
    if (method === "DELETE" && flagMatch?.[1]) {
      this.ctx.storage.sql.exec(`DELETE FROM flags WHERE flag_id = ?`, flagMatch[1]);
      return new Response(null, { status: 204 });
    }

    // GET /flags — list all flags
    if (method === "GET" && url.pathname === "/flags") {
      const rows = this.ctx.storage.sql
        .exec(`SELECT flag_id, state, enabled_pct, updated_at FROM flags ORDER BY flag_id`)
        .toArray() as unknown as Pick<FlagRow, "flag_id" | "state" | "enabled_pct" | "updated_at">[];
      return Response.json({ flags: rows });
    }

    // POST /evaluate — evaluate a flag for a given context
    if (method === "POST" && url.pathname === "/evaluate") {
      const body = await request.json<{ flag_id: string; context: EvalContext }>();
      if (!body.flag_id) return Response.json({ error: "flag_id required" }, { status: 400 });

      const rows = this.ctx.storage.sql
        .exec(`SELECT * FROM flags WHERE flag_id = ?`, body.flag_id)
        .toArray() as unknown as FlagRow[];

      if (!rows[0]) {
        // Unknown flags default to disabled
        return Response.json({ enabled: false, reason: "unknown_flag" });
      }

      const flag = rows[0];

      if (flag.state === "off") return Response.json({ enabled: false, reason: "disabled" });
      if (flag.state === "on") return Response.json({ enabled: true, reason: "enabled" });

      // state === "rollout"
      const rules: TargetingRule[] = JSON.parse(flag.targeting_rules);
      if (rules.length > 0 && evalRules(rules, body.context)) {
        return Response.json({ enabled: true, reason: "targeting_rule_match" });
      }

      const accountId = body.context.account_id ?? body.context.tenant_id ?? "anonymous";
      const pct = await deterministicPct(body.flag_id, accountId);
      const enabled = pct < flag.enabled_pct;
      return Response.json({ enabled, reason: `rollout_pct_${flag.enabled_pct}` });
    }

    return Response.json({ error: "not_found" }, { status: 404 });
  }
}
</file>

<file path="workers/spaces/src/do/LockDO.ts">
// G-BB34: Distributed lock via Durable Object.
// One LockDO instance per lock_name (use idFromName(lockName)).
//
// HTTP interface:
//   POST /acquire  { caller_id: string, ttl_ms?: number } → { acquired: boolean, holder?: string }
//   POST /release  { caller_id: string }                  → { released: boolean }
//   GET  /status                                          → { locked: boolean, holder?: string, expires_at?: number }
//
// Caller must release() when done. TTL (default 30s) auto-expires via alarm
// so a crashed caller does not hold the lock forever.

import { DurableObject } from "cloudflare:workers";

const DEFAULT_TTL_MS = 30_000;

export class LockDO extends DurableObject {
  private initialized = false;

  private ensureInit(): void {
    if (this.initialized) return;
    this.ctx.storage.sql.exec(`
      CREATE TABLE IF NOT EXISTS lock_state (
        id         INTEGER PRIMARY KEY CHECK (id = 1),
        holder     TEXT,
        expires_at INTEGER
      );
      INSERT OR IGNORE INTO lock_state (id, holder, expires_at) VALUES (1, NULL, NULL);
    `);
    this.initialized = true;
  }

  override async fetch(request: Request): Promise<Response> {
    this.ensureInit();
    const url = new URL(request.url);
    const nowMs = Date.now();

    if (request.method === "GET" && url.pathname === "/status") {
      const row = this.getLockRow();
      const locked = row.holder !== null && (row.expires_at ?? 0) > nowMs;
      return Response.json({
        locked,
        holder: locked ? row.holder : undefined,
        expires_at: locked ? row.expires_at : undefined,
      });
    }

    if (request.method === "POST" && url.pathname === "/acquire") {
      const body = await request.json<{ caller_id: string; ttl_ms?: number }>();
      if (!body.caller_id) {
        return Response.json({ error: "caller_id required" }, { status: 400 });
      }
      const ttlMs = body.ttl_ms ?? DEFAULT_TTL_MS;
      const row = this.getLockRow();

      // Check if lock is held by someone else and not expired
      if (row.holder !== null && row.holder !== body.caller_id && (row.expires_at ?? 0) > nowMs) {
        return Response.json({ acquired: false, holder: row.holder });
      }

      // Acquire (or re-acquire if caller already holds it or lock expired)
      const expiresAt = nowMs + ttlMs;
      this.ctx.storage.sql.exec(
        `UPDATE lock_state SET holder = ?, expires_at = ? WHERE id = 1`,
        body.caller_id,
        expiresAt
      );

      // Set alarm to auto-expire the lock
      await this.ctx.storage.setAlarm(expiresAt);

      return Response.json({ acquired: true });
    }

    if (request.method === "POST" && url.pathname === "/release") {
      const body = await request.json<{ caller_id: string }>();
      if (!body.caller_id) {
        return Response.json({ error: "caller_id required" }, { status: 400 });
      }
      const row = this.getLockRow();

      if (row.holder !== body.caller_id) {
        return Response.json({ released: false, reason: "caller does not hold the lock" });
      }

      this.ctx.storage.sql.exec(
        `UPDATE lock_state SET holder = NULL, expires_at = NULL WHERE id = 1`
      );
      await this.ctx.storage.deleteAlarm();
      return Response.json({ released: true });
    }

    return Response.json({ error: "not_found" }, { status: 404 });
  }

  override async alarm(): Promise<void> {
    this.ensureInit();
    const nowMs = Date.now();
    const row = this.getLockRow();
    // Only clear if TTL has actually elapsed
    if (row.holder !== null && (row.expires_at ?? 0) <= nowMs) {
      this.ctx.storage.sql.exec(
        `UPDATE lock_state SET holder = NULL, expires_at = NULL WHERE id = 1`
      );
    }
  }

  private getLockRow(): { holder: string | null; expires_at: number | null } {
    const rows = this.ctx.storage.sql
      .exec(`SELECT holder, expires_at FROM lock_state WHERE id = 1`)
      .toArray() as { holder: string | null; expires_at: number | null }[];
    return rows[0] ?? { holder: null, expires_at: null };
  }
}
</file>

<file path="workers/spaces/src/do/ProductUserDO.ts">
// Three-Tier Platform Model (spec "Three-Tier Platform Model" / Journey 1B), Phase 2
// (docs/spec-appendix/A1-script-agents-and-space-assistants.md §A1.17). ONE INSTANCE PER
// (productId, endUserId) — addressed getDOName("produser", `${productId}:${endUserId}`, tenantId,
// PLATFORM_SECRET). This is the platform's FIRST persistent, signed-in end-user concept: today a
// Launchpad end user is an anonymous session id with no durable identity, credit balance, or
// preferences. A Product end user is fully isolated even across products — the same human logging
// into two different builders' products gets two independent ProductUserDO instances (spec: end
// users' data is never shared across products, and never with Naelao's own platform users).
//
// AUTH MODEL (the open design decision the plan flagged, resolved here — do not re-infer):
// end users authenticate through the PRODUCT'S configured auth_provider (naelao-native / Clerk /
// custom-OIDC / SAML), which yields a stable end_user_id; this DO then mints a PRODUCT-SCOPED
// session token stored (hashed) in session_state. That token is validated against THIS DO, never
// against the platform-wide builder JWT. Builder-side actors (owners/admins/Team collaborators)
// keep using the existing JWT + space_members path — they are a structurally different population
// (same reasoning as CLAUDE.md #23's Bucket A/B split). This directly closes the currently-broken
// end-user chat-auth gap CLAUDE.md #23 flagged (widget/portal attach no credential today).
//
// The DO is intentionally auth-provider-agnostic: it never sees Clerk/OIDC/SAML secrets. The
// caller (Phase 3 router/portal wrapper) verifies the provider assertion, derives end_user_id,
// then asks this DO to open a session. Provider secrets live in the credentials vault.
//
// Credit ledger is a LEDGER, not a second source of truth for token→credit conversion: callers
// pass already-converted credits (the agent runtime owns tokensToCredits(), billing-core's single
// conversion point — CLAUDE.md #12). This DO only debits/credits and reports the running balance.

import { DurableObject } from "cloudflare:workers";
import { applyMigrations, type Migration } from "@naelao/db";

interface SessionRow {
  session_id: string;
  token_hash: string;
  auth_provider: string;
  created_at: string;
  expires_at: string;
  revoked_at: string | null;
}

interface LedgerRow {
  id: string;
  delta_credits: number;
  reason: string;
  model: string | null;
  balance_after: number;
  created_at: string;
}

const SESSION_TTL_MS = 30 * 86_400_000; // 30 days, refreshed on each verify

async function sha256Hex(input: string): Promise<string> {
  const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(input));
  return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, "0")).join("");
}

const MIGRATIONS: Migration[] = [
  {
    version: 1,
    description: "initial schema",
    // Do NOT run PRAGMA journal_mode here — Cloudflare's SQLite-backed DO storage manages its
    // own journal mode and rejects this PRAGMA with "not authorized: SQLITE_AUTH" (confirmed via
    // a live wrangler tail session against a real deployment; see SpaceDO.ts's identical fix).
    up: `
      CREATE TABLE IF NOT EXISTS session_state (
        session_id     TEXT PRIMARY KEY,
        token_hash     TEXT NOT NULL,
        auth_provider  TEXT NOT NULL DEFAULT 'naelao-native',
        created_at     TEXT NOT NULL DEFAULT (datetime('now')),
        expires_at     TEXT NOT NULL,
        revoked_at     TEXT
      );
      CREATE INDEX IF NOT EXISTS idx_session_token ON session_state(token_hash);

      CREATE TABLE IF NOT EXISTS credit_ledger (
        id             TEXT PRIMARY KEY,
        delta_credits  INTEGER NOT NULL,
        reason         TEXT NOT NULL,
        model          TEXT,
        balance_after  INTEGER NOT NULL,
        created_at     TEXT NOT NULL DEFAULT (datetime('now'))
      );

      CREATE TABLE IF NOT EXISTS conversation_refs (
        thread_id      TEXT NOT NULL,
        space_id       TEXT NOT NULL,
        session_id     TEXT,
        title          TEXT,
        created_at     TEXT NOT NULL DEFAULT (datetime('now')),
        PRIMARY KEY (space_id, thread_id)
      );

      CREATE TABLE IF NOT EXISTS preferences (
        key            TEXT PRIMARY KEY,
        value          TEXT NOT NULL,
        updated_at     TEXT NOT NULL DEFAULT (datetime('now'))
      );

      CREATE TABLE IF NOT EXISTS notification_queue (
        id             TEXT PRIMARY KEY,
        payload        TEXT NOT NULL,
        status         TEXT NOT NULL DEFAULT 'pending',
        created_at     TEXT NOT NULL DEFAULT (datetime('now'))
      );
    `,
  },
  {
    // Phase E (§A1.17): credit-pack purchases grant credits via a Lemon Squeezy webhook, which
    // can retry — without a dedupe key, a retry would double-grant. `launchpad_orders` has the
    // same problem solved with a `provider_event_id` unique partial index (D1); this is the
    // per-DO-SQLite equivalent for ProductUserDO's own credit_ledger.
    version: 2,
    description: "add idempotency_key to credit_ledger for webhook-safe grants",
    up: `
      ALTER TABLE credit_ledger ADD COLUMN idempotency_key TEXT;
      CREATE UNIQUE INDEX IF NOT EXISTS idx_credit_ledger_idempotency
        ON credit_ledger(idempotency_key) WHERE idempotency_key IS NOT NULL;
    `,
  },
  {
    // Phase 4 (money): the end user's own personal-plan tier — gates how many businesses THEY can
    // own under this product (business-create.ts's maxBusinessesPerEndUser combines with this) and
    // whether others may accept an invite into a business they own. Deliberately NOT stored in the
    // general-purpose `preferences` key-value table: preferences is end-user-writable through an
    // ordinary session-authenticated route, and plan_tier must only ever change via a real checkout
    // (or the internal grant route a webhook calls) — a separate, protected table makes that
    // impossible to conflate. Singleton row (id always 1, CHECK-enforced) — one tier per DO
    // instance, which is already exactly one (productId, endUserId) pair.
    version: 3,
    description: "add plan_state for the end user's own personal-plan tier",
    up: `
      CREATE TABLE IF NOT EXISTS plan_state (
        id         INTEGER PRIMARY KEY CHECK (id = 1),
        plan_tier  TEXT NOT NULL DEFAULT 'free',
        updated_at TEXT NOT NULL DEFAULT (datetime('now'))
      );
    `,
  },
];

export class ProductUserDO extends DurableObject {
  private initialized = false;

  private ensureInit(): void {
    if (this.initialized) return;
    applyMigrations(this.ctx.storage as never, MIGRATIONS);
    this.initialized = true;
  }

  /** Current balance = SUM of every ledger delta (the ledger is the source of truth). */
  private currentBalance(): number {
    const rows = this.ctx.storage.sql
      .exec("SELECT COALESCE(SUM(delta_credits), 0) AS bal FROM credit_ledger")
      .toArray() as unknown as { bal: number }[];
    return rows[0]?.bal ?? 0;
  }

  override async fetch(request: Request): Promise<Response> {
    this.ensureInit();
    const url = new URL(request.url);
    const method = request.method;

    // ── Sessions ──────────────────────────────────────────────────────────────
    // POST /sessions — open a product-scoped session. Caller has already verified the end user's
    // identity via the product's auth_provider; this mints an opaque token, stores only its hash.
    if (method === "POST" && url.pathname === "/sessions") {
      const body = await request.json<{ auth_provider?: string }>().catch(() => ({} as { auth_provider?: string }));
      const sessionId = crypto.randomUUID();
      const rawToken = `nps_${crypto.randomUUID().replace(/-/g, "")}${crypto.randomUUID().replace(/-/g, "")}`;
      const tokenHash = await sha256Hex(rawToken);
      const now = new Date();
      const expiresAt = new Date(now.getTime() + SESSION_TTL_MS).toISOString();
      this.ctx.storage.sql.exec(
        `INSERT INTO session_state (session_id, token_hash, auth_provider, created_at, expires_at)
         VALUES (?, ?, ?, ?, ?)`,
        sessionId, tokenHash, body.auth_provider ?? "naelao-native", now.toISOString(), expiresAt
      );
      // F-48: opportunistically prune long-expired sessions (14+ days past expiry) on the mint
      // path — far rarer than verify, so this bounds the session_state table without adding a
      // cron/alarm. An expired session is already unreachable (verify rejects it); this just keeps
      // the DO's own storage from accumulating dead rows indefinitely.
      const pruneBefore = new Date(now.getTime() - 14 * 86_400_000).toISOString();
      this.ctx.storage.sql.exec("DELETE FROM session_state WHERE expires_at < ?", pruneBefore);
      return Response.json({ session_id: sessionId, session_token: rawToken, expires_at: expiresAt }, { status: 201 });
    }

    // POST /sessions/verify — resolve a session token (sliding-window refresh on success).
    if (method === "POST" && url.pathname === "/sessions/verify") {
      const body = await request.json<{ session_token: string }>().catch(() => ({ session_token: "" }));
      if (!body.session_token) return Response.json({ valid: false }, { status: 400 });
      const tokenHash = await sha256Hex(body.session_token);
      const rows = this.ctx.storage.sql
        .exec(
          "SELECT session_id, expires_at, revoked_at FROM session_state WHERE token_hash = ?",
          tokenHash
        )
        .toArray() as unknown as { session_id: string; expires_at: string; revoked_at: string | null }[];
      const row = rows[0];
      if (!row || row.revoked_at) return Response.json({ valid: false });
      if (new Date(row.expires_at) < new Date()) return Response.json({ valid: false });
      // Sliding-window: extend the session on active use.
      const newExpiry = new Date(Date.now() + SESSION_TTL_MS).toISOString();
      this.ctx.storage.sql.exec(
        "UPDATE session_state SET expires_at = ? WHERE session_id = ?",
        newExpiry, row.session_id
      );
      return Response.json({ valid: true, session_id: row.session_id, expires_at: newExpiry });
    }

    // POST /sessions/revoke — sign out (single session, or all when session_id omitted).
    if (method === "POST" && url.pathname === "/sessions/revoke") {
      const body = await request.json<{ session_id?: string }>().catch(() => ({} as { session_id?: string }));
      const now = new Date().toISOString();
      if (body.session_id) {
        this.ctx.storage.sql.exec(
          "UPDATE session_state SET revoked_at = ? WHERE session_id = ? AND revoked_at IS NULL",
          now, body.session_id
        );
      } else {
        this.ctx.storage.sql.exec("UPDATE session_state SET revoked_at = ? WHERE revoked_at IS NULL", now);
      }
      return new Response(null, { status: 204 });
    }

    // ── Credits ───────────────────────────────────────────────────────────────
    // GET /credits/balance
    if (method === "GET" && url.pathname === "/credits/balance") {
      return Response.json({ balance_credits: this.currentBalance() });
    }

    // GET /plan-tier — Phase 4 (money): the end user's own personal-plan tier. No auth inside the
    // DO itself (matches this class's own established convention — every route here trusts its
    // caller, and it's the wrapping workers/spaces/src/index.ts route that gates who can reach
    // it). Defaults to 'free' when the singleton row hasn't been written yet (a brand-new DO).
    if (method === "GET" && url.pathname === "/plan-tier") {
      const row = this.ctx.storage.sql
        .exec("SELECT plan_tier FROM plan_state WHERE id = 1")
        .toArray() as unknown as { plan_tier: string }[];
      return Response.json({ plan_tier: row[0]?.plan_tier ?? "free" });
    }

    // POST /plan-tier/set — internal-only settor. The ONLY caller that should ever reach this is
    // the spaces worker's HMAC-gated /internal/personal-plan/grant route (after a real checkout,
    // mirroring /credits/grant's own webhook-driven precedent) — there is deliberately no
    // end-user-reachable "set my own tier" route anywhere, since that would let anyone grant
    // themselves the paid tier for free.
    if (method === "POST" && url.pathname === "/plan-tier/set") {
      const body = await request.json<{ plan_tier: string }>();
      if (body.plan_tier !== "free" && body.plan_tier !== "plus") {
        return Response.json({ error: "plan_tier must be 'free' or 'plus'" }, { status: 400 });
      }
      this.ctx.storage.sql.exec(
        `INSERT INTO plan_state (id, plan_tier, updated_at) VALUES (1, ?, datetime('now'))
         ON CONFLICT(id) DO UPDATE SET plan_tier = excluded.plan_tier, updated_at = excluded.updated_at`,
        body.plan_tier
      );
      return Response.json({ plan_tier: body.plan_tier });
    }

    // POST /credits/grant — top-up / initial allocation (positive delta). `idempotency_key` is
    // optional (internal callers with no retry risk can omit it) but REQUIRED for anything driven
    // by a webhook that Lemon Squeezy may redeliver (Phase E credit-pack purchases) — a repeat
    // call with the same key is a no-op, returning the balance as of the original grant.
    if (method === "POST" && url.pathname === "/credits/grant") {
      const body = await request.json<{ credits: number; reason?: string; idempotency_key?: string }>();
      if (!Number.isFinite(body.credits) || body.credits <= 0) {
        return Response.json({ error: "credits must be a positive number" }, { status: 400 });
      }
      if (body.idempotency_key) {
        const existing = this.ctx.storage.sql
          .exec("SELECT balance_after FROM credit_ledger WHERE idempotency_key = ?", body.idempotency_key)
          .toArray() as unknown as { balance_after: number }[];
        if (existing[0]) {
          return Response.json({ balance_credits: existing[0].balance_after, deduplicated: true }, { status: 200 });
        }
      }
      const balanceAfter = this.currentBalance() + Math.floor(body.credits);
      this.ctx.storage.sql.exec(
        `INSERT INTO credit_ledger (id, delta_credits, reason, balance_after, idempotency_key) VALUES (?, ?, ?, ?, ?)`,
        crypto.randomUUID(), Math.floor(body.credits), body.reason ?? "grant", balanceAfter, body.idempotency_key ?? null
      );
      return Response.json({ balance_credits: balanceAfter }, { status: 201 });
    }

    // POST /credits/deduct — debit already-converted credits (caller ran tokensToCredits). Fails
    // CLOSED: an over-draw is rejected, not silently allowed to go negative.
    // S0.6: `idempotency_key` is optional (mirrors /credits/grant above) but should be supplied
    // by any caller that might retry the same debit — NaelaoAgentDO.debitEndUserCredits passes
    // its runId, so a retried post-run debit (e.g. after a transient network error on the first
    // attempt got a response back late) is a no-op reusing the original ledger entry, not a
    // second charge for the same run. Shares the one credit_ledger.idempotency_key unique index
    // with /credits/grant — callers must use a distinctly-namespaced key (grant keys are already
    // prefixed e.g. "credit_pack:...."; deduct keys are prefixed "run:") so the two can never
    // collide with each other.
    if (method === "POST" && url.pathname === "/credits/deduct") {
      const body = await request.json<{ credits: number; reason?: string; model?: string; idempotency_key?: string }>();
      if (!Number.isFinite(body.credits) || body.credits <= 0) {
        return Response.json({ error: "credits must be a positive number" }, { status: 400 });
      }
      if (body.idempotency_key) {
        const existing = this.ctx.storage.sql
          .exec("SELECT balance_after FROM credit_ledger WHERE idempotency_key = ?", body.idempotency_key)
          .toArray() as unknown as { balance_after: number }[];
        if (existing[0]) {
          return Response.json({ balance_credits: existing[0].balance_after, deduplicated: true }, { status: 200 });
        }
      }
      const debit = Math.ceil(body.credits);
      const balance = this.currentBalance();
      if (debit > balance) {
        return Response.json({ error: "insufficient_credits", balance_credits: balance }, { status: 402 });
      }
      const balanceAfter = balance - debit;
      // F-47/F-50: the SELECT-then-INSERT above is already atomic within a single DO instance
      // (DO SQLite .exec is synchronous and there is no `await` between the dedup SELECT and this
      // INSERT, and a DO processes one request to completion before the next), so the audited
      // TOCTOU can't actually interleave here. As defense-in-depth against the unique-index path
      // (and any future refactor that introduces an await), catch a duplicate-key violation and
      // return the already-recorded balance instead of surfacing an error / double-debiting.
      try {
        this.ctx.storage.sql.exec(
          `INSERT INTO credit_ledger (id, delta_credits, reason, model, balance_after, idempotency_key) VALUES (?, ?, ?, ?, ?, ?)`,
          crypto.randomUUID(), -debit, body.reason ?? "agent_run", body.model ?? null, balanceAfter, body.idempotency_key ?? null
        );
      } catch (err) {
        if (body.idempotency_key) {
          const raced = this.ctx.storage.sql
            .exec("SELECT balance_after FROM credit_ledger WHERE idempotency_key = ?", body.idempotency_key)
            .toArray() as unknown as { balance_after: number }[];
          if (raced[0]) return Response.json({ balance_credits: raced[0].balance_after, deduplicated: true }, { status: 200 });
        }
        throw err;
      }
      return Response.json({ balance_credits: balanceAfter }, { status: 201 });
    }

    // POST /credits/clawback — F-29: reverse a refunded credit-pack grant. Unlike /credits/deduct
    // this does NOT fail closed on insufficient balance: if the buyer already spent some of the
    // refunded credits, the balance goes negative (they were refunded the money, so they genuinely
    // owe the value) rather than leaving free credits behind. Idempotent on idempotency_key.
    if (method === "POST" && url.pathname === "/credits/clawback") {
      const body = await request.json<{ credits: number; reason?: string; idempotency_key: string }>();
      if (!Number.isFinite(body.credits) || body.credits <= 0 || !body.idempotency_key) {
        return Response.json({ error: "credits (positive) and idempotency_key are required" }, { status: 400 });
      }
      const existing = this.ctx.storage.sql
        .exec("SELECT balance_after FROM credit_ledger WHERE idempotency_key = ?", body.idempotency_key)
        .toArray() as unknown as { balance_after: number }[];
      if (existing[0]) {
        return Response.json({ balance_credits: existing[0].balance_after, deduplicated: true }, { status: 200 });
      }
      const balanceAfter = this.currentBalance() - Math.ceil(body.credits);
      this.ctx.storage.sql.exec(
        `INSERT INTO credit_ledger (id, delta_credits, reason, balance_after, idempotency_key) VALUES (?, ?, ?, ?, ?)`,
        crypto.randomUUID(), -Math.ceil(body.credits), body.reason ?? "refund_clawback", balanceAfter, body.idempotency_key
      );
      return Response.json({ balance_credits: balanceAfter }, { status: 201 });
    }

    // ── Conversation refs (metadata only — the builder's gated conversation access reads these) ──
    if (method === "POST" && url.pathname === "/conversation-refs") {
      const body = await request.json<{ thread_id: string; space_id: string; session_id?: string; title?: string }>();
      if (!body.thread_id || !body.space_id) {
        return Response.json({ error: "thread_id and space_id are required" }, { status: 400 });
      }
      this.ctx.storage.sql.exec(
        `INSERT OR REPLACE INTO conversation_refs (thread_id, space_id, session_id, title, created_at)
         VALUES (?, ?, ?, ?, COALESCE((SELECT created_at FROM conversation_refs WHERE space_id = ? AND thread_id = ?), datetime('now')))`,
        body.thread_id, body.space_id, body.session_id ?? null, body.title ?? null, body.space_id, body.thread_id
      );
      return Response.json({ ok: true }, { status: 201 });
    }
    if (method === "GET" && url.pathname === "/conversation-refs") {
      const rows = this.ctx.storage.sql
        .exec("SELECT thread_id, space_id, session_id, title, created_at FROM conversation_refs ORDER BY created_at DESC")
        .toArray();
      return Response.json({ data: rows });
    }

    // ── Preferences ─────────────────────────────────────────────────────────────
    if (method === "PUT" && url.pathname === "/preferences") {
      const body = await request.json<{ key: string; value: unknown }>();
      if (!body.key) return Response.json({ error: "key is required" }, { status: 400 });
      this.ctx.storage.sql.exec(
        "INSERT OR REPLACE INTO preferences (key, value, updated_at) VALUES (?, ?, datetime('now'))",
        body.key, JSON.stringify(body.value ?? null)
      );
      return Response.json({ ok: true });
    }
    if (method === "GET" && url.pathname === "/preferences") {
      const rows = this.ctx.storage.sql
        .exec("SELECT key, value FROM preferences")
        .toArray() as unknown as { key: string; value: string }[];
      const prefs: Record<string, unknown> = {};
      for (const r of rows) prefs[r.key] = JSON.parse(r.value) as unknown;
      return Response.json({ preferences: prefs });
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    if (method === "POST" && url.pathname === "/notifications") {
      const body = await request.json<{ payload: unknown }>();
      this.ctx.storage.sql.exec(
        "INSERT INTO notification_queue (id, payload) VALUES (?, ?)",
        crypto.randomUUID(), JSON.stringify(body.payload ?? {})
      );
      return Response.json({ ok: true }, { status: 201 });
    }
    if (method === "GET" && url.pathname === "/notifications") {
      const rows = this.ctx.storage.sql
        .exec("SELECT id, payload, status, created_at FROM notification_queue WHERE status = 'pending' ORDER BY created_at ASC")
        .toArray() as unknown as { id: string; payload: string; status: string; created_at: string }[];
      return Response.json({ data: rows.map((r) => ({ ...r, payload: JSON.parse(r.payload) as unknown })) });
    }

    // ── GDPR Art. 20 — data portability. Full machine-readable dump of everything this DO holds
    // for this end user (mirrors the SpaceDO /me/export pattern, but for the product-user record). ──
    if (method === "GET" && url.pathname === "/export") {
      const sessions = this.ctx.storage.sql
        .exec("SELECT session_id, auth_provider, created_at, expires_at, revoked_at FROM session_state")
        .toArray();
      const ledger = this.ctx.storage.sql
        .exec("SELECT delta_credits, reason, model, balance_after, created_at FROM credit_ledger ORDER BY created_at ASC")
        .toArray() as unknown as LedgerRow[];
      const conversations = this.ctx.storage.sql
        .exec("SELECT thread_id, space_id, title, created_at FROM conversation_refs ORDER BY created_at ASC")
        .toArray();
      const prefRows = this.ctx.storage.sql
        .exec("SELECT key, value FROM preferences")
        .toArray() as unknown as { key: string; value: string }[];
      const preferences: Record<string, unknown> = {};
      for (const r of prefRows) preferences[r.key] = JSON.parse(r.value) as unknown;
      return Response.json({
        export_version: "1",
        exported_at: new Date().toISOString(),
        // Note: sessions exclude token_hash — never export credential material.
        sessions,
        credit_ledger: ledger,
        credit_balance: this.currentBalance(),
        conversations,
        preferences,
      });
    }

    // ── GDPR Art. 17 — right to erasure. The direct inverse of /export above: wipes exactly the
    // personal/behavioral data /export reports (sessions, conversation links, preferences).
    // credit_ledger is deliberately KEPT — it holds no PII (just delta_credits/reason/model/
    // balance_after/timestamps), and a financial/audit trail has its own legitimate-interest
    // retention basis distinct from "personal data" under Art. 17(3). This DO has no knowledge of
    // the caller's real email/display_name — those live in product_end_users (D1), anonymized by
    // the spaces-worker route that calls this. Idempotent: erasing twice is a no-op the second
    // time, never an error.
    if (method === "DELETE" && url.pathname === "/erase") {
      const sessionsDeleted = this.ctx.storage.sql.exec("SELECT COUNT(*) AS n FROM session_state").toArray()[0] as unknown as { n: number };
      const conversationsDeleted = this.ctx.storage.sql.exec("SELECT COUNT(*) AS n FROM conversation_refs").toArray()[0] as unknown as { n: number };
      this.ctx.storage.sql.exec("DELETE FROM session_state");
      this.ctx.storage.sql.exec("DELETE FROM conversation_refs");
      this.ctx.storage.sql.exec("DELETE FROM preferences");
      return Response.json({
        erased_at: new Date().toISOString(),
        sessions_deleted: sessionsDeleted?.n ?? 0,
        conversations_deleted: conversationsDeleted?.n ?? 0,
      });
    }

    return Response.json({ error: "not_found" }, { status: 404 });
  }
}

// Type-only re-exports for consumers that want the row shapes without importing cloudflare:workers.
export type { SessionRow, LedgerRow };
