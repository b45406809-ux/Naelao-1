    <h2>Building Your First Naelao App — A Complete Tutorial</h2>
    <div class="bar"></div>
    <p class="lead">This tutorial walks through building a complete Naelao App from scratch: a Weather Intelligence App
      that gives agents access to weather data. By the end, agents in any Space can call <span
        class="ic">get_current_weather</span> and <span class="ic">get_forecast</span> as MCP tools. The app has a
      dynamic UI showing today's weather dashboard.</p>

    <h3>Step 1 — Create the App Directory</h3>
    <pre><code>mkdir naelao-app-weather
cd naelao-app-weather
npm init -y
npm install hono @cloudflare/workers-types
npm install --save-dev wrangler typescript</code></pre>

    <h3>Step 2 — Write the MCP Server (index.ts)</h3>
    <pre><code><span class="cm">// src/index.ts — The MCP Server Worker</span>
import { Hono } from 'hono';

const app = new Hono&lt;{ Bindings: { WEATHER_API_KEY: string } }&gt;();

<span class="cm">// MCP tool definitions — agents read these to know what's available</span>
const TOOLS = [
  {
    name: 'get_current_weather',
    description: 'Get current weather conditions for a city. Use when user asks about current temperature, conditions, humidity, or wind.',
    inputSchema: {
      type: 'object',
      properties: {
        city: { type: 'string', description: 'City name (e.g., "London", "New York, NY")' },
        units: { type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius' }
      },
      required: ['city']
    }
  },
  {
    name: 'get_forecast',
    description: 'Get 5-day weather forecast for a city. Use when user asks about upcoming weather, weekend forecast, or planning around weather.',
    inputSchema: {
      type: 'object',
      properties: {
        city: { type: 'string', description: 'City name' },
        days: { type: 'number', minimum: 1, maximum: 5, default: 3 },
        units: { type: 'string', enum: ['celsius', 'fahrenheit'], default: 'celsius' }
      },
      required: ['city']
    }
  }
];

<span class="cm">// MCP Protocol: GET /mcp/tools — returns available tools
// naelao-mcp-hub calls this to discover what tools this app provides</span>
app.get('/mcp/tools', (c) => c.json({ tools: TOOLS }));

<span class="cm">// MCP Protocol: POST /mcp/tools/:name — execute a tool</span>
app.post('/mcp/tools/:name', async (c) => {
  const toolName = c.req.param('name');
  const params = await c.req.json();

  <span class="cm">// Validate the tool name against known tools</span>
  const tool = TOOLS.find(t => t.name === toolName);
  if (!tool) {
    return c.json({ error: `Unknown tool: ${toolName}` }, 404);
  }

  <span class="cm">// Validate required parameters</span>
  if (!params.city) {
    return c.json({ error: 'city is required' }, 400);
  }

  try {
    if (toolName === 'get_current_weather') {
      const weather = await fetchCurrentWeather(
        params.city, params.units ?? 'celsius', c.env.WEATHER_API_KEY
      );
      return c.json({ result: weather });
    }

    if (toolName === 'get_forecast') {
      const forecast = await fetchForecast(
        params.city, params.days ?? 3, params.units ?? 'celsius', c.env.WEATHER_API_KEY
      );
      return c.json({ result: forecast });
    }
  } catch (e) {
    return c.json({ error: `Weather API error: ${(e as Error).message}` }, 502);
  }

  return c.json({ error: 'Tool execution failed' }, 500);
});

async function fetchCurrentWeather(city: string, units: string, apiKey: string) {
  const unitParam = units === 'fahrenheit' ? 'imperial' : 'metric';
  const resp = await fetch(
    `https://api.openweathermap.org/data/2.5/weather?q=${encodeURIComponent(city)}&units=${unitParam}&appid=${apiKey}`
  );
  if (!resp.ok) throw new Error(`City not found: ${city}`);
  const data = await resp.json() as Record&lt;string, unknown&gt;;
  const main = data.main as Record&lt;string, number&gt;;
  const weather = (data.weather as Array&lt;Record&lt;string, string&gt;&gt;)[0];
  const wind = data.wind as Record&lt;string, number&gt;;

  return {
    city: data.name,
    country: (data.sys as Record&lt;string, string&gt;).country,
    temperature: Math.round(main.temp),
    feels_like: Math.round(main.feels_like),
    humidity: main.humidity,
    condition: weather.description,
    wind_speed: Math.round(wind.speed),
    units: units === 'fahrenheit' ? 'F' : 'C'
  };
}

async function fetchForecast(city: string, days: number, units: string, apiKey: string) {
  const unitParam = units === 'fahrenheit' ? 'imperial' : 'metric';
  const resp = await fetch(
    `https://api.openweathermap.org/data/2.5/forecast?q=${encodeURIComponent(city)}&units=${unitParam}&appid=${apiKey}&cnt=${days * 8}`
  );
  if (!resp.ok) throw new Error(`City not found: ${city}`);
  const data = await resp.json() as { list: unknown[] };

  <span class="cm">// Group by day (API returns 3-hour intervals)</span>
  const byDay: Record&lt;string, { temps: number[]; conditions: string[] }&gt; = {};
  for (const item of data.list) {
    const entry = item as Record&lt;string, unknown&gt;;
    const date = (entry.dt_txt as string).split(' ')[0];
    if (!byDay[date]) byDay[date] = { temps: [], conditions: [] };
    byDay[date].temps.push((entry.main as Record&lt;string, number&gt;).temp);
    byDay[date].conditions.push(
      ((entry.weather as Array&lt;Record&lt;string, string&gt;&gt;)[0]).description
    );
  }

  return {
    city,
    units: units === 'fahrenheit' ? 'F' : 'C',
    forecast: Object.entries(byDay).slice(0, days).map(([date, d]) => ({
      date,
      high: Math.round(Math.max(...d.temps)),
      low: Math.round(Math.min(...d.temps)),
      condition: d.conditions[Math.floor(d.conditions.length / 2)] <span class="cm">// midday condition</span>
    }))
  };
}

export default app;</code></pre>

