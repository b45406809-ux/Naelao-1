      <div class="fstep">
        <div class="fn">2</div>
        <div class="ft"><strong>Fulfillment Agent triggered</strong> — NaelaoAgentDO wakes up. The Stripe App queued a
          <span class="ic">naelao-agent-runs</span> message with the order data.</div>
      </div>
      <div class="fstep">
        <div class="fn">3</div>
        <div class="ft"><strong>Agent verifies payment</strong> — calls <span class="ic">verify_payment</span> MCP tool
          on Stripe App. If payment is confirmed and not already fulfilled, continues.</div>
      </div>
      <div class="fstep">
        <div class="fn">4</div>
        <div class="ft"><strong>Agent retrieves product</strong> — reads product files from R2 workspace (e.g., the PDF
          ebook) using the file-manager skill.</div>
      </div>
      <div class="fstep">
        <div class="fn">5</div>
        <div class="ft"><strong>Agent sends delivery email</strong> — calls email MCP tool. IF <span
            class="ic">customer_email_send</span> is in <span class="ic">requires_approval_for</span>, creates a
          Human-in-Loop checkpoint and notifies owner via Space Assistant. Otherwise sends automatically.</div>
      </div>
      <div class="fstep">
        <div class="fn">6</div>
        <div class="ft"><strong>Agent updates records</strong> — marks order as fulfilled in CRM (via MCP App), updates
          analytics (via Analytics Engine).</div>
      </div>
      <div class="fstep">
        <div class="fn">7</div>
        <div class="ft"><strong>Space Assistant notifies owner</strong> — "Order #1234 from customer@example.com was
          fulfilled. Product delivered at 14:32 UTC."</div>
      </div>
    </div>

    <h3>Human-in-the-Loop Checkpoints</h3>
    <p>Launchpad agents are Autopilot — they act autonomously BUT can be configured to pause at specific action types.
      The <span class="ic">requires_approval_for</span> field in the agent definition controls which actions require
      explicit human confirmation.</p>
    <pre><code><span class="cm">// durable-objects/agent-do.ts — Human-in-the-Loop implementation
// When agent hits an action that requires approval, it:
// 1. Pauses execution (runFiber() stops and waits)
// 2. Notifies owner via Space Assistant + push notification
// 3. Waits for /approve or /reject from the owner
// 4. Resumes or abandons based on response</span>

async requestApproval(params: {
  actionType: string;
  actionDescription: string;
  previewData: unknown;
  timeoutMs: number;
}): Promise&lt;{ approved: boolean; feedback?: string }&gt; {

  const approvalId = crypto.randomUUID();
  const deadline = Date.now() + params.timeoutMs;

  <span class="cm">// Store the pending approval</span>
  await this.ctx.storage.put(`approval:${approvalId}`, {
    status: 'pending',
    actionType: params.actionType,
    description: params.actionDescription,
    preview: params.previewData,
    deadline,
    createdAt: Date.now()
  });

  <span class="cm">// Notify the owner via Space Assistant</span>
  await this.env.NAELAO_NOTIFICATIONS_QUEUE.send({
    type: 'approval_required',
    spaceId: this.spaceId,
    approvalId,
    agentId: this.agentId,
    actionType: params.actionType,
    description: params.actionDescription,
    preview: params.previewData,
    approveUrl: `https://app.naelao.dev/approvals/${approvalId}/approve`,
    rejectUrl: `https://app.naelao.dev/approvals/${approvalId}/reject`,
    expiresAt: new Date(deadline).toISOString()
  });

  <span class="cm">// Wait for the approval decision using DO Alarm
  // The alarm fires at the deadline and auto-rejects if not responded to</span>
  await this.ctx.storage.setAlarm(deadline);

  <span class="cm">// runFiber() will resume when the approval endpoint is called
  // The fiber suspends here — DO can hibernate, costs $0 while waiting</span>
  return new Promise((resolve) => {
    this.pendingApprovals.set(approvalId, resolve);
  });
}

<span class="cm">// Called when owner clicks Approve/Reject in the UI</span>
async handleApprovalDecision(approvalId: string, decision: 'approve' | 'reject', feedback?: string): Promise&lt;void&gt; {
  const resolver = this.pendingApprovals.get(approvalId);
  if (resolver) {
    resolver({ approved: decision === 'approve', feedback });
    this.pendingApprovals.delete(approvalId);
  }
  await this.ctx.storage.delete(`approval:${approvalId}`);
}</code></pre>
