          <h2>naelao-spaces — Space CRUD, Hierarchy & Member Management</h2>
          <div class="bar"></div>
          <p class="lead"><code>naelao-spaces</code> owns the conceptual structure of the platform. It creates, reads,
            updates, and deletes Spaces and their sub-space trees. It enforces hierarchy rules (max 3 levels, quota per
            tier), manages members (invite/remove/role-change), and maintains the external resource registry for
            containers and third-party integrations. Every write touching the space graph goes through this Worker.</p>

          <div class="g2">
            <div class="box box-bl">
              <div class="box-lbl">SpaceDO: The Hot Cache</div>
              <p><code>SpaceDO</code> caches the single most-read datum: "does this user have access to this space and
                what is their role?" <code>naelao-spaces</code> writes to SpaceDO SQLite as source of truth — SpaceDO is the single authoritative store. Every auth check reads SpaceDO — the DO is the single source of truth for membership.</p>
            </div>
            <div class="box box-tl">
              <div class="box-lbl">Quota Enforcement</div>
              <p>Quota limits (max members, max sub-spaces, max projects) are checked in <code>naelao-spaces</code>
                before writing to SpaceDO. The check reads the count via spaceDO.getMemberCount(), preventing
                concurrent provisioning requests from racing past the limit.</p>
            </div>
          </div>

          <h3>Complete Worker Implementation</h3>
          <pre><code><span class="cm">// workers/spaces/index.ts</span>
import { Hono } from 'hono';
const app = new Hono&lt;{ Bindings: Env }&gt;();

const PLAN_QUOTAS = {
  free:       { maxSubSpaces: 1,   maxMembers: 3,    maxProjects: 5    },
  maker:      { maxSubSpaces: 3,   maxMembers: 10,   maxProjects: 25   },
  pro:        { maxSubSpaces: 10,  maxMembers: 50,   maxProjects: 100  },
  team:       { maxSubSpaces: 25,  maxMembers: 200,  maxProjects: 500  },
  enterprise: { maxSubSpaces: 999, maxMembers: 9999, maxProjects: 99999 },
} as const;

<span class="cm">// ── CREATE SPACE ─────────────────────────────────────────────</span>
app.post('/spaces', async (c) =&gt; {
  const { userId, name, spaceTypeId, parentSpaceId, config } = await c.req.json();
  const spaceDO = getProductDO(rootSpaceId, c.env);  // SpaceDO replaces Hyperdrive

  if (parentSpaceId) {
    const { rows: depthRows } = await db.query(
      `WITH RECURSIVE depth AS (
         SELECT id, parent_space_id, 1 AS level FROM spaces WHERE id = $1
         UNION ALL
         SELECT s.id, s.parent_space_id, d.level + 1 FROM spaces s JOIN depth d ON s.id = d.parent_space_id
       )
       SELECT MAX(level) AS depth FROM depth`,
      [parentSpaceId]
    );
    if ((depthRows[0]?.depth ?? 0) &gt;= 3) {
      return c.json({ error: 'Max sub-space depth (3 levels) exceeded' }, 400);
    }
    const plan = await getSpacePlan(parentSpaceId, db);
    const quota = PLAN_QUOTAS[plan as keyof typeof PLAN_QUOTAS];
    const { rows: cnt } = await db.query(
      `SELECT COUNT(*)::int AS count FROM spaces WHERE parent_space_id = $1`, [parentSpaceId]
    );
    if (cnt[0].count &gt;= quota.maxSubSpaces) {
      return c.json({ error: `Sub-space limit (${quota.maxSubSpaces}) reached for ${plan} plan` }, 400);
    }
  }

  const spaceId = crypto.randomUUID();
  await db.query(
    `INSERT INTO spaces (id, name, owner_id, space_type_id, parent_space_id, plan, status, created_at)
     VALUES ($1,$2,$3,$4,$5,'free','active',NOW())`,
    [spaceId, name, userId, spaceTypeId, parentSpaceId ?? null]
  );
  await db.query(`INSERT INTO space_members (space_id, user_id, role) VALUES ($1,$2,'owner')`, [spaceId, userId]);
  await db.query(`INSERT INTO space_credits (space_id, balance_usd) VALUES ($1, 5.00)`, [spaceId]);

  const spaceDO = c.env.NAELAO_SPACE_DO.get(c.env.NAELAO_SPACE_DO.idFromName(`space:${spaceId}`));
  await spaceDO.fetch(new Request('http://space/init', {
    method: 'POST',
    body: JSON.stringify({ spaceId, ownerId: userId, spaceTypeId, parentSpaceId })
  }));

  c.executionCtx.waitUntil(
    c.env.NAELAO_SPACE_TYPE_REGISTRY.get(
      c.env.NAELAO_SPACE_TYPE_REGISTRY.idFromName('global-registry')
    ).fetch(new Request('http://registry/provision', {
      method: 'POST',
      body: JSON.stringify({ spaceId, spaceTypeId, ownerId: userId, config })
    }))
  );

  return c.json({ spaceId, name, status: 'active' }, 201);
});

<span class="cm">// ── GET SPACE + SUB-SPACE TREE ───────────────────────────────</span>
app.get('/spaces/:spaceId', async (c) =&gt; {
  const { spaceId } = c.req.param();
  const spaceDO = getProductDO(rootSpaceId, c.env);  // SpaceDO replaces Hyperdrive

  const { rows } = await db.query(
    `WITH RECURSIVE tree AS (
       SELECT id, name, parent_space_id, space_type_id, plan, status, created_at, 0 AS depth
       FROM spaces WHERE id = $1
       UNION ALL
       SELECT s.id, s.name, s.parent_space_id, s.space_type_id, s.plan, s.status, s.created_at, t.depth+1
       FROM spaces s JOIN tree t ON s.parent_space_id = t.id
     )
     SELECT * FROM tree ORDER BY depth, name`,
    [spaceId]
  );
  if (!rows.length) return c.json({ error: 'Space not found' }, 404);

  const spaceDO = c.env.NAELAO_SPACE_DO.get(c.env.NAELAO_SPACE_DO.idFromName(`space:${spaceId}`));
  const { count: memberCount } = await (await spaceDO.fetch(new Request('http://space/member-count'))).json() as any;

  return c.json({ space: rows[0], subSpaces: rows.slice(1), memberCount });
});

<span class="cm">// ── INVITE MEMBER ────────────────────────────────────────────</span>
app.post('/spaces/:spaceId/members/invite', async (c) =&gt; {
  const { spaceId } = c.req.param();
  const { email, role } = await c.req.json();
  const spaceDO = getProductDO(rootSpaceId, c.env);  // SpaceDO replaces Hyperdrive

  const plan = await getSpacePlan(spaceId, db);
  const quota = PLAN_QUOTAS[plan as keyof typeof PLAN_QUOTAS];
  const { rows: cnt } = await db.query(`SELECT COUNT(*)::int AS count FROM space_members WHERE space_id=$1`, [spaceId]);
  if (cnt[0].count &gt;= quota.maxMembers) {
    return c.json({ error: `Member limit (${quota.maxMembers}) reached for ${plan} plan` }, 400);
  }

  const inviteToken = crypto.randomUUID();
  await db.query(
    `INSERT INTO space_invites (space_id, email, role, token, expires_at)
     VALUES ($1,$2,$3,$4, NOW() + INTERVAL '7 days')
     ON CONFLICT (space_id, email) DO UPDATE SET role=$3, token=$4, expires_at=NOW()+INTERVAL '7 days'`,
    [spaceId, email, role, inviteToken]
  );
  await c.env.NAELAO_NOTIFICATIONS_QUEUE.send({
    id: `invite-${inviteToken}`, type: 'space_invite', spaceId, channels: ['email'],
    to: email, role,
    message: `You've been invited to a Naelao Space as ${role}. Accept at: https://app.naelao.dev/invite/${inviteToken}`,
    priority: 'normal'
  });
  return c.json({ success: true, inviteToken });
});

app.post('/spaces/:spaceId/members/accept', async (c) =&gt; {
  const { token, userId } = await c.req.json();
  const spaceDO = getProductDO(rootSpaceId, c.env);  // SpaceDO replaces Hyperdrive
  const { rows } = await db.query(
    `DELETE FROM space_invites WHERE token=$1 AND expires_at&gt;NOW() RETURNING space_id, role`, [token]
  );
  if (!rows.length) return c.json({ error: 'Invalid or expired invite token' }, 400);

  await db.query(
    `INSERT INTO space_members (space_id, user_id, role, joined_at) VALUES ($1,$2,$3,NOW())
     ON CONFLICT (space_id, user_id) DO UPDATE SET role=EXCLUDED.role`,
    [rows[0].space_id, userId, rows[0].role]
  );
  const spaceDO = c.env.NAELAO_SPACE_DO.get(c.env.NAELAO_SPACE_DO.idFromName(`space:${rows[0].space_id}`));
  await spaceDO.fetch(new Request('http://space/invalidate-member-cache', { method: 'POST' }));
  return c.json({ success: true, spaceId: rows[0].space_id, role: rows[0].role });
});

app.delete('/spaces/:spaceId/members/:userId', async (c) =&gt; {
  const { spaceId, userId } = c.req.param();
  const spaceDO = getProductDO(rootSpaceId, c.env);  // SpaceDO replaces Hyperdrive
  const { rows } = await db.query(`SELECT role FROM space_members WHERE space_id=$1 AND user_id=$2`, [spaceId, userId]);
  if (!rows.length) return c.json({ error: 'Member not found' }, 404);
  if (rows[0].role === 'owner') return c.json({ error: 'Cannot remove space owner' }, 400);

  await db.query(`DELETE FROM space_members WHERE space_id=$1 AND user_id=$2`, [spaceId, userId]);
  const spaceDO = c.env.NAELAO_SPACE_DO.get(c.env.NAELAO_SPACE_DO.idFromName(`space:${spaceId}`));
  await spaceDO.fetch(new Request('http://space/invalidate-member-cache', { method: 'POST' }));
  return c.json({ success: true });
});

<span class="cm">// ── EXTERNAL RESOURCE REGISTRY ───────────────────────────────</span>
app.post('/spaces/:spaceId/resources/register', async (c) =&gt; {
  const { spaceId } = c.req.param();
  const { resourceType, name, endpoint, capabilities } = await c.req.json();
  const spaceDO = getProductDO(rootSpaceId, c.env);  // SpaceDO replaces Hyperdrive
  const resourceId = crypto.randomUUID();

  await db.query(
    `INSERT INTO space_resources (id, space_id, resource_type, name, endpoint, capabilities, status)
     VALUES ($1,$2,$3,$4,$5,$6,'active')`,
    [resourceId, spaceId, resourceType, name, endpoint, JSON.stringify(capabilities)]
  );
  const spaceDO = c.env.NAELAO_SPACE_DO.get(c.env.NAELAO_SPACE_DO.idFromName(`space:${spaceId}`));
  await spaceDO.fetch(new Request('http://space/resource-added', {
    method: 'POST', body: JSON.stringify({ resourceId, resourceType, name, capabilities })
  }));
  return c.json({ resourceId }, 201);
});

async function getSpacePlan(spaceId: string, db: any): Promise&lt;string&gt; {
  const { rows } = await db.query(`SELECT plan FROM spaces WHERE id=$1`, [spaceId]);
  return rows[0]?.plan ?? 'free';
}

export default app;</code></pre>

          <h3>Key Design Decisions</h3>
          <table class="t">
            <thead>
              <tr>
                <th>Decision</th>
                <th>Why</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="tl">Recursive CTE for hierarchy queries</td>
                <td>Postgres handles the tree traversal natively. The index on <code>parent_space_id</code> makes it
                  fast even at 3 levels deep and 10,000 spaces.</td>
              </tr>
              <tr>
                <td class="tl">SpaceDO invalidated on every member change</td>
                <td>The auth hot-path reads SpaceDO. Without invalidation, a removed member can still authenticate for
                  up to the DO's cache TTL. Invalidate on write; never stale-serve membership.</td>
              </tr>
              <tr>
                <td class="tl">Provisioner called via <code>waitUntil()</code></td>
                <td>Space creation returns immediately with the <code>spaceId</code>. The provisioner (which may spin up
                  DOs, write to R2, register portals) runs async. The user sees the Space instantly.</td>
              </tr>
              <tr>
                <td class="tl">$5 credit seeded on creation</td>
                <td>Users can start using the platform without a credit card. The first LLM calls are free. This is a
                  strategic acquisition cost, not an oversight.</td>
              </tr>
            </tbody>
          </table>
