    <!-- ══════════════════════════════════════════════════════
     §80 — NAELAO-EVAL: COMPLETE SPECIFICATION
═══════════════════════════════════════════════════════ -->
    <div class="sep"></div>
    <div class="sec" id="naelao-eval">
      <span class="sec-ey">80 — Worker Deep Dive: naelao-eval</span>
      <h2>naelao-eval — Benchmarking & QA (GAIA + Braintrust)</h2>
      <div class="bar"></div>
      <p class="lead">How do you know an agent is getting better? Or that a fine-tuned LoRA model for a Vertical Space
        didn't regress on core logic? The <code>naelao-eval</code> Worker is an automated testing harness for agents. It
        runs benchmark datasets (like GAIA) through isolated AgentDO threads, scores the outputs, and syncs metrics to
        Braintrust.</p>

      <div class="box box-t">
        <div class="box-lbl">The Evaluation Loop</div>
        <p>1. User or CI triggers an eval run.<br>
          2. <code>naelao-eval</code> reads a dataset (JSONL) from R2.<br>
          3. For each row, it creates a temporary <code>eval_thread</code> and runs the agent.<br>
          4. It passes the output to a <strong>Scorer</strong> (Exact Match, Regex, or LLM-as-a-Judge).<br>
          5. Results are written to SpaceDO SQLite (eval_runs table) and synced to Braintrust for visual analysis.</p>
      </div>

      <h3>Complete Implementation</h3>
      <pre><code><span class="cm">// workers/eval/index.ts</span>

import { Hono } from 'hono';

const app = new Hono&lt;{ Bindings: Env }&gt;();

app.post('/eval/run', async (c) =&gt; {
  const { spaceId, agentDefinitionId, datasetPath, scorerType } = await c.req.json();
  
  <span class="cm">// Fire and forget the evaluation runner</span>
  c.executionCtx.waitUntil(
    runEvaluationSuite({ spaceId, agentDefinitionId, datasetPath, scorerType, env: c.env })
  );

  return c.json({ status: 'started', datasetPath });
});

async function runEvaluationSuite(params: EvalParams) {
  const { spaceId, agentDefinitionId, datasetPath, scorerType, env } = params;

  <span class="cm">// 1. Load dataset from R2 Workspace (e.g., spaces/{spaceId}/evals/dataset.jsonl)</span>
  const datasetFile = await env.NAELAO_WORKSPACE.get(datasetPath);
  if (!datasetFile) throw new Error("Dataset not found");
  
  const rawData = await datasetFile.text();
  const dataset = rawData.split('\n').filter(Boolean).map(line => JSON.parse(line));

  let passed = 0;
  const results = [];

  <span class="cm">// 2. Run test cases</span>
  for (const testCase of dataset) {
    <span class="cm">// Create a strictly isolated thread for this test</span>
    const testThreadId = `eval-${crypto.randomUUID()}`;
    const agentDoId = env.NAELAO_AGENT_DO.idFromName(`${spaceId}:eval-project:${testThreadId}`);
    const agentDO = env.NAELAO_AGENT_DO.get(agentDoId);

    <span class="cm">// Execute the agent synchronously for the eval</span>
    const agentResp = await agentDO.fetch(new Request('http://agent/run-sync', {
      method: 'POST',
      body: JSON.stringify({ 
        input: testCase.input, 
        agentDefinitionId 
      })
    })).then(r => r.json());

    const actualOutput = agentResp.finalMessage;

    <span class="cm">// 3. Score the output</span>
    const score = await evaluateOutput(actualOutput, testCase.expected, scorerType, env);
    if (score.passed) passed++;

    results.push({
      input: testCase.input,
      expected: testCase.expected,
      actual: actualOutput,
      score
    });
  }

  const finalScore = (passed / dataset.length) * 100;

  <span class="cm">// 4. Sync results to SpaceDO SQLite (eval_runs table)</span>
  const spaceDO = getProductDO(rootSpaceId, env);  // SpaceDO replaces Hyperdrive
  await db.query(
    `INSERT INTO eval_runs (space_id, agent_definition_id, dataset, score, details, created_at)
     VALUES ($1, $2, $3, $4, $5, NOW())`,
    [spaceId, agentDefinitionId, datasetPath, finalScore, JSON.stringify(results)]
  );

  <span class="cm">// 5. Sync to Braintrust (Enterprise ML observability)</span>
  if (env.BRAINTRUST_API_KEY) {
    await fetch('https://api.braintrust.dev/v1/experiment', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${env.BRAINTRUST_API_KEY}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        project_name: `naelao-${spaceId}`,
        experiment_name: `eval-${agentDefinitionId}-${Date.now()}`,
        metrics: { accuracy: finalScore },
        records: results
      })
    });
  }
}

<span class="cm">// ── Scorers ──</span>
async function evaluateOutput(
  actual: string, 
  expected: string, 
  type: 'exact' | 'includes' | 'llm-judge',
  env: Env
): Promise&lt;{ passed: boolean; reason?: string }&gt; {
  
  if (type === 'exact') {
    return { passed: actual.trim() === expected.trim() };
  }
  
  if (type === 'includes') {
    return { passed: actual.includes(expected) };
  }
  
  if (type === 'llm-judge') {
    <span class="cm">// Use LLM-as-a-judge to evaluate semantic correctness (e.g. for long-form text)</span>
    const judgement = await env.AI_GATEWAY.messages.create({
      model: 'claude-haiku-4-5',
      system: 'You are an objective evaluator. Compare the ACTUAL output to the EXPECTED output. Does the actual output correctly and accurately satisfy the expected criteria? Respond with JSON: {"passed": boolean, "reason": "string"}',
      messages: [{ 
        role: 'user', 
        content: `EXPECTED:\n${expected}\n\nACTUAL:\n${actual}` 
      }]
    });
    return JSON.parse(judgement.content[0].text);
  }

  return { passed: false, reason: "Unknown scorer type" };
}

export default app;</code></pre>

      <h3>GAIA Benchmark Dataset Format</h3>
      <p>Naelao uses the GAIA benchmark (General AI Assistants) as its primary quality gate. The GAIA JSONL format must
        be prepared and uploaded to the Space's eval workspace before running benchmarks. Each row contains a real-world
        task, the expected answer, and metadata about how hard it is.</p>
      <pre><code><span class="cm">// Format: spaces/{spaceId}/evals/gaia-validation.jsonl</span>
<span class="cm">// Each line is a JSON object (NOT an array — one JSON object per line):</span>

{"id":"gaia-001","level":1,"input":"What is the total number of words in the Gettysburg Address?","expected":"272","scorer":"exact","metadata":{"source":"gaia","category":"counting","toolsNeeded":[]}}
{"id":"gaia-002","level":2,"input":"Search for the current CEO of Anthropic and tell me their first name.","expected":"Dario","scorer":"includes","metadata":{"source":"gaia","category":"web-search","toolsNeeded":["web_search"]}}
{"id":"gaia-003","level":3,"input":"Download the S&P 500 closing prices for the last 5 trading days, compute the average, and write it to a file called 'sp500-avg.txt'.","expected":"sp500-avg.txt","scorer":"file-exists","metadata":{"source":"gaia","category":"data-processing","toolsNeeded":["browser_navigate","execute_python","write_file"]}}

<span class="cm">// Level 1: Reasoning only (no tools needed)</span>
<span class="cm">// Level 2: 1-2 tool calls needed (web search, file read)</span>
<span class="cm">// Level 3: Multi-step tasks requiring planning across 3+ tools</span>

<span class="cm">// Custom scorers beyond exact/includes/llm-judge:</span>
<span class="cm">// "file-exists": checks if the agent wrote a file with the expected name to the workspace</span>
<span class="cm">// "json-field": parses agent output as JSON and checks a specific field value</span>
<span class="cm">// "numeric-within": checks if numeric output is within a tolerance band</span></code></pre>

      <h3>Extended Scorer Types</h3>
      <pre><code><span class="cm">// Extended scorers for eval/index.ts</span>

async function evaluateOutput(
  actual: string,
  testCase: EvalRow,
  env: Env,
  spaceId: string
): Promise&lt;{ passed: boolean; reason?: string }&gt; {

  const { expected, scorer } = testCase;

  if (scorer === 'file-exists') {
    <span class="cm">// Check if the agent wrote a file with this name to the eval workspace</span>
    const key = `spaces/${spaceId}/evals/temp/${expected}`;
    const obj = await env.NAELAO_WORKSPACE.get(key);
    return { 
      passed: obj !== null,
      reason: obj ? 'File found' : `File '${expected}' not found in eval workspace` 
    };
  }

  if (scorer === 'json-field') {
    <span class="cm">// testCase.expected format: "fieldName:expectedValue"</span>
    const [fieldName, expectedValue] = expected.split(':');
    try {
      const parsed = JSON.parse(actual);
      const actual_value = String(parsed[fieldName]);
      return { passed: actual_value === expectedValue };
    } catch {
      return { passed: false, reason: 'Agent output is not valid JSON' };
    }
  }

  if (scorer === 'numeric-within') {
    <span class="cm">// testCase.expected format: "value±tolerance" e.g. "42.5±0.5"</span>
    const [valueStr, toleranceStr] = expected.split('±');
    const target = parseFloat(valueStr);
    const tolerance = parseFloat(toleranceStr ?? '0.01');
    const actual_num = parseFloat(actual.replace(/[^0-9.-]/g, ''));
    return { passed: Math.abs(actual_num - target) &lt;= tolerance };
  }

  <span class="cm">// fallback to standard scorers</span>
  if (scorer === 'exact') return { passed: actual.trim() === expected.trim() };
  if (scorer === 'includes') return { passed: actual.includes(expected) };
  
  return { passed: false, reason: 'Unknown scorer' };
}</code></pre>

      <h3>CI Integration — GitHub Actions Trigger</h3>
      <p>The eval Worker exposes a <code>/eval/run</code> endpoint that CI calls after every deployment. If the score
        drops below the threshold, the deployment is blocked.</p>
      <pre><code><span class="cm"># .github/workflows/eval-gate.yml</span>
name: Eval Gate

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  eval:
    runs-on: ubuntu-latest
    steps:
      - name: Run GAIA Benchmark
        id: eval
        run: |
          RESULT=$(curl -s -X POST \
            https://api.naelao.dev/v1/eval/run \
            -H "Authorization: Bearer ${{ secrets.NAELAO_CI_TOKEN }}" \
            -H "Content-Type: application/json" \
            -d '{
              "spaceId": "${{ vars.EVAL_SPACE_ID }}",
              "agentDefinitionId": "platform-default-agent",
              "datasetPath": "spaces/${{ vars.EVAL_SPACE_ID }}/evals/gaia-validation.jsonl",
              "scorerType": "auto",
              "waitForCompletion": true,
              "timeoutSeconds": 300
            }')
          
          SCORE=$(echo $RESULT | jq '.score')
          echo "eval_score=$SCORE" >> $GITHUB_OUTPUT
          echo "Eval Score: $SCORE%"

      - name: Check Eval Threshold
        run: |
          SCORE="${{ steps.eval.outputs.eval_score }}"
          THRESHOLD=70  # 70% pass rate required on GAIA validation
          
          if (( $(echo "$SCORE < $THRESHOLD" | bc -l) )); then
            echo "❌ Eval score $SCORE% is below threshold $THRESHOLD%"
            exit 1
          fi
          echo "✅ Eval score $SCORE% passes threshold"

      - name: Comment Score on PR
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: '🤖 **Eval Score:** ${{ steps.eval.outputs.eval_score }}% on GAIA validation set'
            })</code></pre>

      <h3>Regression Tracking — Score History</h3>
      <p>The eval Worker stores every run result in the SpaceDO SQLite <code>eval_runs</code> table. The
        <code>naelao-admin</code> dashboard plots this over time, making it immediately visible when a new deployment
        causes a quality regression.</p>
      <pre><code><span class="cm">// SpaceDO SQLite: eval_runs table (add to SpaceDO constructor schema)</span>
CREATE TABLE IF NOT EXISTS eval_runs (
  id                    UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  space_id              TEXT NOT NULL,
  agent_definition_id   TEXT NOT NULL,
  dataset               TEXT NOT NULL,        <span class="cm">-- R2 key of the dataset JSONL</span>
  scorer_type           TEXT NOT NULL,
  score                 REAL NOT NULL,         <span class="cm">-- 0-100</span>
  cases_total           INTEGER NOT NULL,
  cases_passed          INTEGER NOT NULL,
  details               JSONB,                <span class="cm">-- Full result array for drill-down</span>
  braintrust_experiment TEXT,                <span class="cm">-- Link to Braintrust for visual analysis</span>
  git_sha               TEXT,                <span class="cm">-- Git SHA at time of run (from CI env var)</span>
  created_at            TIMESTAMPTZ DEFAULT NOW()
);

<span class="cm">-- Query for score history (used in admin dashboard chart)</span>
SELECT 
  DATE_TRUNC('day', created_at) as day,
  AVG(score) as avg_score,
  MIN(score) as min_score,
  MAX(score) as max_score
FROM eval_runs
WHERE space_id = $1 AND agent_definition_id = $2
  AND created_at > NOW() - INTERVAL '30 days'
GROUP BY 1
ORDER BY 1;</code></pre>

      <div class="box box-gr">
        <div class="box-lbl">Eval Isolation — Why Agent Threads Are Temporary</div>
        <p>Each eval test case creates a fresh <code>eval_thread</code> AgentDO instance via <code>idFromName</code>
          with a unique UUID. This ensures test cases don't bleed into each other — memory from test case 1 cannot
          influence test case 2. After the eval run completes, naelao-sweeper deletes these temporary DO instances on
          its next pass. The isolation also ensures that eval runs cannot access real user workspace data — the eval
          AgentDO has no access to the Space's primary R2 paths.</p>
      </div>

      <!-- ══════════════════════════════════════════════════════
     §81 — NAELAO-CATEGORIZER & FEEDBACK
═══════════════════════════════════════════════════════ -->
      <div class="sep"></div>
      <div class="sec" id="naelao-categorizer-feedback">
        <span class="sec-ey">81 — Worker Deep Dive</span>
        <h2>Categorizer & Feedback — Background Intelligence</h2>
        <div class="bar"></div>
        <p class="lead">Conversations generate massive amounts of unstructured data. The <code>naelao-categorizer</code>
          and <code>naelao-feedback</code> Workers process this data in the background. They auto-tag projects for the
          UI, analyze user satisfaction, and calculate quality scores for self-authored agent skills without blocking
          the critical path of the chat loop.</p>

        <div class="g2">
          <div class="box box-c">
            <div class="box-lbl">naelao-categorizer</div>
            <p>A cron-driven worker that scans recently active projects, reads the last few messages, and uses a fast,
              cheap LLM (Haiku) to generate tags, summaries, and intent categories. It updates the SpaceDO SQLite
              <code>projects</code> table so the user's dashboard is always neatly organized.</p>
          </div>
          <div class="box box-am">
            <div class="box-lbl">naelao-feedback</div>
            <p>An API endpoint that receives explicit user feedback (thumbs up/down, retry requests, or text feedback).
              It maps this feedback directly back to the <em>specific skill or tool</em> the agent used, updating the
              <code>SkillRegistryDO</code> reputation scores.</p>
          </div>
        </div>

        <h3>Categorizer Implementation</h3>
        <pre><code><span class="cm">// workers/categorizer/index.ts</span>
export default {
  <span class="cm">// Triggered by a CF Cron (e.g., hourly)</span>
  async scheduled(event: ScheduledEvent, env: Env): Promise&lt;void&gt; {
    const spaceDO = getProductDO(rootSpaceId, env);  // SpaceDO replaces Hyperdrive

    <span class="cm">// 1. Fetch stale projects using the stored function from §57</span>
    const staleProjects = await db.query(
      'SELECT * FROM get_stale_projects_for_categorization(50)'
    );

    if (staleProjects.rows.length === 0) return;

    <span class="cm">// 2. Process in parallel, capped at 10 concurrent LLM calls to avoid rate limits</span>
    const limit = pLimit(10);
    await Promise.all(
      staleProjects.rows.map(project =&gt; limit(() =&gt; categorizeProject(project, env, db)))
    );
  }
};

async function categorizeProject(project: any, env: Env, db: any) {
  <span class="cm">// Fetch recent messages for context</span>
  const messages = await db.query(
    `SELECT role, content FROM messages 
     WHERE project_id = $1 AND space_id = $2 
     ORDER BY created_at DESC LIMIT 10`,
    [project.project_id, project.space_id]
  );

  const conversationText = messages.rows.reverse()
    .map((m: any) =&gt; `${m.role}: ${m.content.slice(0, 500)}`)
    .join('\n');

  <span class="cm">// LLM Call to generate tags and summary</span>
  const completion = await env.AI_GATEWAY.messages.create({
    model: 'claude-haiku-4-5',
    max_tokens: 150,
    system: 'You are an auto-categorizer. Return JSON: {"tags": string[], "summary": "short title"}',
    messages: [{ role: 'user', content: conversationText }]
  });

  try {
    const { tags, summary } = JSON.parse(completion.content[0].text);

    <span class="cm">// Update the project record</span>
    await db.query(
      `UPDATE projects SET tags = $1, summary = $2, last_categorized_at = NOW() 
       WHERE id = $3 AND space_id = $4`,
      [tags, summary, project.project_id, project.space_id]
    );
  } catch (e) {
    console.error(`Categorization failed for project ${project.project_id}`, e);
  }
}</code></pre>

        <h3>Feedback Implementation (Skill Scoring)</h3>
        <pre><code><span class="cm">// workers/feedback/index.ts</span>
import { Hono } from 'hono';

const app = new Hono&lt;{ Bindings: Env }&gt;();

app.post('/feedback', async (c) =&gt; {
  const { spaceId, agentId, messageId, score, text, toolUsed } = await c.req.json();
  <span class="cm">// score: 1 for thumbs up, -1 for thumbs down</span>

  <span class="cm">// 1. Write immutable log to Analytics Engine</span>
  await c.env.NAELAO_ANALYTICS_QUEUE.send({
    type: 'user_feedback',
    spaceId, agentId,
    metadata: { messageId, toolUsed, score: score.toString(), text }
  });

  <span class="cm">// 2. If a specific tool was used, update its reputation in SkillRegistryDO</span>
  if (toolUsed) {
    const registryId = c.env.NAELAO_SKILL_REGISTRY.idFromName(`skills:${spaceId}:${agentId}`);
    const registryDO = c.env.NAELAO_SKILL_REGISTRY.get(registryId);
    
    <span class="cm">// The DO updates a moving average rating for the skill. 
    // If an agent-authored skill drops below a 2.0 rating, the DO quarantines it.</span>
    await registryDO.fetch(new Request('http://registry/score', {
      method: 'POST',
      body: JSON.stringify({ toolName: toolUsed, score })
    }));
  }

  <span class="cm">// 3. If negative text feedback provided, trigger self-correction analysis</span>
  if (score &lt; 0 && text) {
    c.executionCtx.waitUntil(analyzeFailure(spaceId, agentId, text, toolUsed, c.env));
  }

  return c.json({ success: true });
});

<span class="cm">// ── Self-Correction Analysis ──</span>
<span class="cm">// When a user provides negative text feedback, this function uses an LLM to</span>
<span class="cm">// classify the failure mode and write an improvement suggestion back to the</span>
<span class="cm">// agent's SKILL.md in the workspace.</span>
async function analyzeFailure(
  spaceId: string,
  agentId: string,
  feedbackText: string,
  toolUsed: string | undefined,
  env: Env
): Promise&lt;void&gt; {

  <span class="cm">// 1. Classify the failure mode</span>
  const classification = await env.AI_GATEWAY.messages.create({
    model: 'claude-haiku-4-5',
    max_tokens: 300,
    system: `You are a QA analyzer for AI agent failures. Classify the user's negative feedback into one of these categories:
- WRONG_TOOL: Agent used the wrong tool for the task
- WRONG_PARAMS: Agent used the right tool with incorrect parameters
- MISUNDERSTOOD_INTENT: Agent misunderstood what the user wanted
- INCOMPLETE_OUTPUT: Agent's answer was correct but missing key details
- HALLUCINATION: Agent stated something factually incorrect
- SKILL_BUG: The tool itself has a bug or missing feature
Return JSON: {"category": string, "suggestion": "one-sentence improvement for the agent"}`,
    messages: [{ role: 'user', content: `User feedback: "${feedbackText}"\nTool used: ${toolUsed ?? 'unknown'}` }]
  });

  let analysis: { category: string; suggestion: string };
  try {
    analysis = JSON.parse(classification.content[0].text);
  } catch {
    return; <span class="cm">// LLM returned non-JSON, skip</span>
  }

  <span class="cm">// 2. Write improvement suggestion to a feedback log in the agent's workspace</span>
  <span class="cm">// The Space Assistant reads these logs during its daily standup to self-improve</span>
  const feedbackKey = `spaces/${spaceId}/agents/${agentId}/feedback-log.jsonl`;
  const existingObj = await env.NAELAO_WORKSPACE.get(feedbackKey);
  const existing = existingObj ? await existingObj.text() : '';

  const entry = JSON.stringify({
    timestamp: new Date().toISOString(),
    feedbackText,
    toolUsed: toolUsed ?? null,
    category: analysis.category,
    suggestion: analysis.suggestion
  });

  await env.NAELAO_WORKSPACE.put(feedbackKey, existing + entry + '\n');

  <span class="cm">// 3. Log to Analytics Engine for platform-level quality tracking</span>
  await env.NAELAO_ANALYTICS_QUEUE.send({
    type: 'failure_analysis',
    spaceId, agentId,
    failureCategory: analysis.category,
    toolUsed: toolUsed ?? 'none'
  });

  <span class="cm">// 4. If this is a SKILL_BUG, escalate to platform team via naelao-admin</span>
  if (analysis.category === 'SKILL_BUG' && toolUsed) {
    await env.NAELAO_ANALYTICS_QUEUE.send({
      type: 'skill_bug_report',
      spaceId, agentId, toolUsed,
      feedbackText, suggestion: analysis.suggestion
    });
  }
}

export default app;</code></pre>

        <h3>Skill Quarantine System</h3>
        <p>When the <code>SkillRegistryDO</code> accumulates enough negative feedback for a self-authored skill, it
          enters quarantine — temporarily disabled until the agent rewrites it. This prevents a buggy agent-written
          skill from continuing to frustrate the user across multiple sessions.</p>
        <pre><code><span class="cm">// durable-objects/skill-registry-do.ts — updateSkillScore()</span>

async function updateSkillScore(toolName: string, score: number): Promise&lt;void&gt; {
  <span class="cm">// Get or initialize skill score record</span>
  const existing = this.ctx.storage.sql.exec(
    `SELECT total_score, rating_count, status FROM skill_scores WHERE tool_name = ?`,
    toolName
  ).one();

  const totalScore = ((existing?.total_score as number) ?? 0) + score;
  const ratingCount = ((existing?.rating_count as number) ?? 0) + 1;
  const movingAverage = totalScore / ratingCount;

  <span class="cm">// Quarantine threshold: average below 2.0 after at least 5 ratings</span>
  let newStatus = existing?.status ?? 'active';
  if (ratingCount >= 5 && movingAverage &lt; 2.0) {
    newStatus = 'quarantined';

    <span class="cm">// Notify the Space Assistant that the skill needs rewriting</span>
    await this.env.NAELAO_NOTIFICATIONS_QUEUE.send({
      type: 'skill_quarantined',
      spaceId: this.spaceId,
      toolName,
      movingAverage,
      ratingCount,
      message: `Skill '${toolName}' has been quarantined due to repeated poor performance (avg score: ${movingAverage.toFixed(2)}). The agent will rewrite this skill during the next session.`
    });
  }

  <span class="cm">// Promote from quarantine if agent fixes the skill and feedback improves</span>
  if (newStatus === 'quarantined' && movingAverage >= 3.0 && ratingCount > 10) {
    newStatus = 'active';
  }

  this.ctx.storage.sql.exec(
    `INSERT OR REPLACE INTO skill_scores (tool_name, total_score, rating_count, moving_average, status, updated_at)
     VALUES (?, ?, ?, ?, ?, ?)`,
    toolName, totalScore, ratingCount, movingAverage, newStatus, Date.now()
  );
}

<span class="cm">// getSkill() blocks quarantined tools from loading</span>
async function getSkill(toolName: string): Promise&lt;Skill | null&gt; {
  const score = this.ctx.storage.sql.exec(
    `SELECT status FROM skill_scores WHERE tool_name = ?`, toolName
  ).one();

  if (score?.status === 'quarantined') {
    throw new Error(`Skill '${toolName}' is quarantined due to poor performance. The agent must rewrite it.`);
  }

  <span class="cm">// ... normal skill loading ...</span>
}</code></pre>

        <h3>Daily Quality Standup — Space Assistant Integration</h3>
        <p>Every morning, the Space Assistant's cron job reads the <code>feedback-log.jsonl</code> for each agent and
          generates a self-improvement plan. This closes the loop between user feedback and agent behavior.</p>
        <pre><code><span class="cm">// The Space Assistant's daily standup cron handler</span>

async function runDailyQualityReview(spaceId: string, env: Env): Promise&lt;void&gt; {
  const spaceDO = getProductDO(rootSpaceId, env);  // SpaceDO replaces Hyperdrive

  <span class="cm">// Get all agents in this space</span>
  const agents = await db.query(`SELECT id FROM agent_definitions WHERE space_id = $1`, [spaceId]);

  for (const agent of agents.rows) {
    const logKey = `spaces/${spaceId}/agents/${agent.id}/feedback-log.jsonl`;
    const logObj = await env.NAELAO_WORKSPACE.get(logKey);
    if (!logObj) continue;

    const log = await logObj.text();
    const entries = log.split('\n').filter(Boolean).map(l => JSON.parse(l));

    if (entries.length === 0) continue;

    <span class="cm">// Ask the LLM to synthesize improvements from feedback entries</span>
    const plan = await env.AI_GATEWAY.messages.create({
      model: 'claude-sonnet-4-5',
      max_tokens: 1000,
      system: 'You are a senior AI agent coach. Review feedback entries and write a concise improvement plan as a numbered list of specific behavioral changes.',
      messages: [{ role: 'user', content: `Agent: ${agent.id}\n\nFeedback from users:\n${log}` }]
    });

    <span class="cm">// Write the improvement plan to the agent's system prompt addendum</span>
    await env.NAELAO_WORKSPACE.put(
      `spaces/${spaceId}/agents/${agent.id}/improvement-addendum.md`,
      `# Self-Improvement Plan — ${new Date().toLocaleDateString()}\n\n${plan.content[0].text}`
    );

    <span class="cm">// Clear the feedback log so it doesn't grow unbounded</span>
    await env.NAELAO_WORKSPACE.put(logKey, '');
  }
}</code></pre></code></pre>
