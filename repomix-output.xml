  <!-- ── MAIN ── -->
  <div id="main">

    <!-- PERSISTENT MOBILE TOP BAR (hidden on desktop via CSS) -->
    <div id="mobile-topbar">
      <button class="mobile-menu-btn" onclick="toggleMobileSidebar()" aria-label="Open menu">
        <svg viewBox="0 0 16 16" fill="none" stroke-width="1.5" stroke="currentColor"><line x1="2" y1="4" x2="14" y2="4"/><line x1="2" y1="8" x2="14" y2="8"/><line x1="2" y1="12" x2="14" y2="12"/></svg>
