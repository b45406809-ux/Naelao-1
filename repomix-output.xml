  "NAELAO_CONFIG_KV",
  "NAELAO_WORKSPACE",
  "NAELAO_AGENTS_DO",
  "NAELAO_ASSISTANT_DO",
  "NAELAO_VECTORIZE",
  "AI",
  "NAELAO_NOTIFICATIONS_QUEUE",
];

function validateEnv(env: Env): void {
  for (const key of REQUIRED_BINDINGS) {
    if (!env[key]) {
      throw new Error(`Missing required binding: ${key}. Check wrangler.jsonc.`);
    }
  }
}

export default {
  fetch(req: Request, env: Env, ctx: ExecutionContext) {
