app.post('/users/:userId/ban', async (c) =&gt; {
  const { userId } = c.req.param();
  const { reason, durationHours } = await c.req.json();
  const adminEmail = c.get('adminEmail' as any);
  const spaceDO = getProductDO(rootSpaceId, c.env);  // SpaceDO replaces Hyperdrive

  const banExpiresAt = durationHours ? new Date(Date.now() + durationHours * 3600 * 1000) : null;
  await db.query(
    `UPDATE user_profiles SET banned=true, ban_reason=$1, ban_expires_at=$2, banned_by=$3, banned_at=NOW() WHERE id=$4`,
    [reason, banExpiresAt, adminEmail, userId]
  );
  <span class="cm">// Revoke all active sessions (invalidate JWTs via KV blocklist)</span>
  await naelaoAuth.adminUpdateUser(userId, { ban_duration: durationHours ? `${durationHours}h` : 'none' });
  <span class="cm">// Kill any running agent processes for this user</span>
  const { rows: runs } = await db.query(
    `UPDATE agent_runs SET status='cancelled', completed_at=NOW() WHERE user_id=$1 AND status='running' RETURNING id`, [userId]
  );
  await c.env.NAELAO_ANALYTICS_QUEUE.send({ type: 'admin_user_banned', userId, reason, adminEmail, runsCancelled: runs.length });
  return c.json({ success: true, banned: true, banExpiresAt, runsCancelled: runs.length });
});

