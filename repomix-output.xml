  <!-- ══════════════════════════════════════════════════════
     §30 — WALLETDO (STANDALONE DEEP DIVE)
═══════════════════════════════════════════════════════ -->
  <div class="sep"></div>
  <div class="sec" id="walletdo-deep">
    <span class="sec-ey">30 — WalletDO Deep Dive</span>
    <h2>WalletDO — Every Agent's Economic Engine</h2>
    <div class="bar"></div>
    <p class="lead">WalletDO is used by Workers instances, Space Assistants (when enabled), Enterprise agents, and
      Mini-AGI nodes. It is the primitive that makes autonomous economic action possible. This section covers every
      aspect of WalletDO that wasn't covered in §06: the complete policy system, the audit trail, the x402 inter-Space
      payment protocol, and how to test wallet behavior correctly.</p>

    <h3>Complete WalletDO Policy System</h3>
    <pre><code><span class="cm">// durable-objects/wallet-do.ts — Policy management
// Policies are set by Space admins via the dashboard, not by agents.
// Agents can READ policy (to know their limits) but NEVER write policy.
// Policy is enforced atomically inside WalletDO — agents can't bypass it.</span>

export class WalletDO extends DurableObject {

  <span class="cm">// Space admin calls this to configure the wallet policy</span>
  async setPolicy(params: {
    maxSingleSpendUsd: number;       <span class="cm">// max spend per single transaction</span>
    monthlyBudgetUsd: number;        <span class="cm">// total monthly spend limit</span>
    vendorWhitelist: string[];        <span class="cm">// [] = allow all, [list] = only these vendors</span>
    categoryCapUsd: Record&lt;string, number&gt;;  <span class="cm">// per-category monthly caps</span>
    requireApprovalAboveUsd: number; <span class="cm">// amounts above this trigger human approval</span>
    allowedHours?: { from: number; to: number }; <span class="cm">// spending hours (UTC, optional)</span>
  }, adminId: string): Promise&lt;void&gt; {

    <span class="cm">// Validate all policy values before storing</span>
    if (params.maxSingleSpendUsd &lt; 0 || params.maxSingleSpendUsd &gt; 10000) {
      throw new Error('maxSingleSpendUsd must be between 0 and 10000');
    }
    if (params.monthlyBudgetUsd &lt; 0) {
      throw new Error('monthlyBudgetUsd cannot be negative');
    }

    <span class="cm">// Store as individual policy rows for easy querying</span>
    const policyEntries: Array&lt;[string, string]&gt; = [
      ['max_single_spend',          params.maxSingleSpendUsd.toString()],
      ['monthly_budget',            params.monthlyBudgetUsd.toString()],
      ['vendor_whitelist',          JSON.stringify(params.vendorWhitelist)],
      ['category_caps',             JSON.stringify(params.categoryCapUsd)],
      ['require_approval_above',    params.requireApprovalAboveUsd.toString()],
      ['allowed_hours',             JSON.stringify(params.allowedHours ?? null)],
      ['policy_updated_by',         adminId],
      ['policy_updated_at',         Date.now().toString()]
    ];

    for (const [key, value] of policyEntries) {
      this.ctx.storage.sql.exec(
        'INSERT OR REPLACE INTO policy (key, value) VALUES (?, ?)', key, value
      );
    }

    <span class="cm">// Log policy change to transactions table for audit</span>
    this.ctx.storage.sql.exec(
      'INSERT INTO transactions (type, amount_usd, description, vendor, balance_after) VALUES (?, ?, ?, ?, ?)',
      'policy_change', 0, `Policy updated by admin ${adminId}`, 'system',
      parseFloat(this.getWalletBalance())
    );
  }

  async getPolicy(): Promise&lt;WalletPolicy&gt; {
    const rows = this.ctx.storage.sql
      .exec('SELECT key, value FROM policy')
      .toArray() as Array&lt;{ key: string; value: string }&gt;;
    const p = Object.fromEntries(rows.map(r =&gt; [r.key, r.value]));
    return {
      maxSingleSpendUsd:       parseFloat(p.max_single_spend ?? '10'),
      monthlyBudgetUsd:        parseFloat(p.monthly_budget ?? '100'),
      vendorWhitelist:         JSON.parse(p.vendor_whitelist ?? '[]'),
      categoryCapUsd:          JSON.parse(p.category_caps ?? '{}'),
      requireApprovalAboveUsd: parseFloat(p.require_approval_above ?? '50'),
      allowedHours:            JSON.parse(p.allowed_hours ?? 'null')
    };
  }

  <span class="cm">// Get full transaction history for audit/display
  // Returns most recent transactions first with pagination</span>
  async getTransactionHistory(params: {
    limit?: number;
    before?: number;  <span class="cm">// timestamp cursor for pagination</span>
    type?: string;    <span class="cm">// filter by type: debit|credit|fee|policy_change</span>
  }): Promise&lt;Transaction[]&gt; {
    let query = 'SELECT * FROM transactions';
    const args: unknown[] = [];
    const conditions: string[] = [];
    
    if (params.before) {
      conditions.push('created_at &lt; ?');
      args.push(params.before);
    }
    if (params.type) {
      conditions.push('type = ?');
      args.push(params.type);
    }
    if (conditions.length) query += ' WHERE ' + conditions.join(' AND ');
    query += ' ORDER BY created_at DESC LIMIT ?';
    args.push(params.limit ?? 50);

    return this.ctx.storage.sql.exec(query, ...args).toArray() as Transaction[];
  }

  <span class="cm">// Check if spending is allowed right now (time-based policy)
  // Called before every deductCredits() as an additional guard</span>
  private isWithinAllowedHours(allowedHours: { from: number; to: number } | null): boolean {
    if (!allowedHours) return true; <span class="cm">// no time restriction</span>
    const utcHour = new Date().getUTCHours();
    if (allowedHours.from &lt;= allowedHours.to) {
      <span class="cm">// Same-day range: from=9, to=17 means 9am-5pm UTC</span>
      return utcHour &gt;= allowedHours.from &amp;&amp; utcHour &lt; allowedHours.to;
    } else {
      <span class="cm">// Overnight range: from=22, to=6 means 10pm-6am UTC</span>
      return utcHour &gt;= allowedHours.from || utcHour &lt; allowedHours.to;
    }
  }

  private getWalletBalance(): string {
    return (this.ctx.storage.sql
      .exec('SELECT balance_usd FROM wallet WHERE id = ?', 'main')
      .one()?.balance_usd as number ?? 0).toString();
  }
}
</code></pre>

    <h3>x402 Inter-Space Payments</h3>
    <p>The x402 protocol allows Worker instances in company Spaces to hire other Workers from the Workers marketplace,
      paying micropayments between Spaces. The payment is atomic: money leaves company wallet, arrives in creator
      wallet, in a single coordinated operation.</p>
    <pre><code><span class="cm">// x402 payment flow: Company Space Worker hires a specialist Worker
// The specialist Worker provides a service priced in USD micropayments</span>

async function x402Payment(params: {
  fromSpaceId: string;     <span class="cm">// company that is paying</span>
  fromWalletId: string;    <span class="cm">// which wallet in that company</span>
  toCreatorSpaceId: string;<span class="cm">// creator's Workers Space</span>
  toWorkerId: string;      <span class="cm">// which Worker is being hired</span>
  amountUsd: number;
  description: string;
  env: Env;
}): Promise&lt;{ success: boolean; txId?: string; error?: string }&gt; {

  <span class="cm">// Step 1: Debit from company wallet</span>
  const companyWalletDO = params.env.NAELAO_WALLET_DO.get(
    params.env.NAELAO_WALLET_DO.idFromName(`wallet:${params.fromSpaceId}:${params.fromWalletId}`)
  );
  const debitResult = await companyWalletDO.fetch(new Request('http://wallet/deduct', {
    method: 'POST',
    body: JSON.stringify({
      amount: params.amountUsd,
      description: `x402: ${params.description}`,
      vendor: `worker:${params.toWorkerId}`,
      category: 'worker_hire'
    })
  })).then(r =&gt; r.json()) as DeductResult;

  if (!debitResult.success) {
    return { success: false, error: debitResult.reason };
  }

  <span class="cm">// Step 2: Credit to creator's WorkerDefinitionDO earnings
  // The creator earns 85% (platform takes 15% fee)</span>
  const creatorEarning = params.amountUsd * 0.85;
  const workerDefDO = params.env.NAELAO_WORKER_DEF.get(
    params.env.NAELAO_WORKER_DEF.idFromName(`workerdef:${params.toCreatorSpaceId}:${params.toWorkerId}`)
  );
  await workerDefDO.fetch(new Request('http://workerdef/record-earning', {
    method: 'POST',
    body: JSON.stringify({
      amount: creatorEarning,
      companySpaceId: params.fromSpaceId,
      period: new Date().toISOString().slice(0, 7)  <span class="cm">// YYYY-MM</span>
    })
  }));

  <span class="cm">// Step 3: Platform fee goes to Naelao revenue wallet (15%)</span>
  const platformFee = params.amountUsd * 0.15;
  await params.env.NAELAO_ANALYTICS_QUEUE.send({
    type: 'x402_payment',
    fromSpaceId: params.fromSpaceId,
    toCreatorSpaceId: params.toCreatorSpaceId,
    workerId: params.toWorkerId,
    totalAmount: params.amountUsd,
    creatorEarning,
    platformFee,
    timestamp: Date.now()
  });

  return { success: true, txId: debitResult.transactionId };
}</code></pre>

    <h3>Testing WalletDO — The Right Way</h3>
    <pre><code><span class="cm">// tests/suites/suite-06-wallet.test.ts
// Run inside workerd via @cloudflare/vitest-pool-workers
// WalletDO is single-threaded — no race conditions in tests</span>

import { describe, it, expect, beforeEach } from 'vitest';
import { env } from 'cloudflare:test';

describe('WalletDO', () =&gt; {
  let walletDO: DurableObjectStub;

  beforeEach(async () =&gt; {
    <span class="cm">// Fresh wallet for each test — use unique name per test</span>
    const id = env.NAELAO_WALLET_DO.idFromName(`test-wallet-${crypto.randomUUID()}`);
    walletDO = env.NAELAO_WALLET_DO.get(id);
    
    <span class="cm">// Initialize with $100 balance and default policy</span>
    await walletDO.fetch(new Request('http://wallet/credit', {
      method: 'POST',
      body: JSON.stringify({ amount: 100, description: 'Test credit', source: 'test' })
    }));
  });

  it('deducts correct amount atomically', async () =&gt; {
    const result = await walletDO.fetch(new Request('http://wallet/deduct', {
      method: 'POST',
      body: JSON.stringify({
        amount: 25, description: 'Test deduction',
        vendor: 'test-vendor', category: 'test'
      })
    })).then(r =&gt; r.json()) as DeductResult;

    expect(result.success).toBe(true);
    expect(result.newBalance).toBe(75); <span class="cm">// $100 - $25</span>

    <span class="cm">// Verify transaction was recorded</span>
    const history = await walletDO.fetch(new Request('http://wallet/history'))
      .then(r =&gt; r.json()) as { transactions: Transaction[] };
    expect(history.transactions[0].amount_usd).toBe(25);
    expect(history.transactions[0].type).toBe('debit');
  });

  it('rejects deduction exceeding max single spend policy', async () =&gt; {
    <span class="cm">// Set policy: max $10 per transaction</span>
    await walletDO.fetch(new Request('http://wallet/set-policy', {
      method: 'POST',
      body: JSON.stringify({ maxSingleSpendUsd: 10, monthlyBudgetUsd: 100,
        vendorWhitelist: [], categoryCapUsd: {}, requireApprovalAboveUsd: 50 })
    }));

    const result = await walletDO.fetch(new Request('http://wallet/deduct', {
      method: 'POST',
      body: JSON.stringify({ amount: 15, description: 'Over limit', vendor: 'v', category: 'c' })
    })).then(r =&gt; r.json()) as DeductResult;

    expect(result.success).toBe(false);
    expect(result.reason).toContain('max single spend');
    
    <span class="cm">// Verify balance unchanged (atomic reject — no partial deduction)</span>
    const balanceResp = await walletDO.fetch(new Request('http://wallet/balance'));
    const { balance } = await balanceResp.json() as { balance: number };
    expect(balance).toBe(100); <span class="cm">// unchanged</span>
  });

  it('rejects vendor not in whitelist', async () =&gt; {
    await walletDO.fetch(new Request('http://wallet/set-policy', {
      method: 'POST',
      body: JSON.stringify({ maxSingleSpendUsd: 100, monthlyBudgetUsd: 1000,
        vendorWhitelist: ['approved-vendor'], categoryCapUsd: {}, requireApprovalAboveUsd: 999 })
    }));

    const result = await walletDO.fetch(new Request('http://wallet/deduct', {
      method: 'POST',
      body: JSON.stringify({ amount: 5, description: 'Test', vendor: 'unapproved-vendor', category: 'c' })
    })).then(r =&gt; r.json()) as DeductResult;

    expect(result.success).toBe(false);
    expect(result.reason).toContain('whitelist');
  });

  it('rejects when monthly budget exhausted', async () =&gt; {
    await walletDO.fetch(new Request('http://wallet/set-policy', {
      method: 'POST',
      body: JSON.stringify({ maxSingleSpendUsd: 100, monthlyBudgetUsd: 30,
        vendorWhitelist: [], categoryCapUsd: {}, requireApprovalAboveUsd: 999 })
    }));

    <span class="cm">// Spend $20 successfully</span>
    await walletDO.fetch(new Request('http://wallet/deduct', {
      method: 'POST',
      body: JSON.stringify({ amount: 20, description: 'First', vendor: 'v', category: 'c' })
    }));

    <span class="cm">// Try to spend $15 more (would exceed $30 monthly budget)</span>
    const result = await walletDO.fetch(new Request('http://wallet/deduct', {
      method: 'POST',
      body: JSON.stringify({ amount: 15, description: 'Second', vendor: 'v', category: 'c' })
    })).then(r =&gt; r.json()) as DeductResult;

    expect(result.success).toBe(false);
    expect(result.reason).toContain('monthly budget');
  });
});</code></pre>
