// workers/naelao-auth/src/jwt.ts
const payload: JWTPayload = { sub: userId, spaceId, rootSpaceId, role, builderId,
  iat: Math.floor(Date.now() / 1000), exp: Math.floor(Date.now() / 1000) + 3600 };

Fix 2: Populate rootSpaceId at login time. Add a root_space_id column to SpaceDO's spaces table (or store it in the members table). When a user authenticates to a spaceId, query SpaceDO for the root space:
// workers/naelao-auth/src/index.ts – POST /v1/auth/login
const spaceMeta = await spaceDOStub.fetch('/meta').then(r =&gt; r.json());
const rootSpaceId = spaceMeta.rootSpaceId ?? spaceId; // top-level spaces are their own root
