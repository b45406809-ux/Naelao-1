    .card p {
      font-size: 12.5px;
      color: var(--mt);
      line-height: 1.62;
      margin-bottom: 5px;
    }

    .card p:last-child {
      margin-bottom: 0;
    }

    /* ─── ARCH DIAGRAMS ───────────────────────────── */
    .arch {
      background: var(--bg2);
      border: 1px solid var(--brd2);
      border-radius: 9px;
      padding: 22px;
      margin: 22px 0;
    }

    .arch-t {
