  <!-- ══════════════════════════════════════════════════════
     §24 — PROJECT COLLABORATION (ProjectDO Deep Dive)
═══════════════════════════════════════════════════════ -->
  <div class="sep"></div>
  <div class="sec" id="project-collab">
    <span class="sec-ey">24 — Project Collaboration</span>
    <h2>ProjectDO — Real-Time Multi-User Collaboration</h2>
    <div class="bar"></div>
    <p class="lead">ProjectDO manages all collaboration within a Naelao project: file locking to prevent concurrent
      write corruption, version history for rollback, real-time member presence, and an activity feed that streams live
      updates to all connected members. This section covers the full implementation every junior developer needs to
      build it correctly.</p>

    <h3>ProjectDO — Complete SQLite Schema</h3>
    <pre><code><span class="cm">// durable-objects/project-do.ts
// One ProjectDO per project. Lives as long as the project.
// ID: idFromName(`project:${spaceId}:${projectId}`)</span>

export class ProjectDO extends DurableObject {
  private async initSchema() {
    this.ctx.storage.sql.exec(`
      <span class="cm">-- File lock table: prevents concurrent writes to the same file</span>
      CREATE TABLE IF NOT EXISTS file_locks (
        path        TEXT PRIMARY KEY,
        locked_by   TEXT NOT NULL,   <span class="cm">-- agentId or userId</span>
        locked_at   INTEGER NOT NULL DEFAULT (unixepoch('now') * 1000),
        lock_type   TEXT NOT NULL DEFAULT 'write', <span class="cm">-- write|exclusive</span>
        run_id      TEXT,            <span class="cm">-- which agent run holds this lock</span>
        expires_at  INTEGER NOT NULL <span class="cm">-- auto-release after 60 seconds of inactivity</span>
      );

      <span class="cm">-- Version history: every file write creates a version entry</span>
      CREATE TABLE IF NOT EXISTS file_versions (
        id          TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
        path        TEXT NOT NULL,
        version_key TEXT NOT NULL,   <span class="cm">-- R2 key of the versioned copy</span>
        written_by  TEXT NOT NULL,   <span class="cm">-- agentId or userId</span>
        size_bytes  INTEGER,
        commit_msg  TEXT,            <span class="cm">-- optional description of change</span>
        created_at  INTEGER NOT NULL DEFAULT (unixepoch('now') * 1000)
      );
      CREATE INDEX IF NOT EXISTS idx_fv_path ON file_versions(path, created_at DESC);

      <span class="cm">-- Member presence: who is currently active in this project</span>
      CREATE TABLE IF NOT EXISTS presence (
        user_id     TEXT PRIMARY KEY,
        display_name TEXT NOT NULL,
        avatar_url  TEXT,
        status      TEXT DEFAULT 'active', <span class="cm">-- active|idle|away</span>
        last_seen   INTEGER NOT NULL DEFAULT (unixepoch('now') * 1000),
        current_thread TEXT            <span class="cm">-- which thread they are viewing</span>
      );

      <span class="cm">-- Activity feed: all project events</span>
      CREATE TABLE IF NOT EXISTS activity (
        id          TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
        type        TEXT NOT NULL,    <span class="cm">-- agent_run|file_write|member_joined|thread_created|etc</span>
        actor_id    TEXT NOT NULL,    <span class="cm">-- userId or agentId that caused the event</span>
        actor_name  TEXT,
        description TEXT NOT NULL,
        metadata    TEXT DEFAULT '{}', <span class="cm">-- JSON extra data</span>
        created_at  INTEGER NOT NULL DEFAULT (unixepoch('now') * 1000)
      );
      CREATE INDEX IF NOT EXISTS idx_activity_time ON activity(created_at DESC);

      <span class="cm">-- Project settings (cached from SpaceDO SQLite)</span>
      CREATE TABLE IF NOT EXISTS settings (
        key         TEXT PRIMARY KEY,
        value       TEXT NOT NULL,
        updated_at  INTEGER DEFAULT (unixepoch('now') * 1000)
      );
    `);
  }

  <span class="cm">// Acquire a write lock on a file path.
  // Called BEFORE any agent writes to a file.
  // Returns true if lock acquired, false if file is locked by someone else.</span>
  async acquireLock(params: {
    path: string;
    lockedBy: string;   <span class="cm">// agentId or userId</span>
    runId?: string;
    ttlMs?: number;     <span class="cm">// default 60000 (60 seconds)</span>
  }): Promise&lt;{ acquired: boolean; lockedBy?: string; expiresAt?: number }&gt; {

    const ttl = params.ttlMs ?? 60000;
    const now = Date.now();
    const expiresAt = now + ttl;

    <span class="cm">// Check for existing unexpired lock</span>
    const existing = this.ctx.storage.sql.exec(
      'SELECT locked_by, expires_at FROM file_locks WHERE path = ? AND expires_at &gt; ?',
      params.path, now
    ).one();

    if (existing) {
      <span class="cm">// File is locked — check if it's by the same entity (re-entrant lock)</span>
      if ((existing.locked_by as string) === params.lockedBy) {
        <span class="cm">// Extend the lock</span>
        this.ctx.storage.sql.exec(
          'UPDATE file_locks SET expires_at = ? WHERE path = ?', expiresAt, params.path
        );
        return { acquired: true };
      }
      return { acquired: false, lockedBy: existing.locked_by as string, expiresAt: existing.expires_at as number };
    }

    <span class="cm">// No existing lock — acquire it</span>
    this.ctx.storage.sql.exec(
      'INSERT OR REPLACE INTO file_locks (path, locked_by, locked_at, run_id, expires_at) VALUES (?, ?, ?, ?, ?)',
      params.path, params.lockedBy, now, params.runId ?? null, expiresAt
    );

    return { acquired: true };
  }

  async releaseLock(path: string, releasedBy: string): Promise&lt;void&gt; {
    <span class="cm">// Only the lock holder (or an admin) can release a lock</span>
    const existing = this.ctx.storage.sql.exec(
      'SELECT locked_by FROM file_locks WHERE path = ?', path
    ).one();

    if (!existing) return; <span class="cm">// no lock to release</span>

    if ((existing.locked_by as string) !== releasedBy) {
      <span class="cm">// Log attempted unauthorized release for audit</span>
      await this.logActivity({
        type: 'lock_release_denied',
        actorId: releasedBy,
        description: `Attempted to release lock on ${path} held by ${existing.locked_by}`
      });
      throw new Error('Cannot release lock held by another entity');
    }

    this.ctx.storage.sql.exec('DELETE FROM file_locks WHERE path = ?', path);
  }

  <span class="cm">// Record a file write and create version history</span>
  async recordFileWrite(params: {
    path: string;
    writtenBy: string;
    sizeBytes: number;
    r2VersionKey: string;  <span class="cm">// R2 key of the versioned copy</span>
    commitMsg?: string;
  }): Promise&lt;void&gt; {
    this.ctx.storage.sql.exec(
      'INSERT INTO file_versions (path, version_key, written_by, size_bytes, commit_msg) VALUES (?, ?, ?, ?, ?)',
      params.path, params.r2VersionKey, params.writtenBy, params.sizeBytes, params.commitMsg ?? null
    );

    <span class="cm">// Log to activity feed</span>
    await this.logActivity({
      type: 'file_write',
      actorId: params.writtenBy,
      description: `Updated ${params.path}`,
      metadata: { path: params.path, sizeBytes: params.sizeBytes }
    });

    <span class="cm">// Broadcast to all connected WebSocket clients</span>
    this.broadcastEvent({
      type: 'file_updated',
      path: params.path,
      writtenBy: params.writtenBy,
      timestamp: Date.now()
    });
  }

  async getFileVersionHistory(
    path: string,
    limit = 20
  ): Promise&lt;FileVersion[]&gt; {
    return this.ctx.storage.sql.exec(
      'SELECT * FROM file_versions WHERE path = ? ORDER BY created_at DESC LIMIT ?',
      path, limit
    ).toArray() as FileVersion[];
  }

  <span class="cm">// Restore a file to a previous version</span>
  async rollbackFile(
    path: string,
    versionId: string,
    requestedBy: string,
    r2: R2Bucket,
    spaceId: string
  ): Promise&lt;void&gt; {
    const version = this.ctx.storage.sql.exec(
      'SELECT * FROM file_versions WHERE id = ? AND path = ?', versionId, path
    ).one() as FileVersion | null;

    if (!version) throw new Error(`Version ${versionId} not found for ${path}`);

    <span class="cm">// Copy the versioned R2 object back to the main path</span>
    const versionedObj = await r2.get(version.version_key as string);
    if (!versionedObj) throw new Error(`Version data not found in R2: ${version.version_key}`);

    await r2.put(`spaces/${spaceId}/workspace/${path}`, versionedObj.body);

    await this.logActivity({
      type: 'file_rollback',
      actorId: requestedBy,
      description: `Rolled back ${path} to version from ${new Date(version.created_at as number).toISOString()}`,
      metadata: { path, versionId, originalAuthor: version.written_by }
    });
  }

  <span class="cm">// 3-way merge for text files (Markdown, code, JSON)
  // Called when two agents write to the same file concurrently</span>
  async mergeTextFile(params: {
    path: string;
    baseContent: string;    <span class="cm">// last common ancestor</span>
    contentA: string;       <span class="cm">// Agent A's version</span>
    contentB: string;       <span class="cm">// Agent B's version</span>
  }): Promise&lt;{ merged: string; hasConflicts: boolean }&gt; {
    <span class="cm">// Simple line-based 3-way merge
    // For production: consider using a proper diff3 algorithm
    // This is sufficient for most agent-generated content (Markdown, JSON)</span>
    const baseLines = params.baseContent.split('
');
    const aLines = params.contentA.split('
');
    const bLines = params.contentB.split('
');

    <span class="cm">// If A and B made the same changes, just use A</span>
    if (params.contentA === params.contentB) {
      return { merged: params.contentA, hasConflicts: false };
    }

    <span class="cm">// If only A changed, use A</span>
    if (params.contentB === params.baseContent) {
      return { merged: params.contentA, hasConflicts: false };
    }

    <span class="cm">// If only B changed, use B</span>
    if (params.contentA === params.baseContent) {
      return { merged: params.contentB, hasConflicts: false };
    }

    <span class="cm">// Both changed — need actual merge. Mark conflicts for user review.</span>
    const merged = [
      '&lt;&lt;&lt;&lt;&lt;&lt;&lt; Agent A version',
      params.contentA,
      '=======',
      params.contentB,
      '&gt;&gt;&gt;&gt;&gt;&gt;&gt; Agent B version'
    ].join('
');

    return { merged, hasConflicts: true };
  }

  private async logActivity(params: {
    type: string;
    actorId: string;
    actorName?: string;
    description: string;
    metadata?: unknown;
  }): Promise&lt;void&gt; {
    this.ctx.storage.sql.exec(
      'INSERT INTO activity (type, actor_id, actor_name, description, metadata) VALUES (?, ?, ?, ?, ?)',
      params.type, params.actorId, params.actorName ?? null,
      params.description, JSON.stringify(params.metadata ?? {})
    );
  }

  private broadcastEvent(event: unknown): void {
    const msg = JSON.stringify(event);
    this.ctx.getWebSockets().forEach(ws => ws.send(msg));
  }
}</code></pre>

    <h3>How File Versioning Works in R2</h3>
    <p>Every time a file is written, a versioned copy is stored in R2 alongside the main file. The version key includes
      the timestamp. The ProjectDO SQLite database tracks all versions for quick listing and rollback.</p>
    <pre><code><span class="cm">// shared/file-versioning.ts
// Call this EVERY time an agent or user writes a file to R2 workspace.
// Skipping versioning means rollback is impossible for that file write.</span>

export async function writeFileWithVersioning(params: {
  path: string;
  content: string | ArrayBuffer;
  writtenBy: string;
  spaceId: string;
  projectId: string;
  commitMsg?: string;
  env: Env;
}): Promise&lt;void&gt; {
  const { path, content, writtenBy, spaceId, projectId, commitMsg, env } = params;
  const timestamp = Date.now();
  
  <span class="cm">// 1. Write main file (latest version)</span>
  const mainKey = `spaces/${spaceId}/workspace/${path}`;
  await env.NAELAO_WORKSPACE.put(mainKey, content, {
    customMetadata: {
      writtenBy,
      updatedAt: timestamp.toString(),
      projectId
    }
  });

  <span class="cm">// 2. Write versioned copy (for history and rollback)</span>
  const versionKey = `spaces/${spaceId}/.versions/${path}/v${timestamp}`;
  await env.NAELAO_WORKSPACE.put(versionKey, content);

  <span class="cm">// 3. Record in ProjectDO (tracks all versions for fast listing)</span>
  const projectDO = env.NAELAO_PROJECT_DO.get(
    env.NAELAO_PROJECT_DO.idFromName(`project:${spaceId}:${projectId}`)
  );
  await projectDO.fetch(new Request('http://project/record-write', {
    method: 'POST',
    body: JSON.stringify({
      path,
      writtenBy,
      sizeBytes: typeof content === 'string' ? content.length : content.byteLength,
      r2VersionKey: versionKey,
      commitMsg: commitMsg ?? `Updated ${path}`
    })
  }));
}</code></pre>
  </div>

