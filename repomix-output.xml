```typescript
// Schema (in onStart):
this.sql`ALTER TABLE memories ADD COLUMN user_id TEXT`;
this.sql`CREATE INDEX IF NOT EXISTS idx_memories_user
  ON memories(user_id, space_id)`;

// Write path — always include user_id:
async storeMemory(key: string, value: string, userId: string) {
  const memKey = this.isSharedMode
    ? `${userId}:${key}` // namespace with userId in shared mode
    : key;
  await this.sql`INSERT OR REPLACE INTO memories
    (key, value, user_id, space_id, updated_at)
    VALUES (
      ${memKey}, ${value}, ${userId},
      ${this.spaceId}, unixepoch('now')*1000
    )`;
}

// Read path — always filter by user_id:
async recallMemory(key: string, userId: string) {
  const memKey = this.isSharedMode ? `${userId}:${key}` : key;
  return this.sql&lt;Memory[]&gt;`
    SELECT * FROM memories
    WHERE key = ${memKey} AND user_id = ${userId}
  `[0];
}
```
