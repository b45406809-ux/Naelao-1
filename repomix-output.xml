    <span style="font-family:'DM Mono',monospace;font-size:10px;color:#EAB308;letter-spacing:.08em;text-transform:uppercase;background:#EAB30818;padding:3px 8px;border-radius:3px;white-space:nowrap;">HIGH</span>
