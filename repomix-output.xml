```typescript
function mergeSkillsByPrecedence(
  [platform, space, agent]: Skill[][],
  spaceId: string,
  userId: string
): Skill[] {
  const merged = new Map&lt;string, Skill&gt;();
  for (const skill of platform) merged.set(skill.name, { ...skill, tier: 1 });
  for (const skill of space) {
    const existing = merged.get(skill.name);
    if (existing) {
      logSkillOverride({ skill, overrides: existing, by: "space", spaceId });
    }
    merged.set(skill.name, { ...skill, tier: 2 });
  }
  for (const skill of agent) {
    const existing = merged.get(skill.name);
    if (existing) {
      logSkillOverride({ skill, overrides: existing, by: "agent", spaceId, userId });
    }
    merged.set(skill.name, { ...skill, tier: 3 });
  }
  return [...merged.values()];
}

// Store overrides in SkillRegistryDO for admin review
function logSkillOverride(event: SkillOverrideEvent) {
  ctx.storage.sql.exec(
    "INSERT INTO skill_overrides (skill_name, tier, overridden_tier, space_id, user_id, logged_at) VALUES (?,?,?,?,?,?)",
    event.skill.name, event.by, event.overrides.tier, event.spaceId, event.userId ?? null, Date.now()
  );
}
