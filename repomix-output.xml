    }

    .box-rd .box-lbl {
      color: var(--rd);
    }

    .box-am .box-lbl {
      color: var(--am);
    }

    .box-cy .box-lbl {
      color: var(--cy);
    }

    .box-ye .box-lbl {
      color: var(--ye);
    }

    .box p,
    .box li {
      margin-bottom: 6px;
