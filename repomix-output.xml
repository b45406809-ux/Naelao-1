  const res = await apiFetch<{ data?: SubAgentSummary[] } | SubAgentSummary[]>(
    `/v1/spaces/${spaceId}/assistant/sub-agents?${qs.toString()}`,
    { session }
  );
  return Array.isArray(res) ? res : res.data ?? [];
}

