    }

    .box-or .box-lbl {
      color: var(--or);
    }

    .box-bl .box-lbl {
      color: var(--bl);
    }

    .box-gr .box-lbl {
      color: var(--gr);
    }

    .box-pu .box-lbl {
      color: var(--pu);
