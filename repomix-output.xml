// ── ANALYTICS CHART ──
function buildChart(){
  const wrap=document.getElementById('chart-bars');
  if(!wrap)return;
  const data=[{l:'Mon',v:35},{l:'Tue',v:62},{l:'Wed',v:48},{l:'Thu',v:80},{l:'Fri',v:55},{l:'Sat',v:28},{l:'Sun',v:44}];
  const max=Math.max(...data.map(d=>d.v));
  wrap.innerHTML=data.map(d=>`<div class="chart-bar-col"><div class="chart-bar" style="height:${(d.v/max)*72}px" title="${d.v} credits"></div><div class="chart-bar-label">${d.l}</div></div>`).join('');
}

