async installDefinition(defId: string, spaceId: string) {
  const latest = await registry.getLatest(defId);
  await spaceDO.recordInstall({
    defId, spaceId,
    pinnedVersion: latest.version,            // pin exact version
    snapshot: latest,                          // immutable snapshot
    autoUpgrade: "minor",                      // minor/patch auto, major opt-in
  });
}
