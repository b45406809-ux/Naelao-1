export default {
  async queue(batch: MessageBatch, env: Env): Promise&lt;void&gt; {
    for (const msg of batch.messages) {
      const body = msg.body as { retryCount: number; payload: unknown; enqueuedAt: number };
      const ageMs = Date.now() - body.enqueuedAt;
      if (body.retryCount &lt; 3 &amp;&amp; ageMs &lt; 86_400_000) {
        await env.NAELAO_WORKFLOW_DISPATCH.send(body.payload); // re-queue to appropriate queue
        msg.ack();
      } else {
        msg.ack(); // discard permanently, log to analytics
      }
    }
  }
