<file path="apps/shell/src/app/p/[slug]/(shell)/plugins/page.tsx">
"use client";

export const runtime = "edge";

// Step 20: the Plugins directory — a browsable catalogue of the native business-infrastructure
// "plugins" (Wallet, CRM, Business Email, Storefront, Analytics, …) a business can install, in the
// spirit of Claude's own plugin marketplace. Distinct from the inline "Plugins" grid in the New
// Project dialog (which only shows what you could ADD): this page also shows what's already
// installed and which come by DEFAULT with a business, so an operator can see their whole plugin
// surface in one place and reach it later without opening a create-project modal.
//
// A "plugin" here IS a project of a Business Feature kind — same mechanism, not a parallel system
// (CLAUDE.md ground rule #4). Installing one creates that kind of project; opening one navigates
// to its project (whose shell mounts the kind's native panel).

import * as React from "react";
import Link from "next/link";
import { Button, Card, CardTitle, CardDesc, Badge, Modal, FormInput, useToast, Toast } from "@naelao/ui";
import { useProduct } from "@/lib/product-context";
import { useProductAuth } from "@/lib/auth-provider";
import { useActiveSpace } from "@/lib/active-space-context";
import {
  listProjects,
  createProject,
  getFeatureKinds,
  type Project,
  type FeatureKind,
} from "@/lib/api";

// The two base project shapes, never "plugins" — mirrors STRUCTURAL_PROJECT_KINDS in
// @naelao/events. Anything else with a kind set is a feature-kind plugin.
const STRUCTURAL_KINDS = new Set(["", "workspace", "customer_bot"]);

interface InstalledPlugin {
  kind: string;
  /** The installed project itself — the card links here. */
  project: Project;
  /** The registry label when the caller could also create this kind; else the project name. */
  label: string;
  description?: string | undefined;
}

export default function PluginsPage() {
  const product = useProduct();
  const { activeSpaceId } = useActiveSpace();
  const { session } = useProductAuth();
  const { toast, show } = useToast();

  const [projects, setProjects] = React.useState<Project[]>([]);
  const [featureKinds, setFeatureKinds] = React.useState<FeatureKind[]>([]);
  const [loading, setLoading] = React.useState(true);
  const [loadFailed, setLoadFailed] = React.useState(false);

  // Install dialog: pick a plugin, then name the project it creates.
  const [picked, setPicked] = React.useState<FeatureKind | null>(null);
  const [name, setName] = React.useState("");
  const [installing, setInstalling] = React.useState(false);

  const creds = session ? { sessionToken: session.session_token, endUserId: session.end_user_id } : null;

  const refresh = React.useCallback(async () => {
    if (!creds) return;
    setLoading(true);
    // allSettled: the project list and the installable-kinds list fail independently — one must
    // never blank the whole directory. getFeatureKinds is empty for a viewer/member who can't
    // create any kind; that's correct (they still SEE what's installed, just can't add more).
    const [p, k] = await Promise.allSettled([
      listProjects(activeSpaceId, creds),
      getFeatureKinds(activeSpaceId, creds),
    ]);
    if (p.status === "fulfilled") {
      setProjects(p.value);
      setLoadFailed(false);
    } else {
      setLoadFailed(true);
    }
    if (k.status === "fulfilled") setFeatureKinds(k.value);
    setLoading(false);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [activeSpaceId, session]);

  React.useEffect(() => {
    void refresh();
  }, [refresh]);

  // Installed = every active project whose kind is a real feature kind (not a base shape). Uses the
  // project list, which is visible to every role, so an operator sees their whole plugin surface
  // regardless of whether they could ADD more.
  const kindByName = React.useMemo(
    () => new Map(featureKinds.map((k) => [k.kind, k])),
    [featureKinds],
  );
  const installed: InstalledPlugin[] = projects
    .filter((p) => p.status !== "archived" && p.kind && !STRUCTURAL_KINDS.has(p.kind))
    .map((p) => {
      const reg = kindByName.get(p.kind!);
      return { kind: p.kind!, project: p, label: reg?.label ?? p.name, description: reg?.description };
    });
  const installedKinds = new Set(installed.map((i) => i.kind));

  // Available = role-filtered installable kinds not already present as an active singleton. A
  // non-singleton kind stays available even when one exists (you can add another).
  const available = featureKinds.filter(
    (k) => !(k.singleton && installedKinds.has(k.kind)),
  );

  function openInstall(k: FeatureKind) {
    setPicked(k);
    setName(k.label);
  }

  async function handleInstall(e: React.FormEvent) {
    e.preventDefault();
    if (!creds || !picked || !name.trim()) return;
    setInstalling(true);
    try {
      await createProject(activeSpaceId, creds, name.trim(), picked.description, picked.kind);
      setPicked(null);
      show(`"${name.trim()}" installed.`);
      await refresh();
    } catch (err) {
      show(err instanceof Error ? err.message : "Failed to install plugin");
    } finally {
      setInstalling(false);
    }
  }

  return (
    <div className="page-view">
      <div className="page-header">
        <div className="page-title">Plugins</div>
        <div className="page-subtitle">
          Native business infrastructure — a wallet, a CRM, a shared inbox — installed as projects
          your agents work inside. Some come with your business by default; add more any time.
        </div>
      </div>

      {loading ? (
        <p style={{ color: "var(--text3)", fontSize: 13 }}>Loading…</p>
      ) : loadFailed ? (
        <div style={{ display: "flex", alignItems: "center", gap: 12, fontSize: 13 }}>
          <span style={{ color: "#dc2626" }} role="alert">
            Couldn&rsquo;t load your plugins — this is a loading problem, nothing is lost.
          </span>
          <Button variant="secondary" onClick={() => void refresh()}>Retry</Button>
        </div>
      ) : (
        <>
          <div className="section-label">Installed{installed.length > 0 ? ` (${installed.length})` : ""}</div>
          {installed.length === 0 ? (
            <p style={{ color: "var(--text3)", fontSize: 13 }}>
              Nothing installed yet — add one from the catalogue below.
            </p>
          ) : (
            <div className="grid-3">
              {installed.map((i) => (
                <Link
                  key={i.project.id}
                  href={`/p/${product.slug}/projects/${i.project.id}`}
                  style={{ textDecoration: "none" }}
                >
                  <Card interactive>
                    <div className="app-card-header">
                      <div className="app-card-initial">{i.label.slice(0, 1)}</div>
                      <CardTitle>{i.project.name}</CardTitle>
                    </div>
                    {i.description && <CardDesc>{i.description}</CardDesc>}
                    <Badge color="green">Installed</Badge>
                  </Card>
                </Link>
              ))}
            </div>
          )}

          {available.length > 0 && (
            <>
              <div className="section-label" style={{ marginTop: 26 }}>Add a plugin</div>
              <div className="grid-3">
                {available.map((k) => (
                  <Card key={k.kind} interactive onClick={() => openInstall(k)} style={{ cursor: "pointer" }}>
                    <div className="app-card-header">
                      <div className="app-card-initial">{k.label.slice(0, 1)}</div>
                      <CardTitle>{k.label}</CardTitle>
                    </div>
                    <CardDesc>{k.description}</CardDesc>
                    <div style={{ display: "flex", gap: 6, flexWrap: "wrap" }}>
                      {/* autoProvisionable kinds are the ones a business template installs by
                          default — surface that so an operator knows which come free with a
                          business vs. which they're adding by hand. */}
                      {k.autoProvisionable && <Badge color="blue">Default</Badge>}
                      {installedKinds.has(k.kind) && !k.singleton && <Badge color="green">Installed</Badge>}
                    </div>
                  </Card>
                ))}
              </div>
            </>
          )}

          {available.length === 0 && installed.length > 0 && (
            <p style={{ color: "var(--text3)", fontSize: 13, marginTop: 20 }}>
              Every plugin available to you is already installed.
            </p>
          )}
        </>
      )}

      <Modal
        open={picked !== null}
        onClose={() => setPicked(null)}
        title={picked ? `Install ${picked.label}` : "Install plugin"}
        footer={
          <>
            <Button variant="secondary" type="button" onClick={() => setPicked(null)}>Cancel</Button>
            <Button onClick={handleInstall} disabled={installing || !name.trim()}>
              {installing ? "Installing…" : "Install"}
            </Button>
          </>
        }
      >
        <form onSubmit={handleInstall} style={{ display: "flex", flexDirection: "column", gap: 12 }}>
          {picked && <p style={{ fontSize: 13, color: "var(--text3)", margin: 0 }}>{picked.description}</p>}
          <FormInput
            placeholder="Name it"
            value={name}
            onChange={(e) => setName(e.target.value)}
            required
            autoFocus
          />
        </form>
      </Modal>
      <Toast toast={toast} />
    </div>
  );
}
</file>

<file path="apps/shell/src/app/p/[slug]/(shell)/projects/[projectId]/threads/[threadId]/page.tsx">
"use client";

export const runtime = "edge";

// A project thread's chat surface, addressed under the project it belongs to
// (/projects/:projectId/threads/:threadId) rather than at the flat /threads/:id — a thread is not
// a free-floating object, it lives in a project, and the URL should say so. The flat route stays
// for now since the standalone Threads browse still links to it.
//
// Threads (SpaceDO `threads`, structural) and chat sessions (SpaceDO `sessions`, the message
// transport) are now linked server-side via threads.session_id (see thread.create in
// project-coordination.ts and startSession's thread_id param) — thread.session_id is passed
// straight to Chat below rather than relying on sessionKey's client-side cache.
//
// A left rail lists this project's OTHER threads (collapsible) so a person can move between
// conversations in the same project without going back to the project page first — reuses the
// same .spaces-layout/.spaces-sidebar shell the project page's own tree already uses, but does
// NOT use .spaces-content for the chat side: that class adds its own padding + overflow-y:auto,
// which would fight Chat's own internal .chat-layout/.chat-area scroll and sticky-composer
// layout. Chat is mounted as a direct flex sibling instead so its own flex:1 sizing still works.

import * as React from "react";
import Link from "next/link";
import { useParams } from "next/navigation";
import { useProduct } from "@/lib/product-context";
import { Chat } from "@/components/Chat";
import { useProductAuth } from "@/lib/auth-provider";
import { useActiveSpace } from "@/lib/active-space-context";
import { getThread, listThreads, type ThreadSummary } from "@/lib/api";

export default function ProjectThreadPage() {
  const params = useParams<{ projectId: string; threadId: string }>();
  const product = useProduct();
  const { activeSpaceId, supportContact } = useActiveSpace();
  const { session } = useProductAuth();
  const [thread, setThread] = React.useState<ThreadSummary | null>(null);
  const [loadFailed, setLoadFailed] = React.useState(false);
  const [siblingThreads, setSiblingThreads] = React.useState<ThreadSummary[]>([]);
  const [railOpen, setRailOpen] = React.useState(true);

  // Closed by default on a phone. Below 900px `.spaces-sidebar` becomes a full-width horizontal
  // strip above the content — fine on Discover, wrong here: it steals vertical space from a chat
  // surface that needs the full height for its message area and sticky composer, which is what
  // made this page unusable on mobile once the rail was added. Reopening it is one tap.
  //
  // Done in an effect rather than a lazy useState initialiser on purpose: reading `window` during
  // the first render would mismatch the server-rendered markup. Same pattern as the right-hand
  // thread panel's own mobile default.
  React.useEffect(() => {
    if (typeof window !== "undefined" && window.matchMedia("(max-width: 900px)").matches) {
      setRailOpen(false);
    }
  }, []);

  const creds = session ? { sessionToken: session.session_token, endUserId: session.end_user_id } : null;

  React.useEffect(() => {
    if (!creds) return;
    let cancelled = false;
    setThread(null);
    setLoadFailed(false);
    void getThread(activeSpaceId, params.threadId, creds)
      .then((t) => {
        if (!cancelled) setThread(t);
      })
      .catch(() => {
        if (!cancelled) setLoadFailed(true);
      });
    return () => {
      cancelled = true;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [activeSpaceId, params.threadId, session]);

  // The rail's own thread list — a separate fetch from the single-thread lookup above, and
  // deliberately not blocking on it: a slow/failed list fetch shouldn't hold up opening the
  // thread itself, it just means the rail renders with nothing (or stays as it was) that tick.
  React.useEffect(() => {
    if (!creds) return;
    let cancelled = false;
    void listThreads(activeSpaceId, creds, { projectId: params.projectId })
      .then((list) => {
        if (!cancelled) setSiblingThreads(list);
      })
      .catch(() => {
        /* the rail just shows nothing this render; the thread itself still opens */
      });
    return () => {
      cancelled = true;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [activeSpaceId, params.projectId, params.threadId, session]);

  if (!creds) return null;
  if (loadFailed) {
    return (
      <div className="page-view">
        <p style={{ color: "var(--text3)", fontSize: 13 }}>Couldn't load this thread. Try again from the project.</p>
      </div>
    );
  }
  // Wait for the thread to load before mounting Chat, rather than rendering it immediately with
  // no session_id known yet: Chat's `sessionId` prop is read once, on mount, to decide whether to
  // reuse an existing linked session or fall back to client-side caching. Rendering Chat before
  // the thread loads would always take the fallback path — for a thread that already HAS a
  // session (opened again, or from a different browser/tab), that meant minting a brand new,
  // unlinked session every time instead of reusing the real one.
  if (!thread) return <div className="page-view">Loading…</div>;

  return (
    <div className="spaces-layout">
      {railOpen && (
        <div className="spaces-sidebar">
          <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", padding: "2px 4px 6px" }}>
            <span style={{ fontSize: 10.5, fontWeight: 500, color: "var(--text3)", letterSpacing: "0.07em", textTransform: "uppercase" }}>
              Threads in this project
            </span>
            <button
              type="button"
              onClick={() => setRailOpen(false)}
              title="Hide thread list"
              style={{ background: "transparent", border: "none", color: "var(--text3)", cursor: "pointer", fontSize: 14, lineHeight: 1, padding: 2 }}
            >
              ‹
            </button>
          </div>
          <Link
            href={`/p/${product.slug}/projects/${params.projectId}`}
            className="space-tree-item"
            style={{ textDecoration: "none" }}
          >
            <svg viewBox="0 0 16 16" fill="none" strokeWidth={1.5} stroke="currentColor"><path d="M2 4H6L7 5H14V13H2V4Z" /></svg>
            Back to project
          </Link>
          <div style={{ padding: "4px 10px", margin: "4px 0" }}>
            <div style={{ height: 1, background: "var(--border)" }} />
          </div>
          {siblingThreads.length === 0 ? (
            <p style={{ fontSize: 11.5, color: "var(--text3)", padding: "4px 10px" }}>No other threads yet.</p>
          ) : (
            siblingThreads.map((t) => (
              <Link
                key={t.id}
                href={`/p/${product.slug}/projects/${params.projectId}/threads/${t.id}`}
                className={`space-tree-item${t.id === params.threadId ? " active" : ""}`}
                style={{ textDecoration: "none" }}
              >
                <svg viewBox="0 0 16 16" fill="none" strokeWidth={1.5} stroke="currentColor"><path d="M4 2H10L13 5V14H4V2Z" /></svg>
                <span style={{ overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{t.title ?? "Untitled thread"}</span>
              </Link>
            ))
          )}
        </div>
      )}
      {!railOpen && (
        <button type="button" className="rail-expander" onClick={() => setRailOpen(true)} title="Show thread list">
          ›<span className="rail-expander-label">Threads in this project</span>
        </button>
      )}
      <div style={{ flex: 1, minWidth: 0, display: "flex" }}>
        <Chat
          spaceId={activeSpaceId}
          session={creds}
          sessionKey={params.threadId}
          title={thread.title ?? "Thread"}
          supportContact={supportContact}
          threadId={params.threadId}
          projectId={params.projectId}
          {...(thread.session_id ? { sessionId: thread.session_id } : {})}
        />
      </div>
    </div>
  );
}
</file>

<file path="apps/shell/src/app/p/[slug]/(shell)/projects/[projectId]/page.tsx">
"use client";

export const runtime = "edge";

// Ported from apps/launchpad/src/index.html's Projects page (#projects-view): breadcrumb, a
// header with icon action buttons, a stats row, a searchable thread list with status-colored
// badges, and an agents-in-project grid ending in a "view all" card — using the SAME global
// classes (grid-4, workflow-item, badge-green/amber, search-bar, card-icon, btn-ghost/btn-primary)
// packages/ui/src/styles.css already ports verbatim from that same mockup, so this isn't a
// re-theme, it's actually using the shared system the way the mockup's own markup does.
//
// Kept, not ported: the mockup's per-tile "Credits used" stat (not tracked per-project — would be
// fabricated, same precedent as this codebase's `credits_consumed: null` elsewhere) and each
// thread/agent's fake run counts. Everything else here is real, fetched data.

import * as React from "react";
import { useParams, useRouter } from "next/navigation";
import Link from "next/link";
import { Button, Card, CardLabel, CardValue, CardTitle, CardDesc, Modal, FormInput, FormSelect, FormTextarea, useToast, Toast } from "@naelao/ui";
import { relativeTime } from "@/lib/relativeTime";
import { useProduct } from "@/lib/product-context";
import { useProductAuth } from "@/lib/auth-provider";
import { useActiveSpace } from "@/lib/active-space-context";
import {
  getProject,
  updateProject,
  listThreads,
  listProjects,
  createThread,
  listAgentDefinitions,
  listKbDocuments,
  createKbDocument,
  deleteKbDocument,
  listAgentTemplates,
  instantiateAgentTemplate,
  type Project,
  type ThreadSummary,
  type AgentDefinitionSummary,
  type KbDocument,
  type AgentTemplateSummary,
} from "@/lib/api";
import { ProjectKindPanel } from "@/components/ProjectKindPanel";
import { CustomerBotAutomation } from "@/components/CustomerBotAutomation";
import { AgentPolicyPanel } from "@/components/AgentPolicyPanel";

const STATUS_BADGE: Record<string, "green" | "amber" | "blue" | undefined> = {
  active: "green",
  archived: undefined,
};

export default function ProjectDetailPage() {
  const params = useParams<{ projectId: string }>();
  const router = useRouter();
  const product = useProduct();
  const { activeSpaceId, activeSpaceName } = useActiveSpace();
  const { session } = useProductAuth();
  const { toast, show } = useToast();
  const [project, setProject] = React.useState<Project | null>(null);
  const [allProjects, setAllProjects] = React.useState<Project[]>([]);
  const [threads, setThreads] = React.useState<ThreadSummary[]>([]);
  const [agents, setAgents] = React.useState<AgentDefinitionSummary[]>([]);
  const [loading, setLoading] = React.useState(true);
  const [creating, setCreating] = React.useState(false);
  const [threadQuery, setThreadQuery] = React.useState("");
  const settingsRef = React.useRef<HTMLDivElement>(null);

  // Naelao Agent Templates — add a real, differently-configured agent to this project.
  const [templatePickerOpen, setTemplatePickerOpen] = React.useState(false);
  const [templates, setTemplates] = React.useState<AgentTemplateSummary[]>([]);
  const [templatesLoading, setTemplatesLoading] = React.useState(false);
  const [instantiating, setInstantiating] = React.useState(false);

  const [docs, setDocs] = React.useState<KbDocument[]>([]);
  const [docsLoading, setDocsLoading] = React.useState(true);
  const [newDocTitle, setNewDocTitle] = React.useState("");
  const [newDocContent, setNewDocContent] = React.useState("");
  const [addingDoc, setAddingDoc] = React.useState(false);

  // WS-4.2: editable draft of the rich project config (customer_bot kind, execution ceiling,
  // spend cap, max threads, agent bindings) — PATCH succeeds for an admin/owner in the target
  // business; the settings section is still shown to a plain member (read-only save attempt
  // will surface the 403 via toast rather than pre-computing role client-side).
  const [savingSettings, setSavingSettings] = React.useState(false);
  const [draftKind, setDraftKind] = React.useState<"workspace" | "customer_bot">("workspace");
  const [draftMaxThreads, setDraftMaxThreads] = React.useState("0");
  const [draftExecutionCeiling, setDraftExecutionCeiling] = React.useState("5");
  const [draftSpendCap, setDraftSpendCap] = React.useState("0");
  const [draftDefaultAgentId, setDraftDefaultAgentId] = React.useState("");

  const creds = session ? { sessionToken: session.session_token, endUserId: session.end_user_id } : null;

  const refresh = React.useCallback(async () => {
    if (!creds) return;
    setLoading(true);
    try {
      const [p, t, a, allP] = await Promise.all([
        getProject(activeSpaceId, params.projectId, creds),
        listThreads(activeSpaceId, creds, { projectId: params.projectId }),
        listAgentDefinitions(activeSpaceId, creds).catch(() => []),
        listProjects(activeSpaceId, creds).catch(() => []),
      ]);
      setProject(p);
      setThreads(t);
      setAgents(a);
      setAllProjects(allP);
      setDraftKind(p.kind === "customer_bot" ? "customer_bot" : "workspace");
      setDraftMaxThreads(String(p.max_threads ?? 0));
      setDraftExecutionCeiling(String(p.execution_ceiling ?? 5));
      setDraftSpendCap(String(p.daily_spend_cap_credits ?? 0));
      setDraftDefaultAgentId(p.default_agent_id ?? "");
    } catch {
      show("Couldn't load project");
    } finally {
      setLoading(false);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [activeSpaceId, params.projectId, session]);

  const refreshDocs = React.useCallback(async () => {
    if (!creds) return;
    setDocsLoading(true);
    try {
      setDocs(await listKbDocuments(activeSpaceId, creds, params.projectId));
    } catch {
      show("Couldn't load knowledge base");
    } finally {
      setDocsLoading(false);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [activeSpaceId, params.projectId, session]);

  React.useEffect(() => {
    void refresh();
    void refreshDocs();
  }, [refresh, refreshDocs]);

  // Defensive re-fetch on regaining focus: a thread created from this project's own "New Thread"
  // button navigates straight into it, so coming back here (tab switch, browser back) should
  // never show a stale list from before that thread existed.
  React.useEffect(() => {
    function onFocus() {
      void refresh();
    }
    window.addEventListener("focus", onFocus);
    return () => window.removeEventListener("focus", onFocus);
  }, [refresh]);

  async function openTemplatePicker() {
    setTemplatePickerOpen(true);
    if (templates.length > 0 || !creds) return;
    setTemplatesLoading(true);
    try {
      setTemplates(await listAgentTemplates(activeSpaceId, creds));
    } catch {
      show("Couldn't load agent templates");
    } finally {
      setTemplatesLoading(false);
    }
  }

  async function handleAddFromTemplate(t: AgentTemplateSummary) {
    if (!creds || instantiating) return;
    setInstantiating(true);
    try {
      await instantiateAgentTemplate(activeSpaceId, creds, { template_id: t.id, project_id: params.projectId });
      setTemplatePickerOpen(false);
      show(`${t.name} added to this project`);
      void refresh();
    } catch (err) {
      show(err instanceof Error ? err.message : "Couldn't add this agent");
    } finally {
      setInstantiating(false);
    }
  }

  async function handleNewThread() {
    if (!creds) return;
    setCreating(true);
    try {
      const created = await createThread(activeSpaceId, creds, { project_id: params.projectId, title: "New thread" });
      // Open it. Creating a thread and being left staring at the same list is a dead end — the
      // point of making one is to start working in it.
      router.push(`/p/${product.slug}/projects/${params.projectId}/threads/${created.id}`);
    } catch (err) {
      show(err instanceof Error ? err.message : "Failed to create thread");
    } finally {
      setCreating(false);
    }
  }

  async function handleSaveSettings() {
    if (!creds) return;
    setSavingSettings(true);
    try {
      const updated = await updateProject(activeSpaceId, params.projectId, creds, {
        kind: draftKind,
        max_threads: Number(draftMaxThreads) || 0,
        execution_ceiling: Number(draftExecutionCeiling) || 1,
        daily_spend_cap_credits: Number(draftSpendCap) || 0,
        default_agent_id: draftDefaultAgentId || null,
      });
      setProject(updated);
      show("Settings saved");
    } catch (err) {
      show(err instanceof Error ? err.message : "Failed to save settings (admin role required)");
    } finally {
      setSavingSettings(false);
    }
  }

  // Step 13b: upload a FILE into the project KB, not just paste text. Reads a text-readable file
  // and pre-fills the title (from the filename) + content, then the person clicks Add. Same
  // text-only/2MB guard as the space-wide Knowledge Base page (real PDF/office parsing is a
  // separate, larger pipeline feature — a binary is rejected rather than ingested as garbage).
  const fileInputRef = React.useRef<HTMLInputElement>(null);
  async function handlePickFile(e: React.ChangeEvent<HTMLInputElement>) {
    const file = e.target.files?.[0];
    e.target.value = ""; // allow re-picking the same file
    if (!file) return;
    if (file.size > 2 * 1024 * 1024) {
      show("File is over 2MB — paste the relevant part instead, or upload a smaller file.");
      return;
    }
    try {
      const text = await file.text();
      if (!/\S/.test(text)) {
        show("That file has no readable text (it may be a PDF/image/binary — paste the text instead).");
        return;
      }
      if (!newDocTitle.trim()) setNewDocTitle(file.name.replace(/\.[^.]+$/, ""));
      setNewDocContent(text);
    } catch {
      show("Couldn't read that file.");
    }
  }

  async function handleAddDoc(e: React.FormEvent) {
    e.preventDefault();
    if (!creds || !newDocTitle.trim() || !newDocContent.trim()) return;
    setAddingDoc(true);
    try {
      await createKbDocument(activeSpaceId, creds, {
        title: newDocTitle.trim(),
        content: newDocContent.trim(),
        project_id: params.projectId,
      });
      setNewDocTitle("");
      setNewDocContent("");
      await refreshDocs();
    } catch (err) {
      show(err instanceof Error ? err.message : "Failed to add document");
    } finally {
      setAddingDoc(false);
    }
  }

  async function handleDeleteDoc(docId: string) {
    if (!creds) return;
    try {
      await deleteKbDocument(activeSpaceId, docId, creds);
      await refreshDocs();
    } catch (err) {
      show(err instanceof Error ? err.message : "Failed to delete document");
    }
  }

  if (loading) return <div className="page-view">Loading…</div>;
  if (!project) return <div className="page-view">Project not found.</div>;

  const lastActivityAt = threads.length > 0
    ? threads.reduce((latest, t) => (t.updated_at > latest ? t.updated_at : latest), threads[0]!.updated_at)
    : null;
  const visibleThreads = threadQuery.trim()
    ? threads.filter((t) => (t.title ?? "Untitled thread").toLowerCase().includes(threadQuery.trim().toLowerCase()))
    : threads;

  return (
    <div className="spaces-layout">
      {/* Left: project tree nav — the mockup's #projects-view left rail (quick-switch between
          this space's projects without leaving the detail view), plus space-wide shortcuts to
          Agent Library / Knowledge Base. Thread counts are shown ONLY for the currently open
          project (the one count already fetched here) — fetching every OTHER project's thread
          count just to populate this rail would be an N+1 for a cosmetic number, so those are
          left off rather than fabricated or paid for. */}
      <div className="spaces-sidebar">
        <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", padding: "2px 4px 6px" }}>
          <span style={{ fontSize: 10.5, fontWeight: 500, color: "var(--text3)", letterSpacing: "0.07em", textTransform: "uppercase" }}>
            Projects
          </span>
        </div>
        {allProjects.map((p) => (
          <Link
            key={p.id}
            href={`/p/${product.slug}/projects/${p.id}`}
            className={`space-tree-item${p.id === params.projectId ? " active" : ""}`}
            style={{ textDecoration: "none" }}
          >
            <svg viewBox="0 0 16 16" fill="none" strokeWidth={1.5} stroke="currentColor"><path d="M2 4H6L7 5H14V13H2V4Z" /></svg>
            {p.name}
            {p.id === params.projectId && <span style={{ marginLeft: "auto", fontSize: 10, color: "var(--text3)" }}>{threads.length}</span>}
          </Link>
        ))}
        <div style={{ padding: "4px 10px", marginTop: 4 }}>
          <div style={{ height: 1, background: "var(--border)" }} />
        </div>
        <div style={{ padding: "10px 14px 4px", fontSize: 10.5, fontWeight: 500, color: "var(--text3)", letterSpacing: "0.07em", textTransform: "uppercase" }}>
          Agents in Space
        </div>
        <Link href={`/p/${product.slug}/agents`} className="space-tree-item" style={{ textDecoration: "none" }}>
          <svg viewBox="0 0 16 16" fill="none" strokeWidth={1.5} stroke="currentColor"><rect x="3" y="3" width="10" height="10" rx="2" /><circle cx="6" cy="7" r="1" /><circle cx="10" cy="7" r="1" /><path d="M6 10C6 10 7 11 10 10" /></svg>
          Agent Library
        </Link>
        <Link href={`/p/${product.slug}/knowledge`} className="space-tree-item" style={{ textDecoration: "none" }}>
