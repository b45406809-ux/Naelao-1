  if (type === 'html') {
    // HTML-encode for safe srcdoc embedding — no template literal interpolation of user code
    const escaped = code
      .replace(/&amp;/g, '&amp;amp;').replace(/"/g, '&amp;quot;')
      .replace(/&lt;/g, '&amp;lt;').replace(/&gt;/g, '&amp;gt;');
