    <span class="sec-ey">57 — SpaceDO Methods</span>
    <h2>SpaceDO Methods — Replacing All Stored Functions</h2>
    <div class="bar"></div>
    <p class="lead">Several critical operations in Naelao require stored functions in Supabase PostgreSQL. These
      functions run inside the database, avoiding round-trips and ensuring atomicity. This section documents every
      stored function, its purpose, and its complete SQL implementation.</p>

    <h3>Function 1 — get_llm_formatted_messages</h3>
    <p>Fetches and formats conversation messages for LLM context injection. This is the most important stored function —
      called on every agent turn. It returns messages in the exact format needed by the Anthropic SDK.</p>
    <pre><code><span class="cm">// workers/naelao-spaces/src/dos/SpaceDO.ts — method implementations
// All former Supabase RPCs are now typed DO methods called via Service Binding.</span>

CREATE OR REPLACE FUNCTION get_llm_formatted_messages(
  p_thread_id UUID,
  p_space_id  UUID,
  p_limit     INTEGER DEFAULT 100,
  p_before    TIMESTAMPTZ DEFAULT NULL
)
RETURNS TABLE (
  role    TEXT,
  content TEXT,
  created_at TIMESTAMPTZ
)
LANGUAGE plpgsql
SECURITY DEFINER  <span class="cm">-- runs as function owner, not caller (allows cross-table reads)</span>
AS $$
BEGIN
  <span class="cm">-- RLS check: verify caller has access to this space</span>
  IF NOT EXISTS (
    SELECT 1 FROM space_members
    WHERE space_id = p_space_id AND user_id = auth.uid()
  ) THEN
    RAISE EXCEPTION 'Access denied to space %', p_space_id;
  END IF;

  RETURN QUERY
  SELECT
    m.role,
    m.content,
    m.created_at
  FROM messages m
  WHERE m.thread_id = p_thread_id
    AND m.space_id = p_space_id
    AND m.deleted_at IS NULL
    AND (p_before IS NULL OR m.created_at &lt; p_before)
    AND m.role != 'system'  <span class="cm">-- system messages are in system_prompt, not messages array</span>
  ORDER BY m.created_at ASC
  LIMIT p_limit;
END;
$$;</code></pre>

    <h3>Function 2 — get_stale_projects_for_categorization</h3>
    <pre><code><span class="cm">-- Called by naelao-categorizer cron Worker every hour
-- Returns projects with uncategorized conversations</span>

CREATE OR REPLACE FUNCTION get_stale_projects_for_categorization(
  p_limit INTEGER DEFAULT 20
)
RETURNS TABLE (
  project_id UUID,
  space_id   UUID,
  thread_count INTEGER,
  last_message_at TIMESTAMPTZ
)
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
BEGIN
  RETURN QUERY
  SELECT
    p.id AS project_id,
    p.space_id,
    COUNT(DISTINCT t.id)::INTEGER AS thread_count,
    MAX(m.created_at) AS last_message_at
  FROM projects p
  JOIN threads t ON t.project_id = p.id
  JOIN messages m ON m.thread_id = t.id
  WHERE p.status = 'active'
    AND (p.last_categorized_at IS NULL
         OR p.last_categorized_at &lt; NOW() - INTERVAL '24 hours')
    AND m.created_at &gt; NOW() - INTERVAL '7 days'
  GROUP BY p.id, p.space_id
  HAVING COUNT(m.id) &gt; 10  <span class="cm">-- only categorize projects with meaningful activity</span>
  ORDER BY last_message_at DESC
  LIMIT p_limit;
END;
$$;</code></pre>

    <h3>Function 3 — create_space_with_defaults</h3>
    <pre><code><span class="cm">-- Atomic space creation: creates space + member record + default settings in one transaction
-- Called by naelao-spaces Worker on POST /api/spaces</span>

CREATE OR REPLACE FUNCTION create_space_with_defaults(
  p_name         TEXT,
  p_type         TEXT,
  p_admin_user_id UUID,
  p_parent_id    UUID DEFAULT NULL,
  p_settings     JSONB DEFAULT '{}'
)
RETURNS TABLE (
  space_id    UUID,
  slug        TEXT,
  depth       INTEGER
)
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
DECLARE
  v_space_id UUID;
  v_slug     TEXT;
  v_depth    INTEGER;
BEGIN
  <span class="cm">-- Generate URL-friendly slug from name</span>
  v_slug := LOWER(REGEXP_REPLACE(p_name, '[^a-zA-Z0-9]+', '-', 'g'));
  v_slug := TRIM(BOTH '-' FROM v_slug);

  <span class="cm">-- Ensure slug uniqueness by appending random suffix if needed</span>
  IF EXISTS (SELECT 1 FROM spaces WHERE slug = v_slug) THEN
    v_slug := v_slug || '-' || SUBSTRING(gen_random_uuid()::TEXT FROM 1 FOR 6);
  END IF;

  <span class="cm">-- Calculate depth from parent</span>
  IF p_parent_id IS NULL THEN
    v_depth := 0;
  ELSE
    SELECT depth + 1 INTO v_depth FROM spaces WHERE id = p_parent_id;
    IF v_depth IS NULL THEN
      RAISE EXCEPTION 'Parent space not found: %', p_parent_id;
    END IF;
    IF v_depth &gt; 3 THEN
      RAISE EXCEPTION 'Maximum sub-space depth (3) exceeded';
    END IF;
  END IF;

  <span class="cm">-- Create the space (atomic with member creation below)</span>
  INSERT INTO spaces (name, slug, type, admin_user_id, parent_id, depth, settings)
  VALUES (p_name, v_slug, p_type, p_admin_user_id, p_parent_id, v_depth, p_settings)
  RETURNING id INTO v_space_id;

  <span class="cm">-- Add creator as owner</span>
  INSERT INTO space_members (space_id, user_id, role)
  VALUES (v_space_id, p_admin_user_id, 'owner');

  <span class="cm">-- Create initial credit balance</span>
  INSERT INTO space_credits (space_id, balance_usd, billing_tier)
  VALUES (v_space_id, 5.00, 'free');  <span class="cm">-- $5 free credit on signup</span>

  RETURN QUERY SELECT v_space_id, v_slug, v_depth;
END;
$$;</code></pre>

    <h3>Function 4 — get_active_assistants</h3>
    <pre><code><span class="cm">-- Called by naelao-sweeper every 5 minutes to get assistants that need heartbeat
-- Returns only truly active assistants to avoid wasting DO wakeups</span>

CREATE OR REPLACE FUNCTION get_active_assistants(
  p_limit INTEGER DEFAULT 1000
)
RETURNS TABLE (
  user_id  UUID,
  space_id UUID
)
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
BEGIN
  RETURN QUERY
  WITH recent_users AS (
    SELECT DISTINCT
      t.user_id,
      t.space_id
    FROM threads t
    WHERE t.created_at &gt; NOW() - INTERVAL '30 days'
      AND t.deleted_at IS NULL
    UNION
    <span class="cm">-- Also include new members (may not have threads yet)</span>
    SELECT
      sm.user_id,
      sm.space_id
    FROM space_members sm
    WHERE sm.joined_at &gt; NOW() - INTERVAL '7 days'
  )
  SELECT ru.user_id, ru.space_id
  FROM recent_users ru
  JOIN spaces s ON s.id = ru.space_id
  WHERE s.status = 'active'
  LIMIT p_limit;
END;
$$;</code></pre>

    <h3>Function 5 — deduct_space_credits (Atomic)</h3>
    <pre><code><span class="cm">-- Called by naelao-billing to atomically deduct credits from a Space
-- Returns success=true + new balance, or success=false if insufficient funds
-- Using a stored function guarantees atomicity without application-level transactions</span>

CREATE OR REPLACE FUNCTION deduct_space_credits(
  p_space_id UUID,
  p_amount   NUMERIC,
  p_reason   TEXT,
  p_run_id   TEXT DEFAULT NULL
)
RETURNS TABLE (
  success       BOOLEAN,
  new_balance   NUMERIC,
  error_message TEXT
)
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
DECLARE
  v_current_balance NUMERIC;
  v_new_balance     NUMERIC;
BEGIN
  <span class="cm">-- Lock the row to prevent concurrent deductions
  -- PostgreSQL row-level lock via FOR UPDATE</span>
  SELECT balance_usd INTO v_current_balance
  FROM space_credits
  WHERE space_id = p_space_id
  FOR UPDATE;

  IF v_current_balance IS NULL THEN
    RETURN QUERY SELECT FALSE, 0::NUMERIC, 'Space credit record not found';
    RETURN;
  END IF;

  IF v_current_balance &lt; p_amount THEN
    RETURN QUERY SELECT FALSE, v_current_balance,
      format('Insufficient credits: balance $%s, required $%s', v_current_balance, p_amount);
    RETURN;
  END IF;

  v_new_balance := v_current_balance - p_amount;

  <span class="cm">-- Update balance</span>
  UPDATE space_credits
  SET balance_usd = v_new_balance, updated_at = NOW()
  WHERE space_id = p_space_id;

  <span class="cm">-- Record the transaction</span>
  INSERT INTO credit_transactions (space_id, type, amount_usd, reason, run_id, balance_after)
  VALUES (p_space_id, 'debit', p_amount, p_reason, p_run_id, v_new_balance);

  RETURN QUERY SELECT TRUE, v_new_balance, NULL::TEXT;
END;
$$;</code></pre>
  </div>

