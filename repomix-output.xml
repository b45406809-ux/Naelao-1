    <!-- HOME TOPBAR -->
    <div id="home-topbar">
      <div class="credit-meter" onclick="showPage('analytics');showToast('Viewing credits')">
        <svg viewBox="0 0 16 16" fill="none" stroke-width="1.5" stroke="currentColor"><circle cx="8" cy="8" r="6"/><path d="M8 4V8L11 10"/></svg>
        <span class="credit-amount">8,240</span>
        <div class="credit-bar-mini"><div class="credit-bar-fill" style="width:68%"></div></div>
      </div>
      <button class="appearance-btn" onclick="openModal()">
        <svg viewBox="0 0 16 16" fill="none" stroke-width="1.5" stroke="currentColor"><circle cx="8" cy="8" r="3"/><circle cx="8" cy="8" r="6.5" stroke-dasharray="2 2"/></svg>
        Appearance
