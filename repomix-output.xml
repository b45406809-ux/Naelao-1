    <p class="lead">Every LLM call in Naelao routes through Cloudflare AI Gateway. This is not optional — it is the
      single choke point that provides caching, fallback routing, per-tenant analytics, rate limiting, and BYOK (Bring
      Your Own Key). Together AI extends this with open-source models and LoRA fine-tuning capability for the Bootstrap
      Mode and Verticals.</p>

    <h3>AI Gateway — The Full Implementation</h3>
    <p>Understanding what AI Gateway does and does not do is critical before implementing it. AI Gateway is a
      <strong>proxy</strong> — it sits between your Workers and the LLM provider's API. You point your SDK's base URL at
      the gateway URL instead of Anthropic's URL. The gateway then handles caching, analytics, fallback routing, and
      rate limiting transparently.</p>

    <div class="warn-box">
      <div class="warn-label">⚠ Critical Implementation Warning</div>
      <p><strong>AI Gateway is NOT a drop-in replacement for the Anthropic SDK</strong>. You still use the Anthropic
        SDK. You only change the <span class="ic">baseURL</span> parameter. If you try to call the AI Gateway URL
        directly without the SDK, you will get authentication errors because the SDK adds the required headers. Never
        call the gateway URL with a raw fetch() — always use the SDK with the modified baseURL.</p>
      <p>Second warning: The gateway URL format is specific. Copy it exactly: <span
          class="ic">https://gateway.ai.cloudflare.com/v1/{ACCOUNT_ID}/{GATEWAY_ID}/anthropic</span>. The trailing <span
          class="ic">/anthropic</span> tells the gateway which provider to route to. Different providers have different
        suffixes: <span class="ic">/openai</span>, <span class="ic">/workers-ai</span>, <span
          class="ic">/google-vertex-ai</span>.</p>
    </div>

    <pre><code><span class="cm">// shared/ai-client.ts
// THE canonical AI client factory for all of Naelao.
// Every Worker and DO that calls an LLM must use this function.
// Do NOT create Anthropic clients anywhere else in the codebase.</span>

import Anthropic from '@anthropic-ai/sdk';

export interface AIClientContext {
  spaceId: string;
  threadId?: string;
  userId?: string;
  agentId?: string;
  model?: string;
}

export function createAnthropicClient(env: Env, ctx: AIClientContext): Anthropic {
  const gatewayUrl = `https://gateway.ai.cloudflare.com/v1/${env.NAELAO_ACCOUNT_ID}/${env.NAELAO_GATEWAY_ID}/anthropic`;

  return new Anthropic({
    <span class="cm">// This is the ONLY change from a normal Anthropic client</span>
    baseURL: gatewayUrl,

    <span class="cm">// API key: either the platform key or a user-provided BYOK key
    // BYOK keys are fetched from naelao-credentials Worker, never hardcoded</span>
    apiKey: env.ANTHROPIC_API_KEY,

    defaultHeaders: {
      <span class="cm">// Per-tenant metadata — REQUIRED for correct billing and analytics
      // AI Gateway uses spaceId to namespace caching and rate limits</span>
      'cf-aig-metadata': JSON.stringify({
        spaceId: ctx.spaceId,
        threadId: ctx.threadId ?? 'unknown',
        userId: ctx.userId ?? 'system',
        agentId: ctx.agentId ?? 'unknown',
        model: ctx.model ?? 'claude-sonnet-4-5',
        platform: 'naelao',
        version: '1.0'
      }),

      <span class="cm">// Semantic caching TTL in seconds.
      // 3600 = cache for 1 hour. Set to 0 to disable caching for specific clients.
      // Research/classification calls benefit from caching.
      // Conversational calls should set this lower (60-300s) to avoid stale responses.</span>
      'cf-aig-cache-ttl': '3600',

      <span class="cm">// Skip cache for calls where fresh response is critical
      // (e.g., when agent is reading live data and generating a response)</span>
      // 'cf-aig-skip-cache': 'true',  // uncomment for real-time calls
    }
  });
}

<span class="cm">// Together AI client — for open-source models and fine-tuning</span>
export function createTogetherAIClient(env: Env, ctx: AIClientContext): Anthropic {
  <span class="cm">// Together AI is OpenAI-compatible, but we use the Anthropic SDK via a custom baseURL
  // that routes through our naelao-together-ai Worker which translates the API</span>
  return new Anthropic({
    baseURL: `https://app.naelao.dev/api/together-ai/v1`,
    apiKey: env.TOGETHER_AI_API_KEY,
    defaultHeaders: {
      'cf-aig-metadata': JSON.stringify({ ...ctx, provider: 'together-ai' })
    }
  });
}

<span class="cm">// BYOK (Bring Your Own Key) — load user's API key from naelao-credentials
export async function createBYOKClient(
  env: Env,
  ctx: AIClientContext,
  provider: 'anthropic' | 'openai' | 'together'
): Promise&lt;Anthropic&gt; {
  // Fetch encrypted key from naelao-credentials Worker</span>
  const credResponse = await env.NAELAO_CREDENTIALS.fetch(
    new Request('http://credentials/get', {
      method: 'POST',
      body: JSON.stringify({ spaceId: ctx.spaceId, provider })
    })
  );

  if (!credResponse.ok) {
    <span class="cm">// Fall back to platform key if user hasn't configured BYOK</span>
    return createAnthropicClient(env, ctx);
  }

  const { apiKey } = await credResponse.json() as { apiKey: string };

  return new Anthropic({
    baseURL: `https://gateway.ai.cloudflare.com/v1/${env.NAELAO_ACCOUNT_ID}/${env.NAELAO_GATEWAY_ID}/${provider}`,
    apiKey,
    defaultHeaders: {
      'cf-aig-metadata': JSON.stringify({ ...ctx, byok: true })
    }
  });
}</code></pre>

    <h3>AI Gateway Feature Configuration</h3>
    <div class="sg">
      <div class="sk">Semantic Caching</div>
      <div class="sv">Enabled by default via <span class="ic">cf-aig-cache-ttl: 3600</span> header. Caches LLM responses
        for semantically similar prompts — not just exact matches. Saves 40-80% of LLM costs for repetitive
        research/classification tasks. Cache is namespaced by spaceId so Space A's cache never pollutes Space B.</div>
      <div class="sk">Fallback Routing</div>
      <div class="sv">Configure in CF AI Gateway dashboard: Primary → Anthropic Claude Sonnet. Fallback 1 → Anthropic
        Claude Haiku. Fallback 2 → Workers AI (Llama-3.1-70B). Fallback triggers on: 429 rate limit, 503 service
        unavailable, timeout &gt;30s. Users never see an error — they get a slightly different model. Log the fallback
        to Analytics Engine.</div>
      <div class="sk">Per-Space Rate Limiting</div>
      <div class="sv">Configure in CF AI Gateway dashboard per gateway. Set tokens-per-minute limits per billing tier.
        Free: 50k tokens/min. Maker: 200k. Pro: 1M. Enterprise: unlimited. Rate limits enforced by spaceId in the
        cf-aig-metadata header. Exceeded limit returns 429 — NaelaoAgentDO catches this and retries with exponential
        backoff.</div>
      <div class="sk">Cost Analytics</div>
      <div class="sv">AI Gateway automatically tracks: input tokens, output tokens, cache read tokens, cache write
        tokens, cost per request. Query via CF Analytics Engine API: <span class="ic">SELECT spaceId, SUM(input_tokens)
          FROM ai_gateway_logs WHERE date &gt; '2026-05-01' GROUP BY spaceId</span>. This powers the per-Space billing
        breakdown in the admin dashboard.</div>
      <div class="sk">BYOK Configuration</div>
      <div class="sv">User provides API key in Space Settings → AI → API Keys. Frontend sends to naelao-credentials
        Worker which encrypts with AES-256-GCM using <span class="ic">NAELAO_MCP_ENCRYPTION_KEY</span> and stores in
        SpaceDO SQLite. When agent needs LLM: naelao-credentials decrypts and passes to createBYOKClient(). API key never
        appears in logs or Workers env vars.</div>
    </div>

    <h3>Together AI Integration — Complete Setup</h3>
    <p>Together AI provides access to open-source models (Llama, Mistral, Qwen) at 5-10x lower cost than Claude for
      tasks that don't need Claude's reasoning capability. The integration happens through the naelao-together-ai Worker
      which proxies requests to Together AI's API.</p>
    <pre><code><span class="cm">// workers/together-ai/index.ts
// Proxies Together AI API calls with Naelao's authentication layer.
// Translates between Anthropic SDK format and Together AI's OpenAI-compatible format.</span>

export default {
  async fetch(request: Request, env: Env): Promise&lt;Response&gt; {
    const url = new URL(request.url);
    const { spaceId } = extractSpaceFromRequest(request);

    <span class="cm">// Validate space access</span>
    await validateSpaceAccess(request, spaceId, env);

    <span class="cm">// Get Together AI API key for this space (BYOK or platform key)</span>
    const apiKey = await getTogetherApiKey(spaceId, env);
    if (!apiKey) {
      return Response.json({ error: 'Together AI not configured for this Space' }, { status: 400 });
    }

    if (url.pathname.includes('/v1/chat/completions')) {
      <span class="cm">// Chat completion — proxy to Together AI</span>
      const body = await request.json();
      
      const togetherResponse = await fetch('https://api.together.xyz/v1/chat/completions', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${apiKey}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          ...body,
          <span class="cm">// Together AI model names differ from Anthropic format</span>
          model: translateModelName(body.model)
        })
      });

      <span class="cm">// Log to Analytics Engine</span>
      await env.NAELAO_ANALYTICS_QUEUE.send({
        type: 'together_ai_call',
        spaceId,
        model: body.model,
        status: togetherResponse.status
      });

      return new Response(togetherResponse.body, {
        status: togetherResponse.status,
        headers: { 'Content-Type': 'application/json' }
      });
    }

    if (url.pathname.includes('/start-finetune')) {
      return handleFinetuneStart(request, apiKey, spaceId, env);
    }

    if (url.pathname.includes('/job-status')) {
      return handleJobStatus(request, apiKey, env);
    }

    if (url.pathname.includes('/register-model')) {
      return handleModelRegistration(request, spaceId, env);
    }

    return new Response('Not Found', { status: 404 });
  }
};

function translateModelName(naelaoModelName: string): string {
  <span class="cm">// Maps Naelao model names to Together AI model names</span>
  const modelMap: Record&lt;string, string&gt; = {
    'llama-3.1-70b':    'meta-llama/Llama-3.1-70B-Instruct-Turbo',
    'llama-3.1-8b':     'meta-llama/Llama-3.1-8B-Instruct-Turbo',
    'mistral-7b':       'mistralai/Mistral-7B-Instruct-v0.3',
    'qwen-2.5-72b':     'Qwen/Qwen2.5-72B-Instruct-Turbo',
    'deepseek-r1':      'deepseek-ai/DeepSeek-R1',
  };
  return modelMap[naelaoModelName] ?? naelaoModelName;
}</code></pre>

    <h3>LoRA Fine-Tuning — End-to-End Flow</h3>
    <pre><code><span class="cm">// Complete fine-tuning flow from UI to trained model.
// This is the most complex multi-step flow in Naelao.
// Every step must be durable because fine-tuning takes hours.

// workers/together-ai/finetune.ts</span>

async function handleFinetuneStart(
  request: Request,
  apiKey: string,
  spaceId: string,
  env: Env
): Promise&lt;Response&gt; {
  const { trainingFilePath, model, epochs, description } = await request.json();

  <span class="cm">// Step 1: Read training file from R2</span>
  const trainingObj = await env.NAELAO_WORKSPACE.get(trainingFilePath);
  if (!trainingObj) {
    return Response.json({ error: 'Training file not found in R2' }, { status: 404 });
  }
  const trainingData = await trainingObj.text();

  <span class="cm">// Validate JSONL format before sending to Together AI
  // Together AI will reject invalid JSONL silently — validate here first</span>
  const lines = trainingData.trim().split('\n');
  for (let i = 0; i &lt; lines.length; i++) {
    try {
      const parsed = JSON.parse(lines[i]);
      if (!parsed.messages || !Array.isArray(parsed.messages)) {
        return Response.json({
          error: `Line ${i + 1} of training file is not in chat format: {messages: [{role, content}]}`
        }, { status: 400 });
      }
      const hasUser = parsed.messages.some((m: {role: string}) => m.role === 'user');
      const hasAssistant = parsed.messages.some((m: {role: string}) => m.role === 'assistant');
      if (!hasUser || !hasAssistant) {
        return Response.json({
          error: `Line ${i + 1} must have at least one 'user' and one 'assistant' message`
        }, { status: 400 });
      }
    } catch {
      return Response.json({ error: `Line ${i + 1} is not valid JSON` }, { status: 400 });
    }
  }

  if (lines.length &lt; 50) {
    return Response.json({
      error: `Training file has ${lines.length} examples. Minimum 50 required for LoRA fine-tuning.`
    }, { status: 400 });
  }

  <span class="cm">// Step 2: Upload training file to Together AI
  // Together AI requires the file to be uploaded as multipart form data</span>
  const formData = new FormData();
  formData.append('file', new Blob([trainingData], { type: 'text/plain' }), 'train.jsonl');
  formData.append('purpose', 'fine-tune');

  const uploadResponse = await fetch('https://api.together.xyz/v1/files', {
    method: 'POST',
    headers: { 'Authorization': `Bearer ${apiKey}` },
    body: formData
  });

  if (!uploadResponse.ok) {
    const error = await uploadResponse.text();
    return Response.json({ error: `Together AI file upload failed: ${error}` }, { status: 502 });
  }

  const { id: fileId } = await uploadResponse.json() as { id: string };

  <span class="cm">// Step 3: Start fine-tuning job</span>
  const finetuneResponse = await fetch('https://api.together.xyz/v1/fine-tunes', {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${apiKey}`,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      training_file: fileId,
      model: translateModelName(model),
      n_epochs: epochs ?? 3,
      <span class="cm">// LoRA configuration for efficient fine-tuning</span>
      lora: true,
      lora_r: 16,        <span class="cm">// rank — higher = more capacity, more compute</span>
      lora_alpha: 32,    <span class="cm">// scaling factor — usually 2x lora_r</span>
      lora_dropout: 0.1, <span class="cm">// regularization — prevents overfitting</span>
      learning_rate: 0.0001,
      suffix: `naelao-${spaceId.slice(0, 8)}` <span class="cm">// custom model name suffix</span>
    })
  });

  if (!finetuneResponse.ok) {
    const error = await finetuneResponse.text();
    return Response.json({ error: `Together AI fine-tune start failed: ${error}` }, { status: 502 });
  }

  const { id: jobId } = await finetuneResponse.json() as { id: string };

  <span class="cm">// Step 4: Create FinetuneJobDO to track the job</span>
  const jobDO = env.NAELAO_FINETUNE_JOB.get(
    env.NAELAO_FINETUNE_JOB.idFromName(`ftjob:${spaceId}:${jobId}`)
  );
  await jobDO.fetch(new Request('http://job/init', {
    method: 'POST',
    body: JSON.stringify({
      jobId, spaceId, model, description,
      trainingFilePath, fileId, startedAt: Date.now()
    })
  }));

  <span class="cm">// Step 5: Trigger Dynamic Workflow to poll job status</span>
  await env.NAELAO_WORKFLOW.create({
    id: `finetune-poll-${jobId}`,
    params: {
      spaceId,
      jobId,
      workflowPath: 'platform/workflows/finetune-poll.ts'
    }
  });

  return Response.json({ jobId, status: 'started', message: 'Fine-tuning started. This typically takes 2-24 hours.' });
}</code></pre>

    <h3>Model Selector UI Integration</h3>
    <p>When Together AI is connected or a fine-tuned model is approved, it must appear in the frontend model selector.
      This requires a clean API that returns available models per Space.</p>
    <pre><code><span class="cm">// workers/agents/models.ts
// GET /api/spaces/{spaceId}/available-models
// Returns all models available to this Space, including fine-tuned models</span>

export async function getAvailableModels(spaceId: string, env: Env): Promise&lt;Model[]&gt; {
  const models: Model[] = [
    <span class="cm">// Always-available Anthropic models</span>
    { id: 'claude-opus-4-5',   name: 'Claude Opus 4.5',   provider: 'anthropic', tier: 'pro' },
    { id: 'claude-sonnet-4-5', name: 'Claude Sonnet 4.5', provider: 'anthropic', tier: 'maker' },
    { id: 'claude-haiku-4-5',  name: 'Claude Haiku 4.5',  provider: 'anthropic', tier: 'free' },
  ];

  <span class="cm">// Add Workers AI models (always available, cheapest)</span>
  models.push(
    { id: 'workers-ai-llama-3.1-70b', name: 'Llama 3.1 70B (Workers AI)', provider: 'workers-ai', tier: 'free' },
    { id: 'workers-ai-llama-3.1-8b',  name: 'Llama 3.1 8B (Workers AI)',  provider: 'workers-ai', tier: 'free' }
  );

  <span class="cm">// Check if Space has Together AI connected</span>
  const hasTogetherAI = await env.NAELAO_CONFIG_KV.get(`together-ai-connected:${spaceId}`);
  if (hasTogetherAI) {
    models.push(
      { id: 'llama-3.1-70b',  name: 'Llama 3.1 70B (Together AI)', provider: 'together-ai', tier: 'maker' },
      { id: 'deepseek-r1',    name: 'DeepSeek R1 (Together AI)',    provider: 'together-ai', tier: 'maker' },
      { id: 'qwen-2.5-72b',   name: 'Qwen 2.5 72B (Together AI)',   provider: 'together-ai', tier: 'maker' }
    );
  }

  <span class="cm">// Check for approved fine-tuned models</span>
  const fineTunedModels = await spaceDO.query(  // SpaceDO method replaces direct Hyperdrive query
    'SELECT id, name, base_model, status FROM fine_tune_jobs WHERE space_id = ? AND status = ? AND approved = 1',
    [spaceId, 'completed']
  );

  for (const m of fineTunedModels.rows) {
    models.push({
      id: `finetune:${m.id}`,
      name: `${m.name} (Fine-tuned)`,
      provider: 'together-ai-finetune',
      tier: 'pro',
      isFineTuned: true,
      baseModel: m.base_model
    });
  }

  return models;
}</code></pre>
