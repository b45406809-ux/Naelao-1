          <h3>Complete WorkflowRegistryDO</h3>
          <pre><code><span class="cm">// durable-objects/workflow-registry-do.ts — COMPLETE</span>
export class WorkflowRegistryDO extends DurableObject {
  private spaceId = '';

  private async initSchema() {
    this.ctx.storage.sql.exec(`
      CREATE TABLE IF NOT EXISTS workflows (
        id          TEXT PRIMARY KEY,
        name        TEXT NOT NULL,
        description TEXT,
        r2_path     TEXT NOT NULL,
        schedule    TEXT,
        last_run    INTEGER NOT NULL DEFAULT 0,
        next_run    INTEGER NOT NULL DEFAULT 0,
        run_count   INTEGER NOT NULL DEFAULT 0,
        error_count INTEGER NOT NULL DEFAULT 0,
        last_error  TEXT,
        status      TEXT NOT NULL DEFAULT 'active',
        created_at  INTEGER NOT NULL DEFAULT (unixepoch() * 1000),
        updated_at  INTEGER NOT NULL DEFAULT (unixepoch() * 1000)
      );
      CREATE TABLE IF NOT EXISTS workflow_runs (
        run_id      TEXT PRIMARY KEY,
        workflow_id TEXT NOT NULL REFERENCES workflows(id),
        trigger     TEXT NOT NULL,
        status      TEXT NOT NULL DEFAULT 'running',
        started_at  INTEGER NOT NULL DEFAULT (unixepoch() * 1000),
        finished_at INTEGER,
        error_msg   TEXT
      );
    `);
  }

  async fetch(request: Request): Promise&lt;Response&gt; {
    if (!this.spaceId) this.spaceId = await this.ctx.storage.get('spaceId') ?? '';
    await this.initSchema();
    const url = new URL(request.url);

    switch (url.pathname) {
      case '/register':       return this.register(request);
      case '/list':           return this.list(request);
      case '/get':            return this.get(request);
      case '/update':         return this.update(request);
      case '/pause':          return this.pause(request);
      case '/resume':         return this.resume(request);
      case '/archive':        return this.archive(request);
      case '/trigger-manual': return this.triggerManual(request);
      case '/run-complete':   return this.runComplete(request);
      case '/sweep':          return this.sweepSchedules();
      default:                return new Response('Not Found', { status: 404 });
    }
  }

  private async register(req: Request): Promise&lt;Response&gt; {
    const { id, name, description, r2Path, schedule } = await req.json();
    if (!id || !name || !r2Path) return Response.json({ error: 'id, name, r2Path required' }, { status: 400 });

    const nextRun = schedule ? parseCronToNextTimestamp(schedule) : 0;
    this.ctx.storage.sql.exec(
      `INSERT INTO workflows (id, name, description, r2_path, schedule, next_run, updated_at)
       VALUES (?,?,?,?,?,?,?)
       ON CONFLICT(id) DO UPDATE
         SET name=excluded.name, description=excluded.description,
             r2_path=excluded.r2_path, schedule=excluded.schedule,
             next_run=excluded.next_run, updated_at=excluded.updated_at,
             status=CASE WHEN status='archived' THEN 'active' ELSE status END`,
      id, name, description ?? null, r2Path, schedule ?? null, nextRun, Date.now()
    );
    return Response.json({ id, name, schedule, nextRun });
  }

  private async list(req: Request): Promise&lt;Response&gt; {
    const status = new URL(req.url).searchParams.get('status');
    const rows = status
      ? this.ctx.storage.sql.exec('SELECT * FROM workflows WHERE status=? ORDER BY name', status).toArray()
      : this.ctx.storage.sql.exec('SELECT * FROM workflows ORDER BY name').toArray();
    return Response.json({ workflows: rows, count: rows.length });
  }

  private async get(req: Request): Promise&lt;Response&gt; {
    const { id } = await req.json();
    const wf = this.ctx.storage.sql.exec('SELECT * FROM workflows WHERE id=?', id).toArray();
    if (!wf.length) return Response.json({ error: 'Not found' }, { status: 404 });
    const runs = this.ctx.storage.sql.exec(
      'SELECT * FROM workflow_runs WHERE workflow_id=? ORDER BY started_at DESC LIMIT 20', id
    ).toArray();
    return Response.json({ workflow: wf[0], recentRuns: runs });
  }

  private async update(req: Request): Promise&lt;Response&gt; {
    const { id, schedule, name, description, r2Path } = await req.json();
    const nextRun = schedule !== undefined ? parseCronToNextTimestamp(schedule) : undefined;
    this.ctx.storage.sql.exec(
      `UPDATE workflows SET
         name=COALESCE(?,name), description=COALESCE(?,description), r2_path=COALESCE(?,r2_path),
         schedule=CASE WHEN ? IS NOT NULL THEN ? ELSE schedule END,
         next_run=COALESCE(?,next_run), updated_at=?
       WHERE id=?`,
      name??null, description??null, r2Path??null,
      schedule??null, schedule??null, nextRun??null, Date.now(), id
    );
    return Response.json({ success: true });
  }

  private async pause(req: Request): Promise&lt;Response&gt; {
    const { id } = await req.json();
    this.ctx.storage.sql.exec(
      `UPDATE workflows SET status='paused', updated_at=? WHERE id=? AND status='active'`, Date.now(), id
    );
    return Response.json({ success: true, status: 'paused' });
  }

  private async resume(req: Request): Promise&lt;Response&gt; {
    const { id } = await req.json();
    const wf = this.ctx.storage.sql.exec('SELECT schedule FROM workflows WHERE id=?', id).toArray();
    if (!wf.length) return Response.json({ error: 'Not found' }, { status: 404 });
    const nextRun = wf[0].schedule ? parseCronToNextTimestamp(wf[0].schedule as string) : 0;
    this.ctx.storage.sql.exec(
      `UPDATE workflows SET status='active', next_run=?, updated_at=? WHERE id=?`, nextRun, Date.now(), id
    );
    return Response.json({ success: true, status: 'active', nextRun });
  }

  private async archive(req: Request): Promise&lt;Response&gt; {
    const { id } = await req.json();
    this.ctx.storage.sql.exec(
      `UPDATE workflows SET status='archived', next_run=0, updated_at=? WHERE id=?`, Date.now(), id
    );
    return Response.json({ success: true, status: 'archived' });
  }

  private async triggerManual(req: Request): Promise&lt;Response&gt; {
    const { id, triggeredBy = 'manual' } = await req.json();
    const wf = this.ctx.storage.sql.exec(
      `SELECT * FROM workflows WHERE id=? AND status!='archived'`, id
    ).toArray();
    if (!wf.length) return Response.json({ error: 'Workflow not found or archived' }, { status: 404 });

    const runId = crypto.randomUUID();
    this.ctx.storage.sql.exec(
      `INSERT INTO workflow_runs (run_id, workflow_id, trigger, status, started_at) VALUES (?,?,?,?,?)`,
      runId, id, triggeredBy, 'running', Date.now()
    );
    await this.env.NAELAO_WORKFLOW.create({
      id: `manual-${id}-${Date.now()}`,
      params: { spaceId: this.spaceId, workflowPath: wf[0].r2_path, runId, trigger: triggeredBy }
    });
    this.ctx.storage.sql.exec(
      `UPDATE workflows SET run_count=run_count+1, updated_at=? WHERE id=?`, Date.now(), id
    );
    return Response.json({ success: true, runId });
  }

  private async runComplete(req: Request): Promise&lt;Response&gt; {
    const { runId, workflowId, success, errorMsg } = await req.json();
    this.ctx.storage.sql.exec(
      `UPDATE workflow_runs SET status=?, finished_at=?, error_msg=? WHERE run_id=?`,
      success ? 'success' : 'failed', Date.now(), errorMsg ?? null, runId
    );
    if (!success) {
      this.ctx.storage.sql.exec(
        `UPDATE workflows SET error_count=error_count+1, last_error=?, updated_at=? WHERE id=?`,
        errorMsg, Date.now(), workflowId
      );
      const wf = this.ctx.storage.sql.exec(`SELECT error_count FROM workflows WHERE id=?`, workflowId).toArray()[0];
      if ((wf?.error_count as number) &gt;= 3) {
        this.ctx.storage.sql.exec(`UPDATE workflows SET status='paused' WHERE id=?`, workflowId);
        <span class="cm">// Auto-pause after 3 consecutive failures — admin must resume</span>
      }
    }
    return Response.json({ success: true });
  }

  private async sweepSchedules(): Promise&lt;Response&gt; {
    const now = Date.now();
    const due = this.ctx.storage.sql.exec(
      `SELECT * FROM workflows WHERE status='active' AND schedule IS NOT NULL AND next_run&lt;=? AND next_run&gt;0`, now
    ).toArray();

    const dispatched: string[] = [];
    for (const wf of due) {
      const runId = crypto.randomUUID();
      this.ctx.storage.sql.exec(
        `INSERT INTO workflow_runs (run_id, workflow_id, trigger, status, started_at) VALUES (?,?,?,?,?)`,
        runId, wf.id, 'cron', 'running', now
      );
      await this.env.NAELAO_WORKFLOW.create({
        id: `cron-${wf.id as string}-${now}`,
        params: { spaceId: this.spaceId, workflowPath: wf.r2_path, runId, trigger: 'cron' }
      });
      const nextRun = parseCronToNextTimestamp(wf.schedule as string);
      this.ctx.storage.sql.exec(
        `UPDATE workflows SET last_run=?, next_run=?, run_count=run_count+1, updated_at=? WHERE id=?`,
        now, nextRun, now, wf.id
      );
      dispatched.push(wf.id as string);
    }
    return Response.json({ dispatched, count: dispatched.length });
  }
}

function parseCronToNextTimestamp(cron: string): number {
  const [min, hour, , month, dow] = cron.split(' ');
  const next = new Date(Date.now() + 60_000); <span class="cm">// advance 1 min to avoid same-minute re-trigger</span>
  for (let i = 0; i &lt; 10080; i++) { <span class="cm">// search up to 7 days</span>
    if ((min   === '*' || parseInt(min)   === next.getUTCMinutes())
     &amp;&amp; (hour  === '*' || parseInt(hour)  === next.getUTCHours())
     &amp;&amp; (dow   === '*' || parseInt(dow)   === next.getUTCDay())
     &amp;&amp; (month === '*' || parseInt(month) === next.getUTCMonth() + 1)) {
      return next.getTime();
    }
    next.setMinutes(next.getMinutes() + 1);
  }
  return Date.now() + 86_400_000; <span class="cm">// fallback: 24 hr</span>
}</code></pre>

