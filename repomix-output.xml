    <!-- ══════════════════════════════════════════════════════
     §63 — EXTERNAL PORTAL SYSTEM
═══════════════════════════════════════════════════════ -->
    <div class="sep"></div>
    <div class="sec" id="external-portal">
      <span class="sec-ey">63 — External Portal System</span>
      <h2>External Portals — {slug}.naelao.com & Custom Domains</h2>
      <div class="bar"></div>
      <p class="lead">Some space types have a public-facing component separate from the operator console. A Launchpad
        space has a customer storefront. A Sites space IS a website. A Verticals space has a client portal. A Workers
        space has a talent marketplace. These external portals are provisioned automatically when the space is created,
        have zero Naelao chrome, and support custom domains.</p>

      <h3>Portal Deployment Architecture</h3>
      <div class="arch">
        <div class="arch-t">Two Portal Deployment Models</div>
        <div class="ar">
          <div class="ab ab-c">Model A: Dynamic Worker Portal</div>
          <div class="aa">→ content in R2 →</div>
          <div class="ab ab-d">Dynamic Worker Loader serves HTML</div>
          <div class="aa">→</div>
          <div class="ab ab-a">{slug}.naelao.com</div>
        </div>
        <div class="ar">
          <div class="ab ab-e">Model B: CF Pages Portal</div>
          <div class="aa">→ static build in R2 →</div>
          <div class="ab ab-c">CF Pages project</div>
          <div class="aa">→</div>
          <div class="ab ab-a">{slug}.naelao.com</div>
        </div>
        <div class="arch-lbl">Both models support custom domains via CF Custom Domains API. Dynamic Worker = instant
          updates. CF Pages = better for complex SPAs.</div>
      </div>

      <pre><code><span class="cm">// workers/spaces/portal-provisioner.ts</span>

export async function provisionExternalPortal(
  spaceId: string,
  manifest: NaelaoSpaceTypeManifestV2,
  env: Env
): Promise&lt;{ portalUrl: string; customDomainEnabled: boolean }&gt; {

  const portalConfig = manifest.ui.externalPortal!;
  const slug = await generateUniqueSlug(portalConfig.defaultSlug, spaceId, env);

  if (portalConfig.deploymentType === 'dynamic-worker') {
    <span class="cm">// Copy the portal template to this space's R2 prefix</span>
    const templateObj = await env.NAELAO_ASSETS.get(
      `portal-templates/${portalConfig.templateId}/index.ts`
    );
    if (!templateObj) throw new Error(`Portal template not found: ${portalConfig.templateId}`);

    const templateCode = await templateObj.text();

    <span class="cm">// Inject space context into the template</span>
    const portalCode = templateCode
      .replace('{{SPACE_ID}}', spaceId)
      .replace('{{PORTAL_SLUG}}', slug)
      .replace('{{AUTH_MODEL}}', portalConfig.authModel)
      .replace('{{NAELAO_API_BASE}}', env.NAELAO_API_BASE);

    <span class="cm">// Store the portal code in R2 under the space prefix</span>
    await env.NAELAO_WORKSPACE.put(
      `spaces/${spaceId}/portal/index.ts`,
      portalCode
    );

    <span class="cm">// Register the slug → spaceId mapping in KV
    // The naelao-portal Worker reads this to route requests</span>
    await env.NAELAO_CONFIG_KV.put(`portal-slug:${slug}`, spaceId);
    await env.NAELAO_CONFIG_KV.put(`portal-space:${spaceId}`, slug);

    const portalUrl = `https://${slug}.naelao.com`;

    <span class="cm">// Store portal config in SpaceDO</span>
    const spaceDO = env.NAELAO_SPACE_DO.get(
      env.NAELAO_SPACE_DO.idFromName(`space:${spaceId}`)
    );
    await spaceDO.fetch(new Request('http://space/set-portal', {
      method: 'POST',
      body: JSON.stringify({ portalUrl, slug, deploymentType: 'dynamic-worker', authModel: portalConfig.authModel })
    }));

    return { portalUrl, customDomainEnabled: portalConfig.customDomain };

  } else {
    <span class="cm">// CF Pages deployment — for complex SPA portals
    // Create a new CF Pages project via API</span>
    const pagesProject = await fetch(
      `https://api.cloudflare.com/client/v4/accounts/${env.NAELAO_ACCOUNT_ID}/pages/projects`,
      {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${env.CF_API_TOKEN}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          name: `naelao-portal-${slug}`,
          production_branch: 'main',
          source: {
            type: 'github', <span class="cm">// or upload-based</span>
          }
        })
      }
    ).then(r => r.json());

    const portalUrl = `https://${slug}.naelao.com`;
    return { portalUrl, customDomainEnabled: portalConfig.customDomain };
  }
}

<span class="cm">// naelao-portal Worker — handles all {*.naelao.com} requests
// Routes to the correct space's portal code</span>
export const PORTAL_WORKER = {
  async fetch(request: Request, env: Env): Promise&lt;Response&gt; {
    const host = request.headers.get('Host') ?? '';

    <span class="cm">// Extract slug from host: {slug}.naelao.com</span>
    const slugMatch = host.match(/^([a-z0-9-]+)\.naelao\.com$/);
    if (!slugMatch) return new Response('Not Found', { status: 404 });

    const slug = slugMatch[1];

    <span class="cm">// Look up spaceId from slug</span>
    const spaceId = await env.NAELAO_CONFIG_KV.get(`portal-slug:${slug}`);
    if (!spaceId) return new Response('Portal not found', { status: 404 });

    <span class="cm">// Load portal code from R2</span>
    const portalObj = await env.NAELAO_WORKSPACE.get(`spaces/${spaceId}/portal/index.ts`);
    if (!portalObj) return new Response('Portal not configured', { status: 503 });

    const portalCode = await portalObj.text();

    <span class="cm">// Execute via Dynamic Worker Loader
    // The portal code is a CF Worker that handles the request</span>
    const loaderDO = env.NAELAO_DW_LOADER.get(
      env.NAELAO_DW_LOADER.idFromName(`portal:${spaceId}`)
    );

    return loaderDO.fetch(new Request('http://loader/execute', {
      method: 'POST',
      body: JSON.stringify({
        code: portalCode,
        request: {
          url: request.url,
          method: request.method,
          headers: Object.fromEntries(request.headers.entries()),
          body: await request.text()
        }
      })
    }));
  }
};</code></pre>

      <h3>Custom Domain Configuration</h3>
      <pre><code><span class="cm">// Operator flow: Space Settings → Portal → Custom Domain → enter domain
// POST /api/spaces/{spaceId}/portal/custom-domain</span>

export async function configureCustomDomain(params: {
  spaceId: string;
  domain:  string;  <span class="cm">// e.g., 'mystore.com'</span>
  env:     Env;
}): Promise&lt;{ success: boolean; verificationRecord?: string }&gt; {

  const { spaceId, domain, env } = params;

  <span class="cm">// 1. Add the domain to CF Custom Domains via API</span>
  const customDomainResp = await fetch(
    `https://api.cloudflare.com/client/v4/accounts/${env.NAELAO_ACCOUNT_ID}/workers/domains`,
    {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${env.CF_API_TOKEN}`, 'Content-Type': 'application/json' },
      body: JSON.stringify({
        environment: 'production',
        hostname: domain,
        service: 'naelao-portal',  <span class="cm">// the portal Worker</span>
        zone_id: env.CF_ZONE_ID
      })
    }
  ).then(r => r.json());

  if (!customDomainResp.success) {
    return { success: false };
  }

  <span class="cm">// 2. Store the custom domain → spaceId mapping in KV</span>
  await env.NAELAO_CONFIG_KV.put(`portal-custom-domain:${domain}`, spaceId);

  <span class="cm">// 3. Update naelao-portal Worker to also check custom domains</span>
  <span class="cm">// The portal Worker checks both slug.naelao.com AND custom domain mappings</span>

  return {
    success: true,
    verificationRecord: `_naelao-verify.${domain} TXT naelao-${spaceId.slice(0, 8)}`
  };
}</code></pre>
