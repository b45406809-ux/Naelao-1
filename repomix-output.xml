ync () \u003d\u003e {\n    const res \u003d await ctx.cli.exec(\"repomix --compress --style xml --output repomix-map.xml\");\n    return await ctx.fs.read(\"repomix-map.xml\");\n  });\n\n  // Step 2: Ask Fast Model to Pick Files (Workers AI / Gemini Flash)\n  const selectedFiles \u003d await ctx.step.do(\"pick-relevant-files\", async () \u003d\u003e {\n    return await ctx.ai.generateObject({\n      schema: { type: \"array\", items: { type: \"string\" } },\n      prompt: `Given this compressed repo map, select only files needed for: ${payload.chunkSpec}\\n\\nMAP:\\n${mapXml}`\n    });\n  });\n\n  // Step 3: Targeted Repomix Packing\n  const targetedCode \u003d await ctx.step.do(\"target-pack\", async () \u003d\u003e {\n    await ctx.cli.exec(`repomix --include \"${selectedFiles.join(\u0027,\u0027)}\" --style xml --output repomix-target.xml`);\n    return await ctx.fs.read(\"repomix-target.xml\");\n  });\n\n  // Step 4: Implement the Code\n  const implementation \u003d await ctx.step.do(\"generate-code\", async () \u003d\u003e {\n    return await ctx.ai.generateObject({\n      schema: {\n        commitMessage: { type: \"string\" },\n        files: { type: \"array\", items: { path: \"string\", content: \"string\" } }\n      },\n      prompt: `Implement this spec: ${payload.chunkSpec}\\n\\nTARGET CODE:\\n${targetedCode}`\n    });\n  });\n\n  // Step 5: Write Files and Commit\n  await ctx.step.do(\"apply-and-commit\", async () \u003d\u003e {\n    for (const f of implementation.files) {\n      await ctx.fs.write(f.path, f.content);\n    }\n    await ctx.cli.exec(`git add . \u0026\u0026 git commit -m \"${implementation.commitMessage}\"`);\n  });\n\n  return {\n    success: true,\n    chunk: payload.chunkName,\n    commit: implementation.commitMessage\n  };\n}\n```\n\n### How the Parent Launches It and Keeps the UI Clean:\nIn the user\u0027s thread, the Parent Agent simply runs:\n```typescript\nawait ctx.workflows.start(\"repomix-chunker\", {\n  chunkSpec: \"Implement Phas