        <pre style="background:var(--bg3);border:1px solid var(--brd);border-radius:8px;padding:16px;overflow-x:auto;margin-top:12px;"><code style="font-family:'DM Mono',monospace;font-size:11.5px;color:var(--cy);line-height:1.6;">// On workflow success
db.exec(`UPDATE workflows
         SET consecutive_error_count = 0,
             last_success_at = datetime(&#x27;now&#x27;)
         WHERE id = ?`, [workflowId]);

// On workflow failure
db.exec(`UPDATE workflows
         SET consecutive_error_count = consecutive_error_count + 1,
             total_error_count = total_error_count + 1,
             last_error = ?,
             status = CASE WHEN consecutive_error_count + 1 &gt;= 3
                          THEN &#x27;paused&#x27; ELSE status END
         WHERE id = ?`, [errorMsg, workflowId]);</code></pre>
