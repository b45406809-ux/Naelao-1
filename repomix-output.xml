      <!-- ══════════════════════════════════════════════════════
A5 — Space Provisioner / Deprovisioner
═══════════════════════════════════════════════════════ -->
      <div class="sep"></div>
      <div class="sec" id="provisioner">
        <span class="sec-ey">A5 — Lifecycle Hooks</span>
        <h2>Provisioning &amp; Deprovisioning — Transactional Assembly</h2>
        <div class="bar"></div>
        <p class="lead">Naelao treats a Space as an atomic unit of infrastructure. The <strong>Provisioner</strong> is a
          durable state machine that assembles all platform hardware — Durable Objects, SpaceDO SQLite records, R2 prefixes, KV
          entries — required by a specific Space Type in the correct order, with full rollback if any step fails.
          Deprovisioning is not just a deletion: it is a sanitised scrub that guarantees no data leakage, no orphaned
          billing, and no zombie DOs.</p>

        <h3>The Provisioning Chain</h3>
        <p>Every Space creation runs through six ordered phases. Each phase appends a compensating action to a
          <strong>Compensation Log</strong> before proceeding. If any phase throws, the log is replayed in reverse order
          to undo all completed work:</p>

        <div class="flow">
          <div class="fstep">
            <div class="fn">1</div>
            <div class="ft"><strong>Manifest fetch &amp; validation:</strong> <code>naelao-spaces</code> calls
              <code>SpaceTypeRegistryDO</code> to retrieve the signed manifest for the requested Space Type. The
              manifest's Ed25519 signature is verified against the platform public key. An invalid or missing manifest
              is a hard failure — no compensation needed at this point.</div>
          </div>
          <div class="fstep">
            <div class="fn">2</div>
            <div class="ft"><strong>Slug reservation:</strong> A unique slug is chosen (user-provided or
              auto-generated). The slug is written to a KV lock key (<code>slug-lock:{slug}</code>) with a 30s TTL. If
              the KV write fails, the slug is already taken. Compensation: delete the KV lock.</div>
          </div>
          <div class="fstep">
            <div class="fn">3</div>
            <div class="ft"><strong>SpaceDO record:</strong> The <code>spaces</code> row is inserted into SpaceDO SQLite. The
              provisioner then runs any Space-Type-specific SQL migrations from
              <code>manifest.backend.sqlMigrations</code>, with <code>{SPACE_ID}</code> tokens replaced in every
              statement so that Row Level Security predicates are baked in from the first microsecond. Compensation:
              <code>DELETE FROM spaces WHERE id = ?</code>.</div>
          </div>
          <div class="fstep">
            <div class="fn">4</div>
            <div class="ft"><strong>DO assembly (Platform Hardware):</strong> For each binding listed in
              <code>manifest.backend.platformDOs</code>, the provisioner calls
              <code>env[binding].get(idFromName(spaceId))</code> and POSTs an <code>/init</code> message to the DO. DOs
              are addressed by name so they are deterministically retrievable later. Compensation: POST
              <code>/destroy</code> to each initialised DO.</div>
          </div>
          <div class="fstep">
            <div class="fn">5</div>
            <div class="ft"><strong>R2 seeding:</strong> Creates the R2 prefix roots declared in
              <code>manifest.backend.r2Prefixes</code>. For types that include starter content (Launchpad, Sites,
              Verticals), this step copies template assets from a shared platform R2 bucket. Compensation:
              <code>r2.list + r2.delete</code> for all seeded objects.</div>
          </div>
          <div class="fstep">
            <div class="fn">6</div>
            <div class="ft"><strong>Portal provisioning (if enabled):</strong> Calls
              <code>provisionExternalPortal()</code> (see A6) to register the slug in the KV route table and issue the
              initial portal Scoped Token. Compensation: delete all three KV portal entries.</div>
          </div>
        </div>

        <h3>Compensation Log Implementation</h3>
        <pre><code><span class="cm">// workers/naelao-provisioner/src/provision.ts</span>

export async function provisionSpace(
  spaceId:  string,
  slug:     string,
  manifest: ManifestV2,
  env:      Env
): Promise&lt;ProvisionResult&gt; {

  const compLog: Array&lt;() =&gt; Promise&lt;void&gt;&gt; = [];

  try {
    <span class="cm">// ── Phase 2: slug reservation ────────────────────────────</span>
    await env.PORTAL_ROUTES.put(`slug-lock:${slug}`, spaceId, { expirationTtl: 30 });
    compLog.push(() =&gt; env.PORTAL_ROUTES.delete(`slug-lock:${slug}`));

    <span class="cm">// ── Phase 3: DB row + migrations ─────────────────────────</span>
    await spaceDO.createSpaceRecord({
      id: spaceId, slug, type_id: manifest.id,
      created_at: new Date().toISOString(),
    });
    compLog.push(() =&gt; spaceDO.deleteSpaceRecord(spaceId));

    for (const migration of manifest.backend.sqlMigrations ?? []) {
      const sql = migration.sql.replaceAll('{SPACE_ID}', spaceId);
      await spaceDO.runMigration(sql);  // SpaceDO migration method
      <span class="cm">// Migrations are irreversible — log their inverse if provided</span>
      if (migration.rollbackSql) {
        const rollback = migration.rollbackSql.replaceAll('{SPACE_ID}', spaceId);
        compLog.push(() =&gt; spaceDO.runMigration(rollback));
      }
    }

    <span class="cm">// ── Phase 4: DO assembly ─────────────────────────────────</span>
    const initialisedDOs: string[] = [];
    for (const doConf of manifest.backend.platformDOs) {
      const binding = env[doConf.binding] as DurableObjectNamespace;
      const stub = binding.get(binding.idFromName(spaceId));
      await stub.fetch(new Request('http://internal/init', {
        method: 'POST',
        body: JSON.stringify({ spaceId, typeId: manifest.id, config: doConf.config }),
      }));
      initialisedDOs.push(doConf.binding);
      <span class="cm">// Capture binding name for closure — JS let scoping</span>
      const capturedBinding = doConf.binding;
      compLog.push(async () =&gt; {
        const b = env[capturedBinding] as DurableObjectNamespace;
        const s = b.get(b.idFromName(spaceId));
        await s.fetch(new Request('http://internal/destroy', { method: 'POST' }));
      });
    }

    <span class="cm">// ── Phase 5: R2 seeding ──────────────────────────────────</span>
    const seededKeys: string[] = [];
    for (const prefix of manifest.backend.r2Prefixes) {
      const rootKey = `${prefix}/${spaceId}/.naelao`;
      await env.R2.put(rootKey, JSON.stringify({ spaceId, typeId: manifest.id, createdAt: Date.now() }));
      seededKeys.push(rootKey);
    }
    if (manifest.backend.starterContent) {
      const copied = await copyStarterContent(spaceId, manifest.backend.starterContent, env);
      seededKeys.push(...copied);
    }
    compLog.push(async () =&gt; {
      await Promise.all(seededKeys.map(k =&gt; env.R2.delete(k)));
    });

    <span class="cm">// ── Phase 6: portal ──────────────────────────────────────</span>
    let portalUrl: string | undefined;
    if (manifest.ui.externalPortal?.enabled) {
      portalUrl = await provisionExternalPortal(spaceId, slug, env);
      compLog.push(() =&gt; deprovisionPortal(spaceId, slug, env));
    }

    return { spaceId, slug, portalUrl, initialisedDOs };

  } catch (err) {
    <span class="cm">// FAILURE: replay compensation log in reverse</span>
    for (const rollback of [...compLog].reverse()) {
      await rollback().catch(e =&gt;
        console.error('Compensation step failed:', e)
      );
    }
    throw err;  <span class="cm">// Re-throw so the caller surfaces the error to the user</span>
  }
}</code></pre>

        <h3>Deprovisioning — The Full Scrub</h3>
        <p>Deleting a database row is not deprovisioning. A Space owns R2 objects, KV entries, active DOs, SpaceDO SQLite records
          across multiple tables, and potentially an external portal registration. Every byte must be accounted for or
          it becomes storage bloat that Naelao pays for indefinitely. Deprovisioning uses a <strong>CF Workflow</strong>
          so it survives timeouts on large Spaces:</p>

        <pre><code><span class="cm">// workers/naelao-provisioner/src/deprovision.ts</span>
<span class="cm">// Runs as a CF Workflow step-function — each step is durable and retried on failure</span>

export class DeprovisionWorkflow extends WorkflowEntrypoint&lt;Env, { spaceId: string }&gt; {
  async run(event: WorkflowEvent&lt;{ spaceId: string }&gt;, step: WorkflowStep) {
    const { spaceId } = event.payload;

    <span class="cm">// Step A: Disable portal immediately (stop serving traffic)</span>
    await step.do('disable-portal', async () =&gt; {
      const host = await this.env.PORTAL_ROUTES.get(`portal:space:${spaceId}`);
      if (host) await this.env.PORTAL_ROUTES.put(
        `portal:host:${host}`,
        JSON.stringify({ spaceId, enabled: false, disabledMessage: 'This Space has been deleted.' })
      );
    });

    <span class="cm">// Step B: Destroy all DOs for this Space</span>
    await step.do('destroy-dos', async () =&gt; {
      const doBindings = ['AGENT_DO', 'WALLET_DO', 'SPACE_DO', 'PROJECT_DO', 'CONCURRENCY_DO'];
      await Promise.all(doBindings.map(async binding =&gt; {
        try {
          const ns = this.env[binding] as DurableObjectNamespace;
          const stub = ns.get(ns.idFromName(spaceId));
          await stub.fetch(new Request('http://internal/destroy', { method: 'POST' }));
        } catch { /* DO may not exist for this Space Type — ignore */ }
      }));
    });

    <span class="cm">// Step C: Delete all R2 objects (paginated — may be thousands of files)</span>
    await step.do('delete-r2', async () =&gt; {
      let cursor: string | undefined;
      do {
        const list = await this.env.R2.list({ prefix: `workspace/${spaceId}/`, cursor, limit: 1000 });
        if (list.objects.length) {
          await this.env.R2.delete(list.objects.map(o =&gt; o.key));
        }
        cursor = list.truncated ? list.cursor : undefined;
      } while (cursor);

      <span class="cm">// Also scrub portal artifacts</span>
      const portalList = await this.env.R2.list({ prefix: `portals/${spaceId}/` });
      if (portalList.objects.length) {
        await this.env.R2.delete(portalList.objects.map(o =&gt; o.key));
      }
    });

    <span class="cm">// Step D: Call spaceDO.purge() — cascades through all tables in SpaceDO SQLite</span>
    await step.do('delete-db', async () =&gt; {
      await spaceDO.purge();  // SpaceDO.purge() deletes all records for this space + sub-spaces
      <span class="cm">// CASCADE handles: projects, threads, messages, agents, knowledge_docs</span>
    });

    <span class="cm">// Step E: Clean up KV entries</span>
    await step.do('delete-kv', async () =&gt; {
      const host = await this.env.PORTAL_ROUTES.get(`portal:space:${spaceId}`);
      const slug = host?.split('.')[0];
      await Promise.all([
        host   ? this.env.PORTAL_ROUTES.delete(`portal:host:${host}`) : Promise.resolve(),
        slug   ? this.env.PORTAL_ROUTES.delete(`portal:slug:${slug}`) : Promise.resolve(),
        this.env.PORTAL_ROUTES.delete(`portal:space:${spaceId}`),
      ]);
    });
  }
}
</code></pre>

        <h3>Lifecycle Hook Registry</h3>
        <p>Space Type manifests can declare hooks that fire at specific lifecycle events. Hooks are called synchronously
          within the provisioner step — if a hook fails, the step fails and compensation runs:</p>

        <table class="t">
          <thead>
            <tr>
              <th>Hook</th>
              <th>When It Fires</th>
              <th>Typical Use</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="tl"><code>onProvision</code></td>
              <td>After all platform hardware is assembled, before returning to the user</td>
              <td>Send welcome email, seed default agent config, create first project</td>
            </tr>
            <tr>
              <td class="tl"><code>onFirstAgentRun</code></td>
              <td>Before the first agent turn in a newly provisioned Space</td>
              <td>Run an onboarding workflow, inject Space-Type-specific context into the first system prompt</td>
            </tr>
            <tr>
              <td class="tl"><code>onDeprovision</code></td>
              <td>After portal is disabled, before DOs and R2 are destroyed</td>
              <td>Export user data to a download link, notify integrations of Space deletion</td>
            </tr>
            <tr>
              <td class="tl"><code>onUpgrade</code></td>
              <td>When a Space changes Space Type (e.g. Standard → Launchpad)</td>
              <td>Provision additional DOs required by the new type, run incremental SQL migrations</td>
            </tr>
          </tbody>
        </table>

        <div class="box box-am">
          <div class="box-lbl">The Most Common Junior Dev Mistake</div>
          <p>Forgetting to paginate R2 deletion. <code>r2.list()</code> returns at most 1,000 objects per call. A Space
            with 10,000 files requires 10 list calls. The Workflow step pattern handles this correctly — each
            list+delete iteration is checkpointed. If the Worker times out mid-deletion, the Workflow resumes from the
            last successful checkpoint rather than starting over or leaving orphan objects.</p>
        </div>
      </div>
