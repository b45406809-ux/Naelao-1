await env.NAELAO_BILLING_QUEUE.send({
  type: "run_complete",
  spaceId,
  subSpaceId,
  costMicroCents: calculateCostMicroCents(inputTokens, outputTokens),
  timestamp: Date.now(),
});

// Billing queue consumer: credit parent WalletDO immediately
async queue(batch: MessageBatch) {
  for (const msg of batch.messages) {
    const { spaceId, costMicroCents } = msg.body;
    await walletDO.deductMicroCents(spaceId, costMicroCents);
    msg.ack();
