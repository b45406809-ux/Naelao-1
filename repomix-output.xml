═══════════════════════════════════════════════════════ -->
    <div class="sep"></div>
    <div class="sec" id="naelao-admin">
      <span class="sec-ey">78 — Worker Deep Dive: naelao-admin</span>
      <h2>naelao-admin — Audit Logs, DLQ & Platform Ops</h2>
      <div class="bar"></div>
      <p class="lead">The <code>naelao-admin</code> Worker provides the internal APIs for Naelao's platform operations
        team. It handles compliance audit querying, Dead Letter Queue (DLQ) inspection, and emergency state recovery.
        Because this Worker exposes highly privileged operations, it is strictly protected by Cloudflare Zero Trust (CF
        Access).</p>

      <div class="box box-rd">
        <div class="box-lbl">Security Boundary: CF Access</div>
        <p>Admin endpoints cannot rely solely on product JWTs, as a compromised user database could lead to
          platform-wide compromise. Every request to <code>naelao-admin</code> must carry a valid
          <code>Cf-Access-Jwt-Assertion</code> header signed by the Cloudflare Access team domain. If the token is
          missing or the cryptographic signature is invalid, the request drops at the edge.</p>
      </div>

      <h3>Complete Implementation</h3>
      <pre><code><span class="cm">// workers/admin/index.ts
// Handles platform operations, DLQ management, and Analytics Engine queries.</span>

import { Hono } from 'hono';

const app = new Hono&lt;{ Bindings: Env }&gt;();

<span class="cm">// 1. CF Access Zero Trust Middleware (Mandatory)</span>
app.use('*', async (c, next) =&gt; {
  const jwt = c.req.header('Cf-Access-Jwt-Assertion');
  if (!jwt) return c.text('Forbidden: Missing CF Access JWT', 403);

  <span class="cm">// Validate the JWT signature using the public keys from CF Access
  // Developers MUST use the @cloudflare/kv-asset-handler or manual JWKS verification</span>
  const isValid = await verifyCloudflareAccessJWT(jwt, c.env.CF_ACCESS_TEAM_DOMAIN, c.env.CF_ACCESS_AUD);
  if (!isValid) return c.text('Forbidden: Invalid CF Access JWT', 403);

  await next();
});

<span class="cm">// 2. Audit Log Querying (Reads from CF Analytics Engine via SQL API)</span>
<span class="cm">// Allows support engineers to query immutable logs for a specific Space</span>
app.get('/audit/:spaceId', async (c) =&gt; {
  const spaceId = c.req.param('spaceId');
  const { eventType, limit = '100' } = c.req.query();

  <span class="cm">// We query the Analytics Engine GraphQL/SQL API
  // Naelao logs all actions (wallet spends, security events, etc.) here</span>
  const query = `
    SELECT timestamp, blob1 as event_type, blob2 as actor_id, blob3 as details, double1 as amount
    FROM naelao_analytics
    WHERE index1 = '${spaceId}'
    ${eventType ? `AND blob1 = '${eventType}'` : ''}
    ORDER BY timestamp DESC
    LIMIT ${parseInt(limit)}
  `;

  const response = await fetch(`https://api.cloudflare.com/client/v4/accounts/${c.env.NAELAO_ACCOUNT_ID}/analytics_engine/sql`, {
    method: 'POST',
    headers: { 'Authorization': `Bearer ${c.env.CF_API_TOKEN}` },
    body: query
  });

  return c.json(await response.json());
});

<span class="cm">// 3. DLQ (Dead Letter Queue) Management</span>
<span class="cm">// Inspect messages that failed 3+ times in the agent-runs queue</span>
app.get('/dlq/messages', async (c) =&gt; {
  const response = await fetch(
    `https://api.cloudflare.com/client/v4/accounts/${c.env.NAELAO_ACCOUNT_ID}/queues/naelao-dlq/messages`,
    { headers: { 'Authorization': `Bearer ${c.env.CF_API_TOKEN}` } }
  );
  return c.json(await response.json());
});

<span class="cm">// Retry a specific DLQ message (Support engineer intervention)</span>
app.post('/dlq/retry/:messageId', async (c) =&gt; {
  const messageId = c.req.param('messageId');
  const payload = await c.req.json(); <span class="cm">// The modified payload if the engineer fixed the bug</span>

  <span class="cm">// Send it back to the primary agent runs queue</span>
  await c.env.NAELAO_AGENT_QUEUE.send(payload);

  <span class="cm">// Acknowledge/delete it from the DLQ</span>
  await fetch(
    `https://api.cloudflare.com/client/v4/accounts/${c.env.NAELAO_ACCOUNT_ID}/queues/naelao-dlq/messages/${messageId}/ack`,
    { method: 'POST', headers: { 'Authorization': `Bearer ${c.env.CF_API_TOKEN}` } }
  );

  return c.json({ success: true, message: "Re-queued to primary queue" });
});

<span class="cm">// 4. Circuit Breaker Management</span>
<span class="cm">// If a 3rd party API (e.g., Stripe) goes down, Naelao trips a circuit breaker in KV.
// Admins can manually reset it once the provider resolves the incident.</span>
app.post('/system/circuit-breakers/reset', async (c) =&gt; {
  const { service } = await c.req.json();
  await c.env.NAELAO_CIRCUIT_KV.delete(`circuit:${service}`);
  return c.json({ success: true, service, state: 'CLOSED' });
});

export default app;</code></pre>
