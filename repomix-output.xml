import { Hono } from 'hono';
const app = new Hono&lt;{ Bindings: Env }&gt;();

const MODEL_MAP: Record&lt;string, string&gt; = {
  'llama-3.1-405b':  'meta-llama/Llama-3.1-405B-Instruct-Turbo',
  'llama-3.1-70b':   'meta-llama/Llama-3.1-70B-Instruct-Turbo',
  'llama-3.1-8b':    'meta-llama/Llama-3.1-8B-Instruct-Turbo',
  'mistral-7b':      'mistralai/Mistral-7B-Instruct-v0.3',
  'qwen-2.5-72b':    'Qwen/Qwen2.5-72B-Instruct-Turbo',
  'deepseek-r1':     'deepseek-ai/DeepSeek-R1',
  'deepseek-coder':  'deepseek-ai/deepseek-coder-33b-instruct',
};

async function getApiKey(spaceId: string, env: Env): Promise&lt;string&gt; {
  try {
    const resp = await env.NAELAO_CREDENTIALS.fetch(new Request('http://credentials/get', {
      method: 'POST', body: JSON.stringify({ spaceId, provider: 'together_ai' })
    }));
    if (resp.ok) return ((await resp.json()) as any).apiKey;
  } catch {}
  return env.TOGETHER_AI_API_KEY;
}

<span class="cm">// ── 1. CHAT COMPLETIONS PROXY ────────────────────────────────</span>
app.post('/v1/chat/completions', async (c) =&gt; {
  const spaceId = c.req.header('X-Naelao-Space-Id') ?? '';
  if (!spaceId) return c.json({ error: 'X-Naelao-Space-Id header required' }, 400);

  const body = await c.req.json();
  const apiKey = await getApiKey(spaceId, c.env);
  const translatedBody = { ...body, model: MODEL_MAP[body.model] ?? body.model };

  const upstream = await fetch('https://api.together.xyz/v1/chat/completions', {
    method: 'POST',
    headers: { 'Authorization': `Bearer ${apiKey}`, 'Content-Type': 'application/json' },
    body: JSON.stringify(translatedBody)
  });

  c.executionCtx.waitUntil(c.env.NAELAO_ANALYTICS_QUEUE.send({
    type: 'together_ai_completion', spaceId,
    model: body.model, translatedModel: translatedBody.model,
    status: upstream.status, timestamp: Date.now()
  }));

  return new Response(upstream.body, {
    status: upstream.status,
    headers: { 'Content-Type': upstream.headers.get('Content-Type') ?? 'application/json' }
  });
});

<span class="cm">// ── 2. LORA FINE-TUNE: START ─────────────────────────────────</span>
app.post('/finetune/start', async (c) =&gt; {
  const { spaceId, trainingDataR2Key, baseModel, jobName, hyperparams } = await c.req.json();
  const apiKey = await getApiKey(spaceId, c.env);
  const spaceDO = getProductDO(rootSpaceId, c.env);  // SpaceDO replaces Hyperdrive

  const trainingObj = await c.env.NAELAO_WORKSPACE.get(trainingDataR2Key);
  if (!trainingObj) return c.json({ error: 'Training data not found in R2' }, 404);

  const trainingData = await trainingObj.text();
  if (trainingData.split('\n').filter(Boolean).length &lt; 10) {
    return c.json({ error: 'Training data must have at least 10 JSONL examples' }, 400);
  }

  <span class="cm">// Upload to Together AI Files API</span>
  const form = new FormData();
  form.append('file', new Blob([trainingData], { type: 'text/plain' }), 'training.jsonl');
  form.append('purpose', 'fine-tune');
  const fileResp = await fetch('https://api.together.xyz/v1/files', {
    method: 'POST', headers: { 'Authorization': `Bearer ${apiKey}` }, body: form
  });
  if (!fileResp.ok) return c.json({ error: `File upload failed: ${await fileResp.text()}` }, 500);
  const { id: fileId } = await fileResp.json() as { id: string };

  <span class="cm">// Launch fine-tune job</span>
  const jobResp = await fetch('https://api.together.xyz/v1/fine-tunes', {
    method: 'POST',
    headers: { 'Authorization': `Bearer ${apiKey}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({
      training_file: fileId,
      model: MODEL_MAP[baseModel] ?? baseModel,
      n_epochs: hyperparams?.epochs ?? 3,
      learning_rate: hyperparams?.learningRate ?? 1e-5,
      batch_size: hyperparams?.batchSize ?? 32,
      suffix: jobName.replace(/[^a-z0-9]/gi, '-').toLowerCase()
    })
  });
  if (!jobResp.ok) return c.json({ error: 'Failed to start fine-tune job' }, 500);
  const { id: togetherJobId } = await jobResp.json() as { id: string };

  const internalJobId = crypto.randomUUID();
  await db.query(
    `INSERT INTO fine_tune_jobs (id, space_id, together_job_id, base_model, job_name, status, file_id, created_at)
     VALUES ($1,$2,$3,$4,$5,'running',$6,NOW())`,
    [internalJobId, spaceId, togetherJobId, baseModel, jobName, fileId]
  );

  <span class="cm">// Spin up FinetuneJobDO to poll Together AI via DO Alarms (no compute wasted)</span>
  await c.env.NAELAO_FINETUNE_JOB_DO.get(
    c.env.NAELAO_FINETUNE_JOB_DO.idFromName(`finetune:${internalJobId}`)
  ).fetch(new Request('http://do/init', {
    method: 'POST',
    body: JSON.stringify({ jobId: togetherJobId, internalJobId, spaceId, model: baseModel })
  }));

  return c.json({ jobId: internalJobId, togetherJobId, status: 'running' }, 202);
});

<span class="cm">// ── 3. FINE-TUNE STATUS ──────────────────────────────────────</span>
app.get('/finetune/:jobId/status', async (c) =&gt; {
  const { jobId } = c.req.param();
  const spaceDO = getProductDO(rootSpaceId, c.env);  // SpaceDO replaces Hyperdrive
  const { rows } = await db.query(`SELECT * FROM fine_tune_jobs WHERE id=$1`, [jobId]);
  if (!rows.length) return c.json({ error: 'Job not found' }, 404);

  if (rows[0].status === 'running') {
    const doStatus = await (await c.env.NAELAO_FINETUNE_JOB_DO.get(
      c.env.NAELAO_FINETUNE_JOB_DO.idFromName(`finetune:${jobId}`)
    ).fetch(new Request('http://do/status'))).json();
    return c.json({ ...rows[0], liveStatus: doStatus });
  }
  return c.json(rows[0]);
});

<span class="cm">// ── 4. REGISTER COMPLETED MODEL (called by FinetuneJobDO) ────</span>
app.post('/finetune/:jobId/register', async (c) =&gt; {
  const { jobId } = c.req.param();
  const { outputModelName, spaceId } = await c.req.json();
  const spaceDO = getProductDO(rootSpaceId, c.env);  // SpaceDO replaces Hyperdrive

  await db.query(
    `UPDATE fine_tune_jobs SET status='completed', result_model=$1, completed_at=NOW() WHERE id=$2`,
    [outputModelName, jobId]
  );
  await db.query(
    `INSERT INTO space_models (space_id, model_id, model_name, provider, is_finetuned, status)
     VALUES ($1,$2,$3,'together_ai',true,'available')
     ON CONFLICT (space_id, model_id) DO UPDATE SET status='available'`,
    [spaceId, outputModelName, `Fine-tuned: ${outputModelName}`]
  );
  await c.env.NAELAO_CONFIG_KV.put(
    `space-model:${spaceId}:${jobId}`,
    JSON.stringify({ modelId: outputModelName, provider: 'together_ai' })
  );
  await c.env.NAELAO_NOTIFICATIONS_QUEUE.send({
    id: `finetune-complete-${jobId}`, type: 'finetune_complete', spaceId, channels: ['email','push'],
    message: `Your fine-tuned model "${outputModelName}" is ready to use.`, priority: 'high'
  });
  return c.json({ success: true, outputModelName });
});

<span class="cm">// ── 5. AUTORESEARCH AGENT ─────────────────────────────────────
// Synthesizes a KB document from a research question using open-source models.
// Step 1: Llama-8B (cheap) generates search queries.
// Step 2: Brave Search fetches results.
// Step 3: Llama-70B (quality) synthesizes into a structured markdown doc.</span>
app.post('/autoresearch', async (c) =&gt; {
  const { spaceId, query, maxPages = 5 } = await c.req.json();
  const apiKey = await getApiKey(spaceId, c.env);

  const planResp = await fetch('https://api.together.xyz/v1/chat/completions', {
    method: 'POST',
    headers: { 'Authorization': `Bearer ${apiKey}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({
      model: MODEL_MAP['llama-3.1-8b'],
      max_tokens: 500,
      messages: [{ role: 'user', content: `Generate ${maxPages} search queries to comprehensively research: "${query}". Return as JSON array of strings only, no markdown.` }]
    })
  });
  const queries: string[] = JSON.parse(((await planResp.json()) as any).choices[0].message.content);

  const results = await Promise.all(queries.slice(0, maxPages).map(async (q: string) =&gt; {
    const resp = await fetch(`https://api.search.brave.com/res/v1/web/search?q=${encodeURIComponent(q)}&count=3`, {
      headers: { 'X-Subscription-Token': c.env.BRAVE_SEARCH_API_KEY }
    });
    return ((await resp.json()) as any).web?.results ?? [];
  }));

  const context = results.flat().map((r: any) =&gt; `**${r.title}**\n${r.description}\nSource: ${r.url}`).join('\n\n');

  const synthResp = await fetch('https://api.together.xyz/v1/chat/completions', {
    method: 'POST',
    headers: { 'Authorization': `Bearer ${apiKey}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({
      model: MODEL_MAP['llama-3.1-70b'],
      max_tokens: 2000,
      messages: [
        { role: 'system', content: 'You are a research synthesizer. Create a comprehensive, well-structured markdown document from search results. Include key facts, cite sources, use headers.' },
        { role: 'user', content: `Research topic: "${query}"\n\nSearch results:\n${context}` }
      ]
    })
  });
  const document = ((await synthResp.json()) as any).choices[0].message.content;

  const docKey = `spaces/${spaceId}/knowledge/autoresearch-${Date.now()}.md`;
  await c.env.NAELAO_WORKSPACE.put(docKey, document, {
    httpMetadata: { contentType: 'text/markdown' },
    customMetadata: { query, createdAt: new Date().toISOString(), source: 'autoresearch' }
  });

  return c.json({ success: true, r2Key: docKey, documentLength: document.length });
});

