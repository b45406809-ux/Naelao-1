<file path="workers/agents/src/script-engine/prebuilt/plan.ts">
/**
 * plan — the agent's own checklist for the CURRENT run (Claude Code's TodoWrite pattern),
 * distinct from `tasks` (the durable, per-project, cross-agent DAG in SpaceDO — see tasks.ts).
 *
 * Why a run-scoped plan matters, and why it has teeth: a research/multi-step agent that lays out a
 * plan and then stops after the first easy step is the single most common way autonomous work goes
 * half-done. So this is NOT a passive note-taking tool — once a plan is set, loop.ts REFUSES a
 * terminal `answer`/`give_up` while any step is still incomplete, telling the model to finish the
 * work and mark the step done (plan.complete_step) first. The only ways a run with an unfinished
 * plan ends are the ones the user explicitly allows: a real error, running out of budget/time, or
 * the user pressing Stop. See loop.ts's plan gate.
 *
 * State lives on `ctx.env.plan` — a single mutable object the loop owns (it creates one fresh per
 * run and reconstructs it from a resumed run's history). These ops read/write that same object, so
 * what the model sees here is exactly what the loop enforces. When there is no active run wiring it
 * (a bare test/caller), the ops degrade to a clear message rather than throwing.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import type { PlanState, PlanStep } from "../types.js";

/** Cap the plan so a runaway plan.set can't bloat the reasoner payload — a real plan is a handful
 *  of steps, not hundreds. */
const MAX_PLAN_STEPS = 40;

function slug(text: string, index: number): string {
  const base = text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 24);
  return `s${index + 1}${base ? "-" + base : ""}`;
}

/** Match a step by its id OR by an exact (case-insensitive, trimmed) text match — models refer to
 *  a step by whichever they have to hand, and forcing them to remember the generated id would just
 *  create a failure mode. */
function findStep(state: PlanState, ref: string): PlanStep | undefined {
  const needle = ref.trim().toLowerCase();
  return state.steps.find((s) => s.id === ref || s.text.trim().toLowerCase() === needle);
}

/**
 * Apply one plan operation to a plan state, in place, and return that same state.
 *
 * The SINGLE source of truth for what each plan op does — used both by the prebuilt ops below (the
 * live path) AND by loop.ts's reconstruction of a resumed run's plan (replaying the recorded
 * plan.* calls from resumeSteps). Keeping both on one function is what guarantees a reconstructed
 * plan is byte-identical to the one the original run held.
 */
export function applyPlanOp(state: PlanState, name: string, params: Record<string, unknown>): PlanState {
  switch (name) {
    case "plan.set": {
      const raw = Array.isArray(params["steps"]) ? (params["steps"] as unknown[]) : [];
      const texts = raw.map((s) => String(s).trim()).filter(Boolean).slice(0, MAX_PLAN_STEPS);
      state.steps = texts.map((text, i) => ({ id: slug(text, i), text, done: false }));
      return state;
    }
    case "plan.add_step": {
      if (state.steps.length >= MAX_PLAN_STEPS) return state;
      const text = String(params["step"] ?? "").trim();
      if (text) state.steps.push({ id: slug(text, state.steps.length), text, done: false });
      return state;
    }
    case "plan.complete_step": {
      const ref = String(params["step"] ?? "").trim();
      const target = ref ? findStep(state, ref) : undefined;
      if (target) target.done = true;
      return state;
    }
    case "plan.clear": {
      state.steps = [];
      return state;
    }
    default:
      return state;
  }
}

/** Human-readable snapshot of the plan, returned by every op so the model always sees the whole
 *  board (done/total + each step's status) after touching it. */
function render(state: PlanState): { ok: true; total: number; completed: number; remaining: number; steps: Array<{ id: string; text: string; done: boolean }> } {
  const completed = state.steps.filter((s) => s.done).length;
  return {
    ok: true,
    total: state.steps.length,
    completed,
    remaining: state.steps.length - completed,
    steps: state.steps.map((s) => ({ id: s.id, text: s.text, done: s.done })),
  };
}

function ensurePlan(ctx: PrebuiltOpContext): PlanState | { ok: false; error: string } {
  if (!ctx.env.plan) {
    return { ok: false, error: "plan is only available inside a live agent run (the loop wires it) — there is nothing to plan against here." };
  }
  return ctx.env.plan;
}

export const plan: PrebuiltScript = {
  name: "plan",
  description:
    "Your checklist for THIS task. Lay out the steps up front with plan.set, then work through " +
    "them and mark each done with plan.complete_step as you finish it. Once you set a plan you are " +
    "held to it: you cannot answer or give up while steps are still open — finish the work and tick " +
    "the step, or (only if a step is genuinely impossible) say so plainly in your answer. Use this " +
    "for anything with more than one real step; it is what keeps a multi-step job from stopping " +
    "half-done.",
  domain: "orchestration",
  requires_tier: 1,
  paramHints: {
    "plan.set": "steps (string[], REQUIRED) — the ordered steps you intend to do, one short phrase each.",
    "plan.add_step": "step (string, REQUIRED) — one new step to append to the current plan.",
    "plan.complete_step": "step (string, REQUIRED) — the id (from plan.status) OR the exact text of the step you just finished.",
    "plan.status": "no params — returns the current plan with each step's done/not-done status.",
    "plan.clear": "no params — discards the current plan entirely (rarely needed; prefer completing steps).",
  },
  operations: {
    async "plan.set"(a, c) {
      const state = ensurePlan(c);
      if ("error" in state) return state;
      if (!Array.isArray(a["steps"]) || a["steps"].length === 0) {
        return { ok: false, error: "plan.set requires a non-empty 'steps' array (the ordered steps you'll do)." };
      }
      applyPlanOp(state, "plan.set", a);
      return render(state);
    },
    async "plan.add_step"(a, c) {
      const state = ensurePlan(c);
      if ("error" in state) return state;
      if (!String(a["step"] ?? "").trim()) return { ok: false, error: "plan.add_step requires 'step' (the step text)." };
      applyPlanOp(state, "plan.add_step", a);
      return render(state);
    },
    async "plan.complete_step"(a, c) {
      const state = ensurePlan(c);
      if ("error" in state) return state;
      const ref = String(a["step"] ?? "").trim();
      if (!ref) return { ok: false, error: "plan.complete_step requires 'step' (the id or exact text of the finished step)." };
      const before = state.steps.filter((s) => s.done).length;
      applyPlanOp(state, "plan.complete_step", a);
      const after = state.steps.filter((s) => s.done).length;
      if (after === before) {
        const snapshot = render(state);
        return {
          ok: false,
          error: `no plan step matches "${ref}". Use plan.status to see the exact ids/text.`,
          total: snapshot.total,
          remaining: snapshot.remaining,
          steps: snapshot.steps,
        };
      }
      return render(state);
    },
    async "plan.status"(_a, c) {
      const state = ensurePlan(c);
      if ("error" in state) return state;
      return render(state);
    },
    async "plan.clear"(_a, c) {
      const state = ensurePlan(c);
      if ("error" in state) return state;
      applyPlanOp(state, "plan.clear", {});
      return render(state);
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/project-coordination.ts">
/**
 * project-coordination (§A1.18 thread model) — lets a Space Assistant coordinate with a named
 * project agent without mixing that exchange into the visible user<->agent transcript, gives it
 * a narrow way to look at a project's OTHER threads on demand, and — as of this pass — the same
 * everyday thread operations a human has: open one, rename or archive it, find one by name, and
 * actually chat inside an existing thread rather than only through a hidden side channel.
 *
 * Design (see CLAUDE.md item 75 for the full reasoning): a project thread is the person and
 * whichever agent is working — two visible parties, no addressing ambiguity. When the assistant
 * needs to talk TO that agent (a handoff, a status check, an instruction) WITHOUT it appearing in
 * the visible thread, that's `thread.consult` — a real, separate conversation in its own subthread
 * (thread_kind='sub_agent', parent_thread_id), hidden by default and expandable in the shell.
 * `thread.send_message` is the other half: when the point IS for the message (and, unless
 * respond:false, the target agent's reply) to actually show up in a real, visible thread — the
 * assistant participating the way a person types into a thread and gets an answer. "Context is
 * not lost" is mostly already solved without shared transcripts — Memory OS L3/L4/L6
 * (project-shared) and the Project Journal carry the DISTILLED state across every thread in a
 * project — this script is for the rarer cases of needing the RAW exchange itself: consulting an
 * agent privately, chatting in a visible thread, or auditing exactly what was said in one.
 *
 * `thread.list`/`thread.read`/`thread.search` are read-only and never gated (same precedent as
 * workspace-admin's `project.list`/`agent.list`). `thread.consult` is left ungated by default too —
 * it dispatches the assistant's own normal operating cost (one run), same posture as @mention
 * dispatch; whatever the consulted agent decides to DO is still gated by its own
 * agent_policy_overrides/assistant_policy exactly as if a human had asked it directly.
 * `thread.create`/`thread.rename`/`thread.delete`/`thread.send_message` ARE gated by default —
 * each is either a structural write or a real dispatched run, and the guided policy's job is to
 * let the owner see structure and cost appear on purpose rather than accumulate.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";
import {
  ALLOWED_MODELS,
  DEFAULT_WORKING_MODEL,
  capabilityForModel,
  contextWindowForModel,
  benchmarkForModel,
  isAllowedModel,
  suggestModels,
} from "@naelao/billing-core";

/** The general Space Assistant agent id — provisioned in every space, so it is a valid target in
 *  every project even one with no explicit agent_definitions rows. Kept in sync with
 *  DEFAULT_NAELAO_AGENT.agentId in profiles.ts. */
const GENERAL_AGENT_ID = "naelao-agent";

interface ProjectAgentEntry {
  id: string;
  name: string;
  description?: string;
  is_default?: boolean;
}

/** List the agents addressable from a project: every agent_definition in the space PLUS the
 *  general Space Assistant, which is always addressable even in a brand-new project (auto-added
 *  to the listing so a spawn/consult/send can name it). De-duplicated by id. */
async function listProjectAgents(ctx: PrebuiltOpContext): Promise<ProjectAgentEntry[]> {
  let rows: Array<Record<string, unknown>> = [];
  try {
    const res = (await spacesCall(
      ctx,
      "GET",
      `/spaces/${ctx.env.spaceId}/agent-definitions?space_id=${encodeURIComponent(ctx.env.spaceId)}`
    )) as { data?: Array<Record<string, unknown>> };
    rows = Array.isArray(res.data) ? res.data : [];
  } catch {
    // A listing failure must never make the general agent invisible — it is always addressable.
    rows = [];
  }
  const entries: ProjectAgentEntry[] = rows.map((r) => ({
    id: String(r["id"] ?? ""),
    name: String(r["name"] ?? r["id"] ?? "agent"),
    ...(typeof r["description"] === "string" ? { description: r["description"] as string } : {}),
  }));
  if (!entries.some((e) => e.id === GENERAL_AGENT_ID)) {
    entries.unshift({
      id: GENERAL_AGENT_ID,
      name: "Space Assistant (general)",
      description: "The default general-purpose agent, available in every project.",
      is_default: true,
    });
  }
  return entries;
}

/** Rank candidate agent ids/names against a guess by token overlap — the "did you mean" list for
 *  an agent_id that names no real agent (same shape as billing-core's suggestModels). */
function suggestAgents(guess: string, agents: ProjectAgentEntry[], max = 3): string[] {
  const g = guess.toLowerCase().trim();
  if (!g) return [];
  const gTokens = new Set(g.split(/[/\-.@\s_]+/).filter(Boolean));
  return agents
    .map((a) => {
      const hay = `${a.id} ${a.name}`.toLowerCase();
      let score = 0;
      for (const t of hay.split(/[/\-.@\s_]+/).filter(Boolean)) if (gTokens.has(t)) score += 2;
      if (hay.includes(g)) score += 3;
      for (const t of gTokens) if (t.length >= 3 && hay.includes(t)) score += 1;
      return { id: a.id, score };
    })
    .filter((s) => s.score > 0)
    .sort((a, b) => b.score - a.score)
    .slice(0, max)
    .map((s) => s.id);
}

/** Returns a structured error result when `agentId` names no addressable agent, else null. */
async function validateAgentId(ctx: PrebuiltOpContext, agentId: string): Promise<Record<string, unknown> | null> {
  const agents = await listProjectAgents(ctx);
  if (agents.some((a) => a.id === agentId)) return null;
  const suggestions = suggestAgents(agentId, agents);
  return {
    ok: false,
    error:
      `agent "${agentId}" was not found in this project.` +
      (suggestions.length ? ` Did you mean: ${suggestions.join(", ")}?` : "") +
      ` Call thread.list_project_agents to see who you can address ("${GENERAL_AGENT_ID}" is always available).`,
    did_you_mean: suggestions,
    available_agents: agents.map((a) => a.id),
  };
}

/** Returns a structured error result when `model` is a non-empty, non-allowed id, else null. */
function validateModel(model: string | undefined): Record<string, unknown> | null {
  if (!model || isAllowedModel(model)) return null;
  const suggestions = suggestModels(model);
  return {
    ok: false,
    error:
      `model "${model}" is not available.` +
      (suggestions.length ? ` Did you mean: ${suggestions.join(", ")}?` : "") +
      ` Call thread.list_project_models to see every model you can name (omit "model" to use the agent's default).`,
    did_you_mean: suggestions,
  };
}

async function spacesCall(ctx: PrebuiltOpContext, method: string, path: string, body?: Record<string, unknown>): Promise<unknown> {
  if (!ctx.env.spacesWorker) throw new Error("project-coordination unavailable: spaces worker binding not configured");
  const token = await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId);
  const resp = await ctx.env.spacesWorker.fetch(
    new Request(`http://spaces-worker${path}`, {
      method,
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": token,
        // Act on behalf of the person who asked, when there is one — same reasoning as
        // workspace-admin's own spacesCall (see that file's header): correct attribution on
        // anything created, and the assistant is clamped to what that person could do unaided.
        ...(ctx.env.userId ? { "x-naelao-user-id": ctx.env.userId } : {}),
      },
      ...(body ? { body: JSON.stringify(body) } : {}),
    })
  );
  if (!resp.ok) throw new Error(`project-coordination ${method} ${path} failed: ${resp.status} ${await resp.text()}`);
  return resp.json();
}

export const projectCoordination: PrebuiltScript = {
  name: "project-coordination",
  description:
    "Work with a project's threads and its agents — everything a person can do with a thread, " +
    "not just read one: open a new thread, rename or archive one, find one by name, list a " +
    "project's threads, read exactly what was said in one, send a real message INTO an existing " +
    "thread (with the target agent replying there, visibly, the way a person chatting in it " +
    "would), and consult a named project agent PRIVATELY (a separate exchange, not the visible " +
    "thread). Use send_message when the point is for the person to see the exchange; use consult " +
    "when it's a private handoff/check-in/instruction that shouldn't appear in the visible thread; " +
    "use thread.read when you need the raw exchange rather than the Project Journal's distilled " +
    "summary.",
  domain: "orchestration",
  requires_tier: 1,
  operations: {
    "thread.consult": async (a, c) => {
      if (!c.env.orchestration?.consultAgent) {
        return { ok: false, error: "thread.consult not available in this environment" };
      }
      const agentId = String(a["agent_id"] ?? "");
      const message = String(a["message"] ?? "");
      if (!agentId || !message) throw new Error("thread.consult requires agent_id and message");
      // Validate the target agent up front so a wrong id gets a real "did you mean" list instead
      // of the bare "HTTP 404 / not provisioned" the DO dispatch would otherwise surface.
      const agentCheck = await validateAgentId(c, agentId);
      if (agentCheck) return agentCheck;
      const projectId = a["project_id"] ? String(a["project_id"]) : c.env.projectId;
      const parentThreadId = a["parent_thread_id"] ? String(a["parent_thread_id"]) : undefined;
      const threadId = a["thread_id"] ? String(a["thread_id"]) : undefined;
      return c.env.orchestration.consultAgent({
        agentId,
        message,
        spaceId: c.env.spaceId,
        ...(projectId ? { projectId } : {}),
        ...(parentThreadId ? { parentThreadId } : {}),
        ...(threadId ? { threadId } : {}),
      });
    },
    // Post a real message into an EXISTING, visible thread — and, unless respond:false, dispatch
    // the named agent to reply THERE, the way a person chatting in that thread would see happen.
    // Distinct from thread.consult (above): that one is private and hidden; this one is exactly
    // what shows up when someone opens the thread. `agent_id` is required to get a reply — there
    // is no attempt to guess "the project's default agent"; name who you're addressing.
    "thread.send_message": async (a, c) => {
      if (!c.env.orchestration?.sendToThread) {
        return { ok: false, error: "thread.send_message not available in this environment" };
      }
      const threadId = String(a["thread_id"] ?? "");
      const message = String(a["message"] ?? "");
      if (!threadId || !message) throw new Error("thread.send_message requires thread_id and message");
      const agentId = a["agent_id"] ? String(a["agent_id"]) : undefined;
      const respond = a["respond"] !== false;
      const model = a["model"] ? String(a["model"]) : undefined;
      // Validate the model and (when a reply is wanted) the target agent up front, so a wrong id
      // returns a real did-you-mean rather than a bare 404 from the dispatch.
      const modelErr = validateModel(model);
      if (modelErr) return modelErr;
      if (respond && agentId) {
        const agentErr = await validateAgentId(c, agentId);
        if (agentErr) return agentErr;
      }
      return c.env.orchestration.sendToThread({
        threadId,
        message,
        spaceId: c.env.spaceId,
        ...(agentId ? { agentId } : {}),
        ...(model ? { model } : {}),
        respond,
      });
    },
    // Open a real, visible thread — what "new thread" in the shell does. Deliberately creates a
    // 'primary' thread only: 'sub_agent' threads are the private consult/fan-out lane above (the
    // orchestration hook owns those), and 'channel' threads are minted by the channel gateway from
    // a verified inbound webhook. Letting an agent forge either kind by hand would put messages
    // somewhere the UI presents as having a provenance they didn't have.
    //
    // A thread with no linked session is unopenable in the shell ("Session not found") — the
    // thread page renders <Chat> against thread.session_id and nothing else ever mints one for a
    // thread created this way. So this also creates and links the real chat session immediately,
    // the same way a human clicking "New thread" does (Chat.tsx's startSession(thread_id)) —
    // generate the id ourselves so the thread exists BEFORE the session tries to link to it
    // (POST /sessions' thread_id link is a best-effort UPDATE ... WHERE session_id IS NULL, a
    // no-op against a thread that doesn't exist yet).
    "thread.create": async (a, c) => {
      const projectId = a["project_id"] ? String(a["project_id"]) : c.env.projectId;
      const id = crypto.randomUUID();
      const thread = (await spacesCall(c, "POST", `/spaces/${c.env.spaceId}/threads`, {
        id,
        ...(a["title"] ? { title: String(a["title"]) } : {}),
        ...(projectId ? { project_id: projectId } : {}),
      })) as Record<string, unknown>;
      try {
        const session = (await spacesCall(c, "POST", `/spaces/${c.env.spaceId}/sessions`, { thread_id: id })) as { id?: string };
        if (session?.id) thread["session_id"] = session.id;
      } catch {
        // The thread itself was created successfully; a missing session link is a real gap
        // (the thread will still 404 as "Session not found" if opened) but not a reason to fail
        // the whole call — the caller still gets a real thread id back to retry/inspect.
      }
      return thread;
    },
    "thread.list": (a, c) => {
      const qs = new URLSearchParams({ space_id: c.env.spaceId });
      const projectId = a["project_id"] ? String(a["project_id"]) : c.env.projectId;
      if (projectId) qs.set("project_id", projectId);
      if (a["parent_thread_id"]) qs.set("parent_thread_id", String(a["parent_thread_id"]));
      if (a["include_sub_threads"]) qs.set("include_sub_threads", "true");
      return spacesCall(c, "GET", `/spaces/${c.env.spaceId}/threads?${qs.toString()}`);
    },
    "thread.read": async (a, c) => {
      const threadId = String(a["thread_id"] ?? "");
      if (!threadId) throw new Error("thread.read requires thread_id");
      const thread = (await spacesCall(c, "GET", `/spaces/${c.env.spaceId}/threads/${encodeURIComponent(threadId)}`)) as {
        id: string;
        session_id?: string | null;
        [key: string]: unknown;
      };
      if (!thread.session_id) return { thread, messages: [] };
      const messages = await spacesCall(c, "GET", `/spaces/${c.env.spaceId}/sessions/${thread.session_id}/messages`);
      return { thread, messages };
    },
    "thread.rename": async (a, c) => {
      const threadId = String(a["thread_id"] ?? "");
      const title = String(a["title"] ?? "");
      if (!threadId || !title) throw new Error("thread.rename requires thread_id and title");
      return spacesCall(c, "PATCH", `/spaces/${c.env.spaceId}/threads/${encodeURIComponent(threadId)}`, { title });
    },
    // There is no hard delete for a thread — its messages are real conversation history, and this
    // archives it (status:'archived'), same convention `project.configure({status:'archived'})`
    // already uses. isThreadLimitReached (SpaceDO) already excludes archived threads from a
    // project's max_threads count, so this frees up room the same way a real delete would.
    "thread.delete": async (a, c) => {
      const threadId = String(a["thread_id"] ?? "");
      if (!threadId) throw new Error("thread.delete requires thread_id");
      return spacesCall(c, "PATCH", `/spaces/${c.env.spaceId}/threads/${encodeURIComponent(threadId)}`, { status: "archived" });
    },
    // A real, honest search — matches thread TITLES only (same precedent as the shell's own
    // Sessions-page search, which is instant client-side title filtering; a genuine full-text
    // search over message CONTENT was explicitly scoped out there too and stays out here for the
    // same reason: no backend route for it exists yet, and pretending otherwise would silently
    // under-deliver on what "search" means).
    "thread.search": async (a, c) => {
      const query = String(a["query"] ?? "").trim().toLowerCase();
      if (!query) throw new Error("thread.search requires query");
      const projectId = a["project_id"] ? String(a["project_id"]) : c.env.projectId;
      const qs = new URLSearchParams({ space_id: c.env.spaceId });
      if (projectId) qs.set("project_id", projectId);
      if (a["include_sub_threads"]) qs.set("include_sub_threads", "true");
      const listed = (await spacesCall(c, "GET", `/spaces/${c.env.spaceId}/threads?${qs.toString()}`)) as {
        data?: Array<{ id: string; title?: string | null; [key: string]: unknown }>;
      };
      const matches = (listed.data ?? []).filter((t) => (t.title ?? "").toLowerCase().includes(query));
      return { query, matches, matched_count: matches.length };
    },
    // Step 8: the AI must be able to SEE which models/agents it may address before spawning,
    // consulting, or sending — otherwise it guesses an id and gets a 404 (or never sets one).
    // list_project_models mirrors sub-agent's agent.list_models; list_project_agents always
    // includes the general agent so a brand-new project still lists a real, addressable target.
    "thread.list_project_models": async () => {
      return {
        default: DEFAULT_WORKING_MODEL,
        models: ALLOWED_MODELS.map((m) => {
          const cap = capabilityForModel(m);
          const bench = benchmarkForModel(m);
          return {
            id: m,
            family: bench?.family ?? null,
            cost_tier: bench?.costTier ?? null,
            context_window: contextWindowForModel(m),
            supports_thinking: cap.reasoningLevels.length > 0,
            thinking_levels: cap.reasoningLevels,
            best_for: bench?.bestFor ?? [],
          };
        }),
      };
    },
    "thread.list_project_agents": async (_a, c) => {
      const agents = await listProjectAgents(c);
      return { agents, default_agent: GENERAL_AGENT_ID };
    },
  },
  // Live-reported bug this closes: a model asked to "create a thread in project p1 and say hello"
  // called thread.create({}) — no project_id, since nothing told it that field existed — landing
  // the thread with no project attached, then never attempted thread.send_message at all because
  // it had no idea what fields that call needed. See PrebuiltScript.paramHints's own doc.
  paramHints: {
    "thread.create": "project_id (string, OPTIONAL but almost always what you want — the project's " +
      "own id, e.g. from project.list/project.create's result; pass it to attach the new thread to " +
      "THAT project, otherwise omitting it silently creates a space-wide thread with no project at " +
      "all). title (string, optional).",
    "thread.send_message": "thread_id (string, REQUIRED — the id from thread.create/thread.list, " +
      "NOT the project id). message (string, REQUIRED — the real text to post, e.g. \"hello\"). " +
      "agent_id (string, optional but needed to get a reply — without it the message posts with " +
      "nobody addressed to answer it; use agent.list to see which agents exist). respond " +
      "(boolean, optional, default true — set false to post without dispatching a reply). model " +
      "(string, optional — run the replying agent on a specific model for this one dispatch; ids " +
      "come from agent.list_models, and omitting it uses that agent's own configured default).",
    "thread.consult": "agent_id (string, REQUIRED — who to consult). message (string, REQUIRED). " +
      "project_id/thread_id (string, optional — defaults to this run's own project/a fresh " +
      "subthread). This is PRIVATE (hidden from the visible thread) — use thread.send_message " +
      "instead when the point is for the person to see the exchange.",
    "thread.list": "project_id (string, optional — defaults to this run's own project; omit for " +
      "every thread in the space).",
    "thread.read": "thread_id (string, REQUIRED).",
    "thread.rename": "thread_id (string, REQUIRED). title (string, REQUIRED — the new title).",
    "thread.delete": "thread_id (string, REQUIRED) — archives it; there is no hard delete.",
    "thread.search": "query (string, REQUIRED — matched against thread TITLES only, not message " +
      "content). project_id (string, optional).",
    "thread.list_project_models": "no parameters. Returns every model you may name in a spawn, " +
      "consult, or send_message (with context window, thinking support, cost tier) — call this " +
      "before guessing a model id.",
    "thread.list_project_agents": "no parameters. Returns every agent you may address in this " +
      "project (id + name); the general Space Assistant is always included and addressable.",
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/project-journal.ts">
/**
 * project-journal — the project's shared, durable "what is going on here" file.
 *
 * Memory OS already shares Layers 3/4/6 across a project and keeps Layer 5 private per
 * (thread, agent). That boundary is right: one thread's conversational meandering must not
 * contaminate another thread's reasoning. But it leaves project STATE homeless — "invoice.csv
 * now exists", "the payout task is done" is neither a semantic fact nor a private episode, and
 * without somewhere to put it two agents in two threads happily redo each other's work.
 *
 * This prebuilt is that place. One markdown file per project (see project-journal.ts for the
 * format and the compaction rules), read on demand — never injected into every LLM call, which
 * is the whole reason it can afford to hold real detail.
 *
 * Scoping is structural, not advisory: every op derives the project from `ctx.env.projectId`, so
 * an agent cannot read or write another project's journal by passing a different id. A run with
 * no projectId (the Space Assistant's own space-wide slot) has no journal of its own and is told
 * so plainly rather than silently writing to a space-level file nobody reads.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import {
  parseJournal,
  renderJournal,
  emptyJournal,
  appendActivity,
  compactJournal,
  journalKey,
  DEFAULT_JOURNAL_LIMITS,
  type ProjectJournal,
  type JournalSummarizer,
} from "../project-journal.js";
import { UTILITY_MODEL } from "@naelao/billing-core";

function bucket(ctx: PrebuiltOpContext): R2Bucket {
  return ctx.env.workspaceBucket ?? ctx.env.scriptsBucket;
}

/** Every op funnels through this so the "which project?" question has exactly one answer. */
function requireProject(ctx: PrebuiltOpContext): { spaceId: string; projectId: string } | { error: string } {
  const projectId = ctx.env.projectId;
  if (!projectId) {
    return {
      error:
        "no project journal here — this run is not bound to a project (the Space Assistant works space-wide). Open or name a project first.",
    };
  }
  return { spaceId: ctx.env.spaceId, projectId };
}

async function loadJournal(ctx: PrebuiltOpContext, spaceId: string, projectId: string): Promise<ProjectJournal> {
  const obj = await bucket(ctx).get(journalKey(spaceId, projectId));
  if (!obj) return emptyJournal();
  return parseJournal(await obj.text());
}

async function saveJournal(ctx: PrebuiltOpContext, spaceId: string, projectId: string, j: ProjectJournal): Promise<void> {
  await bucket(ctx).put(journalKey(spaceId, projectId), renderJournal(j));
}

/** An LLM-backed summariser when one is wired, else undefined so compaction uses its
 *  deterministic rollup. Never throws — compaction treats a failure as "no summary". */
function summarizerFor(ctx: PrebuiltOpContext): JournalSummarizer | undefined {
  const caller = ctx.env.llmCaller;
  if (!caller?.complete) return undefined;
  return async (entries, existingArchive) => {
    const lines = entries.map((e) => `- ${e.at} [${e.actor}] ${e.summary}`).join("\n");
    const prompt = [
      "You maintain a running summary of a project's history.",
      "Rewrite the ARCHIVE so it absorbs the NEW ENTRIES below.",
      "Keep it dense and factual: what was accomplished, what was decided, what changed.",
      "Preserve concrete names (files, customers, amounts) — they are why anyone reads this.",
      "Drop chatter and repetition. Do not invent anything. Under 200 words.",
      "",
      `EXISTING ARCHIVE:\n${existingArchive || "(empty)"}`,
      "",
      `NEW ENTRIES:\n${lines}`,
    ].join("\n");
    const out = await caller.complete!({
      // Compaction is a background maintenance task, not user-facing reasoning — cascaded-routing
      // trick 4: route it to the shared cheap UTILITY_MODEL (one tuned constant, not a drifting
      // hardcoded string), not the agent's reasoning model.
      model: UTILITY_MODEL,
      prompt,
      maxTokens: 400,
    });
    return out.text?.trim() || null;
  };
}

function nowIso(): string {
  return new Date().toISOString();
}

export const projectJournal: PrebuiltScript = {
  name: "project-journal",
  description:
    "The project's shared journal: its goal, standing instructions, current status, todos and a bounded log of what every agent in the project has done. Read it to find out what is already done before starting work; log to it after doing something.",
  domain: "knowledge",
  requires_tier: 1,
  operations: {
    /** Read the journal. This is the op an assistant calls INSTEAD of walking every thread. */
    async "project_journal.read"(args, ctx) {
      const scope = requireProject(ctx);
      if ("error" in scope) return { ok: false, reason: scope.error };
      const j = await loadJournal(ctx, scope.spaceId, scope.projectId);
      const section = typeof args["section"] === "string" ? (args["section"] as string).toLowerCase() : null;
      if (section) {
        const map: Record<string, unknown> = {
          goal: j.goal,
          instructions: j.instructions,
          status: j.status,
          todos: j.todos,
          activity: j.activity,
          archive: j.archive,
        };
        if (!(section in map)) {
          return { ok: false, reason: `unknown section '${section}' (goal, instructions, status, todos, activity, archive)` };
        }
        return { ok: true, section, value: map[section] };
      }
      return {
        ok: true,
        name: j.name,
        goal: j.goal,
        instructions: j.instructions,
        status: j.status,
        todos: j.todos,
        // Newest last; a reader wanting "what just happened" reads the tail.
        activity: j.activity,
        archive: j.archive,
        markdown: renderJournal(j),
      };
    },

    /** Record something that was done. The op every agent calls after a real action. */
    async "project_journal.log"(args, ctx) {
      const scope = requireProject(ctx);
      if ("error" in scope) return { ok: false, reason: scope.error };
      const summary = String(args["summary"] ?? "").trim();
      if (!summary) throw new Error("project_journal.log requires 'summary' (one line: what you did)");
      const actor = String(args["actor"] ?? ctx.env.agentId ?? "agent");
      // Only ever the caller's explicit thread_id: ScriptEngineEnv carries no thread identity of
      // its own, and inventing one would put a wrong "jump to this conversation" link in the log.
      const threadId = typeof args["thread_id"] === "string" ? (args["thread_id"] as string) : undefined;

      const j = await loadJournal(ctx, scope.spaceId, scope.projectId);
      const result = await appendActivity(
        j,
        { at: nowIso(), actor, summary, ...(threadId ? { threadId } : {}) },
        summarizerFor(ctx),
        DEFAULT_JOURNAL_LIMITS
      );
      await saveJournal(ctx, scope.spaceId, scope.projectId, result.journal);
      return {
        ok: true,
        logged: summary,
        compacted: result.compacted,
        activity_entries: result.journal.activity.length,
      };
    },

    /** Set the goal / standing instructions / status. Separate from `log` because these are
     *  rewritten in place, not appended — a status that accumulated would be a second activity
     *  log with none of its bounds. */
    async "project_journal.set"(args, ctx) {
      const scope = requireProject(ctx);
      if ("error" in scope) return { ok: false, reason: scope.error };
      const j = await loadJournal(ctx, scope.spaceId, scope.projectId);
      let changed = false;
      for (const field of ["goal", "instructions", "status", "name"] as const) {
        const v = args[field];
        if (typeof v === "string") {
          j[field] = v.trim();
          changed = true;
        }
      }
      if (!changed) throw new Error("project_journal.set requires at least one of: goal, instructions, status, name");
      await saveJournal(ctx, scope.spaceId, scope.projectId, j);
      return { ok: true, goal: j.goal, instructions: j.instructions, status: j.status, name: j.name };
    },

    /** Add a todo. */
    async "project_journal.add_todo"(args, ctx) {
      const scope = requireProject(ctx);
      if ("error" in scope) return { ok: false, reason: scope.error };
      const text = String(args["text"] ?? "").trim();
      if (!text) throw new Error("project_journal.add_todo requires 'text'");
      const j = await loadJournal(ctx, scope.spaceId, scope.projectId);
      // Adding the same todo twice is a normal consequence of two threads working in parallel —
      // dedupe rather than letting the list rot into duplicates.
      const existing = j.todos.find((t) => t.text.toLowerCase() === text.toLowerCase());
      if (existing) return { ok: true, todo: existing, already_present: true, todos: j.todos };
      j.todos.push({ text, done: false, at: nowIso() });
      await saveJournal(ctx, scope.spaceId, scope.projectId, j);
      return { ok: true, todos: j.todos };
    },

    /** Mark a todo done (or undone). Matched on exact text, case-insensitive. */
    async "project_journal.complete_todo"(args, ctx) {
      const scope = requireProject(ctx);
      if ("error" in scope) return { ok: false, reason: scope.error };
      const text = String(args["text"] ?? "").trim();
      if (!text) throw new Error("project_journal.complete_todo requires 'text'");
      const done = args["done"] === undefined ? true : Boolean(args["done"]);
      const j = await loadJournal(ctx, scope.spaceId, scope.projectId);
      const todo = j.todos.find((t) => t.text.toLowerCase() === text.toLowerCase());
      if (!todo) return { ok: false, reason: `no todo matching '${text}'`, todos: j.todos };
      todo.done = done;
      todo.at = nowIso();
      await saveJournal(ctx, scope.spaceId, scope.projectId, j);
      return { ok: true, todos: j.todos };
    },

    /** Force a compaction pass. Normally unnecessary — `log` compacts automatically — but
     *  exposed so a scheduled job or an assistant tidying up can trigger it deliberately. */
    async "project_journal.compact"(_args, ctx) {
      const scope = requireProject(ctx);
      if ("error" in scope) return { ok: false, reason: scope.error };
      const j = await loadJournal(ctx, scope.spaceId, scope.projectId);
      const result = await compactJournal(j, summarizerFor(ctx), DEFAULT_JOURNAL_LIMITS);
      if (result.compacted > 0) await saveJournal(ctx, scope.spaceId, scope.projectId, result.journal);
      return {
        ok: true,
        compacted: result.compacted,
        used_summarizer: result.usedSummarizer,
        activity_entries: result.journal.activity.length,
      };
    },
  },
  paramHints: {
    "project_journal.read": "no required fields — the project comes from the run itself, never an argument.",
    "project_journal.log": "summary (string, REQUIRED — ONE factual line about what you actually DID and what resulted, e.g. \"created the Lead Tracking project and briefed the dev agent\"; the field is `summary`, not `content`/`text`).",
    "project_journal.set": "at least one of goal / instructions / status / name (all strings).",
    "project_journal.add_todo": "text (string, REQUIRED).",
    "project_journal.complete_todo": "text (string, REQUIRED — matching an existing todo).",
    "project_journal.compact": "no arguments.",
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/r2-workspace.ts">
/**
 * r2-workspace (spec §12.1) — maps file operations to Tier 1 direct R2.
 * Default for all agents. The R2 workspace is the agent's persistent filesystem; it
 * persists across sessions. Operations: read_file, write_file, list_directory,
 * delete_file, copy_file, move_file, stat_file, search_file — plus a second, Claude-Code-shaped
 * set of REPL primitives that share the SAME underlying store: Read (line-windowed), Edit
 * (surgical search-and-replace), Write (atomic write — literally the same op as write_file),
 * Grep (regex search across the whole workspace, not just one file), Glob (path-pattern
 * listing). Both sets stay callable forever — RENAMED_OPERATIONS (tool-surface.ts) also maps a
 * few lowercase aliases (read/edit/write/grep/glob/bash) onto these for a model that reaches for
 * the more familiar spelling.
 *
 * The matching observe script for this is observe_filesystem (see observe.ts).
 *
 * read_file's own result becomes part of THIS turn's reasoner payload immediately — it isn't
 * windowed down to a short observation until step-context.ts trims an OLDER step, which is too
 * late for a single oversized read. A multi-MB file (a customer-uploaded CSV, a large export)
 * read in full would blow a small model's ~24k-token context in one call. stat_file lets the
 * agent check size before committing to a read; read_file itself also refuses past
 * MAX_READABLE_FILE_BYTES rather than trusting the model to check first — same "structure over
 * prompts" reasoning as every other hard cap in this engine. Read/Edit/Grep carry their own,
 * independent size gates below — LINE-windowed reading needs the whole object's text in memory
 * to find line boundaries, so its ceiling is deliberately the higher MAX_SEARCHABLE_FILE_BYTES,
 * not the smaller MAX_READABLE_FILE_BYTES read_file uses for a true single-shot read.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { workspacePrefix } from "../types.js";

/** Above this, read_file refuses rather than returning a payload that can blow the context of a
 *  turn all by itself. ~50k tokens at a rough 4-chars/token estimate — generous for real text/
 *  config/code files, bounded well under even the platform's smallest usable model window. */
const MAX_READABLE_FILE_BYTES = 200_000;

/** Resolve the workspace bucket (falls back to the scripts bucket if not separate). */
function bucket(ctx: PrebuiltOpContext): R2Bucket {
  return ctx.env.workspaceBucket ?? ctx.env.scriptsBucket;
}

/** All workspace keys are scoped under the run's workspace prefix (space- or project-scoped). */
function key(ctx: PrebuiltOpContext, path: string): string {
  const clean = String(path).replace(/^\/+/, "");
  if (clean.includes("..")) throw new Error(`Path traversal rejected: ${path}`);
  return `${workspacePrefix(ctx.env)}${clean}`;
}

function reqStr(args: Record<string, unknown>, name: string): string {
  const v = args[name];
  if (typeof v !== "string" || v.length === 0) throw new Error(`'${name}' (string) is required`);
  return v;
}

function numArg(args: Record<string, unknown>, name: string): number | undefined {
  const v = args[name];
  if (typeof v === "number" && Number.isFinite(v)) return v;
  if (typeof v === "string" && v.trim() !== "" && Number.isFinite(Number(v))) return Number(v);
  return undefined;
}

/** Cap on how large a file search_file/Read/Grep will read in one pass. Higher than the
 *  single-read cap because search returns only matching lines, not the whole file — but still
 *  bounded so a genuinely huge file is read in chunks via read_file(offset,length) instead. */
const MAX_SEARCHABLE_FILE_BYTES = 5_000_000;

/** Grep scans across the whole workspace, not one named file — bounded on BOTH files touched
 *  and matches found so a sparse query against a large workspace can't approach the platform's
 *  1000-subrequest-per-invocation ceiling (one R2 get per file scanned) or blow a turn's payload. */
const MAX_GREP_FILES_SCANNED = 300;
const MAX_GREP_MATCHES = 100;

async function writeFileImpl(
  ctx: PrebuiltOpContext,
  path: string,
  content: string
): Promise<{ ok: true; path: string; size: number }> {
  await bucket(ctx).put(key(ctx, path), content, {
    customMetadata: { updatedAt: Date.now().toString() },
  });
  // The file IS the handoff between projects: one project's agent records what it found, that
  // write fires an event, and a no-code rule wakes whoever owns the next stage. Fired after the
  // write actually succeeded, and never awaited — a listener failing must not turn a successful
  // write into a failed one.
  ctx.env.onWorkspaceChange?.({ path, operation: "write" });
  return { ok: true, path, size: content.length };
}

/** Claude-Code-shaped windowed reader: 1-indexed LINE offset/limit, returned as
 *  `"<n> | <line>"` text the way an agent expects a file viewer to look. Distinct from
 *  read_file's byte-oriented offset/length — the two are NOT interchangeable, and existing
 *  callers of read_file (byte offsets) must keep working unchanged. */
async function readWindowed(
  ctx: PrebuiltOpContext,
  path: string,
  offsetLines?: number,
  limitLines?: number
): Promise<{
  exists: boolean;
  content?: string;
  lines_total?: number;
  offset?: number;
  limit?: number;
  has_more?: boolean;
  too_large?: boolean;
  size?: number;
  message?: string;
}> {
  const head = await bucket(ctx).head(key(ctx, path));
  if (!head) return { exists: false };
  if (head.size > MAX_SEARCHABLE_FILE_BYTES) {
    return {
      exists: true,
      too_large: true,
      size: head.size,
      message: `This file is ${head.size} bytes, over the ${MAX_SEARCHABLE_FILE_BYTES}-byte limit for a windowed read. Use search_file/Grep to jump to the part you need, or read_file(path, offset, length) for a true byte-chunked read.`,
    };
  }
  const obj = await bucket(ctx).get(key(ctx, path));
  if (!obj) return { exists: false };
  const allLines = (await obj.text()).split(/\r?\n/);
  const total = allLines.length;
  const start = Math.max(1, offsetLines ?? 1);
  const count = Math.max(1, Math.min(limitLines ?? 2000, 2000));
  const slice = allLines.slice(start - 1, start - 1 + count);
  const padWidth = String(start + Math.max(0, slice.length - 1)).length;
  const content = slice.map((line, idx) => `${String(start + idx).padStart(padWidth, " ")} | ${line}`).join("\n");
  const hasMore = start - 1 + count < total;
  return {
    exists: true,
    content,
    lines_total: total,
    offset: start,
    limit: count,
    ...(hasMore ? { has_more: true } : { has_more: false }),
  };
}

/** Surgical single-occurrence search-and-replace. Refuses (rather than guessing) when the exact
 *  text isn't found — returning nearby lines sharing a keyword so the model can self-correct
 *  without a wasted extra Read round-trip — and refuses when the match is ambiguous (>1
 *  occurrence), since replacing "the wrong one" silently is worse than asking for more context. */
async function editFile(
  ctx: PrebuiltOpContext,
  path: string,
  oldString: string,
  newString: string
): Promise<{ ok: boolean; path: string; replacements?: number; error?: string; hint?: string }> {
  if (!oldString) throw new Error("'oldString' (string) is required");
  const head = await bucket(ctx).head(key(ctx, path));
  if (!head) return { ok: false, path, error: `File not found: ${path}` };
  if (head.size > MAX_READABLE_FILE_BYTES) {
    return {
      ok: false,
      path,
      error: `This file is ${head.size} bytes, over the ${MAX_READABLE_FILE_BYTES}-byte limit for Edit. Use read_file(path, offset, length) to inspect it in chunks instead.`,
    };
  }
  const obj = await bucket(ctx).get(key(ctx, path));
  if (!obj) return { ok: false, path, error: `File not found: ${path}` };
  const content = await obj.text();

  if (!content.includes(oldString)) {
    const searchLines = oldString.split(/\r?\n/).map((l) => l.trim()).filter((l) => l.length > 3);
    const fileLines = content.split(/\r?\n/);
    const nearbyHints: Array<{ line: number; text: string }> = [];
    for (let i = 0; i < fileLines.length; i++) {
      const fl = fileLines[i] ?? "";
      if (searchLines.some((sl) => fl.includes(sl))) {
        nearbyHints.push({ line: i + 1, text: fl.trim().slice(0, 100) });
        if (nearbyHints.length >= 4) break;
      }
    }
    const hint =
      nearbyHints.length > 0
        ? `oldString was not found verbatim. Possibly nearby (line ${nearbyHints[0]!.line}):\n` +
          nearbyHints.map((h) => `  ${h.line}: ${h.text}`).join("\n")
        : `oldString was not found in ${path}. Read it first to get the exact current text.`;
    return { ok: false, path, error: "target_string_not_found", hint };
  }

  const occurrences = content.split(oldString).length - 1;
  if (occurrences > 1) {
    return {
      ok: false,
      path,
      error: `oldString matched ${occurrences} times in ${path} — include more surrounding lines in oldString so the replacement is unambiguous.`,
    };
  }

  const patched = content.replace(oldString, newString);
  await writeFileImpl(ctx, path, patched);
  return { ok: true, path, replacements: 1 };
}

/** Regex search across every file under a prefix (the whole workspace, or a narrower path) —
 *  distinct from search_file, which searches ONE named file. Bounded on files scanned AND
 *  matches found; a search that hits either cap says so rather than silently stopping. */
async function grepWorkspace(
  ctx: PrebuiltOpContext,
  pattern: string,
  pathPrefix = ""
): Promise<{
  pattern: string;
  total_matches: number;
  matches: Array<{ file: string; line_number: number; text: string }>;
  files_scanned: number;
  truncated: boolean;
}> {
  let regex: RegExp;
  try {
    regex = new RegExp(pattern, "i");
  } catch {
    throw new Error(`'${pattern}' is not a valid regular expression`);
  }
  const prefix = key(ctx, pathPrefix);
  const wsPrefix = workspacePrefix(ctx.env);
  const matches: Array<{ file: string; line_number: number; text: string }> = [];
  let filesScanned = 0;
  let cursor: string | undefined;
  let truncated = false;
  do {
    const listing = await bucket(ctx).list(cursor ? { prefix, cursor } : { prefix });
    for (const objMeta of listing.objects) {
      if (objMeta.key.endsWith("/.keep") || objMeta.size > MAX_SEARCHABLE_FILE_BYTES) continue;
      if (filesScanned >= MAX_GREP_FILES_SCANNED) { truncated = true; break; }
      filesScanned++;
      const fileObj = await bucket(ctx).get(objMeta.key);
      if (!fileObj) continue;
      const lines = (await fileObj.text()).split(/\r?\n/);
      const relativePath = objMeta.key.slice(wsPrefix.length);
      for (let i = 0; i < lines.length; i++) {
        const line = lines[i] ?? "";
        if (regex.test(line)) {
          matches.push({ file: relativePath, line_number: i + 1, text: line.trim().slice(0, 300) });
          if (matches.length >= MAX_GREP_MATCHES) { truncated = true; break; }
        }
      }
      if (matches.length >= MAX_GREP_MATCHES) break;
    }
    cursor = listing.truncated && !truncated ? listing.cursor : undefined;
  } while (cursor);

  return { pattern, total_matches: matches.length, matches, files_scanned: filesScanned, truncated };
}

/**
 * Glob-to-RegExp translation, a single left-to-right token scan rather than a chain of
 * `.replace()` calls. (Note for anyone editing this comment: never write the two characters
 * star-slash next to each other in here, even inside backticks — it closes a block comment.)
 * A naive replace-chain (convert a double-star to a placeholder, THEN a single star to
 * `[^` + slash + `]*`, then swap the placeholder for `.*`) has two real failure modes, both
 * caught by this port's own tests:
 *   1. Re-matching: if the placeholder swap runs before the single-star pass, the star inside
 *      the just-inserted `.*` gets rewritten again, corrupting "cross any directory depth" into
 *      "exactly one path segment".
 *   2. Even done in the right order, treating a double-star-then-slash as two independent
 *      tokens ("cross any depth", then a literal slash) makes the slash MANDATORY — so a
 *      pattern like double-star, slash, star, ".ts" (which must ALSO match a root-level file
 *      with zero directories, e.g. `top.ts`, per standard glob semantics) could never match
 *      anything without a slash in it. Double-star-then-slash has to be recognized as ONE unit
 *      and translated to an OPTIONAL group.
 * A bare double-star not immediately followed by a slash still means "cross any depth" (`.*`);
 * `?` is a single-char wildcard, matching standard glob conventions.
 */
function globToRegex(pattern: string): RegExp {
  let out = "";
  let i = 0;
  while (i < pattern.length) {
    if (pattern[i] === "*" && pattern[i + 1] === "*") {
      if (pattern[i + 2] === "/") {
        out += "(?:.*/)?";
        i += 3;
      } else {
        out += ".*";
        i += 2;
      }
      continue;
    }
    const c = pattern[i]!;
    if (c === "*") out += "[^/]*";
    else if (c === "?") out += "[^/]";
    else if (".+^${}()|[]\\".includes(c)) out += "\\" + c;
    else out += c;
    i++;
  }
  return new RegExp(`^${out}$`);
}

async function globWorkspace(
  ctx: PrebuiltOpContext,
  pattern: string | undefined,
  pathPrefix = ""
): Promise<{ path: string; files: string[]; count: number; truncated: boolean }> {
  const prefix = key(ctx, pathPrefix);
  const wsPrefix = workspacePrefix(ctx.env);
  const allFiles: string[] = [];
  let cursor: string | undefined;
  let truncated = false;
  const CAP = 2000;
  do {
    const listing = await bucket(ctx).list(cursor ? { prefix, cursor } : { prefix });
    for (const obj of listing.objects) {
      if (obj.key.endsWith("/.keep")) continue;
      allFiles.push(obj.key.slice(wsPrefix.length));
      if (allFiles.length >= CAP) { truncated = true; break; }
    }
    cursor = listing.truncated && !truncated ? listing.cursor : undefined;
  } while (cursor);

  if (!pattern || pattern === "*" || pattern === "**") {
    return { path: pathPrefix, files: allFiles, count: allFiles.length, truncated };
  }
  const re = globToRegex(pattern);
  const filtered = allFiles.filter((f) => re.test(f));
  return { path: pathPrefix, files: filtered, count: filtered.length, truncated };
}

export const r2Workspace: PrebuiltScript = {
  name: "r2-workspace",
  description:
    "Read, write, list, delete, copy and move files in the agent's R2 workspace. read_file " +
    "supports chunked byte reads (offset/length) for files too big to read at once; stat_file " +
    "checks size first; search_file finds matching lines inside ONE named file. Read/Edit/Write/" +
    "Grep/Glob are the same workspace through a Claude-Code-shaped lens: Read is a line-numbered " +
    "windowed view, Edit is a surgical exact-text replace, Grep searches ACROSS every file (not " +
    "just one), Glob lists paths matching a pattern like '**/*.ts'.",
  domain: "filesystem",
  requires_tier: 1,
  paramHints: {
    read_file:
      "path (string, REQUIRED). offset (number, optional) + length (number, optional) — read ONLY " +
      "that byte range, the way to read a file bigger than the read limit: start at offset 0, then " +
      "pass the next_offset the result returns until has_more is false. Omit both for a full read " +
      "(refused with too_large if the file exceeds the limit — then use offset/length or search_file).",
    stat_file: "path (string, REQUIRED). Returns size + whether it's readable in one call — call this " +
      "BEFORE read_file on anything that might be large.",
    search_file:
      "path (string, REQUIRED). query (string, REQUIRED — a substring, matched case-insensitively). " +
      "context (number, optional, 0-10) — lines of surrounding context per match. Returns matching " +
      "lines with line numbers; many matches are paged automatically.",
    write_file: "path (string, REQUIRED). content (string, REQUIRED).",
    list_directory: "path (string, optional — a prefix; omit for the whole workspace).",
    delete_file: "path (string, REQUIRED).",
    copy_file: "from (string, REQUIRED). to (string, REQUIRED).",
    move_file: "from (string, REQUIRED). to (string, REQUIRED).",
    Read: "path (string, REQUIRED). offset (number, optional — 1-indexed LINE to start at). limit " +
      "(number, optional — line count, default/max 2000). Returns `\"<n> | <line>\"` text, LINE " +
      "numbers not bytes — different from read_file's byte offset/length. Refused past 5MB; use " +
      "Grep or read_file's byte-chunked reads on anything bigger.",
    Edit: "path (string, REQUIRED). oldString (string, REQUIRED — the EXACT text to replace, must " +
      "match exactly once). newString (string, REQUIRED). Read the file first if unsure of the " +
      "exact current text — a near-miss returns nearby lines as a hint, never guesses.",
    Write: "path (string, REQUIRED). content (string, REQUIRED). Identical to write_file.",
    Grep: "pattern (string, REQUIRED — a regular expression). path (string, optional — a prefix to " +
      "search under; omit for the whole workspace). Searches every file under the prefix, not one " +
      "— for one named file use search_file instead.",
    Glob: "pattern (string, optional — e.g. '**/*.ts'; omit or '*'/'**' for every file). path " +
      "(string, optional prefix).",
  },
  operations: {
    async read_file(args, ctx) {
      const path = reqStr(args, "path");
      const k = key(ctx, path);

      // Step 3: chunked/ranged read. When offset and/or length are given, read only that byte
      // range — the way to read a file LARGER than the single-read cap, a slice at a time. The
      // returned chunk is byte-bounded by the cap; has_more/next_offset tell the agent how to
      // page through the rest (same convention as the tool-result paginator). A ranged R2 get()
      // still reports the FULL object size in `.size`, so no separate head() is needed.
      const offset = numArg(args, "offset");
      const length = numArg(args, "length");
      if (offset !== undefined || length !== undefined) {
        const off = Math.max(0, offset ?? 0);
        const len = Math.min(length ?? MAX_READABLE_FILE_BYTES, MAX_READABLE_FILE_BYTES);
        const obj = await bucket(ctx).get(k, { range: { offset: off, length: len } });
        if (!obj) return { exists: false, content: null };
        const total = obj.size;
        if (off >= total) {
          return { exists: true, content: "", offset: off, length: 0, total_size: total, has_more: false };
        }
        const content = await obj.text();
        // Byte-accurate next offset (content.length is chars, which drifts for multibyte UTF-8).
        const bytesRead = Math.min(len, total - off);
        const end = off + bytesRead;
        const hasMore = end < total;
        return {
          exists: true,
          content,
          offset: off,
          length: bytesRead,
          total_size: total,
          has_more: hasMore,
          ...(hasMore ? { next_offset: end } : {}),
        };
      }

      // Full read. get() returns the object with its real `.size` metadata, so the oversize check
      // still happens before the body is materialized into a payload that could blow the turn.
      const obj = await bucket(ctx).get(k);
      if (!obj) return { exists: false, content: null };
      if (obj.size > MAX_READABLE_FILE_BYTES) {
        return {
          exists: true,
          content: null,
          size: obj.size,
          too_large: true,
          message: `This file is ${obj.size} bytes, over the ${MAX_READABLE_FILE_BYTES}-byte limit for a single read. Read it in chunks with read_file(path, offset, length) — start at offset 0, then use the next_offset it returns — or use search_file(path, query) to jump straight to the part you need.`,
        };
      }
      return { exists: true, content: await obj.text(), size: obj.size };
    },
    // Step 3: search WITHIN a file and get back only the matching lines (with line numbers, and
    // optional surrounding context) instead of pulling the whole file. Many matches are paged by
    // the generic tool-result paginator, so a broad query never overflows the turn. For a file too
    // large even to scan in one pass, use read_file's chunked offset/length reads.
    async search_file(args, ctx) {
      const path = reqStr(args, "path");
      const query = reqStr(args, "query");
      const k = key(ctx, path);
      const head = await bucket(ctx).head(k);
      if (!head) return { exists: false };
      if (head.size > MAX_SEARCHABLE_FILE_BYTES) {
        return {
          exists: true,
          too_large: true,
          size: head.size,
          message: `This file is ${head.size} bytes, over the ${MAX_SEARCHABLE_FILE_BYTES}-byte search limit. Read it in chunks with read_file(path, offset, length) and scan each chunk yourself.`,
        };
      }
      const obj = await bucket(ctx).get(k);
      if (!obj) return { exists: false };
      const text = await obj.text();
      const q = query.toLowerCase();
      const contextLines = Math.max(0, Math.min(numArg(args, "context") ?? 0, 10));
      const lines = text.split(/\r?\n/);
      const matches: Array<{ line_number: number; text: string; context?: string }> = [];
      for (let i = 0; i < lines.length; i++) {
        if ((lines[i] ?? "").toLowerCase().includes(q)) {
          const entry: { line_number: number; text: string; context?: string } = {
            line_number: i + 1,
            text: lines[i] ?? "",
          };
          if (contextLines > 0) {
            entry.context = lines.slice(Math.max(0, i - contextLines), i + contextLines + 1).join("\n");
          }
          matches.push(entry);
        }
      }
      return { exists: true, query, total_matches: matches.length, matches };
    },
    // A cheap, content-free size/existence check — call this BEFORE read_file on anything that
    // might be large (a customer upload, an export another agent produced) instead of finding out
    // the hard way.
    async stat_file(args, ctx) {
      const head = await bucket(ctx).head(key(ctx, reqStr(args, "path")));
      if (!head) return { exists: false };
      return {
        exists: true,
        size: head.size,
        uploaded: head.uploaded.toISOString(),
        readable: head.size <= MAX_READABLE_FILE_BYTES,
      };
    },

    async write_file(args, ctx) {
      const path = reqStr(args, "path");
      const content = args["content"];
      if (typeof content !== "string") throw new Error("'content' (string) is required");
      await bucket(ctx).put(key(ctx, path), content, {
        customMetadata: { updatedAt: Date.now().toString() },
      });
      // The file IS the handoff between projects: one project's agent records what it found,
      // that write fires an event, and a no-code rule wakes whoever owns the next stage. Fired
      // after the write actually succeeded, and never awaited — a listener failing must not turn
      // a successful write into a failed one.
      ctx.env.onWorkspaceChange?.({ path, operation: "write" });
      return { ok: true, path };
    },

    async list_directory(args, ctx) {
      const prefix = key(ctx, typeof args["path"] === "string" ? (args["path"] as string) : "");
      const out: Array<{ key: string; size: number; uploaded: string }> = [];
      let cursor: string | undefined;
      do {
        const listing = await bucket(ctx).list(cursor ? { prefix, cursor } : { prefix });
        for (const o of listing.objects) {
          out.push({ key: o.key, size: o.size, uploaded: o.uploaded.toISOString() });
        }
        cursor = listing.truncated ? listing.cursor : undefined;
      } while (cursor);
      return { files: out, count: out.length };
    },

    async delete_file(args, ctx) {
      const path = reqStr(args, "path");
      await bucket(ctx).delete(key(ctx, path));
      ctx.env.onWorkspaceChange?.({ path, operation: "delete" });
      return { ok: true };
    },

    async copy_file(args, ctx) {
      const from = await bucket(ctx).get(key(ctx, reqStr(args, "from")));
      if (!from) throw new Error("source file not found");
      await bucket(ctx).put(key(ctx, reqStr(args, "to")), from.body);
      return { ok: true };
    },

    async move_file(args, ctx) {
      const fromKey = key(ctx, reqStr(args, "from"));
      const from = await bucket(ctx).get(fromKey);
      if (!from) throw new Error("source file not found");
      await bucket(ctx).put(key(ctx, reqStr(args, "to")), from.body);
      await bucket(ctx).delete(fromKey);
      return { ok: true };
    },

    // ── Claude-Code-shaped REPL primitives — same workspace, different lens (see file header) ──
    async Read(args, ctx) {
      return readWindowed(ctx, reqStr(args, "path"), numArg(args, "offset"), numArg(args, "limit"));
    },
    async Edit(args, ctx) {
      const newString = args["newString"];
      return editFile(
        ctx,
        reqStr(args, "path"),
        reqStr(args, "oldString"),
        typeof newString === "string" ? newString : ""
      );
    },
    async Write(args, ctx) {
      return writeFileImpl(ctx, reqStr(args, "path"), reqStr(args, "content"));
    },
    async Grep(args, ctx) {
      const p = args["path"];
      return grepWorkspace(ctx, reqStr(args, "pattern"), typeof p === "string" ? p : "");
    },
    async Glob(args, ctx) {
      const pattern = args["pattern"];
      const p = args["path"];
      return globWorkspace(
        ctx,
        typeof pattern === "string" ? pattern : undefined,
        typeof p === "string" ? p : ""
      );
    },
  },
};
</file>

