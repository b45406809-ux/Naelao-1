    <h3>Local PC as a Container Target</h3>
    <p>Users can connect their own machine as a container target via the <strong>Naelao Local Agent</strong> — a small
      native app (Electron wrapper or CLI daemon) that runs on their machine and establishes a persistent WebSocket
      tunnel to <code>LocalTunnelDO</code>. This is the most powerful container type: full filesystem access, GPU, local
      software (Xcode, Adobe suite, proprietary CLIs), and no billing for compute since it runs on the user's hardware.
    </p>

    <div class="g2">
      <div class="box box-rd">
        <div class="box-lbl">Security Model — Local PC Is Always Opt-In</div>
        <p>Connecting a local machine is a deliberate, explicit action. The Naelao Local Agent presents a
          <strong>permission grant UI</strong> before any agent can use it. Grants are scoped: the user selects which
          directories are readable, which are writable, and which system commands are allowed. An agent asking to
          <code>read_file</code> on the local machine can only access paths within granted directories.
          <code>execute_bash</code> on local runs in a restricted shell with only granted commands in PATH.</p>
      </div>
      <div class="box box-bl">
        <div class="box-lbl">What Local PC Unlocks</div>
        <ul class="fl">
          <li><strong>Full filesystem:</strong> Agent can read/write any file the user grants access to — Documents,
            Desktop, code repos, downloads.</li>
          <li><strong>GPU access:</strong> Local ML inference, video rendering, game development with real GPU.</li>
          <li><strong>Proprietary software:</strong> Run Xcode builds, Adobe scripts, AutoCAD macros, Excel macros —
            anything installed on the machine.</li>
          <li><strong>Local services:</strong> Talk to <code>localhost</code> — a local dev server, a database, a
            hardware device.</li>
          <li><strong>Zero compute cost:</strong> All execution happens on the user's CPU/GPU — no Cloudflare container
            billing.</li>
        </ul>
      </div>
    </div>

    <h4>Local Agent Protocol</h4>
    <pre><code><span class="cm">// durable-objects/local-tunnel-do.ts
// One LocalTunnelDO per (spaceId, userId). Maintained only when the local agent is connected.
// The local agent connects via WebSocket. The DO forwards tool calls over the WS.</span>

export class LocalTunnelDO extends DurableObject {
  private localAgentWs: WebSocket | null = null;
  private pendingCalls = new Map&lt;string, (result: ToolResult) =&gt; void&gt;();
  private grants: LocalPermissionGrant[] = [];

  async fetch(request: Request): Promise&lt;Response&gt; {
    const url = new URL(request.url);

    <span class="cm">// The local agent connects here via the CF WebSocket Hibernation API</span>
    if (url.pathname === '/connect') {
      const { 0: client, 1: server } = new WebSocketPair();
      this.ctx.acceptWebSocket(server, ['local-agent']);
      this.localAgentWs = server;
      return new Response(null, { status: 101, webSocket: client });
    }

    <span class="cm">// Called by AgentDO when routing a tool call to the local machine</span>
    if (url.pathname === '/exec') return this.execOnLocal(request);
    if (url.pathname === '/status') return this.status();
    if (url.pathname === '/grants') return this.getGrants();
    return new Response('Not Found', { status: 404 });
  }

  async execOnLocal(request: Request): Promise&lt;Response&gt; {
    if (!this.localAgentWs) {
      return Response.json({ error: 'Local machine not connected. Open the Naelao Local Agent.' }, { status: 503 });
    }

    const call = await request.json() as LocalToolCall;

    <span class="cm">// CRITICAL: Check permission grants before forwarding</span>
    const permitted = this.checkGrants(call);
    if (!permitted.ok) {
      return Response.json({ error: `Permission denied: ${permitted.reason}` }, { status: 403 });
    }

    <span class="cm">// Forward to local agent, await response</span>
    const callId = crypto.randomUUID();
    const result = await new Promise&lt;ToolResult&gt;((resolve) =&gt; {
      this.pendingCalls.set(callId, resolve);
      this.localAgentWs!.send(JSON.stringify({ callId, ...call }));
      <span class="cm">// Timeout after 30s</span>
      setTimeout(() =&gt; {
        this.pendingCalls.delete(callId);
        resolve({ error: 'Local agent timed out' });
      }, 30_000);
    });

    return Response.json(result);
  }

  <span class="cm">// Called when the local agent sends back a result</span>
  async webSocketMessage(ws: WebSocket, message: string): Promise&lt;void&gt; {
    const { callId, result } = JSON.parse(message) as { callId: string; result: ToolResult };
    const resolve = this.pendingCalls.get(callId);
    if (resolve) {
      this.pendingCalls.delete(callId);
      resolve(result);
    }
  }

  private checkGrants(call: LocalToolCall): { ok: boolean; reason?: string } {
    if (call.tool === 'read_file_local') {
      const allowed = this.grants
        .filter(g =&gt; g.type === 'read' || g.type === 'readwrite')
        .some(g =&gt; call.params.path.startsWith(g.directory));
      return allowed ? { ok: true } : { ok: false, reason: `Path ${call.params.path} not in any granted read directory` };
    }
    if (call.tool === 'write_file_local') {
      const allowed = this.grants
        .filter(g =&gt; g.type === 'readwrite' || g.type === 'write')
        .some(g =&gt; call.params.path.startsWith(g.directory));
      return allowed ? { ok: true } : { ok: false, reason: `Path ${call.params.path} not in any granted write directory` };
    }
    if (call.tool === 'exec_local') {
      const cmd = call.params.command;
      const allowed = this.grants
        .filter(g =&gt; g.type === 'exec')
        .some(g =&gt; g.commands.includes(cmd) || g.commands.includes('*'));
      return allowed ? { ok: true } : { ok: false, reason: `Command '${cmd}' not in granted exec list` };
    }
    return { ok: false, reason: 'Unknown local tool' };
  }
}</code></pre>

    <h4>Permission Grant Schema</h4>
    <pre><code><span class="cm">// Stored in LocalTunnelDO and displayed in the Naelao Local Agent UI</span>

interface LocalPermissionGrant {
  grantId:    string;
  type:       'read' | 'write' | 'readwrite' | 'exec';
  
  <span class="cm">// For filesystem grants</span>
  directory?: string;     <span class="cm">// e.g. '/Users/alice/Documents/naelao-projects'</span>
  
  <span class="cm">// For exec grants</span>
  commands?:  string[];   <span class="cm">// e.g. ['python3', 'node', 'git', 'xcodebuild']</span>
                           <span class="cm">// ['*'] = unrestricted (power user mode, shown prominently)</span>
  
  grantedAt:  number;
  grantedFor: string;     <span class="cm">// description shown to user when granting</span>
  spaceId:    string;     <span class="cm">// grants are per-Space, not global</span>
  projectId?: string;     <span class="cm">// optional further restriction to one project</span>
}</code></pre>

    <h3>Agent Tool Manifest — Multi-Container Awareness</h3>
    <p>The agent's system prompt tool manifest is rebuilt every time the project's container fleet changes. The
      <code>AgentDO</code> calls <code>ProjectDO.getActiveToolManifest()</code> which queries the container slots table
      and collects <code>exposedTools</code> from all running containers. Tools from different containers are tagged
      with their source so the agent can make intelligent routing decisions.</p>

    <pre><code><span class="cm">// In ProjectDO — build the unified tool manifest for the agent</span>

async getActiveToolManifest(): Promise&lt;AgentToolManifest&gt; {
  const slots = this.ctx.storage.sql
    .exec(`SELECT * FROM container_slots WHERE status = 'running'`)
    .toArray() as ProjectContainerSlot[];

  const tools: ToolDefinition[] = [];

  for (const slot of slots) {
    const slotTools = JSON.parse(slot.exposed_tools) as ExposedTool[];
    for (const tool of slotTools) {
      tools.push({
        ...tool,
        <span class="cm">// Tag with source so agent prompt explains where this tool executes</span>
        containerSlotId: slot.slot_id,
        containerLabel:  slot.display_name,
        routeTo:         slot.type === 'local' ? 'local-tunnel' : 'project-container',
      });
    }
  }

  <span class="cm">// Also include always-available base container tools</span>
  tools.push(...BASE_CONTAINER_TOOLS);

  <span class="cm">// And local machine tools if the local agent is connected</span>
  const localConnected = await this.checkLocalAgentConnected();
  if (localConnected) tools.push(...LOCAL_MACHINE_TOOLS);

  return { tools, generatedAt: Date.now() };
}

<span class="cm">// Tool call routing — AgentDO dispatches based on containerSlotId</span>
async routeToolCall(call: ParsedToolCall): Promise&lt;ToolResult&gt; {
  const toolDef = this.toolManifest.tools.find(t =&gt; t.name === call.name);

  if (!toolDef) return { error: `Unknown tool: ${call.name}` };

  if (toolDef.routeTo === 'local-tunnel') {
    const tunnelDO = this.env.LOCAL_TUNNEL_DO.get(
      this.env.LOCAL_TUNNEL_DO.idFromName(`tunnel:${this.spaceId}:${this.userId}`)
    );
    return (await tunnelDO.fetch(new Request('http://tunnel/exec', {
      method: 'POST', body: JSON.stringify({ tool: call.name, params: call.params })
    }))).json();
  }

  if (toolDef.containerSlotId) {
    const slot = this.getSlot(toolDef.containerSlotId);
    const containerDO = this.env.PROJECT_CONTAINER_DO.get(
      this.env.PROJECT_CONTAINER_DO.idFromName(slot.do_name)
    );
    return (await containerDO.fetch(new Request('http://container/exec', {
      method: 'POST', body: JSON.stringify({ tool: call.name, params: call.params })
    }))).json();
  }

  <span class="cm">// Default: base SandboxDO (Tier 5 on the execution ladder)</span>
  return this.sandboxDO.execTool(call);
}</code></pre>

