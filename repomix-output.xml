<file path=".github/workflows/ci.yml">
name: CI

on:
  push:
    branches: [main, "claude/**"]
  pull_request:
    branches: [main]

env:
  # node:sqlite (used by tests/unit/helpers/sqlite-do-shim.ts + stubs/d1-sqlite.ts to run DO
  # SQLite tests against a real in-memory engine) is only a Node builtin from 22.5+ — Node 20
  # doesn't have it at all. Every test job was failing ERR_UNKNOWN_BUILTIN_MODULE under Node 20.
  NODE_VERSION: "22"
  PNPM_VERSION: "9"

jobs:
  typecheck:
    name: TypeScript typecheck
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      # Workspace packages (e.g. @naelao/client-sdk, @naelao/billing-core) resolve via their
      # compiled dist/ (package.json main/types), which isn't committed. `pnpm --recursive`
      # bypasses turbo's `dependsOn: ["^build"]` graph entirely, so a clean checkout fails to
      # resolve any package that depends on another workspace package's build output.
      - name: Build workspace packages
        run: pnpm turbo run build

      - name: Typecheck all packages
        run: pnpm --recursive --parallel typecheck

  test:
    name: Unit & integration tests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build workspace packages
        run: pnpm turbo run build

      - name: Run tests
        run: pnpm --filter "@naelao/tests" test

  lint:
    name: Lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      # --if-present must precede the script name or pnpm forwards it as a literal arg to the
      # underlying command (e.g. `next lint --if-present`, which next's CLI rejects).
      - name: Lint (if configured)
        run: pnpm --recursive --parallel --if-present lint
</file>

<file path=".github/workflows/deploy-prod.yml">
name: Deploy to production

on:
  push:
    tags:
      - "v[0-9]+.[0-9]+.[0-9]+"

env:
  # node:sqlite is a Node builtin only from 22.5+ (see ci.yml's own note) — required by the
  # DO SQLite test helpers.
  NODE_VERSION: "22"
  PNPM_VERSION: "9"

jobs:
  preflight:
    name: Production preflight checks
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      # `pnpm --recursive` bypasses turbo's build-dependency graph (see ci.yml) — build first.
      - name: Build workspace packages
        run: pnpm turbo run build

      - name: Full typecheck
        run: pnpm --recursive --parallel typecheck

      - name: Run tests
        run: pnpm --filter "@naelao/tests" test

  deploy-workers-prod:
    name: Deploy workers to production
    runs-on: ubuntu-latest
    environment: production
    concurrency: deploy-production
    needs: [preflight]
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Run D1 migrations (production)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
        run: |
          DB_ID="${{ vars.D1_DATABASE_ID_PROD }}"
          for migration in infra/migrations/*.sql; do
            echo "Applying $migration..."
            npx wrangler d1 execute "$DB_ID" \
              --file="$migration" \
              --remote 2>&1 || true
          done

      - name: Deploy all workers (production)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
        run: |
          # F-16: a bash `for` loop's exit code is the LAST iteration's, so a mid-loop deploy
          # failure was silently masked by a later success — production could half-deploy and still
          # report green. Track every failure and fail the step (with a run summary) if any occurred.
          WORKERS=(router spaces agents auth knowledge billing analytics \
                   marketplace threads assistant browser mini-agi channels \
                   security-gateway workflows ws-gateway)
          failed=()
          for w in "${WORKERS[@]}"; do
            if [ -f "workers/$w/wrangler.toml" ]; then
              echo "Deploying $w to production..."
              # F-13: MUST pass --env=production, or wrangler deploys the top-level config
              # (ENVIRONMENT="development", localhost CORS) to production. Every worker defines an
              # [env.production] block (parity enforced by wrangler-vars-parity.test.ts).
              if ! npx wrangler deploy --env=production --config="workers/$w/wrangler.toml"; then
                echo "❌ $w deploy failed"
                failed+=("$w")
              fi
            fi
          done
          if [ ${#failed[@]} -gt 0 ]; then
            echo "### ❌ Production deploy: ${#failed[@]} worker(s) failed: ${failed[*]}" >> "$GITHUB_STEP_SUMMARY"
            exit 1
          fi
          echo "### ✅ Production deploy: all workers deployed" >> "$GITHUB_STEP_SUMMARY"

  deploy-frontends-prod:
    name: Deploy frontends to production
    runs-on: ubuntu-latest
    environment: production
    needs: [deploy-workers-prod]
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build all frontends
        run: |
          pnpm --filter @naelao/dashboard build
          pnpm --filter @naelao/portal build
          pnpm --filter @naelao/marketplace-web build
          pnpm --filter @naelao/widget build
        env:
          NEXT_PUBLIC_API_URL: ${{ vars.API_URL_PROD }}
          NEXT_PUBLIC_DASHBOARD_URL: ${{ vars.DASHBOARD_URL_PROD }}

      - name: Deploy to CF Pages (production)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CF_PAGES_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
        run: |
          npx wrangler pages deploy apps/dashboard/.vercel/output/static \
            --project-name=naelao-dashboard --branch=main
          npx wrangler pages deploy apps/portal/.vercel/output/static \
            --project-name=naelao-portal --branch=main
          npx wrangler pages deploy apps/marketplace-web/.vercel/output/static \
            --project-name=naelao-marketplace --branch=main

      - name: Upload widget to R2 (production, versioned + latest)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
