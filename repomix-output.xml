// G-C01: Credentials worker — encrypted per-Space credential storage.
//
// Credential hierarchy (CLAUDE.md open follow-up, closed here): a credential is resolved for an
// ACTING USER in four tiers, most-specific-wins EXCEPT a privileged override always wins:
//   1. space-scope row with is_override=1  — privileged (owner/admin) override, always wins
//   2. user-scope row for the acting user  — personal credential (the per-user default)
//   3. space-scope row with is_override=0  — shared business-wide fallback (optionally narrowed
//      to specific members via shared_with_user_ids — NULL means everyone, unchanged default)
//   4. the PRODUCT ROOT's own space-scope row — a builder-set product-wide default, checked only
//      when this space is a business (has parent_space_id) and nothing matched above
// A caller above this worker (mcp-hub, a prebuilt op) applies its own final fallback — a
// Naelao-held platform Workers Secret (Tavily, etc, item 42's universal-tools doctrine) — when
// this worker returns nothing at all; that tier is deliberately NOT a vaulted DB row here (see
// CLAUDE.md's item on naelao-wide fallback billing).
// See resolveCredential() below and infra/migrations/0040_space_credentials.sql +
// infra/migrations/0069_credential_sharing_and_product_tier.sql.
import { badRequest, errorResponse, forbidden, mintInternalToken, notFound, requestId, requireInternalHmac } from "@naelao/http";
import { Hono } from "hono";

// ── Env ───────────────────────────────────────────────────────────────────────

export interface CredentialsEnv {
  ENVIRONMENT: string;
  PLATFORM_SECRET: string;
  CREDENTIAL_ENCRYPTION_KEY: string;
  PLATFORM_DB: D1Database;
  ANALYTICS: AnalyticsEngineDataset;
  // Optional: lets a resolved fallback (the acting user didn't get their own personal
  // credential) notify the assistant via SpaceDO's generic event ingress. Best-effort —
  // resolution/decryption never depends on this being wired.
  SPACES_WORKER?: Fetcher;
}

/** Fire credential.fallback_used through SpaceDO's existing generic external-event ingress
 *  (same pattern as workers/billing's fireWalletEvent) — best-effort, never blocks a resolved
 *  credential read. Only fired when a specific acting user was named and didn't get their own
 *  personal credential, so this is signal ("you're running on someone/something else's
 *  credential"), not noise on every ordinary space-level resolution with no acting user. */
async function fireCredentialFallbackEvent(
  env: CredentialsEnv,
  params: { tenantId: string; spaceId: string; name: string; actingUserId: string; tier: CredentialResolvedTier }
): Promise<void> {
  if (!env.SPACES_WORKER) return;
  try {
    await env.SPACES_WORKER.fetch(
      new Request(`http://spaces-worker/internal/spaces/${encodeURIComponent(params.spaceId)}/events/fire`, {
        method: "POST",
        headers: {
          "content-type": "application/json",
          "x-naelao-tenant-id": params.tenantId,
          "x-naelao-internal-token": await mintInternalToken(env.PLATFORM_SECRET, params.tenantId),
        },
        body: JSON.stringify({
          type: "credential.fallback_used",
          space_id: params.spaceId,
          payload: { connector: params.name, requested_by: params.actingUserId, resolved_tier: params.tier },
        }),
      })
    );
  } catch {
    // Best-effort — the credential read itself already succeeded.
  }
}

function validateEnv(env: CredentialsEnv): void {
  if (!env.PLATFORM_SECRET) throw new Error("Missing required secret: PLATFORM_SECRET");
  if (!env.CREDENTIAL_ENCRYPTION_KEY) {
    throw new Error("Missing required secret: CREDENTIAL_ENCRYPTION_KEY");
  }
}

// ── Hex encode/decode helpers ─────────────────────────────────────────────────

function hexToBytes(hex: string): Uint8Array {
  if (hex.length % 2 !== 0) throw new Error("Invalid hex string length");
  const bytes = new Uint8Array(hex.length / 2);
  for (let i = 0; i < bytes.length; i++) {
    const byte = parseInt(hex.slice(i * 2, i * 2 + 2), 16);
    if (isNaN(byte)) throw new Error(`Invalid hex character at position ${i * 2}`);
    bytes[i] = byte;
  }
  return bytes;
}

function bytesToHex(bytes: Uint8Array): string {
  return Array.from(bytes)
    .map((b) => b.toString(16).padStart(2, "0"))
    .join("");
}

// ── AES-256-GCM encryption helpers ───────────────────────────────────────────
// G-D05: Credentials store a key_version alongside each encrypted record.
// On key rotation: new encryptions use the new key version; old records can be
// re-encrypted by reading them with the old key and re-writing with the new key.
// The CREDENTIAL_ENCRYPTION_KEY env var encodes "v<N>:<hex-key>", e.g. "v2:<32bytes-hex>".

// G-AH07: Per-space key hierarchy. Root key is CREDENTIAL_ENCRYPTION_KEY.
// Per-space key is derived via HKDF(root_key, "naelao-cred-v1:<spaceId>").
// This means a single-key compromise only yields the root; space keys are non-extractable.

function parseKeyEnv(keyEnv: string): { version: string; hex: string } {
  const colonIdx = keyEnv.indexOf(":");
  if (colonIdx > 0 && keyEnv[0] === "v") {
    return { version: keyEnv.slice(0, colonIdx), hex: keyEnv.slice(colonIdx + 1) };
  }
  // Legacy: no version prefix — treat as v1
  return { version: "v1", hex: keyEnv };
}

// G-AH07: Derive a per-space AES-256-GCM key from the root key using HKDF-SHA256.
// The info string binds the derivation to the specific space — compromise of one
// space's derived key cannot be used to decrypt another space's credentials.
async function deriveSpaceKey(rootKeyHex: string, spaceId: string): Promise<CryptoKey> {
  const rootBytes = hexToBytes(rootKeyHex);
  const rootKey = await crypto.subtle.importKey("raw", rootBytes, { name: "HKDF" }, false, ["deriveBits"]);
  const info = new TextEncoder().encode(`naelao-cred-v1:${spaceId}`);
  const salt = new Uint8Array(32); // zero salt (info provides domain separation)
  const bits = await crypto.subtle.deriveBits(
    { name: "HKDF", hash: "SHA-256", salt, info },
    rootKey,
    256
  );
  return crypto.subtle.importKey("raw", bits, { name: "AES-GCM" }, false, ["encrypt", "decrypt"]);
}

async function encrypt(
  plaintext: string,
  rootKeyEnv: string,
  spaceId: string
): Promise<{ ciphertext: string; iv: string; key_version: string }> {
  const { version, hex } = parseKeyEnv(rootKeyEnv);
  // G-AH07: Use space-specific derived key, not the root key directly
  const spaceKey = await deriveSpaceKey(hex, spaceId);
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const encoded = new TextEncoder().encode(plaintext);
  const encrypted = await crypto.subtle.encrypt({ name: "AES-GCM", iv }, spaceKey, encoded);
  return { ciphertext: bytesToHex(new Uint8Array(encrypted)), iv: bytesToHex(iv), key_version: version };
}

async function decrypt(ciphertext: string, iv: string, rootKeyHex: string, spaceId: string): Promise<string> {
  // G-AH07: Derive the same per-space key for decryption
  const spaceKey = await deriveSpaceKey(rootKeyHex, spaceId);
  const decrypted = await crypto.subtle.decrypt(
    { name: "AES-GCM", iv: hexToBytes(iv) },
    spaceKey,
    hexToBytes(ciphertext)
  );
  return new TextDecoder().decode(decrypted);
}

/** Resolve the root key hex matching a stored row's key_version (handles rotation). */
function resolveRootKeyHex(
  env: CredentialsEnv,
  rowVersion: string | null
): string {
  const { version: currentVersion, hex: currentHex } = parseKeyEnv(env.CREDENTIAL_ENCRYPTION_KEY);
  const effectiveRowVersion = rowVersion ?? "v1";
  if (effectiveRowVersion === currentVersion) return currentHex;
  const prevKey = (env as CredentialsEnv & { CREDENTIAL_ENCRYPTION_KEY_PREV?: string }).CREDENTIAL_ENCRYPTION_KEY_PREV;
  if (prevKey) {
    const { version: prevVersion, hex: prevHex } = parseKeyEnv(prevKey);
    if (effectiveRowVersion === prevVersion) return prevHex;
  }
  return currentHex;
}

// ── G-F06: Short-lived per-request HMAC token for internal credential access ──
// Token format: "t=<unix-seconds>,aid=<agentId>,v1=<hmac-hex>"
// HMAC payload:  "<spaceId>:<agentId>:<timestamp>"
// Token expires after 60 seconds.

export async function generateCredentialToken(
  platformSecret: string,
  spaceId: string,
  agentId: string
): Promise<string> {
  const timestamp = Math.floor(Date.now() / 1000);
  const signingInput = `${spaceId}:${agentId}:${timestamp}`;
  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(platformSecret),
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["sign"]
  );
  const sig = await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(signingInput));
  const hexSig = Array.from(new Uint8Array(sig))
    .map((b) => b.toString(16).padStart(2, "0"))
    .join("");
  return `t=${timestamp},aid=${agentId},v1=${hexSig}`;
}

async function verifyCredentialToken(
  token: string,
  platformSecret: string,
  expectedSpaceId: string
): Promise<{ ok: boolean; reason?: string }> {
  const TOKEN_MAX_AGE_SECONDS = 60;
  const parts: Record<string, string> = {};
  for (const segment of token.split(",")) {
    const eq = segment.indexOf("=");
    if (eq > 0) parts[segment.slice(0, eq)] = segment.slice(eq + 1);
  }
  const timestamp = parseInt(parts["t"] ?? "0", 10);
  const agentId = parts["aid"] ?? "";
  const receivedHex = parts["v1"] ?? "";

  if (!agentId || !receivedHex) return { ok: false, reason: "Malformed credential token" };

  const age = Math.floor(Date.now() / 1000) - timestamp;
  if (age < 0 || age > TOKEN_MAX_AGE_SECONDS) {
    return { ok: false, reason: `Credential token expired (age=${age}s)` };
  }

  const signingInput = `${expectedSpaceId}:${agentId}:${timestamp}`;
  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(platformSecret),
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["verify"]
  );
  const expectedSigBytes = new Uint8Array(
    (receivedHex.match(/.{2}/g) ?? []).map((h) => parseInt(h, 16))
  );
  const valid = await crypto.subtle.verify(
    "HMAC",
    key,
    expectedSigBytes,
    new TextEncoder().encode(signingInput)
  );
  if (!valid) return { ok: false, reason: "Invalid credential token signature" };
  return { ok: true };
}

// ── Validation ────────────────────────────────────────────────────────────────

// Plain "gmail" or a multi-slot "gmail::work" — the slot suffix lets one user hold several
// named credentials on the same connector (e.g. a personal vs a work Gmail) with no schema
// change: each slot is just a distinct credential name under the existing (space,name,scope
// [,user]) uniqueness rules. The base connector id and the slot label are each capped like a
// plain name would be.
const CREDENTIAL_NAME_RE = /^[A-Za-z0-9_]{1,64}(::[A-Za-z0-9_]{1,32})?$/;
const PRIVILEGED_ROLES = new Set(["owner", "admin"]);

function validateCredentialName(name: string): void {
  if (!CREDENTIAL_NAME_RE.test(name)) {
    throw badRequest(
      "Credential name must be 1–64 characters (alphanumeric/underscore), optionally followed by ::slot (1–32 alphanumeric/underscore)"
    );
  }
}

function isPrivileged(role: string): boolean {
  return PRIVILEGED_ROLES.has(role);
}

// ── Credential hierarchy: row shape + resolution ─────────────────────────────

interface CredentialRow {
  id: string;
  space_id: string;
  tenant_id: string;
  name: string;
  scope: "user" | "space";
  user_id: string | null;
  is_override: number;
  shared_with_user_ids: string | null;
  encrypted_value: string;
  iv: string;
  key_version: string | null;
  description: string | null;
  created_by: string | null;
  created_at: string;
  updated_at: string;
}

export type CredentialResolvedTier = "business_override" | "user" | "business_shared" | "product";

/** Does a business-shared row (is_override=0) apply to this specific acting user? */
function sharedRowAppliesToUser(row: CredentialRow, actingUserId: string | null): boolean {
  if (!row.shared_with_user_ids) return true; // NULL = shared with everyone (default)
  if (!actingUserId) return false; // a selective share needs a known acting user to match against
  try {
    const allowed = JSON.parse(row.shared_with_user_ids) as string[];
    return allowed.includes(actingUserId);
  } catch {
    return true; // malformed data must not silently deny an otherwise-valid shared credential
  }
}

async function fetchSpaceRow(
  db: D1Database,
  spaceId: string,
  tenantId: string,
  name: string
): Promise<CredentialRow | null> {
  return db.prepare(
    `SELECT * FROM space_credentials WHERE space_id = ? AND tenant_id = ? AND name = ? AND scope = 'space' LIMIT 1`
  ).bind(spaceId, tenantId, name).first<CredentialRow>();
}

/**
 * Resolve the effective credential row for (spaceId, name, actingUserId) per the hierarchy:
 *   1. space-scope row with is_override=1        (privileged override — always wins)
 *   2. user-scope row for actingUserId            (personal, default)
 *   3. space-scope row with is_override=0         (business-shared fallback, optionally narrowed
 *      to specific members via shared_with_user_ids)
 *   4. the PRODUCT ROOT's own space-scope row     (product-wide default — only when this space
 *      has a parent, i.e. is a business, and nothing above matched)
 * actingUserId may be omitted (e.g. an agent acting on behalf of the space as a whole, not a
 * specific member) — resolution then skips tier 2 and treats a narrowed tier-3 row as absent.
 * A caller's own further fallback (a Naelao platform-secret key) happens OUTSIDE this function
 * when it returns null — that tier is never a space_credentials row.
 */
async function resolveCredential(
  db: D1Database,
  spaceId: string,
  tenantId: string,
  name: string,
  actingUserId: string | null,
  /** §A1 connector default-vs-personal switch: an explicit ask from the caller for WHICH tier to
   *  use, overriding the implicit "personal always wins when connected" default below.
   *  "business": skip tier 2 entirely (a member's own personal credential is ignored even if one
   *  exists) — the chat surface's default mode, so a shared business account is used unless the
   *  caller deliberately switched. "personal": REQUIRE tier 2 — a missing personal credential is
   *  reported distinctly (personal_required), never silently substituted with the shared one,
   *  since that's exactly the "forgot to switch" case the UI needs to warn about. Absent (every
   *  pre-existing caller) keeps today's byte-identical behavior. The privileged override (tier 1)
   *  always wins regardless — an admin forcing a value is not something either mode should skip. */
  preferScope?: "business" | "personal"
): Promise<{ row: CredentialRow; tier: CredentialResolvedTier } | { notFoundReason: "personal_required" } | null> {
  const spaceRow = await fetchSpaceRow(db, spaceId, tenantId, name);

  if (spaceRow && spaceRow.is_override) return { row: spaceRow, tier: "business_override" };

  const checkPersonalTier = preferScope !== "business" && Boolean(actingUserId);
  if (checkPersonalTier) {
    const userRow = await db.prepare(
      `SELECT * FROM space_credentials WHERE space_id = ? AND tenant_id = ? AND name = ? AND scope = 'user' AND user_id = ? LIMIT 1`
    ).bind(spaceId, tenantId, name, actingUserId).first<CredentialRow>();
    if (userRow) return { row: userRow, tier: "user" };
  }
  if (preferScope === "personal") {
    // Explicitly asked for the personal account and there isn't one connected — never fall
    // through to the shared credential silently, that's the exact mismatch the caller needs to
    // know about (see catalogue.ts / the shell's connector-mode UI).
    return { notFoundReason: "personal_required" };
  }

  if (spaceRow && sharedRowAppliesToUser(spaceRow, actingUserId)) {
    return { row: spaceRow, tier: "business_shared" };
  }

  // Best-effort: the product-root walk is a nice-to-have tier, never a hard dependency of
  // credential resolution — a missing/unreachable spaces table must fall through to "not found"
  // rather than 500 the whole lookup.
  try {
    const space = await db.prepare(
      `SELECT parent_space_id FROM spaces WHERE id = ? AND status != 'deleted'`
    ).bind(spaceId).first<{ parent_space_id: string | null }>();
    if (space?.parent_space_id) {
      const rootRow = await fetchSpaceRow(db, space.parent_space_id, tenantId, name);
      if (rootRow) return { row: rootRow, tier: "product" };
    }
  } catch {
    // Fall through — see comment above.
  }

  return null;
}

// ── Hono app ──────────────────────────────────────────────────────────────────

const app = new Hono<{ Bindings: CredentialsEnv }>();

app.use("*", requestId);
app.use("*", async (c, next) => {
  validateEnv(c.env);
  await next();
});

// B1/B3 fix: the three public CRUD routes only ever trust x-naelao-tenant-id/-user-id/-role
// as-is — with workers_dev disabled the router is the only path in, but this is the
// defense-in-depth backstop (a misconfiguration or a future direct binding must not be able
// to forge a tenant/role). The internal plaintext-resolution route below has its own,
// independent HMAC scheme (generateCredentialToken/verifyCredentialToken, scoped to a single
// agentId+spaceId) and is deliberately NOT covered by this — it's not proxied by the router.
app.use("/spaces/:spaceId/credentials", requireInternalHmac((c) => (c as unknown as { env: CredentialsEnv }).env.PLATFORM_SECRET));
app.use("/spaces/:spaceId/credentials/:credId", requireInternalHmac((c) => (c as unknown as { env: CredentialsEnv }).env.PLATFORM_SECRET));

// POST /v1/spaces/:spaceId/credentials — create a credential.
// Body: { name, value, description?, scope?: 'user'|'space' (default 'user'), is_override?: boolean,
//         shared_with_user_ids?: string[] | null }
// - scope='user' (default): a member's own personal credential. Always allowed for the caller,
//   always owned by the caller (a user can never create another user's credential).
// - scope='space': the shared business-wide credential. Requires owner/admin.
// - is_override=true: only valid with scope='space', requires owner/admin — forces this value
//   ahead of any member's personal credential of the same name.
// - shared_with_user_ids: only valid with scope='space' AND is_override=false — narrows the
//   shared fallback to specific member ids instead of everyone in the business. Requires
//   owner/admin, same as scope='space' itself (a non-admin can never widen/narrow who sees a
//   credential they didn't have the privilege to share in the first place).
app.post("/spaces/:spaceId/credentials", async (c) => {
  const tenantId = c.req.header("x-naelao-tenant-id") ?? "";
  const userId = c.req.header("x-naelao-user-id") ?? "";
  const role = c.req.header("x-naelao-role") ?? "viewer";
  const spaceId = c.req.param("spaceId");

  if (!tenantId) throw badRequest("x-naelao-tenant-id header is required");
  if (!userId) throw badRequest("x-naelao-user-id header is required");

  let body: {
    name: string;
    value: string;
    description?: string;
    scope?: "user" | "space";
    is_override?: boolean;
    shared_with_user_ids?: string[] | null;
  };
  try {
    body = await c.req.json();
  } catch {
    throw badRequest("Invalid JSON body");
  }

  if (!body.name) throw badRequest("name is required");
  if (!body.value) throw badRequest("value is required");
  validateCredentialName(body.name);

  const scope = body.scope ?? "user";
  if (scope !== "user" && scope !== "space") {
    throw badRequest("scope must be 'user' or 'space'");
  }
  const isOverride = Boolean(body.is_override);
  if (isOverride && scope !== "space") {
    throw badRequest("is_override is only valid with scope='space'");
  }
  if ((scope === "space" || isOverride) && !isPrivileged(role)) {
    throw forbidden("Only owner/admin may set a business-shared credential or override");
  }
  const sharedWithUserIds = body.shared_with_user_ids ?? null;
  if (sharedWithUserIds !== null) {
    if (scope !== "space" || isOverride) {
      throw badRequest("shared_with_user_ids is only valid with scope='space' and is_override=false");
    }
    if (!Array.isArray(sharedWithUserIds) || sharedWithUserIds.some((u) => typeof u !== "string" || !u)) {
      throw badRequest("shared_with_user_ids must be an array of user ids, or null");
    }
  }

  // G-AH07: Space-derived key; each space's credentials use a distinct HKDF-derived key
  const { ciphertext, iv, key_version } = await encrypt(body.value, c.env.CREDENTIAL_ENCRYPTION_KEY, spaceId);

  const id = crypto.randomUUID();
  const now = new Date().toISOString();
  const ownerUserId = scope === "user" ? userId : null;
  const sharedWithJson = sharedWithUserIds ? JSON.stringify(sharedWithUserIds) : null;

  // Upsert on the unique (space,name,scope[,user]) index so re-saving the same name/scope
  // rotates the value in place rather than erroring or leaving orphaned rows.
  const conflictTarget = scope === "user" ? "(space_id, name, user_id)" : "(space_id, name)";
  await c.env.PLATFORM_DB.prepare(
    `INSERT INTO space_credentials
       (id, space_id, tenant_id, name, scope, user_id, is_override, shared_with_user_ids, encrypted_value, iv, key_version, description, created_by, created_at, updated_at)
     VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
     ON CONFLICT ${conflictTarget} WHERE scope = '${scope}' DO UPDATE SET
       is_override = excluded.is_override,
       shared_with_user_ids = excluded.shared_with_user_ids,
       encrypted_value = excluded.encrypted_value,
       iv = excluded.iv,
       key_version = excluded.key_version,
       description = excluded.description,
       updated_at = excluded.updated_at`
  )
    .bind(
      id,
      spaceId,
      tenantId,
      body.name,
      scope,
      ownerUserId,
      isOverride ? 1 : 0,
      sharedWithJson,
      ciphertext,
      iv,
      key_version,
      body.description ?? null,
      userId,
      now,
      now
    )
    .run();

  return c.json(
    {
      id,
      name: body.name,
      scope,
      is_override: isOverride,
      shared_with_user_ids: sharedWithUserIds,
      description: body.description ?? null,
      created_at: now,
    },
    201
  );
});

// GET /v1/spaces/:spaceId/credentials — list credentials (metadata only, never values).
// A non-privileged caller sees: their own user-scoped credentials + all space-scoped ones
// (so they can see what's shared/overridden, without seeing teammates' personal credentials).
// A privileged caller (owner/admin) sees everything, for management/audit visibility.
app.get("/spaces/:spaceId/credentials", async (c) => {
  const tenantId = c.req.header("x-naelao-tenant-id") ?? "";
  const userId = c.req.header("x-naelao-user-id") ?? "";
  const role = c.req.header("x-naelao-role") ?? "viewer";
  const spaceId = c.req.param("spaceId");

  if (!tenantId) throw badRequest("x-naelao-tenant-id header is required");

  const query = isPrivileged(role)
    ? c.env.PLATFORM_DB.prepare(
        `SELECT id, name, scope, user_id, is_override, shared_with_user_ids, description, created_at
         FROM space_credentials
         WHERE space_id = ? AND tenant_id = ?
         ORDER BY created_at DESC`
      ).bind(spaceId, tenantId)
    : c.env.PLATFORM_DB.prepare(
        `SELECT id, name, scope, user_id, is_override, shared_with_user_ids, description, created_at
         FROM space_credentials
         WHERE space_id = ? AND tenant_id = ? AND (scope = 'space' OR user_id = ?)
         ORDER BY created_at DESC`
      ).bind(spaceId, tenantId, userId);

  const results = await query.all<{
    id: string;
    name: string;
    scope: "user" | "space";
    user_id: string | null;
    is_override: number;
    shared_with_user_ids: string | null;
    description: string | null;
    created_at: string;
  }>();

  return c.json({
    credentials: results.results.map((r) => ({
      ...r,
      is_override: Boolean(r.is_override),
      shared_with_user_ids: r.shared_with_user_ids ? (JSON.parse(r.shared_with_user_ids) as string[]) : null,
    })),
  });
});

// DELETE /v1/spaces/:spaceId/credentials/:credId — delete a credential.
// A user may always delete their own user-scoped credential. Deleting a space-scoped
// credential (shared or override) requires owner/admin.
app.delete("/spaces/:spaceId/credentials/:credId", async (c) => {
  const tenantId = c.req.header("x-naelao-tenant-id") ?? "";
  const userId = c.req.header("x-naelao-user-id") ?? "";
  const role = c.req.header("x-naelao-role") ?? "viewer";
  const spaceId = c.req.param("spaceId");
  const credId = c.req.param("credId");

  if (!tenantId) throw badRequest("x-naelao-tenant-id header is required");

  const row = await c.env.PLATFORM_DB.prepare(
    `SELECT scope, user_id FROM space_credentials WHERE id = ? AND space_id = ? AND tenant_id = ?`
  ).bind(credId, spaceId, tenantId).first<{ scope: "user" | "space"; user_id: string | null }>();
  if (!row) throw notFound("Credential");

  const isOwnCredential = row.scope === "user" && row.user_id === userId;
  if (!isOwnCredential && !isPrivileged(role)) {
    throw forbidden("Only the owning member or an owner/admin may delete this credential");
  }

  const result = await c.env.PLATFORM_DB.prepare(
    `DELETE FROM space_credentials WHERE id = ? AND space_id = ? AND tenant_id = ?`
  )
    .bind(credId, spaceId, tenantId)
    .run();

  if (result.meta.changes === 0) {
    throw notFound("Credential");
  }

  return c.json({ deleted: true });
});

// PATCH /v1/spaces/:spaceId/credentials/:credId — update sharing metadata on a business-shared
// credential (who it's shared with) WITHOUT touching or re-supplying the secret value. This is
// the "toggle sharing to everyone / selected members" control an admin uses from the UI — the
// upsert-on-POST path above still works for rotating the actual value.
app.patch("/spaces/:spaceId/credentials/:credId", async (c) => {
  const tenantId = c.req.header("x-naelao-tenant-id") ?? "";
  const role = c.req.header("x-naelao-role") ?? "viewer";
  const spaceId = c.req.param("spaceId");
  const credId = c.req.param("credId");

  if (!tenantId) throw badRequest("x-naelao-tenant-id header is required");
  if (!isPrivileged(role)) throw forbidden("Only owner/admin may change credential sharing");

  const row = await c.env.PLATFORM_DB.prepare(
    `SELECT scope, is_override FROM space_credentials WHERE id = ? AND space_id = ? AND tenant_id = ?`
  ).bind(credId, spaceId, tenantId).first<{ scope: "user" | "space"; is_override: number }>();
  if (!row) throw notFound("Credential");
  if (row.scope !== "space") throw badRequest("Only a business-shared credential's sharing can be changed");

  let body: { shared_with_user_ids?: string[] | null };
  try {
    body = await c.req.json();
  } catch {
    throw badRequest("Invalid JSON body");
  }
  if (body.shared_with_user_ids !== undefined && body.shared_with_user_ids !== null) {
    if (!Array.isArray(body.shared_with_user_ids) || body.shared_with_user_ids.some((u) => typeof u !== "string" || !u)) {
      throw badRequest("shared_with_user_ids must be an array of user ids, or null");
    }
  }
  if (row.is_override) throw badRequest("An override credential is always shared with everyone — clear is_override first");

  const sharedWithJson = body.shared_with_user_ids ? JSON.stringify(body.shared_with_user_ids) : null;
  await c.env.PLATFORM_DB.prepare(
    `UPDATE space_credentials SET shared_with_user_ids = ?, updated_at = ? WHERE id = ? AND space_id = ? AND tenant_id = ?`
  ).bind(sharedWithJson, new Date().toISOString(), credId, spaceId, tenantId).run();

  return c.json({ id: credId, shared_with_user_ids: body.shared_with_user_ids ?? null });
});

// POST /v1/internal/spaces/:spaceId/credentials/:name/plaintext
// Internal endpoint — returns decrypted value for agent tool dispatch, resolved through the
// credential hierarchy for an optional acting user (body.on_behalf_of_user_id). Callers that
// don't know/care about a specific member (e.g. mcp-hub resolving a connector's own secret)
// omit it and get the effective space-level credential (override, else shared).
// G-F06: Requires short-lived HMAC credential token (x-naelao-credential-token)
//        embedding {spaceId}:{agentId}:{timestamp}, expires 60s.
app.post("/v1/internal/spaces/:spaceId/credentials/:name/plaintext", async (c) => {
  const tenantId = c.req.header("x-naelao-tenant-id") ?? "";
  const credentialToken = c.req.header("x-naelao-credential-token") ?? "";
  const spaceId = c.req.param("spaceId");
  const credName = c.req.param("name");

  if (!tenantId) throw badRequest("x-naelao-tenant-id header is required");
  if (!credentialToken) throw forbidden("x-naelao-credential-token header is required");

  // G-F06: Verify short-lived HMAC token — prevents cross-space exfiltration
  const tokenCheck = await verifyCredentialToken(credentialToken, c.env.PLATFORM_SECRET, spaceId);
  if (!tokenCheck.ok) {
    throw forbidden(tokenCheck.reason ?? "Invalid credential token");
  }

  let onBehalfOfUserId: string | null = null;
  let preferScope: "business" | "personal" | undefined;
  try {
    const body = await c.req.json<{ on_behalf_of_user_id?: string; prefer_scope?: "business" | "personal" }>();
    onBehalfOfUserId = body.on_behalf_of_user_id ?? null;
    preferScope = body.prefer_scope;
  } catch {
    // Empty/absent body is fine — resolves at the space level.
  }

  const resolved = await resolveCredential(c.env.PLATFORM_DB, spaceId, tenantId, credName, onBehalfOfUserId, preferScope);
  if (!resolved) {
    throw notFound("Credential");
  }
  if ("notFoundReason" in resolved) {
    return c.json({ error_code: "personal_credential_required", message: "No personal credential is connected for this member" }, 404);
  }
  const { row, tier } = resolved;

  // G-AH07/G-D05: Resolve the root key matching this credential's key_version for decryption.
  const rootHex = resolveRootKeyHex(c.env, row.key_version);

  // G-AH07: Re-derive the per-space key using the credential's OWN space (row.space_id) — NOT
  // the requested spaceId. These differ exactly when tier === "product": the row was created on
  // (and encrypted for) the product ROOT space, while spaceId in the URL is the business that
  // fell through to it. Using the wrong space here derives the wrong HKDF key and decryption
  // fails outright.
  const value = await decrypt(row.encrypted_value, row.iv, rootHex, row.space_id);

  // G-D06: Immutable audit entry — credential_access event in Analytics Engine
  try {
    const tokenParts: Record<string, string> = {};
    for (const seg of credentialToken.split(",")) {
      const eq = seg.indexOf("=");
      if (eq > 0) tokenParts[seg.slice(0, eq)] = seg.slice(eq + 1);
    }
    c.env.ANALYTICS.writeDataPoint({
      blobs: [
        "credential_access",          // blob1: event_name
        row.name,                     // blob2: credential_name (not the value)
        spaceId,                      // blob3: space_id
        tokenParts["aid"] ?? "",      // blob4: agent_id
        tenantId,                     // blob5: tenant_id
        tier,                         // blob6: resolved tier (user | business_shared | business_override | product)
      ],
      doubles: [Date.now()],          // double1: access_timestamp_ms
      indexes: [spaceId],
    });
  } catch {
    // Best-effort — audit failures must not block the credential read
  }

  // Notify the assistant when a specific acting user didn't end up on their OWN credential —
  // e.g. their personal one was missing and business-shared/product/an admin override was used
  // instead. Fire-and-forget: this must never slow down or fail the actual credential read.
  if (onBehalfOfUserId && tier !== "user") {
    c.executionCtx.waitUntil(
      fireCredentialFallbackEvent(c.env, { tenantId, spaceId, name: credName, actingUserId: onBehalfOfUserId, tier })
    );
  }

  return c.json({ name: row.name, value, scope: row.scope, is_override: Boolean(row.is_override), resolved_tier: tier });
});

// ── Error handler ─────────────────────────────────────────────────────────────
app.onError((err, c) => errorResponse(err, c.get("requestId") ?? "unknown"));

// ── Export ────────────────────────────────────────────────────────────────────
export default {
  fetch: app.fetch,
} satisfies ExportedHandler<CredentialsEnv>;
</file>

<file path="workers/knowledge/src/index.ts">
/**
 * Naelao Knowledge Worker
 * Handles KB document ingestion, Vectorize indexing, and hybrid semantic search.
 *
 * Gap IDs fulfilled: G-B01..G-B15 (KB System)
 */

import { Hono } from "hono";
import { requestId, errorResponse, notFound, badRequest, unauthorized, internalError, safeKvPut, requireInternalHmac } from "@naelao/http";
import { chunkText, embedText, embedBatch, googleModeSearch, verifyCitationCoordinate, type GroundedSearchHit, type RetrievalScope } from "@naelao/rag";
import { checkSsrf } from "@naelao/security";
import { EntitlementsChecker, getPlanLimits } from "@naelao/entitlements";
import { moderateInput } from "@naelao/llm-gateway";

// ── Environment ───────────────────────────────────────────────────────────────

interface KnowledgeEnv {
  ENVIRONMENT: string;
  PLATFORM_SECRET: string;
  PLATFORM_DB: D1Database;
  KB_BUCKET: R2Bucket;
  KB_VECTORS: VectorizeIndex;
  KB_CACHE: KVNamespace;
  SEMANTIC_CACHE_VECTORS: VectorizeIndex;
  SEMANTIC_CACHE_KV: KVNamespace;
  AI: Ai;
  // UNIVERSAL / PLATFORM-PROVIDED web search (CLAUDE.md "universal tools" principle): Naelao
  // holds ONE search-provider key here as a Workers Secret so every agent gets web search for
  // free — never the BYO-key `space_credentials` model. Optional: when unset, `search`/`extract`
  // report `configured:false` and `fetch` (a keyless SSRF-guarded GET) still works.
  TAVILY_API_KEY?: string;
  // §A1.19 (AutoRAG/AI Search): the AutoRAG instance name backing an opt-in retrieval mode
  // alongside the existing hand-built dense+BM25+RRF hybrid pipeline (default, unchanged).
  // Optional — when unset, `retrieval_mode=autorag` requests fall back to the legacy pipeline
  // rather than erroring, same honest-degradation posture as every other optional integration.
  // The AutoRAG instance must be configured (via the CF dashboard/API, outside this codebase) to
  // watch this worker's own KB_BUCKET at the `autorag/` prefix this file writes mirror docs to —
  // no separate bucket binding is introduced.
  AUTORAG_KB_INSTANCE?: string;
  /** Cohere Parse is mandatory for binary/layout-sensitive ingestion. It intentionally has no
   * fallback to pretending the model ran: callers receive a service-unavailable failure. */
  COHERE_API_KEY?: string;
  RETRIEVAL_POLICY_VERSION?: string;
  RETRIEVAL_CONFIDENCE_THRESHOLD?: string;
  KNOWLEDGE_ANALYTICS?: AnalyticsEngineDataset;
}

/** R2 key for the whole-document mirror AutoRAG indexes (one file per doc, not per-chunk —
 *  AutoRAG does its own chunking). Distinct prefix from the existing per-chunk `chunkR2Key`. */
function autoragKbKey(spaceId: string, projectId: string | null, docId: string): string {
  return `autorag/${spaceId}/${projectId ?? "_space"}/${docId}.md`;
}

// ── R2 chunk record shape ─────────────────────────────────────────────────────

interface ChunkRecord {
  docId: string;
  chunkIndex: number;
  content: string;
  spaceId: string;
  tenantId: string;
  projectId: string;
  visibility: "project" | "space";
  requiredRoleRank: number;
  chunkId: string;
  contentHash: string;
  sourceFreshness: string;
  headingPath: string[];
  byteStart: number;
  byteEnd: number;
  lineStart: number;
  lineEnd: number;
}

// WS-4: Vectorize metadata can't filter on a genuinely absent field the same way SQL's
// `IS NULL` works — an empty string is used as the "space-wide" sentinel so a project-scoped
// query and a space-wide query never accidentally match each other.
const SPACE_WIDE_PROJECT_SENTINEL = "";

// ── Hono app ──────────────────────────────────────────────────────────────────

// G-A11: Validate required secrets at startup
function validateEnv(env: KnowledgeEnv): void {
  if (!env.PLATFORM_SECRET) throw new Error("Missing required secret: PLATFORM_SECRET");
}

const app = new Hono<{ Bindings: KnowledgeEnv }>();
app.use("*", requestId);
app.use("*", async (c, next) => { validateEnv(c.env); await next(); });

// ── Helper: extract + validate tenant ────────────────────────────────────────

function requireTenant(c: { req: { header: (h: string) => string | undefined } }): string {
  const tenantId = c.req.header("x-naelao-tenant-id");
  if (!tenantId) throw unauthorized("Missing x-naelao-tenant-id header");
  return tenantId;
}

// F8: every kb/documents/* route already scopes its SQL by `WHERE space_id = ? AND tenant_id
// = ?`, so a foreign spaceId just matches zero rows there. kb/search has no such scoping — it
// filters Vectorize by space_id alone — so a caller who merely knows/guesses another tenant's
// spaceId could search that tenant's KB. Verify the space is actually owned by the requesting
// tenant before running the (otherwise unscoped) Vectorize query.
async function verifySpaceOwnership(db: D1Database, spaceId: string, tenantId: string): Promise<boolean> {
  const row = await db
    .prepare("SELECT 1 FROM spaces WHERE id = ? AND tenant_id = ? AND status != 'deleted'")
    .bind(spaceId, tenantId)
    .first();
  return row !== null;
}

const ROLE_RANK: Record<string, number> = { product_end_user: 0, viewer: 10, member: 20, developer: 30, admin: 40, owner: 50, builder: 50 };

function effectiveRoleRank(c: { req: { header: (h: string) => string | undefined } }): number {
  const role = c.req.header("x-naelao-role") ?? "";
  const rank = ROLE_RANK[role];
  if (rank === undefined) throw unauthorized("Effective role is unavailable");
  return rank;
}

/** Project authorization is deliberately independent from space ownership. The canonical
 * project ACL is owned by SpaceDO; until a read-only binding is introduced, the mirrored D1
 * project ACL is the fail-closed authority used by this worker. */
async function authorizeProject(db: D1Database, scope: RetrievalScope, userId: string): Promise<boolean> {
  if (!scope.projectId || !userId) return false;
  try {
    const access = await db.prepare(
      `SELECT visibility, role_rank FROM project_access
       WHERE project_id = ? AND user_id = ? AND tenant_id = ? AND space_id = ?`
    ).bind(scope.projectId, userId, scope.tenantId, scope.spaceId)
      .first<{ visibility: string; role_rank: number }>();
    return Boolean(access && access.role_rank >= 0);
  } catch {
    // Schema/service-policy failures must never widen access.
    return false;
  }
}

function contextEnvelope(hit: GroundedSearchHit): string {
  const content = hit.content.replace(/<\/context_chunk>/gi, "&lt;/context_chunk&gt;");
  return `<context_chunk id="${hit.id.replace(/[^a-zA-Z0-9_-]/g, "")}" trust="untrusted">${content}</context_chunk>`;
}

// ── G-BD01: KB content sanitization — strip HTML/XML and scan for injection ───

// Patterns that commonly signal prompt injection attempts in KB content
const INJECTION_PATTERNS: RegExp[] = [
  /ignore\s+(all\s+)?(previous|prior|above)\s+instructions?/i,
  /disregard\s+(all\s+)?(previous|prior|above)\s+instructions?/i,
  /forget\s+(all\s+)?(previous|prior|above)\s+instructions?/i,
  /you\s+are\s+now\s+(a|an)\s+/i,
  /\[SYSTEM\]/i,
  /\bSYSTEM\s*PROMPT\b/i,
  /###\s*(INSTRUCTIONS?|SYSTEM|OVERRIDE|JAILBREAK)/i,
  /<\s*system\s*>/i,
  /\bOVERRIDE\s+(ALL\s+)?(PREVIOUS\s+)?INSTRUCTIONS?\b/i,
  /\bACT\s+AS\s+(IF\s+YOU\s+ARE\s+)?(A\s+)?/i,
];

function sanitizeKbContent(content: string): { sanitized: string; injectionDetected: boolean } {
  // Strip HTML/XML tags to prevent tag-based injection vectors
  const stripped = content
    .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, "")
    .replace(/<style\b[^<]*(?:(?!<\/style>)<[^<]*)*<\/style>/gi, "")
    .replace(/<[^>]{0,500}>/g, " ")
    .replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&amp;/g, "&")
    .replace(/&quot;/g, '"').replace(/&#39;/g, "'")
    .replace(/\s{3,}/g, "\n\n")
    .trim();

  const injectionDetected = INJECTION_PATTERNS.some((p) => p.test(stripped));

  return { sanitized: stripped, injectionDetected };
}

// ── Helper: sha256 hex digest (Web Crypto, available in Workers) ──────────────

async function sha256Hex(input: string): Promise<string> {
  const encoder = new TextEncoder();
  const data = encoder.encode(input);
  const hashBuffer = await crypto.subtle.digest("SHA-256", data);
  const hashArray = Array.from(new Uint8Array(hashBuffer));
  return hashArray.map(b => b.toString(16).padStart(2, "0")).join("");
}

// ── Helper: R2 key for a chunk ────────────────────────────────────────────────
// WS-4: per-project KB isolation — a project's documents live under their own R2 prefix,
// distinct from the space-wide default (projectId undefined/null).

function chunkR2Key(spaceId: string, projectId: string | null | undefined, docId: string, index: number): string {
  return `kb/${spaceId}/${projectId ?? "_space"}/${docId}/chunk_${index}.json`;
}

function citationR2Key(spaceId: string, projectId: string | null | undefined, docId: string, index: number): string {
  return `kb/${spaceId}/${projectId ?? "_space"}/${docId}/chunk_${index}.txt`;
}

function docR2Prefix(spaceId: string, projectId: string | null | undefined, docId: string): string {
  return `kb/${spaceId}/${projectId ?? "_space"}/${docId}/`;
}

async function parseWithCohere(env: KnowledgeEnv, content: string, contentType: string): Promise<string> {
  if (!env.COHERE_API_KEY) throw Object.assign(new Error("Cohere Parse is not configured"), { status: 503 });
  const response = await fetch("https://api.cohere.com/v2/parse", {
    method: "POST",
    headers: { authorization: `Bearer ${env.COHERE_API_KEY}`, "content-type": "application/json" },
    body: JSON.stringify({ model: "parse-v5.0", document: { content, content_type: contentType }, output_format: "markdown" }),
  });
  if (!response.ok) throw Object.assign(new Error(`Cohere Parse failed (${response.status})`), { status: 502 });
  const parsed = await response.json<{ text?: string; markdown?: string; document?: { text?: string } }>();
  const text = parsed.markdown ?? parsed.text ?? parsed.document?.text;
  if (!text) throw Object.assign(new Error("Cohere Parse returned no document text"), { status: 502 });
  return text;
}

function chunkCoordinates(document: string, chunks: string[]): Array<{ byteStart: number; byteEnd: number; lineStart: number; lineEnd: number }> {
  const encoder = new TextEncoder();
  let cursor = 0;
  return chunks.map((chunk) => {
    const characterStart = document.indexOf(chunk, cursor);
    const start = characterStart < 0 ? cursor : characterStart;
    const end = start + chunk.length;
    cursor = end;
    return {
      byteStart: encoder.encode(document.slice(0, start)).byteLength,
      byteEnd: encoder.encode(document.slice(0, end)).byteLength,
      lineStart: document.slice(0, start).split("\n").length,
      lineEnd: document.slice(0, end).split("\n").length,
    };
  });
}

// A1.16.10 (layer-3 backstop, bucket A): KB is a server-side agent tool, never called
// client-side (confirmed neither apps/widget nor apps/portal ever reaches /kb/*) — safe to
// gate broadly.
app.use("/spaces/:spaceId/kb/*", requireInternalHmac((c) => (c as unknown as { env: KnowledgeEnv }).env.PLATFORM_SECRET));
app.use("/spaces/:spaceId/projects/:projectId/citations/*", requireInternalHmac((c) => (c as unknown as { env: KnowledgeEnv }).env.PLATFORM_SECRET));

// F8: requireInternalHmac only authenticates the CALLING WORKER, not the tenant the request
// is acting on behalf of. A compromised/malicious agent script belonging to tenant A can still
// pass a spaceId belonging to tenant B (leaked/guessed via URLs, logs, screenshots) in the
// x-naelao-tenant-id + spaceId pair. Every kb/* verb (list, ingest, patch, delete, search) must
// refuse to touch a space the caller's tenant doesn't own — gated once, here, before any
// handler runs (including cache lookups), so no future route can reintroduce the gap.
app.use("/spaces/:spaceId/kb/*", async (c, next) => {
  const tenantId = requireTenant(c);
  const spaceId = c.req.param("spaceId");
  const owned = await verifySpaceOwnership(c.env.PLATFORM_DB, spaceId, tenantId);
  if (!owned) throw notFound("Space not found");
  await next();
});

// ── GET /spaces/:spaceId/kb/documents ─────────────────────────────────────────

app.get("/spaces/:spaceId/kb/documents", async (c) => {
  const tenantId = requireTenant(c);
  const spaceId = c.req.param("spaceId");
  const url = new URL(c.req.url);
  const limit = Math.min(parseInt(url.searchParams.get("limit") ?? "50", 10), 200);
  const offset = parseInt(url.searchParams.get("offset") ?? "0", 10);
  // WS-4: no project_id param = the pre-existing default, space-wide documents only
  // (project_id IS NULL) — never mixes in a project's own isolated documents by accident.
  const projectId = url.searchParams.get("project_id");

  const { results } = await c.env.PLATFORM_DB.prepare(
    projectId
      ? `SELECT id, space_id, tenant_id, project_id, title, source_url, content_type, status,
                chunk_count, created_at, updated_at
         FROM kb_documents
         WHERE space_id = ? AND tenant_id = ? AND project_id = ?
         ORDER BY created_at DESC
         LIMIT ? OFFSET ?`
      : `SELECT id, space_id, tenant_id, project_id, title, source_url, content_type, status,
                chunk_count, created_at, updated_at
         FROM kb_documents
         WHERE space_id = ? AND tenant_id = ? AND project_id IS NULL
         ORDER BY created_at DESC
         LIMIT ? OFFSET ?`
  )
    .bind(...(projectId ? [spaceId, tenantId, projectId, limit, offset] : [spaceId, tenantId, limit, offset]))
    .all();

  return c.json({ data: results, count: results.length, limit, offset });
});

// ── POST /spaces/:spaceId/kb/documents ────────────────────────────────────────

app.post("/spaces/:spaceId/kb/documents", async (c) => {
  const tenantId = requireTenant(c);
  const spaceId = c.req.param("spaceId");

  const body = await c.req.json<{
    title?: string;
    content?: string;
    content_type?: string;
    source_url?: string;
    /** WS-4: optional — isolates this document to a single project's own KB, distinct from the
     *  space-wide default (omitted/null). */
    project_id?: string;
    required_role_rank?: number;
  }>();
  const projectId = body.project_id ?? null;
  const requiredRoleRank = Math.max(0, Math.min(body.required_role_rank ?? 0, 50));
  if (projectId) {
    const scope = { tenantId, spaceId, projectId, roleRank: effectiveRoleRank(c) };
    const userId = c.req.header("x-naelao-user-id") ?? "";
    if (!(await authorizeProject(c.env.PLATFORM_DB, scope, userId))) throw notFound("Project not found");
  }

  // Validate required fields
  if (!body.title || typeof body.title !== "string" || body.title.trim().length === 0) {
    throw badRequest("title is required");
  }
  if (!body.content || typeof body.content !== "string") {
    throw badRequest("content is required");
  }

  const validContentTypes = new Set(["text", "url", "code", "pdf"]);
  const contentType = body.content_type ?? "text";
  if (!validContentTypes.has(contentType)) {
    throw badRequest(`content_type must be one of: text, url, code, pdf`);
  }

  // Enforce 1MB content limit
  const MAX_CONTENT_CHARS = 1_048_576;
  if (body.content.length > MAX_CONTENT_CHARS) {
    throw badRequest(`content exceeds maximum size of 1MB (${MAX_CONTENT_CHARS} chars)`);
  }

  // G-AA26: Scan document content for prompt injection before indexing
  const titleMod = moderateInput(body.title.trim());
  if (titleMod.blocked) {
    throw badRequest(`Document title contains disallowed content: ${titleMod.reason}`);
  }
  // Sample the content in 2000-char windows to catch injections in long docs
  const SAMPLE_WINDOW = 2000;
  for (let pos = 0; pos < body.content.length; pos += SAMPLE_WINDOW) {
    const window = body.content.slice(pos, pos + SAMPLE_WINDOW);
    const mod = moderateInput(window);
    if (mod.blocked) {
      throw badRequest(`Document content contains disallowed content: ${mod.reason}`);
    }
  }

  // G-D12: Enforce KB document quota at the API layer (not just the UI)
  const entitlements = new EntitlementsChecker(c.env.PLATFORM_DB);
  const tier = await entitlements.getTenantTier(tenantId);
  const limits = getPlanLimits(tier);
  const countRow = await c.env.PLATFORM_DB.prepare(
    `SELECT COUNT(*) as count FROM kb_documents WHERE space_id = ? AND tenant_id = ? AND status != 'purged'`
  ).bind(spaceId, tenantId).first<{ count: number }>();
  const docCount = countRow?.count ?? 0;
  if (docCount >= limits.kb_documents_per_space) {
    throw Object.assign(
      new Error(`KB document limit (${limits.kb_documents_per_space}) reached for ${tier} plan`),
      { error_code: "quota_exceeded", status: 429 }
    );
  }

  const docId = crypto.randomUUID();
  const now = new Date().toISOString();

  // Insert doc record with status=processing
  await c.env.PLATFORM_DB.prepare(
    `INSERT INTO kb_documents
       (id, space_id, tenant_id, project_id, title, source_url, content_type, status, chunk_count, created_at, updated_at)
     VALUES (?, ?, ?, ?, ?, ?, ?, 'processing', 0, ?, ?)`
  )
    .bind(docId, spaceId, tenantId, projectId, body.title.trim(), body.source_url ?? null, contentType, now, now)
    .run();

  try {
    // ── G-BD01: Sanitize content — strip HTML, detect injection patterns ────
    const parsedContent = contentType === "pdf" ? await parseWithCohere(c.env, body.content, contentType) : body.content;
    const { sanitized: sanitizedContent, injectionDetected } = sanitizeKbContent(parsedContent);
    if (injectionDetected) {
      // Flag in DB but do NOT reject — builders may legitimately document attacks
      await c.env.PLATFORM_DB.prepare(
        `UPDATE kb_documents SET status = 'flagged', updated_at = ? WHERE id = ?`
      ).bind(new Date().toISOString(), docId).run();
      console.warn(`[kb] Injection pattern detected in doc ${docId} for space ${spaceId}`);
    }

    // ── Chunking ────────────────────────────────────────────────────────────
    const chunks = chunkText(sanitizedContent);

    if (chunks.length === 0) {
      // Content too short to chunk — treat as one chunk
      chunks.push(sanitizedContent.trim());
    }
    const coordinates = chunkCoordinates(sanitizedContent, chunks);

    // ── Embedding (batch, 50 chunks per CF AI call) ─────────────────────────
    const EMBED_BATCH_SIZE = 50;
    const allEmbedResults: Array<{ embedding: number[]; tokenCount: number }> = [];

    for (let i = 0; i < chunks.length; i += EMBED_BATCH_SIZE) {
      const batchChunks = chunks.slice(i, i + EMBED_BATCH_SIZE);
      const batchResults = await embedBatch(c.env.AI, batchChunks);
      allEmbedResults.push(...batchResults);
    }

    // ── R2 storage + Vectorize upsert ───────────────────────────────────────
    const vectorUpserts: VectorizeVector[] = [];

    for (let i = 0; i < chunks.length; i++) {
      const chunk = chunks[i];
      const embedResult = allEmbedResults[i];
      const coordinate = coordinates[i];
      if (chunk === undefined || embedResult === undefined || coordinate === undefined) continue;
      const chunkId = `${docId}_chunk_${i}`;
      const contentHash = await sha256Hex(chunk);

      // Store chunk content in R2
      const chunkRecord: ChunkRecord = {
        docId,
        chunkIndex: i,
        content: chunk,
        spaceId,
        tenantId,
        projectId: projectId ?? SPACE_WIDE_PROJECT_SENTINEL,
        visibility: projectId ? "project" : "space",
        requiredRoleRank,
        chunkId,
        contentHash,
        sourceFreshness: now,
        headingPath: [],
        ...coordinate,
      };
      await c.env.KB_BUCKET.put(
        chunkR2Key(spaceId, projectId, docId, i),
        JSON.stringify(chunkRecord),
      );
      await c.env.KB_BUCKET.put(citationR2Key(spaceId, projectId, docId, i), chunk, {
        customMetadata: { contentHash, tenantId, spaceId, projectId: projectId ?? SPACE_WIDE_PROJECT_SENTINEL },
      });

      // Prepare Vectorize vector. project_id always set (never omitted) — Vectorize's flat
      // $eq filter can't distinguish "field absent" from "field present," so the space-wide
      // sentinel (empty string) makes filtering exact both ways (see SPACE_WIDE_PROJECT_SENTINEL).
      vectorUpserts.push({
        id: chunkId,
        values: embedResult.embedding,
        metadata: {
          space_id: spaceId,
          tenant_id: tenantId,
          project_id: projectId ?? SPACE_WIDE_PROJECT_SENTINEL,
          visibility: projectId ? "project" : "space",
          required_role_rank: requiredRoleRank,
          doc_id: docId,
          chunk_id: chunkId,
          content_hash: contentHash,
          source_freshness: now,
          byte_start: coordinate.byteStart,
          byte_end: coordinate.byteEnd,
          line_start: coordinate.lineStart,
          line_end: coordinate.lineEnd,
          chunk_index: i,
          title: body.title.trim(),
          content_preview: chunk.slice(0, 200),
        },
      });
      await c.env.PLATFORM_DB.prepare(
        `INSERT INTO kb_chunks
         (id, tenant_id, space_id, project_id, document_id, chunk_index, content, content_hash,
          visibility, required_role_rank, source_freshness, heading_path, r2_key,
          byte_start, byte_end, line_start, line_end, created_at, deleted_at)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, '[]', ?, ?, ?, ?, ?, ?, NULL)`
      ).bind(chunkId, tenantId, spaceId, projectId ?? SPACE_WIDE_PROJECT_SENTINEL, docId, i,
        chunk, contentHash, projectId ? "project" : "space", requiredRoleRank, now,
        citationR2Key(spaceId, projectId, docId, i), 0, new TextEncoder().encode(chunk).byteLength,
        coordinate.lineStart, coordinate.lineEnd, now).run();
    }

    // Upsert vectors in batches (Vectorize has limits per upsert call)
    const VECTOR_BATCH_SIZE = 100;
    for (let i = 0; i < vectorUpserts.length; i += VECTOR_BATCH_SIZE) {
      const batch = vectorUpserts.slice(i, i + VECTOR_BATCH_SIZE);
      await c.env.KB_VECTORS.upsert(batch);
    }

    // §A1.19: best-effort whole-document mirror for AutoRAG (only written when an instance is
    // configured — cheap, and a failed mirror write never fails ingestion since the legacy
    // pipeline above already succeeded and is the default retrieval path regardless).
    if (c.env.AUTORAG_KB_INSTANCE) {
      try {
        await c.env.KB_BUCKET.put(autoragKbKey(spaceId, projectId, docId), sanitizedContent);
      } catch {
        /* best-effort — legacy retrieval is unaffected */
      }
    }

    // ── Update DB: status=indexed ────────────────────────────────────────────
    await c.env.PLATFORM_DB.prepare(
      `UPDATE kb_documents
       SET status = 'indexed', chunk_count = ?, updated_at = datetime('now')
       WHERE id = ?`
    )
      .bind(chunks.length, docId)
      .run();

    const doc = await c.env.PLATFORM_DB.prepare(
      "SELECT * FROM kb_documents WHERE id = ?"
    )
      .bind(docId)
      .first();

    return c.json(doc, 201);
  } catch (err) {
    // Mark document as failed on any error during processing
    await c.env.PLATFORM_DB.prepare(
      `UPDATE kb_documents SET status = 'failed', updated_at = datetime('now') WHERE id = ?`
    )
      .bind(docId)
      .run()
      .catch(() => {/* best-effort */});

    if (err && typeof err === "object" && "status" in err) throw err;
    throw internalError(`Document ingestion failed: ${err instanceof Error ? err.message : String(err)}`);
  }
});

// ── PATCH /spaces/:spaceId/kb/documents/:docId ───────────────────────────────
// G-X09: Document update must delete old stale vectors before upserting new ones

app.patch("/spaces/:spaceId/kb/documents/:docId", async (c) => {
  const tenantId = requireTenant(c);
  const spaceId = c.req.param("spaceId");
  const docId = c.req.param("docId");

  const body = await c.req.json<{
    title?: string;
    content?: string;
  }>();

  if (!body.title && !body.content) {
    throw badRequest("At least one of title or content is required");
  }

  // Verify ownership and get current state
  const existing = await c.env.PLATFORM_DB.prepare(
    "SELECT id, title, chunk_count, project_id FROM kb_documents WHERE id = ? AND space_id = ? AND tenant_id = ?"
  ).bind(docId, spaceId, tenantId).first<{ id: string; title: string; chunk_count: number; project_id: string | null }>();

  if (!existing) throw notFound("KbDocument");
  const projectId = existing.project_id;

  // If only updating title (no content re-index needed)
  if (body.title && !body.content) {
    const newTitle = body.title.trim();
    const titleMod = moderateInput(newTitle);
    if (titleMod.blocked) throw badRequest(`Title contains disallowed content: ${titleMod.reason}`);

    await c.env.PLATFORM_DB.prepare(
      "UPDATE kb_documents SET title = ?, updated_at = datetime('now') WHERE id = ?"
    ).bind(newTitle, docId).run();

    const updated = await c.env.PLATFORM_DB.prepare("SELECT * FROM kb_documents WHERE id = ?").bind(docId).first();
    return c.json(updated, 200);
  }

  const newContent = body.content!;
  const newTitle = body.title?.trim() ?? existing.title;

  // G-AA26: Scan updated content for injection
  const titleMod = moderateInput(newTitle);
  if (titleMod.blocked) throw badRequest(`Title contains disallowed content: ${titleMod.reason}`);
  const SAMPLE_WINDOW = 2000;
  for (let pos = 0; pos < newContent.length; pos += SAMPLE_WINDOW) {
    const win = newContent.slice(pos, pos + SAMPLE_WINDOW);
    const mod = moderateInput(win);
    if (mod.blocked) throw badRequest(`Content contains disallowed content: ${mod.reason}`);
  }

  const MAX_CONTENT_CHARS = 1_048_576;
  if (newContent.length > MAX_CONTENT_CHARS) {
    throw badRequest(`content exceeds maximum size of 1MB`);
  }

  // Mark as re-processing
  await c.env.PLATFORM_DB.prepare(
    "UPDATE kb_documents SET status = 'processing', updated_at = datetime('now') WHERE id = ?"
  ).bind(docId).run();

  try {
    // G-X09: Delete ALL old vectors before re-indexing to prevent stale accumulation
    const oldChunkCount = existing.chunk_count ?? 0;
    if (oldChunkCount > 0) {
      const oldVectorIds: string[] = [];
      for (let i = 0; i < oldChunkCount; i++) oldVectorIds.push(`${docId}_chunk_${i}`);
      const VECTOR_DELETE_BATCH = 100;
      for (let i = 0; i < oldVectorIds.length; i += VECTOR_DELETE_BATCH) {
        await c.env.KB_VECTORS.deleteByIds(oldVectorIds.slice(i, i + VECTOR_DELETE_BATCH));
      }
    }
    await c.env.PLATFORM_DB.prepare(
      "DELETE FROM kb_chunks WHERE document_id=? AND tenant_id=? AND space_id=? AND project_id=?"
    ).bind(docId, tenantId, spaceId, projectId ?? SPACE_WIDE_PROJECT_SENTINEL).run();

    // Delete old R2 chunks
    const prefix = docR2Prefix(spaceId, projectId, docId);
    let cursor: string | undefined;
    do {
      const listOpts: R2ListOptions = cursor !== undefined ? { prefix, cursor } : { prefix };
      const listed: R2Objects = await c.env.KB_BUCKET.list(listOpts);
      if (listed.objects.length > 0) {
        await Promise.all(listed.objects.map(o => c.env.KB_BUCKET.delete(o.key)));
      }
      cursor = listed.truncated ? listed.cursor : undefined;
    } while (cursor);

    // Re-chunk and re-embed
    const chunks = chunkText(newContent);
    if (chunks.length === 0) chunks.push(newContent.trim());
    const coordinates = chunkCoordinates(newContent, chunks);
    const indexedAt = new Date().toISOString();

    const EMBED_BATCH_SIZE = 50;
    const allEmbedResults: Array<{ embedding: number[]; tokenCount: number }> = [];
    for (let i = 0; i < chunks.length; i += EMBED_BATCH_SIZE) {
      const batchResults = await embedBatch(c.env.AI, chunks.slice(i, i + EMBED_BATCH_SIZE));
      allEmbedResults.push(...batchResults);
    }

    const vectorUpserts: VectorizeVector[] = [];
    for (let i = 0; i < chunks.length; i++) {
      const chunk = chunks[i];
      const embedResult = allEmbedResults[i];
      const coordinate = coordinates[i];
      if (chunk === undefined || embedResult === undefined || coordinate === undefined) continue;
      const chunkId = `${docId}_chunk_${i}`;
      const contentHash = await sha256Hex(chunk);

      await c.env.KB_BUCKET.put(
        chunkR2Key(spaceId, projectId, docId, i),
        JSON.stringify({ docId, chunkIndex: i, content: chunk, spaceId, tenantId,
          projectId: projectId ?? SPACE_WIDE_PROJECT_SENTINEL, visibility: projectId ? "project" : "space",
          requiredRoleRank: 0, chunkId, contentHash, sourceFreshness: indexedAt, headingPath: [], ...coordinate } satisfies ChunkRecord)
      );
      await c.env.KB_BUCKET.put(citationR2Key(spaceId, projectId, docId, i), chunk, {
        customMetadata: { contentHash, tenantId, spaceId, projectId: projectId ?? SPACE_WIDE_PROJECT_SENTINEL },
      });
      await c.env.PLATFORM_DB.prepare(
        `INSERT INTO kb_chunks (id,tenant_id,space_id,project_id,document_id,chunk_index,content,
         content_hash,visibility,required_role_rank,source_freshness,heading_path,r2_key,byte_start,
         byte_end,line_start,line_end,created_at,deleted_at) VALUES (?,?,?,?,?,?,?,?,?,0,?,'[]',?,?,?,?,?,?,NULL)`
      ).bind(chunkId, tenantId, spaceId, projectId ?? SPACE_WIDE_PROJECT_SENTINEL, docId, i, chunk,
        contentHash, projectId ? "project" : "space", indexedAt, citationR2Key(spaceId, projectId, docId, i),
        0, new TextEncoder().encode(chunk).byteLength, coordinate.lineStart, coordinate.lineEnd, indexedAt).run();

      vectorUpserts.push({
        id: chunkId,
        values: embedResult.embedding,
        metadata: {
          space_id: spaceId,
          tenant_id: tenantId,
          project_id: projectId ?? SPACE_WIDE_PROJECT_SENTINEL,
          required_role_rank: 0,
          content_hash: contentHash,
          doc_id: docId,
          chunk_index: i,
          title: newTitle,
          content_preview: chunk.slice(0, 200),
        },
      });
    }

    const VECTOR_BATCH_SIZE = 100;
    for (let i = 0; i < vectorUpserts.length; i += VECTOR_BATCH_SIZE) {
      await c.env.KB_VECTORS.upsert(vectorUpserts.slice(i, i + VECTOR_BATCH_SIZE));
    }

    // §A1.19: keep the AutoRAG mirror in sync with the re-indexed content (best-effort, same
    // posture as the POST route's mirror write).
    if (c.env.AUTORAG_KB_INSTANCE) {
      try {
        await c.env.KB_BUCKET.put(autoragKbKey(spaceId, projectId, docId), newContent);
      } catch {
        /* best-effort — legacy retrieval is unaffected */
      }
    }

    await c.env.PLATFORM_DB.prepare(
      "UPDATE kb_documents SET status = 'indexed', title = ?, chunk_count = ?, updated_at = datetime('now') WHERE id = ?"
    ).bind(newTitle, chunks.length, docId).run();

    const updated = await c.env.PLATFORM_DB.prepare("SELECT * FROM kb_documents WHERE id = ?").bind(docId).first();
    return c.json(updated, 200);
  } catch (err) {
    await c.env.PLATFORM_DB.prepare(
      "UPDATE kb_documents SET status = 'failed', updated_at = datetime('now') WHERE id = ?"
    ).bind(docId).run().catch(() => {});
    throw internalError(`Document update failed: ${err instanceof Error ? err.message : String(err)}`);
  }
});

// ── DELETE /spaces/:spaceId/kb/documents/:docId ───────────────────────────────

app.delete("/spaces/:spaceId/kb/documents/:docId", async (c) => {
  const tenantId = requireTenant(c);
  const spaceId = c.req.param("spaceId");
  const docId = c.req.param("docId");

  // Verify ownership
  const doc = await c.env.PLATFORM_DB.prepare(
    "SELECT id, chunk_count, project_id FROM kb_documents WHERE id = ? AND space_id = ? AND tenant_id = ?"
  )
    .bind(docId, spaceId, tenantId)
    .first<{ id: string; chunk_count: number; project_id: string | null }>();

  if (!doc) throw notFound("KbDocument");

  const chunkCount = doc.chunk_count ?? 0;

  // ── Delete Vectorize vectors ──────────────────────────────────────────────
  // Build vector IDs directly from doc + chunk count (we stored them as {docId}_chunk_{i})
  if (chunkCount > 0) {
    const vectorIds: string[] = [];
    for (let i = 0; i < chunkCount; i++) {
      vectorIds.push(`${docId}_chunk_${i}`);
    }
    // Delete in batches of 100
    const VECTOR_DELETE_BATCH = 100;
    for (let i = 0; i < vectorIds.length; i += VECTOR_DELETE_BATCH) {
      const batch = vectorIds.slice(i, i + VECTOR_DELETE_BATCH);
      await c.env.KB_VECTORS.deleteByIds(batch);
    }
  }

  // ── Delete R2 objects ─────────────────────────────────────────────────────
  const prefix = docR2Prefix(spaceId, doc.project_id, docId);
  let cursor: string | undefined;
  do {
    const listOpts: R2ListOptions = cursor !== undefined ? { prefix, cursor } : { prefix };
    const listed: R2Objects = await c.env.KB_BUCKET.list(listOpts);
    const keys = listed.objects.map(o => o.key);
    if (keys.length > 0) {
      // R2 doesn't have a batch delete — delete in parallel
      await Promise.all(keys.map(k => c.env.KB_BUCKET.delete(k)));
    }
    cursor = listed.truncated ? listed.cursor : undefined;
  } while (cursor);

  // §A1.19: the AutoRAG mirror lives at a separate `autorag/` prefix (not under docR2Prefix
  // above, since it's one whole-document file rather than per-chunk records) — delete it
  // explicitly, best-effort, so a purged document doesn't stay searchable via AutoRAG.
  if (c.env.AUTORAG_KB_INSTANCE) {
    await c.env.KB_BUCKET.delete(autoragKbKey(spaceId, doc.project_id, docId)).catch(() => {
      /* best-effort */
    });
  }

  // ── Delete DB record ──────────────────────────────────────────────────────
  await c.env.PLATFORM_DB.prepare(
    "DELETE FROM kb_documents WHERE id = ?"
  )
    .bind(docId)
    .run();
  await c.env.PLATFORM_DB.prepare(
    "DELETE FROM kb_chunks WHERE document_id=? AND tenant_id=? AND space_id=? AND project_id=?"
  ).bind(docId, tenantId, spaceId, doc.project_id ?? SPACE_WIDE_PROJECT_SENTINEL).run();

  return new Response(null, { status: 204 });
});

// Canonical citation resolver. Neither model nor browser supplies an R2 key: the key and range
// are loaded from the immutable chunk record after tenant/project/role authorization.
app.get("/spaces/:spaceId/projects/:projectId/citations/:documentId/:chunkId", async (c) => {
  const tenantId = requireTenant(c);
  const spaceId = c.req.param("spaceId");
  const projectId = c.req.param("projectId");
  const userId = c.req.header("x-naelao-user-id") ?? "";
  const roleRank = effectiveRoleRank(c);
  const scope = { tenantId, spaceId, projectId, roleRank };
  if (!(await authorizeProject(c.env.PLATFORM_DB, scope, userId))) throw notFound("Citation not found");
  const row = await c.env.PLATFORM_DB.prepare(
    `SELECT id, document_id, r2_key, content_hash, byte_start, byte_end, line_start, line_end
     FROM kb_chunks WHERE id=? AND document_id=? AND tenant_id=? AND space_id=? AND project_id=?
       AND required_role_rank<=? AND deleted_at IS NULL`
  ).bind(c.req.param("chunkId"), c.req.param("documentId"), tenantId, spaceId, projectId, roleRank)
    .first<Record<string, unknown>>();
  if (!row) throw notFound("Citation not found");
  const head = await c.env.KB_BUCKET.head(String(row.r2_key));
  if (!head) throw notFound("Citation not found");
  const coordinate = verifyCitationCoordinate({ r2Key: String(row.r2_key), byteStart: Number(row.byte_start),
    byteEnd: Number(row.byte_end), lineStart: Number(row.line_start), lineEnd: Number(row.line_end) },
    { r2Key: String(row.r2_key), size: head.size, lineCount: Number(row.line_end) });
  if (head.customMetadata?.contentHash !== String(row.content_hash)) throw notFound("Citation not found");
  const object = await c.env.KB_BUCKET.get(coordinate.r2Key, {
    range: { offset: coordinate.byteStart, length: coordinate.byteEnd - coordinate.byteStart },
  });
  if (!object) throw notFound("Citation not found");
  const content = await object.text();
  if (await sha256Hex(content) !== String(row.content_hash)) throw notFound("Citation not found");
  return c.json({ citation: { version: 1, identity: `${row.document_id}:${row.id}:${row.content_hash}`,
    document_id: row.document_id, chunk_id: row.id, content_hash: row.content_hash,
    byte_start: coordinate.byteStart, byte_end: coordinate.byteEnd, line_start: coordinate.lineStart,
    line_end: coordinate.lineEnd }, content });
});

// ── GET /spaces/:spaceId/kb/search ────────────────────────────────────────────

app.get("/spaces/:spaceId/kb/search", async (c) => {
  const tenantId = requireTenant(c);
  const spaceId = c.req.param("spaceId");
  const url = new URL(c.req.url);
  const query = url.searchParams.get("q");
  const topK = Math.min(parseInt(url.searchParams.get("top_k") ?? "10", 10), 50);
  // WS-4: no project_id param = the pre-existing default, search space-wide documents only —
  // never silently mixes in a project's own isolated KB.
  const projectId = url.searchParams.get("project_id");
  // §A1.19: opt-in per request (the caller — e.g. the knowledge-base prebuilt or dashboard —
  // decides), not a stored per-space policy. Falls back to the legacy hybrid pipeline whenever
  // AutoRAG isn't configured on this worker, even if the caller asked for it — never a hard
  // error for an unconfigured optional integration.
  const useAutoRag = url.searchParams.get("retrieval_mode") === "autorag" && Boolean(c.env.AUTORAG_KB_INSTANCE);

  if (!query || query.trim().length === 0) {
    throw badRequest("q parameter is required");
  }

  const roleRank = effectiveRoleRank(c);
  const userId = c.req.header("x-naelao-user-id") ?? "";
  const scope: RetrievalScope = {
    tenantId,
    spaceId,
    projectId: projectId ?? SPACE_WIDE_PROJECT_SENTINEL,
    roleRank,
  };
  if (projectId && !(await authorizeProject(c.env.PLATFORM_DB, scope, userId))) {
    // Conceal absent and inaccessible private projects identically.
    throw notFound("Project not found");
  }
  const policyVersion = c.env.RETRIEVAL_POLICY_VERSION ?? "1";
  const mode = useAutoRag ? "autorag" : "hybrid";
  const namespace = `${tenantId}:${spaceId}:${scope.projectId}:${roleRank}:${mode}:${policyVersion}`;
  const telemetry: Record<string, number> = {};
  const timed = async <T>(name: string, operation: () => Promise<T>): Promise<T> => {
    const started = performance.now();
    try { return await operation(); }
    finally { telemetry[name] = performance.now() - started; }
  };
  const rowToHit = (row: Record<string, unknown>, score: number): GroundedSearchHit => ({
    id: String(row.id), score, content: String(row.content), r2Key: String(row.r2_key),
    byteStart: Number(row.byte_start), byteEnd: Number(row.byte_end),
    lineStart: Number(row.line_start), lineEnd: Number(row.line_end), title: String(row.title ?? ""),
  });
  const result = await googleModeSearch(query.trim(), scope, {
    now: Date.now,
    cache: {
      lookup: async (q, _scope, nowMs) => timed("cache_lookup_ms", async () => {
        const key = `grounded:${await sha256Hex(`${namespace}:${q}`)}`;
        const value = await c.env.KB_CACHE.get(key, "json") as { createdAt: number; expiresAt: number; hits: GroundedSearchHit[] } | null;
        if (!value) return null;
        if (value.expiresAt <= nowMs || value.createdAt > nowMs) { await c.env.KB_CACHE.delete(key); return null; }
        return value;
      }),
      store: async (q, _scope, hits, expiresAt) => {
        if (!hits.length) return;
        const key = `grounded:${await sha256Hex(`${namespace}:${q}`)}`;
        await safeKvPut(c.env.KB_CACHE, key, JSON.stringify({ createdAt: Date.now(), expiresAt, hits }), { expirationTtl: 3600 });
      },
    },
    dense: async (q, scoped) => timed("dense_search_ms", async () => {
      const embedded = await timed("embedding_ms", () => embedText(c.env.AI, q));
      const found = await c.env.KB_VECTORS.query(embedded.embedding, {
        topK: topK * 2,
        filter: {
          tenant_id: { $eq: scoped.tenantId }, space_id: { $eq: scoped.spaceId },
          project_id: { $eq: scoped.projectId }, required_role_rank: { $lte: scoped.roleRank },
        },
        returnMetadata: "indexed",
      });
      const ids = (found.matches ?? []).map((m) => m.id);
      if (!ids.length) return [];
      const placeholders = ids.map(() => "?").join(",");
      const rows = await c.env.PLATFORM_DB.prepare(
        `SELECT k.*, d.title FROM kb_chunks k JOIN kb_documents d ON d.id=k.document_id
         WHERE k.id IN (${placeholders}) AND k.tenant_id=? AND k.space_id=? AND k.project_id=?
           AND k.required_role_rank<=? AND k.deleted_at IS NULL`
      ).bind(...ids, scoped.tenantId, scoped.spaceId, scoped.projectId, scoped.roleRank).all<Record<string, unknown>>();
      const byId = new Map(rows.results.map((row) => [String(row.id), row]));
      return (found.matches ?? []).flatMap((match) => {
        const row = byId.get(match.id); return row ? [rowToHit(row, match.score ?? 0)] : [];
      });
    }),
    // Sparse retrieval searches the entire authorized FTS corpus, never only dense candidates.
    sparse: async (q, scoped) => timed("sparse_search_ms", async () => {
      const rows = await c.env.PLATFORM_DB.prepare(
        `SELECT k.*, d.title, bm25(kb_chunks_fts) AS rank FROM kb_chunks_fts f
         JOIN kb_chunks k ON k.rowid=f.rowid JOIN kb_documents d ON d.id=k.document_id
         WHERE kb_chunks_fts MATCH ? AND k.tenant_id=? AND k.space_id=? AND k.project_id=?
           AND k.required_role_rank<=? AND k.deleted_at IS NULL ORDER BY rank LIMIT ?`
      ).bind(q, scoped.tenantId, scoped.spaceId, scoped.projectId, scoped.roleRank, topK * 2).all<Record<string, unknown>>();
      return rows.results.map((row, index) => rowToHit(row, 1 / (index + 1)));
    }),
    web: async (q, scoped) => timed("web_grounding_ms", async () => {
      if (!c.env.TAVILY_API_KEY) return [];
      const response = await fetch(TAVILY_SEARCH_URL, { method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ api_key: c.env.TAVILY_API_KEY, query: q, max_results: Math.min(topK, 5), search_depth: "basic" }) });
      if (!response.ok) return [];
      // Web excerpts stay external/untrusted until separately ingested. They deliberately receive
      // no fake internal R2 coordinates or citation identity.
      const data = await response.json<{ results?: TavilyResult[] }>();
      return (data.results ?? []).map((item, index) => ({ id: `web:${index}`, score: item.score ?? 0,
        content: item.content ?? "", r2Key: "", byteStart: 0, byteEnd: 0, title: item.title ?? "" }));
    }),
    emitTelemetry: (event) => {
      const payload = { ...event, ...telemetry, retrieval_mode: mode, result_count: 0 };
      c.env.KNOWLEDGE_ANALYTICS?.writeDataPoint({ blobs: [tenantId, spaceId, scope.projectId, JSON.stringify(payload)], doubles: [event.latencyMs, event.confidence] });
      console.log(JSON.stringify({ event: "knowledge.retrieval", ...payload }));
    },
  }, { confidenceThreshold: Number(c.env.RETRIEVAL_CONFIDENCE_THRESHOLD ?? "0.8"), limit: topK });

  const data = result.hits.map((hit) => ({
    chunk_id: hit.id, content: contextEnvelope(hit), score: hit.score,
    citation: hit.r2Key ? { document_id: hit.id.split("_chunk_")[0], chunk_id: hit.id,
      content_hash: undefined, byte_start: hit.byteStart, byte_end: hit.byteEnd,
      line_start: hit.lineStart, line_end: hit.lineEnd } : null,
  }));
  return c.json({ data, cached: result.cacheHit, retrieval_mode: mode, confidence: result.confidence,
    live_grounding: result.liveGrounding, latency_ms: result.latencyMs });
});

// ── G-AZ19: Semantic Response Cache ──────────────────────────────────────────
// Endpoint: POST /internal/semantic-cache/lookup
//   Body: { query: string, spaceId: string }
//   Returns: { hit: true, response: string, cache_id: string } | { hit: false }
//
// Endpoint: POST /internal/semantic-cache/store
//   Body: { query: string, spaceId: string, response: string }
//   Returns: { stored: true, cache_id: string }
//
// Endpoint: DELETE /internal/semantic-cache
//   Query: ?spaceId=xxx
//   Returns: { invalidated: true }

const SEMANTIC_CACHE_SIMILARITY_THRESHOLD = 0.97;
const SEMANTIC_CACHE_TTL_SECS = 24 * 60 * 60;

// A1.16.9 (layer-3 backstop): these routes had NO auth check at all — not even a truthy
// header, just an open POST/DELETE anyone reaching this worker could call. Covers lookup,
// store, and the DELETE invalidation route below (prefix wildcard).
app.use("/internal/semantic-cache/*", requireInternalHmac((c) => (c as unknown as { env: KnowledgeEnv }).env.PLATFORM_SECRET));

app.post("/internal/semantic-cache/lookup", async (c) => {
  const body = await c.req.json<{ query: string; spaceId: string }>();
  if (!body.query || !body.spaceId) {
    return c.json({ error: "query and spaceId required" }, 400);
  }

  // Fail open if Vectorize binding not available (optional binding)
  if (!c.env.SEMANTIC_CACHE_VECTORS || !c.env.SEMANTIC_CACHE_KV) {
    return c.json({ hit: false });
  }

  try {
    const embedding = await embedText(c.env.AI, body.query);

    const results = await c.env.SEMANTIC_CACHE_VECTORS.query(embedding.embedding, {
      topK: 1,
      filter: { space_id: { $eq: body.spaceId } },
      returnMetadata: "indexed",
    });

    const top = results.matches?.[0];
    if (!top || (top.score ?? 0) < SEMANTIC_CACHE_SIMILARITY_THRESHOLD) {
      return c.json({ hit: false });
    }

    const cacheId = top.id;
    const metadata = top.metadata as Record<string, unknown> | undefined;
    const expiresAt = metadata?.["expires_at"] as number | undefined;

    // Check if expired (Vectorize has no TTL — checked via metadata)
    if (expiresAt && expiresAt < Date.now()) {
      // Async cleanup of stale vector — don't block response
      c.executionCtx.waitUntil(c.env.SEMANTIC_CACHE_VECTORS.deleteByIds([cacheId]));
      return c.json({ hit: false });
    }

    const cachedResponse = await c.env.SEMANTIC_CACHE_KV.get(`sc:${cacheId}`);
    if (!cachedResponse) {
      return c.json({ hit: false });
    }

    console.log(`[SemanticCache] HIT spaceId=${body.spaceId} similarity=${top.score?.toFixed(4)} cacheId=${cacheId}`);
    return c.json({ hit: true, response: cachedResponse, cache_id: cacheId, similarity: top.score });
  } catch (err) {
    // Fail open on cache errors — never block the main request
    console.warn(`[SemanticCache] Lookup error: ${err}`);
    return c.json({ hit: false });
  }
});

app.post("/internal/semantic-cache/store", async (c) => {
  const body = await c.req.json<{ query: string; spaceId: string; response: string }>();
  if (!body.query || !body.spaceId || !body.response) {
    return c.json({ error: "query, spaceId, and response required" }, 400);
  }

  if (!c.env.SEMANTIC_CACHE_VECTORS || !c.env.SEMANTIC_CACHE_KV) {
    return c.json({ stored: false, reason: "semantic cache not configured" });
  }

  try {
    const cacheId = crypto.randomUUID();
    const embedding = await embedText(c.env.AI, body.query);
    const expiresAt = Date.now() + SEMANTIC_CACHE_TTL_SECS * 1000;

    await c.env.SEMANTIC_CACHE_VECTORS.upsert([{
      id: cacheId,
      values: embedding.embedding,
      metadata: {
        space_id: body.spaceId,
        expires_at: expiresAt,
      },
    }]);

    await c.env.SEMANTIC_CACHE_KV.put(`sc:${cacheId}`, body.response, {
      expirationTtl: SEMANTIC_CACHE_TTL_SECS,
    });

    console.log(`[SemanticCache] STORED spaceId=${body.spaceId} cacheId=${cacheId}`);
    return c.json({ stored: true, cache_id: cacheId });
  } catch (err) {
    console.warn(`[SemanticCache] Store error: ${err}`);
    return c.json({ stored: false, reason: String(err) });
  }
});

// Invalidate all semantic cache entries for a space (called on KB update)
app.delete("/internal/semantic-cache", async (c) => {
  const spaceId = c.req.query("spaceId");
  if (!spaceId) return c.json({ error: "spaceId required" }, 400);

  if (!c.env.SEMANTIC_CACHE_VECTORS || !c.env.SEMANTIC_CACHE_KV) {
    return c.json({ invalidated: true, count: 0 });
  }

  try {
    // Fetch all vectors for this space using a dummy query (get any embedding)
    const dummyEmbed = await embedText(c.env.AI, "cache invalidation");
    const toDelete = await c.env.SEMANTIC_CACHE_VECTORS.query(dummyEmbed.embedding, {
      topK: 1000,
      filter: { space_id: { $eq: spaceId } },
      returnMetadata: "none",
    });

    const ids = toDelete.matches?.map(m => m.id) ?? [];
    if (ids.length > 0) {
      await c.env.SEMANTIC_CACHE_VECTORS.deleteByIds(ids);
      // Also delete from KV
      await Promise.all(ids.map(id => c.env.SEMANTIC_CACHE_KV.delete(`sc:${id}`)));
    }

    console.log(`[SemanticCache] Invalidated ${ids.length} entries for spaceId=${spaceId}`);
    return c.json({ invalidated: true, count: ids.length });
  } catch (err) {
    console.warn(`[SemanticCache] Invalidation error: ${err}`);
    return c.json({ invalidated: false, error: String(err) });
  }
});

// ── UNIVERSAL / PLATFORM-PROVIDED web search (CLAUDE.md "universal tools") ──────
//
// Web search is bundled by Naelao exactly like Claude/ChatGPT bundle it: the platform holds ONE
// provider key (TAVILY_API_KEY, a Workers Secret) and every agent gets search for free. This is
// the `commerce`/`together-ai` platform-key precedent, NOT the BYO-key `space_credentials` model
// (which is only for a builder's OWN external accounts). The key never leaves this worker — the
// calling isolate only ever sees normalized results.
//
//   POST /internal/web-search/search    { query, max_results? }  → { configured, results[], answer? }
//   POST /internal/web-search/fetch     { url }                  → { url, status, content }
//   POST /internal/web-search/extract   { url, schema? }         → { configured, url, content }
//   POST /internal/web-search/download  { url }                  → { url, status, content, size, truncated }
//
// `search`/`extract` need the provider key and report `configured:false` when it is unset rather
// than faking empty results. `fetch`/`download` are keyless SSRF-guarded GETs and work out of the
// box — `download` is the higher-cap, save-don't-read variant (see its own comment).

const TAVILY_SEARCH_URL = "https://api.tavily.com/search";
const TAVILY_EXTRACT_URL = "https://api.tavily.com/extract";
// Cap fetched/extracted page text so one call can't blow the isolate's memory or the sub-request
// response budget — matches the platform's general "bounded text" convention.
const WEB_SEARCH_CONTENT_CAP = 100_000;

app.use("/internal/web-search/*", requireInternalHmac((c) => (c as unknown as { env: KnowledgeEnv }).env.PLATFORM_SECRET));

interface TavilyResult {
  title?: string;
  url?: string;
  content?: string;
  score?: number;
}

app.post("/internal/web-search/search", async (c) => {
  const body = await c.req.json<{ query?: string; max_results?: number }>().catch(() => ({} as { query?: string; max_results?: number }));
  const query = (body.query ?? "").trim();
  if (!query) return c.json({ error_code: "bad_request", message: "query required" }, 400);

  // Honest degradation: no platform key → report unconfigured, don't fake empty results.
  if (!c.env.TAVILY_API_KEY) {
    return c.json({ configured: false, results: [], message: "platform web search is not configured" });
  }

  const maxResults = Math.min(Math.max(typeof body.max_results === "number" ? body.max_results : 10, 1), 20);
  try {
    const resp = await fetch(TAVILY_SEARCH_URL, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        api_key: c.env.TAVILY_API_KEY,
        query,
        max_results: maxResults,
        search_depth: "basic",
        include_answer: true,
      }),
    });
    if (!resp.ok) {
      return c.json({ configured: true, results: [], error: `search provider error (${resp.status})` }, 502);
    }
    const data = await resp.json<{ answer?: string; results?: TavilyResult[] }>();
    const results = (data.results ?? []).map((r) => ({
      title: r.title ?? "",
      url: r.url ?? "",
      content: (r.content ?? "").slice(0, WEB_SEARCH_CONTENT_CAP),
      score: r.score ?? 0,
    }));
    return c.json({ configured: true, query, results, answer: data.answer ?? null });
  } catch (err) {
    return c.json({ configured: true, results: [], error: String(err) }, 502);
  }
});

app.post("/internal/web-search/fetch", async (c) => {
  const body = await c.req.json<{ url?: string }>().catch(() => ({} as { url?: string }));
  const rawUrl = (body.url ?? "").trim();
  if (!rawUrl) return c.json({ error_code: "bad_request", message: "url required" }, 400);

  // SSRF guard (DoH resolution) — the agent can pass any URL, so re-check at fetch time, exactly
  // like mcp-hub/browser do. Keyless: page fetch is a universal capability regardless of provider.
  const ssrf = await checkSsrf(rawUrl);
  if (ssrf.blocked) return c.json({ error_code: "forbidden", message: ssrf.reason ?? "url failed SSRF validation" }, 403);

  try {
    const resp = await fetch(rawUrl, { headers: { "user-agent": "naelao-agent/1.0" }, redirect: "follow" });
    const text = (await resp.text()).slice(0, WEB_SEARCH_CONTENT_CAP);
    return c.json({ url: rawUrl, status: resp.status, content: text });
  } catch (err) {
    return c.json({ url: rawUrl, status: 0, content: "", error: String(err) }, 502);
  }
});

app.post("/internal/web-search/extract", async (c) => {
  const body = await c.req.json<{ url?: string; schema?: unknown }>().catch(() => ({} as { url?: string }));
  const rawUrl = (body.url ?? "").trim();
  if (!rawUrl) return c.json({ error_code: "bad_request", message: "url required" }, 400);

  const ssrf = await checkSsrf(rawUrl);
  if (ssrf.blocked) return c.json({ error_code: "forbidden", message: ssrf.reason ?? "url failed SSRF validation" }, 403);

  // Prefer the provider's clean extraction; without a platform key fall back to a keyless
  // SSRF-guarded raw fetch so extract still returns *something* usable rather than nothing.
  if (c.env.TAVILY_API_KEY) {
    try {
      const resp = await fetch(TAVILY_EXTRACT_URL, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ api_key: c.env.TAVILY_API_KEY, urls: [rawUrl] }),
      });
      if (resp.ok) {
        const data = await resp.json<{ results?: Array<{ url?: string; raw_content?: string }> }>();
        const first = data.results?.[0];
        if (first) {
          return c.json({ configured: true, url: rawUrl, content: (first.raw_content ?? "").slice(0, WEB_SEARCH_CONTENT_CAP) });
        }
      }
    } catch {
      // fall through to the keyless raw-fetch fallback
    }
  }

  try {
    const resp = await fetch(rawUrl, { headers: { "user-agent": "naelao-agent/1.0" }, redirect: "follow" });
    const text = (await resp.text()).slice(0, WEB_SEARCH_CONTENT_CAP);
    return c.json({ configured: Boolean(c.env.TAVILY_API_KEY), url: rawUrl, content: text });
  } catch (err) {
    return c.json({ configured: Boolean(c.env.TAVILY_API_KEY), url: rawUrl, content: "", error: String(err) }, 502);
  }
});

// A DIFFERENT shape from /fetch and /extract on purpose: those two are meant to be read directly
// (small, capped at WEB_SEARCH_CONTENT_CAP, returned straight into the reasoning payload). This
// one is meant to be SAVED — a real download the agent's own downloads/ prebuilt op writes to R2
// rather than reading into context, so a much larger cap is safe here.
//
// Binary is FIRST-CLASS here, not a refusal. An earlier revision rejected any binary content-type
// with a 415 on the reasoning that a `.text()` decode of binary bytes produces mojibake — true,
// but the conclusion was wrong: the fix is to stop calling `.text()`, not to stop accepting PDFs
// and images, which are exactly what "download a file" means. Bytes are read once as an
// ArrayBuffer and returned base64 when they aren't text, and the prebuilt writes the real decoded
// bytes to R2.
//
// Text keeps a truncating cap (a partial CSV still has value). Binary does NOT truncate — half a
// PDF is not a smaller PDF, it is a corrupt file — so an oversized binary is refused outright with
// its real size named, which is actionable, rather than silently written as garbage.
const WEB_DOWNLOAD_CONTENT_CAP = 2_000_000;
const WEB_DOWNLOAD_BINARY_CAP = 12_000_000;

/**
 * Base64 a byte array without `String.fromCharCode(...bytes)`, which blows the call stack once the
 * array is large (the same trap already hit and fixed once in the browser worker's screenshot
 * path). Chunked rather than reaching for `Buffer`, which this worker's tsconfig does not type.
 */
function bytesToBase64(bytes: Uint8Array): string {
  const CHUNK = 0x8000;
  let binary = "";
  for (let i = 0; i < bytes.length; i += CHUNK) {
    binary += String.fromCharCode(...bytes.subarray(i, i + CHUNK));
  }
  return btoa(binary);
}

/** Text-ish content types that are safe and useful to hand back as a string. */
function isTextualContentType(contentType: string): boolean {
  const ct = contentType.toLowerCase();
  if (ct.startsWith("text/")) return true;
  return /^application\/(json|xml|javascript|x-ndjson|ld\+json|graphql|x-yaml|yaml)\b/.test(ct)
    || /\+(json|xml)\b/.test(ct);
}

app.post("/internal/web-search/download", async (c) => {
  const body = await c.req.json<{ url?: string }>().catch(() => ({} as { url?: string }));
  const rawUrl = (body.url ?? "").trim();
  if (!rawUrl) return c.json({ error_code: "bad_request", message: "url required" }, 400);

  const ssrf = await checkSsrf(rawUrl);
  if (ssrf.blocked) return c.json({ error_code: "forbidden", message: ssrf.reason ?? "url failed SSRF validation" }, 403);

  try {
    const resp = await fetch(rawUrl, { headers: { "user-agent": "naelao-agent/1.0" }, redirect: "follow" });
    const contentType = (resp.headers.get("content-type") ?? "").split(";")[0]!.trim();
    // Read the bytes ONCE. A body can only be consumed a single time, so the text-vs-binary
    // decision has to happen against the buffer, never by re-reading the response.
    const buf = await resp.arrayBuffer();
    const bytes = new Uint8Array(buf);

    if (isTextualContentType(contentType)) {
      const full = new TextDecoder().decode(bytes);
      const truncated = full.length > WEB_DOWNLOAD_CONTENT_CAP;
      return c.json({
        url: rawUrl, status: resp.status, encoding: "text", content_type: contentType || "text/plain",
        content: full.slice(0, WEB_DOWNLOAD_CONTENT_CAP),
        size: full.length, truncated,
      });
    }

    if (bytes.byteLength > WEB_DOWNLOAD_BINARY_CAP) {
      return c.json({
        url: rawUrl, status: resp.status, content: null, content_type: contentType,
        error: `file is ${bytes.byteLength} bytes, over the ${WEB_DOWNLOAD_BINARY_CAP}-byte download limit. Binary files are not truncated because a partial file is corrupt.`,
      }, 413);
    }
    // Buffer (nodejs_compat is on for this worker) rather than String.fromCharCode(...bytes),
    // which blows the call stack on a large array — the same trap already hit and fixed once in
    // the browser worker's screenshot path.
    return c.json({
      url: rawUrl, status: resp.status, encoding: "base64",
      content_type: contentType || "application/octet-stream",
      content: bytesToBase64(bytes),
      size: bytes.byteLength, truncated: false,
    });
  } catch (err) {
    return c.json({ url: rawUrl, status: 0, content: null, error: String(err) }, 502);
  }
});

// ── Error handler ─────────────────────────────────────────────────────────────

app.onError((err, c) => errorResponse(err, c.get("requestId") ?? "unknown"));

// ── 404 catch-all ─────────────────────────────────────────────────────────────

app.notFound((c) =>
  c.json({ error_code: "not_found", message: "Route not found" }, 404)
);

export default { fetch: app.fetch } satisfies ExportedHandler<KnowledgeEnv>;
</file>

<file path="workers/mcp-hub/src/index.ts">
// G-I17: MCP Tool Server Registry — registers MCP servers per Space and proxies tool calls
import { Hono } from "hono";
import { errorResponse, requestId, requireInternalHmac, mintInternalToken } from "@naelao/http";
import { checkSsrf } from "@naelao/security";
import { scrubEgressPayload } from "@naelao/agent-sdk";

export interface Env {
  ENVIRONMENT: string;
  PLATFORM_SECRET: string;
  PLATFORM_DB: D1Database;
  /** Credentials worker — resolves auth_secret_name → plaintext at call time (never stored here). */
  CREDENTIALS_WORKER?: Fetcher;
  /** Spec G-BF02 (universal-tools doctrine): PLATFORM-PROVIDED provider keys. Naelao holds ONE
   *  Composio/Pipedream key as a Workers Secret so provider-backed connectors work with zero
   *  builder configuration (the Claude/ChatGPT bundled-connector model) — never the BYO
   *  space-credential path, which stays reserved for a builder's OWN provider project. The key
   *  never leaves this worker. Optional: when unset and a connector has no BYO credential, calls
   *  degrade honestly with `provider_not_configured`. */
  COMPOSIO_API_KEY?: string;
  /** VERIFIED (2026-07, against Pipedream's own docs): Pipedream's REST API is OAuth
   *  client_credentials-only — there is no "simple API key" the way Composio has one. Naelao's
   *  ONE Pipedream OAuth client id/secret (workers/agents/src/connectors/pipedream.ts holds the
   *  canonical implementation of the token exchange this worker mirrors below — kept in sync by
   *  hand, same precedent as the reserved-capability lists above). */
  PIPEDREAM_CLIENT_ID?: string;
  PIPEDREAM_CLIENT_SECRET?: string;
  /** "development" or "production", required on every Pipedream Connect call. Defaults below. */
  PIPEDREAM_ENVIRONMENT?: string;
  /** OAuth2 connectors ("Connect with Whop" etc.): buildAuthHeaders proactively refreshes a
   *  near-expiry access token by calling this internal endpoint — only the agents worker holds
   *  the connector's OAuth client secret, so refresh logic lives there, not here. */
  AGENTS_WORKER?: Fetcher;
  /** Meters a call that rode on Naelao's OWN platform provider key (not the builder's BYO
   *  credential) so it bills the builder's org rather than being an open, unattributed platform
   *  cost sink. Optional/best-effort — degrades to unmetered (not unblocked) when unwired. */
  BILLING_WORKER?: Fetcher;
}

/** Meter a tool call that resolved to Naelao's platform provider key (never a builder's own BYO
 *  credential — that case is the builder's own provider billing, not ours). Reuses the existing
 *  generic POST /billing/usage sink (same one llm_tokens/infra_credits already use), so this
 *  needs no new billing-worker route. Best-effort: never blocks or fails the tool call itself. */
async function recordPlatformKeyUsage(env: Env, tenantId: string, spaceId: string, connectorProvider: string): Promise<void> {
  if (!env.BILLING_WORKER) return;
  try {
    await env.BILLING_WORKER.fetch(
      new Request("http://billing-worker/billing/usage", {
        method: "POST",
        headers: {
          "content-type": "application/json",
          "x-naelao-tenant-id": tenantId,
          "x-naelao-internal-token": await mintInternalToken(env.PLATFORM_SECRET, tenantId),
        },
        body: JSON.stringify({ space_id: spaceId, event_type: "platform_connector_key", quantity: 1 }),
      })
    );
  } catch {
    // Best-effort — the tool call itself already succeeded/failed independently of billing.
  }
}

// Hosts that are external payment processors (incl. Naelao's own LS). A connector may never be
// registered against these — money-in is reserved to the prebuilt commerce script. Mirrors
// workers/agents/src/script-engine/reserved-capabilities.ts (kept in sync; defense-in-depth).
const RESERVED_PAYMENT_HOSTS: readonly string[] = [
  "api.stripe.com", "stripe.com", "js.stripe.com", "checkout.stripe.com",
  "api.paypal.com", "paypal.com", "paypalobjects.com",
  "squareup.com", "connect.squareup.com",
  "api.paddle.com", "paddle.com", "checkout.paddle.com",
  "braintreegateway.com", "api.braintreegateway.com",
  "razorpay.com", "api.razorpay.com", "api.checkout.com", "gr4vy.com",
  "commerce.coinbase.com", "api.coinbase.com",
  "api.lemonsqueezy.com", "lemonsqueezy.com",
];

function isReservedPaymentHost(hostname: string): boolean {
  const h = hostname.toLowerCase();
  return RESERVED_PAYMENT_HOSTS.some((p) => h === p || h.endsWith(`.${p}`));
}

// Mirrors workers/agents/src/script-engine/reserved-capabilities.ts's RESERVED_CAPABILITIES +
// isReservedToolName (kept in sync by hand — same precedent as the payment-host list above).
const RESERVED_TOOL_CAPABILITIES: readonly string[] = [
  "collect_payment", "create_checkout", "charge_customer", "subscription_charge",
  "issue_invoice", "payout", "wallet_withdraw", "wallet_balance", "connect_payment_account",
];

function isReservedToolName(toolName: string): boolean {
  const n = toolName.toLowerCase().replace(/[^a-z]/g, "_");
  if (RESERVED_TOOL_CAPABILITIES.some((cap) => n.includes(cap))) return true;
  return /(create|start|new|capture|collect)_?(payment|checkout|charge|invoice|payout|subscription)/.test(n)
    || /\b(charge|payout|refund|withdraw)\b/.test(toolName.toLowerCase());
}

/**
 * Short-lived per-request HMAC credential token (mirrors workers/credentials generateCredentialToken).
 * Format: "t=<unix>,aid=<agentId>,v1=<hmac-hex>"; HMAC payload "<spaceId>:<agentId>:<timestamp>".
 * The credentials worker verifies signature + spaceId + 60s freshness before returning plaintext.
 */
async function generateCredentialToken(platformSecret: string, spaceId: string, agentId: string): Promise<string> {
  const timestamp = Math.floor(Date.now() / 1000);
  const key = await crypto.subtle.importKey(
    "raw", new TextEncoder().encode(platformSecret), { name: "HMAC", hash: "SHA-256" }, false, ["sign"]
  );
  const sig = await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(`${spaceId}:${agentId}:${timestamp}`));
  const hex = Array.from(new Uint8Array(sig)).map((b) => b.toString(16).padStart(2, "0")).join("");
  return `t=${timestamp},aid=${agentId},v1=${hex}`;
}

type ConnectorProvider = "direct" | "composio" | "pipedream";

export interface McpServer {
  id: string;
  space_id: string;
  tenant_id: string;
  name: string;
  url: string;
  auth_type: "bearer" | "api_key" | "none" | "oauth2";
  auth_secret_name: string | null; // references space_credentials table
  enabled: number; // 0 or 1 (D1 stores booleans as integers)
  connector_provider: ConnectorProvider;
  /** Provider's opaque connection reference (Composio connected_account_id / Pipedream user_id). Never the underlying OAuth token. */
  provider_connection_id: string | null;
  created_at: string;
  updated_at: string;
}

// ── Phase P: Composio / Pipedream provider routing ────────────────────────────────────────────
// When connector_provider is 'composio' or 'pipedream', we route the tool call through the
// provider's execute-action API instead of calling the server URL directly. The script-native
// "6 ops only" surface is unchanged — more connector inventory, same surface.
// Both providers need an API key stored as a space-level credential; the connection_id stored in
// provider_connection_id scopes the call to the correct end-user OAuth connection on the provider side.

interface ProviderToolCallResult {
  result?: unknown;
  error?: string;
}

// Composio moved its tool-execution/listing API from v2 (`/api/v2/actions/...`) to v3
// (`/api/v3/tools/...`) — the connect-flow code in connectors/composio.ts was already updated to
// v3 for the OAuth handshake (see its own header), but these two functions, which is what every
// ACTUAL agent tool call goes through, were left on the dead v2 shape. Confirmed against
// Composio's real, live OpenAPI spec (`GET https://backend.composio.dev/api/v3/openapi.json`,
// fetched directly rather than assumed) — this is not a guess at a plausible shape the way some
// of this file's other defensive parsing is; the exact field names below are the schema's own.
const COMPOSIO_API_BASE = "https://backend.composio.dev/api/v3";

async function composioToolCall(
  connectionId: string,
  toolName: string,
  input: Record<string, unknown>,
  apiKey: string
): Promise<ProviderToolCallResult> {
  const resp = await fetch(
    `${COMPOSIO_API_BASE}/tools/execute/${encodeURIComponent(toolName)}`,
    {
      method: "POST",
      headers: { "Content-Type": "application/json", "x-api-key": apiKey },
      body: JSON.stringify({ connected_account_id: connectionId, arguments: input }),
      signal: AbortSignal.timeout(30_000),
    }
  );
  if (!resp.ok) {
    const text = await resp.text().catch(() => "");
    return { error: `Composio returned ${resp.status}: ${text.slice(0, 200)}` };
  }
  const data = await resp.json<{ data?: unknown; error?: string | null; successful?: boolean }>();
  if (data.error) return { error: data.error };
  // The v3 response envelope reports success via a dedicated `successful` boolean rather than
  // relying solely on `error` being absent — a call whose HTTP status was 200 but whose
  // `successful` field is `false` is still a failure (e.g. the upstream app itself rejected the
  // action), and reporting it as a result would hide that from the agent.
  if (data.successful === false) return { error: "Composio reported the tool call as unsuccessful" };
  return { result: data.data };
}

async function composioListTools(
  connectionId: string,
  apiKey: string
): Promise<{ tools: unknown[] }> {
  // v3 lists tools by TOOLKIT (`?toolkit_slug=`), not by connected account — there is no
  // "list tools for this connection" filter anymore, confirmed against the real spec. A
  // connected account always belongs to exactly one toolkit, so resolve that first.
  const acctResp = await fetch(
    `${COMPOSIO_API_BASE}/connected_accounts/${encodeURIComponent(connectionId)}`,
    { headers: { "x-api-key": apiKey }, signal: AbortSignal.timeout(15_000) }
  );
  if (!acctResp.ok) return { tools: [] };
  const acct = await acctResp.json<{ toolkit?: { slug?: string } }>().catch(() => ({}) as { toolkit?: { slug?: string } });
  const toolkitSlug = acct.toolkit?.slug;
  if (!toolkitSlug) return { tools: [] };
  const resp = await fetch(
    `${COMPOSIO_API_BASE}/tools?toolkit_slug=${encodeURIComponent(toolkitSlug)}&limit=100`,
    { headers: { "x-api-key": apiKey }, signal: AbortSignal.timeout(15_000) }
  );
  if (!resp.ok) return { tools: [] };
  const data = await resp.json<{ items?: unknown[] }>();
  return { tools: data.items ?? [] };
}

// Module-scoped OAuth access-token cache — mirrors connectors/pipedream.ts's own cache (a soft
// optimization only; a cold isolate simply refetches, never relied on for correctness).
const pipedreamTokenCache = new Map<string, { accessToken: string; expiresAt: number }>();

/** Exchanges Naelao's platform Pipedream OAuth client for a short-lived (1hr) access token —
 *  Pipedream's REST API accepts NOTHING else, confirmed against their own docs (no static API
 *  key path exists, unlike Composio's x-api-key). Never throws to its caller; a failed exchange
 *  degrades to the same provider_not_configured/credential_error path a missing key already
 *  takes. */
async function getPipedreamAccessToken(clientId: string, clientSecret: string): Promise<string | null> {
  const cached = pipedreamTokenCache.get(clientId);
  if (cached && cached.expiresAt > Date.now() + 30_000) return cached.accessToken;
  try {
    const resp = await fetch("https://api.pipedream.com/v1/oauth/token", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ grant_type: "client_credentials", client_id: clientId, client_secret: clientSecret }),
      signal: AbortSignal.timeout(15_000),
    });
    if (!resp.ok) return null;
    const json = await resp.json<{ access_token?: string; expires_in?: number }>();
    if (!json.access_token) return null;
    pipedreamTokenCache.set(clientId, { accessToken: json.access_token, expiresAt: Date.now() + (json.expires_in ?? 3600) * 1000 });
    return json.access_token;
  } catch {
    return null;
  }
}

async function pipedreamToolCall(
  connectionId: string,
  actionName: string,
  input: Record<string, unknown>,
  accessToken: string,
  environment: string
): Promise<ProviderToolCallResult> {
  // Pipedream Connect execute-action endpoint. `accessToken` is a real OAuth access token
  // (client_credentials-derived), never a static key — see getPipedreamAccessToken above.
  const resp = await fetch(
    `https://api.pipedream.com/v1/connect/actions/${encodeURIComponent(actionName)}/run`,
    {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": `Bearer ${accessToken}`,
        "x-pd-environment": environment,
        "x-pd-end-user-id": connectionId,
      },
      body: JSON.stringify({ inputs: input }),
      signal: AbortSignal.timeout(30_000),
    }
  );
  if (!resp.ok) {
    const text = await resp.text().catch(() => "");
    return { error: `Pipedream returned ${resp.status}: ${text.slice(0, 200)}` };
  }
  const data = await resp.json<{ data?: unknown; error?: string }>();
  if (data.error) return { error: data.error };
  return { result: data.data };
}

async function pipedreamListTools(
  connectionId: string,
  accessToken: string,
  environment: string
): Promise<{ tools: unknown[] }> {
  const resp = await fetch(
    `https://api.pipedream.com/v1/connect/components/actions?end_user_id=${encodeURIComponent(connectionId)}`,
    {
      headers: { "Authorization": `Bearer ${accessToken}`, "x-pd-environment": environment },
      signal: AbortSignal.timeout(15_000),
    }
  );
  if (!resp.ok) return { tools: [] };
  const data = await resp.json<{ data?: unknown[] }>();
  return { tools: data.data ?? [] };
}

function validateEnv(env: Env): void {
  if (!env.PLATFORM_SECRET) throw new Error("Missing required secret: PLATFORM_SECRET");
}

const app = new Hono<{ Bindings: Env }>();
app.use("*", requestId);
app.use("*", async (c, next) => {
  validateEnv(c.env);
  await next();
});
// §A1.17 Phase I: this worker's only real ingress is direct service bindings from the agents
// worker (mcp-connector's ctx.env.mcpHubWorker, and now the ctx.mcp isolate loopback) — never
// the public router — so `workers_dev = false` is the primary control. This adds the same
// defense-in-depth `requireInternalHmac` backstop every other internal-only worker in the
// platform already has (credentials, billing's /internal/*, spaces' /internal/*) in case that
// ever slips.
app.use("/v1/spaces/*", requireInternalHmac((c) => (c as unknown as { env: Env }).env.PLATFORM_SECRET));

function getCallerIdentity(c: { req: { header: (h: string) => string | undefined } }): {
  tenantId: string;
  userId: string;
} {
  return {
    tenantId: c.req.header("x-naelao-tenant-id") ?? "",
    userId: c.req.header("x-naelao-user-id") ?? "",
  };
}

// S0.5: was a literal-only hostname/IP blocklist (no DNS resolution, so a DNS-rebinding attack —
// register a public-IP hostname, then repoint its DNS to an internal address — sailed straight
// through) checked ONLY at registration time, never again before the actual outbound fetch. Now
// backed by the shared @naelao/security checkSsrf (DoH resolution, the same guard
// workers/browser/src/index.ts uses), and called again immediately before every outbound MCP
// fetch below — not just at registration — so a hostname that resolves safely at registration
// but is repointed afterward is still caught at call time.
async function validateMcpUrl(rawUrl: string): Promise<{ ok: true; url: URL } | { ok: false; message: string }> {
  const result = await checkSsrf(rawUrl);
  if (result.blocked) {
    return { ok: false, message: result.reason ?? "url failed SSRF validation" };
  }
  return { ok: true, url: new URL(rawUrl) };
}

/**
 * Resolve a credential reference (auth_secret_name → encrypted vault → plaintext) through the
 * credentials worker, then build the auth headers for the upstream MCP server. The plaintext is
 * fetched per call and never persisted in mcp_servers — the row only holds the credential NAME.
 * agentId scopes the short-lived credential token (for the vault's audit trail).
 *
 * §A1.18 connector scope model: `actingUserId`, when given, is passed to the credentials worker
 * as `on_behalf_of_user_id` — the plaintext-resolution route already implements the full
 * space-override > user > space-shared hierarchy (`resolveCredential`, unchanged by this pass),
 * it just never received an acting user from any caller. This is what makes a `scope='user'`
 * connector credential (a member's own personal account) actually reachable at call time — before
 * this, every resolution here was effectively space-only regardless of what was stored. Absent
 * (the vast majority of calls — most connectors are space-scoped) resolves exactly as before.
 */
/** Normalizes the `x-naelao-connector-scope` header (set by the mcp-connector prebuilt from the
 *  chat surface's per-session connector-mode preference) into buildAuthHeaders' preferScope
 *  param — any other/absent value degrades to undefined (today's default resolution), never a
 *  thrown error over a malformed header. */
function readPreferScope(raw: string | undefined): "business" | "personal" | undefined {
  return raw === "business" || raw === "personal" ? raw : undefined;
}

export async function buildAuthHeaders(
  server: McpServer,
  env: Env,
  agentId: string,
  actingUserId?: string,
  /** §A1 connector default-vs-personal switch: forwarded verbatim to the credentials worker's
   *  resolveCredential (see that function's own doc for the tier semantics). Absent for every
   *  pre-existing caller — byte-identical behavior. */
  preferScope?: "business" | "personal"
): Promise<Record<string, string>> {
  const headers: Record<string, string> = { "Content-Type": "application/json" };
  if (server.auth_type === "none" || !server.auth_secret_name) return headers;

  if (!env.CREDENTIALS_WORKER) {
    throw new Error("Credential resolution requires CREDENTIALS_WORKER binding");
  }
  const token = await generateCredentialToken(env.PLATFORM_SECRET, server.space_id, agentId);
  const resp = await env.CREDENTIALS_WORKER.fetch(
    new Request(
      `http://credentials/v1/internal/spaces/${server.space_id}/credentials/${encodeURIComponent(server.auth_secret_name)}/plaintext`,
      {
        method: "POST",
        headers: {
          "content-type": "application/json",
          "x-naelao-tenant-id": server.tenant_id,
          "x-naelao-credential-token": token,
        },
        body: JSON.stringify({
          ...(actingUserId ? { on_behalf_of_user_id: actingUserId } : {}),
          ...(preferScope ? { prefer_scope: preferScope } : {}),
        }),
      }
    )
  );
  if (resp.status === 404) {
    const body = await resp.json<{ error_code?: string }>().catch(() => ({}) as Record<string, never>);
    if (body.error_code === "personal_credential_required") {
      throw new Error(`personal_credential_required: no personal account connected for '${server.name}' — switch to the business account or connect your own`);
    }
  }
  if (!resp.ok) {
    throw new Error(`Failed to resolve credential '${server.auth_secret_name}' (${resp.status})`);
  }
  const { value } = await resp.json<{ value: string }>();
  if (server.auth_type === "bearer") headers["Authorization"] = `Bearer ${value}`;
  else if (server.auth_type === "api_key") headers["X-API-Key"] = value;
  else if (server.auth_type === "oauth2") {
    headers["Authorization"] = `Bearer ${await resolveOAuthAccessToken(server, env, value)}`;
  }
  return headers;
}

interface OAuthCredentialValue {
  access_token: string;
  refresh_token: string;
  /** Epoch millis. */
  expires_at: number;
}

// Refresh a bit before actual expiry so a call in flight doesn't race token expiration.
const OAUTH_REFRESH_BUFFER_MS = 5 * 60_000;

/** Resolves an oauth2 connector's access token, proactively refreshing via the agents worker
 *  (the only place that holds the connector's OAuth client secret) when near expiry. Never
 *  throws on a refresh failure — falls back to the current (possibly stale) access token so a
 *  transient refresh-endpoint outage doesn't turn every call into a hard failure; the upstream
 *  connector call itself will surface a real 401 if the token has actually expired. */
export async function resolveOAuthAccessToken(server: McpServer, env: Env, rawValue: string): Promise<string> {
  let tokens: OAuthCredentialValue;
  try {
    tokens = JSON.parse(rawValue) as OAuthCredentialValue;
  } catch {
    // Not a JSON blob — treat as a bare access token (defensive; shouldn't happen for a
    // correctly-registered oauth2 server).
    return rawValue;
  }
  if (!tokens.expires_at || Date.now() < tokens.expires_at - OAUTH_REFRESH_BUFFER_MS) {
    return tokens.access_token;
  }
  if (!env.AGENTS_WORKER) return tokens.access_token;
  try {
    const token = await mintInternalToken(env.PLATFORM_SECRET, server.tenant_id);
    const resp = await env.AGENTS_WORKER.fetch(
      new Request("http://agents-worker/internal/connectors/oauth/refresh", {
        method: "POST",
        headers: { "content-type": "application/json", "x-naelao-tenant-id": server.tenant_id, "x-naelao-internal-token": token },
        body: JSON.stringify({ space_id: server.space_id, platform: server.name, refresh_token: tokens.refresh_token }),
      })
    );
    if (!resp.ok) return tokens.access_token;
    const refreshed = await resp.json<{ access_token?: string }>();
    return refreshed.access_token ?? tokens.access_token;
  } catch {
    return tokens.access_token;
  }
}

type ProviderKeyResolution =
  | { ok: true; apiKey: string; source: "byo" | "platform" }
  | { ok: false; status: 400 | 502 | 503; errorCode: string; message: string };

/**
 * G-BF02: resolve the provider API key for a Composio/Pipedream-routed connector.
 *
 * Order matters: BYO wins when the row names a vault credential — a builder running their own
 * provider project keeps full control (and their own provider billing). Only when NO credential
 * is named does the PLATFORM key apply: Naelao's own Composio/Pipedream key, injected
 * server-side, never visible to (or enterable by) any builder or end user. Neither configured
 * → an honest, explicit error — never a silent empty result.
 */
async function resolveProviderApiKey(server: McpServer, env: Env, agentId: string): Promise<ProviderKeyResolution> {
  if (server.auth_secret_name) {
    let authHeaders: Record<string, string>;
    try {
      authHeaders = await buildAuthHeaders(server, env, agentId);
    } catch (err) {
      return { ok: false, status: 502, errorCode: "credential_error", message: (err as Error).message };
    }
    const apiKey = authHeaders["Authorization"]?.replace("Bearer ", "") ?? authHeaders["X-API-Key"] ?? "";
    if (!apiKey) {
      // Declared BYO but resolved to nothing (e.g. auth_type 'none' with a secret name) — a
      // registration bug. Deliberately NOT falling back to the platform key: that would silently
      // mask the misconfiguration and bill Naelao's provider account for a builder-project
      // connector.
      return {
        ok: false, status: 400, errorCode: "credential_error",
        message: `Credential '${server.auth_secret_name}' resolved to no API key (check the connector's auth_type)`,
      };
    }
    return { ok: true, apiKey, source: "byo" };
  }

  if (server.connector_provider === "composio") {
    if (env.COMPOSIO_API_KEY) return { ok: true, apiKey: env.COMPOSIO_API_KEY, source: "platform" };
  } else if (env.PIPEDREAM_CLIENT_ID && env.PIPEDREAM_CLIENT_SECRET) {
    // Pipedream has no static platform key — resolve to a live OAuth access token instead
    // (client_credentials-only per its own docs; see getPipedreamAccessToken above).
    const accessToken = await getPipedreamAccessToken(env.PIPEDREAM_CLIENT_ID, env.PIPEDREAM_CLIENT_SECRET);
    if (accessToken) return { ok: true, apiKey: accessToken, source: "platform" };
    return {
      ok: false, status: 502, errorCode: "provider_auth_failed",
      message: "Pipedream OAuth token exchange failed (check PIPEDREAM_CLIENT_ID/PIPEDREAM_CLIENT_SECRET)",
    };
  }
  return {
    ok: false, status: 503, errorCode: "provider_not_configured",
    message: `${server.connector_provider} connectors are not configured on this platform (no platform credentials set) and this connector has no credential of its own`,
  };
}

// GET /v1/spaces/:spaceId/mcp-servers — list registered MCP servers
app.get("/v1/spaces/:spaceId/mcp-servers", async (c) => {
  const { tenantId } = getCallerIdentity(c);
  if (!tenantId) return c.json({ error_code: "unauthorized", message: "Missing tenant" }, 401);
  const spaceId = c.req.param("spaceId");

  const { results } = await c.env.PLATFORM_DB.prepare(
    "SELECT id, name, url, auth_type, enabled, created_at FROM mcp_servers WHERE space_id = ? AND tenant_id = ?"
  )
    .bind(spaceId, tenantId)
    .all();

  return c.json({ data: results });
});

// POST /v1/spaces/:spaceId/mcp-servers — register a new MCP server
app.post("/v1/spaces/:spaceId/mcp-servers", async (c) => {
  const { tenantId } = getCallerIdentity(c);
  if (!tenantId) return c.json({ error_code: "unauthorized", message: "Missing tenant" }, 401);
  const spaceId = c.req.param("spaceId");

  const body = await c.req.json<{
    name: string;
    url?: string;
    auth_type?: "bearer" | "api_key" | "none";
    auth_secret_name?: string;
    connector_provider?: ConnectorProvider;
    provider_connection_id?: string;
  }>();

  const connectorProvider: ConnectorProvider = body.connector_provider ?? "direct";
  if (!["direct", "composio", "pipedream"].includes(connectorProvider)) {
    return c.json({ error_code: "bad_request", message: "connector_provider must be 'direct', 'composio', or 'pipedream'" }, 400);
  }

  // For provider-routed connectors a url is optional (the provider resolves the endpoint);
  // for direct connections a url is required.
  const url = body.url ?? "";
  if (connectorProvider === "direct" && !body.name) {
    return c.json({ error_code: "bad_request", message: "name is required" }, 400);
  }
  if (connectorProvider === "direct" && !url) {
    return c.json({ error_code: "bad_request", message: "url is required for direct connectors" }, 400);
  }
  if (!body.name) {
    return c.json({ error_code: "bad_request", message: "name is required" }, 400);
  }

  // SSRF + reserved-payment checks apply only to direct connectors (the provider handles
  // routing for Composio/Pipedream — we validate the provider API host at deploy time, not here).
  if (connectorProvider === "direct") {
    const urlValidation = await validateMcpUrl(url);
    if (!urlValidation.ok) {
      return c.json({ error_code: "bad_request", message: urlValidation.message }, 400);
    }
    if (isReservedPaymentHost(urlValidation.url.hostname)) {
      return c.json({
        error_code: "reserved_capability",
        message: "Payment processors cannot be registered as MCP connectors; money-in is reserved to Naelao commerce.",
      }, 403);
    }
  }

  if ((connectorProvider === "composio" || connectorProvider === "pipedream") && !body.provider_connection_id) {
    return c.json({ error_code: "bad_request", message: "provider_connection_id is required for Composio/Pipedream connectors" }, 400);
  }

  const id = crypto.randomUUID();
  const now = new Date().toISOString();
  const authType = body.auth_type ?? "none";
