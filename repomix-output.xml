<file path="infra/migrations/0068_eval_run_model.sql">
-- The model an eval run was scored against.
--
-- Needed for the model-comparison matrix: several runs of the SAME suite differ only by which
-- model answered, so without this a stored run can't be attributed and the comparison can only
-- ever live in the caller's console output.
--
-- Deliberately the ONLY column added. Everything else the run summary reports (average score,
-- pass/fail counts, agent/judge error counts) is derivable from the per-case eval_results rows
-- and is computed on read rather than stored — the same "don't create a second source of truth
-- alongside an aggregate you can already compute" rule applied to the billing usage counter.
--
-- eval_suites.model already exists and is a different thing: the suite's DEFAULT model. This is
-- what a specific run actually used, which may be an explicit per-run override.
ALTER TABLE eval_runs ADD COLUMN model TEXT;
</file>

<file path="infra/migrations/0069_credential_sharing_and_product_tier.sql">
-- Credential hierarchy expansion (naelao->product->business->personal), per the user's own
-- design: a space-scope credential that's shared can be shared with EVERYONE in the business
-- (existing default, unchanged) OR with a SELECTED subset of members — an admin-only choice,
-- checked by the worker (workers/credentials/src/index.ts resolveCredential), not the DB.
--
-- shared_with_user_ids: NULL (default) = shared with every member, matching today's behavior.
-- A JSON array of user ids narrows the shared fallback to just those members. Only meaningful
-- on scope='space' rows with is_override=0 (an is_override row is a FORCE, not an opt-in share,
-- and always wins regardless of this column).
ALTER TABLE space_credentials ADD COLUMN shared_with_user_ids TEXT;

-- Product-wide tier: a business (child) space with no local match (no personal, no business-
-- shared) falls through to its PRODUCT ROOT's own scope='space' credential row — the builder's
-- own product-level default, set once in the builder dashboard and used by every business under
-- that product unless a business/user overrides it. This needs no new table: the product root
-- is just another space, and its own space_credentials rows already have everything required.
-- Resolution walks spaces.parent_space_id exactly once (businesses are direct children of the
-- product root in this platform's model, never nested further) — see resolveCredential().
</file>

<file path="infra/migrations/0070_channel_pairings.sql">
-- Channel pairings: which external conversation/workspace belongs to which business.
--
-- The existing channel_links table answers "does this space have Slack?" — one row per
-- (space, channel), keyed by the space. Platform-app pairing needs the question asked the other
-- way round: a message arrives at Naelao's OWN bot carrying a Telegram chat id or a Slack team id,
-- and we have to find the business it belongs to. There is no space in the URL to look it up with.
--
-- Kept separate from channel_links rather than bolted onto it because the two really are different
-- facts. channel_links says a channel is configured and which project it drives; this says a
-- specific outside conversation is bound to a specific business. A space can have several
-- pairings on one channel (two Discord servers, several Telegram chats) and they all point at the
-- same link row.
CREATE TABLE IF NOT EXISTS channel_pairings (
  channel TEXT NOT NULL,
  -- The channel's own id for the thing that was paired: a Telegram chat id, a Slack team id, a
  -- Discord guild id, a WhatsApp sender id.
  external_id TEXT NOT NULL,
  space_id TEXT NOT NULL,
  tenant_id TEXT NOT NULL,
  -- Bind to a customer-bot project instead of the Space Assistant, mirroring channel_links.
  project_id TEXT,
  -- Who completed the pairing, so a binding is attributable after the fact.
  paired_by TEXT,
  created_at TEXT NOT NULL DEFAULT (datetime('now')),
  PRIMARY KEY (channel, external_id)
);

-- Listing a business's pairings, and unbinding them all when a business is deleted.
CREATE INDEX IF NOT EXISTS idx_channel_pairings_space ON channel_pairings(space_id, channel);
</file>

<file path="infra/migrations/0071_scheduled_job_runs.sql">
-- Phase 3 item 27/28 — scheduled_jobs has last_run_at/consecutive_failures (the CURRENT state)
-- but no per-fire HISTORY: nothing records what happened on each individual attempt, so a Crons
-- editing UI could show "when did this last run" but never "how has it been going" (a list of
-- recent fires, each pass/fail, with the real error). Same PLATFORM_DB table as scheduled_jobs
-- itself (the hourly dispatcher already needs one cheap cross-space query there — see that
-- migration's own comment for why this isn't per-space SpaceDO state).
--
-- Deliberately a flat append-only log, not a column on scheduled_jobs: a job fires repeatedly
-- over its lifetime and each fire is its own fact, not a value to overwrite.
CREATE TABLE IF NOT EXISTS scheduled_job_runs (
  id          TEXT PRIMARY KEY,
  job_id      TEXT NOT NULL,
  space_id    TEXT NOT NULL,
  tenant_id   TEXT NOT NULL,
  fired_at    INTEGER NOT NULL, -- unix ms, matches scheduled_jobs.last_run_at's own unit
  ok          INTEGER NOT NULL, -- 1 = succeeded, 0 = failed
  error       TEXT,             -- NULL on success
  duration_ms INTEGER,          -- NULL when unknown (a skip is never recorded here at all)
  skipped_busy INTEGER NOT NULL DEFAULT 0 -- was this fire skipped because the assistant was
                                          -- still running a prior wake? Recorded here (not in
                                          -- scheduled_jobs' own last_run_at/consecutive_failures,
                                          -- which are deliberately left untouched by a skip) so a
                                          -- run-history UI can still show it happened, distinct
                                          -- from a genuine pass or fail.
);
CREATE INDEX IF NOT EXISTS idx_scheduled_job_runs_job ON scheduled_job_runs(job_id, fired_at DESC);
-- Retention: unbounded growth for an hourly-or-more-frequent job is a real concern at scale.
-- The write path (recordScheduledJobRun, workers/agents) caps what it keeps per job rather than
-- relying on a separate cleanup job — see that function's own comment.
</file>

<file path="infra/migrations/0072_org_quota_overage.sql">
-- Phase 4 (money): lets a builder opt their org OUT of the hard monthly/daily/weekly usage gate
-- (enforceRunGates' "quota_exceeded"/"infra_quota_exceeded" 402s) in favor of a soft overage —
-- the run is still allowed, still metered into usage_events exactly as before, just no longer
-- BLOCKED once the plan's ceiling is crossed. This is deliberately NOT a metered-billing feature —
-- there is no live billing-provider integration here that turns overage into an invoice line item
-- (that would need real metered-usage APIs against Whop/Lemon Squeezy this pass does not build).
-- It is an honest "don't cut me off mid-work" toggle: usage past the ceiling is tracked (so a
-- human can see it and follow up manually) but never silently pretended to auto-bill.
ALTER TABLE orgs ADD COLUMN allow_quota_overage INTEGER NOT NULL DEFAULT 0;
</file>

