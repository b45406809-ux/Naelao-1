  const asset = await registry.get(assetId);
  if (asset.publisherUserId === raterUserId)
    throw new Error("publishers cannot rate their own assets");
  if (!(await hasUsed(raterUserId, assetId)))
    throw new Error("must use the asset before rating");
  // one rating per user per asset (UNIQUE constraint)
}
// Publish quota per user/tier
const PUBLISH_QUOTA = { free: 5, pro: 50, enterprise: 500 };
if (publishedCount &gt;= PUBLISH_QUOTA[tier]) throw new Error("publish quota reached");
