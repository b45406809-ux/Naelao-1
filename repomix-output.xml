<file path="workers/agents/container/server.mjs">
// Tier-5 harness — runs INSIDE the Cloudflare Container.
// Listens on :8080. Two routes:
//
// POST /build  { code }  ->  { built, tests_passed, logs }
//   The §02 micro-tool build/test gate (BusinessDO legacy path):
//   1. write the submitted code to a temp module
//   2. type-check / transpile it (esbuild)
//   3. import it and run its exported runTests() -> { passed, results[] }
//
// POST /exec  { name, code, args }  ->  { ok, result?, error?, logs? }
//   General Tier-5 script execution (script-engine execution-ladder §8): the script
//   exports `export async function run(args, ctx) { ... return result; }`. Bundled with
//   esbuild (so it can use Node builtins/npm deps installed in the image) then imported
//   and invoked with the agent's args. `ctx.workspaceDir` (also the process cwd for the
//   duration of the run) is /workspace — Tier-5 scripts get a real OS (filesystem,
//   child_process), unlike Tiers 2-4.
//
//   §A1.17 Phase R: /workspace is this container's OWN local disk — it persists across calls
//   to the SAME warm container instance with NO R2 round-trip, and starts genuinely EMPTY on a
//   cold start. Phase K's every-/exec-call blind full materialize/collect (workspace_files /
//   workspace_files_out, bounded 300 files / 2MB / 25MB) is gone: an agent explicitly moves
//   what it needs via the workspace.copy/move/list prebuilt (POST /workspace/{read,write,list,
//   delete} below), the same way it would reason about two genuinely different filesystems.
//
// POST /workspace/write  { files: {relPath: content} }        -> { ok }
// POST /workspace/read   { paths?: [relPath, ...] }            -> { files: {relPath: content} }
//   (paths omitted = every file currently under /workspace, same bound as before)
// POST /workspace/list   {}                                    -> { files: [relPath, ...] }
// POST /workspace/delete { paths: [relPath, ...] }              -> { ok }

import { createServer } from "node:http";
import { writeFile, mkdir, mkdtemp, readdir, readFile, rm, stat } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join, dirname, relative } from "node:path";
import { build } from "esbuild";

const PORT = 8080;
const EXEC_TIMEOUT_MS = 55_000;
const WORKSPACE_DIR = "/workspace";
// Mirrors ToolSandboxDO's own sync bounds — the harness enforces its side independently so a
// runaway script can't OOM/hang the container even if the DO's caps were somehow bypassed.
const MAX_WORKSPACE_FILES = 300;
const MAX_WORKSPACE_FILE_BYTES = 2 * 1024 * 1024;

async function materializeWorkspace(files) {
  await mkdir(WORKSPACE_DIR, { recursive: true });
  for (const [relPath, content] of Object.entries(files ?? {})) {
    const dest = join(WORKSPACE_DIR, relPath);
    await mkdir(dirname(dest), { recursive: true });
    await writeFile(dest, content, "utf8");
  }
}

async function collectWorkspace() {
  const out = {};
  let count = 0;
  async function walk(dir) {
    let entries;
    try {
      entries = await readdir(dir, { withFileTypes: true });
    } catch {
      return;
    }
    for (const entry of entries) {
      if (count >= MAX_WORKSPACE_FILES) return;
      const full = join(dir, entry.name);
      if (entry.isDirectory()) {
        await walk(full);
      } else if (entry.isFile()) {
        const info = await stat(full).catch(() => null);
        if (!info || info.size > MAX_WORKSPACE_FILE_BYTES) continue;
        try {
          out[relative(WORKSPACE_DIR, full)] = await readFile(full, "utf8");
          count++;
        } catch {
          // Binary/unreadable-as-utf8 file — skip rather than corrupt it (matches the
          // platform's existing R2-workspace convention of text-only content).
        }
      }
    }
  }
  await mkdir(WORKSPACE_DIR, { recursive: true });
  await walk(WORKSPACE_DIR);
  return out;
}

// §A1.17 Phase R: explicit read of specific paths (workspace.copy('container','r2', path)) —
// falls back to collectWorkspace()'s full walk when no paths are given (workspace.list-adjacent
// callers that want everything).
async function readWorkspacePaths(paths) {
  if (!paths || paths.length === 0) return collectWorkspace();
  const out = {};
  for (const relPath of paths.slice(0, MAX_WORKSPACE_FILES)) {
    try {
      const full = join(WORKSPACE_DIR, relPath);
      const info = await stat(full);
      if (info.size > MAX_WORKSPACE_FILE_BYTES) continue;
      out[relPath] = await readFile(full, "utf8");
    } catch {
      // missing/unreadable — simply absent from the result, not an error for the whole batch
    }
  }
  return out;
}

async function listWorkspacePaths() {
  const names = [];
  async function walk(dir) {
    let entries;
    try {
      entries = await readdir(dir, { withFileTypes: true });
    } catch {
      return;
    }
    for (const entry of entries) {
      if (names.length >= MAX_WORKSPACE_FILES) return;
      const full = join(dir, entry.name);
      if (entry.isDirectory()) await walk(full);
      else if (entry.isFile()) names.push(relative(WORKSPACE_DIR, full));
    }
  }
  await mkdir(WORKSPACE_DIR, { recursive: true });
  await walk(WORKSPACE_DIR);
  return names;
}

async function deleteWorkspacePaths(paths) {
  for (const relPath of paths ?? []) {
    await rm(join(WORKSPACE_DIR, relPath), { force: true }).catch(() => {});
  }
}

async function buildAndTest(code) {
  const logs = [];
  const dir = await mkdtemp(join(tmpdir(), "tool-"));
  const src = join(dir, "tool.ts");
  const out = join(dir, "tool.mjs");
  try {
    await writeFile(src, code, "utf8");

    // 1+2. Build (this is also the type/transpile gate).
    try {
      await build({ entryPoints: [src], outfile: out, bundle: true, format: "esm", platform: "node", logLevel: "silent" });
      logs.push("build: ok");
    } catch (err) {
      logs.push(`build: failed — ${String(err).slice(0, 1000)}`);
      return { built: false, tests_passed: false, logs: logs.join("\n") };
    }

    // 3. Run the tool's own tests.
    const mod = await import(`file://${out}`);
    if (typeof mod.runTests !== "function") {
      logs.push("tests: tool exports no runTests() — cannot verify it works");
      return { built: true, tests_passed: false, logs: logs.join("\n") };
    }
    const result = await mod.runTests();
    const passed = !!(result && result.passed);
    logs.push(`tests: ${passed ? "passed" : "failed"}`);
    if (Array.isArray(result?.results)) logs.push(...result.results.map(String));
    return { built: true, tests_passed: passed, logs: logs.join("\n") };
  } catch (err) {
    logs.push(`harness error: ${String(err).slice(0, 1000)}`);
    return { built: false, tests_passed: false, logs: logs.join("\n") };
  } finally {
    await rm(dir, { recursive: true, force: true }).catch(() => {});
  }
}

async function execScript(name, code, args) {
  const dir = await mkdtemp(join(tmpdir(), "exec-"));
  const src = join(dir, "script.ts");
  const out = join(dir, "script.mjs");
  // §A1.17 Phase R: /workspace is untouched here — it's whatever this warm container's own
  // disk already has from a prior call plus whatever workspace.copy explicitly staged in. No
  // implicit materialize/collect around the run anymore (see the file header comment).
  try {
    await writeFile(src, code, "utf8");
    try {
      await build({ entryPoints: [src], outfile: out, bundle: true, format: "esm", platform: "node", logLevel: "silent" });
    } catch (err) {
      return { ok: false, error: `build failed: ${String(err).slice(0, 1000)}` };
    }
    const mod = await import(`file://${out}`);
    if (typeof mod.run !== "function") {
      return { ok: false, error: `script '${name}' does not export an async function named 'run'` };
    }
    const timeout = new Promise((_, reject) =>
      setTimeout(() => reject(new Error("execution timed out")), EXEC_TIMEOUT_MS)
    );
    const result = await Promise.race([mod.run(args ?? {}, { workspaceDir: WORKSPACE_DIR }), timeout]);
    return { ok: true, result };
  } catch (err) {
    return { ok: false, error: String(err).slice(0, 2000) };
  } finally {
    await rm(dir, { recursive: true, force: true }).catch(() => {});
  }
}

const WORKSPACE_ROUTES = new Set(["/workspace/read", "/workspace/write", "/workspace/list", "/workspace/delete"]);

createServer((req, res) => {
  const path = req.url ?? "";
  const isWorkspaceRoute = [...WORKSPACE_ROUTES].some((r) => path.endsWith(r));
  if (req.method !== "POST" || (!path.endsWith("/build") && !path.endsWith("/exec") && !isWorkspaceRoute)) {
    res.writeHead(404).end(JSON.stringify({ error: "not_found" }));
    return;
  }
  const isExec = path.endsWith("/exec");
  const MAX_BODY_BYTES = 10_000_000; // §A1.17 Phase R: no more bundled workspace_files, back to a script-code-sized budget
  let body = "";
  req.on("data", (c) => { body += c; if (body.length > MAX_BODY_BYTES) req.destroy(); });
  req.on("end", async () => {
    try {
      const parsed = JSON.parse(body || "{}");
      if (isWorkspaceRoute) {
        let result;
        if (path.endsWith("/workspace/write")) { await materializeWorkspace(parsed.files); result = { ok: true }; }
        else if (path.endsWith("/workspace/read")) result = { files: await readWorkspacePaths(parsed.paths) };
        else if (path.endsWith("/workspace/list")) result = { files: await listWorkspacePaths() };
        else { await deleteWorkspacePaths(parsed.paths); result = { ok: true }; }
        res.writeHead(200, { "content-type": "application/json" }).end(JSON.stringify(result));
        return;
      }
      if (!parsed.code) { res.writeHead(400).end(JSON.stringify({ error: "code required" })); return; }
      const result = isExec
        ? await execScript(parsed.name ?? "script", parsed.code, parsed.args)
        : await buildAndTest(parsed.code);
      res.writeHead(200, { "content-type": "application/json" }).end(JSON.stringify(result));
    } catch (err) {
      res.writeHead(500).end(JSON.stringify(
        isExec || isWorkspaceRoute ? { ok: false, error: String(err) } : { built: false, tests_passed: false, logs: String(err) }
      ));
    }
  });
}).listen(PORT, () => console.log(`tool-sandbox harness listening on :${PORT}`));
</file>

<file path="workers/agents/local-agent/naelao-local-agent.mjs">
#!/usr/bin/env node
/**
 * Naelao Local Agent — reference client for "Local PC as a Container Target"
 * (spec gap G-3; §A1.17 Phase M).
 *
 * This is a small, dependency-free Node script (requires the global `WebSocket`, stable in
 * Node 22+) that a builder runs on their OWN machine to opt it in as a grant-checked execution
 * target for their space's agent. It opens ONE WebSocket to LocalTunnelDO (agents worker) and
 * relays read_file/write_file/exec requests — nothing more. The server has ALREADY checked the
 * request against that space's `local_grants` before it ever reaches this client (see
 * workers/agents/src/script-engine/prebuilt/local-machine.ts); the `--allow-dir`/
 * `--allow-command` flags here are an OPTIONAL second, independent check on this side, because
 * this machine is the one actually at risk if the server-side check were ever wrong.
 *
 * Usage:
 *   node naelao-local-agent.mjs \
 *     --url wss://agents.your-naelao-deployment.example \
 *     --space <spaceId> --user <userId> --token <connect-token> \
 *     --allow-dir /home/alice/project \
 *     --allow-command "npm test"
 *
 * Get --space/--user/--token by calling (as the space's owner/admin):
 *   POST /spaces/:spaceId/local-tunnel/connect-token
 * The token expires in 5 minutes — run this client promptly after minting one. On disconnect
 * this client exits rather than silently retrying with a dead token; mint a fresh token and
 * re-run to reconnect. To revoke access entirely, delete the grant(s)
 * (DELETE /spaces/:spaceId/local-grants/:grantId) — a revoked grant is denied on the NEXT
 * request even if this client is still connected, since the check runs server-side per call.
 */

import { readFile, writeFile } from "node:fs/promises";
import { exec as execCallback } from "node:child_process";
import { promisify } from "node:util";

const exec = promisify(execCallback);
const EXEC_TIMEOUT_MS = 25_000; // stays under LocalTunnelDO's 30s /exec timeout

function parseArgs(argv) {
  const args = { allowDirs: [], allowCommands: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--url") args.url = argv[++i];
    else if (a === "--space") args.space = argv[++i];
    else if (a === "--user") args.user = argv[++i];
    else if (a === "--token") args.token = argv[++i];
    else if (a === "--allow-dir") args.allowDirs.push(argv[++i]);
    else if (a === "--allow-command") args.allowCommands.push(argv[++i]);
  }
  return args;
}

export function normalizePath(p) {
  const isAbsolute = p.startsWith("/");
  const parts = p.split("/").filter(Boolean);
  const out = [];
  for (const part of parts) {
    if (part === ".") continue;
    if (part === "..") { out.pop(); continue; }
    out.push(part);
  }
  return (isAbsolute ? "/" : "") + out.join("/");
}

export function isWithinAny(path, dirs) {
  if (dirs.length === 0) return true; // no client-side allowlist configured — trust the server's own grant check
  const normalized = normalizePath(path);
  return dirs.some((d) => {
    const dir = normalizePath(d).replace(/\/+$/, "");
    return normalized === dir || normalized.startsWith(dir + "/");
  });
}

export function isAllowedCommand(command, commands) {
  if (commands.length === 0) return true; // same as above — server already checked this
  return commands.includes(command);
}

export async function handleRequest(args, op, params) {
  if (op === "read_file") {
    if (!isWithinAny(params.path, args.allowDirs)) throw new Error(`local policy: '${params.path}' is outside this client's --allow-dir list`);
    return await readFile(params.path, "utf8");
  }
  if (op === "write_file") {
    if (!isWithinAny(params.path, args.allowDirs)) throw new Error(`local policy: '${params.path}' is outside this client's --allow-dir list`);
    await writeFile(params.path, params.content ?? "", "utf8");
    return { written: true };
  }
  if (op === "exec") {
    if (!isAllowedCommand(params.command, args.allowCommands)) throw new Error(`local policy: '${params.command}' is not in this client's --allow-command list`);
    const { stdout, stderr } = await exec(params.command, { timeout: EXEC_TIMEOUT_MS, maxBuffer: 10 * 1024 * 1024 });
    return { stdout, stderr };
  }
  throw new Error(`unknown op: ${op}`);
}

async function main() {
  const args = parseArgs(process.argv.slice(2));
  if (!args.url || !args.space || !args.user || !args.token) {
    console.error("Usage: naelao-local-agent.mjs --url <wss://...> --space <id> --user <id> --token <token> [--allow-dir <path> ...] [--allow-command <cmd> ...]");
    process.exit(1);
  }

  const connectUrl = `${args.url.replace(/\/$/, "")}/local-tunnel/connect?space=${encodeURIComponent(args.space)}&user=${encodeURIComponent(args.user)}&token=${encodeURIComponent(args.token)}`;
  console.log(`[naelao-local-agent] connecting to ${args.url} for space=${args.space} user=${args.user}`);
  if (args.allowDirs.length === 0 && args.allowCommands.length === 0) {
    console.warn("[naelao-local-agent] no --allow-dir/--allow-command configured — this client will not second-guess the server's grant check.");
  }

  const ws = new WebSocket(connectUrl);

  ws.addEventListener("open", () => {
    console.log("[naelao-local-agent] connected — waiting for requests");
  });

  ws.addEventListener("message", async (event) => {
    let msg;
    try {
      msg = JSON.parse(typeof event.data === "string" ? event.data : event.data.toString());
    } catch {
      return;
    }
    if (msg.type !== "request" || !msg.request_id) return;

    try {
      const result = await handleRequest(args, msg.op, msg.params || {});
      ws.send(JSON.stringify({ type: "response", request_id: msg.request_id, ok: true, result }));
    } catch (err) {
      ws.send(JSON.stringify({ type: "response", request_id: msg.request_id, ok: false, error: String(err?.message || err) }));
    }
  });

  ws.addEventListener("close", (event) => {
    console.error(`[naelao-local-agent] disconnected (code=${event.code}). Connect tokens are single-use-window (5 min) — mint a fresh one and re-run to reconnect.`);
    process.exit(event.code === 1000 ? 0 : 1);
  });

  ws.addEventListener("error", (event) => {
    console.error("[naelao-local-agent] connection error:", event.message || event);
  });
}

// Only run when invoked directly (`node naelao-local-agent.mjs ...`) — importing this module
// (e.g. from a test exercising the pure helpers above) must not open a real connection.
if (import.meta.url === `file://${process.argv[1]}`) {
  main();
}
</file>

<file path="workers/agents/src/channels/agentmail.ts">
/**
 * AgentMail — a Naelao-provisioned, INBOUND-CAPABLE business mailbox (the piece the prior pass
 * deferred because this account owns zero DNS zones). AgentMail hosts the receiving domain itself:
 * `POST /v0/inboxes` with a username gives a real address that can both send AND receive on their
 * domain, so no Naelao-owned DNS zone is needed at all — which is exactly why it unblocks the
 * "auto-provisioned business email" feature.
 *
 * This is a dependency-free REST client verified against AgentMail's own OpenAPI
 * (https://docs.agentmail.to/openapi.json — base https://api.agentmail.to, Bearer auth, paths
 * under /v0). Every function degrades HONESTLY when `AGENTMAIL_API_KEY` is unset
 * (`{configured:false}`) rather than throwing or pretending — the same "confirm once real access
 * exists" precedent as this repo's Whop/Composio/Pipedream integrations. The exact wire shapes
 * below are the real ones from the OpenAPI, not guessed; the one thing genuinely unverified until
 * a live key exists is the Svix header/secret format (documented on the verify function).
 */

const AGENTMAIL_BASE = "https://api.agentmail.to";

export interface AgentMailEnv {
  /** AgentMail API key (Bearer). A Workers Secret — never in code/wrangler vars. Unset = the whole
   *  integration degrades honestly to "not configured" and the caller falls back (Resend for send,
   *  no inbound). */
  AGENTMAIL_API_KEY?: string;
  /** Public base URL of this agents worker (already used for the OAuth callback) — the inbound
   *  webhook is registered as `${PUBLIC_AGENTS_URL}/channels/email/agentmail-inbound/{spaceId}`. */
  PUBLIC_AGENTS_URL?: string;
}

export function agentMailConfigured(env: AgentMailEnv): boolean {
  return Boolean(env.AGENTMAIL_API_KEY);
}

async function amFetch(
  env: AgentMailEnv,
  path: string,
  init: { method: string; body?: unknown }
): Promise<{ ok: boolean; status: number; json: Record<string, unknown> }> {
  const resp = await fetch(`${AGENTMAIL_BASE}${path}`, {
    method: init.method,
    headers: {
      authorization: `Bearer ${env.AGENTMAIL_API_KEY}`,
      "content-type": "application/json",
    },
    ...(init.body !== undefined ? { body: JSON.stringify(init.body) } : {}),
  });
  const json = await resp.json<Record<string, unknown>>().catch(() => ({}) as Record<string, unknown>);
  return { ok: resp.ok, status: resp.status, json };
}

/** A slug → an AgentMail-safe local part (their `username`). Bounded, lowercased, no leading/
 *  trailing separators — mirrors the storefront/handle slugging already used in spaces-worker. */
export function toInboxUsername(input: string): string {
  return (input || "team").toLowerCase().replace(/[^a-z0-9.-]+/g, "-").replace(/^[-.]+|[-.]+$/g, "").slice(0, 40) || "team";
}

/**
 * `toInboxUsername` alone collides in production: AgentMail's `username` is unique across its
 * ENTIRE customer base, not scoped to our account — confirmed live provisioning the platform's own
 * "launchpad" business, which 403'd with `resource_taken` because some other AgentMail customer
 * already owns that exact username on their shared default domain. A common business name/slug is
 * genuinely likely to collide. Appends a short spaceId-derived suffix so a provisioned address is
 * virtually guaranteed unique while staying readable (`acme-corp-a1b2c3` rather than a bare UUID).
 */
export function uniqueInboxUsername(slug: string, spaceId: string): string {
  const suffix = (spaceId.replace(/[^a-z0-9]/gi, "").slice(0, 6).toLowerCase() || "000000");
  const base = toInboxUsername(slug).slice(0, Math.max(1, 39 - suffix.length - 1));
  return `${base}-${suffix}`;
}

export interface CreateInboxResult {
  ok: boolean;
  configured: boolean;
  /** The real, inbound-capable email address AgentMail allocated. */
  email?: string;
  inboxId?: string;
  error?: string;
}

/**
 * Create (or idempotently reuse) an inbox for a space. `client_id` is set to the spaceId — a
 * caller-supplied reference AgentMail stores, so a re-provision of the same space is safe to
 * attempt (we also short-circuit before calling this when a business_services row already exists).
 * `username` omitted lets AgentMail assign one on its default domain; passing one gives a readable
 * address. Response fields (`email`, `inbox_id`) are verified against the OpenAPI's create-inbox
 * 200 schema.
 */
export async function createInbox(
  env: AgentMailEnv,
  opts: { username?: string; displayName?: string; spaceId: string }
): Promise<CreateInboxResult> {
  if (!agentMailConfigured(env)) return { ok: false, configured: false };
  try {
    const res = await amFetch(env, "/v0/inboxes", {
      method: "POST",
      body: {
        ...(opts.username ? { username: opts.username } : {}),
        ...(opts.displayName ? { display_name: opts.displayName } : {}),
        client_id: opts.spaceId,
      },
    });
    if (!res.ok) {
      return { ok: false, configured: true, error: `agentmail create inbox failed (${res.status}): ${JSON.stringify(res.json).slice(0, 200)}` };
    }
    const email = typeof res.json["email"] === "string" ? (res.json["email"] as string) : undefined;
    const inboxId = typeof res.json["inbox_id"] === "string" ? (res.json["inbox_id"] as string) : undefined;
    if (!email || !inboxId) return { ok: false, configured: true, error: "agentmail response missing email/inbox_id" };
    return { ok: true, configured: true, email, inboxId };
  } catch (err) {
    return { ok: false, configured: true, error: `agentmail create inbox error: ${err instanceof Error ? err.message : String(err)}` };
  }
}

export interface CreateWebhookResult {
  ok: boolean;
  configured: boolean;
  webhookId?: string;
  /** Svix signing secret for verifying inbound webhook deliveries. Returned once at creation. */
  secret?: string;
  error?: string;
}

/** Register an inbound webhook on an inbox for `message.received` events, pointing at our public
 *  Svix-verified ingress. Body/response fields verified against the OpenAPI create-webhook schema
 *  (`url`, `event_types`, response `webhook_id`/`secret`). */
export async function createInboundWebhook(
  env: AgentMailEnv,
  inboxId: string,
  webhookUrl: string
): Promise<CreateWebhookResult> {
  if (!agentMailConfigured(env)) return { ok: false, configured: false };
  try {
    const res = await amFetch(env, `/v0/inboxes/${encodeURIComponent(inboxId)}/webhooks`, {
      method: "POST",
      body: { url: webhookUrl, event_types: ["message.received"] },
    });
    if (!res.ok) {
      return { ok: false, configured: true, error: `agentmail create webhook failed (${res.status}): ${JSON.stringify(res.json).slice(0, 200)}` };
    }
    const webhookId = typeof res.json["webhook_id"] === "string" ? (res.json["webhook_id"] as string) : undefined;
    const secret = typeof res.json["secret"] === "string" ? (res.json["secret"] as string) : undefined;
    return { ok: true, configured: true, ...(webhookId ? { webhookId } : {}), ...(secret ? { secret } : {}) };
  } catch (err) {
    return { ok: false, configured: true, error: `agentmail create webhook error: ${err instanceof Error ? err.message : String(err)}` };
  }
}

export interface SendResult {
  ok: boolean;
  configured: boolean;
  messageId?: string;
  threadId?: string;
  error?: string;
}

/** Send from a provisioned inbox. `to` accepts a single address or a list (AgentMail's `Addresses`
 *  oneOf). Response fields verified against the OpenAPI send 200 schema (`message_id`/`thread_id`). */
export async function sendFromInbox(
  env: AgentMailEnv,
  inboxId: string,
  msg: { to: string | string[]; subject?: string; text?: string; html?: string }
): Promise<SendResult> {
  if (!agentMailConfigured(env)) return { ok: false, configured: false };
  if (!msg.to || (Array.isArray(msg.to) && msg.to.length === 0)) return { ok: false, configured: true, error: "recipient 'to' is required" };
  try {
    const res = await amFetch(env, `/v0/inboxes/${encodeURIComponent(inboxId)}/messages/send`, {
      method: "POST",
      body: {
        to: msg.to,
        ...(msg.subject ? { subject: msg.subject } : {}),
        ...(msg.text ? { text: msg.text } : {}),
        ...(msg.html ? { html: msg.html } : {}),
      },
    });
    if (!res.ok) {
      return { ok: false, configured: true, error: `agentmail send failed (${res.status}): ${JSON.stringify(res.json).slice(0, 200)}` };
    }
    return {
      ok: true, configured: true,
      ...(typeof res.json["message_id"] === "string" ? { messageId: res.json["message_id"] as string } : {}),
      ...(typeof res.json["thread_id"] === "string" ? { threadId: res.json["thread_id"] as string } : {}),
    };
  } catch (err) {
    return { ok: false, configured: true, error: `agentmail send error: ${err instanceof Error ? err.message : String(err)}` };
  }
}

// ── Inbound: Svix signature verification + payload parse ──────────────────────

/**
 * Verify an AgentMail (Svix-delivered) inbound webhook signature.
 *
 * AgentMail signs webhooks with Svix, whose scheme is stable and public:
 *   - headers: `svix-id`, `svix-timestamp`, `svix-signature`
 *   - the signing secret is `whsec_<base64>`; the bytes after the prefix are base64-decoded
 *   - signed content = `${svix-id}.${svix-timestamp}.${rawBody}`
 *   - expected = base64( HMAC-SHA256(secretBytes, signedContent) )
 *   - the `svix-signature` header is a space-delimited list of `v1,<sig>` — a match against ANY
 *     entry is valid (Svix rotates secrets by sending multiple)
 *   - deliveries older than 5 minutes are rejected (replay protection), same window as the
 *     Slack/Mailgun adapters in channels.ts.
 *
 * The Svix scheme itself is verified against Svix's published spec; what remains genuinely
 * unconfirmed until a live AgentMail webhook fires is only that AgentMail uses these exact header
 * names (it advertises Svix, and the OpenAPI names `SvixId`/`SvixSignature`/`SvixTimestamp` schemas
 * — strong evidence, not a live observation). Fails CLOSED on any parsing/crypto error.
 */
export async function verifySvixSignature(opts: {
  headers: Record<string, string>;
  rawBody: string;
  secret: string;
  nowMs?: number;
}): Promise<boolean> {
  const { headers, rawBody, secret } = opts;
  const svixId = headers["svix-id"] ?? headers["webhook-id"];
  const svixTimestamp = headers["svix-timestamp"] ?? headers["webhook-timestamp"];
  const svixSignature = headers["svix-signature"] ?? headers["webhook-signature"];
  if (!svixId || !svixTimestamp || !svixSignature || !secret) return false;

  const now = opts.nowMs ?? Date.now();
  const tsSec = Number(svixTimestamp);
  if (!Number.isFinite(tsSec) || Math.abs(now / 1000 - tsSec) > 300) return false;

  try {
    const secretB64 = secret.startsWith("whsec_") ? secret.slice("whsec_".length) : secret;
    const keyBytes = base64ToBytes(secretB64);
    const key = await crypto.subtle.importKey("raw", keyBytes, { name: "HMAC", hash: "SHA-256" }, false, ["sign"]);
    const signedContent = `${svixId}.${svixTimestamp}.${rawBody}`;
    const sig = await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(signedContent));
    const expected = bytesToBase64(new Uint8Array(sig));
    // Header is space-delimited "v1,<sig> v1,<sig2>" — accept a match against any version-1 entry.
    for (const part of svixSignature.split(" ")) {
      const [, sigVal] = part.split(",");
      if (sigVal && timingSafeEqualStr(sigVal, expected)) return true;
    }
    return false;
  } catch {
    return false;
  }
}

/** Normalized inbound email, ready to hand to the same channel pipeline every other channel uses
 *  (`emailAdapter.normalizeInbound`'s output shape: from / text / external_id). */
export interface ParsedInboundEmail {
  from: string;
  text: string;
  messageId: string;
  subject?: string;
}

/**
 * Parse an AgentMail `message.received` webhook body into the fields the channel pipeline needs.
 * Shape verified against the OpenAPI `MessageReceivedEvent` schema: `{type:"event",
 * event_type:"message.received"|..., event_id, message:{from, to, subject, text, ...}, thread}`.
 * Returns null for a non-message event or a message with no usable sender/body — the caller
 * ack-ignores, never 500s (an unparseable delivery must not look like a server failure to Svix,
 * which would retry it forever).
 */
export function parseInboundMessageReceived(payload: unknown): ParsedInboundEmail | null {
  if (!payload || typeof payload !== "object") return null;
  const p = payload as Record<string, unknown>;
  const eventType = typeof p["event_type"] === "string" ? (p["event_type"] as string) : "";
  if (!eventType.startsWith("message.received")) return null;
  // Spam/blocked/unauthenticated variants share the prefix — a spam-flagged inbound is a real
  // signal a human may want, but it must never auto-drive the agent; the caller decides. Here we
  // only surface the ordinary `message.received`; the flagged variants are returned as null so
  // they don't feed the reasoning loop (the inbound route logs them separately).
  if (eventType !== "message.received") return null;

  const message = p["message"];
  if (!message || typeof message !== "object") return null;
  const m = message as Record<string, unknown>;
  const from = typeof m["from"] === "string" ? (m["from"] as string) : "";
  const text = typeof m["text"] === "string" ? (m["text"] as string)
    : typeof m["preview"] === "string" ? (m["preview"] as string) : "";
  const messageId = typeof m["message_id"] === "string" ? (m["message_id"] as string) : "";
  const subject = typeof m["subject"] === "string" ? (m["subject"] as string) : undefined;
  if (!from || !text || !messageId) return null;
  return { from, text, messageId, ...(subject ? { subject } : {}) };
}

// ── small crypto/encoding helpers (no deps) ──────────────────────────────────

function base64ToBytes(b64: string): Uint8Array {
  const bin = atob(b64);
  const out = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
  return out;
}

function bytesToBase64(bytes: Uint8Array): string {
  let bin = "";
  for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]!);
  return btoa(bin);
}

/** Constant-time-ish string compare (length-independent short-circuit avoided). */
function timingSafeEqualStr(a: string, b: string): boolean {
  if (a.length !== b.length) return false;
  let diff = 0;
  for (let i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return diff === 0;
}
