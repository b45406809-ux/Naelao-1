<file path="workers/analytics/src/events.ts">
// G-H01: Analytics event schema and CF Analytics Engine write helper
// Fulfills the append-only, 25M rows/day CF Analytics Engine write path.

// ── Event types ───────────────────────────────────────────────────────────────

export type EventType =
  | "session_start"
  | "session_end"
  | "message_sent"
  | "agent_response"
  | "tool_called"
  | "tool_error"
  | "kb_retrieved"
  | "kb_doc_uploaded"
  | "space_created"
  | "space_deleted"
  | "login"
  | "register"
  | "billing_checkout"
  | "subscription_changed"
  | "error"
  | "rate_limited"
  | "rating_submitted";

export interface AnalyticsEvent {
  eventType: EventType;
  tenantId: string;
  spaceId?: string;
  sessionId?: string;
  userId?: string;
  durationMs?: number;
  tokenCount?: number;
  errorCode?: string;
  rating?: number; // 1-5
  model?: string;
  toolName?: string;
  planTier?: string;
  metadata?: Record<string, string>; // max 5 key-value pairs
}

// ── CF Analytics Engine write ─────────────────────────────────────────────────
//
// CF Analytics Engine field layout (must stay stable — append-only schema):
//
//  indexes (string, max 20):
//    index1 = eventType
//    index2 = tenantId
//    index3 = spaceId       (empty string when absent)
//    index4 = sessionId     (empty string when absent)
//    index5 = userId        (empty string when absent)
//
//  doubles (number, max 20):
//    double1 = timestamp unix ms
//    double2 = durationMs   (0 when absent)
//    double3 = tokenCount   (0 when absent)
//    double4 = rating       (0 when absent)
//
//  blobs (string, max 20):
//    blob1 = errorCode      (empty string when absent)
//    blob2 = model          (empty string when absent)
//    blob3 = toolName       (empty string when absent)
//    blob4 = planTier       (empty string when absent)
//    blob5 = JSON.stringify(metadata ?? {})

export function writeEvent(
  dataset: AnalyticsEngineDataset,
  event: AnalyticsEvent
): void {
  // Validate metadata size — silently truncate to 5 pairs
  let metadata = event.metadata ?? {};
  const entries = Object.entries(metadata);
  if (entries.length > 5) {
    metadata = Object.fromEntries(entries.slice(0, 5));
  }

  dataset.writeDataPoint({
    indexes: [
      event.eventType,               // index1
      event.tenantId,                // index2
      event.spaceId ?? "",           // index3
      event.sessionId ?? "",         // index4
      event.userId ?? "",            // index5
    ],
    doubles: [
      Date.now(),                    // double1 — timestamp unix ms
      event.durationMs ?? 0,         // double2
      event.tokenCount ?? 0,         // double3
      event.rating ?? 0,             // double4
    ],
    blobs: [
      event.errorCode ?? "",         // blob1
      event.model ?? "",             // blob2
      event.toolName ?? "",          // blob3
      event.planTier ?? "",          // blob4
      JSON.stringify(metadata),      // blob5
    ],
  });
}
</file>

<file path="workers/analytics/src/index.ts">
/**
 * Naelao Analytics Worker — Phase 8: Analytics + Observability
 *
 * Gap IDs fulfilled:
 *   G-H01  CF Analytics Engine write path (writeEvent)
 *   G-H02  Analytics query (space / tenant / platform metrics via REST API)
 *   G-H03  KV metrics cache (5-min TTL per space/tenant)
 *   G-H04  Queue consumer — drain analytics event queue into Analytics Engine
 *
 * Routing note: The router worker should forward /analytics/* and /metrics/*
 * requests to this worker via an ANALYTICS_WORKER service binding.
 * e.g.  fetch(env.ANALYTICS_WORKER, request)  for paths matching the above.
 *
 * Two modes:
 *   1. Ingest  — POST /events  (internal, service-binding-only — no JWT)
 *   2. Query   — GET  /metrics/space/:spaceId
 *               GET  /metrics/tenant
 *               GET  /metrics/platform  (admin, requires x-naelao-role: owner)
 */

import { Hono } from "hono";
import { errorResponse, requestId, requireInternalHmac } from "@naelao/http";
import { type AnalyticsEvent, writeEvent } from "./events.js";
import {
  getPlatformMetrics,
  getSpaceMetrics,
  getTenantMetrics,
} from "./query.js";

// ── Environment ───────────────────────────────────────────────────────────────

export interface AnalyticsEnv {
  ENVIRONMENT: string;
  CF_ACCOUNT_ID: string;
  CF_ANALYTICS_API_TOKEN: string;
  ANALYTICS: AnalyticsEngineDataset;
  METRICS_CACHE: KVNamespace;
  /** WS-7 (audit plan): /metrics/space/:spaceId had no auth at all (not even the header-trust
   *  check every other internal worker had before its own HMAC hardening) and its cache key
   *  didn't fold in tenantId — any caller reaching this worker with a spaceId it didn't own could
   *  read another tenant's cached metrics for up to 5 minutes. Gated with the same
   *  requireInternalHmac convention + a real ownership check against PLATFORM_DB. */
  PLATFORM_SECRET: string;
  PLATFORM_DB: D1Database;
}

async function verifySpaceOwnership(db: D1Database, spaceId: string, tenantId: string): Promise<boolean> {
  const row = await db
    .prepare("SELECT 1 FROM spaces WHERE id = ? AND tenant_id = ? AND status != 'deleted'")
    .bind(spaceId, tenantId)
    .first();
  return row !== null;
}

// ── Helpers ───────────────────────────────────────────────────────────────────

/** Parse and validate a period query param. Allowed: 7, 30, 90. Default: 30. */
function parsePeriod(raw: string | null): number {
  const n = parseInt(raw ?? "30", 10);
  if (n === 7 || n === 30 || n === 90) return n;
  return 30;
}

/** Minimal structural validation for an inbound AnalyticsEvent. */
function isValidEvent(obj: unknown): obj is AnalyticsEvent {
  if (!obj || typeof obj !== "object") return false;
  const e = obj as Record<string, unknown>;
  return (
    typeof e["eventType"] === "string" &&
    e["eventType"].length > 0 &&
    typeof e["tenantId"] === "string" &&
    e["tenantId"].length > 0
  );
}

/** Write a batch of events to Analytics Engine, silently dropping invalid ones. */
function writeBatch(
  dataset: AnalyticsEngineDataset,
  events: unknown[]
): number {
  let written = 0;
  for (const raw of events) {
    if (!isValidEvent(raw)) continue;
    try {
      writeEvent(dataset, raw);
      written++;
    } catch {
      // Silently drop — never fail the caller due to analytics
    }
  }
  return written;
}

// G-A11: Validate required secrets at startup
function validateEnv(env: AnalyticsEnv): void {
  const required = ["CF_ACCOUNT_ID", "CF_ANALYTICS_API_TOKEN"] as const;
  for (const key of required) {
    if (!env[key]) throw new Error(`Missing required secret: ${key}`);
  }
}

// ── Hono app ──────────────────────────────────────────────────────────────────

const app = new Hono<{ Bindings: AnalyticsEnv }>();
app.use("*", requestId);
app.use("*", async (c, next) => { validateEnv(c.env); await next(); });

// ── POST /events ──────────────────────────────────────────────────────────────
// Internal ingest endpoint — no JWT auth required.
// Called by other workers via CF service binding.
// Accepts a single AnalyticsEvent or { events: AnalyticsEvent[] } (batch ≤100).
app.post("/events", async (c) => {
  let body: unknown;
  try {
    body = await c.req.json();
  } catch {
    // If the caller sends malformed JSON, return OK to avoid blocking them
    return c.json({ ok: true, count: 0 });
  }

  let count = 0;

  if (
    body !== null &&
    typeof body === "object" &&
    "events" in (body as object)
  ) {
    // Batch mode
    const batch = (body as { events: unknown }).events;
    const events = Array.isArray(batch) ? batch.slice(0, 100) : [];
    count = writeBatch(c.env.ANALYTICS, events);
  } else {
    // Single event mode
    count = writeBatch(c.env.ANALYTICS, [body]);
  }

  return c.json({ ok: true, count });
});

// ── GET /metrics/space/:spaceId ───────────────────────────────────────────────
// Gated with requireInternalHmac (WS-7) — this worker is never directly reachable
// (workers_dev = false) but had no verification of its own before this pass.
// Cached in METRICS_CACHE for 5 minutes, keyed per-tenant so one tenant's cache entry can
// never be served back to a different tenant querying the same spaceId.
app.get("/metrics/space/:spaceId", requireInternalHmac((c) => (c.env as unknown as AnalyticsEnv).PLATFORM_SECRET), async (c) => {
  const tenantId = c.req.header("x-naelao-tenant-id") ?? "";
  if (!tenantId) {
    return c.json(
      { error_code: "unauthorized", message: "Missing x-naelao-tenant-id header" },
      401
    );
  }

  const spaceId = c.req.param("spaceId");
  const owns = await verifySpaceOwnership(c.env.PLATFORM_DB, spaceId, tenantId);
  if (!owns) {
    return c.json({ error_code: "not_found", message: "Space not found" }, 404);
  }
  const period = parsePeriod(new URL(c.req.url).searchParams.get("period"));

  const cacheKey = `metrics:space:${tenantId}:${spaceId}:${period}`;
  const cached = await c.env.METRICS_CACHE.get(cacheKey, "text");
  if (cached) {
    return new Response(cached, {
      headers: {
        "Content-Type": "application/json",
        "X-Cache": "HIT",
      },
    });
  }

  const accountId = c.env.CF_ACCOUNT_ID;
  const apiToken = c.env.CF_ANALYTICS_API_TOKEN;

  if (!accountId || !apiToken) {
    return c.json(
      {
        error_code: "configuration_error",
        message: "CF_ACCOUNT_ID and CF_ANALYTICS_API_TOKEN must be configured",
      },
      503
    );
  }

  const metrics = await getSpaceMetrics(
    accountId,
    apiToken,
    spaceId,
    tenantId,
    period
  );

  const body = JSON.stringify(metrics);
  // Cache for 5 minutes (300s)
  await c.env.METRICS_CACHE.put(cacheKey, body, { expirationTtl: 300 });

  return new Response(body, {
    headers: {
      "Content-Type": "application/json",
      "X-Cache": "MISS",
    },
  });
});

// ── GET /metrics/tenant ───────────────────────────────────────────────────────
// Authenticated — requires x-naelao-tenant-id header.
// Cached in METRICS_CACHE for 5 minutes.
app.get("/metrics/tenant", async (c) => {
  const tenantId = c.req.header("x-naelao-tenant-id") ?? "";
  if (!tenantId) {
    return c.json(
      { error_code: "unauthorized", message: "Missing x-naelao-tenant-id header" },
      401
    );
  }

  const period = parsePeriod(new URL(c.req.url).searchParams.get("period"));
  const cacheKey = `metrics:tenant:${tenantId}:${period}`;

  const cached = await c.env.METRICS_CACHE.get(cacheKey, "text");
  if (cached) {
    return new Response(cached, {
      headers: {
        "Content-Type": "application/json",
        "X-Cache": "HIT",
      },
    });
  }

  const accountId = c.env.CF_ACCOUNT_ID;
  const apiToken = c.env.CF_ANALYTICS_API_TOKEN;

  if (!accountId || !apiToken) {
    return c.json(
      {
        error_code: "configuration_error",
        message: "CF_ACCOUNT_ID and CF_ANALYTICS_API_TOKEN must be configured",
      },
      503
    );
  }

  const metrics = await getTenantMetrics(accountId, apiToken, tenantId, period);

  const body = JSON.stringify(metrics);
  await c.env.METRICS_CACHE.put(cacheKey, body, { expirationTtl: 300 });

  return new Response(body, {
    headers: {
      "Content-Type": "application/json",
      "X-Cache": "MISS",
    },
  });
});

// ── GET /metrics/platform ─────────────────────────────────────────────────────
// Admin-only: requires both x-naelao-role: owner header AND a shared
// internal secret (x-naelao-platform-secret) to prevent external callers.
// No KV cache — admins always get fresh data.
app.get("/metrics/platform", async (c) => {
  // Role check: must be platform owner
  const role = c.req.header("x-naelao-role") ?? "";
  if (role !== "owner") {
    return c.json(
      { error_code: "forbidden", message: "Platform metrics require owner role" },
      403
    );
  }

  // Internal secret check: prevents external access even if someone sends the
  // owner role header through a misconfigured proxy.
  // The router must set x-naelao-platform-secret from CF Workers Secrets before
  // forwarding to this worker via service binding.
  const platformSecret = c.req.header("x-naelao-platform-secret") ?? "";
  // If no secret is configured in the environment (e.g. dev), skip the check.
  // In production, PLATFORM_ANALYTICS_SECRET must be set.
  const envSecret =
    (c.env as unknown as Record<string, string>)["PLATFORM_ANALYTICS_SECRET"] ??
    "";
  if (envSecret && platformSecret !== envSecret) {
    return c.json(
      { error_code: "forbidden", message: "Invalid internal secret" },
      403
    );
  }

  const period = parsePeriod(new URL(c.req.url).searchParams.get("period"));

  const accountId = c.env.CF_ACCOUNT_ID;
  const apiToken = c.env.CF_ANALYTICS_API_TOKEN;

  if (!accountId || !apiToken) {
    return c.json(
      {
        error_code: "configuration_error",
        message: "CF_ACCOUNT_ID and CF_ANALYTICS_API_TOKEN must be configured",
      },
      503
    );
  }

  const metrics = await getPlatformMetrics(accountId, apiToken, period);

  return c.json(metrics);
});

// ── Error handler ─────────────────────────────────────────────────────────────

app.onError((err, c) =>
  errorResponse(err, c.get("requestId") ?? "unknown")
);

// ── 404 catch-all ─────────────────────────────────────────────────────────────

app.notFound((c) =>
  c.json({ error_code: "not_found", message: "Route not found" }, 404)
);

// ── Queue consumer ────────────────────────────────────────────────────────────
// G-H04: Drains the naelao-analytics-events queue into CF Analytics Engine.
// Each message in the batch is an AnalyticsEvent written by other workers.
// Messages are ack'd individually after a successful write so that transient
// errors cause a retry (message stays in queue) rather than silent data loss.

export async function queue(
  batch: MessageBatch<AnalyticsEvent>,
  env: AnalyticsEnv
): Promise<void> {
  for (const message of batch.messages) {
    try {
      if (isValidEvent(message.body)) {
        writeEvent(env.ANALYTICS, message.body);
      }
      // Ack even for invalid messages — we don't want to retry unparseable events
      message.ack();
    } catch (err) {
      console.error("[analytics/queue] failed to write event:", err);
      // Retry: do NOT ack — CF Queues will retry up to max_retries
      message.retry();
    }
  }
}

// ── Default export ────────────────────────────────────────────────────────────

export default {
  fetch: app.fetch,
  queue: queue as ExportedHandlerQueueHandler<AnalyticsEnv>,
} satisfies ExportedHandler<AnalyticsEnv>;
</file>

<file path="workers/analytics/src/query.ts">
// G-H02: Analytics query functions via CF Analytics Engine SQL API (ClickHouse dialect)
// The Analytics Engine SQL API is REST-only — it is NOT available as a Worker binding.
// Must use fetch() with the CF REST API.

// ── Internal query helper ─────────────────────────────────────────────────────

interface AnalyticsEngineResponse {
  data: Record<string, unknown>[];
  meta: unknown;
  rows: number;
  rows_before_limit_at_least?: number;
}

async function queryAnalytics(
  accountId: string,
  apiToken: string,
  sql: string
): Promise<{ data: Record<string, unknown>[]; meta: unknown }> {
  const url = `https://api.cloudflare.com/client/v4/accounts/${accountId}/analytics_engine/sql`;

  const resp = await fetch(url, {
    method: "POST",
    headers: {
      Authorization: `Bearer ${apiToken}`,
      "Content-Type": "text/plain",
    },
    body: sql,
  });

  if (!resp.ok) {
    const text = await resp.text().catch(() => "(no body)");
    throw new Error(
      `Analytics Engine query failed: HTTP ${resp.status} — ${text}`
    );
  }

  const result = (await resp.json()) as AnalyticsEngineResponse;
  return { data: result.data ?? [], meta: result.meta ?? null };
}

// ── Helper: safe number coercion from query result ────────────────────────────

function toNum(val: unknown, fallback = 0): number {
  const n = Number(val);
  return isFinite(n) ? n : fallback;
}

// ── Space-level metrics ───────────────────────────────────────────────────────

export interface SpaceMetrics {
  totalSessions: number;
  totalMessages: number;
  avgSessionDuration: number; // ms
  totalTokens: number;
  avgRating: number;
  errorRate: number; // 0-1
}

export async function getSpaceMetrics(
  accountId: string,
  apiToken: string,
  spaceId: string,
  tenantId: string,
  periodDays = 30
): Promise<SpaceMetrics> {
  // ClickHouse dialect — index1=eventType, index2=tenantId, index3=spaceId
  // double1=timestamp unix ms, double2=durationMs, double3=tokenCount, double4=rating
  const sql = `
SELECT
  countIf(index1 = 'session_start')       AS total_sessions,
  countIf(index1 = 'message_sent')        AS total_messages,
  avgIf(double2, index1 = 'session_end')  AS avg_duration_ms,
  sumIf(double3, index1 = 'agent_response') AS total_tokens,
  avgIf(double4, index1 = 'rating_submitted' AND double4 > 0) AS avg_rating,
  if(count() = 0, 0, countIf(index1 = 'error') / count()) AS error_rate
FROM naelao_analytics
WHERE index2 = '${tenantId}'
  AND index3 = '${spaceId}'
  AND toDateTime(double1 / 1000) >= now() - INTERVAL ${periodDays} DAY
`.trim();

  const { data } = await queryAnalytics(accountId, apiToken, sql);
  const row = data[0] ?? {};

  return {
    totalSessions: toNum(row["total_sessions"]),
    totalMessages: toNum(row["total_messages"]),
    avgSessionDuration: toNum(row["avg_duration_ms"]),
    totalTokens: toNum(row["total_tokens"]),
    avgRating: toNum(row["avg_rating"]),
    errorRate: toNum(row["error_rate"]),
  };
}

// ── Tenant-level metrics ──────────────────────────────────────────────────────

export interface TenantMetrics {
  totalSessions: number;
  totalMessages: number;
  totalTokens: number;
  activeSpaces: number;
  topSpaces: Array<{ spaceId: string; sessions: number }>;
}

export async function getTenantMetrics(
  accountId: string,
  apiToken: string,
  tenantId: string,
  periodDays = 30
): Promise<TenantMetrics> {
  // Two queries: aggregate totals + per-space breakdown for top spaces
  const aggregateSql = `
SELECT
  countIf(index1 = 'session_start')           AS total_sessions,
  countIf(index1 = 'message_sent')            AS total_messages,
  sumIf(double3, index1 = 'agent_response')   AS total_tokens,
  uniqIf(index3, index1 = 'session_start' AND index3 != '') AS active_spaces
FROM naelao_analytics
WHERE index2 = '${tenantId}'
  AND toDateTime(double1 / 1000) >= now() - INTERVAL ${periodDays} DAY
`.trim();

  const topSpacesSql = `
SELECT
  index3                              AS space_id,
  countIf(index1 = 'session_start')  AS sessions
FROM naelao_analytics
WHERE index2 = '${tenantId}'
  AND index3 != ''
  AND toDateTime(double1 / 1000) >= now() - INTERVAL ${periodDays} DAY
GROUP BY index3
ORDER BY sessions DESC
LIMIT 10
`.trim();

  const [aggResult, topResult] = await Promise.all([
    queryAnalytics(accountId, apiToken, aggregateSql),
    queryAnalytics(accountId, apiToken, topSpacesSql),
  ]);

  const agg = aggResult.data[0] ?? {};
  const topSpaces = topResult.data.map((r) => ({
    spaceId: String(r["space_id"] ?? ""),
    sessions: toNum(r["sessions"]),
  }));

  return {
    totalSessions: toNum(agg["total_sessions"]),
    totalMessages: toNum(agg["total_messages"]),
    totalTokens: toNum(agg["total_tokens"]),
    activeSpaces: toNum(agg["active_spaces"]),
    topSpaces,
  };
}

// ── Platform-level metrics (admin) ────────────────────────────────────────────

export interface PlatformMetrics {
  totalSessions: number;
  totalTenants: number;
  totalMessages: number;
  errorRate: number;
  p95LatencyMs: number;
}

export async function getPlatformMetrics(
  accountId: string,
  apiToken: string,
  periodDays = 30
): Promise<PlatformMetrics> {
  const sql = `
SELECT
  countIf(index1 = 'session_start')              AS total_sessions,
  uniqIf(index2, index2 != '')                   AS total_tenants,
  countIf(index1 = 'message_sent')               AS total_messages,
  if(count() = 0, 0, countIf(index1 = 'error') / count()) AS error_rate,
  quantileIf(0.95)(double2, index1 = 'agent_response' AND double2 > 0) AS p95_latency_ms
FROM naelao_analytics
WHERE toDateTime(double1 / 1000) >= now() - INTERVAL ${periodDays} DAY
`.trim();

  const { data } = await queryAnalytics(accountId, apiToken, sql);
  const row = data[0] ?? {};

  return {
    totalSessions: toNum(row["total_sessions"]),
    totalTenants: toNum(row["total_tenants"]),
    totalMessages: toNum(row["total_messages"]),
    errorRate: toNum(row["error_rate"]),
    p95LatencyMs: toNum(row["p95_latency_ms"]),
  };
}
</file>

