    : `spaces/${this.spaceId}/assistants/${this.userId}/skills/${skill.id}.json`;
  await this.env.R2.put(path, JSON.stringify(skill));
}
```
Add a userId assertion guard at the top of any R2 write method in AssistantDO that runs in shared mode: if (this.isSharedMode &amp;&amp; !userId) throw new Error('...'); to catch bugs early.</p></div>
