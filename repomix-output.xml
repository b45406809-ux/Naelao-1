            <td>50 MB / 1 GB</td>
          </tr>
        </tbody>
      </table>

      <h3>What Standard Does Not Provide</h3>
      <p>Standard intentionally omits capabilities that require elevated infrastructure. This keeps the provisioning
        fast, the security surface small, and the billing predictable:</p>
      <ul class="fl">
        <li><strong>No WalletDO</strong> — no autonomous spending, no credit balance, no x402 payment flows. Agents
          cannot purchase on behalf of users.</li>
        <li><strong>No WorkflowRegistryDO</strong> — no persistent background workflows. Tasks run within a single agent
          turn; nothing runs while the user is offline.</li>
        <li><strong>No external portal</strong> — the Space cannot serve a public-facing URL with an embedded agent.
          Standard Spaces are private by default.</li>
        <li><strong>No custom RemoteLoop</strong> — Standard uses the built-in chat loop. There is no way to inject a
          custom reasoning Worker.</li>
        <li><strong>No cron jobs</strong> — Agents do not run on a schedule. For scheduled execution, upgrade to
          Launchpad or Workers.</li>
      </ul>

      <h3>The Provisioner Path</h3>
      <p>When a user creates a Standard Space, <code>SpaceTypeRegistryDO</code> runs the Standard provisioner. It is the
        fastest provisioner on the platform because there are no special DOs to spin up:</p>
      <pre><code><span class="cm">// workers/naelao-provisioner/src/types/standard.ts</span>
export async function provisionStandard(
  ctx: ProvisionContext
): Promise&lt;ProvisionResult&gt; {
  const { spaceId, userId, env } = ctx;

  <span class="cm">// 1. Create the core SpaceDO stub (every space gets this)</span>
  const spaceDO = env.SPACE_DO.get(env.SPACE_DO.idFromName(spaceId));
  await spaceDO.fetch('http://internal/init', {
    method: 'POST',
    body: JSON.stringify({ spaceId, typeId: 'standard', userId }),
  });

  <span class="cm">// 2. Insert record into SpaceDO SQLite</span>
  await spaceDO.createSpace({
    id: spaceId,
    user_id: userId,
    type_id: 'standard',
    name: ctx.name ?? 'Builder Workspace',
    created_at: new Date().toISOString(),
  });

  <span class="cm">// 3. Create the default project</span>
  const projectId = crypto.randomUUID();
  await spaceDO.createProject({
    id: projectId,
    space_id: spaceId,
    name: 'Default Project',
    created_at: new Date().toISOString(),
  });

  <span class="cm">// 4. Seed R2 with the project root</span>
  await env.R2.put(
    `workspace/projects/${projectId}/.naelao`,
    JSON.stringify({ projectId, spaceId, createdAt: Date.now() })
  );

  <span class="cm">// Standard needs nothing else — no WalletDO, no WorkflowRegistryDO</span>
  return { spaceId, projectId, typeId: 'standard' };
}</code></pre>

