  <!-- ══════════════════════════════════════════════════════
     §53 — NAELAO DEVELOPER SPACE: AGENT SDK USAGE
═══════════════════════════════════════════════════════ -->
  <div class="sep"></div>
  <div class="sec" id="sdk-usage">
    <span class="sec-ey">53 — SDK Usage: Advanced Patterns</span>
    <h2>Advanced Agent SDK Patterns — What Every Developer Must Know</h2>
    <div class="bar"></div>
    <p class="lead">The @naelao/agent-sdk provides the base class. But building a production-quality custom agent
      requires understanding four advanced patterns: multi-turn context management, structured output extraction,
      sub-agent coordination, and graceful degradation. This section documents all four with complete implementations.
    </p>

    <h3>Pattern 1 — Multi-Turn Context Management</h3>
    <p>The most common mistake in custom agents: not managing context properly. As conversation grows, you hit token
      limits. The SessionManager provides tools to handle this gracefully.</p>
    <pre><code><span class="cm">// Pattern: Context-aware multi-turn agent
// Compacts old context while preserving the most recent and important messages</span>

import { NaelaoAgent, AgentInput, AgentEvent, FiberContext } from '@naelao/agent-sdk';

export class ContextAwareAgent extends NaelaoAgent {
  private readonly MAX_CONTEXT_TOKENS = 150_000; <span class="cm">// leave room for response</span>

  async *run(input: AgentInput): AsyncGenerator&lt;AgentEvent&gt; {
    const session = this.getSession(input.threadId) ?? this.createSession(input.threadId);
    this.addMessage(session.id, { role: 'user', content: input.message });

    <span class="cm">// Check context size BEFORE calling LLM
    // If too large, compact first to avoid hitting token limits mid-conversation</span>
    const messages = this.getSessionMessages(session.id);
    const estimatedTokens = this.estimateTokens(messages);

    if (estimatedTokens > this.MAX_CONTEXT_TOKENS * 0.8) {
      yield { type: 'thinking', content: 'Organizing conversation context...' };
      await this.compactSession(session.id);
      yield { type: 'thinking', content: 'Context organized. Continuing...' };
    }

    <span class="cm">// Now safe to call LLM with manageable context</span>
    const response = await this.callLLM({
      messages: this.getSessionMessages(session.id),
      system: [{ type: 'text', text: this.getSystemPrompt(), cache_control: { type: 'ephemeral' } }],
      onToken: (delta) => this.broadcast({ type: 'token', delta })
    });

    this.addMessage(session.id, {
      role: 'assistant',
      content: response.content
    });

    yield { type: 'complete', content: response.content };
  }

  private estimateTokens(messages: Message[]): number {
    <span class="cm">// Simple estimate: ~4 chars per token (good enough for routing decisions)
    // For exact billing, use the Anthropic tokenizer via agentpress/prompt-cache.ts</span>
    return messages.reduce((acc, m) => acc + m.content.length / 4, 0);
  }

  async onFiberRecovered(ctx: FiberContext): Promise&lt;void&gt; {
    <span class="cm">// This agent uses foreground mode — no fiber recovery</span>
  }
}</code></pre>

    <h3>Pattern 2 — Structured Output Extraction</h3>
    <p>Many agent tasks require structured JSON output from the LLM. The most reliable way is to ask for JSON in the
      system prompt AND validate it before returning. Never trust unvalidated LLM JSON output.</p>
    <pre><code><span class="cm">// Pattern: Reliable structured output extraction
// Uses a retry loop for validation rather than just hoping the LLM is correct</span>

export async function extractStructuredOutput&lt;T&gt;(params: {
  prompt: string;
  schema: JSONSchema;
  llmClient: Anthropic;
  maxAttempts?: number;
}): Promise&lt;T&gt; {
  const { prompt, schema, llmClient, maxAttempts = 3 } = params;

  for (let attempt = 1; attempt &lt;= maxAttempts; attempt++) {
    const response = await llmClient.messages.create({
      model: 'claude-haiku-4-5',  <span class="cm">// use haiku for structured extraction — fast and cheap</span>
      max_tokens: 2048,
      system: `You are a JSON extraction assistant. Return ONLY valid JSON matching this schema:
${JSON.stringify(schema, null, 2)}

Rules:
- Return ONLY the JSON object, no explanation, no markdown, no code fences
- Every required field must be present
- String values must be strings, numbers must be numbers
- If you cannot extract a required field, use the most sensible default`,
      messages: [
        { role: 'user', content: prompt },
        ...(attempt > 1 ? [{
          role: 'user' as const,
          content: `Your previous response was not valid JSON. Attempt ${attempt}/${maxAttempts}. Try again with valid JSON only.`
        }] : [])
      ]
    });

    const text = response.content[0].text?.trim() ?? '';

    <span class="cm">// Strip any accidental code fences (LLM sometimes adds them despite instructions)</span>
    const jsonText = text
      .replace(/^```(?:json)?
/, '')
      .replace(/
```$/, '')
      .trim();

    try {
      const parsed = JSON.parse(jsonText) as T;

      <span class="cm">// Validate against schema using ajv (bundled in agent SDK)</span>
      const validationErrors = validateAgainstSchema(parsed, schema);
      if (validationErrors.length === 0) {
        return parsed; <span class="cm">// ✓ Valid — return it</span>
      }

      if (attempt === maxAttempts) {
        throw new Error(`Structured output validation failed after ${maxAttempts} attempts: ${validationErrors.join(', ')}`);
      }
      <span class="cm">// else: loop continues to next attempt</span>
    } catch (e) {
      if (attempt === maxAttempts) throw e;
      <span class="cm">// loop continues</span>
    }
  }

  throw new Error('extractStructuredOutput: unreachable');
}</code></pre>

    <h3>Pattern 3 — Sub-Agent Coordination</h3>
    <p>For complex tasks requiring parallelism, the parent agent spawns sub-agents via Project Think's Facets API.
      Sub-agents are colocated (same CF machine) and communicate via typed RPC — zero network hop.</p>
    <pre><code><span class="cm">// Pattern: Parent agent spawning sub-agents for parallel research
// Each sub-agent handles one research topic, parent synthesizes results</span>

export class ResearchCoordinatorAgent extends NaelaoAgent {

  async *run(input: AgentInput): AsyncGenerator&lt;AgentEvent&gt; {
    const session = this.createSession(input.threadId);
    this.addMessage(session.id, { role: 'user', content: input.message });

    yield { type: 'thinking', content: 'Breaking down research task...' };

    <span class="cm">// Step 1: Decompose the research task into sub-topics</span>
    const decomposition = await extractStructuredOutput&lt;{topics: string[]}&gt;({
      prompt: `Decompose this research request into 3-5 independent research topics:
"${input.message}"`,
      schema: {
        type: 'object',
        required: ['topics'],
        properties: {
          topics: { type: 'array', items: { type: 'string' }, minItems: 2, maxItems: 5 }
        }
      },
      llmClient: this.createLLMClient()
    });

    yield { type: 'thinking', content: `Researching ${decomposition.topics.length} topics in parallel...` };

    <span class="cm">// Step 2: Spawn a sub-agent for each topic (Facets — colocated, typed RPC)</span>
    const subAgentResults = await Promise.all(
      decomposition.topics.map(async (topic, i) =&gt; {
        const subAgent = this.spawnSubAgent(TopicResearchAgent, `topic-${i}`);
        return subAgent.research(topic); <span class="cm">// typed RPC call — returns string</span>
      })
    );

    yield { type: 'thinking', content: 'Synthesizing findings...' };

    <span class="cm">// Step 3: Synthesize all sub-agent results</span>
    const synthesis = await this.callLLM({
      messages: [{
        role: 'user',
        content: `Synthesize these research findings into a coherent report on: "${input.message}"

${
          decomposition.topics.map((topic, i) =>
            `## ${topic}
${subAgentResults[i]}`
          ).join('

')
        }`
      }],
      onToken: (delta) => this.broadcast({ type: 'token', delta })
    });

    <span class="cm">// Save synthesis to workspace for reference</span>
    await this.writeWorkspace(
      `research/${Date.now()}-synthesis.md`,
      `# Research: ${input.message}

${synthesis.content}`,
      `Research synthesis: ${input.message.slice(0, 50)}`
    );

    yield { type: 'complete', content: synthesis.content };
  }

  async onFiberRecovered(_ctx: FiberContext): Promise&lt;void&gt; {}
}

<span class="cm">// Sub-agent class — handles one research topic</span>
class TopicResearchAgent extends NaelaoAgent {
  <span class="cm">// This method is called via typed RPC from parent agent
  // It executes colocated — same CF machine, no network hop</span>
  async research(topic: string): Promise&lt;string&gt; {
    const searchResult = await this.callSkill('web-search', 'search', {
      query: topic,
      max_results: '5',
      search_depth: 'advanced'
    });

    const synthesis = await this.callLLM({
      messages: [{
        role: 'user',
        content: `Summarize these search results about "${topic}":
${JSON.stringify(searchResult.output)}`
      }]
    });

    return synthesis.content;
  }

  async *run(_input: AgentInput): AsyncGenerator&lt;AgentEvent&gt; {
    yield { type: 'complete', content: 'TopicResearchAgent used via RPC, not direct run' };
  }

  async onFiberRecovered(_ctx: FiberContext): Promise&lt;void&gt; {}
}</code></pre>

    <h3>Pattern 4 — Graceful Degradation</h3>
    <p>Production agents must handle failures gracefully. When a tool fails, the agent should explain what happened,
      attempt alternatives, and recover — not crash the entire run.</p>
    <pre><code><span class="cm">// Pattern: Tool call with graceful degradation and retry</span>

export async function callToolWithRetry(params: {
  toolName: string;
  parameters: Record&lt;string, string&gt;;
  agent: NaelaoAgent;
  maxAttempts?: number;
  fallback?: () =&gt; Promise&lt;ToolResult&gt;;
}): Promise&lt;ToolResult&gt; {
  const { toolName, parameters, agent, maxAttempts = 2, fallback } = params;

  for (let attempt = 1; attempt &lt;= maxAttempts; attempt++) {
    try {
      const result = await agent.callSkill('mcp-hub', toolName, parameters);

      if (!result.success) {
        if (attempt === maxAttempts) {
          <span class="cm">// All attempts failed — try fallback if provided</span>
          if (fallback) {
            console.warn(`[AGENT] Tool ${toolName} failed after ${maxAttempts} attempts. Using fallback.`);
            return fallback();
          }
          return {
            success: false,
            error: `Tool ${toolName} failed: ${result.error}. I could not complete this part of the task.`
          };
        }

        <span class="cm">// Wait before retry with exponential backoff</span>
        await new Promise(resolve => setTimeout(resolve, attempt * 1000));
        continue;
      }

      return result;
    } catch (e) {
      if (attempt === maxAttempts) {
        if (fallback) return fallback();
        return {
          success: false,
          error: `Tool ${toolName} threw an error: ${(e as Error).message}`
        };
      }
      await new Promise(resolve => setTimeout(resolve, attempt * 1000));
    }
  }

  return { success: false, error: 'Tool call failed: max attempts exceeded' };
}</code></pre>
