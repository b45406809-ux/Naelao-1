          <p>Required: Tiered Context Strategy // context-builder.ts — replaces the raw last-50 slice async function buildContext(threadId: string, db: SpaceDB): Promise&lt;Message[]&gt; { const totalCount = db.exec('SELECT COUNT(*) FROM messages WHERE thread_id=?',[threadId]).rows[0][0]; if (totalCount &lt;= 50) { // Under 50: use everything — no compaction needed return db.exec('SELECT * FROM messages WHERE thread_id=? ORDER BY created_at', [threadId]).rows; } // Over 50: three-zone context assembly // Zone 1 — ANCHOR (first 3 messages): always included // Contains the user's original goal and initial context const anchor = db.exec( 'SELECT * FROM messages WHERE thread_id=? ORDER BY created_at LIMIT 3', [threadId] ).rows; // Zone 2 — SUMMARY (messages 4 to N-30): replaced by a generated summary // The…</p>
