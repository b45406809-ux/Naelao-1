<span class="cm">// Annotation payment flow (workers/verticals/annotator.ts)</span>
async function payAnnotator(params: {
  expertUserId: string;
  annotationQualityScore: number; <span class="cm">// 7-10 scale</span>
  vertical: string;
  env: Env;
}): Promise&lt;{ paid: number; platformFee: number }&gt; {

  <span class="cm">// Payment amount scales with quality</span>
  const grossPayment = 0.10 + (params.annotationQualityScore - 7) * 0.05; <span class="cm">// $0.10-$0.25</span>
  const platformFee = grossPayment * 0.15;
  const netPayment = grossPayment - platformFee;

  <span class="cm">// Credit the annotator's WalletDO</span>
  const annotatorWallet = params.env.NAELAO_WALLET_DO.get(
    params.env.NAELAO_WALLET_DO.idFromName(
      `wallet:annotators:${params.expertUserId}`
    )
  );

  await annotatorWallet.fetch(new Request('http://wallet/credit', {
    method: 'POST',
    body: JSON.stringify({
      amount: netPayment,
      description: `Annotation reward: ${params.vertical} vertical`,
      source: 'bootstrap-fund'
    })
  }));

  <span class="cm">// Deduct from bootstrap fund (separate WalletDO for the vertical)</span>
  const verticalFund = params.env.NAELAO_WALLET_DO.get(
    params.env.NAELAO_WALLET_DO.idFromName(
      `wallet:bootstrap-fund:${params.vertical}`
    )
  );

  await verticalFund.fetch(new Request('http://wallet/deduct', {
    method: 'POST',
    body: JSON.stringify({
      amount: grossPayment,  <span class="cm">// full amount (platform fee handled separately)</span>
      description: `Annotation payment to ${params.expertUserId}`,
      vendor: 'annotator-pool',
      category: 'annotation'
    })
  }));

  return { paid: netPayment, platformFee };
}

<span class="cm">// Annotator can withdraw earnings to their bank/PayPal via Stripe Connect</span>
async function withdrawAnnotatorEarnings(
  expertUserId: string,
  amount: number,
  env: Env
): Promise&lt;{ withdrawalId: string }&gt; {
  const wallet = env.NAELAO_WALLET_DO.get(
