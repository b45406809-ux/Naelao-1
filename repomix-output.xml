```typescript
async submitAnnotation(userId: string, taskId: string, annotation: object) {
  const holdId = crypto.randomUUID();
  // 1. Hold payment — reserve without delivering
  await walletDO.holdPayment(holdId, { userId, amountCents: ANNOTATION_RATE_CENTS });
  // 2. Store annotation with hold reference
  this.ctx.storage.sql.exec(
    "INSERT INTO annotations (id, task_id, user_id, data, hold_id, status) VALUES (?,?,?,?,?,'pending')",
    crypto.randomUUID(), taskId, userId, JSON.stringify(annotation), holdId
  );
  // 3. Queue for async scoring (returns immediately)
  await env.ANNOTATION_SCORE_QUEUE.send({ holdId, taskId, userId, annotation });
  return { holdId, status: "pending_review" };
}

// After scoring:
async settleAnnotation(holdId: string, score: number) {
  if (score &gt;= ACCEPTANCE_THRESHOLD) {
    await walletDO.releaseHold(holdId); // pay annotator
  } else {
    await walletDO.cancelHold(holdId);  // refund bootstrap fund
