<file path="workers/spaces/src/product-end-user-routes.ts">
// Three-Tier Platform Model, Phase 6 — public, UNAUTHENTICATED end-user signup/login for
// products configured with authProvider.provider === 'naelao-native' (Journey 1B: "End user
// signs up or is invited via the builder's configured auth provider"). ProductUserDO (Phase 2)
// mints and verifies SESSIONS but never verifies an identity in the first place — that's what
// this file adds: a credential (email + password) scoped entirely to one product, per the
// spec's Tier 2 definition. Registered on the router's UNAUTHENTICATED path (mirrors
// /v1/auth/*), since a visitor has no token at all before signing up.
//
// Other authProvider values (clerk/custom-oidc/saml-sso) verify identity externally — these
// routes reject with 400 if the product isn't configured for naelao-native, rather than
// pretending to support a flow that isn't built.

import type { Hono } from "hono";
import { hashPassword, verifyPassword } from "@naelao/crypto";
import type { HashedPassword } from "@naelao/crypto";
import { getDOName } from "@naelao/crypto";
import type { SpaceTypeProductConfig } from "./do/SpaceTypeRegistryDO.js";

export interface ProductEndUserRoutesEnv {
  PLATFORM_DB: D1Database;
  PLATFORM_SECRET: string;
  PRODUCT_USER_DO: DurableObjectNamespace;
  SPACE_TYPE_REGISTRY_DO: DurableObjectNamespace;
  NAELAO_CONFIG_KV: KVNamespace;
  NOTIFICATIONS_WORKER?: Fetcher;
  /** Public base URL of apps/shell (e.g. "https://app.naelao.com"), used to build a clickable
   *  verification link ("${base}/p/{slug}/verify-email?token=..."). Deliberately left unset by
   *  default rather than guessing a production domain — when unset, the email still carries the
   *  raw token, and the shell's verify-email page accepts a manually pasted token, so signup
   *  verification works either way, not just when this happens to be configured correctly. */
  PRODUCT_SHELL_URL?: string;
}

async function sha256Hex(input: string): Promise<string> {
  const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(input));
  return Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, "0")).join("");
}

const RESET_TOKEN_TTL_MS = 60 * 60 * 1000; // 1 hour, same order of magnitude as business_invites' 7-day cap but shorter since this grants a live credential change
const VERIFY_TOKEN_TTL_MS = 24 * 60 * 60 * 1000; // 24 hours — long enough that a slow inbox doesn't lock a legitimate signup out of its free credits

async function sendEmail(env: ProductEndUserRoutesEnv, tenantId: string, spaceId: string, to: string, subject: string, body: string): Promise<void> {
  if (!env.NOTIFICATIONS_WORKER) return;
  try {
    await env.NOTIFICATIONS_WORKER.fetch(new Request("http://notifications-worker/internal/notify", {
      method: "POST",
      headers: { "content-type": "application/json", "x-naelao-tenant-id": tenantId },
      body: JSON.stringify({ channel: "email", space_id: spaceId, to, subject, body }),
    }));
  } catch { /* best-effort — never blocks the caller's own response */ }
}

async function issueVerificationToken(env: ProductEndUserRoutesEnv, productId: string, endUserId: string, tenantId: string, email: string, slug: string | null): Promise<void> {
  const token = crypto.randomUUID() + crypto.randomUUID();
  const tokenHash = await sha256Hex(token);
  const expiresAt = new Date(Date.now() + VERIFY_TOKEN_TTL_MS).toISOString();
  await env.PLATFORM_DB.prepare(
    `INSERT INTO email_verification_tokens (id, product_space_id, end_user_id, token_hash, expires_at)
     VALUES (?, ?, ?, ?, ?)`
  ).bind(crypto.randomUUID(), productId, endUserId, tokenHash, expiresAt).run();
  const link = env.PRODUCT_SHELL_URL && slug
    ? `\n\nOr click this link: ${env.PRODUCT_SHELL_URL}/p/${slug}/verify-email?token=${token}`
    : "";
  await sendEmail(env, tenantId, productId, email, "Verify your email",
    `Verification token: ${token}${link}\n\nThis token expires in 24 hours. Verifying unlocks your free starting credits.`);
}

interface ProductRow {
  id: string;
  tenant_id: string;
  spacetype_id: string;
  config_json: string | null;
  product_slug: string | null;
}

// Metering enforcement pass, follow-up: a product with pricingConfig.model === "free" (or no
// pricingConfig at all — a product that never configured pricing is closer to "free" than to any
// paid model) is an explicit builder signal that end users shouldn't need to pay to use it. Before
// the pre-run credit gate existed, that "just worked" by accident (every run was unmetered). Now
// that runs are actually gated on a positive balance, "free" and "0 credits granted" would mean
// the same thing — instant lockout on message one — unless a builder happens to also fill in
// creditsIncludedPerMonth (a field the wizard only shows for the "credits" pricing model in the
// first place). This platform default keeps a "Free" product usable out of the box without
// reintroducing unmetered/unlimited runs. Deliberately NOT applied to "credits"/"subscription"/
// "seats" models with an unset or explicit 0 allowance — those models are the builder's own
// explicit monetization choice ("pay first"), which this default must not override.
// Exported so index.ts's monthly-refresh route (Tier 2 metering follow-up) resolves the SAME
// free-tier default this signup grant uses — a free/unconfigured product refreshes 100 credits
// every month, not just once, without two constants drifting apart.
export const FREE_TIER_DEFAULT_SIGNUP_CREDITS = 100;

async function loadProductAuthConfig(
  env: ProductEndUserRoutesEnv,
  productId: string
): Promise<{ product: ProductRow; authConfig: SpaceTypeProductConfig["authProvider"]; signupCredits: number } | null> {
  const product = await env.PLATFORM_DB.prepare(
    "SELECT id, tenant_id, spacetype_id, config_json, product_slug FROM spaces WHERE id = ? AND status != 'deleted'"
  ).bind(productId).first<ProductRow>();
  if (!product) return null;

  let authConfig: SpaceTypeProductConfig["authProvider"] | undefined;
  let signupCredits = 0;
  if (product.config_json) {
    try {
      const parsed = JSON.parse(product.config_json) as { productConfig?: SpaceTypeProductConfig };
      authConfig = parsed.productConfig?.authProvider;
      // Metering enforcement pass: `creditsIncludedPerMonth` was builder-configurable through the
      // product creation wizard but nothing ever read it — every new end user started at a
      // permanent 0 balance, which (now that agent runs are gated on a positive balance — see
      // NaelaoAgentDO's pre-run credit check) would otherwise make the free tier unusable from
      // message one. Granted ONCE at signup, not actually monthly-recurring — a real recurring
      // top-up would need its own scheduled sweep per end user, which is a separate, larger
      // feature this fix does not attempt to build.
      const pricingConfig = parsed.productConfig?.pricingConfig;
      const isFreeOrUnconfigured = !pricingConfig || pricingConfig.model === "free";
      signupCredits = pricingConfig?.creditsIncludedPerMonth
        ?? (isFreeOrUnconfigured ? FREE_TIER_DEFAULT_SIGNUP_CREDITS : 0);
    } catch { /* malformed config_json — treat as unset, fall through to default below */ }
  } else {
    // No config_json at all — same "hasn't configured pricing yet" case as above.
    signupCredits = FREE_TIER_DEFAULT_SIGNUP_CREDITS;
  }
  // Default to naelao-native when unset — a product that never configured an auth provider is
  // not "no auth allowed," it's "hasn't picked one yet," and naelao-native is the fastest-to-ship
  // default the spec itself names.
  return { product, authConfig: authConfig ?? { provider: "naelao-native" }, signupCredits };
}

async function productUserDoStub(env: ProductEndUserRoutesEnv, productId: string, endUserId: string, tenantId: string) {
  const doId = env.PRODUCT_USER_DO.idFromName(
    await getDOName("produser", `${productId}:${endUserId}`, tenantId, env.PLATFORM_SECRET)
  );
  return env.PRODUCT_USER_DO.get(doId);
}

export function registerProductEndUserRoutes(app: Hono<any>): void { // eslint-disable-line @typescript-eslint/no-explicit-any
  app.post("/spaces/:spaceId/end-users/signup", async (c) => {
    const env = c.env as ProductEndUserRoutesEnv;
    const productId = c.req.param("spaceId");
    const resolved = await loadProductAuthConfig(env, productId);
    if (!resolved) return c.json({ error_code: "not_found", message: "Product not found" }, 404);
    if (resolved.authConfig?.provider !== "naelao-native") {
      return c.json({ error_code: "unsupported_provider", message: `This product uses ${resolved.authConfig?.provider ?? "an external"} sign-in, not email/password` }, 400);
    }

    const body = await c.req.json<{ email: string; password: string; display_name?: string }>();
    if (!body.email || !body.password || body.password.length < 8) {
      return c.json({ error_code: "bad_request", message: "email and a password (min 8 chars) are required" }, 400);
    }
    const email = body.email.trim().toLowerCase();

    if (resolved.authConfig.allowedEmailDomains?.length) {
      const domain = email.split("@")[1] ?? "";
      if (!resolved.authConfig.allowedEmailDomains.includes(domain)) {
        return c.json({ error_code: "domain_not_allowed", message: `Sign-ups are restricted to: ${resolved.authConfig.allowedEmailDomains.join(", ")}` }, 403);
      }
    }

    const existing = await env.PLATFORM_DB.prepare(
      "SELECT end_user_id FROM product_end_users WHERE product_space_id = ? AND email = ?"
    ).bind(productId, email).first<{ end_user_id: string }>();
    if (existing) return c.json({ error_code: "conflict", message: "An account with this email already exists" }, 409);

    const endUserId = crypto.randomUUID();
    const hashed = await hashPassword(body.password);
    await env.PLATFORM_DB.prepare(
      `INSERT INTO product_end_users (product_space_id, end_user_id, email, display_name, password_hash, first_seen_at, last_seen_at)
       VALUES (?, ?, ?, ?, ?, datetime('now'), datetime('now'))`
    ).bind(productId, endUserId, email, body.display_name ?? null, JSON.stringify(hashed)).run();

    const stub = await productUserDoStub(env, productId, endUserId, resolved.product.tenant_id);
    const sessionRes = await stub.fetch(new Request("http://do/sessions", {
      method: "POST", headers: { "content-type": "application/json" },
      body: JSON.stringify({ auth_provider: "naelao-native" }),
    }));
    const session = await sessionRes.json<{ session_token: string; expires_at: string }>();

    // Security audit follow-up: the free-credit grant used to fire immediately at signup, which
    // is exactly what makes farming free compute as cheap as generating throwaway email
    // addresses — the pre-auth IP rate limiter (router) bounds that but doesn't eliminate a
    // slow/distributed farmer. The account and session are usable immediately either way (a
    // legitimate user isn't blocked from signing in), but the credit grant itself now only
    // fires from verify-email below — see issueVerificationToken. A product with nothing to
    // grant (paid pricing model, no allowance) skips sending a verification email entirely,
    // since there's no farming incentive to close for it.
    //
    // Best-effort, same posture as every other post-account-creation side effect in this file
    // (the credit grant itself, the notify() call): a failure here (e.g. transient D1 issue)
    // must never fail the signup response — the account and session already exist and are
    // valid. Worst case, the end user starts unverified and can retry via resend-verification.
    if (resolved.signupCredits > 0) {
      try {
        await issueVerificationToken(env, productId, endUserId, resolved.product.tenant_id, email, resolved.product.product_slug);
      } catch { /* best-effort */ }
    }

    return c.json({ end_user_id: endUserId, session_token: session.session_token, expires_at: session.expires_at, email_verification_required: resolved.signupCredits > 0 }, 201);
  });

  app.post("/spaces/:spaceId/end-users/login", async (c) => {
    const env = c.env as ProductEndUserRoutesEnv;
    const productId = c.req.param("spaceId");
    const resolved = await loadProductAuthConfig(env, productId);
    if (!resolved) return c.json({ error_code: "not_found", message: "Product not found" }, 404);
    if (resolved.authConfig?.provider !== "naelao-native") {
      return c.json({ error_code: "unsupported_provider", message: `This product uses ${resolved.authConfig?.provider ?? "an external"} sign-in, not email/password` }, 400);
    }

    const body = await c.req.json<{ email: string; password: string }>();
    if (!body.email || !body.password) {
      return c.json({ error_code: "bad_request", message: "email and password are required" }, 400);
    }
    const email = body.email.trim().toLowerCase();

    const row = await env.PLATFORM_DB.prepare(
      "SELECT end_user_id, password_hash, suspended_at FROM product_end_users WHERE product_space_id = ? AND email = ?"
    ).bind(productId, email).first<{ end_user_id: string; password_hash: string | null; suspended_at: string | null }>();
    // Constant-shape response whether the email doesn't exist or the password is wrong — never
    // reveal which one it was.
    if (!row || !row.password_hash) return c.json({ error_code: "invalid_credentials", message: "Incorrect email or password" }, 401);
    const ok = await verifyPassword(body.password, JSON.parse(row.password_hash) as HashedPassword);
    if (!ok) return c.json({ error_code: "invalid_credentials", message: "Incorrect email or password" }, 401);
    if (row.suspended_at) return c.json({ error_code: "suspended", message: "This account has been suspended" }, 403);

    await env.PLATFORM_DB.prepare(
      "UPDATE product_end_users SET last_seen_at = datetime('now') WHERE product_space_id = ? AND end_user_id = ?"
    ).bind(productId, row.end_user_id).run();

    const stub = await productUserDoStub(env, productId, row.end_user_id, resolved.product.tenant_id);
    const sessionRes = await stub.fetch(new Request("http://do/sessions", {
      method: "POST", headers: { "content-type": "application/json" },
      body: JSON.stringify({ auth_provider: "naelao-native" }),
    }));
    const session = await sessionRes.json<{ session_token: string; expires_at: string }>();

    return c.json({ end_user_id: row.end_user_id, session_token: session.session_token, expires_at: session.expires_at });
  });

  // Security audit follow-up: naelao-native end users had a login with no recovery path at all —
  // a lost password meant a lost account. Same shape as business_invites (business-routes.ts):
  // hashed, single-use, expiring token; never reveal whether the email exists (constant response
  // either way — mirrors the login route's own "don't reveal which part was wrong" precedent).
  app.post("/spaces/:spaceId/end-users/request-password-reset", async (c) => {
    const env = c.env as ProductEndUserRoutesEnv;
    const productId = c.req.param("spaceId");
    const resolved = await loadProductAuthConfig(env, productId);
    if (!resolved) return c.json({ error_code: "not_found", message: "Product not found" }, 404);
    if (resolved.authConfig?.provider !== "naelao-native") {
      return c.json({ error_code: "unsupported_provider", message: `This product uses ${resolved.authConfig?.provider ?? "an external"} sign-in, not email/password` }, 400);
    }

    const body = await c.req.json<{ email: string }>();
    const email = (body.email ?? "").trim().toLowerCase();
    const ALWAYS_OK = c.json({ ok: true, message: "If an account with that email exists, a reset link has been sent." });
    if (!email) return ALWAYS_OK;

    const row = await env.PLATFORM_DB.prepare(
      "SELECT end_user_id FROM product_end_users WHERE product_space_id = ? AND email = ? AND password_hash IS NOT NULL"
    ).bind(productId, email).first<{ end_user_id: string }>();
    if (!row) return ALWAYS_OK; // never reveal whether the email exists

    const token = crypto.randomUUID() + crypto.randomUUID();
    const tokenHash = await sha256Hex(token);
    const expiresAt = new Date(Date.now() + RESET_TOKEN_TTL_MS).toISOString();
    await env.PLATFORM_DB.prepare(
      `INSERT INTO password_reset_tokens (id, product_space_id, end_user_id, token_hash, expires_at)
       VALUES (?, ?, ?, ?, ?)`
    ).bind(crypto.randomUUID(), productId, row.end_user_id, tokenHash, expiresAt).run();

    // Best-effort — same precedent as every other notify() call in this codebase: a delivery
    // failure must never leak whether the account exists via a different response shape, so
    // this can't be allowed to change ALWAYS_OK's response.
    await sendEmail(env, resolved.product.tenant_id, productId, email, "Reset your password",
      `Reset token: ${token}\n\nThis token expires in 1 hour. If you didn't request this, ignore this email.`);

    return ALWAYS_OK;
  });

  app.post("/spaces/:spaceId/end-users/reset-password", async (c) => {
    const env = c.env as ProductEndUserRoutesEnv;
    const productId = c.req.param("spaceId");
    const body = await c.req.json<{ token: string; new_password: string }>();
    if (!body.token || !body.new_password || body.new_password.length < 8) {
      return c.json({ error_code: "bad_request", message: "token and a new_password (min 8 chars) are required" }, 400);
    }

    const tokenHash = await sha256Hex(body.token);
    const row = await env.PLATFORM_DB.prepare(
      `SELECT id, end_user_id, expires_at, used_at FROM password_reset_tokens
       WHERE product_space_id = ? AND token_hash = ?`
    ).bind(productId, tokenHash).first<{ id: string; end_user_id: string; expires_at: string; used_at: string | null }>();
    if (!row || row.used_at || new Date(row.expires_at) < new Date()) {
      return c.json({ error_code: "invalid_token", message: "This reset link is invalid or has expired" }, 400);
    }

    const hashed = await hashPassword(body.new_password);
    await env.PLATFORM_DB.prepare(
      "UPDATE product_end_users SET password_hash = ? WHERE product_space_id = ? AND end_user_id = ?"
    ).bind(JSON.stringify(hashed), productId, row.end_user_id).run();
    // Single-use: mark consumed so this exact token can never be replayed.
    await env.PLATFORM_DB.prepare(
      "UPDATE password_reset_tokens SET used_at = datetime('now') WHERE id = ?"
    ).bind(row.id).run();

    // Revoke ALL existing sessions — a stolen session must not survive a password reset.
    // Best-effort: failure must not block the reset itself (the password is already changed).
    try {
      const space = await env.PLATFORM_DB.prepare("SELECT tenant_id FROM spaces WHERE id = ?").bind(productId).first<{ tenant_id: string }>();
      if (space) {
        const stub = await productUserDoStub(env, productId, row.end_user_id, space.tenant_id);
        await stub.fetch("http://do/sessions/revoke", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({}) });
      }
    } catch { /* ignore — password is already updated */ }

    return c.json({ ok: true, message: "Password updated. Sign in with your new password." });
  });

  // Security audit follow-up: closes the free-credit-farming hole at its source — the signup
  // allowance now only grants once a real inbox is proven reachable. Idempotency_key is the SAME
  // deterministic `signup:${endUserId}` key the old immediate-grant used, so this can never
  // double-grant even if verify-email is called twice (e.g. a double-clicked email link).
  app.post("/spaces/:spaceId/end-users/verify-email", async (c) => {
    const env = c.env as ProductEndUserRoutesEnv;
    const productId = c.req.param("spaceId");
    const body = await c.req.json<{ token: string }>();
    if (!body.token) return c.json({ error_code: "bad_request", message: "token is required" }, 400);

    const tokenHash = await sha256Hex(body.token);
    const row = await env.PLATFORM_DB.prepare(
      `SELECT id, end_user_id, expires_at, used_at FROM email_verification_tokens
       WHERE product_space_id = ? AND token_hash = ?`
    ).bind(productId, tokenHash).first<{ id: string; end_user_id: string; expires_at: string; used_at: string | null }>();
    if (!row || row.used_at || new Date(row.expires_at) < new Date()) {
      return c.json({ error_code: "invalid_token", message: "This verification link is invalid or has expired" }, 400);
    }

    await env.PLATFORM_DB.prepare(
      "UPDATE product_end_users SET email_verified_at = COALESCE(email_verified_at, datetime('now')) WHERE product_space_id = ? AND end_user_id = ?"
    ).bind(productId, row.end_user_id).run();
    await env.PLATFORM_DB.prepare(
      "UPDATE email_verification_tokens SET used_at = datetime('now') WHERE id = ?"
    ).bind(row.id).run();

    // Grant whatever the product's CURRENT pricing config says a signup should receive — reads
    // fresh rather than storing the amount at signup time, same "current config wins" posture
    // loadProductAuthConfig already uses everywhere else. Best-effort: a grant failure must
    // never fail email verification itself.
    const resolved = await loadProductAuthConfig(env, productId);
    if (resolved && resolved.signupCredits > 0) {
      try {
        const stub = await productUserDoStub(env, productId, row.end_user_id, resolved.product.tenant_id);
        await stub.fetch(new Request("http://do/credits/grant", {
          method: "POST", headers: { "content-type": "application/json" },
          body: JSON.stringify({ credits: resolved.signupCredits, reason: "signup_allowance", idempotency_key: `signup:${row.end_user_id}` }),
        }));
      } catch { /* best-effort */ }
    }

    return c.json({ ok: true, message: "Email verified." });
  });

  app.post("/spaces/:spaceId/end-users/resend-verification", async (c) => {
    const env = c.env as ProductEndUserRoutesEnv;
    const productId = c.req.param("spaceId");
    const resolved = await loadProductAuthConfig(env, productId);
    if (!resolved) return c.json({ error_code: "not_found", message: "Product not found" }, 404);

    // Live-reported bug: an empty or malformed body (no email field at all, a truncated request,
    // a bare probe with no `-d`) threw an unhandled SyntaxError here and surfaced as a raw 500 —
    // exactly the kind of response this route's own ALWAYS_OK constant-response design exists to
    // avoid leaking anything from. Defensive parse, same convention as every other body-parsing
    // route in this codebase.
    const body = await c.req.json<{ email?: string }>().catch(() => ({}) as { email?: string });
    const email = (body.email ?? "").trim().toLowerCase();
    const ALWAYS_OK = c.json({ ok: true, message: "If that account exists and isn't yet verified, a new verification link has been sent." });
    if (!email) return ALWAYS_OK;

    const row = await env.PLATFORM_DB.prepare(
      "SELECT end_user_id, email_verified_at FROM product_end_users WHERE product_space_id = ? AND email = ?"
    ).bind(productId, email).first<{ end_user_id: string; email_verified_at: string | null }>();
    // Never reveal whether the account exists or is already verified — constant response.
    if (!row || row.email_verified_at) return ALWAYS_OK;

    await issueVerificationToken(env, productId, row.end_user_id, resolved.product.tenant_id, email, resolved.product.product_slug);
    return ALWAYS_OK;
  });
}
</file>

<file path="workers/spaces/src/template-catalog.ts">
// Launchpad template catalogue + the free-tier eligibility gate (spec G-BF08, Appendix BF).
//
// loadTemplateCatalog was Phase F's single source of truth for template data in this worker
// (a KV-cached call to the agents worker's real GET /templates — never a hand-maintained copy).
// Extracted from index.ts so business-create.ts / create-space.ts can reuse it without importing
// index.ts (both files keep their one-way import rule), and extended with `free_tier_eligible`
// so the flag — which existed on LaunchpadTemplate and in the dashboard projection since Phase F
// but was NEVER enforced anywhere — finally gets teeth at creation time.

export interface TemplateCatalogEntry {
  id: string;
  name: string;
  coming_soon: boolean;
  free_tier_eligible: boolean;
  /** Connector catalogue ids (catalogue.ts) this template's onboarding recommends connecting —
   *  e.g. creator-store recommends higgsfield + social platforms for marketing. Empty means "no
   *  specific recommendation," not "connect nothing" — the shell still shows the full catalogue
   *  elsewhere; this only drives the onboarding "Recommended apps" panel. */
  connectors: string[];
}

export interface TemplateCatalogEnv {
  NAELAO_CONFIG_KV?: KVNamespace;
  AGENTS_WORKER?: Fetcher;
}

// v3: entry shape gained connectors (v2 gained free_tier_eligible) — a stale cache entry from an
// older shape would make the onboarding "Recommended apps" panel silently show nothing for up to
// an hour after deploy, so the key is bumped again rather than reusing v2.
const CATALOG_CACHE_KEY = "launchpad-template-catalog:v3";

/**
 * Load the catalogue, or null when it is genuinely UNAVAILABLE (no AGENTS_WORKER binding, or
 * the fetch failed). Callers that gate on eligibility need the distinction: an unavailable
 * catalogue must not be confused with "this template doesn't exist."
 */
export async function loadTemplateCatalogOrNull(env: TemplateCatalogEnv): Promise<TemplateCatalogEntry[] | null> {
  const cached = env.NAELAO_CONFIG_KV
    ? (await env.NAELAO_CONFIG_KV.get(CATALOG_CACHE_KEY, "json")) as TemplateCatalogEntry[] | null
    : null;
  if (cached) return cached;
  if (!env.AGENTS_WORKER) return null;
  let resp: Response;
  try {
    resp = await env.AGENTS_WORKER.fetch(new Request("http://agents-worker/templates"));
  } catch {
    return null;
  }
  if (!resp.ok) return null;
  const body = await resp.json<{
    templates: Array<{ id: string; name: string; coming_soon?: boolean; free_tier_eligible?: boolean; connectors?: string[] }>;
  }>();
  const catalog: TemplateCatalogEntry[] = body.templates.map((t) => ({
    id: t.id,
    name: t.name,
    coming_soon: t.coming_soon ?? false,
    free_tier_eligible: t.free_tier_eligible ?? false,
    connectors: t.connectors ?? [],
  }));
  if (env.NAELAO_CONFIG_KV) {
    await env.NAELAO_CONFIG_KV.put(CATALOG_CACHE_KEY, JSON.stringify(catalog), { expirationTtl: 3600 });
  }
  return catalog;
}

/** Shape-compatible wrapper for callers that render the catalogue (shell/manifest): unavailable
 *  degrades to an empty list, exactly as the pre-extraction loadTemplateCatalog behaved. */
export async function loadTemplateCatalog(env: TemplateCatalogEnv): Promise<TemplateCatalogEntry[]> {
  return (await loadTemplateCatalogOrNull(env)) ?? [];
}

/** The org's plan tier (orgs.id == tenantId, per the Phase 4 enforceSpaceQuota fix). Unknown
 *  org or a lookup error resolves to "free" — the most restrictive tier (fail closed). */
export async function resolveOrgPlanTier(db: D1Database, tenantId: string): Promise<string> {
  try {
    const org = await db.prepare("SELECT plan_tier FROM orgs WHERE id = ?").bind(tenantId).first<{ plan_tier: string }>();
    return org?.plan_tier ?? "free";
  } catch {
    return "free";
  }
}

export type FreeTierGateResult =
  | { ok: true }
  | { ok: false; error_code: "plan_upgrade_required"; message: string; status: 403 };

/**
 * G-BF08: on the free tier, every requested template must be free_tier_eligible. Semantics:
 * - Empty template list ("Custom — build with the assistant") always passes; usage caps bound it.
 * - Non-free tiers pass without loading the catalogue at all (no added latency/dependency).
 * - Catalogue UNAVAILABLE (null) passes: this is a monetization gate, not a security boundary,
 *   and failing closed here would 403 every free-plan creation during an agents-worker outage
 *   (and break every dev/test environment without the binding). The tier lookup itself still
 *   fails CLOSED (unknown org → free).
 * - Catalogue loaded: a template that is absent from it or not flagged eligible is rejected,
 *   naming the offending template ids.
 */
export async function checkFreeTierTemplateEligibility(
  db: D1Database,
  env: TemplateCatalogEnv,
  tenantId: string,
  templateIds: string[]
): Promise<FreeTierGateResult> {
  if (templateIds.length === 0) return { ok: true };
  const tier = await resolveOrgPlanTier(db, tenantId);
  if (tier !== "free") return { ok: true };
  const catalog = await loadTemplateCatalogOrNull(env);
  if (catalog === null) return { ok: true };
  const byId = new Map(catalog.map((t) => [t.id, t]));
  const blocked = templateIds.filter((id) => byId.get(id)?.free_tier_eligible !== true);
  if (blocked.length === 0) return { ok: true };
  return {
    ok: false,
    error_code: "plan_upgrade_required",
    status: 403,
    message: `Not available on the free plan: ${blocked.join(", ")}. Upgrade your plan or choose a free-eligible template.`,
  };
}

// ── Browse-only shell catalogues (Discover page) ─────────────────────────────
// What a business comes preconfigured WITH (project presets) and WHO runs it (the core agents).
// Static product data, same KV-cached-projection pattern as the template catalogue above — the
// shell renders these rather than carrying its own hardcoded copy that silently drifts.

export interface ShellCatalog {
  project_templates: Array<{ id: string; name: string; description: string; kind: string }>;
  agents: Array<{ id: string; name: string; description: string }>;
}

const SHELL_CATALOG_CACHE_KEY = "launchpad-shell-catalog:v1";

/** Unavailable (no binding, failed fetch) degrades to empty lists — this drives an informational
 *  panel, never an access decision, so a missing catalogue must never fail a manifest read. */
export async function loadShellCatalog(env: TemplateCatalogEnv): Promise<ShellCatalog> {
  const empty: ShellCatalog = { project_templates: [], agents: [] };
  const cached = env.NAELAO_CONFIG_KV
    ? ((await env.NAELAO_CONFIG_KV.get(SHELL_CATALOG_CACHE_KEY, "json")) as ShellCatalog | null)
    : null;
  if (cached) return cached;
  if (!env.AGENTS_WORKER) return empty;
  try {
    const resp = await env.AGENTS_WORKER.fetch(new Request("http://agents-worker/catalog/shell"));
    if (!resp.ok) return empty;
    const body = await resp.json<Partial<ShellCatalog>>();
    const catalog: ShellCatalog = {
      project_templates: body.project_templates ?? [],
      agents: body.agents ?? [],
    };
    if (env.NAELAO_CONFIG_KV) {
      await env.NAELAO_CONFIG_KV.put(SHELL_CATALOG_CACHE_KEY, JSON.stringify(catalog), { expirationTtl: 3600 });
    }
    return catalog;
  } catch {
    return empty;
  }
}
</file>

<file path="workers/spaces/src/tenancy.ts">
/**
 * Tenancy — the data-topology contract a builder picks per product (spec G-Y15 CRITICAL).
 * Pure module (no cloudflare:workers import) so it is reusable by the provisioner and the
 * worker and unit-testable without a DO runtime.
 *
 *   single — one owner, one SpaceDO. No sub-spaces.
 *   team   — one shared SpaceDO; sub-spaces (departments) live inside it, isolated by
 *            space_id in the SpaceDO `spaces` registry. Shared members.
 *   saas   — product root + per-end-user isolation: each customer business is its OWN
 *            SpaceDO under its OWN child tenant (structural isolation, G-Y16).
 */
export type Tenancy = "single" | "team" | "saas";

/**
 * Derive the effective tenancy from a productConfig. Prefers the explicit `tenancy`
 * field; otherwise infers it from membershipModel so older manifests (and per-space
 * overrides) that only set membershipModel still resolve: team→team, tenant→saas,
 * hybrid→saas. Defaults to "team".
 */
export function resolveTenancy(
  pc: { tenancy?: Tenancy; membershipModel?: string } | null | undefined
): Tenancy {
  if (!pc) return "team";
  if (pc.tenancy) return pc.tenancy;
  if (pc.membershipModel === "tenant" || pc.membershipModel === "hybrid") return "saas";
  return "team";
}
</file>

<file path="workers/workflows/src/workflows/DataErasureWorkflow.ts">
/**
 * DataErasureWorkflow
 *
 * GDPR / right-to-erasure workflow. Permanently erases all PII and data for an org.
 * Includes a 24-hour cooling-off period between suspension and hard deletion
 * to satisfy regulatory requirements and allow accidental-request reversal.
 *
 * Steps:
 *   1. record-erasure-request  — insert audit_log entry
 *   2. suspend-org             — suspend org + all its spaces
 *   [24-hour cooling-off sleep]
 *   3. delete-spaces-data      — delete usage_events; log R2 deletion intent
 *   4. delete-user-pii         — anonymize user email / password_hash
 *   5. cancel-subscription     — mark subscription cancelled
 *   6. emit-completed          — audit log + emit org.erased event
 *
 * Gap IDs fulfilled: G-D01, G-D02, G-D03 (GDPR erasure pipeline)
 */

import { WorkflowEntrypoint, WorkflowStep, WorkflowEvent } from "cloudflare:workers";
import type { Env } from "../env";

export interface ErasureParams {
  orgId: string;
  requestedBy: string; // userId who triggered the erasure
  reason: string;
}

export class DataErasureWorkflow extends WorkflowEntrypoint<Env, ErasureParams> {
  async run(
    event: WorkflowEvent<ErasureParams>,
    step: WorkflowStep,
  ): Promise<void> {
    const params = event.payload;

    // ── Step 1: Record erasure request in audit log ──────────────────────────
    await step.do("record-erasure-request", async () => {
      const auditId = crypto.randomUUID();
      await this.env.PLATFORM_DB.prepare(
        `INSERT OR IGNORE INTO audit_log
           (id, tenant_id, actor_id, actor_type, event_type, resource_type, resource_id, event_data)
         VALUES (?, ?, ?, 'user', 'erasure_requested', 'org', ?, ?)`
      )
        .bind(
          auditId,
          params.orgId,
          params.requestedBy,
          params.orgId,
          JSON.stringify({ reason: params.reason, requestedBy: params.requestedBy }),
        )
        .run();

      console.log(`[DataErasure] Erasure request recorded: org=${params.orgId}, auditId=${auditId}`);
      return { auditId };
    });

    // ── Step 2: Suspend org + spaces ─────────────────────────────────────────
    await step.do("suspend-org", async () => {
      await this.env.PLATFORM_DB.prepare(
        `UPDATE orgs SET status = 'suspended' WHERE id = ? AND status != 'suspended'`
      )
        .bind(params.orgId)
        .run();

      await this.env.PLATFORM_DB.prepare(
        `UPDATE spaces SET status = 'suspended', updated_at = datetime('now')
         WHERE tenant_id = ? AND status != 'suspended'`
      )
        .bind(params.orgId)
        .run();

      console.log(`[DataErasure] Org ${params.orgId} and its spaces suspended.`);
      return { suspended: true };
    });

    // ── Regulatory cooling-off period: 24 hours ───────────────────────────────
    // CF Workflows supports sleep durations up to 1 year.
    // This satisfies GDPR Art. 17 implementation requirements (reversibility window).
    await step.sleep("cooling-off", "24 hours");

    // ── Step 3: Delete space data (R2, Vectorize, D1) ────────────────────────
    // G-E08: Paginated R2 deletion — iterate all pages, not just first
    await step.do("delete-spaces-data", async () => {
      // Fetch all space IDs for this org
      const { results: spaces } = await this.env.PLATFORM_DB.prepare(
        `SELECT id FROM spaces WHERE tenant_id = ?`
      )
        .bind(params.orgId)
        .all<{ id: string }>();

      // Delete usage events for this org
      await this.env.PLATFORM_DB.prepare(
        `DELETE FROM usage_events WHERE org_id = ?`
      )
        .bind(params.orgId)
        .run();

      // Delete R2 objects and Vectorize vectors for each space
      for (const space of spaces) {
        // Get all indexed KB documents for this space
        const { results: docs } = await this.env.PLATFORM_DB.prepare(
          `SELECT id, chunk_count FROM kb_documents WHERE space_id = ?`
        )
          .bind(space.id)
          .all<{ id: string; chunk_count: number }>();

        for (const doc of docs) {
          // Delete R2 objects — paginated (G-E08 fix: don't stop at first page)
          const prefix = `kb/${space.id}/${doc.id}/`;
          let cursor: string | undefined;
          do {
            const listOpts: R2ListOptions = cursor !== undefined ? { prefix, cursor } : { prefix };
            const listed: R2Objects = await this.env.KB_BUCKET.list(listOpts);
            if (listed.objects.length > 0) {
              await Promise.all(listed.objects.map((o) => this.env.KB_BUCKET.delete(o.key)));
            }
            cursor = listed.truncated ? listed.cursor : undefined;
          } while (cursor);

          // Delete Vectorize vectors
          const chunkCount = doc.chunk_count ?? 0;
          if (chunkCount > 0) {
            const vectorIds = Array.from({ length: chunkCount }, (_, i) => `${doc.id}_chunk_${i}`);
            const BATCH = 100;
            for (let i = 0; i < vectorIds.length; i += BATCH) {
              await this.env.KB_VECTORS.deleteByIds(vectorIds.slice(i, i + BATCH));
            }
          }
        }

        // Delete all D1 KB document records for this space
        await this.env.PLATFORM_DB.prepare(
          `DELETE FROM kb_documents WHERE space_id = ?`
        ).bind(space.id).run();

        // Delete active session registry entries for this space
        await this.env.PLATFORM_DB.prepare(
          `DELETE FROM active_sessions WHERE space_id = ?`
        ).bind(space.id).run();

        await this.env.PLATFORM_DB.prepare(
          `DELETE FROM thread_sessions WHERE space_id = ?`
        ).bind(space.id).run();

        console.log(`[DataErasure] Cleaned space=${space.id} for org=${params.orgId}`);
      }

      console.log(
        `[DataErasure] Deleted data for ${spaces.length} space(s) in org=${params.orgId}`,
      );
      return { spacesProcessed: spaces.length };
    });

    // ── Step 4: Anonymize user PII ────────────────────────────────────────────
    await step.do("delete-user-pii", async () => {
      // Overwrite email with a non-identifiable placeholder; clear password_hash.
      // The id is preserved so foreign-key references remain intact.
      await this.env.PLATFORM_DB.prepare(
        `UPDATE users
         SET email = 'erased-' || id || '@deleted.invalid',
             status = 'erased'
         WHERE org_id = ?`
      )
        .bind(params.orgId)
        .run();

      console.log(`[DataErasure] PII anonymized for users in org=${params.orgId}`);
      return { piiErased: true };
    });

    // ── Step 4b: Clear KV cache for the erased org ────────────────────────────
    // G-AZ34: Delete all CF KV cached responses scoped to this tenant.
    // QUOTA_CACHE keys follow the pattern: {orgId}:* (quota entries, config, etc.)
    await step.do("clear-kv-cache", async () => {
      const prefix = `${params.orgId}:`;
      let cursor: string | undefined;
      let deleted = 0;
      do {
        const listOpts = cursor !== undefined
          ? { prefix, cursor }
          : { prefix };
        const listed = await this.env.QUOTA_CACHE.list(listOpts);
        for (const key of listed.keys) {
          await this.env.QUOTA_CACHE.delete(key.name);
          deleted++;
        }
        cursor = listed.list_complete ? undefined : listed.cursor;
      } while (cursor);

      console.log(`[DataErasure] Cleared ${deleted} KV cache entries for org=${params.orgId}`);
      return { kvKeysDeleted: deleted };
    });

    // ── Step 5: Cancel subscription ───────────────────────────────────────────
    await step.do("cancel-subscription", async () => {
      await this.env.PLATFORM_DB.prepare(
        `UPDATE subscriptions
         SET status = 'cancelled', updated_at = datetime('now')
         WHERE org_id = ? AND status != 'cancelled'`
      )
        .bind(params.orgId)
        .run();

      console.log(`[DataErasure] Subscription cancelled for org=${params.orgId}`);
      return { subscriptionCancelled: true };
    });

    // ── Step 6: Emit erasure-completed event ──────────────────────────────────
    await step.do("emit-completed", async () => {
      // Final audit log entry
      const completionAuditId = crypto.randomUUID();
      await this.env.PLATFORM_DB.prepare(
        `INSERT OR IGNORE INTO audit_log
           (id, tenant_id, actor_id, actor_type, event_type, resource_type, resource_id, event_data)
         VALUES (?, ?, ?, 'system', 'erasure_completed', 'org', ?, ?)`
      )
        .bind(
          completionAuditId,
          params.orgId,
          params.requestedBy,
          params.orgId,
          JSON.stringify({ reason: params.reason, completedAt: new Date().toISOString() }),
        )
        .run();

      const completedAt = new Date().toISOString();

      // Emit org.erased event to the main event queue
      await this.env.EVENTS_QUEUE.send({
        type: "org.erased",
        orgId: params.orgId,
        requestedBy: params.requestedBy,
        timestamp: completedAt,
      });

      // G-AZ34: Analytics Engine is append-only — cannot delete rows.
      // Emit an analytics.user_erased correction record so the analytics worker
      // can write a null_user_id anonymization marker into Analytics Engine.
      await this.env.EVENTS_QUEUE.send({
        type: "analytics.user_erased",
        orgId: params.orgId,
        erasedAt: completedAt,
        reason: params.reason,
      });

      console.log(
        `[DataErasure] Erasure completed for org=${params.orgId}, auditId=${completionAuditId}`,
      );
      return { completionAuditId, emitted: true };
    });
  }
}
</file>

<file path="workers/workflows/src/workflows/DunningWorkflow.ts">
/**
 * DunningWorkflow
 *
 * Subscription dunning workflow for failed/past-due invoice payments.
 * Supports up to 3 retry attempts. On attempt 3 the subscription is
 * moved to 'past_due' and an audit trail is written.
 *
 * Steps:
 *   1. check-payment-status      — guard: skip if invoice already paid
 *   2. send-dunning-email        — stub: log email intent (Phase 6 wires real email)
 *   3. schedule-retry-or-suspend — enqueue next attempt or mark past_due
 *   4. emit-event                — emit dunning.attempted to EVENTS_QUEUE
 *
 * Gap IDs fulfilled: G-E01, G-E02 (billing dunning automation)
 */

import { WorkflowEntrypoint, WorkflowStep, WorkflowEvent } from "cloudflare:workers";
import type { Env } from "../env";

export interface DunningParams {
  orgId: string;
  invoiceId: string;
  stripeInvoiceId?: string;
  attemptNumber: number; // 1, 2, or 3
}

export class DunningWorkflow extends WorkflowEntrypoint<Env, DunningParams> {
  async run(
    event: WorkflowEvent<DunningParams>,
    step: WorkflowStep,
  ): Promise<void> {
    const params = event.payload;

    // ── Step 1: Check current invoice payment status ──────────────────────────
    // Idempotent guard — if a webhook already marked this invoice paid, bail out.
    const { invoiceStatus } = await step.do("check-payment-status", async () => {
      const invoice = await this.env.PLATFORM_DB.prepare(
        `SELECT status FROM invoices WHERE id = ?`
      )
        .bind(params.invoiceId)
        .first<{ status: string }>();

      if (!invoice) {
        throw new Error(
          `Invoice ${params.invoiceId} not found — cannot run dunning workflow`,
        );
      }

      console.log(
        `[Dunning] Invoice ${params.invoiceId} status=${invoice.status} ` +
          `(org=${params.orgId}, attempt=${params.attemptNumber})`,
      );

      return { invoiceStatus: invoice.status };
    });

    // If the invoice was already paid (e.g., by a concurrent webhook) we stop here.
    if (invoiceStatus === "paid") {
      console.log(
        `[Dunning] Invoice ${params.invoiceId} already paid — dunning workflow exits early`,
      );
      return;
    }

    // ── Step 2: Send dunning email (stub) ─────────────────────────────────────
    await step.do("send-dunning-email", async () => {
      const user = await this.env.PLATFORM_DB.prepare(
        `SELECT email FROM users WHERE org_id = ? AND status = 'active' LIMIT 1`
      )
        .bind(params.orgId)
        .first<{ email: string }>();

      const emailAddress = user?.email ?? "unknown";

      // TODO Phase 6: replace with real transactional email via SendGrid / Resend
      console.log(
        `[DUNNING] Would send email to ${emailAddress} ` +
          `for invoice ${params.invoiceId} attempt ${params.attemptNumber}`,
      );

      return { email: emailAddress };
    });

    // ── Step 3: Schedule retry or suspend subscription ────────────────────────
    await step.do("schedule-retry-or-suspend", async () => {
      if (params.attemptNumber < 3) {
        // Enqueue the next dunning attempt.
        // Real delay scheduling: use step.sleep("wait-before-retry", "3 days") before
        // triggering the next workflow instance. For now we enqueue immediately and
        // rely on the consumer to check timing or re-schedule.
        await this.env.EVENTS_QUEUE.send({
          type: "dunning",
          orgId: params.orgId,
          invoiceId: params.invoiceId,
          stripeInvoiceId: params.stripeInvoiceId,
          attemptNumber: params.attemptNumber + 1,
        });

        console.log(
          `[Dunning] Scheduled retry attempt ${params.attemptNumber + 1} ` +
            `for invoice=${params.invoiceId} org=${params.orgId}`,
        );
        return { action: "retry-scheduled", nextAttempt: params.attemptNumber + 1 };
      } else {
        // Final attempt (3) — mark subscription as past_due and write audit trail
        await this.env.PLATFORM_DB.prepare(
          `UPDATE subscriptions
           SET status = 'past_due', updated_at = datetime('now')
           WHERE org_id = ? AND status NOT IN ('cancelled', 'past_due')`
        )
          .bind(params.orgId)
          .run();

        await this.env.PLATFORM_DB.prepare(
          `INSERT OR IGNORE INTO audit_log
             (id, tenant_id, actor_id, actor_type, event_type, resource_type, resource_id, event_data)
           VALUES (?, ?, 'system', 'system', 'subscription_past_due', 'org', ?, ?)`
        )
          .bind(
            crypto.randomUUID(),
            params.orgId,
            params.orgId,
            JSON.stringify({
              invoiceId: params.invoiceId,
              stripeInvoiceId: params.stripeInvoiceId ?? null,
              totalAttempts: params.attemptNumber,
            }),
          )
          .run();

        console.log(
          `[Dunning] Final attempt exhausted — subscription marked past_due ` +
            `for org=${params.orgId}`,
        );
        return { action: "subscription-past-due" };
      }
    });

    // ── Step 4: Emit dunning.attempted event ──────────────────────────────────
    await step.do("emit-event", async () => {
      await this.env.EVENTS_QUEUE.send({
        type: "dunning.attempted",
        orgId: params.orgId,
        invoiceId: params.invoiceId,
        stripeInvoiceId: params.stripeInvoiceId ?? null,
        attemptNumber: params.attemptNumber,
        invoiceStatus,
        timestamp: new Date().toISOString(),
      });

      return { emitted: true };
    });
  }
}
</file>

<file path="workers/workflows/src/workflows/KbIngestionWorkflow.ts">
/**
 * KbIngestionWorkflow
 *
 * CF Workflow for ingesting large KB documents that exceed single-request limits.
 * Raw content is pre-stored in R2 by the caller; this workflow fetches, chunks,
 * embeds, and indexes the content via the KNOWLEDGE_WORKER internal API.
 *
 * Steps:
 *   1. fetch-content            — retrieve raw content from R2, validate ≤5MB
 *   2. update-status-processing — mark document as processing
 *   3. chunk-and-embed          — split + forward chunks to knowledge worker
 *   4. update-status-indexed    — mark document as indexed with chunk count
 *   5. cleanup-raw              — delete the raw staging object from R2
 *
 * Gap IDs fulfilled: G-B16, G-B17 (async large-doc ingestion)
 */

import { WorkflowEntrypoint, WorkflowStep, WorkflowEvent } from "cloudflare:workers";
import type { Env } from "../env";

export interface IngestionParams {
  docId: string;
  spaceId: string;
  tenantId: string;
  projectId: string;
  r2Key: string;      // Key in KB_BUCKET where raw content is staged
  title: string;
  contentType: string;
}

// 5 MB content limit per workflow run
const MAX_CONTENT_BYTES = 5 * 1024 * 1024;

// 10 KB target chunk size (character-based; actual split at word boundary)
const CHUNK_SIZE_CHARS = 10 * 1024;

/**
 * Split text into chunks of up to chunkSize characters,
 * preferring to break at the last whitespace before the boundary
 * to avoid mid-word cuts.
 */
function splitIntoChunks(text: string, chunkSize: number): string[] {
  const chunks: string[] = [];
  let offset = 0;

  while (offset < text.length) {
    if (offset + chunkSize >= text.length) {
      // Last chunk — take whatever remains
      chunks.push(text.slice(offset));
      break;
    }

    // Find the last whitespace within the chunk window
    let end = offset + chunkSize;
    const slice = text.slice(offset, end);
    const lastSpace = slice.lastIndexOf(" ");

    if (lastSpace > 0) {
      end = offset + lastSpace;
    }

    chunks.push(text.slice(offset, end).trim());
    offset = end + 1; // skip the space we split on
  }

  return chunks.filter(c => c.length > 0);
}

export class KbIngestionWorkflow extends WorkflowEntrypoint<Env, IngestionParams> {
  async run(
    event: WorkflowEvent<IngestionParams>,
    step: WorkflowStep,
  ): Promise<void> {
    const params = event.payload;
    let chunkCount = 0;

    try {
      // G-BC03: Per-step retry config with exponential backoff
      const networkRetry = {
        retries: { limit: 3, delay: 1000, backoff: "exponential" as const },
        timeout: 30_000,
      };

      // ── Step 1: Fetch raw content from R2 ──────────────────────────────────
      const { contentLength } = await step.do("fetch-content", networkRetry, async () => {
        const obj = await this.env.KB_BUCKET.get(params.r2Key);

        if (!obj) {
          throw new Error(
            `R2 object not found: key="${params.r2Key}" docId=${params.docId}`,
          );
        }

        // Validate size via Content-Length header before reading the full body
        const sizeHeader = obj.size;
        if (sizeHeader > MAX_CONTENT_BYTES) {
          throw new Error(
            `Document exceeds 5MB limit: size=${sizeHeader} bytes, docId=${params.docId}`,
          );
        }

        const content = await obj.text();

        if (content.length > MAX_CONTENT_BYTES) {
          throw new Error(
            `Document content exceeds 5MB character limit: length=${content.length}`,
          );
        }

        console.log(
          `[KbIngestion] Fetched r2Key="${params.r2Key}", length=${content.length} chars`,
        );
        return { contentLength: content.length };
      });

      // ── Step 2: Mark document as processing ────────────────────────────────
      await step.do("update-status-processing", networkRetry, async () => {
        const resp = await this.env.KNOWLEDGE_WORKER.fetch(
          `https://knowledge-worker/internal/docs/${params.docId}/status`,
          {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ status: "processing", project_id: params.projectId }),
          },
        );

        if (!resp.ok) {
          const text = await resp.text();
          throw new Error(
            `Failed to set status=processing for doc ${params.docId}: (${resp.status}) ${text}`,
          );
        }

        return { ok: true };
      });

      // ── Step 3: Chunk and embed via KNOWLEDGE_WORKER ────────────────────────
      // We re-fetch the content inside this step because WorkflowStep state is
      // JSON-serialized between steps — storing large strings across steps would
      // balloon serialized state. R2 fetches are idempotent so re-fetching is safe.
      chunkCount = await step.do("chunk-and-embed", { ...networkRetry, timeout: 29_000 }, async () => {
        const obj = await this.env.KB_BUCKET.get(params.r2Key);
        if (!obj) {
          throw new Error(
            `R2 object disappeared between steps: key="${params.r2Key}"`,
          );
        }
        const content = await obj.text();

        const chunks = splitIntoChunks(content, CHUNK_SIZE_CHARS);

        console.log(
          `[KbIngestion] Chunked docId=${params.docId} into ${chunks.length} chunk(s)`,
        );

        const resp = await this.env.KNOWLEDGE_WORKER.fetch(
          `https://knowledge-worker/internal/docs/${params.docId}/ingest-chunks`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-Naelao-Tenant-Id": params.tenantId,
            },
            body: JSON.stringify({
              chunks,
              spaceId: params.spaceId,
              tenantId: params.tenantId,
              projectId: params.projectId,
              title: params.title,
              contentType: params.contentType,
            }),
          },
        );

        if (!resp.ok) {
          const text = await resp.text();
          throw new Error(
            `Chunk ingestion failed for doc ${params.docId}: (${resp.status}) ${text}`,
          );
        }

        return chunks.length;
      });

      // ── Step 4: Mark document as indexed ──────────────────────────────────
      await step.do("update-status-indexed", networkRetry, async () => {
        const resp = await this.env.KNOWLEDGE_WORKER.fetch(
          `https://knowledge-worker/internal/docs/${params.docId}/status`,
          {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ status: "indexed", chunk_count: chunkCount, project_id: params.projectId }),
          },
        );

        if (!resp.ok) {
          const text = await resp.text();
          throw new Error(
            `Failed to set status=indexed for doc ${params.docId}: (${resp.status}) ${text}`,
          );
        }

        console.log(
          `[KbIngestion] docId=${params.docId} indexed with ${chunkCount} chunk(s)`,
        );
        return { status: "indexed", chunkCount };
      });

      // ── Step 5: Delete raw staging object from R2 ──────────────────────────
      await step.do("cleanup-raw", async () => {
        await this.env.KB_BUCKET.delete(params.r2Key);

        console.log(`[KbIngestion] Deleted raw staging object r2Key="${params.r2Key}"`);
        return { deleted: true };
      });
    } catch (err) {
      // On any step failure: mark the document as failed and rethrow
      // so the workflow records the error and CF can retry/DLQ.
      const message = err instanceof Error ? err.message : String(err);
      console.error(`[KbIngestion] Failed for docId=${params.docId}: ${message}`);

      try {
        await this.env.KNOWLEDGE_WORKER.fetch(
          `https://knowledge-worker/internal/docs/${params.docId}/status`,
          {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ status: "failed", error: message, project_id: params.projectId }),
          },
        );
      } catch (statusErr) {
        // Best-effort — don't mask the original error
        console.error(
          `[KbIngestion] Also failed to set status=failed: ${statusErr}`,
        );
      }

      throw err;
    }
  }
}
</file>

<file path="workers/workflows/src/workflows/QueueHealthWorkflow.ts">
/**
 * QueueHealthWorkflow — CF Workflow for queue health monitoring.
 *
 * G-BE03: Monitors CF Queues for backlog depth and message age.
 * Alerts if:
 *   - Oldest message age > 3 days (CRITICAL: messages at risk of silent drop)
 *   - DLQ depth > 1000 (needs investigation or bulk replay)
 *   - Consumer error rate > 50% (circuit breaker recommendation)
 *
 * Triggered every 30 minutes via cron in wrangler.toml.
 *
 * Uses Cloudflare GraphQL Analytics API to read queue metrics.
 * Requires CF_ACCOUNT_ID and CF_API_TOKEN secrets.
 */

import { WorkflowEntrypoint, WorkflowStep, WorkflowEvent } from "cloudflare:workers";
import type { Env } from "../env.js";

export interface QueueHealthParams {
  triggeredAt: string;
}

interface QueueMetrics {
  queueName: string;
  backlogDepth: number;
  oldestMessageAgeSeconds: number;
  dlqDepth: number;
  errorRate: number;
}

const ALERT_OLDEST_AGE_SECS = 3 * 24 * 60 * 60;  // 3 days
const ALERT_DLQ_DEPTH = 1000;
const ALERT_ERROR_RATE = 0.5;

export class QueueHealthWorkflow extends WorkflowEntrypoint<Env, QueueHealthParams> {
  async run(
    event: WorkflowEvent<QueueHealthParams>,
    step: WorkflowStep,
  ): Promise<void> {
    const retry = {
      retries: { limit: 2, delay: 5000, backoff: "exponential" as const },
      timeout: 30_000,
    };

    // ── Step 1: Fetch queue metrics from CF Analytics API ─────────────────────
    const metrics = await step.do("fetch-queue-metrics", retry, async () => {
      if (!this.env.CF_ACCOUNT_ID || !this.env.CF_API_TOKEN) {
        console.warn("[QueueHealth] CF_ACCOUNT_ID or CF_API_TOKEN not set — using D1 estimates");
        return await this.estimateMetricsFromD1();
      }
      return await this.fetchMetricsFromCfApi();
    });

    // ── Step 2: Evaluate thresholds and emit alerts ────────────────────────────
    await step.do("evaluate-and-alert", retry, async () => {
      const alerts: string[] = [];

      for (const m of metrics) {
        if (m.oldestMessageAgeSeconds > ALERT_OLDEST_AGE_SECS) {
          alerts.push(
            `[CRITICAL] Queue "${m.queueName}": oldest message age ${Math.floor(m.oldestMessageAgeSeconds / 3600)}h ` +
            `exceeds 3-day threshold — messages at risk of silent drop. Investigate consumer health immediately.`
          );
        }
        if (m.dlqDepth > ALERT_DLQ_DEPTH) {
          alerts.push(
            `[WARN] Queue "${m.queueName}" DLQ depth ${m.dlqDepth} > ${ALERT_DLQ_DEPTH} — bulk replay or root cause investigation needed.`
          );
        }
        if (m.errorRate > ALERT_ERROR_RATE) {
          alerts.push(
            `[WARN] Queue "${m.queueName}" consumer error rate ${(m.errorRate * 100).toFixed(1)}% > 50% — recommend pausing consumption.`
          );
        }
      }

      if (alerts.length > 0) {
        console.error(`[QueueHealth] ${alerts.length} alert(s) at ${event.payload.triggeredAt}:\n${alerts.join("\n")}`);
      } else {
        console.log(`[QueueHealth] All queues healthy at ${event.payload.triggeredAt}`);
      }

      // Write health check results to D1 for audit trail
      await this.env.PLATFORM_DB.prepare(
        `INSERT INTO queue_health_checks (checked_at, queue_metrics, alert_count, alerts_json)
         VALUES (datetime('now'), ?, ?, ?)`
      ).bind(
        JSON.stringify(metrics),
        alerts.length,
        JSON.stringify(alerts)
      ).run().catch(err => {
        // Table may not exist — log but don't fail the workflow
        console.warn(`[QueueHealth] Could not write to queue_health_checks: ${err}`);
      });

      return { alertCount: alerts.length, alerts };
    });
  }

  private async fetchMetricsFromCfApi(): Promise<QueueMetrics[]> {
    const nowMs = Date.now();
    const thirtyMinutesAgoMs = nowMs - 30 * 60 * 1000;

    const query = `
      query QueueMetrics($accountTag: string!, $since: Time!, $until: Time!) {
        viewer {
          accounts(filter: { accountTag: $accountTag }) {
            queueMetrics: queuesAdaptiveGroups(
              filter: { datetime_geq: $since, datetime_leq: $until }
              limit: 100
            ) {
              dimensions { queueId queueName }
              sum { messages messagesDelivered messagesFailed messagesDeadLettered }
            }
          }
        }
      }
    `;

    const resp = await fetch("https://api.cloudflare.com/client/v4/graphql", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${this.env.CF_API_TOKEN}`,
      },
      body: JSON.stringify({
        query,
        variables: {
          accountTag: this.env.CF_ACCOUNT_ID,
          since: new Date(thirtyMinutesAgoMs).toISOString(),
          until: new Date(nowMs).toISOString(),
        },
      }),
    });

    if (!resp.ok) {
      const text = await resp.text();
      throw new Error(`CF GraphQL API error (${resp.status}): ${text}`);
    }

    const data = await resp.json<{
      data?: {
        viewer?: {
          accounts?: Array<{
            queueMetrics?: Array<{
              dimensions: { queueId: string; queueName: string };
              sum: { messages: number; messagesDelivered: number; messagesFailed: number; messagesDeadLettered: number };
            }>;
          }>;
        };
      };
    }>();

    const queueMetrics = data.data?.viewer?.accounts?.[0]?.queueMetrics ?? [];

    return queueMetrics.map(q => {
      const total = q.sum.messages || 1;
      const errorRate = q.sum.messagesFailed / total;
      return {
        queueName: q.dimensions.queueName,
        backlogDepth: q.sum.messages - q.sum.messagesDelivered,
        oldestMessageAgeSeconds: 0,  // Not available via GraphQL — requires queue-specific API
        dlqDepth: q.sum.messagesDeadLettered,
        errorRate,
      };
    });
  }

  // Fallback: estimate metrics from D1 event tables when CF API creds are unavailable
  private async estimateMetricsFromD1(): Promise<QueueMetrics[]> {
    try {
      const row = await this.env.PLATFORM_DB.prepare(`
        SELECT
          COUNT(*) as total,
          SUM(CASE WHEN status = 'failed' THEN 1 ELSE 0 END) as failed,
          MIN(created_at) as oldest_event
        FROM usage_events
        WHERE created_at >= datetime('now', '-30 minutes')
      `).first<{ total: number; failed: number; oldest_event: string | null }>();

      const total = row?.total ?? 0;
      const failed = row?.failed ?? 0;
      const oldestEvent = row?.oldest_event;
      const oldestAgeSecs = oldestEvent
        ? Math.floor((Date.now() - new Date(oldestEvent).getTime()) / 1000)
        : 0;

      return [{
        queueName: "naelao-events",
        backlogDepth: total - (total - failed),
        oldestMessageAgeSeconds: oldestAgeSecs,
        dlqDepth: 0,
        errorRate: total > 0 ? failed / total : 0,
      }];
    } catch {
      return [];
    }
  }
}
