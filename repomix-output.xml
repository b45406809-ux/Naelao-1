  <!-- ══════════════════════════════════════════════════════
     §10 — SPACES, SUB-SPACES & ISOLATION
═══════════════════════════════════════════════════════ -->
  <div class="sec" id="spaces">
    <span class="sec-ey">10 — Spaces & Isolation</span>
    <h2>Spaces, Sub-Spaces & 6-Layer Tenant Isolation</h2>
    <div class="bar"></div>
    <p class="lead">A Space is a virtual full Naelao instance. Every organization on the platform shares the same
      physical Cloudflare infrastructure but is completely isolated at six independent layers simultaneously. Breaching
      one layer does not expose data from another. This is the foundational security guarantee of the entire platform.
    </p>

    <h3>The 6 Isolation Layers — Implemented in Full Detail</h3>

    <h4>Layer 1 — SpaceDO SQLite Per-Product Database</h4>
    <p>Every NaelaoProduct (root Space) gets its own <strong>SpaceDO</strong> instance whose <code>ctx.storage.sql</code>
      (DO SQLite) is the product's complete database. Sub-spaces within the product share the same SpaceDO database and
      are isolated by <code>space_id</code> column — no RLS needed because no two products share a database instance.
      The DO instance boundary <em>is</em> the isolation boundary. Breaching one product's SpaceDO cannot expose another
      product's data because they are physically separate SQLite databases in separate DO instances.</p>
    <div class="box box-or" style="margin:12px 0 18px;">
      <div class="box-lbl">Why SpaceDO SQLite, Not Supabase + RLS</div>
      <p style="margin:0;font-size:13.5px;">The original architecture kept Supabase because "D1 lacks RLS, stored
        functions, full-text search." That reasoning was valid for a <em>single shared database</em> where RLS was doing
        the isolation work. With one SpaceDO per product, the database boundary replaces RLS entirely — there are no
        cross-product rows to filter. DO SQLite supports FTS5 natively. Stored functions become typed DO methods.
        Hyperdrive is eliminated. No external service dependency. The entire data layer runs inside Cloudflare.</p>
    </div>
    <pre><code><span class="cm">// SpaceDO — per-product database, initialized in constructor
// File: workers/naelao-spaces/src/dos/SpaceDO.ts
// DO ID: idFromName('space:{rootSpaceId}')  ← root space ID = product ID
// Sub-spaces write to the same DO with their own space_id in every row.</span>

export class SpaceDO extends DurableObject {
  private db: SqlStorage;

  constructor(ctx: DurableObjectState, env: Env) {
    super(ctx, env);
    this.db = ctx.storage.sql;
    this.db.exec(`
      <span class="cm">-- Platform-fixed schema. Never diverges by SpaceType.
      -- SpaceType differences live in config, agent definitions, and manifests — never in DB tables.</span>

      CREATE TABLE IF NOT EXISTS spaces (
        id         TEXT PRIMARY KEY,
        parent_id  TEXT REFERENCES spaces(id),
        name       TEXT NOT NULL,
        space_type TEXT NOT NULL CHECK (space_type IN (
                     'builder_workspace','team','launchpad','verticals',
                     'workers','studio','enterprise','mini_agi','developer','custom'
                   )),
        agency_shell INTEGER DEFAULT 0,
        depth      INTEGER NOT NULL DEFAULT 0 CHECK (depth &lt;= 3),
        status     TEXT DEFAULT 'active' CHECK (status IN ('active','suspended','deleted')),
        settings   TEXT DEFAULT '{}',
        created_at TEXT NOT NULL
      );

      CREATE TABLE IF NOT EXISTS space_members (
        space_id   TEXT NOT NULL REFERENCES spaces(id) ON DELETE CASCADE,
        user_id    TEXT NOT NULL,
        role       TEXT NOT NULL DEFAULT 'member'
                     CHECK (role IN ('owner','admin','editor','member','viewer')),
        invited_by TEXT,
        joined_at  TEXT NOT NULL,
        PRIMARY KEY (space_id, user_id)
      );

      CREATE TABLE IF NOT EXISTS product_users (
        id            TEXT PRIMARY KEY,
        email         TEXT NOT NULL,
        display_name  TEXT,
        status        TEXT DEFAULT 'active',
        credits_used  INTEGER DEFAULT 0,
        credits_limit INTEGER,
        last_active_at TEXT,
        created_at    TEXT NOT NULL
      );

      CREATE TABLE IF NOT EXISTS threads (
        id         TEXT PRIMARY KEY,
        space_id   TEXT NOT NULL REFERENCES spaces(id),
        user_id    TEXT NOT NULL,
        title      TEXT,
        created_at TEXT NOT NULL,
        updated_at TEXT NOT NULL
      );

      CREATE TABLE IF NOT EXISTS messages (
        id         TEXT PRIMARY KEY,
        thread_id  TEXT NOT NULL REFERENCES threads(id) ON DELETE CASCADE,
        space_id   TEXT NOT NULL,    <span class="cm">-- denormalized for fast space-scoped queries</span>
        role       TEXT NOT NULL,
        content    TEXT NOT NULL,
        created_at TEXT NOT NULL
      );

      CREATE TABLE IF NOT EXISTS agent_runs (
        id               TEXT PRIMARY KEY,
        thread_id        TEXT NOT NULL REFERENCES threads(id),
        space_id         TEXT NOT NULL,
        agent_id         TEXT NOT NULL,
        status           TEXT DEFAULT 'pending',
        input_tokens     INTEGER DEFAULT 0,
        output_tokens    INTEGER DEFAULT 0,
        credits_consumed INTEGER DEFAULT 0,
        started_at       TEXT,
        completed_at     TEXT
      );

      CREATE TABLE IF NOT EXISTS billing (
        id          TEXT PRIMARY KEY,
        user_id     TEXT NOT NULL,
        space_id    TEXT NOT NULL,
        event_type  TEXT NOT NULL,
        credits     INTEGER NOT NULL,
        recorded_at TEXT NOT NULL
      );

      CREATE TABLE IF NOT EXISTS agent_definitions (
        id          TEXT PRIMARY KEY,
        space_id    TEXT NOT NULL,
        name        TEXT NOT NULL,
        config_json TEXT NOT NULL,
        version     INTEGER DEFAULT 1,
        created_at  TEXT NOT NULL
      );

      CREATE TABLE IF NOT EXISTS fine_tune_jobs (
        id          TEXT PRIMARY KEY,
        space_id    TEXT NOT NULL,
        status      TEXT DEFAULT 'pending',
        approved    INTEGER DEFAULT 0,
        model_id    TEXT,
        created_at  TEXT NOT NULL
      );

      <span class="cm">-- Indexes for the most common query patterns</span>
      CREATE INDEX IF NOT EXISTS idx_threads_space   ON threads(space_id, created_at DESC);
      CREATE INDEX IF NOT EXISTS idx_messages_thread ON messages(thread_id, created_at ASC);
      CREATE INDEX IF NOT EXISTS idx_messages_space  ON messages(space_id);
      CREATE INDEX IF NOT EXISTS idx_runs_space      ON agent_runs(space_id, started_at DESC);
      CREATE INDEX IF NOT EXISTS idx_billing_user    ON billing(user_id, recorded_at DESC);
      CREATE INDEX IF NOT EXISTS idx_members_user    ON space_members(user_id);
      CREATE INDEX IF NOT EXISTS idx_defs_space      ON agent_definitions(space_id);

      <span class="cm">-- FTS5 for message search (replaces Supabase full-text search)</span>
      CREATE VIRTUAL TABLE IF NOT EXISTS messages_fts
        USING fts5(content, content=messages, content_rowid=rowid);
    `);
  }

  <span class="cm">// All data access goes through typed DO methods — never raw SQL from Workers.
  // Workers call SpaceDO via Service Binding. SpaceDO enforces space_id scoping internally.</span>

  getThreads(spaceId: string, limit = 50): unknown[] {
    return this.db.exec(
      'SELECT * FROM threads WHERE space_id = ? ORDER BY created_at DESC LIMIT ?',
      spaceId, limit
    ).toArray();
  }

  insertThread(spaceId: string, id: string, userId: string, title: string): void {
    const now = new Date().toISOString();
    this.db.exec(
      'INSERT INTO threads (id, space_id, user_id, title, created_at, updated_at) VALUES (?,?,?,?,?,?)',
      id, spaceId, userId, title, now, now
    );
  }

  <span class="cm">// Atomic credit deduction — BEGIN IMMEDIATE serializes writes in DO's single-writer model.
  // The single-writer property of DOs makes this race-condition-free by design.</span>
  deductCredits(userId: string, spaceId: string, credits: number): { success: boolean; remaining: number } {
    const user = this.db.exec(
      'SELECT credits_used, credits_limit FROM product_users WHERE id = ?', userId
    ).one() as { credits_used: number; credits_limit: number | null } | null;
    if (!user) return { success: false, remaining: 0 };
    if (user.credits_limit !== null &amp;&amp; user.credits_used + credits &gt; user.credits_limit) {
      return { success: false, remaining: user.credits_limit - user.credits_used };
    }
    this.db.exec(
      'UPDATE product_users SET credits_used = credits_used + ? WHERE id = ?', credits, userId
    );
    this.db.exec(
      'INSERT INTO billing (id, user_id, space_id, event_type, credits, recorded_at) VALUES (?,?,?,?,?,?)',
      crypto.randomUUID(), userId, spaceId, 'agent_run', credits, new Date().toISOString()
    );
    const newUsed = user.credits_used + credits;
    return { success: true, remaining: user.credits_limit !== null ? user.credits_limit - newUsed : Infinity as unknown as number };
  }

  <span class="cm">// Replaces Supabase stored function get_llm_formatted_messages()
  // Returns messages in the format expected by the LLM context builder.</span>
  getLlmFormattedMessages(threadId: string, limit = 100): Array&lt;{role: string; content: string}&gt; {
    return (this.db.exec(
      'SELECT role, content FROM messages WHERE thread_id = ? ORDER BY created_at ASC LIMIT ?',
      threadId, limit
    ).toArray() as Array&lt;{role: string; content: string}&gt;);
  }

  <span class="cm">// Replaces Supabase RPC get_stale_projects_for_categorization()</span>
  getStaleProjectsForCategorization(staleBefore: string): unknown[] {
    return this.db.exec(
      `SELECT p.id, p.title, p.space_id FROM threads p
       WHERE p.updated_at &lt; ? AND p.space_id IN (SELECT id FROM spaces WHERE status = 'active')
       LIMIT 50`,
      staleBefore
    ).toArray();
  }
}</code></pre>

    <h4>Layer 2 — R2 Key Prefixes</h4>
    <pre><code><span class="cm">// Every R2 operation in every Worker must use this helper.
// Never write to R2 without the space prefix — it's the only way to enforce isolation.
// shared/r2-helpers.ts</span>

export class SpaceR2 {
  constructor(
    private r2: R2Bucket,
    private spaceId: string
  ) {
    <span class="cm">// Validate spaceId format immediately — catch bugs early</span>
    if (!/^[0-9a-f-]{36}$/.test(spaceId)) {
      throw new Error(`Invalid spaceId format: ${spaceId}`);
    }
  }

  <span class="cm">// All R2 operations route through these methods — NEVER call r2.get() directly</span>
  async get(path: string): Promise&lt;R2ObjectBody | null&gt; {
    this.validatePath(path);
    return this.r2.get(`spaces/${this.spaceId}/${path}`);
  }

  async put(path: string, value: string | ArrayBuffer | ReadableStream, options?: R2PutOptions): Promise&lt;void&gt; {
    this.validatePath(path);
    await this.r2.put(`spaces/${this.spaceId}/${path}`, value, options);
  }

  async delete(path: string): Promise&lt;void&gt; {
    this.validatePath(path);
    await this.r2.delete(`spaces/${this.spaceId}/${path}`);
  }

  async list(prefix?: string): Promise&lt;R2Objects&gt; {
    return this.r2.list({ prefix: `spaces/${this.spaceId}/${prefix ?? ''}` });
  }

  private validatePath(path: string): void {
    <span class="cm">// Prevent path traversal attacks: ../../ or absolute paths</span>
    if (path.includes('..') || path.startsWith('/')) {
      throw new Error(`Invalid R2 path: ${path}. Must be relative with no '..'`);
    }
    <span class="cm">// Prevent accessing another space's data by embedding the prefix</span>
    if (path.includes('spaces/')) {
      throw new Error(`R2 path cannot contain 'spaces/': ${path}`);
    }
  }
}

<span class="cm">// Usage in any Worker:</span>
const spaceR2 = new SpaceR2(env.NAELAO_WORKSPACE, spaceId);
await spaceR2.put('workspace/todo.md', content); <span class="cm">// writes to spaces/{spaceId}/workspace/todo.md</span>
const file = await spaceR2.get('workspace/todo.md'); <span class="cm">// reads from spaces/{spaceId}/workspace/todo.md</span></code></pre>

