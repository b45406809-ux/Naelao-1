      <h3>The Task-Completion Loop</h3>
      <p>Unlike the Standard <code>chat</code> loop where the agent waits for user input, the
        <code>task-completion</code> loop is designed for headless background execution. When a webhook arrives, the
        Naelao Router bypasses the UI entirely and wakes the AgentDO directly.</p>

      <pre><code><span class="cm">// agentpress/loops/task-completion.ts
// The isolated execution loop for Launchpad agents.
// Optimizes for speed, low token usage, and strict success/fail states.</span>

export async function executeTaskCompletionLoop(
  triggerEvent: WebhookEvent,
  agentDO: NaelaoAgentDO,
  env: Env
): Promise&lt;void&gt; {
  
  <span class="cm">// 1. Generate system prompt based strictly on the webhook payload</span>
  const messages = [
    { 
      role: 'user', 
      content: `Execute fulfillment for the following event: \n${JSON.stringify(triggerEvent)}` 
    }
  ];

  let iterations = 0;
  const MAX_ITERATIONS = 5; <span class="cm">// Strict limit. Fulfillment should be fast.</span>

  while (iterations < MAX_ITERATIONS) {
    iterations++;

    <span class="cm">// 2. Call LLM (Haiku is preferred here for speed/cost)</span>
    const response = await agentDO.callLLM({
      messages,
      model: 'claude-haiku-4-5',
      temperature: 0.1 <span class="cm">// Highly deterministic</span>
    });

    messages.push({ role: 'assistant', content: response.content });

    <span class="cm">// 3. If no tool calls, the task is considered complete.</span>
    if (!response.toolCalls || response.toolCalls.length === 0) {
      await agentDO.recordTaskSuccess(triggerEvent.id);
      return;
    }

    <span class="cm">// 4. Execute tools (e.g., verify_stripe_payment, send_email, update_db)</span>
    const toolResults = await agentDO.executeTools(response.toolCalls);
    
    <span class="cm">// If a critical tool fails (like payment verification), abort loop immediately</span>
    const criticalFailure = toolResults.find(r => !r.success && r.isFatal);
    if (criticalFailure) {
      await agentDO.recordTaskFailure(triggerEvent.id, criticalFailure.error);
      <span class="cm">// Alert the Space Admin via the Space Assistant</span>
      await env.NAELAO_NOTIFICATIONS_QUEUE.send({
        type: 'fulfillment_failed',
        spaceId: agentDO.spaceId,
        message: `Fulfillment failed for event ${triggerEvent.id}: ${criticalFailure.error}`
      });
      return;
    }

    <span class="cm">// 5. Append tool results and loop</span>
    messages.push({ role: 'user', content: JSON.stringify(toolResults) });
  }

  <span class="cm">// If we hit MAX_ITERATIONS, it's a loop failure (hallucination/stuck)</span>
  await agentDO.recordTaskFailure(triggerEvent.id, "Max iterations exceeded");
}</code></pre>
