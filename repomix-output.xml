  <div class="sec" id="agentpress">
    <span class="sec-ey">04 — AgentPress TypeScript Port</span>
    <h2>AgentPress — Complete TypeScript Port</h2>
    <div class="bar"></div>
    <p class="lead">AgentPress is Suna kortix's execution engine — the Python package under <span
        class="ic">agentpress/</span> in the original repo. Every module must be ported to TypeScript and live in <span
        class="ic">naelao/agentpress/</span>. This section covers every file, every class, every gotcha, and exactly
      what a junior developer must implement line-by-line to get a working port.</p>

    <div class="box box-rd">
      <div class="box-lbl">⚠ Critical Warning Before You Start</div>
      <p>The most common mistake when porting AgentPress from Python to TypeScript is assuming Python's streaming
        behavior maps 1:1 to TypeScript. It does not. Python's <span class="ic">async for chunk in stream</span> is
        synchronous within each chunk — the iterator waits for the next chunk before continuing. In TypeScript with the
        Anthropic SDK, you use <span class="ic">stream.on('text', ...)</span> or <span class="ic">for await (const chunk
          of stream)</span>. The XML parser MUST handle partial tags across chunk boundaries — this is where 90% of bugs
        in AgentPress ports occur. Read the streaming section carefully.</p>
    </div>

    <h3>File-by-File Port Guide</h3>

    <h4>1. agentpress/context-manager.ts</h4>
    <p>The ContextManager builds the message array that gets sent to the LLM. In the Python version, this is <span
        class="ic">agentpress/context_manager.py</span>. Its job: take the raw conversation history from the DO session,
      truncate to fit context limits, inject system prompt, inject tools, and apply prompt caching markers — in exactly
      the right order to maximize Anthropic's cache hit rate.</p>
    <pre><code><span class="cm">// agentpress/context-manager.ts
// Builds the messages array for every LLM call.
// ORDER MATTERS FOR CACHING — do not rearrange without understanding cache_control.</span>

import type { MessageParam, TextBlockParam } from '@anthropic-ai/sdk/resources/messages';

export interface ContextManagerOptions {
  maxTokens: number;          <span class="cm">// Hard limit for context window (e.g., 200000 for Claude)</span>
  systemPrompt: string;       <span class="cm">// Base system prompt from agent definition</span>
  spaceContext: string;       <span class="cm">// Space-specific context (permissions, Space name, etc.)</span>
  skillsXML: string;          <span class="cm">// Skills injected as XML block</span>
  toolDefinitions: ToolDef[]; <span class="cm">// Tools the LLM can call</span>
  knowledgeBase?: string;     <span class="cm">// Project knowledge documents (optional)</span>
}

export class ContextManager {
  constructor(private opts: ContextManagerOptions) {}

  buildMessages(
    rawMessages: SessionMessage[],
    tokenCounter: TokenCounter
  ): { system: TextBlockParam[]; messages: MessageParam[] } {
    
    <span class="cm">// STEP 1: Build the system prompt blocks IN THIS EXACT ORDER.
    // Anthropic caches prefix blocks. Static blocks must come FIRST.
    // Dynamic blocks (knowledge, current task) must come LAST.
    // Swapping these destroys cache efficiency — 90% more input tokens per call.</span>
    
    const system: TextBlockParam[] = [
      <span class="cm">// Block 1: Base system prompt — STATIC, cached across all calls for this agent definition</span>
      {
        type: 'text',
        text: this.opts.systemPrompt,
        cache_control: { type: 'ephemeral' }  <span class="cm">// cache this block</span>
      },
      <span class="cm">// Block 2: Space context — STATIC for this session (Space name, permissions)</span>
      {
        type: 'text',
        text: this.opts.spaceContext,
        cache_control: { type: 'ephemeral' }
      },
      <span class="cm">// Block 3: Skills XML — SEMI-STATIC (changes only when skills change)</span>
      {
        type: 'text',
        text: this.opts.skillsXML,
        cache_control: { type: 'ephemeral' }
      },
      <span class="cm">// Block 4: Knowledge base — DYNAMIC (may change per query via semantic search)</span>
      <span class="cm">// NO cache_control here — different every call</span>
      ...(this.opts.knowledgeBase ? [{
        type: 'text' as const,
        text: `<knowledge_base>\n${this.opts.knowledgeBase}\n</knowledge_base>`
      }] : []),
    ];

    <span class="cm">// STEP 2: Build the messages array.
    // Truncate from the MIDDLE if context is too long — preserve the latest user message
    // and the oldest context (system prompt is separate, not in messages array).</span>
    
    let messages = rawMessages.map(m => ({
      role: m.role as 'user' | 'assistant',
      content: m.content
    }));

    <span class="cm">// Count tokens — use the Anthropic tokenizer, not a character estimate
    // Character estimates are wrong by 30-50% for code-heavy conversations</span>
    const totalTokens = tokenCounter.count(messages);
    
    if (totalTokens > this.opts.maxTokens * 0.85) {
      <span class="cm">// Truncate: remove from position 2 (after first user msg) to keep context coherent
      // Never remove the very first user message — it establishes the task</span>
      messages = this.truncateMiddle(messages, this.opts.maxTokens * 0.75, tokenCounter);
    }

    return { system, messages };
  }

  private truncateMiddle(
    messages: MessageParam[],
    targetTokens: number,
    counter: TokenCounter
  ): MessageParam[] {
    <span class="cm">// Keep first 2 and last N messages, remove from the middle
    // This preserves task context (first) and recent context (last)</span>
    const keep = [messages[0]]; <span class="cm">// Always keep first</span>
    let tokens = counter.count([messages[0]]);
    
    <span class="cm">// Add from the end backwards until we hit the target</span>
    for (let i = messages.length - 1; i > 0; i--) {
      const msgTokens = counter.count([messages[i]]);
      if (tokens + msgTokens > targetTokens) break;
      keep.splice(1, 0, messages[i]); <span class="cm">// insert after first</span>
      tokens += msgTokens;
    }
    
    return keep;
  }
}</code></pre>

    <h4>2. agentpress/xml-parser.ts</h4>
    <p>This is the most bug-prone file in the entire port. The LLM emits tool calls as XML inside the streaming
      response. The problem: a single XML tag can be split across multiple streaming chunks. Your parser must buffer
      incomplete tags and only emit complete ones. Get this wrong and tool calls will silently fail or produce garbled
      output.</p>
    <pre><code><span class="cm">// agentpress/xml-parser.ts
// Streaming XML parser for tool call extraction.
// CRITICAL: Must handle partial tags across chunk boundaries.
// This is the most common source of bugs in AgentPress ports.

// Example of what the LLM emits (one tool call across 3 streaming chunks):
// Chunk 1: "I'll search for that. <web_se"
// Chunk 2: "arch><query>CF Worker"
// Chunk 3: "s</query></web_search>"
// Your parser must buffer across these three chunks and emit ONE complete tool call.</span>

export interface ParsedToolCall {
  toolName: string;
  parameters: Record&lt;string, string&gt;;
  rawXml: string;
}

export class StreamingXMLParser {
  private buffer = '';
  private insideTag = false;
  private currentTagName = '';
  private onToolCall: (call: ParsedToolCall) => void;

  constructor(onToolCall: (call: ParsedToolCall) => void) {
    this.onToolCall = onToolCall;
  }

  <span class="cm">// Call this for EVERY chunk from the LLM stream</span>
  feed(chunk: string): string {
    this.buffer += chunk;
    let textContent = '';

    while (true) {
      if (!this.insideTag) {
        <span class="cm">// Look for an opening tool call tag
        // Tool call tags are known tool names in angle brackets
        // We don't know which tag names exist at parse time, so we detect any tag</span>
        const openIdx = this.buffer.indexOf('&lt;');
        if (openIdx === -1) {
          <span class="cm">// No tag start — all buffer is text</span>
          textContent += this.buffer;
          this.buffer = '';
          break;
        }
        
        <span class="cm">// Text before the tag is regular content</span>
        textContent += this.buffer.slice(0, openIdx);
        this.buffer = this.buffer.slice(openIdx);
        this.insideTag = true;
      }

      if (this.insideTag) {
        <span class="cm">// Look for closing &gt; to complete the opening tag</span>
        const closeIdx = this.buffer.indexOf('&gt;');
        if (closeIdx === -1) {
          <span class="cm">// Incomplete tag — wait for more chunks
          // This is the NORMAL CASE for partial chunks. DO NOT emit anything.</span>
          break;
        }

        const tag = this.buffer.slice(1, closeIdx); <span class="cm">// content between &lt; and &gt;</span>
        
        <span class="cm">// Is this a closing tag? (starts with /)</span>
        if (tag.startsWith('/')) {
          this.insideTag = false;
          this.buffer = this.buffer.slice(closeIdx + 1);
          continue;
        }

        <span class="cm">// This is an opening tool tag — now find its closing tag</span>
        this.currentTagName = tag.trim().split(' ')[0];
        const closingTag = `&lt;/${this.currentTagName}&gt;`;
        const fullCloseIdx = this.buffer.indexOf(closingTag);
        
        if (fullCloseIdx === -1) {
          <span class="cm">// The closing tag hasn't arrived yet — wait for more chunks</span>
          break;
        }

        <span class="cm">// We have a complete tool call element — parse it</span>
        const rawXml = this.buffer.slice(0, fullCloseIdx + closingTag.length);
        this.buffer = this.buffer.slice(fullCloseIdx + closingTag.length);
        this.insideTag = false;

        const toolCall = this.parseToolXml(rawXml, this.currentTagName);
        if (toolCall) {
          this.onToolCall(toolCall);
        }
      }
    }

    return textContent;
  }

  private parseToolXml(rawXml: string, toolName: string): ParsedToolCall | null {
    <span class="cm">// Extract parameter tags from within the tool call XML
    // e.g., &lt;web_search&gt;&lt;query&gt;Hello&lt;/query&gt;&lt;num_results&gt;5&lt;/num_results&gt;&lt;/web_search&gt;</span>
    const parameters: Record&lt;string, string&gt; = {};
    const paramRegex = /&lt;(\w+)&gt;([\s\S]*?)&lt;\/\1&gt;/g;
    let match;
    
    <span class="cm">// Strip the outer tool tag to get to parameters</span>
    const inner = rawXml
      .replace(`&lt;${toolName}&gt;`, '')
      .replace(`&lt;/${toolName}&gt;`, '');
    
    while ((match = paramRegex.exec(inner)) !== null) {
      parameters[match[1]] = match[2].trim();
    }
    
    return { toolName, parameters, rawXml };
  }

  <span class="cm">// Call when stream ends — check for any incomplete buffered content</span>
  flush(): string {
    const remaining = this.buffer;
    this.buffer = '';
    this.insideTag = false;
    return remaining; <span class="cm">// Return any trailing text content</span>
  }
}</code></pre>

    <h4>3. agentpress/orchestrator.ts</h4>
    <p>The orchestrator takes the parsed tool calls and executes them. It decides: which tools can run in parallel,
      which must be serial, and which need a container vs which can run at the edge. This is where the execution ladder
      is implemented.</p>
    <pre><code><span class="cm">// agentpress/orchestrator.ts
// Execution ladder: workspace → isolate → npm → browser → sandbox
// Each tier is only used if the tool actually needs it.
// A web_search never needs a container. A python_exec always does.
// Getting this right cuts container costs by 60-80%.</span>

export type ExecutionTier = 'workspace' | 'isolate' | 'npm' | 'browser' | 'sandbox';

export interface ToolManifest {
  name: string;
  tier: ExecutionTier;
  parallel: boolean;  <span class="cm">// Can this tool run in parallel with others?</span>
}

<span class="cm">// Hard-coded tool tier assignments — these never change per agent</span>
const TOOL_TIERS: Record&lt;string, ToolManifest&gt; = {
  <span class="cm">// Tier 1: workspace — pure R2 reads/writes, no compute isolate</span>
  'read_file':       { name: 'read_file',       tier: 'workspace', parallel: true },
  'write_file':      { name: 'write_file',      tier: 'workspace', parallel: false },
  'list_directory':  { name: 'list_directory',  tier: 'workspace', parallel: true },
  'delete_file':     { name: 'delete_file',     tier: 'workspace', parallel: false },
  
  <span class="cm">// Tier 2: isolate — V8 Dynamic Worker, &lt;5ms boot, TypeScript/JS only</span>
  'web_search':      { name: 'web_search',      tier: 'isolate',   parallel: true },
  'api_call':        { name: 'api_call',         tier: 'isolate',   parallel: true },
  'render_artifact': { name: 'render_artifact', tier: 'isolate',   parallel: false },
  'data_transform':  { name: 'data_transform',  tier: 'isolate',   parallel: true },
  
  <span class="cm">// Tier 4: browser — CF Browser Rendering, ~200ms boot</span>
  'browser_navigate':{ name: 'browser_navigate',tier: 'browser',   parallel: false },
  'browser_scrape':  { name: 'browser_scrape',  tier: 'browser',   parallel: false },
  'browser_click':   { name: 'browser_click',   tier: 'browser',   parallel: false },
  
  <span class="cm">// Tier 5: sandbox — CF Container, 2-3s boot, full Linux</span>
  'execute_python':  { name: 'execute_python',  tier: 'sandbox',   parallel: false },
  'execute_bash':    { name: 'execute_bash',    tier: 'sandbox',   parallel: false },
  'execute_node':    { name: 'execute_node',    tier: 'sandbox',   parallel: false },
  'git_clone':       { name: 'git_clone',       tier: 'sandbox',   parallel: false },
  'install_package': { name: 'install_package', tier: 'sandbox',   parallel: false },
};

export class Orchestrator {
  constructor(
    private env: Env,
    private spaceId: string,
    private sandboxDO: DurableObjectStub,
    private wal: WAL
  ) {}

  async executeTools(
    toolCalls: ParsedToolCall[],
    runId: string
  ): Promise&lt;ToolResult[]&gt; {
    
    <span class="cm">// Group tools by tier for batching</span>
    const byTier = this.groupByTier(toolCalls);
    const results: ToolResult[] = [];

    <span class="cm">// Execute workspace tier in parallel (pure R2 ops, no compute)</span>
    if (byTier.workspace?.length) {
      const parallelResults = await Promise.all(
        byTier.workspace.map(tc => 
          this.wal.executeWithWAL(runId, tc.toolName, tc.parameters, () =>
            this.executeWorkspaceTool(tc)
          )
        )
      );
      results.push(...parallelResults);
    }

    <span class="cm">// Execute isolate tier in parallel (V8 Dynamic Workers)</span>
    if (byTier.isolate?.length) {
      const parallelResults = await Promise.all(
        byTier.isolate
          .filter(tc => TOOL_TIERS[tc.toolName]?.parallel)
          .map(tc =>
            this.wal.executeWithWAL(runId, tc.toolName, tc.parameters, () =>
              this.executeIsolateTool(tc)
            )
          )
      );
      results.push(...parallelResults);
    }

    <span class="cm">// Execute browser tier SERIALLY (shared browser resource, no parallel)</span>
    if (byTier.browser?.length) {
      for (const tc of byTier.browser) {
        const result = await this.wal.executeWithWAL(runId, tc.toolName, tc.parameters, () =>
          this.executeBrowserTool(tc)
        );
        results.push(result);
      }
    }

    <span class="cm">// Execute sandbox tier SERIALLY (container commands must be ordered)</span>
    if (byTier.sandbox?.length) {
      <span class="cm">// Ensure container is running ONCE before sending multiple commands</span>
      await this.ensureContainerRunning();
      for (const tc of byTier.sandbox) {
        const result = await this.wal.executeWithWAL(runId, tc.toolName, tc.parameters, () =>
          this.executeSandboxTool(tc)
        );
        results.push(result);
      }
    }

    return results;
  }

  private async executeWorkspaceTool(tc: ParsedToolCall): Promise&lt;ToolResult&gt; {
    const { toolName, parameters } = tc;
    
    if (toolName === 'read_file') {
      const obj = await this.env.NAELAO_WORKSPACE.get(
        `spaces/${this.spaceId}/workspace/${parameters.path}`
      );
      if (!obj) return { toolName, output: { error: 'File not found' } };
      return { toolName, output: { content: await obj.text() } };
    }
    
    if (toolName === 'write_file') {
      <span class="cm">// Write to R2 — this IS the persistent filesystem</span>
      await this.env.NAELAO_WORKSPACE.put(
        `spaces/${this.spaceId}/workspace/${parameters.path}`,
        parameters.content,
        { customMetadata: { mimeType: 'text/plain', updatedAt: Date.now().toString() } }
      );
      return { toolName, output: { success: true, path: parameters.path } };
    }
    
    throw new Error(`Unknown workspace tool: ${toolName}`);
  }

  private async ensureContainerRunning(): Promise&lt;void&gt; {
    <span class="cm">// Ping SandboxDO to ensure container is running
    // SandboxDO handles the boot idempotently — calling this twice is safe</span>
    await this.sandboxDO.fetch(new Request('http://sandbox/ensure-running', {
      method: 'POST',
      body: JSON.stringify({ spaceId: this.spaceId })
    }));
  }

  private async executeSandboxTool(tc: ParsedToolCall): Promise&lt;ToolResult&gt; {
    const response = await this.sandboxDO.fetch(new Request('http://sandbox/exec', {
      method: 'POST',
      body: JSON.stringify({
        command: tc.toolName,
        args: tc.parameters,
        spaceId: this.spaceId
      })
    }));
    return { toolName: tc.toolName, output: await response.json() };
  }

  private groupByTier(toolCalls: ParsedToolCall[]): Partial&lt;Record&lt;ExecutionTier, ParsedToolCall[]&gt;&gt; {
    return toolCalls.reduce((acc, tc) => {
      const tier = TOOL_TIERS[tc.toolName]?.tier ?? 'sandbox'; <span class="cm">// default to safest tier</span>
      if (!acc[tier]) acc[tier] = [];
      acc[tier]!.push(tc);
      return acc;
    }, {} as Partial&lt;Record&lt;ExecutionTier, ParsedToolCall[]&gt;&gt;);
  }
}</code></pre>

    <h4>4. agentpress/prompt-cache.ts</h4>
    <p>Anthropic's prompt caching can save 80-90% of input token costs for long agent runs. The cache works on the
      prefix of your messages. If the first N tokens of your messages array match a previous call, they're served from
      cache at 10% of the normal cost. The rules for maximizing cache hits are strict — violate them and you lose all
      cache benefit.</p>
    <pre><code><span class="cm">// agentpress/prompt-cache.ts
// Anthropic prompt caching rules:
// 1. cache_control: {type: 'ephemeral'} marks a block as a cache breakpoint
// 2. Blocks BEFORE a cache breakpoint are cached
// 3. cache_control can only be on the LAST content block in a message
// 4. Minimum 1024 tokens must be in the cached portion to activate caching
// 5. Cache TTL is 5 minutes — if your agent is idle &gt;5min between turns, cache misses

export function applyCacheControl(messages: MessageParam[]): MessageParam[] {
  <span class="cm">// Find the last 3 'human' role messages that are large enough to cache
  // These are the "cache breakpoints" — everything before them is cached</span>
  const humanMessages = messages
    .map((m, i) => ({ m, i }))
    .filter(({ m }) => m.role === 'user');
  
  <span class="cm">// Apply cache_control to the last human message
  // This tells Anthropic: "cache everything up to and including this block"</span>
  if (humanMessages.length &gt; 0) {
    const last = humanMessages[humanMessages.length - 1];
    const content = Array.isArray(last.m.content) ? last.m.content : [{ type: 'text', text: last.m.content }];
    const lastBlock = content[content.length - 1];
    if (lastBlock.type === 'text') {
      (lastBlock as any).cache_control = { type: 'ephemeral' };
    }
    messages[last.i] = { ...last.m, content };
  }
  
  return messages;
}

<span class="cm">// Track cache hit rate for billing analytics</span>
export function parseCacheMetrics(usage: APIUsage): CacheMetrics {
  return {
    inputTokens:       usage.input_tokens,
    outputTokens:      usage.output_tokens,
    cacheReadTokens:   usage.cache_read_input_tokens ?? 0,
    cacheWriteTokens:  usage.cache_creation_input_tokens ?? 0,
    <span class="cm">// Effective cost = (input - cacheRead)*100% + cacheRead*10% + cacheWrite*125% + output</span>
    costMultiplier: (
      (usage.input_tokens - (usage.cache_read_input_tokens ?? 0)) +
      ((usage.cache_read_input_tokens ?? 0) * 0.1) +
      ((usage.cache_creation_input_tokens ?? 0) * 1.25) +
      usage.output_tokens
    ) / (usage.input_tokens + usage.output_tokens)
  };
}</code></pre>
