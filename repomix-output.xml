          <pre><code><span class="cm">// workers/security-scanner/index.ts</span>

export async function runSecurityScan(pkg: SpaceTypePackage, env: Env): Promise&lt;ScanReport&gt; {
  const gates: GateResult[] = [];
  const blockers: string[]  = [];

  <span class="cm">// Gate 1: Manifest schema validation</span>
  const manifestResult = validateManifest(pkg.manifest);
  gates.push({ gate: 'manifest-validation', ...manifestResult });
  if (!manifestResult.passed) blockers.push(manifestResult.details);

  <span class="cm">// Gate 2: DO permissions must be within allowed set</span>
  const allowedPerms = new Set(['read', 'write', 'delete', 'list', 'subscribe']);
  for (const customDO of pkg.manifest.customDurableObjects ?? []) {
    for (const perm of customDO.permissions) {
      if (!allowedPerms.has(perm)) {
        const d = `Custom DO "${customDO.className}" declares illegal permission: "${perm}"`;
        gates.push({ gate: 'do-permission-audit', passed: false, details: d });
        blockers.push(d);
      }
    }
  }
  if (!blockers.some(b =&gt; b.includes('permission'))) {
    gates.push({ gate: 'do-permission-audit', passed: true, details: 'All DO permissions validated' });
  }

  <span class="cm">// Gate 3: Network policy — non-developer types must use 'restricted' mode, no wildcards</span>
  const net = pkg.manifest.agentConfig?.networkPolicy;
  if (!net || (net.mode === 'open' &amp;&amp; pkg.manifest.securityLabel !== 'developer')) {
    const d = 'Non-developer Space Types must set networkPolicy.mode to "restricted"';
    gates.push({ gate: 'network-policy-check', passed: false, details: d });
    blockers.push(d);
  } else {
    const hasWild = (net.allowlist ?? []).some((d: string) =&gt; d.startsWith('*'));
    if (hasWild &amp;&amp; pkg.manifest.securityLabel !== 'developer') {
      const d = 'Wildcard allowlist entries are only permitted for developer-labeled Space Types';
      gates.push({ gate: 'network-policy-check', passed: false, details: d });
      blockers.push(d);
    } else {
      gates.push({ gate: 'network-policy-check', passed: true, details: `Policy: ${net.mode}` });
    }
  }

  <span class="cm">// Gate 4: Declared capabilities must be within the tier's capability matrix</span>
  const capMatrix = await env.NAELAO_CONFIG_KV.get('capability-matrix', 'json') as Record&lt;string, string[]&gt;;
  const allowedCaps = capMatrix[pkg.manifest.category] ?? [];
  const illegalCaps = (pkg.manifest.capabilities ?? []).filter((c: string) =&gt; !allowedCaps.includes(c));
  if (illegalCaps.length) {
    const d = `Capabilities not allowed for category "${pkg.manifest.category}": ${illegalCaps.join(', ')}`;
    gates.push({ gate: 'data-access-scope-audit', passed: false, details: d });
    blockers.push(d);
  } else {
    gates.push({ gate: 'data-access-scope-audit', passed: true, details: 'All capabilities validated' });
  }

  <span class="cm">// Gate 5: wrangler.jsonc bindings must exactly match manifest declarations — no undeclared bindings</span>
  const declared = new Set([
    ...(pkg.manifest.customDurableObjects ?? []).map((d: any) =&gt; d.bindingName),
    ...(pkg.manifest.requiredBindings ?? [])
  ]);
  const undeclared = (pkg.wranglerBindings ?? []).filter((b: string) =&gt; !declared.has(b));
  if (undeclared.length) {
    const d = `wrangler.jsonc declares bindings not in manifest: ${undeclared.join(', ')}`;
    gates.push({ gate: 'wrangler-binding-diff', passed: false, details: d });
    blockers.push(d);
  } else {
    gates.push({ gate: 'wrangler-binding-diff', passed: true, details: 'Bindings match manifest' });
  }

  const report: ScanReport = {
    spaceTypeId: pkg.manifest.typeId,
    timestamp: Date.now(),
    passed: blockers.length === 0,
    gates, blockers
  };

  await env.NAELAO_ANALYTICS_QUEUE.send({
    type: 'security_scan_complete', spaceTypeId: pkg.manifest.typeId,
    passed: report.passed, blockerCount: blockers.length, blockers: blockers.join('; ')
  });

  return report;
}</code></pre>

          <h3>CartDO — Example Custom DO for Launchpad</h3>
          <pre><code><span class="cm">// packages/space-types/launchpad/durable-objects/cart-do.ts</span>
export class CartDO extends DurableObject {
  private async initSchema() {
    this.ctx.storage.sql.exec(`
      CREATE TABLE IF NOT EXISTS cart_items (
        sku       TEXT PRIMARY KEY, name TEXT NOT NULL,
        price_usd REAL NOT NULL, quantity INTEGER NOT NULL DEFAULT 1, metadata TEXT DEFAULT '{}'
      )
    `);
  }

  async fetch(request: Request): Promise&lt;Response&gt; {
    await this.initSchema();
    const url = new URL(request.url);

    if (url.pathname === '/add') {
      const { sku, name, priceUsd, quantity = 1, metadata = {} } = await request.json();
      this.ctx.storage.sql.exec(
        `INSERT INTO cart_items VALUES (?,?,?,?,?) ON CONFLICT(sku) DO UPDATE SET quantity=quantity+excluded.quantity`,
        sku, name, priceUsd, quantity, JSON.stringify(metadata)
      );
      await this.ctx.storage.setAlarm(Date.now() + 30 * 60 * 1000); <span class="cm">// reset 30-min TTL</span>
      return Response.json({ success: true });
    }
    if (url.pathname === '/get') {
      const items = this.ctx.storage.sql.exec('SELECT * FROM cart_items').toArray();
      const total = items.reduce((s, i) =&gt; s + (i.price_usd as number) * (i.quantity as number), 0);
      return Response.json({ items, total, itemCount: items.length });
    }
    if (url.pathname === '/checkout') {
      const items = this.ctx.storage.sql.exec('SELECT * FROM cart_items').toArray();
      const total = items.reduce((s, i) =&gt; s + (i.price_usd as number) * (i.quantity as number), 0);
      this.ctx.storage.sql.exec('DELETE FROM cart_items');
      await this.ctx.storage.deleteAlarm();
      return Response.json({ items, total, checkoutToken: crypto.randomUUID() });
    }
    return new Response('Not Found', { status: 404 });
  }

  async alarm() { <span class="cm">// Cart TTL expired — clean up</span>
    this.ctx.storage.sql.exec('DELETE FROM cart_items');
  }
}</code></pre>

