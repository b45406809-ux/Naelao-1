<file path="apps/shell/src/components/ConnectorAliases.tsx">
"use client";

import {
  type ConnectorAlias,
  type ConnectorInfo,
  type SessionCredentials,
  createConnectorAlias,
  deleteConnectorAlias,
  getConnectorAliases,
} from "@/lib/api";
import { Button, FormInput } from "@naelao/ui";
import * as React from "react";

export function ConnectorAliases({
  spaceId,
  session,
  connectors,
  onError,
}: {
  spaceId: string;
  session: SessionCredentials;
  connectors: ConnectorInfo[];
  onError(message: string): void;
}) {
  const [aliases, setAliases] = React.useState<ConnectorAlias[]>([]);
  const [name, setName] = React.useState("");
  const [connector, setConnector] = React.useState("");
  const [busy, setBusy] = React.useState(false);

  const refresh = React.useCallback(async () => {
    try {
      setAliases(await getConnectorAliases(spaceId, session));
    } catch (error) {
      onError(
        error instanceof Error
          ? error.message
          : "Couldn't load connector aliases"
      );
    }
  }, [spaceId, session, onError]);

  React.useEffect(() => void refresh(), [refresh]);
  const connected = connectors.filter((item) => item.connected);

  async function create() {
    if (!name || !connector) return;
    setBusy(true);
    try {
      await createConnectorAlias(
        spaceId,
        { alias: name, scope: "space", connector_name: connector },
        session
      );
      setName("");
      await refresh();
    } catch (error) {
      onError(
        error instanceof Error
          ? error.message
          : "Couldn't create connector alias"
      );
    } finally {
      setBusy(false);
    }
  }

  return (
    <section
      className="settings-block"
      aria-labelledby="connector-alias-heading"
    >
      <div
        className="settings-row"
        style={{ alignItems: "flex-start", gap: 12 }}
      >
        <div style={{ flex: 1 }}>
          <div id="connector-alias-heading" className="settings-row-label">
            Logical aliases
          </div>
          <div className="settings-row-sub">
            Give automations stable names such as primary_inbox. Rebinding an
            app never changes workflow source code.
          </div>
        </div>
        <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
          <FormInput
            aria-label="Alias name"
            placeholder="primary_inbox"
            value={name}
            onChange={(event) =>
              setName(
                event.target.value.toLowerCase().replace(/[^a-z0-9_]/g, "")
              )
            }
          />
          <select
            aria-label="Connected app"
            value={connector}
            onChange={(event) => setConnector(event.target.value)}
          >
            <option value="">Choose connected app</option>
            {connected.map((item) => (
              <option key={item.id} value={item.id}>
                {item.name}
              </option>
            ))}
          </select>
          <Button
            size="sm"
            disabled={busy || name.length < 2 || !connector}
            onClick={() => void create()}
          >
            {busy ? "Saving…" : "Add alias"}
          </Button>
        </div>
      </div>
      {aliases.length === 0 ? (
        <p className="settings-row-sub">No aliases yet.</p>
      ) : (
        aliases.map((alias) => (
          <div className="settings-row" key={alias.id}>
            <div>
              <div className="settings-row-label">
                <code>{alias.alias}</code>
              </div>
              <div className="settings-row-sub">
                {alias.scope} connector · {alias.server_id}
              </div>
            </div>
            <Button
              size="sm"
              variant="secondary"
              onClick={() =>
                void deleteConnectorAlias(spaceId, alias.id, session)
                  .then(refresh)
                  .catch((error) =>
                    onError(
                      error instanceof Error
                        ? error.message
                        : "Couldn't remove alias"
                    )
                  )
              }
            >
              Remove
            </Button>
          </div>
        ))
      )}
    </section>
  );
}
</file>

<file path="apps/shell/src/components/ContextUsageMeter.tsx">
"use client";

// §A1.27: Claude-Code-web-style context-window usage meter — current session size vs. the
// selected model's context window, plus daily/weekly/monthly usage against the org's plan limit.
// Triggers a pre-send compaction pass (Memory OS maintenance, run early) once percent_full
// crosses COMPACT_THRESHOLD, client-driven rather than a hidden per-message server check (see
// the /compact route's own comment for why).

import * as React from "react";
import { getContextUsage, compactSession, type ContextUsage } from "@/lib/api";
import type { SessionCredentials } from "@/lib/api";

const COMPACT_THRESHOLD = 85;

function formatCount(n: number | null): string {
  if (n === null) return "—";
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(1)}K`;
  return String(n);
}

function barColor(percent: number): string {
  if (percent >= COMPACT_THRESHOLD) return "var(--danger, #e5484d)";
  if (percent >= 60) return "var(--warning, #f5a623)";
  return "var(--brand, #5b52f0)";
}

export function ContextUsageMeter({
  spaceId,
  sessionId,
  session,
  model = "claude-haiku-4-5-20251001",
  /** Increment this after every completed run to force a refresh. */
  refreshKey,
  /** A single-line strip (bar + percentage + Compact button, no daily/weekly/monthly rows) meant
   *  to sit right above the composer, always visible — not buried in a side-panel tab a person
   *  has to open to notice their context is filling up. */
  compact = false,
}: {
  spaceId: string;
  sessionId: string | null;
  session: SessionCredentials;
  model?: string;
  refreshKey?: number;
  compact?: boolean;
}) {
  const [usage, setUsage] = React.useState<ContextUsage | null>(null);
  const [compacting, setCompacting] = React.useState(false);
  const [justCompacted, setJustCompacted] = React.useState(false);
  const compactedForKeyRef = React.useRef<number | undefined>(undefined);
  const fetchKeyRef = React.useRef(0);

  const refetch = React.useCallback(async () => {
    if (!sessionId) return;
    const myKey = ++fetchKeyRef.current;
    try {
      const result = await getContextUsage(spaceId, sessionId, session, model);
      if (fetchKeyRef.current !== myKey) return;
      setUsage(result);
      return result;
    } catch {
      // Usage endpoint unreachable — the chat itself still works, just no meter this render.
      return undefined;
    }
  }, [spaceId, sessionId, session, model]);

  React.useEffect(() => {
    if (!sessionId) return;
    void (async () => {
      const result = await refetch();
      if (!result) return;
      // Auto-compact once per crossing, not on every poll — compactedForKeyRef gates it to
      // fire at most once per refreshKey (i.e. once per completed run that crossed the line).
      // Only the compact variant does this: it's the one guaranteed to be mounted whenever a
      // session exists (the full variant lives inside the Stats tab, only mounted when the side
      // panel is open) — letting both fire would risk two overlapping compaction calls for the
      // same crossing.
      if (compact && result.percent_full >= COMPACT_THRESHOLD && compactedForKeyRef.current !== refreshKey) {
        compactedForKeyRef.current = refreshKey;
        void compactSession(spaceId, sessionId, session).catch(() => {
          /* best-effort — the meter still shows the real percentage either way */
        });
      }
    })();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [spaceId, sessionId, session, model, refreshKey, compact]);

  async function handleManualCompact() {
    if (!sessionId || compacting) return;
    setCompacting(true);
    try {
      await compactSession(spaceId, sessionId, session);
      await refetch();
      setJustCompacted(true);
      window.setTimeout(() => setJustCompacted(false), 3000);
    } catch {
      // The endpoint failing to reach a real Memory OS maintenance pass shouldn't read as a
      // silent no-op — but this is a convenience action, so the meter just stops spinning and
      // the person can try again rather than being shown a hard error.
    } finally {
      setCompacting(false);
    }
  }

  if (!usage) return null;

  if (compact) {
    // Only worth a person's attention once it's actually filling up — below that this is just
    // clutter above every composer on every page, which is the opposite of "more prominent".
    if (usage.percent_full < 40) return null;
    return (
      <div
        className="context-usage-meter-compact"
        style={{ display: "flex", alignItems: "center", gap: 8, fontSize: 11, color: "var(--text3)", padding: "0 2px 4px" }}
      >
        <div style={{ flex: 1, height: 3, borderRadius: 2, background: "var(--surface2, #23232b)", overflow: "hidden" }}>
          <div
            style={{
              height: "100%",
              width: `${Math.min(100, usage.percent_full)}%`,
              background: barColor(usage.percent_full),
              transition: "width 200ms ease",
            }}
          />
        </div>
        <span>{usage.percent_full}% context</span>
        {sessionId && (
          <button
            type="button"
            onClick={() => void handleManualCompact()}
            disabled={compacting}
            title="Run memory maintenance now, ahead of the automatic 85% threshold"
            style={{
              fontSize: 10.5,
              padding: "1px 7px",
              borderRadius: 999,
              border: "1px solid var(--border)",
              background: "transparent",
              color: justCompacted ? "var(--success, #2ecc71)" : "var(--text3)",
              cursor: compacting ? "default" : "pointer",
              opacity: compacting ? 0.6 : 1,
            }}
          >
            {compacting ? "Compacting…" : justCompacted ? "Compacted" : "Compact"}
          </button>
        )}
      </div>
    );
  }

  return (
    <div className="context-usage-meter" style={{ display: "flex", flexDirection: "column", gap: 6, padding: "8px 0" }}>
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", fontSize: 12, color: "var(--text3)" }}>
        <span>Context window</span>
        <span style={{ display: "flex", alignItems: "center", gap: 8 }}>
          {formatCount(usage.current_tokens)} / {formatCount(usage.model_window)} ({usage.percent_full}%)
          {sessionId && (
            <button
              type="button"
              onClick={() => void handleManualCompact()}
              disabled={compacting}
              title="Run memory maintenance now, ahead of the automatic 85% threshold"
              style={{
                fontSize: 10.5,
                padding: "1px 7px",
                borderRadius: 999,
                border: "1px solid var(--border)",
                background: "transparent",
                color: justCompacted ? "var(--success, #2ecc71)" : "var(--text3)",
                cursor: compacting ? "default" : "pointer",
                opacity: compacting ? 0.6 : 1,
              }}
            >
              {compacting ? "Compacting…" : justCompacted ? "Compacted" : "Compact"}
            </button>
          )}
        </span>
      </div>
      {/* Segmented bar — one coloured segment per breakdown category (Claude Code style). Falls
          back to the single conversation bar when the backend didn't send a breakdown. */}
      {usage.breakdown && usage.breakdown.length > 0 ? (
        <div style={{ display: "flex", height: 8, borderRadius: 3, overflow: "hidden", background: "var(--surface2, #23232b)" }}>
          {usage.breakdown.map((seg) => {
            const pct = usage.model_window > 0 ? (seg.tokens / usage.model_window) * 100 : 0;
            if (pct <= 0) return null;
            return (
              <div
                key={seg.key}
                title={`${seg.label}: ${formatCount(seg.tokens)} tokens`}
                style={{ width: `${pct}%`, background: SEGMENT_COLORS[seg.key] ?? "var(--text3)", transition: "width 200ms ease" }}
              />
            );
          })}
        </div>
      ) : (
        <div style={{ height: 8, borderRadius: 3, background: "var(--surface2, #23232b)", overflow: "hidden" }}>
          <div style={{ height: "100%", width: `${Math.min(100, usage.percent_full)}%`, background: barColor(usage.percent_full), transition: "width 200ms ease" }} />
        </div>
      )}

      {/* Labeled category rows: coloured dot + label + token count + %. */}
      {usage.breakdown && usage.breakdown.length > 0 && (
        <div style={{ display: "flex", flexDirection: "column", gap: 3, marginTop: 4 }}>
          {usage.breakdown.map((seg) => {
            const pct = usage.model_window > 0 ? Math.round((seg.tokens / usage.model_window) * 100) : 0;
            return (
              <div key={seg.key} style={{ display: "flex", alignItems: "center", gap: 8, fontSize: 11.5 }}>
                <span style={{ width: 9, height: 9, borderRadius: 2, background: SEGMENT_COLORS[seg.key] ?? "var(--text3)", flexShrink: 0 }} />
                <span style={{ flex: 1, color: "var(--text1)" }}>
                  {seg.label}
                  {seg.estimated && <span style={{ color: "var(--text3)", fontSize: 10 }}> (est.)</span>}
                </span>
                <span style={{ color: "var(--text3)", fontVariantNumeric: "tabular-nums" }}>{formatCount(seg.tokens)}</span>
                <span style={{ color: "var(--text3)", width: 34, textAlign: "right", fontVariantNumeric: "tabular-nums" }}>{pct}%</span>
              </div>
            );
          })}
        </div>
      )}

      {/* Plan usage — day/week/month against the org's token limit, as progress bars. */}
      {(usage.daily_limit !== null || usage.weekly_limit !== null || usage.monthly_limit !== null) && (
        <div style={{ marginTop: 8, display: "flex", flexDirection: "column", gap: 6 }}>
          <div style={{ fontSize: 11, color: "var(--text3)", fontWeight: 600, textTransform: "uppercase", letterSpacing: 0.4 }}>Plan usage</div>
          {([
            { label: "Today", used: usage.daily_used, limit: usage.daily_limit },
            { label: "This week", used: usage.weekly_used, limit: usage.weekly_limit },
            { label: "This month", used: usage.monthly_used, limit: usage.monthly_limit },
          ] as const)
            .filter((r) => r.limit !== null)
            .map((r) => {
              const used = r.used ?? 0;
              const limit = r.limit ?? 1;
              const pct = limit > 0 ? Math.min(100, Math.round((used / limit) * 100)) : 0;
              return (
                <div key={r.label} style={{ display: "flex", flexDirection: "column", gap: 3 }}>
                  <div style={{ display: "flex", justifyContent: "space-between", fontSize: 11, color: "var(--text3)" }}>
                    <span>{r.label}</span>
                    <span style={{ fontVariantNumeric: "tabular-nums" }}>{formatCount(used)} / {formatCount(limit)} ({pct}%)</span>
                  </div>
                  <div style={{ height: 3, borderRadius: 2, background: "var(--surface2, #23232b)", overflow: "hidden" }}>
                    <div style={{ height: "100%", width: `${pct}%`, background: barColor(pct), transition: "width 200ms ease" }} />
                  </div>
                </div>
              );
            })}
        </div>
      )}
    </div>
  );
}

/** Distinct colours per context-breakdown category (Claude Code style: each segment a different
 *  hue). Free space stays a muted grey so the "used" segments read as the filled portion. */
const SEGMENT_COLORS: Record<string, string> = {
  conversation: "#5b52f0",
  overhead: "#f5a623",
  free: "var(--surface3, #34343e)",
};
</file>

<file path="apps/shell/src/components/CustomerBotAutomation.tsx">
"use client";

// Step 21: the customer-bot Automation dashboard — a no-code editor for the "after the customer
// says X, this happens" rules that run BEFORE the reasoning loop (cheap, deterministic, so a bot
// can answer an FAQ or hand off to a human without spending a model call). Shown only on a
// customer_bot project. Business ADMIN can add/remove; a member sees them read-only.

import * as React from "react";
import { Button, Card, Badge, FormInput, FormSelect, useToast, Toast } from "@naelao/ui";
import {
  getProjectRules,
  createProjectRule,
  deleteProjectRule,
  type ProjectRule,
  type SessionCredentials,
} from "@/lib/api";

const ACTION_LABEL: Record<ProjectRule["action"], string> = {
  reply: "Reply with a set message",
  run_script: "Run a skill",
  human_takeover: "Hand off to a human",
};
const ACTION_BADGE: Record<ProjectRule["action"], "green" | "blue" | "amber"> = {
  reply: "green",
  run_script: "blue",
  human_takeover: "amber",
};

export function CustomerBotAutomation({
  spaceId,
  projectId,
  creds,
}: {
  spaceId: string;
  projectId: string;
  creds: SessionCredentials;
}) {
  const { toast, show } = useToast();
  const [rules, setRules] = React.useState<ProjectRule[]>([]);
  const [loading, setLoading] = React.useState(true);
  const [failed, setFailed] = React.useState(false);

  const [adding, setAdding] = React.useState(false);
  const [trigger, setTrigger] = React.useState("");
  const [action, setAction] = React.useState<ProjectRule["action"]>("reply");
  const [replyText, setReplyText] = React.useState("");
  const [scriptName, setScriptName] = React.useState("");
  const [saving, setSaving] = React.useState(false);

  const refresh = React.useCallback(async () => {
    setLoading(true);
    try {
      setRules(await getProjectRules(spaceId, projectId, creds));
      setFailed(false);
    } catch {
      setFailed(true);
    } finally {
      setLoading(false);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [spaceId, projectId]);

  React.useEffect(() => {
    void refresh();
  }, [refresh]);

  async function handleAdd(e: React.FormEvent) {
    e.preventDefault();
    if (!trigger.trim()) return;
    if (action === "reply" && !replyText.trim()) {
      show("A reply message is required for this action.");
      return;
    }
    if (action === "run_script" && !scriptName.trim()) {
      show("A skill name is required for this action.");
      return;
    }
    setSaving(true);
    try {
      await createProjectRule(spaceId, projectId, creds, {
        trigger_pattern: trigger.trim(),
        action,
        ...(action === "reply" ? { reply_text: replyText.trim() } : {}),
        ...(action === "run_script" ? { script_name: scriptName.trim() } : {}),
      });
      setTrigger("");
      setReplyText("");
      setScriptName("");
      setAdding(false);
      show("Rule added.");
      await refresh();
    } catch (err) {
      // The most common real failure is 403 (not an admin) — surface it plainly rather than a
      // generic message, so a member understands they can look but not change.
      show(err instanceof Error ? err.message : "Couldn't add the rule.");
    } finally {
      setSaving(false);
    }
  }

  async function handleDelete(ruleId: string) {
    try {
      await deleteProjectRule(spaceId, projectId, ruleId, creds);
      await refresh();
    } catch (err) {
      show(err instanceof Error ? err.message : "Couldn't remove the rule.");
    }
  }

  return (
    <div style={{ marginTop: 24 }}>
      <div className="section-label" style={{ display: "flex", alignItems: "center", justifyContent: "space-between" }}>
        <span>Automation</span>
        {!adding && (
          <Button size="sm" variant="secondary" onClick={() => setAdding(true)}>
            Add rule
          </Button>
        )}
      </div>
      <p style={{ fontSize: 12, color: "var(--text3)", margin: "-4px 0 12px" }}>
        Run automatically when a customer message matches — before the AI ever spends a thought.
        Checked in priority order; the first match wins.
      </p>

      {adding && (
        <Card interactive={false} style={{ marginBottom: 12 }}>
          <form onSubmit={handleAdd} style={{ display: "flex", flexDirection: "column", gap: 10 }}>
            <div>
              <div className="settings-row-label" style={{ marginBottom: 4 }}>When the message contains</div>
              <FormInput placeholder="e.g. refund, hours, cancel" value={trigger} onChange={(e) => setTrigger(e.target.value)} required autoFocus />
            </div>
            <div>
              <div className="settings-row-label" style={{ marginBottom: 4 }}>Then</div>
              <FormSelect value={action} onChange={(e) => setAction(e.target.value as ProjectRule["action"])}>
                <option value="reply">Reply with a set message</option>
                <option value="run_script">Run a skill</option>
                <option value="human_takeover">Hand off to a human</option>
              </FormSelect>
            </div>
            {action === "reply" && (
              <div>
                <div className="settings-row-label" style={{ marginBottom: 4 }}>Reply message</div>
                <FormInput placeholder="What to send back" value={replyText} onChange={(e) => setReplyText(e.target.value)} />
              </div>
            )}
            {action === "run_script" && (
              <div>
                <div className="settings-row-label" style={{ marginBottom: 4 }}>Skill to run</div>
                <FormInput placeholder="e.g. refund-request" value={scriptName} onChange={(e) => setScriptName(e.target.value)} />
              </div>
            )}
            <div style={{ display: "flex", gap: 8 }}>
              <Button size="sm" type="submit" disabled={saving || !trigger.trim()}>
                {saving ? "Adding…" : "Add rule"}
              </Button>
              <Button size="sm" variant="secondary" type="button" onClick={() => setAdding(false)}>
                Cancel
              </Button>
            </div>
          </form>
        </Card>
      )}

      {loading ? (
        <p style={{ color: "var(--text3)", fontSize: 13 }}>Loading rules…</p>
      ) : failed ? (
        <div style={{ display: "flex", alignItems: "center", gap: 12, fontSize: 13 }}>
          <span style={{ color: "#dc2626" }} role="alert">Couldn&rsquo;t load automation rules.</span>
          <Button size="sm" variant="secondary" onClick={() => void refresh()}>Retry</Button>
        </div>
      ) : rules.length === 0 ? (
        <p style={{ color: "var(--text3)", fontSize: 13 }}>
          No rules yet. Add one so common messages get handled instantly, without a model call.
        </p>
      ) : (
        <div className="settings-block">
          {rules.map((r) => (
            <div key={r.id} className="settings-row">
              <div style={{ minWidth: 0 }}>
                <div className="settings-row-label" style={{ marginBottom: 2 }}>
                  &ldquo;{r.trigger_pattern}&rdquo;
                </div>
                <div className="settings-row-sub" style={{ display: "flex", alignItems: "center", gap: 8, flexWrap: "wrap" }}>
                  <Badge color={ACTION_BADGE[r.action]}>{ACTION_LABEL[r.action]}</Badge>
                  {r.action === "reply" && r.reply_text ? <span>→ {r.reply_text}</span> : null}
                  {r.action === "run_script" && r.script_name ? <span>→ {r.script_name}</span> : null}
                </div>
              </div>
              <Button size="sm" variant="secondary" onClick={() => void handleDelete(r.id)}>
                Remove
              </Button>
            </div>
          ))}
        </div>
      )}
      <Toast toast={toast} />
    </div>
  );
}
</file>

<file path="apps/shell/src/components/FileViewer.tsx">
"use client";

// Step 4: a multi-format file viewer for the Files panels — PDF, images, and Office documents
// (Word/Excel) in addition to the text/html/markdown/csv the panel already showed. Each Office
// format is a lazy-loaded "plugin": the parser (mammoth for .docx, sheetjs for .xlsx) is
// dynamically import()'d only when a file of that type is actually opened, so it stays out of the
// main bundle and off the edge worker. PDFs and images use the browser's own native rendering — no
// library at all. Anything we can't render is offered as a download rather than a broken preview.

import * as React from "react";
import { Markdown } from "@/components/Markdown";
import { HtmlPreviewFrame } from "@/components/HtmlPreviewFrame";
import type { WorkspaceFileContent } from "@/lib/api";

function base64ToBytes(b64: string): Uint8Array {
  const bin = atob(b64);
  const bytes = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
  return bytes;
}

function ext(path: string): string {
  return (path.split(".").pop() ?? "").toLowerCase();
}

/** Simple CSV → rows. Handles quoted fields and embedded commas/newlines — enough for a preview,
 *  not a spec-complete parser (that's what the .xlsx path's real library is for). */
function parseCsv(text: string): string[][] {
  const rows: string[][] = [];
  let row: string[] = [];
  let field = "";
  let inQuotes = false;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (inQuotes) {
      if (c === '"') {
        if (text[i + 1] === '"') { field += '"'; i++; } else inQuotes = false;
      } else field += c;
    } else if (c === '"') inQuotes = true;
    else if (c === ",") { row.push(field); field = ""; }
    else if (c === "\n") { row.push(field); rows.push(row); row = []; field = ""; }
    else if (c === "\r") { /* skip */ }
    else field += c;
  }
  if (field.length > 0 || row.length > 0) { row.push(field); rows.push(row); }
  return rows;
}

function TableView({ rows }: { rows: string[][] }) {
  if (rows.length === 0) return <p style={{ fontSize: 11.5, color: "var(--text3)" }}>Empty.</p>;
  const [head, ...body] = rows;
  return (
    <div style={{ maxHeight: 300, overflow: "auto", border: "1px solid var(--border)", borderRadius: 6 }}>
      <table style={{ borderCollapse: "collapse", fontSize: 11, width: "100%" }}>
        <thead>
          <tr>
            {head!.map((h, i) => (
              <th key={i} style={{ textAlign: "left", padding: "4px 8px", borderBottom: "1px solid var(--border)", background: "var(--surface2)", position: "sticky", top: 0, whiteSpace: "nowrap" }}>{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {body.slice(0, 500).map((r, ri) => (
            <tr key={ri}>
              {r.map((cell, ci) => (
                <td key={ci} style={{ padding: "3px 8px", borderBottom: "1px solid var(--border)", whiteSpace: "nowrap", maxWidth: 220, overflow: "hidden", textOverflow: "ellipsis" }}>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

/** DOCX → HTML via mammoth (lazy). */
function DocxView({ content }: { content: string }) {
  const [html, setHtml] = React.useState<string | null>(null);
  const [err, setErr] = React.useState(false);
  React.useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        const mammoth = await import("mammoth/mammoth.browser.js");
        const bytes = base64ToBytes(content);
        const buf = bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength) as ArrayBuffer;
        const result = await mammoth.convertToHtml({ arrayBuffer: buf });
        if (!cancelled) setHtml(result.value);
      } catch {
        if (!cancelled) setErr(true);
      }
    })();
    return () => { cancelled = true; };
  }, [content]);
  if (err) return <p style={{ fontSize: 11.5, color: "var(--text3)" }}>Couldn&rsquo;t render this document — download it to view.</p>;
  if (html === null) return <p style={{ fontSize: 11.5, color: "var(--text3)" }}>Opening document…</p>;
  return (
    <div
      style={{ maxHeight: 320, overflow: "auto", fontSize: 12, lineHeight: 1.55, padding: "4px 2px" }}
      // mammoth output is sanitized HTML from the doc's own text; rendered read-only in the panel.
      dangerouslySetInnerHTML={{ __html: html }}
    />
  );
}

/** XLSX → first sheet as a table via sheetjs (lazy). */
function XlsxView({ content }: { content: string }) {
  const [rows, setRows] = React.useState<string[][] | null>(null);
  const [err, setErr] = React.useState(false);
  React.useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        const XLSX = await import("xlsx");
        const wb = XLSX.read(base64ToBytes(content), { type: "array" });
        const first = wb.SheetNames[0];
        const sheet = first ? wb.Sheets[first] : undefined;
        const aoa = sheet ? (XLSX.utils.sheet_to_json(sheet, { header: 1, blankrows: false }) as unknown[][]) : [];
        if (!cancelled) setRows(aoa.map((r) => r.map((c) => (c == null ? "" : String(c)))));
      } catch {
        if (!cancelled) setErr(true);
      }
    })();
    return () => { cancelled = true; };
  }, [content]);
  if (err) return <p style={{ fontSize: 11.5, color: "var(--text3)" }}>Couldn&rsquo;t render this spreadsheet — download it to view.</p>;
  if (rows === null) return <p style={{ fontSize: 11.5, color: "var(--text3)" }}>Opening spreadsheet…</p>;
  return <TableView rows={rows} />;
}

/** PDF via a blob URL in an iframe — the browser's own native PDF viewer, no library. */
function PdfView({ content }: { content: string }) {
  const [url, setUrl] = React.useState<string | null>(null);
  React.useEffect(() => {
    const blob = new Blob([base64ToBytes(content) as unknown as BlobPart], { type: "application/pdf" });
    const u = URL.createObjectURL(blob);
    setUrl(u);
    return () => URL.revokeObjectURL(u);
  }, [content]);
  if (!url) return null;
  return <iframe title="PDF" src={url} style={{ width: "100%", height: 340, border: "1px solid var(--border)", borderRadius: 6, background: "#fff" }} />;
}

export function FileViewer({
  file,
  interactive = false,
}: {
  file: WorkspaceFileContent;
  /** AVOS plan step 6 — turns on click-to-inspect for an HTML preview (see HtmlPreviewFrame's own
   *  header for why this is opt-in: only a caller that knows a Chat.tsx listener is mounted
   *  nearby should turn it on). */
  interactive?: boolean;
}) {
  if (file.too_large) {
    return <p style={{ color: "var(--text3)", fontSize: 11.5, margin: 0 }}>Too large to preview inline.</p>;
  }

  // Binary (base64) types. No hooks here — each sub-view owns its own so the rules of hooks hold
  // regardless of which branch renders.
  if (file.encoding === "base64" && file.content) {
    const ct = file.content_type ?? "";
    const dataUrl = `data:${ct};base64,${file.content}`;
    if (ct === "application/pdf") return <PdfView content={file.content} />;
    if (ct.startsWith("image/")) {
      return <img src={dataUrl} alt={file.path} style={{ maxWidth: "100%", maxHeight: 340, borderRadius: 6, display: "block" }} />;
    }
    if (ct.includes("wordprocessingml")) return <DocxView content={file.content} />;
    if (ct.includes("spreadsheetml")) return <XlsxView content={file.content} />;
    // A known-binary type we can't render inline (e.g. .pptx) — offer the raw bytes to save.
    return (
      <div style={{ fontSize: 11.5, color: "var(--text3)" }}>
        <p style={{ margin: "0 0 6px" }}>Preview isn&rsquo;t available for this file type.</p>
        <a href={dataUrl} download={file.path.split("/").pop()} style={{ color: "var(--accent)" }}>Download to view</a>
      </div>
    );
  }

  // Text types.
  const e = ext(file.path);
  const text = file.content ?? "";
  if (e === "html" || e === "htm") {
    return <HtmlPreviewFrame html={text} title={file.path} interactive={interactive} />;
  }
  if (e === "md" || e === "markdown") {
    return <div style={{ maxHeight: 300, overflow: "auto", fontSize: 12 }}><Markdown text={text} /></div>;
  }
  if (e === "csv" || e === "tsv") {
    return <TableView rows={parseCsv(e === "tsv" ? text.replace(/\t/g, ",") : text)} />;
  }
  return <pre style={{ whiteSpace: "pre-wrap", fontSize: 11, maxHeight: 300, overflow: "auto", margin: 0 }}>{text}</pre>;
}
</file>

<file path="apps/shell/src/components/HtmlPreviewFrame.tsx">
"use client";

// AVOS plan step 6 — a single, hardened HTML preview surface shared by every place this shell
// shows agent-generated/uploaded HTML (the Files panels, the Artifacts panel, and an artifact
// rendered inline in the chat transcript). Consolidates three previously-independent iframe
// implementations that had DRIFTED to three different sandbox postures — including
// InlineArtifactCard's `allow-scripts allow-same-origin`, a real, latent risk: a `srcDoc` iframe
// sandboxed with BOTH flags together is treated by the browser as sharing the PARENT document's
// origin, so a script embedded in agent-generated HTML (e.g. from a prompt-injected inbound
// message summarized into a report) could reach `window.parent` directly rather than being
// confined to postMessage. Every caller now gets the same, safe combination instead:
// `sandbox="allow-scripts"` alone — scripts run, but the iframe resolves to a NULL/opaque origin
// with no access to the parent's DOM/cookies/storage; the only channel out is postMessage, which
// is also exactly the mechanism the click-to-inspect feature below uses.
//
// `interactive` (default false) gates whether the click-to-inspect script is injected at all — it
// is only turned on by callers that know a listener actually exists (Chat.tsx's own `window`
// "message" handler, mounted for the lifetime of a conversation). Without it, this renders a
// genuinely read-only preview with no injected script, rather than an affordance that would
// silently do nothing on a page with no chat nearby (e.g. the project overview page's own Files
// list, which has no composer to pin a selection into).
//
// This deliberately does NOT attempt real source-file/line mapping ("Header.astro:42") — that
// needs a compiler emitting source maps into the DOM, and nothing on this platform does that;
// agent-generated HTML here is a flat file/artifact, not a tracked multi-file source project.
// What IS real and honest: a CSS-selector-shaped description (tag, id/class, position among
// siblings) plus a short text excerpt — exactly as much as a person clicking the same element
// could describe in words, not a fabricated precision the platform can't actually back up.

import * as React from "react";

const INSPECTOR_SCRIPT = `
<script>
(function () {
  var hovered = null;
  function describe(el) {
    if (!el || el === document.body || el === document.documentElement) return null;
    var tag = el.tagName ? el.tagName.toLowerCase() : "el";
    var id = el.id ? "#" + el.id : "";
    var cls = el.className && typeof el.className === "string"
      ? "." + el.className.trim().split(/\\s+/).filter(Boolean).slice(0, 2).join(".")
      : "";
    var text = (el.textContent || "").trim().replace(/\\s+/g, " ").slice(0, 80);
    var idx = el.parentElement ? Array.prototype.indexOf.call(el.parentElement.children, el) : 0;
    var selector = tag + id + cls + (id ? "" : ":nth-child(" + (idx + 1) + ")");
    return { tag: tag, selector: selector, text: text };
  }
  document.addEventListener("mouseover", function (e) {
    if (hovered && hovered.style) hovered.style.outline = "";
    hovered = e.target;
    if (hovered && hovered.style && hovered !== document.body && hovered !== document.documentElement) {
      hovered.style.outline = "2px solid #6d5ef8";
      hovered.style.outlineOffset = "-1px";
    }
  }, true);
  document.addEventListener("click", function (e) {
    var d = describe(e.target);
    if (!d) return;
    e.preventDefault();
    e.stopPropagation();
    try {
      window.parent.postMessage({ type: "AVOS_DOM_CLICK", selector: d.selector, tag: d.tag, text: d.text }, "*");
    } catch (err) { /* postMessage never throws in practice; ignore defensively */ }
  }, true);
})();
</script>`;

export interface InspectedElement {
  selector: string;
  tag: string;
  text: string;
}

export function HtmlPreviewFrame({
  html,
  title,
  height = 260,
  interactive = false,
}: {
  html: string;
  title?: string;
  height?: number;
  /** Injects the click-to-inspect script — only pass true when a Chat.tsx "message" listener is
   *  actually mounted somewhere on this page (see the header comment above). */
  interactive?: boolean;
}) {
  const srcDoc = interactive ? html + INSPECTOR_SCRIPT : html;
  return (
    <iframe
      title={title ?? "Preview"}
      sandbox="allow-scripts"
      srcDoc={srcDoc}
      style={{ width: "100%", height, border: "1px solid var(--border)", borderRadius: 6, background: "#fff" }}
    />
  );
}
</file>

<file path="apps/shell/src/components/InlineApprovalCard.tsx">
"use client";

// An in-chat approval card — rendered at the exact turn a run stopped at a gate, instead of only
// in the separate /approvals inbox. Approving/declining here calls the SAME endpoints that page
// uses; the agent resumes automatically once answered (server-side, via the HITL resume path) —
// this card just reports the decision and lets the person move on, rather than making them find
// the same request again in a different page.

import * as React from "react";
import { approveAction, rejectAction, getAssistantPolicy, updateAssistantPolicy, type RunPendingApproval } from "@/lib/api";
import type { SessionCredentials } from "@/lib/api";

export function InlineApprovalCard({
  spaceId,
  approval,
  session,
  onResolved,
}: {
  spaceId: string;
  approval: RunPendingApproval;
  session: SessionCredentials;
  /** Called once approved/declined — the caller can refresh messages a moment later to pick up
   *  whatever the resumed run eventually says. */
  onResolved?: (decision: "approved" | "declined") => void;
}) {
  const [busy, setBusy] = React.useState(false);
  const [resolved, setResolved] = React.useState<"approved" | "declined" | null>(null);
  const [declining, setDeclining] = React.useState(false);
  const [reason, setReason] = React.useState("");
  // Whether this exact action ended up on the space's own auto-approved allowlist — only known
  // once an "always allow" attempt actually succeeds, so this stays unset (not silently claimed)
  // when the caller isn't a business admin (PATCH is admin-gated; approving itself is not).
  const [alwaysAllowed, setAlwaysAllowed] = React.useState(false);
  const [alwaysAllowFailed, setAlwaysAllowFailed] = React.useState(false);

  async function handleApprove(alwaysAllow: boolean) {
    setBusy(true);
    try {
      await approveAction(spaceId, approval.approval_id, session);
      setResolved("approved");
      onResolved?.("approved");
      // "Approve and don't ask again" — self-serve fix for a business whose stored policy
      // predates a default auto-approved action (e.g. web search) being added, or for any action
      // a person has simply decided is fine going forward. Read-then-write against the real
      // stored list rather than assuming it's empty, since PATCH replaces the whole array.
      if (alwaysAllow) {
        try {
          const policy = await getAssistantPolicy(spaceId, session);
          if (!policy.auto_approved_actions.includes(approval.action_name)) {
            await updateAssistantPolicy(spaceId, session, {
              auto_approved_actions: [...policy.auto_approved_actions, approval.action_name],
            });
          }
          setAlwaysAllowed(true);
        } catch {
          // Most likely: this person isn't a business admin. The approval itself already
          // succeeded — just say so rather than failing the whole action silently.
          setAlwaysAllowFailed(true);
        }
      }
    } catch {
      /* the card stays actionable — the approvals inbox is the fallback if this keeps failing */
    } finally {
      setBusy(false);
    }
  }

  async function handleDecline() {
    setBusy(true);
    try {
      await rejectAction(spaceId, approval.approval_id, reason.trim() || "Declined from chat", session);
      setResolved("declined");
      onResolved?.("declined");
    } catch {
      /* same fallback as approve */
    } finally {
      setBusy(false);
    }
  }

  const paramEntries = Object.entries(approval.params ?? {});

  return (
    <div
      style={{
        marginTop: 6, maxWidth: 440, border: "1px solid var(--border)", borderRadius: "var(--radius-sm)",
        background: "var(--surface2)", padding: 12,
      }}
    >
      <div style={{ display: "flex", alignItems: "center", gap: 6, marginBottom: 6 }}>
        <span aria-hidden style={{ fontSize: 13 }}>🔒</span>
        <span style={{ fontSize: 12.5, fontWeight: 600, color: "var(--text)" }}>Waiting for your approval</span>
      </div>
      <div style={{ fontSize: 12.5, color: "var(--text2)", marginBottom: paramEntries.length ? 6 : 10 }}>
        The agent wants to run <code style={{ fontSize: 12 }}>{approval.action_name}</code>
      </div>
      {paramEntries.length > 0 && (
        <div
          style={{
            fontSize: 11.5, color: "var(--text3)", background: "var(--surface)", borderRadius: 8,
            padding: 8, marginBottom: 10, fontFamily: "monospace", whiteSpace: "pre-wrap", wordBreak: "break-word",
          }}
        >
          {paramEntries.map(([k, v]) => `${k}: ${typeof v === "string" ? v : JSON.stringify(v)}`).join("\n")}
        </div>
      )}

      {resolved ? (
        <div>
          <div style={{ fontSize: 12.5, color: resolved === "approved" ? "var(--accent)" : "var(--text3)", fontWeight: 600 }}>
            {resolved === "approved" ? "Approved — the agent will continue." : "Declined."}
          </div>
          {alwaysAllowed && (
            <div style={{ fontSize: 11.5, color: "var(--text3)", marginTop: 4 }}>
              Won&apos;t ask for <code style={{ fontSize: 11 }}>{approval.action_name}</code> again.
            </div>
          )}
          {alwaysAllowFailed && (
            <div style={{ fontSize: 11.5, color: "var(--text3)", marginTop: 4 }}>
              Approved, but couldn&apos;t update the always-allow list (needs a business admin).
            </div>
          )}
        </div>
      ) : declining ? (
        <div style={{ display: "flex", gap: 8, flexWrap: "wrap", alignItems: "flex-end" }}>
          <input
            className="form-input"
            placeholder="Reason (optional)"
            value={reason}
            onChange={(e) => setReason(e.target.value)}
            style={{ flex: 1, minWidth: 160, fontSize: 12.5 }}
          />
          <button type="button" className="btn btn-sm" style={{ background: "#dc2626", color: "#fff", border: "none" }} onClick={handleDecline} disabled={busy}>
            {busy ? "…" : "Confirm decline"}
          </button>
          <button type="button" className="btn btn-ghost btn-sm" onClick={() => setDeclining(false)} disabled={busy}>
            Cancel
          </button>
        </div>
      ) : (
        <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
          <button type="button" className="btn btn-primary btn-sm" onClick={() => void handleApprove(false)} disabled={busy}>
            {busy ? "…" : "Approve"}
          </button>
          <button
            type="button"
            className="btn btn-ghost btn-sm"
            onClick={() => void handleApprove(true)}
            disabled={busy}
            title="Approve this, and auto-approve this exact action from now on"
          >
            {busy ? "…" : "Always allow"}
          </button>
          <button type="button" className="btn btn-ghost btn-sm" onClick={() => setDeclining(true)} disabled={busy}>
            Decline
          </button>
        </div>
      )}
    </div>
  );
}
</file>

<file path="apps/shell/src/components/InlineArtifactCard.tsx">
"use client";

// Step 5/7/11: an inline preview of an artifact the assistant CREATED this turn — like Claude
// showing an artifact in the chat. HTML renders in a sandboxed iframe; other text renders in a
// scrollable <pre>; everything is downloadable. Rendered directly under the assistant reply (not
// buried in the side-panel Artifacts tab), and — for artifacts.create — this is what shows on
// SUCCESS instead of the tool-call table (step 11).

import * as React from "react";
import { getArtifact, type ArtifactContent, type SessionCredentials } from "@/lib/api";
import { HtmlPreviewFrame } from "@/components/HtmlPreviewFrame";

function isHtml(a: { content_type?: string | undefined; filename: string }): boolean {
  return (a.content_type ?? "").includes("html") || /\.html?$/i.test(a.filename);
}

export function InlineArtifactCard({
  spaceId,
  artifactId,
  filename,
  contentType,
  session,
}: {
  spaceId: string;
  artifactId: string;
  filename: string;
  contentType?: string;
  session: SessionCredentials;
}) {
  const [detail, setDetail] = React.useState<ArtifactContent | null>(null);
  const [failed, setFailed] = React.useState(false);
  const [expanded, setExpanded] = React.useState(true);

  React.useEffect(() => {
    let cancelled = false;
    getArtifact(spaceId, artifactId, session)
      .then((d) => { if (!cancelled) setDetail(d); })
      .catch(() => { if (!cancelled) setFailed(true); });
    return () => { cancelled = true; };
  }, [spaceId, artifactId, session]);

  const html = detail ? isHtml({ content_type: detail.content_type, filename: detail.filename }) : isHtml({ content_type: contentType, filename });

  function download() {
    if (!detail?.content) return;
    const blob = new Blob([detail.content], { type: detail.content_type || "text/plain" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  return (
    <div
      className="inline-artifact-card"
      style={{ border: "1px solid var(--border)", borderRadius: 10, overflow: "hidden", marginTop: 8, background: "var(--surface1, var(--bg))" }}
    >
      <div style={{ display: "flex", alignItems: "center", gap: 8, padding: "8px 12px", background: "var(--surface2, #f9f8f5)", borderBottom: expanded ? "1px solid var(--border)" : "none" }}>
        <span style={{ fontSize: 14 }}>📄</span>
        <span style={{ flex: 1, fontSize: 13, fontWeight: 600, color: "var(--text1)", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{filename}</span>
        <button type="button" className="btn btn-ghost btn-sm" style={{ fontSize: 11.5 }} onClick={() => setExpanded((v) => !v)}>
          {expanded ? "Hide" : "Preview"}
        </button>
        <button type="button" className="btn btn-ghost btn-sm" style={{ fontSize: 11.5 }} disabled={!detail?.content} onClick={download}>
          Download
        </button>
      </div>
      {expanded && (
        <div>
          {failed ? (
            <div style={{ padding: 16, fontSize: 12.5, color: "var(--text3)" }}>Couldn&apos;t load this artifact.</div>
          ) : !detail ? (
            <div style={{ padding: 16, fontSize: 12.5, color: "var(--text3)" }}>Loading preview…</div>
          ) : detail.too_large || detail.binary || !detail.content ? (
            <div style={{ padding: 16, fontSize: 12.5, color: "var(--text3)" }}>
              {detail.binary ? "Binary file — download to open it." : "This file is too large to preview inline — download it to view."}
            </div>
          ) : html ? (
            // AVOS plan step 6 — this used to be `sandbox="allow-scripts allow-same-origin"`, a
            // real latent risk: a srcDoc iframe sandboxed with BOTH flags is treated as sharing
            // the PARENT document's origin, so an agent-generated page could reach window.parent
            // directly instead of being confined to postMessage. HtmlPreviewFrame's own
            // `allow-scripts`-only posture fixes that while ALSO being what makes click-to-inspect
            // possible — always on here since this only ever renders inside the chat transcript,
            // where Chat.tsx's own "message" listener is guaranteed to be mounted.
            <HtmlPreviewFrame html={detail.content} title={filename} height={360} interactive />
          ) : (
            <pre style={{ margin: 0, padding: 12, maxHeight: 360, overflow: "auto", fontSize: 12, whiteSpace: "pre-wrap", wordBreak: "break-word", color: "var(--text1)" }}>
              {detail.content}
            </pre>
          )}
        </div>
      )}
    </div>
  );
}
</file>

<file path="apps/shell/src/components/InlineConnectorCard.tsx">
"use client";

// Rendered under an assistant reply that tried to use a catalogued-but-not-yet-connected app
// (script-engine's tool-surface.ts sets needs_connector/connector_id/connector_name — see
// NaelaoAgentDO's writeAgentAnswerToSession call site). Lets the person connect it right there
// instead of having to go find the Connectors page themselves.

import * as React from "react";
import { getConnectorStatus, type ConnectorInfo } from "@/lib/api";
import type { SessionCredentials } from "@/lib/api";
import { startConnectorConnect, submitManualConnectorKey } from "@/lib/connectorActions";

export function InlineConnectorCard({
  spaceId,
  connectorId,
  connectorName,
  session,
}: {
  spaceId: string;
  connectorId: string;
  connectorName: string;
  session: SessionCredentials;
}) {
  const [connector, setConnector] = React.useState<ConnectorInfo | null>(null);
  const [connected, setConnected] = React.useState(false);
  const [busy, setBusy] = React.useState(false);
  const [manualKeyOpen, setManualKeyOpen] = React.useState(false);
  const [manualKeyValue, setManualKeyValue] = React.useState("");

  React.useEffect(() => {
    let cancelled = false;
    getConnectorStatus(spaceId, session)
      .then((list) => {
        if (cancelled) return;
        const found = list.find((c) => c.id === connectorId) ?? null;
        setConnector(found);
        setConnected(!!found?.connected);
      })
      .catch(() => {});
    return () => { cancelled = true; };
  }, [spaceId, connectorId, session]);

  async function handleConnect() {
    if (!connector) return;
    setBusy(true);
    try {
      const { needsManualKey } = await startConnectorConnect(spaceId, session, connector, window.location.href);
      if (needsManualKey) {
        setManualKeyOpen(true);
        setBusy(false);
      }
    } catch {
      setBusy(false);
    }
  }

  async function handleManualSubmit() {
    if (!manualKeyValue.trim()) return;
    setBusy(true);
    try {
      await submitManualConnectorKey(spaceId, session, connectorId, manualKeyValue.trim());
      setConnected(true);
      setManualKeyOpen(false);
      setManualKeyValue("");
    } catch {
      /* stays actionable */
    } finally {
      setBusy(false);
    }
  }

  if (connected) return null; // already connected between load and now — nothing to show

  return (
    <div
      style={{
        marginTop: 6, maxWidth: 400, border: "1px solid var(--border)", borderRadius: "var(--radius-sm)",
        background: "var(--surface2)", padding: 12, display: "flex", alignItems: "center", gap: 10,
      }}
    >
      <span aria-hidden style={{ fontSize: 16 }}>🔌</span>
      <div style={{ flex: 1, minWidth: 0 }}>
        <div style={{ fontSize: 12.5, fontWeight: 600, color: "var(--text)" }}>Connect {connectorName}</div>
        <div style={{ fontSize: 11.5, color: "var(--text3)" }}>Needed to do what was just asked.</div>
      </div>
      {!manualKeyOpen ? (
        <button type="button" className="btn btn-primary btn-sm" onClick={handleConnect} disabled={busy || !connector}>
          {busy ? "…" : "Connect"}
        </button>
      ) : (
        <div style={{ display: "flex", gap: 6 }}>
          <input
            className="form-input"
            type="password"
            placeholder="API key"
            value={manualKeyValue}
            onChange={(e) => setManualKeyValue(e.target.value)}
            style={{ width: 140, fontSize: 12 }}
          />
          <button type="button" className="btn btn-primary btn-sm" onClick={handleManualSubmit} disabled={busy || !manualKeyValue.trim()}>
            {busy ? "…" : "Save"}
          </button>
        </div>
      )}
    </div>
  );
}
</file>

<file path="apps/shell/src/components/InterruptedRunCard.tsx">
"use client";

/**
 * The standing offer to continue a run that went wrong.
 *
 * Deliberately NOT a toast and not component state: it is read from the server on every mount, so
 * it is still there after a refresh, a closed tab, or coming back tomorrow. It disappears only
 * when someone actually answers it.
 *
 * "Continue" is the important word. It re-enters the same run — actions that already executed are
 * replayed from the ledger rather than run again — whereas a plain "try again" starts from
 * nothing and repeats every side effect. That distinction is why a failed run once created a
 * second project when the user pressed Try again.
 */

import * as React from "react";
import type { InterruptedRun, SessionCredentials } from "@/lib/api";
import { resolveInterruptedRun } from "@/lib/api";

export function InterruptedRunCard({
  interrupted,
  spaceId,
  sessionId,
  session,
  onContinued,
  onDismissed,
}: {
  interrupted: InterruptedRun;
  spaceId: string;
  sessionId: string;
  session: SessionCredentials;
  /** Handed the continuation's run id so the caller can attach its live activity + answer. */
  onContinued: (runId: string) => void;
  onDismissed: () => void;
}) {
  const [busy, setBusy] = React.useState<"continue" | "dismiss" | null>(null);
  const [error, setError] = React.useState<string | null>(null);

  async function resolve(action: "continue" | "dismiss") {
    setBusy(action);
    setError(null);
    try {
      const res = await resolveInterruptedRun(spaceId, sessionId, interrupted.run_id, action, session);
      if (action === "dismiss") {
        onDismissed();
        return;
      }
      // A continue that the server declined to start (already handled elsewhere, say) must not
      // leave the card silently gone with nothing running in its place.
      if (res.run_id) onContinued(res.run_id);
      else onDismissed();
    } catch (err) {
      setError(err instanceof Error ? err.message : "Could not do that just now.");
      setBusy(null);
    }
  }

  const done = interrupted.steps_completed;

  return (
    <div className="interrupted-card">
      <div className="interrupted-head">
        <span className="interrupted-dot" aria-hidden />
        <span className="interrupted-title">
          {interrupted.failure_kind === "user_cancelled" ? "Stopped" : "This didn't finish"}
        </span>
      </div>
      <p className="interrupted-reason">{interrupted.reason}</p>
      {/* What the error actually means, in words. A raw provider string ("4006") leaves the person
          with no way to judge whether continuing now is even worth trying. */}
      {interrupted.explanation && (
        <p className="interrupted-explain">{interrupted.explanation}</p>
      )}
      <p className="interrupted-note">
        {done > 0
          ? `${done} step${done === 1 ? "" : "s"} already completed. Continuing picks up from there — it won't redo them.`
          : "Nothing had run yet, so continuing starts this cleanly."}
      </p>
      {error && <p className="interrupted-error">{error}</p>}
      <div className="interrupted-actions">
        <button
          type="button"
          className="btn-primary"
          onClick={() => void resolve("continue")}
          disabled={busy !== null}
        >
          {busy === "continue"
            ? "Continuing…"
            : interrupted.clears_on_its_own
              ? "Try again now"
              : "Continue"}
        </button>
        <button
          type="button"
          className="btn-ghost"
          onClick={() => void resolve("dismiss")}
          disabled={busy !== null}
        >
          {busy === "dismiss" ? "Dismissing…" : "Dismiss"}
        </button>
      </div>
    </div>
  );
}
</file>

<file path="apps/shell/src/components/Markdown.tsx">
"use client";

import * as React from "react";
import ReactMarkdown from "react-markdown";
import remarkGfm from "remark-gfm";

/**
 * Chat text rendered as markdown.
 *
 * Until now every bubble rendered its content as a raw React text child, so an assistant reply
 * arrived with its `**bold**`, `- bullets` and ``` fences intact as literal characters — while
 * `packages/ui/src/styles.css` had been carrying finished styles for `.bubble p/ul/strong/em/
 * pre/code` the whole time with nothing ever emitting those elements.
 *
 * `react-markdown` rather than `marked`/`showdown` for one reason that matters here: it builds
 * React elements and never touches `dangerouslySetInnerHTML`. An agent in this product renders
 * web-fetched pages, customer emails and connector output into these bubbles — content this
 * platform explicitly treats as untrusted everywhere else — so a renderer that cannot inject HTML
 * at all is worth more than the bundle it costs. For the same reason `rehype-raw` is deliberately
 * NOT installed: inline HTML in markdown stays inert text.
 *
 * Links open in a new tab with `noopener noreferrer` — a chat reply is the one place in this app
 * where the href is routinely chosen by a model rather than by us.
 */

const COMPONENTS = {
  a: ({
    href,
    children,
  }: { href?: string | undefined; children?: React.ReactNode }) => {
    // Citation URLs are immutable stream markers, not navigable bucket URLs. Chat mounts the
    // authenticated CitationBadges resolver; Markdown only renders an inert escaped marker.
    if (href?.startsWith("citation:"))
      return <span className="citation-marker">{children}</span>;
    return (
      <a href={href} target="_blank" rel="noopener noreferrer">
        {children}
      </a>
    );
  },
} as const;

function MarkdownImpl({ text }: { text: string }): React.ReactElement {
  return (
    <ReactMarkdown remarkPlugins={[remarkGfm]} components={COMPONENTS as never}>
      {text}
    </ReactMarkdown>
  );
}

/**
 * Memoised on the exact text. This renders on every tick of a reveal animation and on every poll
 * of a growing answer, and re-parsing an unchanged string each time is pure waste.
 */
export const Markdown = React.memo(MarkdownImpl, (a, b) => a.text === b.text);
</file>

<file path="apps/shell/src/components/MessageActions.tsx">
"use client";

import * as React from "react";

/**
 * The hover/tap action row under a chat message — copy on every message, edit on the last one the
 * user sent.
 *
 * `packages/ui/src/styles.css` has carried `.msg-actions`, `.msg-action`, `.msg-action .tooltip`
 * and `.msg-row:hover .msg-actions{opacity:1}` for a long time with no component ever emitting
 * them; the only affordance that existed was a text "Edit" button, always visible, on one message.
 * This wires the existing styles up rather than inventing a second set.
 *
 * Touch: `:hover` never fires on a tap, so the row would be permanently invisible on a phone.
 * Rather than making it always-visible there (which is what the plain `@media (hover:none)` escape
 * hatch does, and which puts two buttons under every message in a long thread), tapping the row
 * reveals it — matching how the user described Claude Code behaving.
 */

function CopyIcon(): React.ReactElement {
  return (
    <svg viewBox="0 0 24 24" fill="none" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
      <rect x="9" y="9" width="13" height="13" rx="2" />
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
    </svg>
  );
}

function CheckIcon(): React.ReactElement {
  return (
    <svg viewBox="0 0 24 24" fill="none" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
      <path d="M20 6 9 17l-5-5" />
    </svg>
  );
}

function EditIcon(): React.ReactElement {
  return (
    <svg viewBox="0 0 24 24" fill="none" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
      <path d="M12 20h9" />
      <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
    </svg>
  );
}

export function MessageActions({
  content,
  onEdit,
  align = "left",
}: {
  content: string;
  /** Omitted for every message except the last one the user sent. */
  onEdit?: (() => void) | undefined;
  align?: "left" | "right";
}): React.ReactElement {
  const [copied, setCopied] = React.useState(false);

  const copy = React.useCallback(() => {
    // `navigator.clipboard` needs a secure context and can be refused outright; the textarea
    // fallback is what keeps this working on an http origin or a locked-down browser rather than
    // failing silently and looking like a broken button.
    const done = () => {
      setCopied(true);
      window.setTimeout(() => setCopied(false), 1400);
    };
    if (navigator.clipboard?.writeText) {
      navigator.clipboard.writeText(content).then(done).catch(() => fallbackCopy(content, done));
    } else {
      fallbackCopy(content, done);
    }
  }, [content]);

  return (
    <div className="msg-actions" style={align === "right" ? { justifyContent: "flex-end" } : undefined}>
      <button type="button" className="msg-action" onClick={copy} aria-label={copied ? "Copied" : "Copy message"}>
        {copied ? <CheckIcon /> : <CopyIcon />}
        <span className="tooltip">{copied ? "Copied" : "Copy"}</span>
      </button>
      {onEdit && (
        <button type="button" className="msg-action" onClick={onEdit} aria-label="Edit and ask again">
          <EditIcon />
          <span className="tooltip">Edit</span>
        </button>
      )}
    </div>
  );
}

function fallbackCopy(text: string, done: () => void): void {
  try {
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.setAttribute("readonly", "");
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    document.execCommand("copy");
    document.body.removeChild(ta);
    done();
  } catch {
    // Nothing sensible left to try. Staying silent beats a scary error for a copy button.
  }
}
</file>

<file path="apps/shell/src/components/ModelSelector.tsx">
"use client";

// A Claude-Code-style model + capability config picker for the chat input bar: pick a model, and
// — only for the models that actually support it (billing-core's MODEL_CAPABILITIES, researched
// per-model against Cloudflare's own Workers AI docs; see that file's header for what's confirmed
// vs. inferred) — a reasoning-effort/thinking control. A model with no configurable reasoning mode
// (most of them, including the account's actual working default, Llama 3.3) simply shows no such
// control, rather than a dead/disabled one.

import * as React from "react";
import { ALLOWED_MODELS, capabilityForModel } from "@naelao/billing-core";

const MODEL_LABELS: Record<string, string> = {
  "claude-haiku-4-5-20251001": "Claude Haiku 4.5",
  "claude-sonnet-4-6": "Claude Sonnet 4.6",
  "claude-opus-4-8": "Claude Opus 4.8",
  "@cf/meta/llama-3.3-70b-instruct-fp8-fast": "Llama 3.3 70B",
  "@cf/meta/llama-4-scout-17b-16e-instruct": "Llama 4 Scout",
  "@cf/openai/gpt-oss-120b": "GPT-OSS 120B",
  "@cf/openai/gpt-oss-20b": "GPT-OSS 20B",
  "@cf/qwen/qwen3-30b-a3b-fp8": "Qwen3 30B",
  "@cf/mistralai/mistral-small-3.1-24b-instruct": "Mistral Small 3.1",
  "@cf/ibm-granite/granite-4.0-h-micro": "Granite 4.0 Micro",
  "@cf/google/gemma-4-26b-a4b-it": "Gemma 4 26B",
  "@cf/zai-org/glm-4.7-flash": "GLM 4.7 Flash",
  "@cf/zai-org/glm-5.2": "GLM 5.2",
  "@cf/nvidia/nemotron-3-120b-a12b": "Nemotron 3 120B",
  "@cf/moonshotai/kimi-k2.6": "Kimi K2.6",
  "@cf/moonshotai/kimi-k2.7-code": "Kimi K2.7 Code",
  "google-ai-studio/gemini-flash-lite-latest": "Gemini Flash-Lite",
  "google-ai-studio/gemini-flash-latest": "Gemini Flash",
  "google-ai-studio/gemini-pro-latest": "Gemini Pro",
};

export function modelLabel(model: string): string {
  return MODEL_LABELS[model] ?? model;
}

const LEVEL_LABELS: Record<string, string> = {
  off: "Off", on: "On", low: "Low", medium: "Medium", high: "High", max: "Max",
};

export function ModelSelector({
  model,
  reasoningLevel,
  onChange,
}: {
  model: string;
  reasoningLevel: string | null;
  /** Called whenever either the model or the reasoning level changes. Switching model always
   *  re-picks a level (the first one the new model offers, or null when it offers none) — a level
   *  chosen for the PREVIOUS model may not even be valid for the new one. */
  onChange: (model: string, reasoningLevel: string | null) => void;
}) {
  const [open, setOpen] = React.useState(false);
  const rootRef = React.useRef<HTMLDivElement>(null);
  const capability = capabilityForModel(model);

  React.useEffect(() => {
    if (!open) return;
    function onDocClick(e: MouseEvent) {
      if (rootRef.current && !rootRef.current.contains(e.target as Node)) setOpen(false);
    }
    document.addEventListener("mousedown", onDocClick);
    return () => document.removeEventListener("mousedown", onDocClick);
  }, [open]);

  return (
    <div ref={rootRef} style={{ position: "relative" }}>
      <button
        type="button"
        onClick={() => setOpen((v) => !v)}
        title="Model and reasoning effort"
        style={{
          display: "inline-flex", alignItems: "center", gap: 6, height: 28, padding: "0 10px",
          borderRadius: 999, border: "1px solid var(--border)", background: "transparent",
          color: "var(--text2)", fontSize: 12.5, fontWeight: 500, cursor: "pointer",
        }}
      >
        <span>{modelLabel(model)}</span>
        {capability.reasoningLevels.length > 0 && reasoningLevel && (
          <span
            style={{
              fontSize: 10.5, color: "var(--accent)", background: "var(--accent-dim)",
              borderRadius: 6, padding: "1px 6px", fontWeight: 600,
            }}
          >
            {LEVEL_LABELS[reasoningLevel] ?? reasoningLevel}
          </span>
        )}
        <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" strokeWidth={1.5}>
          <path d="M3 4.5L6 7.5L9 4.5" strokeLinecap="round" strokeLinejoin="round" />
        </svg>
      </button>

      {open && (
        <div
          role="menu"
          style={{
            position: "absolute", bottom: "calc(100% + 6px)", left: 0, minWidth: 250,
            maxHeight: 340, overflowY: "auto", background: "var(--surface)",
            border: "1px solid var(--border)", borderRadius: "var(--radius-sm)",
            boxShadow: "var(--shadow-md)", zIndex: 40, padding: 6,
          }}
        >
          <div style={{ fontSize: 11, fontWeight: 600, color: "var(--text3)", textTransform: "uppercase", letterSpacing: 0.4, padding: "4px 8px" }}>
            Model
          </div>
          {ALLOWED_MODELS.map((m) => (
            <button
              key={m}
              type="button"
              onClick={() => {
                const cap = capabilityForModel(m);
                onChange(m, cap.reasoningLevels.length > 0 ? (cap.reasoningLevels[0] ?? null) : null);
              }}
              style={{
                display: "flex", width: "100%", alignItems: "center", justifyContent: "space-between",
                gap: 8, padding: "7px 8px", borderRadius: 8, border: "none",
                background: m === model ? "var(--accent-dim)" : "transparent",
                color: "var(--text)", fontSize: 13, cursor: "pointer", textAlign: "left",
              }}
            >
              <span>{modelLabel(m)}</span>
              {m === model && <span style={{ color: "var(--accent)" }}>✓</span>}
            </button>
          ))}

          {capability.reasoningLevels.length > 0 ? (
            <>
              <div style={{ height: 1, background: "var(--border)", margin: "6px 4px" }} />
              <div style={{ fontSize: 11, fontWeight: 600, color: "var(--text3)", textTransform: "uppercase", letterSpacing: 0.4, padding: "4px 8px" }}>
                Reasoning effort
              </div>
              <div style={{ display: "flex", gap: 4, padding: "2px 8px 6px" }}>
                {capability.reasoningLevels.map((level) => (
                  <button
                    key={level}
                    type="button"
                    onClick={() => onChange(model, level)}
                    style={{
                      flex: 1, padding: "6px 0", borderRadius: 7,
                      border: `1px solid ${level === reasoningLevel ? "var(--accent)" : "var(--border)"}`,
                      background: level === reasoningLevel ? "var(--accent-dim)" : "transparent",
                      color: level === reasoningLevel ? "var(--accent)" : "var(--text2)",
                      fontSize: 12, fontWeight: 500, cursor: "pointer",
                    }}
                  >
                    {LEVEL_LABELS[level] ?? level}
                  </button>
                ))}
              </div>
            </>
          ) : (
            <div style={{ fontSize: 11.5, color: "var(--text3)", padding: "6px 8px 4px" }}>
              This model has no configurable reasoning mode.
            </div>
          )}
        </div>
      )}
    </div>
  );
}
</file>

<file path="apps/shell/src/components/ProjectKindPanel.tsx">
"use client";

import * as React from "react";
import { Button } from "@naelao/ui";
import {
  getBusinessWallet, listWorkspaceFiles, readWorkspaceFile,
  type Project, type BusinessWallet, type WorkspaceFile, type WorkspaceFileContent,
} from "@/lib/api";
import { FileViewer } from "@/components/FileViewer";

type Creds = { sessionToken: string; endUserId: string };

function money(cents: number, currency = "USD"): string {
  return new Intl.NumberFormat("en-US", { style: "currency", currency, minimumFractionDigits: 2 }).format(cents / 100);
}

// F-40: WalletLedgerPanel — the natively-built panel for kind='wallet'. Looks like a bank-account
// ledger (balance + lifetime cuts + transactions), NOT a generic registry-driven component.
function WalletLedgerPanel({ spaceId, creds }: { spaceId: string; creds: Creds }) {
  const [wallet, setWallet] = React.useState<BusinessWallet | null>(null);
  const [loading, setLoading] = React.useState(true);
  React.useEffect(() => {
    getBusinessWallet(spaceId, creds).then(setWallet).catch(() => setWallet(null)).finally(() => setLoading(false));
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [spaceId]);
  if (loading) return <p style={{ color: "var(--text3)", fontSize: 13 }}>Loading wallet…</p>;
  if (!wallet) return <p style={{ color: "var(--text3)", fontSize: 13 }}>Wallet unavailable.</p>;
  return (
    <div className="settings-block">
      <div className="settings-row">
        <div>
          <div className="settings-row-label">Available to grow the business</div>
          <div className="settings-row-sub">Your AI only spends money this business has earned.</div>
        </div>
        <div style={{ textAlign: "right" }}>
          <div className="settings-row-label">{money(wallet.available_balance_cents, wallet.currency)}</div>
          <div className="settings-row-sub">{wallet.currency}</div>
        </div>
      </div>
      <div className="settings-row">
        <div>
          <div className="settings-row-label">Lifetime earned</div>
          <div className="settings-row-sub">{wallet.lifetime.order_count} settled order(s)</div>
        </div>
        <div style={{ textAlign: "right" }}>
          <div className="settings-row-label">{money(wallet.lifetime.gross_cents)} gross</div>
          <div className="settings-row-sub">
            {money(wallet.lifetime.naelao_cut_cents)} Naelao cut
            {wallet.lifetime.builder_cut_cents > 0 ? ` · ${money(wallet.lifetime.builder_cut_cents)} builder cut` : ""}
          </div>
        </div>
      </div>
      {wallet.transactions.slice(0, 10).map((t) => (
        <div className="settings-row" key={t.id}>
          <div>
            <div className="settings-row-label">{t.reason.replace(/_/g, " ")}</div>
            <div className="settings-row-sub">{new Date(t.created_at).toLocaleString()}</div>
          </div>
          <div style={{ textAlign: "right" }}>
            <div className="settings-row-label">{t.delta_cents >= 0 ? "+" : ""}{money(t.delta_cents)}</div>
            <div className="settings-row-sub">bal {money(t.balance_after_cents)}</div>
          </div>
        </div>
      ))}
    </div>
  );
}

// F-39 UI: read-only workspace file viewer — lists a project's R2 artifacts; clicking an .html file
// previews it in a sandboxed iframe, other text shows inline.
function WorkspaceFilesPanel({ spaceId, projectId, creds }: { spaceId: string; projectId: string; creds: Creds }) {
  const [files, setFiles] = React.useState<WorkspaceFile[]>([]);
  const [loading, setLoading] = React.useState(true);
  const [open, setOpen] = React.useState<WorkspaceFileContent | null>(null);
  React.useEffect(() => {
    listWorkspaceFiles(spaceId, projectId, creds).then(setFiles).catch(() => setFiles([])).finally(() => setLoading(false));
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [spaceId, projectId]);

  async function openFile(path: string) {
    try { setOpen(await readWorkspaceFile(spaceId, projectId, path, creds)); }
    catch { setOpen({ path, content: "(could not read file)" }); }
  }

  if (loading) return <p style={{ color: "var(--text3)", fontSize: 13 }}>Loading files…</p>;
  if (files.length === 0) return <p style={{ color: "var(--text3)", fontSize: 13 }}>No files in this project's workspace yet — your agent's generated artifacts appear here.</p>;
  return (
    <>
      <div className="settings-block">
        {files.map((f) => (
          <div className="settings-row" key={f.path}>
            <div>
              <div className="settings-row-label">{f.path}</div>
              <div className="settings-row-sub">{(f.size / 1024).toFixed(1)} KB · {new Date(f.uploaded).toLocaleDateString()}</div>
            </div>
            <Button size="sm" variant="ghost" onClick={() => openFile(f.path)}>View</Button>
          </div>
        ))}
      </div>
      {open && (
        <div className="settings-block" style={{ marginTop: 12, padding: 12 }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 8 }}>
            <strong style={{ fontSize: 13 }}>{open.path}</strong>
            <Button size="sm" variant="ghost" onClick={() => setOpen(null)}>Close</Button>
          </div>
          {/* Step 4: multi-format viewer (PDF, images, Word/Excel, text/html/markdown/csv). */}
          <FileViewer file={open} />
        </div>
      )}
    </>
  );
}

/**
 * F-40: the mount point. A SWITCH on project.kind (never a data-driven interchangeable lookup) —
 * each kind's panel is its own purpose-built component. A kind with no panel yet renders nothing
 * (the shared project shell alone), which is the expected incremental-build path. The Files viewer
 * (F-39) is shown for every kind since every project has a workspace.
 */
export function ProjectKindPanel({ project, spaceId, creds }: { project: Project; spaceId: string; creds: Creds }) {
  return (
    <>
      {project.kind === "wallet" && (
        <>
          <div className="section-label">Wallet</div>
          <WalletLedgerPanel spaceId={spaceId} creds={creds} />
        </>
      )}
      {/* Additional kind panels (storefront, crm, ...) mount here one at a time — see F-40. */}

      <div className="section-label" style={{ marginTop: 24 }}>Files</div>
      <WorkspaceFilesPanel spaceId={spaceId} projectId={project.id} creds={creds} />
    </>
  );
}
