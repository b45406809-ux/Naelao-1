// WorkflowRegistryDO – register() handler
async register(workflow: WorkflowConfig): Promise&lt;void&gt; {
  this.sql.exec('INSERT OR REPLACE INTO workflows VALUES (?,?,?,?)',
    workflow.id, workflow.cronExpr, 'active', computeNextRun(workflow.cronExpr));
  const existing = await this.ctx.storage.getAlarm();
  if (existing === null) {
    await this.ctx.storage.setAlarm(Date.now() + 1_000); // wake soon to schedule
  }
}

// alarm() — schedule next tick for the soonest due workflow only
async alarm(): Promise&lt;void&gt; {
  const due = [...this.sql.exec&lt;{id:string}&gt;(
    'SELECT id FROM workflows WHERE next_run_at &lt;= datetime("now") AND status="active" LIMIT 100'
  )];
  await Promise.allSettled(due.map(wf =&gt; this.env.NAELAO_WORKFLOW_DISPATCH.send({ workflowId: wf.id })));
  const next = [...this.sql.exec&lt;{t:string}&gt;('SELECT MIN(next_run_at) AS t FROM workflows WHERE status="active"')][0]?.t;
  if (next) await this.ctx.storage.setAlarm(new Date(next).getTime());
}</p></div>
</div>

