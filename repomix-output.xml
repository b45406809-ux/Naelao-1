        <div class="sec" id="naelao-notifications-full">
          <span class="sec-ey">92 — Worker Full Implementation: naelao-notifications</span>
          <h2>naelao-notifications — Omnichannel Alert Delivery: APNs, FCM, Slack, Discord, Resend, VAPI</h2>
          <div class="bar"></div>
          <p class="lead">The complete notification delivery engine. A pure CF Queue consumer — nothing calls it via
            HTTP. Every delivery channel is implemented in full: APNs JWT auth (not certificates), FCM HTTP v1 API,
            Slack Block Kit messages, Discord embeds, Resend templated email, and VAPI outbound voice escalation.
            Idempotency via KV prevents double-delivery on queue retry.</p>

          <div class="g2">
            <div class="box box-bl">
              <div class="box-lbl">APNs: JWT Auth (Not Certs)</div>
              <p>APNs supports two auth mechanisms: certificates (.p12) and JWT tokens signed with a .p8 key.
                Certificates expire every year and require renewal. JWT tokens are signed per-request using a long-lived
                ES256 private key that never expires (only the JWT itself expires in 60 min). Naelao uses JWT — zero
                renewal overhead, and the .p8 key stores cleanly as a CF Secret.</p>
            </div>
            <div class="box box-tl">
              <div class="box-lbl">FCM v1 HTTP API</div>
              <p>The legacy FCM API (v1 deprecated 2024) used a server key. The FCM HTTP v1 API uses OAuth2 service
                account tokens. Naelao generates a service account JWT, exchanges it for an access token (cached 55 min
                in KV), and calls <code>https://fcm.googleapis.com/v1/projects/{project}/messages:send</code>. The token
                refresh is transparent and never blocks delivery.</p>
            </div>
          </div>

          <h3>Complete Worker Implementation</h3>
          <pre><code><span class="cm">// workers/notifications/index.ts
// Pure Queue consumer — no HTTP fetch() handler.
// Bindings: NAELAO_NOTIFICATIONS queue (consumer), NAELAO_CONFIG_KV, SPACE_DO, Secrets.</span>

interface NotificationPayload {
  id: string;
  type: string;
  spaceId: string;
  userId?: string;
  to?: string;          <span class="cm">// email address or phone</span>
  channels: Array&lt;'email' | 'push' | 'slack' | 'discord' | 'voice'&gt;;
  message: string;
  title?: string;
  priority: 'normal' | 'high' | 'critical';
  metadata?: Record&lt;string, any&gt;;
}

interface Env {
  SPACE_DO: DurableObjectNamespace;  <span class="cm">// per-product SpaceDO — replaces HYPERDRIVE + SUPABASE_*</span>
  NAELAO_CONFIG_KV: KVNamespace;
  NAELAO_ANALYTICS_QUEUE: Queue;
  <span class="cm">// Secrets</span>
  APNS_KEY_ID: string;          <span class="cm">// 10-char Key ID from Apple Developer</span>
  APNS_TEAM_ID: string;         <span class="cm">// 10-char Team ID</span>
  APNS_BUNDLE_ID: string;       <span class="cm">// e.g. dev.naelao.app</span>
  APNS_PRIVATE_KEY: string;     <span class="cm">// PEM content of .p8 file (ES256)</span>
  FCM_SERVICE_ACCOUNT: string;  <span class="cm">// JSON string of Firebase service account</span>
  FCM_PROJECT_ID: string;
  RESEND_API_KEY: string;
  RESEND_FROM: string;          <span class="cm">// e.g. "Naelao &lt;noreply@naelao.dev&gt;"</span>
  VAPI_API_KEY: string;
  VAPI_PHONE_NUMBER_ID: string;
  <span class="cm">// SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY removed — SpaceDO handles all data access</span>
}

export default {
  async queue(batch: MessageBatch&lt;NotificationPayload&gt;, env: Env): Promise&lt;void&gt; {
    await Promise.allSettled(
      batch.messages.map(async msg =&gt; {
        try {
          await deliverNotification(msg.body, env);
          msg.ack();
        } catch (e) {
          console.error(`[notifications] delivery failed ${msg.body.id}:`, e);
          msg.retry();
        }
      })
    );
  }
};

async function deliverNotification(payload: NotificationPayload, env: Env): Promise&lt;void&gt; {
  <span class="cm">// Idempotency: KV lock for 24h prevents double-send on at-least-once delivery</span>
  const lockKey = `notif:sent:${payload.id}`;
  try { await env.NAELAO_CONFIG_KV.get(lockKey); } catch { /* key not found = not sent yet */ }
  const alreadySent = await env.NAELAO_CONFIG_KV.get(lockKey);
  if (alreadySent) return;

  const tasks: Promise&lt;void&gt;[] = [];

  if (payload.channels.includes('email') &amp;&amp; payload.to) {
    tasks.push(sendEmail(payload, env));
  }
  if (payload.channels.includes('push') &amp;&amp; payload.userId) {
    tasks.push(sendPush(payload, env));
  }
  if (payload.channels.includes('slack')) {
    tasks.push(sendSlack(payload, env));
  }
  if (payload.channels.includes('discord')) {
    tasks.push(sendDiscord(payload, env));
  }
  if (payload.channels.includes('voice') &amp;&amp; payload.priority === 'critical') {
    tasks.push(sendVapiCall(payload, env));
  }

  await Promise.all(tasks);

  await env.NAELAO_CONFIG_KV.put(lockKey, '1', { expirationTtl: 86400 });
  await env.NAELAO_ANALYTICS_QUEUE.send({
    type: 'notification_delivered', notificationId: payload.id,
    spaceId: payload.spaceId, channels: payload.channels, ts: Date.now()
  });
}

<span class="cm">// ── EMAIL via Resend ─────────────────────────────────────────</span>
async function sendEmail(payload: NotificationPayload, env: Env): Promise&lt;void&gt; {
