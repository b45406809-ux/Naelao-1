    }

    /* code keyword */
    .cn {
      color: #FCA5A5;
    }

    /* code number */

    /* ─── LISTS ───────────────────────────────────── */
    ul.fl {
      list-style: none;
      margin: 12px 0;
      padding: 0;
    }

    ul.fl li {
      padding: 7px 0 7px 22px;
      position: relative;
      font-size: 13.5px;
      color: var(--dim);
      border-bottom: 1px solid var(--brd);
      line-height: 1.58;
    }

    ul.fl li:last-child {
      border-bottom: none;
    }

    ul.fl li::before {
      content: '→';
      position: absolute;
      left: 0;
      color: var(--or);
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      top: 8px;
