  "groq/llama-3.3-70b-versatile": NO_REASONING,
  "groq/llama-3.1-8b-instant": NO_REASONING,
  // Qwen 3.6 27B on Groq: confirmed via Groq's own docs — a 2-level toggle, "none" (disable
  // reasoning) or "default" (let Qwen reason), NOT the low/medium/high shape gpt-oss uses. Reuses
  // "reasoning_effort" as the wire param name (Groq's own field for this model too) — only the
  // VALUES differ from gpt-oss, which effort.ts's generic ladder-length logic already handles
  // (a 2-native-level model gets a 3-position Effort ladder, saturating at its own top for "high").
  "groq/qwen/qwen3.6-27b": { reasoningLevels: ["none", "default"], reasoningParam: "reasoning_effort" },
};

/** Reasoning capability for a model string, degrading to NO_REASONING for anything not in the
 *  table above rather than throwing — an unknown/future model should just show no reasoning
 *  control, not break the config card. */
export function capabilityForModel(model: string): ModelCapability {
  return MODEL_CAPABILITIES[model] ?? NO_REASONING;
}

/** Whether `level` is one this model actually offers — used to validate a client-supplied
 *  reasoning-effort override server-side before it ever reaches the AI Gateway request. */
export function isValidReasoningLevel(model: string, level: string): boolean {
  return capabilityForModel(model).reasoningLevels.includes(level);
}
</file>

<file path="packages/billing-core/src/personal-plan.ts">
// Phase 4 (money): the end user's own personal-plan tier — dependency-free (mirrors models.ts's
// own "no circular import" discipline, since this is imported by both the spaces worker and any
// frontend that wants to render limits/prices without pulling in the whole billing-core surface).
//
// SCOPE: this gates two things per the plan's own decision — how many businesses a signed-in
// end user can OWN under one product, and whether they may invite others into a business they
// own. It does NOT replace the existing business_subscriptions (the business as a whole funds
// its own team) or credit-pack (personal balance top-up) mechanisms — both of those already exist
// and are untouched; this is the third, previously-missing leg the plan called "personal plan
// gates how many businesses a user can create and whether others may join."

export type PersonalPlanTier = "free" | "plus";

export interface PersonalPlanLimits {
  /** How many businesses this tier lets a user OWN under one product, before combining with the
   *  product's own configured abuse ceiling (SpaceTypeProductConfig.maxBusinessesPerEndUser). */
  maxBusinessesOwned: number;
  /** Whether a business this user owns may issue invites for others to join it. */
  canInviteOthers: boolean;
}

export const PERSONAL_PLAN_LIMITS: Record<PersonalPlanTier, PersonalPlanLimits> = {
  free: { maxBusinessesOwned: 3, canInviteOthers: false },
  plus: { maxBusinessesOwned: 25, canInviteOthers: true },
};

export function isPersonalPlanTier(value: unknown): value is PersonalPlanTier {
  return value === "free" || value === "plus";
}

/**
 * Combine a user's personal-plan tier with the product's own configured ceiling
 * (maxBusinessesPerEndUser, default 10 — see business-create.ts). The PRODUCT ceiling is always
 * the outer bound a builder chose (an abuse/DoS cap, not a monetization lever) — a personal plan
 * can only ever narrow a free-tier user's OWN slice of it, never widen it beyond what the builder
 * allowed. 'plus' removes that narrowing and lets the user use the full product ceiling.
 */
export function resolveEffectiveBusinessLimit(tier: PersonalPlanTier, productCeiling: number): number {
  if (tier === "plus") return productCeiling;
  return Math.min(productCeiling, PERSONAL_PLAN_LIMITS.free.maxBusinessesOwned);
}

export function canPersonalPlanInvite(tier: PersonalPlanTier): boolean {
  return PERSONAL_PLAN_LIMITS[tier].canInviteOthers;
}
</file>

<file path="packages/billing-core/src/reseller.ts">
/**
 * Reseller billing attribution (spec G-AS34 Agency Partner Program / G-AS35 White-Label
 * Reseller). Pure functions — no I/O — so they are trivially unit-testable and reusable
 * from the billing worker.
 *
 * When a child tenant (a customer who created their own business under a reseller's
 * product) generates a billing event, we attribute it to the parent reseller according to
 * the reseller's `billing_relationship`:
 *
 *   - "reseller":  Naelao bills the reseller WHOLESALE; the reseller keeps the margin
 *                  (retail − wholesale) and owns the customer invoice. Spec G-AS35.
 *   - "referral":  Naelao bills the customer directly and pays the reseller a rev-share
 *                  (referral_share_pct % of retail). The reseller's "margin" is that share.
 *   - "platform":  No resale relationship — the child tenant is billed exactly like any
 *                  builder and nothing is attributed to the parent.
 */

import type { NormalizedBillingEvent } from "./providers/types.js";

export type BillingRelationship = "reseller" | "referral" | "platform";

export interface ResellerConfig {
  billingRelationship: BillingRelationship;
  /**
   * reseller mode: fixed wholesale cost (cents) Naelao charges the reseller for the
   * child subscription period. When undefined/null, wholesale passes through at retail
   * (zero margin) — a safe default until the reseller sets their wholesale rate.
   */
  wholesaleCents?: number | null;
  /** referral mode: percent (0-100) of retail revenue Naelao pays the reseller. */
  referralSharePct?: number;
}

export interface ResellerAttribution {
  relationship: BillingRelationship;
  /** What the customer paid (the event amount). */
  retailCents: number;
  /** What Naelao bills the reseller for this event. */
  wholesaleCents: number;
  /** The reseller's economic benefit: margin (reseller) or rev-share earned (referral). */
  marginCents: number;
  currency: string;
}

/** Event types that move money and should hit the reseller ledger. */
const REVENUE_EVENTS = new Set<NormalizedBillingEvent["type"]>([
  "payment.success",
  "subscription.created",
  "subscription.updated",
  "subscription.resumed",
]);

/** Refunds reverse revenue (negative attribution). */
const REVERSAL_EVENTS = new Set<NormalizedBillingEvent["type"]>(["refund.issued"]);

/** Whether a billing event should produce a reseller-ledger entry at all. */
export function isLedgerEvent(eventType: NormalizedBillingEvent["type"]): boolean {
  return REVENUE_EVENTS.has(eventType) || REVERSAL_EVENTS.has(eventType);
}

function clampPct(pct: number | undefined): number {
  if (pct === undefined || Number.isNaN(pct)) return 0;
  return Math.max(0, Math.min(100, pct));
}

/**
 * Compute how a child-tenant billing event is attributed to its parent reseller.
 * Returns null when there is nothing to attribute (platform relationship or a
 * non-revenue event like payment.failed / subscription.paused / cancelled).
 */
export function computeResellerAttribution(
  event: Pick<NormalizedBillingEvent, "type" | "amountCents" | "currency">,
  config: ResellerConfig
): ResellerAttribution | null {
  if (config.billingRelationship === "platform") return null;
  if (!isLedgerEvent(event.type)) return null;

  const sign = REVERSAL_EVENTS.has(event.type) ? -1 : 1;
  const retailCents = sign * Math.abs(Math.round(event.amountCents));
  const currency = event.currency || "USD";

  if (config.billingRelationship === "reseller") {
    // Wholesale is a fixed per-period cost; pass-through at retail when unset.
    const baseWholesale =
      config.wholesaleCents === undefined || config.wholesaleCents === null
        ? Math.abs(retailCents)
        : Math.max(0, Math.round(config.wholesaleCents));
    const wholesaleCents = sign * baseWholesale;
    const marginCents = retailCents - wholesaleCents; // reseller keeps the spread
    return { relationship: "reseller", retailCents, wholesaleCents, marginCents, currency };
  }

  // referral: Naelao collects retail, pays the reseller a share. From Naelao's books the
  // reseller's "wholesale" cost is zero; the reseller earns referralSharePct of retail.
  const sharePct = clampPct(config.referralSharePct);
  const marginCents = Math.round((retailCents * sharePct) / 100);
  return { relationship: "referral", retailCents, wholesaleCents: 0, marginCents, currency };
}

/** YYYY-MM bucket for ledger rollup, from a timestamp (defaults to now). */
export function billingPeriod(at: number = Date.now()): string {
  const d = new Date(at);
  const month = String(d.getUTCMonth() + 1).padStart(2, "0");
  return `${d.getUTCFullYear()}-${month}`;
}
</file>

