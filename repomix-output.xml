async function deliverWithIdempotency(notifId: string, payload: Notification, env: Env) {
  // Write lock FIRST with short TTL — if this races, one writer wins
  const existing = await env.KV.get(notifId);
  if (existing) return { duplicate: true };
  
  // Write before delivery (not after) — "at most once" semantics
  await env.KV.put(notifId, "pending", { expirationTtl: 300 });
  
  try {
    await deliverNotification(payload, env);
    // Update to "delivered" for diagnostics
    await env.KV.put(notifId, "delivered", { expirationTtl: 86400 });
  } catch (e) {
