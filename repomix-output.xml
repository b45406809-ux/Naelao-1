  <!-- ══════════════════════════════════════════════════════
     §52 — NAELAO-MCP-HUB: COMPLETE IMPLEMENTATION
═══════════════════════════════════════════════════════ -->
  <div class="sep"></div>
  <div class="sec" id="mcp-hub">
    <span class="sec-ey">52 — Worker Deep Dive: naelao-mcp-hub</span>
    <h2>naelao-mcp-hub — MCP Tool Proxy & Registry</h2>
    <div class="bar"></div>
    <p class="lead">naelao-mcp-hub is the central dispatcher for all MCP tool calls in Naelao. Every time an agent calls
      a tool — web_search, create_pr, get_weather, any MCP app tool — the call routes through naelao-mcp-hub. This
      Worker discovers available tools, handles OAuth credential injection, manages tool schema caching, and dispatches
      to the correct MCP server.</p>

    <h3>What naelao-mcp-hub Does</h3>
    <ul class="fl">
      <li><strong>Tool discovery:</strong> Calls each installed MCP server's <span class="ic">GET /mcp/tools</span>
        endpoint to learn what tools are available. Caches tool schemas in KV (TTL: 1 hour).</li>
      <li><strong>Tool routing:</strong> When an agent calls a tool, naelao-mcp-hub looks up which MCP server provides
        that tool and routes the POST to <span class="ic">/mcp/tools/{name}</span> on that server.</li>
      <li><strong>Credential injection:</strong> Calls naelao-credentials to get the right auth headers for each MCP
        server before dispatching the tool call.</li>
      <li><strong>Schema aggregation:</strong> Aggregates tool schemas from all installed apps and returns them to
        AgentDO for injection into the system prompt.</li>
      <li><strong>Platform skill routing:</strong> For platform skills (browser, file-manager, code-exec, etc.), routes
        to the appropriate internal handler without going through an external MCP server.</li>
    </ul>

    <h3>Complete Implementation</h3>
    <pre><code><span class="cm">// workers/mcp-hub/index.ts</span>
import { Hono } from 'hono';
const app = new Hono&lt;{ Bindings: Env }&gt;();

<span class="cm">// GET /tools — aggregate all available tools for a Space
// Called by AgentDO at run start to build the tools list for the system prompt</span>
app.get('/tools', async (c) =&gt; {
  const spaceId = c.get('spaceId');
  const agentId = c.req.query('agentId') ?? 'unknown';

  <span class="cm">// Check cache first — tool schemas rarely change</span>
  const cacheKey = `tool-schemas:${spaceId}:${agentId}`;
  const cached = await c.env.NAELAO_CONFIG_KV.get(cacheKey, 'json') as ToolSchema[] | null;
  if (cached) return c.json({ tools: cached });

  <span class="cm">// Load installed apps for this Space from SpaceDO SQLite</span>
  const spaceDO = getProductDO(rootSpaceId, c.env);  // SpaceDO replaces Hyperdrive
  const installed = await db.query(
    `SELECT app_id, worker_url, tool_permissions FROM space_app_installs
     WHERE space_id = $1 AND status = 'active'`,
    [spaceId]
  );

  <span class="cm">// Discover tools from each installed app in parallel</span>
  const toolDiscoveries = await Promise.allSettled(
    installed.rows.map(async (app) => {
      const { app_id, worker_url, tool_permissions } = app;
      try {
        const resp = await fetch(`${worker_url}/mcp/tools`, {
          signal: AbortSignal.timeout(5000) <span class="cm">// 5s timeout per app</span>
        });
        if (!resp.ok) throw new Error(`App ${app_id} returned ${resp.status}`);
        const { tools } = await resp.json() as { tools: ToolDefinition[] };

        <span class="cm">// Filter to only permitted tools (if tool_permissions is set)</span>
        const permitted = tool_permissions
          ? tools.filter((t: ToolDefinition) =>
              (tool_permissions as string[]).includes(t.name)
            )
          : tools;

        return permitted.map((t: ToolDefinition) => ({
          ...t,
          appId: app_id,
          workerUrl: worker_url
        }));
      } catch (e) {
        console.warn(`[MCP-HUB] Tool discovery failed for app ${app_id}:`, e);
        return []; <span class="cm">// failed app = no tools, not a fatal error</span>
      }
    })
  );

  <span class="cm">// Flatten tool list + add platform skills</span>
  const appTools = toolDiscoveries
    .filter(r => r.status === 'fulfilled')
    .flatMap(r => (r as PromiseFulfilledResult&lt;ToolDefinition[]&gt;).value);

  const platformTools = await loadPlatformToolSchemas(spaceId, agentId, c.env);
  const allTools = [...platformTools, ...appTools];

  <span class="cm">// Cache for 1 hour</span>
  await c.env.NAELAO_CONFIG_KV.put(cacheKey, JSON.stringify(allTools), {
    expirationTtl: 3600
  });

  return c.json({ tools: allTools });
});

<span class="cm">// POST /execute — execute a tool call
// Called by AgentDO when LLM emits a tool call</span>
app.post('/execute', async (c) =&gt; {
  const spaceId = c.get('spaceId');
  const { toolName, parameters, agentId, projectId, runId } = await c.req.json();

  <span class="cm">// 1. Resolve which app/server handles this tool</span>
  const toolRoute = await resolveToolRoute(toolName, spaceId, c.env);

  if (!toolRoute) {
    return c.json({
      success: false,
      error: `Tool not found: ${toolName}. Available tools can be listed via GET /tools`
    }, 404);
  }

  <span class="cm">// 2. Handle platform skills internally</span>
  if (toolRoute.type === 'platform') {
    const result = await executePlatformTool(toolName, parameters, {
      spaceId, agentId, projectId
    }, c.env);
    return c.json(result);
  }

  <span class="cm">// 3. Handle MCP app tools — inject credentials and proxy</span>
  const credHeaders = await getCredentialHeaders(toolRoute.appId, spaceId, c.env);

  const start = Date.now();
  let toolResult: unknown;
  try {
    const resp = await fetch(`${toolRoute.workerUrl}/mcp/tools/${toolName}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Space-Id': spaceId,
        'X-Agent-Id': agentId,
        ...credHeaders
      },
      body: JSON.stringify(parameters),
      signal: AbortSignal.timeout(30000) <span class="cm">// 30s timeout for tool execution</span>
    });

    if (!resp.ok) {
      const errorText = await resp.text();
      return c.json({
        success: false,
        error: `Tool ${toolName} failed: ${resp.status} — ${errorText.slice(0, 500)}`
      });
    }

    const { result } = await resp.json() as { result: unknown };
    toolResult = result;
  } catch (e) {
    if ((e as Error).name === 'TimeoutError') {
      return c.json({ success: false, error: `Tool ${toolName} timed out after 30 seconds` });
    }
    return c.json({ success: false, error: `Tool ${toolName} error: ${(e as Error).message}` });
  }

  <span class="cm">// 4. Log tool execution to Analytics Engine</span>
  await c.env.NAELAO_ANALYTICS_QUEUE.send({
    type: 'tool_execution',
    spaceId, agentId, toolName,
    durationMs: Date.now() - start,
    success: true,
    runId
  });

  return c.json({ success: true, result: toolResult });
});

<span class="cm">// GET /tools/invalidate — called when a Space installs/uninstalls an app
// Forces cache refresh so new tools are immediately available</span>
app.post('/tools/invalidate', async (c) =&gt; {
  const spaceId = c.get('spaceId');
  <span class="cm">// Delete all cached tool schemas for this space</span>
  const keys = await c.env.NAELAO_CONFIG_KV.list({ prefix: `tool-schemas:${spaceId}:` });
  await Promise.all(
    keys.keys.map(k => c.env.NAELAO_CONFIG_KV.delete(k.name))
  );
  return c.json({ invalidated: keys.keys.length });
});

async function resolveToolRoute(
  toolName: string,
  spaceId: string,
  env: Env
): Promise&lt;{ type: 'platform' | 'app'; appId?: string; workerUrl?: string } | null&gt; {
  <span class="cm">// Platform tools have fixed names — check these first</span>
  const PLATFORM_TOOLS = new Set([
    'read_file', 'write_file', 'list_directory', 'delete_file',
    'web_search', 'crawl_page', 'execute_python', 'execute_bash',
    'execute_node', 'browser_navigate', 'browser_click', 'browser_fill',
    'browser_screenshot', 'browser_scrape', 'git_clone', 'git_commit',
    'create_workflow', 'trigger_workflow', 'render_artifact',
    'update_todo', 'api_call', 'data_transform'
  ]);

  if (PLATFORM_TOOLS.has(toolName)) {
    return { type: 'platform' };
  }

  <span class="cm">// Check cached tool registry for app tools</span>
  const allToolsJson = await env.NAELAO_CONFIG_KV.get(`tool-schemas:${spaceId}:unknown`);
  if (allToolsJson) {
    const allTools = JSON.parse(allToolsJson) as Array&lt;{name: string; appId: string; workerUrl: string}&gt;;
    const tool = allTools.find(t => t.name === toolName);
    if (tool) return { type: 'app', appId: tool.appId, workerUrl: tool.workerUrl };
  }

  return null;
}

async function getCredentialHeaders(
  appId: string,
  spaceId: string,
  env: Env
): Promise&lt;Record&lt;string, string&gt;&gt; {
  try {
    const credResp = await env.NAELAO_CREDENTIALS.fetch(
      new Request('http://credentials/get', {
        method: 'POST',
        body: JSON.stringify({ spaceId, provider: appId })
      })
    );
    if (!credResp.ok) return {};
    const { apiKey, found } = await credResp.json() as { apiKey: string; found: boolean };
    if (!found) return {};
    return { 'X-App-Api-Key': apiKey };
  } catch {
    return {};
  }
}

export default app;</code></pre>

    <h3>Platform Tool Dispatch — executePlatformTool()</h3>
    <pre><code><span class="cm">// workers/mcp-hub/platform-tools.ts
// Routes platform tool calls to the correct internal handler.
// Platform tools are not MCP servers — they're built into the Naelao platform.</span>

export async function executePlatformTool(
  toolName: string,
  parameters: Record&lt;string, string&gt;,
  context: { spaceId: string; agentId: string; projectId?: string },
  env: Env
): Promise&lt;ToolResult&gt; {

  <span class="cm">// File operations → file-manager skill handler (R2 direct)</span>
  if (['read_file','write_file','list_directory','delete_file','file_history','rollback_file'].includes(toolName)) {
    return handleFileManagerTool(toolName, parameters, context, env);
  }

  <span class="cm">// Web search → Tavily API via cf-worker script</span>
  if (toolName === 'web_search') {
    return handleWebSearch(parameters, context, env);
  }

  <span class="cm">// Code execution → SandboxDO → CF Container</span>
  if (['execute_python','execute_bash','execute_node'].includes(toolName)) {
    return handleCodeExecution(toolName, parameters, context, env);
  }

  <span class="cm">// Browser → naelao-browser CDP proxy</span>
  if (toolName.startsWith('browser_')) {
    const resp = await env.NAELAO_BROWSER_SVC.fetch(new Request('http://browser/action', {
      method: 'POST',
      body: JSON.stringify({ action: toolName.replace('browser_', ''), ...parameters, spaceId: context.spaceId })
    }));
    return resp.json();
  }

  <span class="cm">// Workflow tools → naelao-workflows</span>
  if (['create_workflow','trigger_workflow'].includes(toolName)) {
    const resp = await env.NAELAO_WORKFLOWS_SVC.fetch(new Request(`http://workflows/${toolName.replace('_', '-')}`, {
      method: 'POST',
      body: JSON.stringify({ ...parameters, spaceId: context.spaceId })
    }));
    return resp.json();
  }

  <span class="cm">// Artifact creation → naelao-artifact</span>
  if (toolName === 'render_artifact') {
    const resp = await env.NAELAO_ARTIFACT.fetch(new Request('http://artifact/create', {
      method: 'POST',
      body: JSON.stringify({ ...parameters, spaceId: context.spaceId, agentId: context.agentId })
    }));
    return resp.json();
  }

  <span class="cm">// API calls → validate URL, inject credentials, proxy request</span>
  if (toolName === 'api_call') {
    return handleApiCall(parameters, context, env);
  }

  return { success: false, error: `Unknown platform tool: ${toolName}` };
}</code></pre>
