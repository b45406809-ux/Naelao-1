          <h3>Complete Worker Implementation</h3>
          <pre><code><span class="cm">// workers/admin/index.ts
// All routes require valid Cf-Access-Jwt-Assertion header.
// Deployed at: admin.naelao.dev (separate CF Access policy from app.naelao.dev)</span>

import { Hono } from 'hono';
import { cors } from 'hono/cors';

interface Env {
  SPACE_DO: DurableObjectNamespace;  <span class="cm">// per-product SpaceDO — replaces HYPERDRIVE</span>
  NAELAO_CONFIG_KV: KVNamespace;
  NAELAO_CIRCUIT_KV: KVNamespace;
  NAELAO_AGENT_QUEUE: Queue;
  NAELAO_ANALYTICS_QUEUE: Queue;
  NAELAO_NOTIFICATIONS_QUEUE: Queue;
  NAELAO_SPACE_DO: DurableObjectNamespace;
  CF_ACCESS_TEAM_DOMAIN: string;   <span class="cm">// e.g. "naelao.cloudflareaccess.com"</span>
  CF_ACCESS_AUD: string;           <span class="cm">// Application Audience tag from CF Access policy</span>
  CF_API_TOKEN: string;
  NAELAO_ACCOUNT_ID: string;
}

const app = new Hono&lt;{ Bindings: Env }&gt;();

<span class="cm">// ── ZERO TRUST MIDDLEWARE ─────────────────────────────────────
// Every request must carry a valid CF Access JWT.
// The JWT is verified against the JWKS published by the CF Access team domain.</span>
app.use('*', async (c, next) =&gt; {
  const jwt = c.req.header('Cf-Access-Jwt-Assertion');
  if (!jwt) return c.json({ error: 'Missing CF-Access-Jwt-Assertion header' }, 403);

  try {
    <span class="cm">// Fetch JWKS from CF Access public endpoint (cached in KV for 1 hr)</span>
    const jwksKey = 'admin:cf-access-jwks';
    let jwks: any = JSON.parse(await c.env.NAELAO_CONFIG_KV.get(jwksKey) ?? 'null');
    if (!jwks) {
      const r = await fetch(`https://${c.env.CF_ACCESS_TEAM_DOMAIN}/cdn-cgi/access/certs`);
      jwks = await r.json();
      await c.env.NAELAO_CONFIG_KV.put(jwksKey, JSON.stringify(jwks), { expirationTtl: 3600 });
    }

    <span class="cm">// Parse JWT header to find kid</span>
    const [headerB64] = jwt.split('.');
    const header = JSON.parse(atob(headerB64));
    const jwk = jwks.keys.find((k: any) =&gt; k.kid === header.kid);
    if (!jwk) return c.json({ error: 'JWT key ID not found in JWKS' }, 403);

    const key = await crypto.subtle.importKey('jwk', jwk, { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' }, false, ['verify']);
    const [, payloadB64, sigB64] = jwt.split('.');
    const data = new TextEncoder().encode(`${headerB64}.${payloadB64}`);
    const sig = Uint8Array.from(atob(sigB64.replace(/-/g, '+').replace(/_/g, '/')), c =&gt; c.charCodeAt(0));
    const valid = await crypto.subtle.verify('RSASSA-PKCS1-v1_5', key, sig, data);
    if (!valid) return c.json({ error: 'CF Access JWT signature invalid' }, 403);

    const payload = JSON.parse(atob(payloadB64));
    if (payload.aud?.[0] !== c.env.CF_ACCESS_AUD) return c.json({ error: 'JWT audience mismatch' }, 403);
    if (payload.exp &lt; Date.now() / 1000) return c.json({ error: 'JWT expired' }, 403);

    c.set('adminEmail' as any, payload.email);
    await next();
  } catch (e) {
    console.error('[admin] JWT verification error:', e);
    return c.json({ error: 'JWT verification failed' }, 403);
  }
});

<span class="cm">// ── 1. PLATFORM METRICS ─────────────────────────────────────
// Aggregated stats from Analytics Engine + SpaceDO SQLite counters</span>
app.get('/metrics', async (c) =&gt; {
