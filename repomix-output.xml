  last_message_at TEXT,
  summary TEXT,                    -- per-session LLM summary for thread context
  created_at TEXT NOT NULL DEFAULT (datetime('now')),
  ended_at TEXT
);

CREATE INDEX IF NOT EXISTS idx_ts_thread ON thread_sessions (thread_id, created_at ASC);
CREATE INDEX IF NOT EXISTS idx_ts_tenant ON thread_sessions (tenant_id, space_id);
</file>

<file path="infra/migrations/0030_token_version.sql">
-- G-AD02: Add token_version counter to users for strongly-consistent session revocation.
-- Incrementing token_version atomically invalidates ALL active tokens for that user.
ALTER TABLE users ADD COLUMN token_version INTEGER NOT NULL DEFAULT 0;
</file>

<file path="infra/migrations/0031_platform_failures.sql">
-- G-D11: Platform DLQ failure tracking table.
-- Dead-letter queue messages are written here before the 4-day CF retention window expires.
CREATE TABLE IF NOT EXISTS platform_failures (
  id            TEXT PRIMARY KEY,
  message_type  TEXT NOT NULL,
  payload_json  TEXT NOT NULL,
  failure_reason TEXT,
  failed_at     TEXT NOT NULL DEFAULT (datetime('now')),
  retry_count   INTEGER NOT NULL DEFAULT 0,
  reviewed      INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS idx_platform_failures_type ON platform_failures(message_type, failed_at DESC);
CREATE INDEX IF NOT EXISTS idx_platform_failures_reviewed ON platform_failures(reviewed, failed_at DESC);
</file>

<file path="infra/migrations/0032_usage_events_idempotency.sql">
-- G-AN09: Usage metering idempotency key — prevents double-charge on queue retry.
-- event_hash is sha256(space_id || user_id || recorded_at_minute || event_type).
-- The UNIQUE constraint means at-least-once queue delivery can INSERT OR IGNORE safely.
ALTER TABLE usage_events ADD COLUMN event_hash TEXT;
CREATE UNIQUE INDEX IF NOT EXISTS idx_usage_events_hash ON usage_events(event_hash) WHERE event_hash IS NOT NULL;
</file>

<file path="infra/migrations/0033_reseller_accounts.sql">
-- Reseller / tenant-membership subsystem (spec G-AS34 Agency Partner Program,
-- G-AS35 White-Label Reseller). Backs productConfig.membershipModel = "tenant" | "hybrid".
--
-- Kept in dedicated tables keyed by tenant_id (rather than ALTERing orgs) so the
-- account-hierarchy concern is isolated and does not depend on the orgs/organizations
-- table naming. A "reseller" is a builder whose product lets customers create their own
-- businesses (child tenants). Naelao bills the reseller wholesale (or the customer
-- directly with a rev-share), per billing_relationship.

-- Config for a tenant that operates as a reseller (one row per reseller tenant).
CREATE TABLE IF NOT EXISTS reseller_accounts (
  tenant_id            TEXT PRIMARY KEY,
  -- The reseller's product space whose productConfig enabled tenant/hybrid membership.
  product_space_id     TEXT NOT NULL,
  -- "reseller" (wholesale->retail, reseller invoices), "referral" (Naelao bills, rev-share),
  -- "platform" (no resale — child tenants billed exactly like any builder).
  billing_relationship TEXT NOT NULL DEFAULT 'platform'
    CHECK (billing_relationship IN ('reseller','referral','platform')),
  -- reseller mode: fixed wholesale cost (cents) Naelao charges the reseller per child
  -- subscription period. NULL = pass-through of the retail amount.
  wholesale_cents      INTEGER,
  -- referral mode: percent (0-100) of retail revenue Naelao pays back to the reseller.
  referral_share_pct   REAL NOT NULL DEFAULT 0.0
    CHECK (referral_share_pct >= 0.0 AND referral_share_pct <= 100.0),
  status               TEXT NOT NULL DEFAULT 'active'
    CHECK (status IN ('active','suspended')),
  created_at           TEXT NOT NULL DEFAULT (datetime('now')),
  updated_at           TEXT NOT NULL DEFAULT (datetime('now'))
);

-- Maps each customer-created tenant to its parent reseller (the account hierarchy).
-- Child tenants stay fully isolated by the existing {tenantId}: namespacing; this table
-- only records lineage for billing rollup and the client-portfolio view.
CREATE TABLE IF NOT EXISTS tenant_hierarchy (
  child_tenant_id          TEXT PRIMARY KEY,
  parent_tenant_id         TEXT NOT NULL,
  -- The reseller's product space the customer signed up through.
  reseller_product_space_id TEXT NOT NULL,
  -- The space (business) provisioned for the customer under their own tenant.
  child_space_id           TEXT NOT NULL,
  child_owner_user_id      TEXT,
  status                   TEXT NOT NULL DEFAULT 'active'
    CHECK (status IN ('active','suspended','terminated')),
  created_at               TEXT NOT NULL DEFAULT (datetime('now'))
);

CREATE INDEX IF NOT EXISTS idx_tenant_hierarchy_parent ON tenant_hierarchy(parent_tenant_id);

-- Consolidated billing rollup: one row per child-tenant billing event, attributed to the
-- parent reseller. Drives the reseller's invoice (sum of wholesale_cents) and margin report.
CREATE TABLE IF NOT EXISTS reseller_ledger (
  id               TEXT PRIMARY KEY,
  parent_tenant_id TEXT NOT NULL,
  child_tenant_id  TEXT NOT NULL,
  child_space_id   TEXT NOT NULL,
  event_type       TEXT NOT NULL,
  retail_cents     INTEGER NOT NULL DEFAULT 0,
  wholesale_cents  INTEGER NOT NULL DEFAULT 0,
  margin_cents     INTEGER NOT NULL DEFAULT 0,
  currency         TEXT NOT NULL DEFAULT 'USD',
  period           TEXT NOT NULL,             -- YYYY-MM
  recorded_at      TEXT NOT NULL DEFAULT (datetime('now'))
);

CREATE INDEX IF NOT EXISTS idx_reseller_ledger_parent_period ON reseller_ledger(parent_tenant_id, period);
CREATE INDEX IF NOT EXISTS idx_reseller_ledger_child ON reseller_ledger(child_tenant_id);
</file>

<file path="infra/migrations/0034_space_hierarchy.sql">
-- Space hierarchy + tenancy topology (spec G-Y15 CRITICAL "Tenancy Model Not a
-- First-Class Configurable Dimension", G-Y16 "Per-End-User Isolation", §49 Sub-Space
-- Architecture). Tenancy is the data-topology contract a builder picks per product:
--
--   single  — one owner, one SpaceDO.
--   team    — one shared SpaceDO; sub-spaces (departments) live inside it, isolated by
--             space_id in the SpaceDO `spaces` registry. Shared members.
--   saas    — product root + per-end-user isolation: each customer business is its OWN
--             D1 spaces row under its OWN child tenant with its OWN SpaceDO (structural
--             isolation, not a WHERE clause). Linked to the parent product via
--             parent_space_id here and via tenant_hierarchy (reseller subsystem).
--
-- These columns sit on the platform `spaces` table so the reseller portfolio, the
-- promote-to-product flow, and cross-product hierarchy queries can run in D1 without
-- opening every SpaceDO. Department-level (depth 2) hierarchy lives inside the SpaceDO
-- `spaces` registry (migration v10), not here.

ALTER TABLE spaces ADD COLUMN parent_space_id TEXT;
ALTER TABLE spaces ADD COLUMN depth INTEGER NOT NULL DEFAULT 0;
ALTER TABLE spaces ADD COLUMN tenancy_mode TEXT NOT NULL DEFAULT 'team'
  CHECK (tenancy_mode IN ('single','team','saas'));
ALTER TABLE spaces ADD COLUMN agency_shell INTEGER NOT NULL DEFAULT 0;
-- organizational = same-type departments; agency-child = mixed-type client space;
-- user-workspace = end-user-created business in a saas/hybrid product.
ALTER TABLE spaces ADD COLUMN scenario_type TEXT
  CHECK (scenario_type IN ('organizational','agency-child','user-workspace'));

CREATE INDEX IF NOT EXISTS idx_spaces_parent ON spaces(parent_space_id);
</file>

<file path="infra/migrations/0035_commerce.sql">
-- Commerce primitive (spec §11 Launchpad: "Owner uploads products and sets prices").
--
-- Generic + manifest-gated, NOT hardcoded to Launchpad: any SpaceType whose manifest sets
-- productConfig.commerce.enabled = true gets product/order tables keyed by space_id. A
-- SpaceType that does not opt in simply never writes here. Money-in is reserved to Naelao's
-- Lemon Squeezy store (the prebuilt commerce script) so the platform fee always applies —
-- naelao_fee_bps records the basis-points fee captured per order.

-- A digital product the owner sells (course, ebook, template, subscription tier, …).
CREATE TABLE IF NOT EXISTS launchpad_products (
  id            TEXT PRIMARY KEY,
  space_id      TEXT NOT NULL,
  tenant_id     TEXT NOT NULL,
  name          TEXT NOT NULL,
  description   TEXT NOT NULL DEFAULT '',
  -- Price in minor units (cents). 0 = free / lead magnet.
  price_cents   INTEGER NOT NULL DEFAULT 0,
  currency      TEXT NOT NULL DEFAULT 'USD',
  -- 'one_time' | 'subscription'. Subscriptions map to a Lemon Squeezy variant.
  kind          TEXT NOT NULL DEFAULT 'one_time'
    CHECK (kind IN ('one_time','subscription')),
  -- R2 key of the deliverable (the fulfilment agent reads this to deliver the product).
  fulfillment_r2_key TEXT,
  -- Lemon Squeezy variant id this product maps to in Naelao's store (set when published).
  ls_variant_id TEXT,
  status        TEXT NOT NULL DEFAULT 'draft'
    CHECK (status IN ('draft','published','archived')),
  created_at    TEXT NOT NULL DEFAULT (datetime('now')),
  updated_at    TEXT NOT NULL DEFAULT (datetime('now'))
);
CREATE INDEX IF NOT EXISTS idx_products_space ON launchpad_products(space_id, status);

-- A customer order. Written by the Lemon Squeezy webhook on payment.success, then the
-- fulfilment agent is woken to deliver. Fee + net are computed at write time.
CREATE TABLE IF NOT EXISTS launchpad_orders (
  id               TEXT PRIMARY KEY,
  space_id         TEXT NOT NULL,
  tenant_id        TEXT NOT NULL,
  product_id       TEXT,
  customer_email   TEXT,
  customer_name    TEXT,
  -- Gross the customer paid (cents) and the platform fee Naelao captured.
  gross_cents      INTEGER NOT NULL DEFAULT 0,
  fee_cents        INTEGER NOT NULL DEFAULT 0,
  net_cents        INTEGER NOT NULL DEFAULT 0,
  currency         TEXT NOT NULL DEFAULT 'USD',
  -- Provider order/subscription identifiers (Lemon Squeezy).
  ls_order_id      TEXT,
  ls_subscription_id TEXT,
  status           TEXT NOT NULL DEFAULT 'paid'
    CHECK (status IN ('paid','fulfilling','fulfilled','refunded','failed')),
  -- Idempotency: a provider event id we have already processed (dedupe webhook retries).
  provider_event_id TEXT,
  created_at       TEXT NOT NULL DEFAULT (datetime('now')),
  updated_at       TEXT NOT NULL DEFAULT (datetime('now'))
);
CREATE INDEX IF NOT EXISTS idx_orders_space ON launchpad_orders(space_id, created_at DESC);
CREATE UNIQUE INDEX IF NOT EXISTS idx_orders_provider_event
  ON launchpad_orders(provider_event_id) WHERE provider_event_id IS NOT NULL;

-- Provisioned business services (storefront, business email, custom domain). One row per
-- (space_id, kind). Written by the prebuilt business scripts; reflects on billing.
CREATE TABLE IF NOT EXISTS business_services (
  id           TEXT PRIMARY KEY,
  space_id     TEXT NOT NULL,
  tenant_id    TEXT NOT NULL,
  kind         TEXT NOT NULL
    CHECK (kind IN ('storefront','business_email','custom_domain')),
  -- Naelao-provided hostname/address (e.g. {slug}.naelao.com, hi@{slug}.naelao-mail.com).
  naelao_handle TEXT,
  -- Customer's own domain when they opt into custom_domain (Cloudflare for SaaS hostname).
  custom_domain TEXT,
  -- Cloudflare for SaaS custom_hostname id (when custom_domain is provisioned).
  cf_hostname_id TEXT,
  config_json  TEXT NOT NULL DEFAULT '{}',
  status       TEXT NOT NULL DEFAULT 'active'
    CHECK (status IN ('provisioning','active','pending_dns','suspended','deleted')),
  created_at   TEXT NOT NULL DEFAULT (datetime('now')),
  updated_at   TEXT NOT NULL DEFAULT (datetime('now'))
);
CREATE UNIQUE INDEX IF NOT EXISTS idx_bizsvc_space_kind ON business_services(space_id, kind);
</file>

<file path="infra/migrations/0036_ls_product_id.sql">
-- Auto-create-variant-on-publish: store the LS product id alongside the variant id.
-- ls_variant_id was already present (0035); add ls_product_id for reverse lookup.
ALTER TABLE launchpad_products ADD COLUMN ls_product_id TEXT;
</file>

<file path="infra/migrations/0037_mcp_servers_auth.sql">
-- Connector layer: reconcile mcp_servers with the mcp-hub worker.
--
-- The hub code reads auth_type + auth_secret_name (a reference to a space_credentials NAME),
-- but 0012 never defined them — the hub would throw at runtime. Add the columns. The secret is
-- NEVER stored here; auth_secret_name points at the encrypted vault (space_credentials), which
-- the hub resolves through the credentials worker at call time so the agent never sees it.
ALTER TABLE mcp_servers ADD COLUMN auth_type TEXT NOT NULL DEFAULT 'none';
ALTER TABLE mcp_servers ADD COLUMN auth_secret_name TEXT;
</file>

<file path="infra/migrations/0038_channel_links.sql">
-- Multi-channel gateway: which spaces have which channels configured. Discovery roster for
-- the heartbeat cron sweep (mirrors the mcp_servers join the connector poller uses) — the
-- channel's signing secret itself lives in the encrypted credentials vault, never here.
CREATE TABLE IF NOT EXISTS channel_links (
  space_id   TEXT NOT NULL,
  tenant_id  TEXT NOT NULL,
  channel    TEXT NOT NULL, -- 'slack' | 'discord' | 'email'
  enabled    INTEGER NOT NULL DEFAULT 1,
  created_at TEXT NOT NULL DEFAULT (datetime('now')),
  PRIMARY KEY (space_id, channel)
);
CREATE INDEX IF NOT EXISTS idx_channel_links_enabled ON channel_links(enabled, channel);
</file>

<file path="infra/migrations/0039_channel_links_project.sql">
-- Customer-bot projects: a channel can be bound to a specific project (e.g. a "WhatsApp
-- Support Bot" project) instead of just the space's default agent. NULL = legacy behavior
-- (space-level, the default agent handles it — backward compatible with 0038).
ALTER TABLE channel_links ADD COLUMN project_id TEXT;
CREATE INDEX IF NOT EXISTS idx_channel_links_project ON channel_links(project_id) WHERE project_id IS NOT NULL;
</file>

<file path="infra/migrations/0040_space_credentials.sql">
-- space_credentials: the encrypted credential vault the naelao-credentials worker reads/writes.
-- G-C01/G-AH07 described this table but no migration ever created it — the worker would throw
-- at runtime against a real D1. Created here WITH the credential hierarchy (CLAUDE.md open
-- follow-up) built in from the start rather than retrofitted:
--
--   per-user (default)  — scope='user', user_id=<owner>. A member's own connected credential
--                          (e.g. their personal email/OAuth token) for a given name.
--   per-space (shared)  — scope='space', user_id=NULL. The space-wide default (e.g. a shared
--                          company email) used when the acting user has no personal credential.
--   privileged override — scope='space' with is_override=1. Settable only by owner/admin
--                          (enforced by the worker, not the DB). When set, this ALWAYS wins
--                          over a member's personal credential of the same name — an admin can
--                          force everyone onto one company-managed credential.
--
-- Resolution order (see workers/credentials/src/index.ts resolveCredential()):
--   1. space-scope row with is_override=1        (privileged override — always wins)
--   2. user-scope row for the acting user         (personal, default)
--   3. space-scope row with is_override=0         (shared fallback)
CREATE TABLE IF NOT EXISTS space_credentials (
  id              TEXT PRIMARY KEY,
  space_id        TEXT NOT NULL,
  tenant_id       TEXT NOT NULL,
  name            TEXT NOT NULL,
  scope           TEXT NOT NULL DEFAULT 'space' CHECK (scope IN ('user', 'space')),
  -- NULL for scope='space'; the owning member's user id for scope='user'.
  user_id         TEXT,
  -- Only meaningful (and only settable by a privileged caller) on scope='space' rows.
  is_override     INTEGER NOT NULL DEFAULT 0,
  encrypted_value TEXT NOT NULL,
  iv              TEXT NOT NULL,
  key_version     TEXT NOT NULL DEFAULT 'v1',
  description     TEXT,
  created_by      TEXT,
  created_at      TEXT NOT NULL DEFAULT (datetime('now')),
  updated_at      TEXT NOT NULL DEFAULT (datetime('now'))
);

-- At most one user-scoped credential per (space, name, user).
CREATE UNIQUE INDEX IF NOT EXISTS idx_space_credentials_user
  ON space_credentials(space_id, name, user_id) WHERE scope = 'user';

-- At most one space-scoped credential per (space, name) — the shared default or its override,
-- never both (an override IS the space-level row; is_override just changes how it resolves).
CREATE UNIQUE INDEX IF NOT EXISTS idx_space_credentials_space
  ON space_credentials(space_id, name) WHERE scope = 'space';

CREATE INDEX IF NOT EXISTS idx_space_credentials_tenant ON space_credentials(tenant_id);
CREATE INDEX IF NOT EXISTS idx_space_credentials_user_lookup ON space_credentials(space_id, user_id) WHERE scope = 'user';
</file>

<file path="infra/migrations/0041_scheduled_jobs.sql">
-- Time-based scheduling (spec §05 "cron-jobs.json — the assistant's schedule of recurring
-- tasks"), the no-code-configurable equivalent for a builder: "every day at 9am, run this
-- script." Complements event_triggers (SpaceDO, event-driven: thread.created/project.created/
-- ...) with a TIME-driven trigger. Lives in PLATFORM_DB (not SpaceDO SQLite) for the same
-- reason channel_links does: the hourly dispatcher needs one cheap cross-space query to find
-- everything due, rather than waking every space's SpaceDO just to ask "do you have anything
-- due" (see runScheduledJobs, workers/agents/src/index.ts).
CREATE TABLE IF NOT EXISTS scheduled_jobs (
  id              TEXT PRIMARY KEY,
  space_id        TEXT NOT NULL,
  tenant_id       TEXT NOT NULL,
  project_id      TEXT, -- NULL = space-wide (fires against the Space Assistant's workspace)
  name            TEXT NOT NULL,
  cron_expression TEXT NOT NULL, -- 5-field ("minute hour day-of-month month day-of-week"), UTC
  script_name     TEXT NOT NULL, -- the script.run action fired on schedule
  params          TEXT NOT NULL DEFAULT '{}', -- JSON, passed to the fired script
  enabled         INTEGER NOT NULL DEFAULT 1,
  last_run_at     INTEGER, -- unix ms; NULL = never run (dispatcher floors the isCronDue scan
                            -- at created_at instead, see infra/migrations/0042's changelog)
  created_at      TEXT NOT NULL DEFAULT (datetime('now')),
  updated_at      TEXT NOT NULL DEFAULT (datetime('now'))
);
CREATE INDEX IF NOT EXISTS idx_scheduled_jobs_dispatch ON scheduled_jobs(enabled);
CREATE INDEX IF NOT EXISTS idx_scheduled_jobs_space ON scheduled_jobs(space_id);
</file>

<file path="infra/migrations/0042_scheduled_jobs_failures.sql">
-- Failure tracking for scheduled_jobs (0041) — a job whose script 404s/500s used to refire
-- every hour forever, because last_run_at was only ever written on success (the same due
-- minute got re-attempted on every sweep). consecutive_failures + last_error let the
-- dispatcher (workers/agents/src/index.ts runScheduledJobs) record a failed attempt as
-- "consumed" (still advances last_run_at) and auto-disable after repeated failures instead of
-- retrying forever.
ALTER TABLE scheduled_jobs ADD COLUMN consecutive_failures INTEGER NOT NULL DEFAULT 0;
ALTER TABLE scheduled_jobs ADD COLUMN last_error TEXT;

-- The dispatch query filters enabled=1 AND joins spaces on space_id — a single-column index
-- on `enabled` alone was never a useful index for that access pattern.
DROP INDEX IF EXISTS idx_scheduled_jobs_dispatch;
CREATE INDEX IF NOT EXISTS idx_scheduled_jobs_dispatch ON scheduled_jobs(enabled, space_id);
</file>

<file path="infra/migrations/0043_scheduled_jobs_agent_goal.sql">
-- F: Launchpad core agents (spec §11) are installed as R2 configs by the provisioner but
-- nothing ever reads LaunchpadAgentDefinition.trigger — every dispatcher hardcodes
-- "naelao-agent", so the Content agent's `cron: "0 9 * * *"` schedule trigger never actually
-- runs the specialist. scheduled_jobs (0041) only supported firing a named prebuilt script
-- op DIRECTLY (fireScriptDirectly/handleTriggerFire — no reasoner, no OBSERVE/FIND/GATE loop,
-- by design, same as event_triggers), which can't "draft this week's content" — that needs a
-- real reasoning session. Two nullable columns add a second, opt-in dispatch mode without
-- touching the existing script_name behavior any existing row relies on:
--   agent_id  — which agent's own R2 config (system prompt, approval gates, prebuilt scripts)
--               to wake. NULL keeps today's implicit "naelao-agent" default.
--   goal      — when set, the dispatcher (workers/agents/src/index.ts handleAgentTick) wakes
--               the FULL reasoning loop (POST .../script/run) with this goal instead of firing
--               script_name directly. NULL preserves the exact pre-existing direct-fire path.
-- A row has exactly one of script_name or goal meaningful for firing; the app layer enforces
-- "at least one of the two" at write time (see workers/spaces/src/index.ts). script_name stays
-- NOT NULL (0041) — a goal-based row stores '' there (SQLite can't drop a NOT NULL constraint
-- without a full table rebuild, and '' is an unambiguous "no direct script" sentinel the app
-- layer checks for, same pattern as project_id NULL meaning "space-wide").
ALTER TABLE scheduled_jobs ADD COLUMN agent_id TEXT;
ALTER TABLE scheduled_jobs ADD COLUMN goal TEXT;
</file>

<file path="infra/migrations/0044_naelao_product.sql">
-- Three-Tier Platform Model (spec "Three-Tier Platform Model" / "How Builders Use Naelao"),
-- Phase 1 (docs/spec-appendix/A1-script-agents-and-space-assistants.md §A1.17).
--
-- Only two genuinely new, cross-space-queryable concerns get real columns here — NOT the full
-- ~20-field NaelaoProduct list the spec describes verbatim, because most of those fields
-- already have a home: SpaceTypeProductConfig (workers/spaces/src/do/SpaceTypeRegistryDO.ts),
-- stored as a config_json.productConfig override on the space row exactly like member billing
-- (CLAUDE.md #17) and assistant policy (#20) already do. Adding new flat columns for those would
-- create the split-brain this migration exists to avoid — e.g. a `product_domain` column here
-- would duplicate the `business_services` table, which already tracks storefront/custom-domain
-- identity end-to-end (CLAUDE.md #16).
--
-- product_slug: the platform-subdomain identity a builder picks for their product
-- ({slug}.naelao.app) at launch time. Genuinely new — no existing table tracks this — and needs
-- a platform-wide uniqueness check the launch wizard runs before allowing signup, so it must be
-- a real indexed column, not buried in JSON.
--
-- conversation_access_approved_by / _at: the spec's legally-gated conversation-log-access
-- approval (a Naelao platform-admin must manually review and approve before a builder can read
-- ANY end-user conversation, even metadata-only). Naelao staff need to query this across every
-- space for the platform-wide approval queue (spec Surface 1) — an audit field, not a
-- builder-editable config value, so it does not belong in config_json.

ALTER TABLE spaces ADD COLUMN product_slug TEXT;
ALTER TABLE spaces ADD COLUMN conversation_access_approved_by TEXT;
ALTER TABLE spaces ADD COLUMN conversation_access_approved_at TEXT;

CREATE UNIQUE INDEX IF NOT EXISTS idx_spaces_product_slug ON spaces(product_slug)
  WHERE product_slug IS NOT NULL;
</file>

<file path="infra/migrations/0045_builder_dashboard_api.sql">
-- Three-Tier Platform Model, Phase 3 (docs/spec-appendix A1.17): the Builder Dashboard API.
--
-- builder_api_key_index: a bare "Authorization: Bearer nbk_..." key carries no tenant hint, but
-- BuilderAccountDO is HMAC-addressed BY tenantId — so a request arriving with only a raw key has
-- no way to know which BuilderAccountDO instance to ask. This table is PURE ROUTING information
-- (key_hash -> tenant_id), not a second source of truth: the actual validity/expiry/revocation/
-- scopes decision is always re-verified against the authoritative BuilderAccountDO.api_keys row
-- (POST /api-keys/verify). A stale index row (key later revoked) is harmless — it only causes one
-- extra DO round-trip that then correctly reports invalid, never a false grant.
CREATE TABLE IF NOT EXISTS builder_api_key_index (
  key_hash   TEXT PRIMARY KEY,
  tenant_id  TEXT NOT NULL,
  key_id     TEXT NOT NULL,
  created_at TEXT NOT NULL DEFAULT (datetime('now'))
);
CREATE INDEX IF NOT EXISTS idx_builder_api_key_index_tenant ON builder_api_key_index(tenant_id);

-- product_end_users: the enumerable roster of a product's end users. Deliberately NOT the same
-- table as SpaceDO's internal space_members (that's platform-user Team collaborators, a
-- structurally different population — CLAUDE.md #23's Bucket A/B split) and NOT the legacy D1
-- space_members from the retired Whop-niche BusinessDO (migration 0021). ProductUserDO instances
-- (Phase 2) hold the actual per-user state (credits/sessions/prefs) but aren't bulk-enumerable —
-- this table is the roster index a builder's Users tab lists from. Populated starting Phase 6
-- (end-user session creation); the schema + read/suspend contract belongs here since it's part
-- of the Builder Dashboard API surface.
CREATE TABLE IF NOT EXISTS product_end_users (
  product_space_id TEXT NOT NULL,
  end_user_id      TEXT NOT NULL,
  email            TEXT,
  display_name     TEXT,
  first_seen_at    TEXT NOT NULL DEFAULT (datetime('now')),
  last_seen_at     TEXT,
  -- Consent for the builder to read this user's conversation metadata (one leg of the
  -- conversation-access triple-gate below) — distinct from feature-flag/staff-approval legs.
  consented_at     TEXT,
  suspended_at     TEXT,
  PRIMARY KEY (product_space_id, end_user_id)
);
CREATE INDEX IF NOT EXISTS idx_product_end_users_product ON product_end_users(product_space_id);

-- conversation_access_audit: append-only. Written every time a builder successfully reads an end
-- user's conversation metadata through the gated endpoint — never on a denied attempt (nothing to
-- audit if nothing was disclosed). No UPDATE/DELETE path is ever wired to this table.
CREATE TABLE IF NOT EXISTS conversation_access_audit (
  id               TEXT PRIMARY KEY,
  product_space_id TEXT NOT NULL,
  end_user_id      TEXT NOT NULL,
  accessed_by      TEXT NOT NULL, -- the builder-side actor (tenant/user id) who read it
  accessed_at      TEXT NOT NULL DEFAULT (datetime('now')),
  purpose          TEXT
);
CREATE INDEX IF NOT EXISTS idx_conversation_access_audit_product ON conversation_access_audit(product_space_id);

-- product_webhooks: a builder's own webhook endpoints for product lifecycle events (order
-- placed, user suspended, etc). Deliberately a small dedicated table, not folded into
-- config_json — webhooks are operational plumbing a builder adds/removes frequently, not
-- product configuration a builder edits rarely (same reasoning as keeping api_keys off
-- config_json in Phase 1).
CREATE TABLE IF NOT EXISTS product_webhooks (
  id               TEXT PRIMARY KEY,
  product_space_id TEXT NOT NULL,
  url              TEXT NOT NULL,
  event_types_json TEXT NOT NULL DEFAULT '[]',
  created_at       TEXT NOT NULL DEFAULT (datetime('now'))
);
CREATE INDEX IF NOT EXISTS idx_product_webhooks_product ON product_webhooks(product_space_id);
</file>

<file path="infra/migrations/0046_product_end_user_credentials.sql">
-- Three-Tier Platform Model, Phase 6: naelao-native end-user authentication (Journey 1B — "End
-- user signs up or is invited via the builder's configured auth provider"). ProductUserDO
-- (Phase 2) mints and verifies SESSIONS but never verified an identity in the first place — for
-- authProvider: 'naelao-native' specifically, Naelao itself must hold the credential (email +
-- password) an end user signs up with. This is NOT the same thing as a platform user's row (the
-- `users` table, migration 0001) — end users are scoped entirely to the product they joined, per
-- the spec's Tier 2 definition ("Their identity... are all scoped to the product... not to
-- Naelao"). Extends the existing product_end_users roster (migration 0045) rather than forking a
-- parallel table, since a credential is just another fact about the SAME roster row.
--
-- Other authProvider values (clerk / custom-oidc / saml-sso) verify identity externally and never
-- populate password_hash — this column is null for them; the signup/login routes below only ever
-- apply to the naelao-native path (see product-end-user-routes.ts).
ALTER TABLE product_end_users ADD COLUMN password_hash TEXT;

-- A product's own login is keyed by (product_space_id, email) — the same email can sign up for
-- unrelated products independently (Tier 2 identities never share across products, per spec).
CREATE UNIQUE INDEX IF NOT EXISTS idx_product_end_users_login
  ON product_end_users(product_space_id, email) WHERE email IS NOT NULL;
</file>

<file path="infra/migrations/0047_business_memberships.sql">
-- Three-Tier Platform Model, Phase C (docs/spec-appendix A1.17): the membership index that
-- backs the Product Shell's space switcher and requireBusinessMembership's real per-business role
-- (Phase B shipped that gate treating every product_end_user as a flat "member" since no
-- businesses existed yet — this table is what makes the role real).
--
-- business_memberships is a ROUTING/INDEX table, like builder_api_key_index (migration 0045) —
-- NOT a second source of truth. SpaceDO's own `space_members` table stays authoritative for
-- actual in-space authorization; this index exists because answering "which businesses does this
-- end user belong to" (the space switcher) would otherwise require opening every SpaceDO in the
-- product to check membership, which doesn't scale. Dual-write on every join/invite-accept;
-- if this index and space_members ever disagree, space_members wins for anything security-critical
-- (a stale index row can widen a switcher listing but requireBusinessMembership's callers always
-- re-derive role from THIS table only for the coarse floor check — fine-grained per-space
-- authorization inside a business still goes through that business's own SpaceDO).
CREATE TABLE IF NOT EXISTS business_memberships (
  business_space_id TEXT NOT NULL,
  product_space_id  TEXT NOT NULL,
  end_user_id       TEXT NOT NULL,
  role              TEXT NOT NULL DEFAULT 'member' CHECK (role IN ('member', 'admin', 'owner')),
  status            TEXT NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'suspended')),
  invited_by        TEXT,
  joined_at         TEXT NOT NULL DEFAULT (datetime('now')),
  PRIMARY KEY (business_space_id, end_user_id)
);
CREATE INDEX IF NOT EXISTS idx_business_memberships_end_user ON business_memberships(product_space_id, end_user_id);
CREATE INDEX IF NOT EXISTS idx_business_memberships_business ON business_memberships(business_space_id);

-- business_invites: a single-use, expiring, hashed invite token (the token itself is never
-- stored — only its hash, same precedent as PBKDF2 password storage elsewhere in this codebase).
-- accepted_at/accepted_by are set exactly once; an already-accepted or expired token can never be
-- redeemed again.
CREATE TABLE IF NOT EXISTS business_invites (
  id                TEXT PRIMARY KEY,
  business_space_id TEXT NOT NULL,
  product_space_id  TEXT NOT NULL,
  email             TEXT NOT NULL,
  role              TEXT NOT NULL DEFAULT 'member' CHECK (role IN ('member', 'admin', 'owner')),
  token_hash        TEXT NOT NULL,
  invited_by        TEXT NOT NULL,
  created_at        TEXT NOT NULL DEFAULT (datetime('now')),
  expires_at        TEXT NOT NULL,
  accepted_at       TEXT,
  accepted_by       TEXT
);
CREATE INDEX IF NOT EXISTS idx_business_invites_token ON business_invites(token_hash);
CREATE INDEX IF NOT EXISTS idx_business_invites_business ON business_invites(business_space_id);
</file>

<file path="infra/migrations/0048_admin_schema_fixes.sql">
-- Fixes a migration-history bug found while reconciling @naelao/entitlements (Phase E
-- precondition): 0022_api_key_scopes.sql's `CREATE TABLE IF NOT EXISTS api_keys` was a no-op
-- (the table already existed from 0004_billing.sql with org_id/scopes columns, not
-- tenant_id/scopes_json), so its own `CREATE INDEX ... ON api_keys (tenant_id, revoked_at)`
-- has been failing against the real schema in every environment since (deploy workflows run
-- migrations with `|| true`, so this failed silently rather than blocking deploys). Nothing in
-- the codebase reads scopes_json or these index names, so this recreates the intended indexes
-- against the columns that actually exist rather than resurrecting the abandoned scopes_json
-- column (real API key scoping now lives on BuilderAccountDO's own per-DO SQLite, unrelated to
-- this D1 table).
-- Distinct names from 0004_billing.sql's idx_api_keys_org(org_id) / idx_api_keys_hash(key_hash)
-- — CREATE INDEX IF NOT EXISTS only checks the index NAME, so reusing either would have silently
-- no-op'd instead of creating the composite/prefix indexes actually intended here.
CREATE INDEX IF NOT EXISTS idx_api_keys_org_revoked ON api_keys (org_id, revoked_at);
CREATE INDEX IF NOT EXISTS idx_api_keys_prefix ON api_keys (key_prefix);

-- workers/admin's PATCH /admin/tenants/:id sets updated_at on orgs, but 0002_orgs.sql never gave
-- orgs that column (only created_at) — every admin plan/status update would have failed with
-- "no such column: updated_at". Added for real, matching the created_at pattern every other
-- platform table already follows (spaces, spacetypes, etc).
ALTER TABLE orgs ADD COLUMN updated_at TEXT;
</file>

<file path="infra/migrations/0049_business_subscriptions.sql">
-- Phase E (§A1.17): tracks the state of a business's subscription to one of its product's
-- builder-defined plans (productConfig.pricingConfig.plans). Keyed by business_space_id — a
-- business as a whole subscribes (mirroring memberBilling's "the whole space pays" shape), not
-- an individual end user. One row per business; upserted on every Lemon Squeezy
-- subscription_created/updated/cancelled webhook (unique on ls_subscription_id so a webhook
-- retry re-sets the same row instead of creating a duplicate).
CREATE TABLE IF NOT EXISTS business_subscriptions (
  id                  TEXT PRIMARY KEY,
  business_space_id   TEXT NOT NULL,
  product_space_id    TEXT NOT NULL,
  plan_id             TEXT NOT NULL,
  status              TEXT NOT NULL DEFAULT 'active'
    CHECK (status IN ('active', 'past_due', 'paused', 'cancelled', 'expired')),
  ls_subscription_id  TEXT,
  ls_customer_id      TEXT,
  current_period_end  TEXT,
  created_at          TEXT NOT NULL DEFAULT (datetime('now')),
  updated_at          TEXT NOT NULL DEFAULT (datetime('now'))
);

-- A business has at most one row (its current plan) — re-subscribing/switching plans updates it
-- rather than accumulating history; the reseller_ledger is the historical revenue record.
CREATE UNIQUE INDEX IF NOT EXISTS idx_business_subscriptions_space ON business_subscriptions(business_space_id);
CREATE UNIQUE INDEX IF NOT EXISTS idx_business_subscriptions_ls_sub ON business_subscriptions(ls_subscription_id) WHERE ls_subscription_id IS NOT NULL;
CREATE INDEX IF NOT EXISTS idx_business_subscriptions_product ON business_subscriptions(product_space_id);
</file>

<file path="infra/migrations/0050_webhook_idempotency.sql">
-- S0.3: webhook exactly-once processing (P0 money-integrity fix).
--
-- Before this migration, handleLemonSqueezyWebhook had no top-level idempotency gate: a Lemon
-- Squeezy retry (any non-2xx response or timeout triggers one) would re-run the ENTIRE handler,
-- including reseller_ledger writes (no unique constraint at all — a plain INSERT with a random
-- id, so every retry inserted a second row and double-counted the wholesale invoice) and
-- wakeAgent (re-running "fulfil + send confirmation + provision access" → duplicate welcome
-- emails / entitlement grants). launchpad_orders already had its own provider_event_id unique
-- index, but the KEY fed into it was a synthetic ${type}:${customerId}:${gross}:${productId}
-- string (packages/billing-core's LS provider discarded the real event.data.id), so two genuinely
-- distinct same-price purchases collided and the second was silently dropped.
--
-- This migration adds ONE processed-events table that gates the WHOLE handler (checked first,
-- before reseller attribution / order recording / wakeAgent), plus a real unique constraint on
-- reseller_ledger keyed on the actual provider event id (now correctly threaded through from
-- event.data.id instead of the discarded/synthetic key).

CREATE TABLE IF NOT EXISTS processed_webhook_events (
  provider     TEXT NOT NULL,
  event_id     TEXT NOT NULL,
  event_type   TEXT NOT NULL DEFAULT '',
  processed_at TEXT NOT NULL DEFAULT (datetime('now')),
  PRIMARY KEY (provider, event_id)
);

ALTER TABLE reseller_ledger ADD COLUMN provider_event_id TEXT;

-- Partial (nullable-safe) unique index — every real event carries a provider_event_id after this
-- pass; NULL is only possible for rows written before this migration, which must remain distinct.
CREATE UNIQUE INDEX IF NOT EXISTS idx_reseller_ledger_provider_event
  ON reseller_ledger(provider_event_id) WHERE provider_event_id IS NOT NULL;
</file>

<file path="infra/migrations/0051_kb_documents_project.sql">
-- WS-4: per-project knowledge base (spec A1.16.20). kb_documents was space-scoped only — a
-- customer-service bot project could not carry its own document KB isolated from the rest of
-- the space. NULL = space-wide (the pre-existing default, unchanged for every existing row).
ALTER TABLE kb_documents ADD COLUMN project_id TEXT;
CREATE INDEX IF NOT EXISTS idx_kb_docs_project ON kb_documents(project_id) WHERE project_id IS NOT NULL;
</file>

<file path="infra/migrations/0052_webhook_idempotency_event_type.sql">
-- P0-5 follow-on: fixes a real, independent bug found while building the storefront-sale wallet
-- settlement + refund clawback.
--
-- processed_webhook_events (0050_webhook_idempotency.sql) dedupes on (provider, event_id) alone.
-- Lemon Squeezy's own `data.id` is the underlying RESOURCE's id, not a per-delivery event id: an
-- `order_refunded` webhook for an order carries the SAME `data.id` as the original `order_created`
-- webhook for that same order, and every subscription lifecycle event (created / updated /
-- cancelled / paused / resumed / payment_success / payment_failed / payment_recovered) for one
-- subscription all share that subscription's own resource id too. With only (provider, event_id)
-- unique, the FIRST event ever seen for a given order/subscription "claims" that id forever — every
-- later, genuinely different event for the same resource is treated as a duplicate delivery of the
-- first one and silently no-op'd before any side effect runs. In practice this meant: a refund was
-- never actually processed once the original sale had been recorded, and a subscription's status
-- changes / repeat renewal payments after the first webhook were silently dropped too.
--
-- Fix: the uniqueness constraint must include event_type, since (provider, event_id, event_type)
-- is what's actually guaranteed unique per delivery — a genuine retry of the SAME webhook always
-- resends the SAME event_type for the SAME resource id, while a later, different lifecycle event
-- for that resource now correctly gets its own row. SQLite can't ALTER a PRIMARY KEY in place, so
-- this recreates the table.
CREATE TABLE processed_webhook_events_v2 (
  provider     TEXT NOT NULL,
  event_id     TEXT NOT NULL,
  event_type   TEXT NOT NULL DEFAULT '',
  processed_at TEXT NOT NULL DEFAULT (datetime('now')),
  PRIMARY KEY (provider, event_id, event_type)
);

INSERT INTO processed_webhook_events_v2 (provider, event_id, event_type, processed_at)
  SELECT provider, event_id, event_type, processed_at FROM processed_webhook_events;

DROP TABLE processed_webhook_events;
ALTER TABLE processed_webhook_events_v2 RENAME TO processed_webhook_events;
</file>

<file path="infra/migrations/0053_payout_requests.sql">
-- Go-live monetization pass: a builder's cut of reseller_ledger.margin_cents (business
-- subscriptions, product orders, seat activations, revenue-cut surcharges — every payer class
-- already attributed there) sat in the ledger with no way to actually get PAID it. reseller_ledger
-- stays a pure append-only revenue record (unchanged); this is a separate withdrawal-request
-- ledger a builder draws against it.
--
-- v1 is manual-fulfillment by design (per the platform's own money-movement decision): Lemon
-- Squeezy is a merchant-of-record with single-account custody and no Stripe-Connect-style
-- split-payment primitive, so there is no automated payout API to wire yet. A request here is
-- fulfilled by a real bank transfer + an ops action marking it paid — the same "ship the backend
-- for real, automate later" precedent as every other manual-fulfillment step in this build.
CREATE TABLE IF NOT EXISTS payout_requests (
  id                TEXT PRIMARY KEY,
  tenant_id         TEXT NOT NULL,
  requested_by      TEXT,             -- user id of the builder who requested it
  amount_cents      INTEGER NOT NULL CHECK (amount_cents > 0),
  currency          TEXT NOT NULL DEFAULT 'USD',
  status            TEXT NOT NULL DEFAULT 'pending'
    CHECK (status IN ('pending', 'paid', 'rejected')),
  requested_at      TEXT NOT NULL DEFAULT (datetime('now')),
  fulfilled_at      TEXT,
  fulfilled_by      TEXT,             -- ops identity that marked it paid/rejected
  notes             TEXT
);

CREATE INDEX IF NOT EXISTS idx_payout_requests_tenant ON payout_requests(tenant_id, requested_at DESC);
CREATE INDEX IF NOT EXISTS idx_payout_requests_status ON payout_requests(status);
</file>

<file path="infra/migrations/0054_password_reset_tokens.sql">
-- Security audit follow-up: neither end users nor builders had any account-recovery path.
-- product_end_users authenticates with a naelao-native email+password (migration 0046) with no
-- way to recover from a lost password other than losing the account. Same hashed-token,
-- single-use, expiring pattern as business_invites (migration 0047) — the token itself is never
-- stored, only its hash, so a leaked D1 row can't be replayed as a live reset link.
CREATE TABLE IF NOT EXISTS password_reset_tokens (
  id                TEXT PRIMARY KEY,
  product_space_id  TEXT NOT NULL,
  end_user_id       TEXT NOT NULL,
  token_hash        TEXT NOT NULL,
  created_at        TEXT NOT NULL DEFAULT (datetime('now')),
  expires_at        TEXT NOT NULL,
  used_at           TEXT
);
CREATE INDEX IF NOT EXISTS idx_password_reset_tokens_hash ON password_reset_tokens(token_hash);
CREATE INDEX IF NOT EXISTS idx_password_reset_tokens_user ON password_reset_tokens(product_space_id, end_user_id);
</file>

<file path="infra/migrations/0055_email_verification.sql">
-- Security audit follow-up: signup had no email verification, so the pre-auth rate limiter
-- (migration-adjacent router fix) bounds free-credit farming per-IP but doesn't eliminate it —
-- a slow/distributed farmer can still mint accounts. Gate the FREE_TIER_DEFAULT_SIGNUP_CREDITS
-- grant (and any configured creditsIncludedPerMonth) behind a real verified inbox: the account
-- and session are usable immediately at signup (so a legitimate user isn't blocked), but the
-- credit grant itself moves to email verification. Same hashed/single-use/expiring token shape
-- as password_reset_tokens (migration 0054) and business_invites (migration 0047).
ALTER TABLE product_end_users ADD COLUMN email_verified_at TEXT;

CREATE TABLE IF NOT EXISTS email_verification_tokens (
  id                TEXT PRIMARY KEY,
  product_space_id  TEXT NOT NULL,
  end_user_id       TEXT NOT NULL,
  token_hash        TEXT NOT NULL,
  created_at        TEXT NOT NULL DEFAULT (datetime('now')),
  expires_at        TEXT NOT NULL,
  used_at           TEXT
);
CREATE INDEX IF NOT EXISTS idx_email_verification_tokens_hash ON email_verification_tokens(token_hash);
CREATE INDEX IF NOT EXISTS idx_email_verification_tokens_user ON email_verification_tokens(product_space_id, end_user_id);
</file>

<file path="infra/migrations/0056_bizsvc_custom_domain_index.sql">
-- Security audit follow-up: CORS_ALLOWLIST was one static platform-wide env var, which can't
-- scale to arbitrary per-builder custom domains (or even the platform's own {slug}.naelao.com
-- product subdomains, which were never added to it at all). The router now resolves an
-- unrecognized Origin dynamically against spaces.product_slug and this table's custom_domain
-- column (see workers/router/src/index.ts's isOriginAllowed) — this index is what keeps that
-- lookup a real index scan instead of a full table scan once there are many businesses running
-- custom domains ("millions of builders").
CREATE INDEX IF NOT EXISTS idx_bizsvc_custom_domain ON business_services(custom_domain) WHERE custom_domain IS NOT NULL;
</file>

<file path="infra/migrations/0057_builder_password_reset_tokens.sql">
-- Launch-readiness audit follow-up: migration 0054 gave END USERS a password-recovery path but
-- builders (platform accounts, workers/auth's own `users` table) still had none — a builder who
-- forgets their password permanently loses access to their own business. Same hashed, single-use,
-- expiring token shape as password_reset_tokens/business_invites; scoped to `users.id` (the
-- platform account), not a product space.
CREATE TABLE IF NOT EXISTS builder_password_reset_tokens (
  id          TEXT PRIMARY KEY,
  user_id     TEXT NOT NULL,
  token_hash  TEXT NOT NULL,
  created_at  TEXT NOT NULL DEFAULT (datetime('now')),
  expires_at  TEXT NOT NULL,
  used_at     TEXT
);
CREATE INDEX IF NOT EXISTS idx_builder_password_reset_tokens_hash ON builder_password_reset_tokens(token_hash);
CREATE INDEX IF NOT EXISTS idx_builder_password_reset_tokens_user ON builder_password_reset_tokens(user_id);
</file>

<file path="infra/migrations/0058_product_end_users_deleted_at.sql">
-- Tier 2/3 follow-up: GDPR Art. 17 erasure existed for product_end_users' export (ProductUserDO's
-- GET /export, GDPR Art. 20) but not deletion — an end user had a way to download their data, but
-- no way to actually have it erased. `deleted_at` marks a roster row whose PII (email/
-- display_name/password_hash) has been anonymized by DELETE /spaces/:spaceId/product-users/me —
-- the row itself is kept (not hard-deleted) so foreign-key-shaped references elsewhere
-- (business_memberships, agent_activity_log) don't orphan, same soft-delete precedent as `spaces.
-- status='deleted'` uses elsewhere in this schema.
ALTER TABLE product_end_users ADD COLUMN deleted_at TEXT;
</file>

<file path="infra/migrations/0059_spaces_last_digest_sent_at.sql">
-- Tier 2/3 follow-up: a proactive daily digest email for builders (agent activity summary — runs,
-- escalations, failures over the last 24h) — opt-in via productConfig.notificationsConfig.
-- dailyDigestEnabled. Tracks per-product-root send state directly on the space row (one recurring
-- digest per space, unlike scheduled_jobs' N builder-configured jobs, so a dedicated table would
-- be overkill) — the enqueueAgentTicks roster (workers/agents) uses this to fire at most once
-- per rolling 24h window.
ALTER TABLE spaces ADD COLUMN last_digest_sent_at TEXT;
</file>

<file path="infra/migrations/0060_mcp_server_connector_provider.sql">
-- Phase P: Composio/Pipedream connector provider support.
-- Adds a connector_provider column to mcp_servers so a registered server can be routed
-- through a gateway provider (Composio, Pipedream) instead of called directly.
-- 'direct' (default) = current behaviour: call server.url/mcp directly.
-- 'composio' = route through Composio's execute-action API using the stored connection_id.
-- 'pipedream' = route through Pipedream Connect using the stored connection_id.
-- Also adds connector_id to capture the provider's opaque connection reference (never the OAuth token).
ALTER TABLE mcp_servers ADD COLUMN connector_provider TEXT NOT NULL DEFAULT 'direct'
  CHECK (connector_provider IN ('direct', 'composio', 'pipedream'));
ALTER TABLE mcp_servers ADD COLUMN provider_connection_id TEXT;
CREATE INDEX IF NOT EXISTS idx_mcp_servers_provider ON mcp_servers (space_id, connector_provider);
</file>

<file path="infra/migrations/0061_reseller_ledger_kind.sql">
-- ARCH-REVENUE-6 / ARCH-REVENUE-7: give reseller_ledger a `kind` column so a builder's payout
-- read side can break revenue down by source, and so the new builder-revenue-share attribution
-- (a builder's slice of a child business's storefront/seat sales) is distinguishable from the
-- existing wholesale/referral attribution written by recordResellerAttribution.
--
--   'attribution'           — the original per-event reseller/referral margin (default for all
--                             existing rows and every recordResellerAttribution write).
--   'builder_revenue_share' — ARCH-REVENUE-6: the builder's configured slice of a child
--                             business's own sale (settled out of the sale before the business
--                             wallet, attributed to the builder's parent tenant).
--
-- Idempotency/refund: a refund writes a matching negative-margin row with the SAME kind, so the
-- payout balance nets to zero — never deletes the original (audit trail).
ALTER TABLE reseller_ledger ADD COLUMN kind TEXT NOT NULL DEFAULT 'attribution';

CREATE INDEX IF NOT EXISTS idx_reseller_ledger_parent_kind ON reseller_ledger(parent_tenant_id, kind);

-- ARCH-REVENUE-6: record the builder's slice on the order row itself, so the wallet UI can show
-- the two deductions (Naelao cut, builder cut) explicitly rather than one opaque fee, and so
-- net_cents = gross - fee_cents - builder_fee_cents stays a checkable invariant. Defaults 0 for
-- every existing order (no builder share taken before this feature).
ALTER TABLE launchpad_orders ADD COLUMN builder_fee_cents INTEGER NOT NULL DEFAULT 0;
</file>

<file path="infra/migrations/0062_subscriptions_lemon_squeezy.sql">
-- Platform-plan billing cutover: Lemon Squeezy is the ONLY billing provider (Stripe removed).
-- The builder's own platform subscription (growth/business plan) now settles through the same
-- Lemon Squeezy store as every other money path. The stripe_* columns from 0004 stay in place
-- (D1 has no cheap DROP COLUMN and rows may carry historical values) but nothing writes them
-- any more.
ALTER TABLE subscriptions ADD COLUMN ls_customer_id TEXT;
ALTER TABLE subscriptions ADD COLUMN ls_subscription_id TEXT;
</file>

<file path="infra/migrations/0063_payment_connections.sql">
-- Wallet Connect: a space's OWN payment account (Stripe Connect Express sub-account, or the
-- builder's own dedicated Lemon Squeezy store) so product revenue settles into an account the
-- builder owns — never Naelao's store, never the builder's personal account. This is the
-- "Stripe-Connect-style split-payment primitive" migration 0053's own header named as the
-- missing piece behind manual payout fulfillment.
--
-- Custody model:
--   stripe        → provider_account_id is a FRESH Express connected account (acct_...) created
--                   by the platform key; onboarding/KYC/bank details are Stripe-hosted (Naelao
--                   never sees them); checkouts are direct charges ON that account with
--                   application_fee_amount as the platform cut. Naelao never holds funds and has
--                   no debit capability.
--   lemon_squeezy → provider_account_id is the builder's own LS store id; their API key +
--                   the per-connection webhook signing secret live ENCRYPTED in the credentials
--                   vault (space_credentials) — this table stores only the credential NAMES,
--                   never secret material.
CREATE TABLE IF NOT EXISTS payment_connections (
  id                        TEXT PRIMARY KEY,
  tenant_id                 TEXT NOT NULL,
  space_id                  TEXT NOT NULL,
  provider                  TEXT NOT NULL CHECK (provider IN ('stripe', 'lemon_squeezy')),
  -- pending: created, awaiting Stripe hosted onboarding (charges_enabled=false)
  -- active:  usable for checkouts
  -- error:   provider reported a hard problem (e.g. account rejected)
  -- disabled: disconnected — kept as an audit row; a new connection may be created
  status                    TEXT NOT NULL DEFAULT 'pending'
    CHECK (status IN ('pending', 'active', 'disabled', 'error')),
  provider_account_id       TEXT,
  -- Vault pointers (space_credentials.name), never secrets:
  credential_name           TEXT,   -- LS API key credential (lemon_squeezy only)
  webhook_secret_credential TEXT,   -- LS per-connection webhook signing secret (lemon_squeezy only)
  details_json              TEXT NOT NULL DEFAULT '{}',
  created_by                TEXT,
  created_at                TEXT NOT NULL DEFAULT (datetime('now')),
  updated_at                TEXT NOT NULL DEFAULT (datetime('now'))
);

-- One live (non-disabled) connection per space — same partial-unique-index technique as
-- 0040_space_credentials.
CREATE UNIQUE INDEX IF NOT EXISTS idx_payment_connections_live_space
  ON payment_connections(space_id) WHERE status != 'disabled';
CREATE INDEX IF NOT EXISTS idx_payment_connections_tenant
  ON payment_connections(tenant_id);
-- Webhook dispatch resolves a Connect event by which provider account it happened on.
CREATE INDEX IF NOT EXISTS idx_payment_connections_provider_account
  ON payment_connections(provider, provider_account_id);
</file>

<file path="infra/migrations/0064_whop_sub_merchants.sql">
-- Whop sub-merchant wallets — the business-bank-account rail (replaces the removed
-- payment_connections / Wallet Connect subsystem, migration 0063). Every business auto-
-- provisions an isolated Whop sub-merchant "company" the moment it's created (no builder
-- enrollment, no OAuth consent) — the wallet IS the business's bank account: revenue in from
-- Whop's own storefront/checkout and connected 3rd-party platforms, expenses out for the
-- business's own operating costs, owner payouts on request. Naelao never custodies these funds;
-- Whop is the regulated payment facilitator (KYC, custody, payout rails). payment_connections
-- (migration 0063) is left in place, unused — D1 has no cheap DROP TABLE-and-forget-it story and
-- nothing writes to it anymore.

CREATE TABLE IF NOT EXISTS whop_sub_merchants (
  id             TEXT PRIMARY KEY,
  tenant_id      TEXT NOT NULL,
  space_id       TEXT NOT NULL,
  company_id     TEXT NOT NULL,  -- Whop's own sub-merchant company id
  owner_email    TEXT NOT NULL,
  status         TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'active', 'error')),
  balance_cents  INTEGER NOT NULL DEFAULT 0,  -- last-synced cache; source of truth is Whop itself
  currency       TEXT NOT NULL DEFAULT 'USD',
  last_synced_at TEXT,
  created_at     TEXT NOT NULL DEFAULT (datetime('now')),
  updated_at     TEXT NOT NULL DEFAULT (datetime('now'))
);

-- One sub-merchant per business, ever (a business's wallet is provisioned once and never
-- re-provisioned by a retry — see workers/billing/src/whop-wallet.ts's provisionSubMerchant).
CREATE UNIQUE INDEX IF NOT EXISTS idx_whop_sub_merchants_space ON whop_sub_merchants(space_id);
CREATE INDEX IF NOT EXISTS idx_whop_sub_merchants_tenant ON whop_sub_merchants(tenant_id);
CREATE INDEX IF NOT EXISTS idx_whop_sub_merchants_company ON whop_sub_merchants(company_id);

-- Ledger of every wallet-affecting event: 3rd-party/Whop-storefront revenue in, the business's
-- own operating expenses out, executed owner payouts, and Naelao's own platform-fee debits.
-- Append-only audit trail; the AUTHORITATIVE balance is always Whop's own (whop_sub_merchants
-- .balance_cents is a synced cache) — this table is for history/analytics, not the ledger of
-- record.
CREATE TABLE IF NOT EXISTS wallet_transactions (
  id                TEXT PRIMARY KEY,
  space_id          TEXT NOT NULL,
  type              TEXT NOT NULL CHECK (type IN ('revenue', 'expense', 'payout', 'fee_debit')),
  amount_cents      INTEGER NOT NULL,
  currency          TEXT NOT NULL DEFAULT 'USD',
  description       TEXT,
  external_ref      TEXT,  -- 3rd-party/Whop transaction id
  provider_event_id TEXT,  -- webhook idempotency key (unique per space)
  created_at        TEXT NOT NULL DEFAULT (datetime('now'))
);

CREATE INDEX IF NOT EXISTS idx_wallet_transactions_space ON wallet_transactions(space_id, created_at DESC);
CREATE UNIQUE INDEX IF NOT EXISTS idx_wallet_transactions_idem
  ON wallet_transactions(space_id, provider_event_id) WHERE provider_event_id IS NOT NULL;

-- Where an owner wants their payouts sent (bank/crypto/Venmo/CashApp). The actual account/
-- routing details are vault-encrypted (space_credentials via credentials worker) — this row
-- stores only a non-secret label + a pointer to the vault credential name, same pattern
-- payment_connections used for LS API keys.
CREATE TABLE IF NOT EXISTS payout_destinations (
  id                   TEXT PRIMARY KEY,
  space_id             TEXT NOT NULL,
  type                 TEXT NOT NULL CHECK (type IN ('bank', 'crypto', 'venmo', 'cashapp')),
  label                TEXT NOT NULL,  -- e.g. a masked account descriptor, never the secret itself
  credential_name      TEXT NOT NULL,  -- vault pointer (space_credentials.name)
  whop_destination_id  TEXT,           -- Whop's own destination id, set once Whop verifies it
  status               TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'verified', 'error')),
  is_default           INTEGER NOT NULL DEFAULT 0,
  created_by           TEXT,
  created_at           TEXT NOT NULL DEFAULT (datetime('now'))
);

CREATE INDEX IF NOT EXISTS idx_payout_destinations_space ON payout_destinations(space_id);

-- A payout only ever executes after an explicit owner approval (safety invariant #5 — first
-- payout per destination requires the owner to click an emailed approval link; subsequent
-- payouts to an already-verified destination are assistant-driven but still logged here).
CREATE TABLE IF NOT EXISTS payout_requests (
  id                  TEXT PRIMARY KEY,
  space_id            TEXT NOT NULL,
  destination_id      TEXT NOT NULL,
  amount_cents        INTEGER NOT NULL,
  note                TEXT,
  status              TEXT NOT NULL DEFAULT 'pending_approval'
    CHECK (status IN ('pending_approval', 'approved', 'executed', 'denied', 'failed')),
  approval_token_hash TEXT,   -- SHA-256 of the single-use emailed approval token
  requested_by        TEXT,   -- 'assistant' or a user id
  whop_withdrawal_id  TEXT,
  created_at          TEXT NOT NULL DEFAULT (datetime('now')),
  updated_at          TEXT NOT NULL DEFAULT (datetime('now'))
);

CREATE INDEX IF NOT EXISTS idx_payout_requests_space ON payout_requests(space_id, created_at DESC);
</file>

<file path="infra/migrations/0065_whop_kyc_onboarding.sql">
-- Whop "connected accounts" (their current name for what migration 0064 called sub-merchants —
-- same Platforms API, same invite-only access) have TWO separate readiness states that migration
-- 0064 conflated into one: the company record can be created instantly via API, but a brand-new
-- owner (no prior Whop account) must additionally complete an emailed onboarding link with KYC
-- verification before that connected account can actually RECEIVE TRANSFERS/payouts. Treating
-- "created" as "active" would have silently told an owner their wallet was ready when payouts
-- would in fact fail — this migration adds the missing intermediate state instead.
--
-- SQLite can't ALTER a CHECK constraint in place (same limitation 0052 hit) — rebuild the table.

CREATE TABLE whop_sub_merchants_v2 (
  id             TEXT PRIMARY KEY,
  tenant_id      TEXT NOT NULL,
  space_id       TEXT NOT NULL,
  company_id     TEXT NOT NULL,
  owner_email    TEXT NOT NULL,
  status         TEXT NOT NULL DEFAULT 'pending'
    CHECK (status IN ('pending', 'awaiting_kyc', 'active', 'error')),
  -- Set only while status = 'awaiting_kyc' — the one-time Whop-hosted KYC/onboarding link the
  -- owner must complete before payouts work. Cleared once status flips to 'active'.
  onboarding_url TEXT,
  balance_cents  INTEGER NOT NULL DEFAULT 0,
  currency       TEXT NOT NULL DEFAULT 'USD',
  last_synced_at TEXT,
  created_at     TEXT NOT NULL DEFAULT (datetime('now')),
  updated_at     TEXT NOT NULL DEFAULT (datetime('now'))
);

INSERT INTO whop_sub_merchants_v2
  (id, tenant_id, space_id, company_id, owner_email, status, balance_cents, currency, last_synced_at, created_at, updated_at)
  SELECT id, tenant_id, space_id, company_id, owner_email, status, balance_cents, currency, last_synced_at, created_at, updated_at
  FROM whop_sub_merchants;

DROP TABLE whop_sub_merchants;
ALTER TABLE whop_sub_merchants_v2 RENAME TO whop_sub_merchants;

CREATE UNIQUE INDEX IF NOT EXISTS idx_whop_sub_merchants_space ON whop_sub_merchants(space_id);
CREATE INDEX IF NOT EXISTS idx_whop_sub_merchants_tenant ON whop_sub_merchants(tenant_id);
