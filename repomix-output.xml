    <h3>x402 AI Crawler Monetization</h3>
    <p>The x402 protocol lets websites charge AI crawlers (GPT, Claude, Perplexity, etc.) micropayments for access to
      content. This is implemented as middleware on the CF Pages site.</p>
    <pre><code><span class="cm">// _middleware.ts in the CF Pages project for Sites
// This runs before every page request and checks if the visitor is an AI crawler</span>

const AI_CRAWLER_USER_AGENTS = [
  'GPTBot', 'ClaudeBot', 'PerplexityBot', 'CCBot', 'anthropic-ai',
  'Applebot', 'Googlebot-Extended', 'ChatGPT-User'
];

export async function onRequest(context: EventContext): Promise&lt;Response&gt; {
  const { request, env } = context;
  const userAgent = request.headers.get('User-Agent') ?? '';

  <span class="cm">// Is this an AI crawler?</span>
  const isAICrawler = AI_CRAWLER_USER_AGENTS.some(ua =>
    userAgent.toLowerCase().includes(ua.toLowerCase())
  );

  if (!isAICrawler) {
    return context.next(); <span class="cm">// Human visitor — serve normally</span>
  }

  <span class="cm">// Check for x402 payment header</span>
  const paymentProof = request.headers.get('X-Payment');

  if (!paymentProof) {
    <span class="cm">// No payment — return 402 Payment Required with payment instructions</span>
    return new Response(JSON.stringify({
      error: 'Payment Required',
      details: 'This site requires micropayment for AI crawler access.',
      payment: {
        protocol: 'x402',
        amount: '0.001',  <span class="cm">// $0.001 per page</span>
        currency: 'USD',
        payTo: env.NAELAO_WALLET_ADDRESS,
        network: 'base'   <span class="cm">// Base L2 for low fees</span>
      }
    }), {
      status: 402,
      headers: {
        'Content-Type': 'application/json',
        'X-Payment-Protocol': 'x402',
        'X-Payment-Amount': '0.001',
        'X-Payment-Currency': 'USD'
      }
    });
  }

  <span class="cm">// Verify payment proof</span>
  const isValidPayment = await verifyX402Payment(paymentProof, env);
  if (!isValidPayment) {
    return new Response('Invalid payment proof', { status: 402 });
  }

  <span class="cm">// Credit the Space's wallet</span>
  await fetch(`https://app.naelao.dev/api/wallets/${env.SPACE_ID}/credit`, {
    method: 'POST',
    headers: { 'Authorization': `Bearer ${env.NAELAO_INTERNAL_TOKEN}` },
    body: JSON.stringify({ amount: 0.001, source: 'ai-crawler', userAgent })
  });

  <span class="cm">// Serve the content</span>
  return context.next();
}</code></pre>
