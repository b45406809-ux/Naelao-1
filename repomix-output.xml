<file path="apps/shell/src/components/SubthreadPanel.tsx">
"use client";

// The assistant<->agent consult lane for a project thread (§A1.18 thread model). A project
// thread is the person and whichever agent is working — two visible parties. When the assistant
// needs to talk TO that agent directly (a handoff, a status check), that exchange runs in its own
// subthread rather than being mixed into the visible transcript, where nobody could tell who a
// message was actually addressed to. Collapsed by default (this whole tab is opt-in — you only
// see it if you click "Assistant"), expandable per-subthread so the raw exchange is never truly
// hidden, just not in your way.

import * as React from "react";
import { getMessages, listSubthreads, type Message, type SessionCredentials, type ThreadSummary } from "@/lib/api";

function authorLabel(m: Message): string {
  if (m.author_type === "assistant") return "Assistant";
  if (m.author_type === "agent" && m.author_id) {
    return m.author_id.replace(/^launchpad-/, "").replace(/-v\d+$/, "").replace(/[-_]/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
  }
  return m.role === "user" ? "Assistant" : "Agent";
}

/** A DOM id shared between the sidebar's list entry and the inline card the same consult produces
 *  in the main thread transcript — what lets clicking one scroll to and briefly highlight the
 *  other. */
export function consultAnchorId(threadId: string): string {
  return `consult-${threadId}`;
}

/** Scrolls to and briefly highlights an inline consult card in the main transcript — the sidebar's
 *  own "click to jump to where this happened" affordance, since the sidebar list otherwise has no
 *  connection back to the exact turn a consult occurred at. */
function scrollToConsultCard(threadId: string) {
  const el = document.getElementById(consultAnchorId(threadId));
  if (!el) return;
  el.scrollIntoView({ behavior: "smooth", block: "center" });
  el.classList.add("consult-highlight");
  window.setTimeout(() => el.classList.remove("consult-highlight"), 1600);
}

// Exported so Chat.tsx can render the SAME expandable card inline in the main transcript, at the
// exact turn where a consult happened (item 79) — not just here in the separate "Assistant" tab,
// which still lists every subthread for a thread regardless of whether it's tied to one message.
// `inline` distinguishes the two call sites: only the SIDEBAR copy (inline=false, the default)
// offers "jump to where this happened in the transcript" — the inline card IS that spot, jumping
// to itself would be a no-op.
export function SubthreadEntry({
  spaceId, thread, session, inline = false,
}: { spaceId: string; thread: ThreadSummary; session: SessionCredentials; inline?: boolean }) {
  const [expanded, setExpanded] = React.useState(false);
  const [messages, setMessages] = React.useState<Message[] | null>(null);
  const [loading, setLoading] = React.useState(false);
  const [failed, setFailed] = React.useState(false);

  async function toggle() {
    const next = !expanded;
    setExpanded(next);
    if (next && messages === null && thread.session_id) {
      setLoading(true);
      try {
        setMessages(await getMessages(spaceId, thread.session_id, session));
        setFailed(false);
      } catch {
        setFailed(true);
      } finally {
        setLoading(false);
      }
    }
  }

  return (
    <div
      id={inline ? consultAnchorId(thread.id) : undefined}
      style={{ border: "1px solid var(--border, #e5e7eb)", borderRadius: 8, marginBottom: 8, overflow: "hidden" }}
    >
      <div style={{ display: "flex", alignItems: "center" }}>
        <button
          type="button"
          onClick={() => void toggle()}
          style={{
            flex: 1, display: "flex", justifyContent: "space-between", alignItems: "center",
            padding: "8px 10px", background: "transparent", border: "none", cursor: "pointer", fontSize: 13,
          }}
        >
          <span>{thread.title ?? "Consult"}</span>
          <span style={{ color: "var(--text3)" }}>{expanded ? "−" : "+"}</span>
        </button>
        {/* Sidebar-only: jump to the exact turn in the transcript this consult happened at — the
            inline card itself doesn't need a link back to itself. */}
        {!inline && (
          <button
            type="button"
            onClick={() => scrollToConsultCard(thread.id)}
            title="Jump to where this happened"
            style={{ padding: "8px 10px", background: "transparent", border: "none", cursor: "pointer", color: "var(--text3)", fontSize: 12 }}
          >
            ↗
          </button>
        )}
      </div>
      {expanded && (
        <div style={{ padding: "0 10px 10px", fontSize: 12 }}>
          {loading ? (
            <p style={{ color: "var(--text3)" }}>Loading…</p>
          ) : failed ? (
            <p style={{ color: "#dc2626" }}>Couldn&rsquo;t load this exchange.</p>
          ) : !thread.session_id ? (
            <p style={{ color: "var(--text3)" }}>No messages yet.</p>
          ) : (
            (messages ?? []).map((m) => (
              <div key={m.id} style={{ marginBottom: 8 }}>
                <div style={{ fontWeight: 600, color: "var(--text3)" }}>{authorLabel(m)}</div>
                <div style={{ whiteSpace: "pre-wrap" }}>{m.content}</div>
              </div>
            ))
          )}
        </div>
      )}
    </div>
  );
}

export function SubthreadPanel({ spaceId, threadId, session }: { spaceId: string; threadId: string; session: SessionCredentials }) {
  const [threads, setThreads] = React.useState<ThreadSummary[] | null>(null);
  const [failed, setFailed] = React.useState(false);

  React.useEffect(() => {
    let cancelled = false;
    listSubthreads(spaceId, threadId, session)
      .then((data) => { if (!cancelled) setThreads(data); })
      .catch(() => { if (!cancelled) setFailed(true); });
    return () => {
      cancelled = true;
    };
  }, [spaceId, threadId, session]);

  if (failed) {
    return <div className="tp-section" style={{ textTransform: "none", color: "#dc2626" }}>Couldn&rsquo;t load.</div>;
  }
  if (threads === null) {
    return <div className="tp-section" style={{ textTransform: "none", color: "var(--text3)" }}>Loading…</div>;
  }
  if (threads.length === 0) {
    return (
      <div className="tp-section" style={{ textTransform: "none", color: "var(--text3)" }}>
        Nothing yet. Shows up here if the assistant consults an agent about this thread.
      </div>
    );
  }
  return (
    // Scrollable: a busy project can accumulate more consults than fit the sidebar's fixed height.
    <div style={{ maxHeight: 480, overflowY: "auto" }}>
      {threads.map((t) => (
        <SubthreadEntry key={t.id} spaceId={spaceId} thread={t} session={session} />
      ))}
    </div>
  );
}
</file>

<file path="apps/shell/src/components/UpgradeDialog.tsx">
"use client";

// The "insufficient credits — top up or subscribe to keep chatting" (and its billing-gate
// siblings: subscription_inactive, quota_exceeded, infra_quota_exceeded) used to surface as a
// bare red error banner — accurate, but a dead end: nothing on it let the person actually DO
// anything about it. This renders the SAME real purchase flow the Settings/business-detail pages
// already have (getPricing → checkoutCreditPack/checkoutBusinessSubscription, both real Lemon
// Squeezy checkouts) as a focused dialog, at the exact moment the wall was hit.
//
// Deliberately honest about what does and doesn't have a self-serve fix here:
//   - insufficient_credits on the SIGNED-IN PERSON'S OWN balance ("insufficient credits — top up
//     or subscribe...") → real credit-pack / subscription purchase buttons, when the business has
//     configured any (a business that hasn't is told so, not shown empty buttons).
//   - subscription_inactive → real "Resubscribe" buttons from the same catalog.
//   - insufficient_credits on the BUSINESS'S OWN WALLET ("this business's wallet is empty...") →
//     there is no end-user-reachable wallet top-up route yet (only an internal billing-worker
//     one an owner can't self-serve from here) — say so plainly and point at support, rather than
//     fabricating a button that would fail.
//   - quota_exceeded / infra_quota_exceeded → an ORG-level plan quota, not fixable by a purchase
//     here at all — message + support link only.

import * as React from "react";
import { getPricing, checkoutCreditPack, checkoutBusinessSubscription, type PricingPlan, type CreditPack } from "@/lib/api";
import type { SessionCredentials } from "@/lib/api";

const PURCHASABLE_CODES = new Set(["insufficient_credits", "subscription_inactive"]);

function isWalletMessage(message: string): boolean {
  return message.toLowerCase().includes("wallet");
}

function formatPrice(cents: number): string {
  return `$${(cents / 100).toFixed(2)}`;
}

export function UpgradeDialog({
  spaceId,
  session,
  errorCode,
  message,
  supportContact,
  onClose,
}: {
  spaceId: string;
  session: SessionCredentials;
  errorCode: string;
  message: string;
  supportContact?: string | null | undefined;
  onClose: () => void;
}) {
  const isWallet = errorCode === "insufficient_credits" && isWalletMessage(message);
  const purchasable = PURCHASABLE_CODES.has(errorCode) && !isWallet;

  const [loading, setLoading] = React.useState(purchasable);
  const [plans, setPlans] = React.useState<PricingPlan[]>([]);
  const [packs, setPacks] = React.useState<CreditPack[]>([]);
  const [loadFailed, setLoadFailed] = React.useState(false);
  const [checkoutBusyId, setCheckoutBusyId] = React.useState<string | null>(null);
  const [checkoutError, setCheckoutError] = React.useState<string | null>(null);

  React.useEffect(() => {
    if (!purchasable) return;
    let cancelled = false;
    setLoading(true);
    getPricing(spaceId, session)
      .then((r) => {
        if (cancelled) return;
        setPlans(r.plans);
        setPacks(r.credit_packs);
      })
      .catch(() => { if (!cancelled) setLoadFailed(true); })
      .finally(() => { if (!cancelled) setLoading(false); });
    return () => { cancelled = true; };
  }, [purchasable, spaceId, session]);

  async function buyPack(packId: string) {
    setCheckoutBusyId(packId);
    setCheckoutError(null);
    try {
      const { checkout_url, dev } = await checkoutCreditPack(spaceId, session, packId);
      // dev:true is a real, deterministic placeholder — checkout.naelao.com doesn't resolve to
      // anything. Navigating there is a dead end with no signal what went wrong; say so instead.
      if (dev) {
        setCheckoutError("Payments aren't configured for this business yet — ask the owner to finish billing setup.");
        setCheckoutBusyId(null);
      } else {
        window.location.href = checkout_url;
      }
    } catch (err) {
      setCheckoutError(err instanceof Error ? err.message : "Couldn't start checkout");
      setCheckoutBusyId(null);
    }
  }

  async function subscribe(planId: string) {
    setCheckoutBusyId(planId);
    setCheckoutError(null);
    try {
      const { checkout_url, dev } = await checkoutBusinessSubscription(spaceId, session, planId);
      if (dev) {
        setCheckoutError("Payments aren't configured for this business yet — ask the owner to finish billing setup.");
        setCheckoutBusyId(null);
      } else {
        window.location.href = checkout_url;
      }
    } catch (err) {
      setCheckoutError(err instanceof Error ? err.message : "Couldn't start checkout");
      setCheckoutBusyId(null);
    }
  }

  const nothingToBuy = purchasable && !loading && !loadFailed && plans.length === 0 && packs.length === 0;

  return (
    <div
      role="dialog"
      aria-modal="true"
      style={{
        position: "fixed", inset: 0, background: "rgba(0,0,0,0.45)", zIndex: 200,
        display: "flex", alignItems: "center", justifyContent: "center", padding: 16,
      }}
      onClick={onClose}
    >
      <div
        style={{
          background: "var(--surface)", border: "1px solid var(--border)", borderRadius: "var(--radius)",
          maxWidth: 440, width: "100%", padding: 20, maxHeight: "85vh", overflowY: "auto",
        }}
        onClick={(e) => e.stopPropagation()}
      >
        <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 10 }}>
          <span aria-hidden style={{ fontSize: 16 }}>💳</span>
          <span style={{ fontSize: 15, fontWeight: 700, color: "var(--text)" }}>
            {errorCode === "subscription_inactive" ? "Subscription needed" : "Out of credits"}
          </span>
        </div>
        <p style={{ fontSize: 13, color: "var(--text2)", marginBottom: 16, lineHeight: 1.5 }}>{message}</p>

        {isWallet && (
          <p style={{ fontSize: 12.5, color: "var(--text3)", marginBottom: 4 }}>
            This is the business&apos;s own wallet, not your personal balance — ask the business owner to top
            it up from the Dashboard&apos;s Business Wallet section.
          </p>
        )}

        {errorCode === "quota_exceeded" || errorCode === "infra_quota_exceeded" ? (
          <p style={{ fontSize: 12.5, color: "var(--text3)", marginBottom: 4 }}>
            This business has reached its plan&apos;s monthly usage limit — the owner can upgrade the
            platform plan from the Dashboard, or wait for it to reset next month.
          </p>
        ) : null}

        {purchasable && loading && <p style={{ fontSize: 12.5, color: "var(--text3)" }}>Loading options…</p>}
        {purchasable && loadFailed && (
          <p style={{ fontSize: 12.5, color: "var(--text3)" }}>Couldn&apos;t load purchase options right now.</p>
        )}
        {nothingToBuy && (
          <p style={{ fontSize: 12.5, color: "var(--text3)" }}>
            This business hasn&apos;t set up a way to buy more credits yet.
          </p>
        )}

        {packs.length > 0 && (
          <div style={{ marginBottom: plans.length ? 14 : 4 }}>
            <div style={{ fontSize: 11.5, fontWeight: 600, color: "var(--text3)", textTransform: "uppercase", letterSpacing: 0.3, marginBottom: 6 }}>
              Buy credits
            </div>
            <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
              {packs.map((p) => (
                <button
                  key={p.id}
                  type="button"
                  className="btn btn-primary btn-sm"
                  style={{ justifyContent: "space-between", display: "flex" }}
                  disabled={checkoutBusyId !== null}
                  onClick={() => void buyPack(p.id)}
                >
                  <span>{p.name} — {p.credits} credits</span>
                  <span>{checkoutBusyId === p.id ? "…" : formatPrice(p.price_cents)}</span>
                </button>
              ))}
            </div>
          </div>
        )}

        {plans.length > 0 && (
          <div>
            <div style={{ fontSize: 11.5, fontWeight: 600, color: "var(--text3)", textTransform: "uppercase", letterSpacing: 0.3, marginBottom: 6 }}>
              Subscribe
            </div>
            <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
              {plans.map((p) => (
                <button
                  key={p.id}
                  type="button"
                  className="btn btn-primary btn-sm"
                  style={{ justifyContent: "space-between", display: "flex" }}
                  disabled={checkoutBusyId !== null}
                  onClick={() => void subscribe(p.id)}
                >
                  <span>{p.name}{p.credit_allowance ? ` — ${p.credit_allowance} credits/${p.interval}` : ""}</span>
                  <span>{checkoutBusyId === p.id ? "…" : `${formatPrice(p.price_cents)}/${p.interval}`}</span>
                </button>
              ))}
            </div>
          </div>
        )}

        {checkoutError && (
          <p style={{ fontSize: 12, color: "#dc2626", marginTop: 10 }}>{checkoutError}</p>
        )}

        {supportContact && (
          <p style={{ fontSize: 12, color: "var(--text3)", marginTop: 14 }}>
            Need help? <a href={supportContact} style={{ color: "var(--accent)" }}>Contact support</a>
          </p>
        )}

        <div style={{ marginTop: 16, textAlign: "right" }}>
          <button type="button" className="btn btn-ghost btn-sm" onClick={onClose}>
            Maybe later
          </button>
        </div>
      </div>
    </div>
  );
}
