  <div class="sec" id="observability">
    <span class="sec-ey">60 — Production Observability</span>
    <h2>Production Observability — Logs, Alerts & Dashboards</h2>
    <div class="bar"></div>
    <p class="lead">Running Naelao in production requires knowing when something is wrong before users complain. This
      section documents the complete observability setup: what to log, what to alert on, and how to build dashboards
      from CF Analytics Engine data.</p>

    <h3>Structured Logging Pattern</h3>
    <pre><code><span class="cm">// shared/logger.ts
// Structured logging for all Workers. Every log entry is a JSON object.
// CF Workers logs are captured in Workers Logs (Cloudflare Dashboard)
// and optionally forwarded to Logpush (Splunk, Datadog, S3, etc.)</span>

export interface LogEntry {
  level: 'debug' | 'info' | 'warn' | 'error' | 'critical';
  message: string;
  component: string;      <span class="cm">// which Worker</span>
  spaceId?: string;
  userId?: string;
  agentId?: string;
  runId?: string;
  errorCode?: string;
  durationMs?: number;
  metadata?: Record&lt;string, unknown&gt;;
  timestamp: string;      <span class="cm">// ISO 8601</span>
}

export class Logger {
  constructor(private component: string, private spaceId?: string) {}

  private log(level: LogEntry['level'], message: string, meta?: Partial&lt;LogEntry&gt;): void {
    const entry: LogEntry = {
      level,
      message,
      component: this.component,
      spaceId: this.spaceId,
      timestamp: new Date().toISOString(),
      ...meta
    };

    <span class="cm">// In CF Workers, console.log is captured by Workers Logs
    // Always use structured JSON — never use template literals for log messages</span>
    console.log(JSON.stringify(entry));
  }

  debug = (msg: string, meta?: Partial&lt;LogEntry&gt;) =&gt; this.log('debug', msg, meta);
  info  = (msg: string, meta?: Partial&lt;LogEntry&gt;) =&gt; this.log('info',  msg, meta);
  warn  = (msg: string, meta?: Partial&lt;LogEntry&gt;) =&gt; this.log('warn',  msg, meta);
  error = (msg: string, meta?: Partial&lt;LogEntry&gt;) =&gt; this.log('error', msg, meta);

  critical(msg: string, meta?: Partial&lt;LogEntry&gt;): void {
    this.log('critical', msg, meta);
    <span class="cm">// Critical logs also go to Analytics Engine for alerting</span>
    // Do NOT await this — fire and forget
    void this.sendToAnalytics({ ...meta, level: 'critical', message: msg });
  }

  private async sendToAnalytics(entry: Partial&lt;LogEntry&gt;): Promise&lt;void&gt; {
    <span class="cm">// Implementation: send to naelao-analytics-queue
    // This is separate from console.log to enable alerting on critical events</span>
  }
}

<span class="cm">// Usage in any Worker:</span>
const logger = new Logger('naelao-agents', spaceId);
logger.info('Agent run started', { runId, agentDefinitionId, backgroundMode });
logger.error('Agent run failed', { runId, errorCode: 'CONTAINER_TIMEOUT', durationMs: 30001 });</code></pre>

