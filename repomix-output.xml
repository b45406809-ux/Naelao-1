/**
 * r2-workspace (spec §12.1) — maps file operations to Tier 1 direct R2.
 * Default for all agents. The R2 workspace is the agent's persistent filesystem; it
 * persists across sessions. Operations: read_file, write_file, list_directory,
 * delete_file, copy_file, move_file, stat_file, search_file — plus a second, Claude-Code-shaped
 * set of REPL primitives that share the SAME underlying store: Read (line-windowed), Edit
 * (surgical search-and-replace), Write (atomic write — literally the same op as write_file),
 * Grep (regex search across the whole workspace, not just one file), Glob (path-pattern
 * listing). Both sets stay callable forever — RENAMED_OPERATIONS (tool-surface.ts) also maps a
 * few lowercase aliases (read/edit/write/grep/glob/bash) onto these for a model that reaches for
 * the more familiar spelling.
 *
 * The matching observe script for this is observe_filesystem (see observe.ts).
 *
 * read_file's own result becomes part of THIS turn's reasoner payload immediately — it isn't
 * windowed down to a short observation until step-context.ts trims an OLDER step, which is too
 * late for a single oversized read. A multi-MB file (a customer-uploaded CSV, a large export)
 * read in full would blow a small model's ~24k-token context in one call. stat_file lets the
 * agent check size before committing to a read; read_file itself also refuses past
 * MAX_READABLE_FILE_BYTES rather than trusting the model to check first — same "structure over
 * prompts" reasoning as every other hard cap in this engine. Read/Edit/Grep carry their own,
 * independent size gates below — LINE-windowed reading needs the whole object's text in memory
 * to find line boundaries, so its ceiling is deliberately the higher MAX_SEARCHABLE_FILE_BYTES,
 * not the smaller MAX_READABLE_FILE_BYTES read_file uses for a true single-shot read.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { workspacePrefix } from "../types.js";

/** Above this, read_file refuses rather than returning a payload that can blow the context of a
 *  turn all by itself. ~50k tokens at a rough 4-chars/token estimate — generous for real text/
 *  config/code files, bounded well under even the platform's smallest usable model window. */
const MAX_READABLE_FILE_BYTES = 200_000;

/** Resolve the workspace bucket (falls back to the scripts bucket if not separate). */
function bucket(ctx: PrebuiltOpContext): R2Bucket {
  return ctx.env.workspaceBucket ?? ctx.env.scriptsBucket;
}

/** All workspace keys are scoped under the run's workspace prefix (space- or project-scoped). */
function key(ctx: PrebuiltOpContext, path: string): string {
  const clean = String(path).replace(/^\/+/, "");
  if (clean.includes("..")) throw new Error(`Path traversal rejected: ${path}`);
  return `${workspacePrefix(ctx.env)}${clean}`;
}

function reqStr(args: Record<string, unknown>, name: string): string {
  const v = args[name];
  if (typeof v !== "string" || v.length === 0) throw new Error(`'${name}' (string) is required`);
  return v;
}

function numArg(args: Record<string, unknown>, name: string): number | undefined {
  const v = args[name];
  if (typeof v === "number" && Number.isFinite(v)) return v;
  if (typeof v === "string" && v.trim() !== "" && Number.isFinite(Number(v))) return Number(v);
  return undefined;
}

/** Cap on how large a file search_file/Read/Grep will read in one pass. Higher than the
 *  single-read cap because search returns only matching lines, not the whole file — but still
 *  bounded so a genuinely huge file is read in chunks via read_file(offset,length) instead. */
const MAX_SEARCHABLE_FILE_BYTES = 5_000_000;

/** Grep scans across the whole workspace, not one named file — bounded on BOTH files touched
 *  and matches found so a sparse query against a large workspace can't approach the platform's
 *  1000-subrequest-per-invocation ceiling (one R2 get per file scanned) or blow a turn's payload. */
const MAX_GREP_FILES_SCANNED = 300;
const MAX_GREP_MATCHES = 100;

async function writeFileImpl(
  ctx: PrebuiltOpContext,
  path: string,
  content: string
): Promise<{ ok: true; path: string; size: number }> {
  await bucket(ctx).put(key(ctx, path), content, {
    customMetadata: { updatedAt: Date.now().toString() },
  });
  // The file IS the handoff between projects: one project's agent records what it found, that
  // write fires an event, and a no-code rule wakes whoever owns the next stage. Fired after the
  // write actually succeeded, and never awaited — a listener failing must not turn a successful
  // write into a failed one.
  ctx.env.onWorkspaceChange?.({ path, operation: "write" });
  return { ok: true, path, size: content.length };
}

/** Claude-Code-shaped windowed reader: 1-indexed LINE offset/limit, returned as
 *  `"<n> | <line>"` text the way an agent expects a file viewer to look. Distinct from
 *  read_file's byte-oriented offset/length — the two are NOT interchangeable, and existing
 *  callers of read_file (byte offsets) must keep working unchanged. */
async function readWindowed(
  ctx: PrebuiltOpContext,
  path: string,
  offsetLines?: number,
  limitLines?: number
): Promise<{
  exists: boolean;
  content?: string;
  lines_total?: number;
  offset?: number;
  limit?: number;
  has_more?: boolean;
  too_large?: boolean;
  size?: number;
  message?: string;
}> {
  const head = await bucket(ctx).head(key(ctx, path));
  if (!head) return { exists: false };
  if (head.size > MAX_SEARCHABLE_FILE_BYTES) {
    return {
      exists: true,
      too_large: true,
      size: head.size,
      message: `This file is ${head.size} bytes, over the ${MAX_SEARCHABLE_FILE_BYTES}-byte limit for a windowed read. Use search_file/Grep to jump to the part you need, or read_file(path, offset, length) for a true byte-chunked read.`,
    };
  }
  const obj = await bucket(ctx).get(key(ctx, path));
  if (!obj) return { exists: false };
  const allLines = (await obj.text()).split(/\r?\n/);
  const total = allLines.length;
  const start = Math.max(1, offsetLines ?? 1);
  const count = Math.max(1, Math.min(limitLines ?? 2000, 2000));
  const slice = allLines.slice(start - 1, start - 1 + count);
  const padWidth = String(start + Math.max(0, slice.length - 1)).length;
  const content = slice.map((line, idx) => `${String(start + idx).padStart(padWidth, " ")} | ${line}`).join("\n");
  const hasMore = start - 1 + count < total;
  return {
    exists: true,
    content,
    lines_total: total,
    offset: start,
    limit: count,
    ...(hasMore ? { has_more: true } : { has_more: false }),
  };
}

/** Surgical single-occurrence search-and-replace. Refuses (rather than guessing) when the exact
 *  text isn't found — returning nearby lines sharing a keyword so the model can self-correct
 *  without a wasted extra Read round-trip — and refuses when the match is ambiguous (>1
 *  occurrence), since replacing "the wrong one" silently is worse than asking for more context. */
async function editFile(
  ctx: PrebuiltOpContext,
  path: string,
  oldString: string,
  newString: string
): Promise<{ ok: boolean; path: string; replacements?: number; error?: string; hint?: string }> {
  if (!oldString) throw new Error("'oldString' (string) is required");
  const head = await bucket(ctx).head(key(ctx, path));
  if (!head) return { ok: false, path, error: `File not found: ${path}` };
  if (head.size > MAX_READABLE_FILE_BYTES) {
    return {
      ok: false,
      path,
      error: `This file is ${head.size} bytes, over the ${MAX_READABLE_FILE_BYTES}-byte limit for Edit. Use read_file(path, offset, length) to inspect it in chunks instead.`,
    };
  }
  const obj = await bucket(ctx).get(key(ctx, path));
  if (!obj) return { ok: false, path, error: `File not found: ${path}` };
  const content = await obj.text();

  if (!content.includes(oldString)) {
    const searchLines = oldString.split(/\r?\n/).map((l) => l.trim()).filter((l) => l.length > 3);
    const fileLines = content.split(/\r?\n/);
    const nearbyHints: Array<{ line: number; text: string }> = [];
    for (let i = 0; i < fileLines.length; i++) {
      const fl = fileLines[i] ?? "";
      if (searchLines.some((sl) => fl.includes(sl))) {
        nearbyHints.push({ line: i + 1, text: fl.trim().slice(0, 100) });
        if (nearbyHints.length >= 4) break;
      }
    }
    const hint =
      nearbyHints.length > 0
        ? `oldString was not found verbatim. Possibly nearby (line ${nearbyHints[0]!.line}):\n` +
          nearbyHints.map((h) => `  ${h.line}: ${h.text}`).join("\n")
        : `oldString was not found in ${path}. Read it first to get the exact current text.`;
    return { ok: false, path, error: "target_string_not_found", hint };
  }

  const occurrences = content.split(oldString).length - 1;
  if (occurrences > 1) {
    return {
      ok: false,
      path,
      error: `oldString matched ${occurrences} times in ${path} — include more surrounding lines in oldString so the replacement is unambiguous.`,
    };
  }

  const patched = content.replace(oldString, newString);
  await writeFileImpl(ctx, path, patched);
  return { ok: true, path, replacements: 1 };
}

/** Regex search across every file under a prefix (the whole workspace, or a narrower path) —
 *  distinct from search_file, which searches ONE named file. Bounded on files scanned AND
 *  matches found; a search that hits either cap says so rather than silently stopping. */
async function grepWorkspace(
  ctx: PrebuiltOpContext,
  pattern: string,
  pathPrefix = ""
): Promise<{
  pattern: string;
  total_matches: number;
  matches: Array<{ file: string; line_number: number; text: string }>;
  files_scanned: number;
  truncated: boolean;
}> {
  let regex: RegExp;
  try {
    regex = new RegExp(pattern, "i");
  } catch {
    throw new Error(`'${pattern}' is not a valid regular expression`);
  }
  const prefix = key(ctx, pathPrefix);
  const wsPrefix = workspacePrefix(ctx.env);
  const matches: Array<{ file: string; line_number: number; text: string }> = [];
  let filesScanned = 0;
  let cursor: string | undefined;
  let truncated = false;
  do {
    const listing = await bucket(ctx).list(cursor ? { prefix, cursor } : { prefix });
    for (const objMeta of listing.objects) {
      if (objMeta.key.endsWith("/.keep") || objMeta.size > MAX_SEARCHABLE_FILE_BYTES) continue;
      if (filesScanned >= MAX_GREP_FILES_SCANNED) { truncated = true; break; }
      filesScanned++;
      const fileObj = await bucket(ctx).get(objMeta.key);
      if (!fileObj) continue;
      const lines = (await fileObj.text()).split(/\r?\n/);
      const relativePath = objMeta.key.slice(wsPrefix.length);
      for (let i = 0; i < lines.length; i++) {
        const line = lines[i] ?? "";
        if (regex.test(line)) {
          matches.push({ file: relativePath, line_number: i + 1, text: line.trim().slice(0, 300) });
          if (matches.length >= MAX_GREP_MATCHES) { truncated = true; break; }
        }
      }
      if (matches.length >= MAX_GREP_MATCHES) break;
    }
    cursor = listing.truncated && !truncated ? listing.cursor : undefined;
  } while (cursor);

  return { pattern, total_matches: matches.length, matches, files_scanned: filesScanned, truncated };
}

/**
 * Glob-to-RegExp translation, a single left-to-right token scan rather than a chain of
 * `.replace()` calls. (Note for anyone editing this comment: never write the two characters
 * star-slash next to each other in here, even inside backticks — it closes a block comment.)
 * A naive replace-chain (convert a double-star to a placeholder, THEN a single star to
 * `[^` + slash + `]*`, then swap the placeholder for `.*`) has two real failure modes, both
 * caught by this port's own tests:
 *   1. Re-matching: if the placeholder swap runs before the single-star pass, the star inside
 *      the just-inserted `.*` gets rewritten again, corrupting "cross any directory depth" into
 *      "exactly one path segment".
 *   2. Even done in the right order, treating a double-star-then-slash as two independent
 *      tokens ("cross any depth", then a literal slash) makes the slash MANDATORY — so a
 *      pattern like double-star, slash, star, ".ts" (which must ALSO match a root-level file
 *      with zero directories, e.g. `top.ts`, per standard glob semantics) could never match
 *      anything without a slash in it. Double-star-then-slash has to be recognized as ONE unit
 *      and translated to an OPTIONAL group.
 * A bare double-star not immediately followed by a slash still means "cross any depth" (`.*`);
 * `?` is a single-char wildcard, matching standard glob conventions.
 */
function globToRegex(pattern: string): RegExp {
  let out = "";
  let i = 0;
  while (i < pattern.length) {
    if (pattern[i] === "*" && pattern[i + 1] === "*") {
      if (pattern[i + 2] === "/") {
        out += "(?:.*/)?";
        i += 3;
      } else {
        out += ".*";
        i += 2;
      }
      continue;
    }
    const c = pattern[i]!;
    if (c === "*") out += "[^/]*";
    else if (c === "?") out += "[^/]";
    else if (".+^${}()|[]\\".includes(c)) out += "\\" + c;
    else out += c;
    i++;
  }
  return new RegExp(`^${out}$`);
}

async function globWorkspace(
  ctx: PrebuiltOpContext,
  pattern: string | undefined,
  pathPrefix = ""
): Promise<{ path: string; files: string[]; count: number; truncated: boolean }> {
  const prefix = key(ctx, pathPrefix);
  const wsPrefix = workspacePrefix(ctx.env);
  const allFiles: string[] = [];
  let cursor: string | undefined;
  let truncated = false;
  const CAP = 2000;
  do {
    const listing = await bucket(ctx).list(cursor ? { prefix, cursor } : { prefix });
    for (const obj of listing.objects) {
      if (obj.key.endsWith("/.keep")) continue;
      allFiles.push(obj.key.slice(wsPrefix.length));
      if (allFiles.length >= CAP) { truncated = true; break; }
    }
    cursor = listing.truncated && !truncated ? listing.cursor : undefined;
  } while (cursor);

  if (!pattern || pattern === "*" || pattern === "**") {
    return { path: pathPrefix, files: allFiles, count: allFiles.length, truncated };
  }
  const re = globToRegex(pattern);
  const filtered = allFiles.filter((f) => re.test(f));
  return { path: pathPrefix, files: filtered, count: filtered.length, truncated };
}

export const r2Workspace: PrebuiltScript = {
  name: "r2-workspace",
  description:
    "Read, write, list, delete, copy and move files in the agent's R2 workspace. read_file " +
    "supports chunked byte reads (offset/length) for files too big to read at once; stat_file " +
    "checks size first; search_file finds matching lines inside ONE named file. Read/Edit/Write/" +
    "Grep/Glob are the same workspace through a Claude-Code-shaped lens: Read is a line-numbered " +
    "windowed view, Edit is a surgical exact-text replace, Grep searches ACROSS every file (not " +
    "just one), Glob lists paths matching a pattern like '**/*.ts'.",
  domain: "filesystem",
  requires_tier: 1,
  paramHints: {
    read_file:
      "path (string, REQUIRED). offset (number, optional) + length (number, optional) — read ONLY " +
      "that byte range, the way to read a file bigger than the read limit: start at offset 0, then " +
      "pass the next_offset the result returns until has_more is false. Omit both for a full read " +
      "(refused with too_large if the file exceeds the limit — then use offset/length or search_file).",
    stat_file: "path (string, REQUIRED). Returns size + whether it's readable in one call — call this " +
      "BEFORE read_file on anything that might be large.",
    search_file:
      "path (string, REQUIRED). query (string, REQUIRED — a substring, matched case-insensitively). " +
      "context (number, optional, 0-10) — lines of surrounding context per match. Returns matching " +
      "lines with line numbers; many matches are paged automatically.",
    write_file: "path (string, REQUIRED). content (string, REQUIRED).",
    list_directory: "path (string, optional — a prefix; omit for the whole workspace).",
    delete_file: "path (string, REQUIRED).",
    copy_file: "from (string, REQUIRED). to (string, REQUIRED).",
    move_file: "from (string, REQUIRED). to (string, REQUIRED).",
    Read: "path (string, REQUIRED). offset (number, optional — 1-indexed LINE to start at). limit " +
      "(number, optional — line count, default/max 2000). Returns `\"<n> | <line>\"` text, LINE " +
      "numbers not bytes — different from read_file's byte offset/length. Refused past 5MB; use " +
      "Grep or read_file's byte-chunked reads on anything bigger.",
    Edit: "path (string, REQUIRED). oldString (string, REQUIRED — the EXACT text to replace, must " +
      "match exactly once). newString (string, REQUIRED). Read the file first if unsure of the " +
      "exact current text — a near-miss returns nearby lines as a hint, never guesses.",
    Write: "path (string, REQUIRED). content (string, REQUIRED). Identical to write_file.",
    Grep: "pattern (string, REQUIRED — a regular expression). path (string, optional — a prefix to " +
      "search under; omit for the whole workspace). Searches every file under the prefix, not one " +
      "— for one named file use search_file instead.",
    Glob: "pattern (string, optional — e.g. '**/*.ts'; omit or '*'/'**' for every file). path " +
      "(string, optional prefix).",
  },
  operations: {
    async read_file(args, ctx) {
      const path = reqStr(args, "path");
      const k = key(ctx, path);

      // Step 3: chunked/ranged read. When offset and/or length are given, read only that byte
      // range — the way to read a file LARGER than the single-read cap, a slice at a time. The
      // returned chunk is byte-bounded by the cap; has_more/next_offset tell the agent how to
      // page through the rest (same convention as the tool-result paginator). A ranged R2 get()
      // still reports the FULL object size in `.size`, so no separate head() is needed.
      const offset = numArg(args, "offset");
      const length = numArg(args, "length");
      if (offset !== undefined || length !== undefined) {
        const off = Math.max(0, offset ?? 0);
        const len = Math.min(length ?? MAX_READABLE_FILE_BYTES, MAX_READABLE_FILE_BYTES);
        const obj = await bucket(ctx).get(k, { range: { offset: off, length: len } });
        if (!obj) return { exists: false, content: null };
        const total = obj.size;
        if (off >= total) {
          return { exists: true, content: "", offset: off, length: 0, total_size: total, has_more: false };
        }
        const content = await obj.text();
        // Byte-accurate next offset (content.length is chars, which drifts for multibyte UTF-8).
        const bytesRead = Math.min(len, total - off);
        const end = off + bytesRead;
        const hasMore = end < total;
        return {
          exists: true,
          content,
          offset: off,
          length: bytesRead,
          total_size: total,
          has_more: hasMore,
          ...(hasMore ? { next_offset: end } : {}),
        };
      }

      // Full read. get() returns the object with its real `.size` metadata, so the oversize check
      // still happens before the body is materialized into a payload that could blow the turn.
      const obj = await bucket(ctx).get(k);
      if (!obj) return { exists: false, content: null };
      if (obj.size > MAX_READABLE_FILE_BYTES) {
        return {
          exists: true,
          content: null,
          size: obj.size,
          too_large: true,
          message: `This file is ${obj.size} bytes, over the ${MAX_READABLE_FILE_BYTES}-byte limit for a single read. Read it in chunks with read_file(path, offset, length) — start at offset 0, then use the next_offset it returns — or use search_file(path, query) to jump straight to the part you need.`,
        };
      }
      return { exists: true, content: await obj.text(), size: obj.size };
    },
    // Step 3: search WITHIN a file and get back only the matching lines (with line numbers, and
    // optional surrounding context) instead of pulling the whole file. Many matches are paged by
    // the generic tool-result paginator, so a broad query never overflows the turn. For a file too
    // large even to scan in one pass, use read_file's chunked offset/length reads.
    async search_file(args, ctx) {
      const path = reqStr(args, "path");
      const query = reqStr(args, "query");
      const k = key(ctx, path);
      const head = await bucket(ctx).head(k);
      if (!head) return { exists: false };
      if (head.size > MAX_SEARCHABLE_FILE_BYTES) {
        return {
          exists: true,
          too_large: true,
          size: head.size,
          message: `This file is ${head.size} bytes, over the ${MAX_SEARCHABLE_FILE_BYTES}-byte search limit. Read it in chunks with read_file(path, offset, length) and scan each chunk yourself.`,
        };
      }
      const obj = await bucket(ctx).get(k);
      if (!obj) return { exists: false };
      const text = await obj.text();
      const q = query.toLowerCase();
      const contextLines = Math.max(0, Math.min(numArg(args, "context") ?? 0, 10));
      const lines = text.split(/\r?\n/);
      const matches: Array<{ line_number: number; text: string; context?: string }> = [];
      for (let i = 0; i < lines.length; i++) {
        if ((lines[i] ?? "").toLowerCase().includes(q)) {
          const entry: { line_number: number; text: string; context?: string } = {
            line_number: i + 1,
            text: lines[i] ?? "",
          };
          if (contextLines > 0) {
            entry.context = lines.slice(Math.max(0, i - contextLines), i + contextLines + 1).join("\n");
          }
          matches.push(entry);
        }
      }
      return { exists: true, query, total_matches: matches.length, matches };
    },
    // A cheap, content-free size/existence check — call this BEFORE read_file on anything that
    // might be large (a customer upload, an export another agent produced) instead of finding out
    // the hard way.
    async stat_file(args, ctx) {
      const head = await bucket(ctx).head(key(ctx, reqStr(args, "path")));
      if (!head) return { exists: false };
      return {
        exists: true,
        size: head.size,
        uploaded: head.uploaded.toISOString(),
        readable: head.size <= MAX_READABLE_FILE_BYTES,
      };
    },

    async write_file(args, ctx) {
      const path = reqStr(args, "path");
      const content = args["content"];
      if (typeof content !== "string") throw new Error("'content' (string) is required");
      await bucket(ctx).put(key(ctx, path), content, {
        customMetadata: { updatedAt: Date.now().toString() },
      });
      // The file IS the handoff between projects: one project's agent records what it found,
      // that write fires an event, and a no-code rule wakes whoever owns the next stage. Fired
      // after the write actually succeeded, and never awaited — a listener failing must not turn
      // a successful write into a failed one.
      ctx.env.onWorkspaceChange?.({ path, operation: "write" });
      return { ok: true, path };
    },

    async list_directory(args, ctx) {
      const prefix = key(ctx, typeof args["path"] === "string" ? (args["path"] as string) : "");
      const out: Array<{ key: string; size: number; uploaded: string }> = [];
      let cursor: string | undefined;
      do {
        const listing = await bucket(ctx).list(cursor ? { prefix, cursor } : { prefix });
        for (const o of listing.objects) {
          out.push({ key: o.key, size: o.size, uploaded: o.uploaded.toISOString() });
        }
        cursor = listing.truncated ? listing.cursor : undefined;
      } while (cursor);
      return { files: out, count: out.length };
    },

    async delete_file(args, ctx) {
      const path = reqStr(args, "path");
      await bucket(ctx).delete(key(ctx, path));
      ctx.env.onWorkspaceChange?.({ path, operation: "delete" });
      return { ok: true };
    },

    async copy_file(args, ctx) {
      const from = await bucket(ctx).get(key(ctx, reqStr(args, "from")));
      if (!from) throw new Error("source file not found");
      await bucket(ctx).put(key(ctx, reqStr(args, "to")), from.body);
      return { ok: true };
    },

    async move_file(args, ctx) {
      const fromKey = key(ctx, reqStr(args, "from"));
      const from = await bucket(ctx).get(fromKey);
      if (!from) throw new Error("source file not found");
      await bucket(ctx).put(key(ctx, reqStr(args, "to")), from.body);
      await bucket(ctx).delete(fromKey);
      return { ok: true };
    },

    // ── Claude-Code-shaped REPL primitives — same workspace, different lens (see file header) ──
    async Read(args, ctx) {
      return readWindowed(ctx, reqStr(args, "path"), numArg(args, "offset"), numArg(args, "limit"));
    },
    async Edit(args, ctx) {
      const newString = args["newString"];
      return editFile(
        ctx,
        reqStr(args, "path"),
        reqStr(args, "oldString"),
        typeof newString === "string" ? newString : ""
      );
    },
    async Write(args, ctx) {
      return writeFileImpl(ctx, reqStr(args, "path"), reqStr(args, "content"));
    },
    async Grep(args, ctx) {
      const p = args["path"];
      return grepWorkspace(ctx, reqStr(args, "pattern"), typeof p === "string" ? p : "");
    },
    async Glob(args, ctx) {
      const pattern = args["pattern"];
      const p = args["path"];
      return globWorkspace(
        ctx,
        typeof pattern === "string" ? pattern : undefined,
        typeof p === "string" ? p : ""
      );
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/revenue-tracker.ts">
/**
 * revenue-tracker — the Whop-native business revenue tracker (go-live monetization pass).
 *
 * Problem: a business whose real sales happen on a platform Naelao never custodies money
 * through (most commonly Whop) has no natural point for the P0-5 wallet-settlement mechanism
 * (settleOrderToWallet) to apply — there is no Naelao checkout, no Naelao webhook, no ledger
 * entry Naelao ever sees. This is the fix: periodically read the business's OWN reported gross
 * revenue (read-only) and store a snapshot the billing worker can bill a builder-configured cut
 * % against (see docs/spec-appendix for the full surcharge design).
 *
 * Deliberately does NOT invent a new credential or connector mechanism — Whop is already
 * reachable through the existing mcp-connector prebuilt exactly as any other connector is
 * (`mcp.register("whop", ..., credential_name: "whop_api_key")` once, then this reads its
 * `list_payments` op). This prebuilt reuses mcp-connector's own hub-request helpers rather than
 * going through a second script.run hop, so the credential-resolution/SSRF-guard/audit-trail
 * machinery mcp-hub already owns is exercised identically to every other connector call.
 *
 * Gross revenue only, never profit — profit/COGS is builder-self-reported and independently
 * unverifiable, so it is deliberately never exposed as a billing basis (see the surcharge design
 * doc for the full reasoning).
 *
 * Whop's exact `list_payments` response shape (field names for amount/status/paid-at) should be
 * verified against current Whop API docs before this handles real production traffic — matching
 * connector-whop's own header comment precedent ("verify against current Whop docs before
 * enabling writes in production") for exactly this kind of live-API assumption. This tries a
 * short list of plausible field names and skips anything it can't confidently parse as cents,
 * rather than guessing and reporting a wrong number.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { hubFetch, resolveServerId } from "./mcp-connector.js";
import { mintInternalToken } from "@naelao/http";

interface WhopPayment {
  status?: string;
  // Plausible amount field names across Whop API versions — cents, integer.
  final_amount?: number;
  amount?: number;
  subtotal?: number;
  // F-26: plausible created/paid timestamp field names — used to keep only payments inside the
  // period being snapshotted. Whop returns either an ISO string or a unix-seconds integer.
  created_at?: string | number;
  paid_at?: string | number;
  settled_at?: string | number;
}

/** Sum only payments that look genuinely completed — skip anything pending/failed/refunded so a
 *  period's revenue reflects money the business actually received, not attempted charges. */
function isCompletedPayment(p: WhopPayment): boolean {
  const status = (p.status ?? "").toLowerCase();
  return status === "" || status === "paid" || status === "completed" || status === "succeeded";
}

function extractAmountCents(p: WhopPayment): number | null {
  const raw = p.final_amount ?? p.amount ?? p.subtotal;
  if (typeof raw !== "number" || !Number.isFinite(raw) || raw < 0) return null;
  return Math.round(raw);
}

/** F-26: parse a Whop timestamp (ISO string or unix seconds) to epoch millis, or null if absent. */
function extractPaidAtMs(p: WhopPayment): number | null {
  const raw = p.paid_at ?? p.settled_at ?? p.created_at;
  if (typeof raw === "number" && Number.isFinite(raw)) return raw > 1e12 ? raw : raw * 1000; // secs vs ms
  if (typeof raw === "string") {
    const t = Date.parse(raw);
    return Number.isNaN(t) ? null : t;
  }
  return null;
}

/** F-26: the [start, end) epoch-ms bounds of a "YYYY-MM" period (UTC). */
function periodBounds(period: string): { startMs: number; endMs: number } {
  const [y, m] = period.split("-").map((n) => parseInt(n, 10));
  const startMs = Date.UTC(y!, m! - 1, 1);
  const endMs = Date.UTC(m! === 12 ? y! + 1 : y!, m! === 12 ? 0 : m!, 1);
  return { startMs, endMs };
}

async function fetchWhopRevenueThisPeriod(ctx: PrebuiltOpContext, period: string): Promise<number> {
  const serverId = await resolveServerId(ctx, "whop");
  const { startMs, endMs } = periodBounds(period);
  let totalCents = 0;
  // Bounded pagination — a v1 cap, not a promise of exhaustive historical accuracy. A business
  // with more than this many payments in one month needs a more scalable tracking mechanism than
  // a synchronous prebuilt call; documented limitation, not a silent undercount hazard (partial
  // data would understate revenue, which understates the builder's cut too — the conservative
  // direction if this cap is ever actually hit).
  const MAX_PAGES = 5;
  for (let page = 1; page <= MAX_PAGES; page++) {
    const result = (await hubFetch(ctx, `/mcp-servers/${serverId}/tools/call`, {
      method: "POST",
      // Matches mcp-connector's mcp.call contract exactly (tool_name/input) — this bypasses that
      // op only to avoid a second script.run hop, not to invent a different hub request shape.
      // F-26: also request a server-side created-at range so the API returns only this period's
      // payments where it supports it (field names per Whop docs may vary — this is best-effort;
      // the client-side window filter below is the AUTHORITATIVE guarantee regardless).
      body: {
        tool_name: "list_payments",
        input: {
          page, per: 100, status: "paid",
          "created_at[gte]": Math.floor(startMs / 1000),
          "created_at[lt]": Math.floor(endMs / 1000),
        },
      },
    })) as { data?: WhopPayment[] } | WhopPayment[];
    const payments = Array.isArray(result) ? result : (result.data ?? []);
    if (payments.length === 0) break;

    for (const p of payments) {
      if (!isCompletedPayment(p)) continue;
      // F-26 (root cause): the previous version summed EVERY completed payment across all time,
      // so each monthly snapshot was the business's all-time revenue — re-billed the cut every
      // month. Only count a payment whose paid/created timestamp falls INSIDE the snapshot period.
      // A payment with no parseable timestamp is skipped (conservative: understates, never
      // over-bills) rather than assumed in-period.
      const paidAtMs = extractPaidAtMs(p);
      if (paidAtMs === null || paidAtMs < startMs || paidAtMs >= endMs) continue;
      const cents = extractAmountCents(p);
      if (cents !== null) totalCents += cents;
    }
    if (payments.length < 100) break; // last page
  }
  return totalCents;
}

async function postSnapshot(ctx: PrebuiltOpContext, period: string, revenueCents: number): Promise<unknown> {
  if (!ctx.env.spacesWorker) throw new Error("revenue-tracker unavailable: spaces worker binding not configured");
  const token = await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId);
  const resp = await ctx.env.spacesWorker.fetch(
    new Request(`http://spaces-worker/spaces/${ctx.env.spaceId}/revenue-tracking`, {
      method: "POST",
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": token,
      },
      body: JSON.stringify({ period, provider: "whop", revenue_cents: revenueCents }),
    })
  );
  if (!resp.ok) throw new Error(`revenue-tracker: failed to record snapshot (${resp.status})`);
  return resp.json();
}

export const revenueTracker: PrebuiltScript = {
  name: "revenue-tracker",
  description:
    "Track a business's own reported revenue on external platforms (Whop) that Naelao never " +
    "custodies money through, so a builder-configured revenue-cut % can be billed as a surcharge.",
  domain: "commerce",
  requires_tier: 2,
  operations: {
    // revenue.track_whop — pull this calendar month's (or an explicit period's) completed Whop
    // payments and record the snapshot. Read-only against Whop; the only write is the SpaceDO
    // snapshot itself.
    "revenue.track_whop": async (args, ctx) => {
      const period = typeof args["period"] === "string" && /^\d{4}-\d{2}$/.test(args["period"])
        ? (args["period"] as string)
        : new Date().toISOString().slice(0, 7);

      const revenueCents = await fetchWhopRevenueThisPeriod(ctx, period);
      return postSnapshot(ctx, period, revenueCents);
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/schedule.ts">
/**
 * schedule (step 12) — lets an agent wake ITSELF later with a follow-up goal, and list/cancel its
 * scheduled wakes. This is the "cron tool to set a trigger that wakes it after ~X" primitive from
 * the ask: the pattern is "kick off a long/background job (a sub-agent, a workflow, an external
 * task), do whatever else there is, and if there's nothing left to do but wait, schedule a wake to
 * come back and check on it" — the way Claude Code checks back on a background task.
 *
 * Implemented on the EXISTING goal-based scheduled_jobs dispatcher (migration 0043), NOT a second
 * scheduler: a due wake calls wakeAgentGoal against this same agent's own DO with the follow-up
 * goal, exactly as the seeded revenue-review cron does. A delay-based wake is one-shot — it fires
 * once (params._one_shot, which the dispatcher disables after firing) rather than recurring. A
 * `cron`-based wake is a real recurring schedule.
 *
 * Granularity: the platform sweeps scheduled jobs on an HOURLY heartbeat, so a wake scheduled
 * sooner than the next heartbeat fires on that next heartbeat (the dispatcher's isCronDue scans
 * the window since last_run_at, so it still fires — just no finer than ~hourly). wake_me says this.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";

async function spacesCall(
  ctx: PrebuiltOpContext,
  method: string,
  path: string,
  body?: Record<string, unknown>
): Promise<{ ok: boolean; status: number; json: unknown }> {
  if (!ctx.env.spacesWorker) throw new Error("schedule unavailable: spaces worker binding not configured");
  const token = await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId);
  const resp = await ctx.env.spacesWorker.fetch(
    new Request(`http://spaces-worker${path}`, {
      method,
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": token,
        ...(ctx.env.userId ? { "x-naelao-user-id": ctx.env.userId } : {}),
      },
      ...(body ? { body: JSON.stringify(body) } : {}),
    })
  );
  const json = await resp.json().catch(() => ({}));
  return { ok: resp.ok, status: resp.status, json };
}

function numArg(a: Record<string, unknown>, name: string): number | undefined {
  const v = a[name];
  if (typeof v === "number" && Number.isFinite(v)) return v;
  if (typeof v === "string" && v.trim() !== "" && Number.isFinite(Number(v))) return Number(v);
  return undefined;
}

/** A one-shot cron for a specific UTC minute ~delayMinutes from now: minute/hour/day-of-month/
 *  month pinned (fires at that date+time), day-of-week wildcard. Combined with params._one_shot,
 *  the dispatcher disables it after the first fire so it never recurs. */
export function cronForDelay(delayMinutes: number, now: Date = new Date()): string {
  const target = new Date(now.getTime() + Math.max(0, delayMinutes) * 60_000);
  return `${target.getUTCMinutes()} ${target.getUTCHours()} ${target.getUTCDate()} ${target.getUTCMonth() + 1} *`;
}

export const schedule: PrebuiltScript = {
  name: "schedule",
  description:
    "Wake yourself later with a follow-up goal (a cron trigger you set), and list or cancel your " +
    "scheduled wakes. Use this to check back on a long/background task (a sub-agent, a workflow, " +
    "an external job) after doing everything else: schedule a wake for roughly when you expect it " +
    "to be ready, then end this run; the wake re-runs you with the follow-up goal so you can check.",
  domain: "orchestration",
  requires_tier: 1,
  paramHints: {
    "schedule.wake_me":
      "goal (string, REQUIRED — the follow-up instruction to run when you wake, e.g. \"check " +
      "whether the research sub-agent finished and summarize it\"). ONE of: delay_minutes " +
      "(number) / delay_hours (number) for a one-shot wake, OR cron (5-field string) for a " +
      "recurring schedule. name (string, optional). Note: wakes fire on the platform's hourly " +
      "heartbeat, so anything sooner than ~1 hour fires on the next heartbeat.",
    "schedule.list": "no parameters. Lists your scheduled wakes/jobs in this project (or space-wide).",
    "schedule.cancel": "id (string, REQUIRED — a job id from schedule.list).",
  },
  operations: {
    "schedule.wake_me": async (a, c) => {
      const goal = String(a["goal"] ?? "").trim();
      if (!goal) throw new Error("schedule.wake_me requires a goal (what to do when you wake)");
      const explicitCron = typeof a["cron"] === "string" ? (a["cron"] as string).trim() : "";
      const delayMinutes = numArg(a, "delay_minutes");
      const delayHours = numArg(a, "delay_hours");
      let cron: string;
      let oneShot = false;
      if (explicitCron) {
        cron = explicitCron;
      } else if (delayHours !== undefined || delayMinutes !== undefined) {
        const mins = (delayHours ?? 0) * 60 + (delayMinutes ?? 0);
        if (mins <= 0) throw new Error("delay must be positive");
        cron = cronForDelay(mins);
        oneShot = true;
      } else {
        throw new Error("schedule.wake_me requires either delay_minutes/delay_hours or a cron expression");
      }
      const name = typeof a["name"] === "string" && a["name"] ? (a["name"] as string) : `wake: ${goal.slice(0, 40)}`;
      const res = await spacesCall(c, "POST", `/spaces/${c.env.spaceId}/scheduled-jobs`, {
        name,
        cron_expression: cron,
        goal,
        agent_id: c.env.agentId,
        ...(c.env.projectId ? { project_id: c.env.projectId } : {}),
        ...(oneShot ? { params: { _one_shot: true } } : {}),
      });
      if (!res.ok) return { ok: false, error: `failed to schedule wake: HTTP ${res.status}` };
      const created = res.json as { id?: string };
      return {
        ok: true,
        id: created.id ?? null,
        cron_expression: cron,
        one_shot: oneShot,
        note: oneShot
          ? "Scheduled a one-shot wake. It fires on the next hourly heartbeat at or after the target time, then disables itself."
          : "Scheduled a recurring wake. Use schedule.cancel with the id when it's no longer needed.",
      };
    },
    "schedule.list": async (_a, c) => {
      const qs = c.env.projectId ? `?project_id=${encodeURIComponent(c.env.projectId)}` : "";
      const res = await spacesCall(c, "GET", `/spaces/${c.env.spaceId}/scheduled-jobs${qs}`);
      if (!res.ok) return { ok: false, error: `failed to list wakes: HTTP ${res.status}` };
      return res.json;
    },
    "schedule.cancel": async (a, c) => {
      const id = String(a["id"] ?? "").trim();
      if (!id) throw new Error("schedule.cancel requires an id");
      const res = await spacesCall(c, "DELETE", `/spaces/${c.env.spaceId}/scheduled-jobs/${encodeURIComponent(id)}`);
      if (!res.ok) return { ok: false, error: `failed to cancel wake ${id}: HTTP ${res.status}` };
      return { ok: true, cancelled: id };
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/skill-manager.ts">
/**
 * skill-manager — the agent's own view of, and control over, the skills it has learned.
 *
 * The engine already records outcomes, derives a health verdict (skill-health.ts), demotes a
 * failing skill in `script.find`, and refuses to auto-run one at L1. That is the automatic half
 * of the loop, and it is enough to stop a broken skill being picked. It is NOT enough to get the
 * skill fixed: nothing decides to repair a skill that isn't currently being reached for, nothing
 * removes one that will never work again, and nothing shares one that has genuinely proven out.
 *
 * Those are judgment calls, which on this platform means they belong to the agent rather than to
 * a hardcoded sweep. So this is a real tool surface over the library:
 *
 *   skill.health    — what has been going wrong, what's proven, what's worth sharing
 *   skill.inspect   — one skill in full: version, health, patch history, recent errors
 *   skill.rollback  — undo a patch that made things worse
 *   skill.retire    — delete a skill that is beyond repair (and stop it being found)
 *   skill.promote   — publish a proven skill to the shared template library
 *
 * Read ops are safe and are auto-approved in guided mode. The three that change the library are
 * gated like any other mutation — retiring a skill another project depends on is exactly the kind
 * of thing an owner should get to see first.
 *
 * Promotion deliberately does NOT happen here: it needs the space's template id, which is a D1
 * lookup this DO has no binding for. `skill.promote` calls the agents worker's already-existing
 * `/skills/promote` route, which owns that lookup and the promotion threshold — one gate, not two
 * that can drift.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import type { ScriptMetadata } from "../types.js";
import { SkillLibrary } from "../skill-library.js";
import { assessSkillHealth } from "../skill-health.js";
import { isPromotable } from "../federation.js";
import { removeScriptEmbedding } from "../script-find.js";
import { mintInternalToken } from "@naelao/http";

function library(ctx: PrebuiltOpContext): SkillLibrary {
  return new SkillLibrary(ctx.env.scriptsBucket, ctx.env.spaceId);
}

/** How many recent errors to surface per skill. Enough to see a pattern, not a log dump. */
const ERRORS_SHOWN = 3;

function summarize(metadata: ScriptMetadata) {
  const health = assessSkillHealth(metadata);
  return {
    name: metadata.name,
    version: metadata.version,
    domain: metadata.domain,
    description: metadata.description,
    state: health.state,
    consecutive_failures: health.consecutive_failures,
    successes: metadata.success_count,
    failures: metadata.failure_count,
    ...(health.last_error ? { last_error: health.last_error } : {}),
    note: health.recommendation,
    promotable: isPromotable(metadata),
  };
}

async function loadAll(ctx: PrebuiltOpContext): Promise<ScriptMetadata[]> {
  const lib = library(ctx);
  const names = await lib.list();
  const metas = await Promise.all(names.map((n) => lib.readMetadata(n)));
  return metas.filter((m): m is ScriptMetadata => m !== null);
}

async function health(_a: Record<string, unknown>, ctx: PrebuiltOpContext): Promise<unknown> {
  const all = await loadAll(ctx);
  if (all.length === 0) {
    return {
      skills: [],
      count: 0,
      assessment: "No learned skills yet — nothing has been distilled in this space.",
    };
  }

  const rows = all.map(summarize);
  const broken = rows.filter((r) => r.state === "broken");
  const degrading = rows.filter((r) => r.state === "degrading");
  const promotable = rows.filter((r) => r.promotable);

  // The point of a summary is to say what to do about it, not to restate the table.
  const parts: string[] = [];
  if (broken.length > 0) {
    parts.push(
      `${broken.length} skill(s) are broken and will not be run unattended: ${broken.map((r) => r.name).join(", ")}. Fix them with a patch aimed at their last_error, or retire them.`
    );
  }
  if (degrading.length > 0) {
    parts.push(`${degrading.length} skill(s) are failing more than they should: ${degrading.map((r) => r.name).join(", ")}.`);
  }
  if (promotable.length > 0) {
    parts.push(`${promotable.length} skill(s) have proven out and could be shared with every business on this template: ${promotable.map((r) => r.name).join(", ")}.`);
  }
  if (parts.length === 0) parts.push(`All ${rows.length} learned skill(s) are healthy.`);

  return {
    skills: rows,
    count: rows.length,
    broken: broken.length,
    degrading: degrading.length,
    promotable: promotable.length,
    assessment: parts.join(" "),
  };
}

async function inspect(a: Record<string, unknown>, ctx: PrebuiltOpContext): Promise<unknown> {
  const name = String(a["name"] ?? "").trim();
  if (!name) throw new Error("skill.inspect requires a skill name");
  const stored = await library(ctx).read(name);
  if (!stored) return { found: false, name, message: `No learned skill named ${name} in this space.` };

  const m = stored.metadata;
  const recent = m.recent_outcomes ?? [];
  return {
    found: true,
    ...summarize(m),
    requires_tier: m.requires_tier,
    parameters: m.parameters,
    // The errors themselves, so a patch can be aimed rather than guessed.
    recent_errors: recent
      .filter((o) => !o.ok && o.error)
      .slice(0, ERRORS_SHOWN)
      .map((o) => ({ at: o.at, error: o.error })),
    recent_runs: recent.map((o) => ({ ok: o.ok, at: o.at })),
    patch_history: m.patch_history.map((p) => ({
      version: p.version,
      at: p.created_at,
      type: p.patch_type,
      reason: p.reason,
    })),
  };
}

async function rollback(a: Record<string, unknown>, ctx: PrebuiltOpContext): Promise<unknown> {
  const name = String(a["name"] ?? "").trim();
  if (!name) throw new Error("skill.rollback requires a skill name");
  const lib = library(ctx);
  const current = await lib.readMetadata(name);
  if (!current) return { ok: false, name, message: `No learned skill named ${name} in this space.` };
  if (current.version <= 1) {
    return { ok: false, name, message: `${name} is still on its first version — there is nothing to roll back to.` };
  }
  const target = a["to_version"] !== undefined ? Number(a["to_version"]) : current.version - 1;
  if (!Number.isInteger(target) || target < 1 || target >= current.version) {
    return { ok: false, name, message: `to_version must be a whole number between 1 and ${current.version - 1}.` };
  }
  const restored = await lib.rollback(name, target);
  return {
    ok: true,
    name,
    from_version: current.version,
    to_version: restored.version,
    message: `Rolled ${name} back to v${target}. Its health record is unchanged — run it to find out whether the older version actually works.`,
  };
}

async function retire(a: Record<string, unknown>, ctx: PrebuiltOpContext): Promise<unknown> {
  const name = String(a["name"] ?? "").trim();
  if (!name) throw new Error("skill.retire requires a skill name");
  const lib = library(ctx);
  const meta = await lib.readMetadata(name);
  if (!meta) return { ok: false, name, message: `No learned skill named ${name} in this space.` };

  await lib.delete(name);
  // Leaving the embedding behind would keep the skill turning up in script.find as a candidate
  // whose metadata no longer resolves — findable, unusable, and confusing.
  await removeScriptEmbedding(ctx.env, name);
  return {
    ok: true,
    name,
    retired_at_version: meta.version,
    message: `Retired ${name} (was v${meta.version}, ${meta.success_count} successes / ${meta.failure_count} failures). It will no longer be found or run. Anything that depended on it will need a new approach.`,
  };
}

async function promote(a: Record<string, unknown>, ctx: PrebuiltOpContext): Promise<unknown> {
  const name = String(a["name"] ?? "").trim();
  if (!name) throw new Error("skill.promote requires a skill name");
  if (!ctx.env.agentsWorker) {
    return { ok: false, name, message: "Skill promotion is not available in this environment." };
  }
  const meta = await library(ctx).readMetadata(name);
  if (!meta) return { ok: false, name, message: `No learned skill named ${name} in this space.` };
  if (!isPromotable(meta)) {
    const h = assessSkillHealth(meta);
    return {
      ok: false,
      name,
      message: `${name} is not proven enough to share yet (stability ${meta.stability_score.toFixed(2)}, ${meta.success_count} successes). ${h.recommendation}`,
    };
  }

  const resp = await ctx.env.agentsWorker.fetch(
    new Request("http://agents-worker/skills/promote", {
      method: "POST",
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId),
      },
      body: JSON.stringify({ space_id: ctx.env.spaceId, name }),
    })
  );
  const body = await resp.json<Record<string, unknown>>().catch(() => null);
  if (!resp.ok) {
    return {
      ok: false,
      name,
      message: String(body?.["message"] ?? `Could not promote ${name} (${resp.status}).`),
    };
  }
  return {
    ok: true,
    name,
    template_id: body?.["template_id"],
    message: `Promoted ${name} to the shared library — every business on this template inherits it from now on.`,
  };
}

export const skillManager: PrebuiltScript = {
  name: "skill-manager",
  description:
    "Inspect and maintain the skills this space has learned: see which are working, which are broken and why, roll back a bad patch, retire one that is beyond repair, or share a proven one with every business on this template.",
  domain: "compute",
  requires_tier: 1,
  operations: {
    "skill.health": health,
    "skill.inspect": inspect,
    "skill.rollback": rollback,
    "skill.retire": retire,
    "skill.promote": promote,
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/storefront.ts">
/**
 * storefront (spec §11 external portal) — provision a Naelao-hosted, multitenant storefront.
 * Tier 2.
 *
 * Architecture (Cloudflare for SaaS, confirmed against CF docs): storefronts are NOT a
 * Worker-per-tenant. They are ONE multitenant surface — a CF Pages static shell fronted by
 * the portal Worker (the fallback origin) which routes by Host header. Provisioning a
 * storefront therefore does not deploy anything; it just:
 *   1. allocates {slug}.naelao.com (covered by the zone's wildcard cert — no per-tenant cert)
 *   2. records a business_services row (space_id, kind='storefront', naelao_handle)
 *   3. registers the Host→spaceId route the portal Worker reads
 *
 * Custom domains are opt-in (productConfig.commerce.allowCustomDomain). They use the
 * Cloudflare for SaaS custom_hostnames API: the customer CNAMEs their domain to the
 * fallback origin and CF issues a DV cert. Until DNS validates, status is 'pending_dns'.
 *
 * Operations:
 *   storefront.provision(slug?)            → { handle: "{slug}.naelao.com", status }
 *   storefront.set_custom_domain(domain)   → { custom_domain, status: "pending_dns", dns }
 *   storefront.status()                    → current storefront service record
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";

async function bizService(
  ctx: PrebuiltOpContext,
  method: "POST" | "GET",
  body?: Record<string, unknown>
): Promise<unknown> {
  if (!ctx.env.spacesWorker) throw new Error("storefront unavailable: spaces worker binding not configured");
  const init: RequestInit = {
    method,
    headers: {
      "content-type": "application/json",
      "x-naelao-tenant-id": ctx.env.tenantId,
      "x-naelao-internal-token": await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId),
    },
  };
  if (body) init.body = JSON.stringify({ space_id: ctx.env.spaceId, ...body });
  const path = method === "GET"
    ? `/internal/business-services?space_id=${encodeURIComponent(ctx.env.spaceId)}&kind=storefront`
    : `/internal/business-services`;
  const resp = await ctx.env.spacesWorker.fetch(new Request(`http://spaces-worker${path}`, init));
  if (!resp.ok) throw new Error(`storefront op failed: ${resp.status} ${await resp.text()}`);
  return resp.json();
}

/** Normalise a free-text name into a DNS-safe slug. */
function toSlug(input: string): string {
  return (input || "shop").toLowerCase().replace(/[^a-z0-9-]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 40) || "shop";
}

export const storefront: PrebuiltScript = {
  name: "storefront",
  description:
    "Provision a Naelao-hosted storefront at {slug}.naelao.com (multitenant CF Pages + Worker) " +
    "and optionally attach the owner's custom domain via Cloudflare for SaaS.",
  domain: "api",
  requires_tier: 2,
  paramHints: {
    "storefront.provision": "slug (or name, slugified automatically) is optional — defaults to 'shop'. This is the {slug}.naelao.com handle, not a domain.",
    "storefront.set_custom_domain": "domain is required, e.g. 'shop.example.com'. A SEPARATE operation from storefront.provision — calling provision again after this would drop the custom domain, never re-provision to change a domain.",
  },
  operations: {
    "storefront.provision": (a, c) =>
      bizService(c, "POST", { kind: "storefront", slug: toSlug(String(a["slug"] ?? a["name"] ?? "shop")) }),
    "storefront.set_custom_domain": (a, c) =>
      // Custom domains are a separate business_services row (kind='custom_domain'); this is what
      // triggers the Cloudflare-for-SaaS apply (createCustomHostname + TXT DCV) on the spaces
      // worker. Posting kind='storefront' here would drop the domain and allocate a handle.
      bizService(c, "POST", { kind: "custom_domain", custom_domain: String(a["domain"] ?? "") }),
    "storefront.status": (_a, c) => bizService(c, "GET"),
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/sub-agent.ts">
/**
 * sub-agent (spec §12.1) — spawn and coordinate sub-agents for parallel task execution.
 * Operations: agent.spawn, agent.send, agent.receive, agent.terminate.
 *
 * Spawning a sub-agent needs the NaelaoAgentDO namespace, which the engine does not own,
 * so these operations delegate to host-provided orchestration hooks. When the host has
 * not wired them, the operation reports itself unavailable (honest degradation).
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import type { OrchestrationHooks } from "../types.js";
import {
  ALLOWED_MODELS,
  DEFAULT_WORKING_MODEL,
  capabilityForModel,
  contextWindowForModel,
  benchmarkForModel,
  isAllowedModel,
  suggestModels,
} from "@naelao/billing-core";

function hooks(ctx: PrebuiltOpContext): OrchestrationHooks {
  return ctx.env.orchestration ?? {};
}

export const subAgent: PrebuiltScript = {
  name: "sub-agent",
  description:
    "Spawn, message, and terminate sub-agents for parallel work, and see which models a spawn " +
    "can actually be given.",
  domain: "orchestration",
  requires_tier: 2,
  paramHints: {
    "agent.spawn":
      "tasks (array, required) — each {goal, model?, maxTokens?}. `model` must be one from " +
      "agent.list_models; an unavailable or too-expensive one is clamped to what the current " +
      "Effort setting allows and the result says so. Omit it to let the platform choose.",
    "agent.list_models":
      "No arguments. Returns every model a spawn may name, with its context window, whether it " +
      "supports a thinking budget, and its cost tier — call this before guessing a model id.",
  },
  operations: {
    // Every op that takes a model needs a way to find out what the real ones are. Without this an
    // agent either guesses an id (and gets a provider 404) or never sets one at all, which makes
    // the whole per-task model choice unusable in practice.
    async "agent.list_models"() {
      return {
        default: DEFAULT_WORKING_MODEL,
        models: ALLOWED_MODELS.map((m) => {
          const cap = capabilityForModel(m);
          const bench = benchmarkForModel(m);
          return {
            id: m,
            family: bench?.family ?? null,
            cost_tier: bench?.costTier ?? null,
            context_window: contextWindowForModel(m),
            supports_thinking: cap.reasoningLevels.length > 0,
            thinking_levels: cap.reasoningLevels,
            best_for: bench?.bestFor ?? [],
          };
        }),
      };
    },
    async "agent.spawn"(args, ctx) {
      const h = hooks(ctx);
      if (!h.spawnSubAgent) return { ok: false, reason: "sub-agent spawning not available in this environment" };
      // Validate any explicitly-named model BEFORE delegating. A wrong id must get a real
      // "not available / did you mean" answer, not a silent clamp (which read as a misleading
      // "too expensive for your Effort" reason, since resolveEscalationModel can't tell an
      // invalid id from a valid-but-pricey one) and never a bare provider 404 down the line.
      // This is the model-selector's own allowlist — the same list agent.list_models returns.
      const tasks = Array.isArray(args["tasks"]) ? (args["tasks"] as Array<Record<string, unknown>>) : [];
      for (const t of tasks) {
        const m = t && typeof t["model"] === "string" ? (t["model"] as string) : "";
        if (m && !isAllowedModel(m)) {
          const suggestions = suggestModels(m);
          return {
            ok: false,
            error:
              `model "${m}" is not available.` +
              (suggestions.length ? ` Did you mean: ${suggestions.join(", ")}?` : "") +
              ` Call agent.list_models to see every model a spawn may name (omit "model" to let the platform choose).`,
            did_you_mean: suggestions,
            available_models: ALLOWED_MODELS as readonly string[],
          };
        }
      }
      return await h.spawnSubAgent(args);
    },
    async "agent.send"(args, ctx) {
      const h = hooks(ctx);
      if (!h.sendToSubAgent) return { ok: false, reason: "sub-agent messaging not available" };
      return await h.sendToSubAgent(String(args["id"] ?? ""), args["task"]);
    },
    async "agent.receive"(args, ctx) {
      const h = hooks(ctx);
      if (!h.receiveFromSubAgent) return { ok: false, reason: "sub-agent receive not available" };
      return await h.receiveFromSubAgent(String(args["id"] ?? ""));
    },
    async "agent.terminate"(args, ctx) {
      const h = hooks(ctx);
      if (!h.terminateSubAgent) return { ok: false, reason: "sub-agent terminate not available" };
      await h.terminateSubAgent(String(args["id"] ?? ""));
      return { ok: true };
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/tasks.ts">
/**
 * tasks (AVOS plan step 4) — a per-project task DAG for multi-agent coordination, distinct from
 * project_journal's own todos (project-journal.ts): a journal todo is a loose personal checklist
 * item (text + done, no dependency graph, no assignment) — fine for "what I still need to do,"
 * useless for "my task is blocked on a DIFFERENT agent finishing theirs." A task here can declare
 * `dependencies` (other task ids) and an `assigned_agent`, and task.start refuses to move a task
 * to in_progress until every dependency is actually completed — the DAG's edges are enforced
 * HERE, in this prebuilt, not trusted to the model's own bookkeeping (the same "structure over
 * prompts" reasoning as every other hard gate in this engine).
 *
 * Storage is SpaceDO's own `tasks` table (dumb CRUD; see SpaceDO.ts's own header on that split).
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";

interface TaskRow {
  id: string;
  space_id: string;
  project_id: string | null;
  thread_id: string | null;
  title: string;
  status: "pending" | "in_progress" | "completed" | "blocked" | "cancelled";
  dependencies: string[];
  assigned_agent: string | null;
  created_at: string;
  updated_at: string;
}

async function spacesCall(
  ctx: PrebuiltOpContext,
  method: string,
  path: string,
  body?: Record<string, unknown>
): Promise<{ ok: boolean; status: number; json: unknown }> {
  if (!ctx.env.spacesWorker) throw new Error("tasks unavailable: spaces worker binding not configured");
  const token = await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId);
  const resp = await ctx.env.spacesWorker.fetch(
    new Request(`http://spaces-worker${path}`, {
      method,
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": token,
        // Act on behalf of the person who asked, when there is one — same reasoning as
        // schedule.ts/project-coordination.ts's own spacesCall: correct attribution, and the
        // assistant is clamped to what that person could do unaided.
        ...(ctx.env.userId ? { "x-naelao-user-id": ctx.env.userId } : {}),
      },
      ...(body ? { body: JSON.stringify(body) } : {}),
    })
  );
  const json = await resp.json().catch(() => ({}));
  return { ok: resp.ok, status: resp.status, json };
}

async function listRaw(ctx: PrebuiltOpContext, filters: Record<string, string> = {}): Promise<TaskRow[]> {
  const qs = new URLSearchParams({ ...(ctx.env.projectId ? { project_id: ctx.env.projectId } : {}), ...filters });
  const res = await spacesCall(ctx, "GET", `/spaces/${ctx.env.spaceId}/tasks?${qs.toString()}`);
  if (!res.ok) return [];
  return ((res.json as { data?: TaskRow[] }).data ?? []) as TaskRow[];
}

function reqId(a: Record<string, unknown>): string {
  const id = String(a["id"] ?? "").trim();
  if (!id) throw new Error("'id' (a task id from task.list) is required");
  return id;
}

async function setStatus(ctx: PrebuiltOpContext, id: string, status: TaskRow["status"]): Promise<unknown> {
  const res = await spacesCall(ctx, "PATCH", `/spaces/${ctx.env.spaceId}/tasks/${encodeURIComponent(id)}`, { status });
  if (!res.ok) return { ok: false, error: `failed to update task ${id}: HTTP ${res.status}` };
  return { ok: true, task: res.json };
}

export const tasks: PrebuiltScript = {
  name: "tasks",
  description:
    "A task DAG for coordinating work ACROSS agents in this project — declare a task, say what " +
    "it depends on and who owns it, and task.start refuses to begin it until its dependencies " +
    "are actually completed. Use project_journal for your own running notes; use this when " +
    "another agent's work genuinely depends on knowing this one is done.",
  domain: "orchestration",
  requires_tier: 1,
  paramHints: {
    "task.create": "title (string, REQUIRED). dependencies (string[], optional — other task ids " +
      "this one can't start until they're completed). assigned_agent (string, optional — an " +
      "agent id from thread.list_project_agents). thread_id (string, optional).",
    "task.start": "id (string, REQUIRED — from task.list). Refused (status stays 'pending') if any " +
      "dependency isn't completed yet.",
    "task.complete": "id (string, REQUIRED).",
    "task.block": "id (string, REQUIRED).",
    "task.list": "status (string, optional — pending/in_progress/completed/blocked/cancelled). " +
      "thread_id (string, optional). Omit both to list every task in this project.",
  },
  operations: {
    async "task.create"(a, c) {
      const title = String(a["title"] ?? "").trim();
      if (!title) throw new Error("task.create requires 'title'");
      const dependencies = Array.isArray(a["dependencies"]) ? (a["dependencies"] as unknown[]).map(String) : [];
      const res = await spacesCall(c, "POST", `/spaces/${c.env.spaceId}/tasks`, {
        title,
        ...(c.env.projectId ? { project_id: c.env.projectId } : {}),
        ...(typeof a["thread_id"] === "string" ? { thread_id: a["thread_id"] } : {}),
        ...(dependencies.length ? { dependencies } : {}),
        ...(typeof a["assigned_agent"] === "string" ? { assigned_agent: a["assigned_agent"] } : {}),
      });
      if (!res.ok) return { ok: false, error: `failed to create task: HTTP ${res.status}` };
      return { ok: true, task: res.json };
    },

    async "task.start"(a, c) {
      const id = reqId(a);
      const all = await listRaw(c);
      const target = all.find((t) => t.id === id);
      if (!target) return { ok: false, error: `task ${id} not found in this project` };
      const unmet = target.dependencies.filter((depId) => {
        const dep = all.find((t) => t.id === depId);
        return !dep || dep.status !== "completed";
      });
      if (unmet.length > 0) {
        return {
          ok: false,
          error: `task ${id} has unfinished dependencies: ${unmet.join(", ")}. It stays pending until those are completed.`,
          blocked_on: unmet,
        };
      }
      return setStatus(c, id, "in_progress");
    },

    async "task.complete"(a, c) {
      return setStatus(c, reqId(a), "completed");
    },

    async "task.block"(a, c) {
      return setStatus(c, reqId(a), "blocked");
    },

    async "task.list"(a, c) {
      const filters: Record<string, string> = {};
      if (typeof a["status"] === "string" && a["status"]) filters.status = a["status"] as string;
      if (typeof a["thread_id"] === "string" && a["thread_id"]) filters.thread_id = a["thread_id"] as string;
      const rows = await listRaw(c, filters);
      return { tasks: rows, count: rows.length };
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/wallet.ts">
/**
 * wallet (user-directed feature — Launchpad Wallet) — Tier 2.
 *
 * Lets an agent/Space Assistant check and top up a business's own stored-value balance
 * (a project flagged kind='wallet', SpaceDO's wallet_ledger — see SpaceDO.ts's "Launchpad
 * Wallet" section for the ledger implementation).
 *
 * SCOPE, READ THIS BEFORE EXTENDING: the wallet is an INTERNAL, Naelao-held ledger, funded via
 * a fixed-price Lemon Squeezy checkout (same "pick a pre-configured pack" shape as commerce
 * checkouts) and drawn down for NAELAO'S OWN metered platform costs. It is NOT, and is not meant
 * to become, a payment rail that pays a third party (Whop, Shopify, Stripe, PayPal...) on a
 * business's behalf — Lemon Squeezy has no API for funding an arbitrary outbound payment to a
 * vendor, and actually building that (a virtual card / ACH-push / money-transmission capability)
 * is a real regulatory undertaking (money-transmitter licensing, PCI scope) this build does not
 * attempt. The "cut Naelao gets" this feature supports is: a business that uses the Naelao
 * wallet for its own platform spend has no separate payment credential to configure; a business
 * that instead connects its OWN Stripe/Whop/Shopify key (check_bypass detects this) is a signal
 * for the assistant to have an honest conversation about it — never a hard block coded here.
 *
 * Operations:
 *   wallet.balance()                        → { balance_cents, currency }
 *   wallet.fund(topup_id, customer_email?)  → { checkout_url }               (money-in)
 *   wallet.history(limit?)                  → recent ledger entries
 *   wallet.check_bypass()                   → { using_own_payment_method, matched_providers }
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";

// Credential names a business might register for its OWN payment method instead of using the
// Naelao wallet. Deliberately a small, explicit allowlist (not a heuristic/regex over arbitrary
// names) — a false positive here would incorrectly flag an unrelated credential as a "bypass."
const THIRD_PARTY_PAYMENT_CREDENTIAL_NAMES = [
  "stripe_api_key",
  "whop_api_key",
  "shopify_api_key",
  "shopify_access_token",
  "paypal_api_key",
];

function requireProjectId(ctx: PrebuiltOpContext, args: Record<string, unknown>): string {
  const projectId = (args["project_id"] as string | undefined) ?? ctx.env.projectId;
  if (!projectId) throw new Error("wallet ops require a project-scoped run (or an explicit project_id)");
  return projectId;
}

async function spacesGet(ctx: PrebuiltOpContext, path: string): Promise<unknown> {
  if (!ctx.env.spacesWorker) throw new Error("wallet unavailable: spaces worker binding not configured");
  const resp = await ctx.env.spacesWorker.fetch(
    new Request(`http://spaces-worker${path}`, {
      headers: {
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId),
      },
    })
  );
  if (!resp.ok) throw new Error(`wallet read ${path} failed: ${resp.status}`);
  return resp.json();
}

async function billingPost(ctx: PrebuiltOpContext, path: string, body: Record<string, unknown>): Promise<unknown> {
  if (!ctx.env.billingWorker) throw new Error("wallet unavailable: billing worker binding not configured");
  const resp = await ctx.env.billingWorker.fetch(
    new Request(`http://billing-worker${path}`, {
      method: "POST",
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId),
      },
      body: JSON.stringify(body),
    })
  );
  if (!resp.ok) throw new Error(`wallet ${path} failed: ${resp.status} ${await resp.text()}`);
  return resp.json();
}

export const wallet: PrebuiltScript = {
  name: "wallet",
  description:
    "Check and top up this business's Naelao wallet balance (a Naelao-held stored-value ledger " +
    "used to pay for Naelao platform costs — not a rail for paying third parties like Whop or " +
    "Shopify). Also detects when a business has connected its own payment credential instead of " +
    "using the wallet.",
  domain: "api",
  requires_tier: 2,
  operations: {
    // async: requireProjectId's validation throw must surface as a rejected promise (matching
    // PrebuiltOp's Promise<unknown> contract), not a synchronous throw from a non-async arrow fn.
    "wallet.balance": async (a, c) =>
      spacesGet(c, `/spaces/${c.env.spaceId}/projects/${requireProjectId(c, a)}/wallet/balance`),

    "wallet.history": async (a, c) => {
      const limit = typeof a["limit"] === "number" ? a["limit"] : 50;
      return spacesGet(c, `/spaces/${c.env.spaceId}/projects/${requireProjectId(c, a)}/wallet/history?limit=${limit}`);
    },

    // Money-in: returns a Naelao-store Lemon Squeezy checkout URL for a pre-configured top-up
    // pack (productConfig.pricingConfig.walletTopups) — never an arbitrary custom amount.
    "wallet.fund": async (a, c) =>
      billingPost(c, "/internal/wallet-topups/checkout", {
        business_space_id: c.env.spaceId,
        project_id: requireProjectId(c, a),
        topup_id: a["topup_id"],
        ...(a["customer_email"] ? { customer_email: a["customer_email"] } : {}),
      }),

    // Detection only — reports what it found. It is deliberately the CALLER's job (the
    // assistant's own judgment / a builder-authored no-code trigger on wallet.bypass_detected)
    // to decide what to say or do about it, never a hardcoded gate here.
    "wallet.check_bypass": async (_a, c) => {
      if (!c.env.credentialsWorker) {
        return { using_own_payment_method: false, matched_providers: [], checked: false };
      }
      const resp = await c.env.credentialsWorker.fetch(
        new Request(`http://credentials-worker/spaces/${c.env.spaceId}/credentials`, {
          headers: {
            "x-naelao-tenant-id": c.env.tenantId,
            "x-naelao-internal-token": await mintInternalToken(c.env.platformSecret ?? "", c.env.tenantId),
          },
        })
      );
      if (!resp.ok) return { using_own_payment_method: false, matched_providers: [], checked: false };
      const { credentials } = await resp.json<{ credentials: Array<{ name: string }> }>();
      const matched = credentials
        .map((cred) => cred.name)
        .filter((name) => THIRD_PARTY_PAYMENT_CREDENTIAL_NAMES.includes(name));
      return { using_own_payment_method: matched.length > 0, matched_providers: matched, checked: true };
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/web-search.ts">
/**
 * web-search (spec §12.3) — Tier 2 isolate. search(query), fetch_page(url),
 * extract_content(url, schema), grounded_answer(query) (§A1.25).
 *
 * UNIVERSAL / PLATFORM-PROVIDED (CLAUDE.md "universal tools" principle): web search is bundled
 * by Naelao exactly like Claude/ChatGPT bundle it — the builder never brings their own search
 * API key. The platform holds ONE search-provider key (Tavily) as a Workers Secret on the
 * knowledge worker, and every agent gets search for free. This is NOT the BYO-key
 * `space_credentials` model (that is only for a builder's own external accounts, e.g. their
 * Whop/Gumroad via mcp-connector). The key never reaches the agent — the isolate only ever sees
 * normalized results.
 *
 * `search`/`extract_content` need the platform provider key; when it is unset the op reports
 * itself unconfigured (`configured:false`) rather than silently returning empty results.
 * `fetch_page` is a generic SSRF-guarded HTTP GET and needs no key — it works out of the box.
 *
 * The route is HMAC-gated (like every other /internal/* route on the knowledge worker), so we
 * mint a short-lived tenant-scoped internal token per call — the agent never gets the key.
 *
 * `grounded_answer` (§A1.25) is a DIFFERENT mechanism, not a Tavily proxy: it calls the LLM
 * directly with Anthropic's native web-search tool enabled (proxied transparently by CF AI
 * Gateway — Unified Billing, no separate provider key). Search-and-synthesize happens in one
 * gateway-billed call instead of a search round trip + a second summarization call. Its token
 * usage is real and gets billed exactly like any reasoner call (see ScriptToolSurface.run()).
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";
import { workspacePrefix } from "../types.js";

async function proxy(ctx: PrebuiltOpContext, path: string, body: unknown): Promise<unknown> {
  if (!ctx.env.knowledgeWorker) {
    throw new Error("web-search: search proxy (KNOWLEDGE_WORKER) not configured");
  }
  const token = await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId);
  const resp = await ctx.env.knowledgeWorker.fetch(
    new Request(`http://knowledge-worker${path}`, {
      method: "POST",
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": token,
      },
      body: JSON.stringify(body),
    })
  );
  if (!resp.ok) throw new Error(`web-search ${path} failed: ${resp.status}`);
  return await resp.json();
}

export const webSearch: PrebuiltScript = {
  name: "web-search",
  description:
    "Search the web, fetch a page, extract structured content, and download a file into the workspace (platform-provided, no key required).",
  domain: "api",
  requires_tier: 2,
  paramHints: {
    download_file: "url is required. filename is optional — defaults to the last path segment of the URL. Handles BINARY files (PDF, images, zip) as well as text. Saves to downloads/<filename> in the workspace; does not return the content, use read_file/stat_file to inspect it afterward (read_file only works on text).",
  },
  operations: {
    async search(args, ctx) {
      return proxy(ctx, "/internal/web-search/search", {
        query: String(args["query"] ?? ""),
        max_results: typeof args["max_results"] === "number" ? args["max_results"] : 10,
      });
    },
    async fetch_page(args, ctx) {
      return proxy(ctx, "/internal/web-search/fetch", { url: String(args["url"] ?? "") });
    },
    async extract_content(args, ctx) {
      return proxy(ctx, "/internal/web-search/extract", {
        url: String(args["url"] ?? ""),
        schema: args["schema"] ?? null,
      });
    },
    // §A1.25: search-and-synthesize in ONE gateway-billed call — a cheap model with Anthropic's
    // native web-search tool enabled (proxied transparently by CF AI Gateway, same Unified
    // Billing as every other LLM call, no separate Tavily round trip for this op). Real usage is
    // returned in `output.usage` so ScriptToolSurface.run() bills it like any reasoner call —
    // this is NOT a free LLM call just because it's invoked from inside a script.
    async grounded_answer(args, ctx) {
      if (!ctx.env.llmCaller) {
        return { ok: false, reason: "grounded_answer unavailable: no LLM credentials configured on this host" };
      }
      const query = String(args["query"] ?? "");
      if (!query) throw new Error("grounded_answer requires 'query'");
      const model = typeof args["model"] === "string" ? (args["model"] as string) : "claude-haiku-4-5-20251001";
      const maxUses = typeof args["max_results"] === "number" ? (args["max_results"] as number) : undefined;
      const result = await ctx.env.llmCaller.callWithNativeWebSearch({ model, query, maxUses });
      return {
        answer: result.answer,
        citations: result.citations,
        usage: { tokens_used: result.tokens_used, input_tokens: result.input_tokens, output_tokens: result.output_tokens },
      };
    },
    // Downloads a real file into the workspace, mirroring the existing `uploads/` convention —
    // the SAME r2-workspace bucket/prefix, under `downloads/` instead. Deliberately does NOT
    // return the content in the tool result (unlike fetch_page/extract_content): a download can
    // be up to 2MB (WEB_DOWNLOAD_CONTENT_CAP on the knowledge worker), and echoing that into the
    // reasoning payload would defeat the entire point of saving it to disk instead of reading it.
    // The caller gets a path and a size; use read_file/stat_file on it afterward if inspection is
    // actually needed — read_file's own size guard applies there too.
    async download_file(args, ctx) {
      const url = String(args["url"] ?? "").trim();
      if (!url) throw new Error("download_file requires 'url'");
      const result = (await proxy(ctx, "/internal/web-search/download", { url })) as {
        url: string; status: number; content: string | null; size?: number; truncated?: boolean;
        error?: string; encoding?: "text" | "base64"; content_type?: string;
      };
      if (!result.content) {
        return { ok: false, url, status: result.status, error: result.error ?? `download failed (status ${result.status})` };
      }
      // A failing server still sends a BODY — an error page, a rate-limit notice, a JSON error.
      // Only "was there content" was checked, so a 429/502 was written into the workspace as if it
      // were the requested file and reported as a successful download. Seen live: a GitHub 502 was
      // saved as a 16-byte `README.md` reading "error code: 502", and the agent told the user the
      // file had downloaded. Anything outside 2xx is a failed download, whatever came back with it.
      if (result.status < 200 || result.status >= 300) {
        return {
          ok: false,
          url,
          status: result.status,
          error: `download failed (status ${result.status}) — the server returned an error page, not the file`,
          body_preview: result.content.slice(0, 200),
        };
      }
      const explicitName = typeof args["filename"] === "string" && args["filename"] ? (args["filename"] as string) : undefined;
      // R2 keys are flat strings with no real directory-traversal semantics, but sanitized the
      // same defensive way r2-workspace.ts's own key() helper does for consistency: strip
      // anything but a safe character class, then collapse any run of 2+ dots (".." and longer)
      // so a filename can never even LOOK like a traversal attempt.
      const filename = (
        (explicitName ?? url.split("/").pop() ?? "download")
          .replace(/[^a-zA-Z0-9._-]/g, "_")
          .replace(/\.{2,}/g, "_")
          .replace(/^[._]+/, "")
      ) || "download";
      const bucket = ctx.env.workspaceBucket ?? ctx.env.scriptsBucket;
      const path = `downloads/${filename}`;
      // A base64 payload has to be decoded back to real bytes before it hits R2 — writing the
      // base64 STRING would store a file that is neither the original nor readable as text.
      const payload: string | Uint8Array =
        result.encoding === "base64"
          ? Uint8Array.from(atob(result.content), (ch) => ch.charCodeAt(0))
          : result.content;
      await bucket.put(`${workspacePrefix(ctx.env)}${path}`, payload, {
        // Recording the real content type is what lets the Files viewer decide between an
        // inline preview and a download, instead of guessing from the extension.
        ...(result.content_type ? { httpMetadata: { contentType: result.content_type } } : {}),
        customMetadata: { updatedAt: Date.now().toString(), sourceUrl: url },
      });
      ctx.env.onWorkspaceChange?.({ path, operation: "write" });
      return {
        ok: true, path,
        size: result.size ?? (payload instanceof Uint8Array ? payload.byteLength : payload.length),
        content_type: result.content_type ?? null,
        binary: result.encoding === "base64",
        truncated: result.truncated ?? false,
      };
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/wiki.ts">
/**
 * wiki (Memory OS Layer 6 — spec "6-Layer Memory OS", byte ~148238: "Auto-curated concept and
 * entity vault. An async background process (wiki-continuous-ingest) runs on session end to
 * structure new learnings into wiki articles, which are re-indexed into Layer 5.").
 *
 * Same self-managed pattern as fabric/memory: the agent calls wiki.upsert when it learns
 * something worth defining durably (a customer's product terminology, a recurring entity),
 * and wiki.lookup/wiki.search to consult what's already been curated before re-deriving it.
 * "Re-indexed into Layer 5" (Vectorize) is a further enhancement noted as future work — this
 * build makes the vault itself (the DO SQLite + R2 primitive per spec) real and queryable.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";

function userIdFor(args: Record<string, unknown>, ctx: PrebuiltOpContext): string | undefined {
  const explicit = args["user_id"];
  if (typeof explicit === "string" && explicit) return explicit;
  return ctx.env.userId;
}

function stringArray(v: unknown): string[] {
  return Array.isArray(v) ? v.filter((x): x is string => typeof x === "string") : [];
}

export const wiki: PrebuiltScript = {
  name: "wiki",
  description:
    "Auto-curated concept vault (Layer 6): define or update a concept/entity, look one up by name, or search definitions by keyword.",
  domain: "knowledge",
  requires_tier: 1,
  operations: {
    async "wiki.upsert"(args, ctx) {
      if (!ctx.env.memoryStore) return { ok: false, reason: "memory store not available in this environment" };
      const concept = String(args["concept"] ?? "");
      const definition = String(args["definition"] ?? "");
      if (!concept || !definition) throw new Error("wiki.upsert requires 'concept' and 'definition'");
      const userId = userIdFor(args, ctx);
      return ctx.env.memoryStore.upsertWikiConcept({
        ...(userId ? { userId } : {}),
        concept,
        definition,
        relationships: stringArray(args["relationships"]),
      });
    },
    async "wiki.lookup"(args, ctx) {
      if (!ctx.env.memoryStore) return { ok: false, reason: "memory store not available in this environment" };
      const concept = String(args["concept"] ?? "");
      if (!concept) throw new Error("wiki.lookup requires 'concept'");
      const userId = userIdFor(args, ctx);
      const article = await ctx.env.memoryStore.lookupWikiConcept(userId, concept);
      return article ?? { ok: false, reason: "concept not found" };
    },
    async "wiki.search"(args, ctx) {
      if (!ctx.env.memoryStore) return { ok: false, reason: "memory store not available in this environment" };
      const text = String(args["query"] ?? args["text"] ?? "");
      if (!text) throw new Error("wiki.search requires 'query'");
      const userId = userIdFor(args, ctx);
      return ctx.env.memoryStore.searchWiki({
        ...(userId ? { userId } : {}),
        text,
        limit: typeof args["limit"] === "number" ? (args["limit"] as number) : 5,
      });
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/workspace-admin.ts">
/**
 * workspace-admin (§A1.17 Phase G) — lets an agent (specifically the Launchpad business-builder
 * Space Assistant) actually SCAFFOLD a business: create/list/configure projects, manage who can
 * see a project, and read the space's agent roster. Tier 2 (pure orchestration over the
 * already-existing spaces-worker project routes — no new backend mechanism, per the "reuse, don't
 * reinvent" principle).
 *
 * `project.create_from_template` mirrors the exact 4-step sequence the agents worker's own
 * `POST /spaces/:spaceId/projects/from-template` route already performs (create → configure →
 * seed rules → seed scheduled jobs) rather than calling that route over HTTP — this prebuilt runs
 * inside the SAME Worker as that route (both in workers/agents), and a Durable Object has no
 * "call my own Worker's HTTP router" primitive, so the sequence is replicated against the spaces
 * worker binding directly, using the identical project-templates catalogue.
 * `project.create` is the ad-hoc counterpart: a plain named project for something the catalogue
 * has no template for, which is what a person clicking "New project" in the shell gets.
 *
 * ACTING USER (§A1.18 follow-up — this fixes a real bug, not just attribution). Every call below
 * forwards `x-naelao-user-id` when the run has an acting user. Without it the spaces worker
 * computes `created_by: undefined, system_caller: true`, and since a project defaults to
 * `visibility:'private'`, `SpaceDO.createProject`'s "creator is always an implicit project_members
 * owner" insert is skipped (`if (... && body.created_by)`) — so `listProjects`' viewer filter hid
 * every assistant-scaffolded project from everyone except a space owner/admin. The person who
 * asked for the project could not see it. Forwarding the user also correctly CLAMPS the assistant
 * to what that person could do unaided (a plain member asking for a project-member change now gets
 * the same 403 they would get themselves), which is the same principle F-36's
 * `resolveAssistantEffectiveRole` already established.
 *
 * All mutating ops (`project.create`, `project.create_from_template`, `project.configure`,
 * `project.add_member`, `project.remove_member`) are gate-worthy action names — under the default
 * guided policy the owner reviews structural changes before they happen. Read-only ops
 * (`project.list`, `project.list_members`, `agent.list`) are never gated. Archiving a project is
 * `project.configure` with `status: 'archived'` rather than its own op — the PATCH is a
 * passthrough, so name/description/visibility/caps/agent-bindings/status all go through one place.
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { mintInternalToken } from "@naelao/http";
import { getProjectTemplate } from "../../launchpad/project-templates.js";

async function spacesCall(ctx: PrebuiltOpContext, method: string, path: string, body?: Record<string, unknown>): Promise<unknown> {
  if (!ctx.env.spacesWorker) throw new Error("workspace-admin unavailable: spaces worker binding not configured");
  const token = await mintInternalToken(ctx.env.platformSecret ?? "", ctx.env.tenantId);
  const resp = await ctx.env.spacesWorker.fetch(
    new Request(`http://spaces-worker${path}`, {
      method,
      headers: {
        "content-type": "application/json",
        "x-naelao-tenant-id": ctx.env.tenantId,
        "x-naelao-internal-token": token,
        // Act ON BEHALF OF the person who asked, whenever there is one. This is load-bearing, not
        // cosmetic — see the header note above. Omitted (byte-identical to the prior behavior) for
        // a genuinely system-initiated run: a cron tick, a channel drain, or provision-time
        // scaffolding, none of which have an acting user.
        ...(ctx.env.userId ? { "x-naelao-user-id": ctx.env.userId } : {}),
      },
      ...(body ? { body: JSON.stringify(body) } : {}),
    })
  );
  if (!resp.ok) throw new Error(`workspace-admin ${method} ${path} failed: ${resp.status} ${await resp.text()}`);
  return resp.json();
}

async function createFromTemplate(ctx: PrebuiltOpContext, templateId: string, name?: string): Promise<unknown> {
  const template = getProjectTemplate(templateId);
  if (!template) throw new Error(`Unknown project template: ${templateId}`);
  const spaceId = ctx.env.spaceId;

  // 1. Create the project.
  const project = (await spacesCall(ctx, "POST", `/spaces/${spaceId}/projects`, {
    name: name ?? template.name,
    description: template.description,
    ...(template.default_agent_id ? { default_agent_id: template.default_agent_id } : {}),
    ...(template.allowed_agent_ids && template.allowed_agent_ids.length > 0 ? { allowed_agent_ids: template.allowed_agent_ids } : {}),
  })) as { id: string; name: string };

  // 2. Configure it (kind, execution ceiling, spend cap, thread cap, suggested channel).
  await spacesCall(ctx, "PATCH", `/spaces/${spaceId}/projects/${project.id}`, {
    kind: template.kind,
    execution_ceiling: template.execution_ceiling,
    daily_spend_cap_credits: template.daily_spend_cap_credits,
    ...(template.max_threads !== undefined ? { max_threads: template.max_threads } : {}),
    ...(template.kind === "customer_bot" && template.suggested_channel
      ? { channel_config: { [template.suggested_channel]: { connected: false } } }
      : {}),
  });

  // 3. Seed starter rules.
  for (const rule of template.rules ?? []) {
    await spacesCall(ctx, "POST", `/spaces/${spaceId}/projects/${project.id}/rules`, { ...rule });
  }

  // 4. Seed scheduled jobs.
  for (const job of template.scheduled_jobs ?? []) {
    await spacesCall(ctx, "POST", `/spaces/${spaceId}/scheduled-jobs`, { ...job, project_id: project.id });
  }

  return project;
}

export const workspaceAdmin: PrebuiltScript = {
  name: "workspace-admin",
  description:
    "Scaffold and manage the business's workspace: create a new project (either a plain one, or " +
    "fully configured from the project-templates catalogue — customer support bots, community " +
    "monitoring, etc.), list and reconfigure existing projects (including renaming and archiving " +
    "them), control who can see a private project, and read the space's installed agent roster. " +
    "Creating or reconfiguring a project is a real structural change to the business — the owner " +
    "reviews it before it happens.",
  domain: "api",
  requires_tier: 2,
  operations: {
    // The ad-hoc counterpart to create_from_template: what "New project" in the shell does. Use
    // this whenever the person asks for a project the template catalogue has no entry for.
    "project.create": async (a, c) => {
      const name = String(a["name"] ?? "").trim();
      if (!name) throw new Error("project.create requires name");
      // A project created on a SYSTEM run (a cron wake, a channel drain) has no acting user, so
      // SpaceDO skips its "the creator is an implicit project_members owner" insert — and the
      // default `private` visibility then hides it from every business member except an
      // owner/admin. Observed live: an unattended wake-up built a real project, posted a real
      // brief into it, and produced something ordinary members could not see, belonging to
      // nobody. When the assistant acts for the business rather than for a person, the business
      // is the audience. An explicit visibility from the caller still wins.
      const systemRun = !c.env.userId;
      return spacesCall(c, "POST", `/spaces/${c.env.spaceId}/projects`, {
        name,
        ...(a["description"] ? { description: String(a["description"]) } : {}),
        ...(a["visibility"] ? { visibility: String(a["visibility"]) } : systemRun ? { visibility: "public" } : {}),
        ...(a["default_agent_id"] ? { default_agent_id: String(a["default_agent_id"]) } : {}),
        ...(Array.isArray(a["allowed_agent_ids"]) ? { allowed_agent_ids: a["allowed_agent_ids"] } : {}),
      });
    },
    "project.create_from_template": (a, c) => createFromTemplate(c, String(a["template_id"] ?? ""), a["name"] ? String(a["name"]) : undefined),
    "project.list": (_a, c) => spacesCall(c, "GET", `/spaces/${c.env.spaceId}/projects`),
    "project.configure": async (a, c) => {
      const { project_id, ...patch } = a;
      if (!project_id) throw new Error("project.configure requires project_id");
      return spacesCall(c, "PATCH", `/spaces/${c.env.spaceId}/projects/${String(project_id)}`, patch);
    },
    // Project membership (§A1.17 Phase T1 ACL) — who can see/work in a private project. Reaching
    // these at all requires the acting user to be an admin of the business, enforced by
    // requireBusinessMembership on the route, not re-implemented here.
    "project.list_members": async (a, c) => {
      const projectId = String(a["project_id"] ?? "") || c.env.projectId;
      if (!projectId) throw new Error("project.list_members requires project_id");
      return spacesCall(c, "GET", `/spaces/${c.env.spaceId}/projects/${encodeURIComponent(projectId)}/members`);
    },
    "project.add_member": async (a, c) => {
      const projectId = String(a["project_id"] ?? "") || c.env.projectId;
      const userId = String(a["user_id"] ?? "");
      if (!projectId || !userId) throw new Error("project.add_member requires project_id and user_id");
      return spacesCall(c, "POST", `/spaces/${c.env.spaceId}/projects/${encodeURIComponent(projectId)}/members`, {
        user_id: userId,
        ...(a["role"] ? { role: String(a["role"]) } : {}),
      });
    },
    "project.remove_member": async (a, c) => {
      const projectId = String(a["project_id"] ?? "") || c.env.projectId;
      const userId = String(a["user_id"] ?? "");
      if (!projectId || !userId) throw new Error("project.remove_member requires project_id and user_id");
      return spacesCall(
        c, "DELETE",
        `/spaces/${c.env.spaceId}/projects/${encodeURIComponent(projectId)}/members/${encodeURIComponent(userId)}`
      );
    },
    "agent.list": (_a, c) => spacesCall(c, "GET", `/spaces/${c.env.spaceId}/agent-definitions?space_id=${encodeURIComponent(c.env.spaceId)}`),
  },
  // See PrebuiltScript.paramHints's own doc (project-coordination.ts has the fuller story).
  paramHints: {
    "project.create": "name (string, REQUIRED). description (string, optional). visibility " +
      "(\"private\"|\"public\", optional). default_agent_id/allowed_agent_ids (optional).",
    "project.create_from_template": "template_id (string, REQUIRED — from the project-templates " +
      "catalogue). name (string, optional — a custom name instead of the template's default).",
    "project.list": "no parameters.",
    "project.configure": "project_id (string, REQUIRED — the project to change). Every other field " +
      "is a partial patch (e.g. name, description, status:\"archived\", visibility).",
    "project.list_members": "project_id (string, optional — defaults to this run's own project).",
    "project.add_member": "project_id (string, optional — defaults to this run's own project). " +
      "user_id (string, REQUIRED). role (string, optional).",
    "project.remove_member": "project_id (string, optional — defaults to this run's own project). " +
      "user_id (string, REQUIRED).",
    "agent.list": "no parameters.",
  },
};
</file>

<file path="workers/agents/src/script-engine/prebuilt/workspace.ts">
/**
 * workspace (§A1.17 Phase R) — explicit copy/move/list between the two DIFFERENT filesystems an
 * agent can use: 'r2' (Tier 1's r2-workspace — always available, small/text files, durable
 * across restarts) and 'container' (the Tier-5 sandbox's own local disk — large/binary/
 * stateful-capable, e.g. real database data files or a full git clone, but only persists while
 * that specific container instance stays warm; genuinely empty on a cold start).
 *
 * This is deliberately NOT an implicit sync — the agent reasons about which workspace has what
 * and moves files on purpose, the same way it would think about two different machines. The R2
 * side of every op is an ordinary read/write against the SAME bucket/prefix r2-workspace.ts
 * already uses; the container side goes through ContainerWorkspaceGateway (ToolSandboxDO).
 */

import type { PrebuiltScript, PrebuiltOpContext } from "./index.js";
import { workspacePrefix } from "../types.js";

type WorkspaceName = "r2" | "container";

function bucket(ctx: PrebuiltOpContext): R2Bucket {
  return ctx.env.workspaceBucket ?? ctx.env.scriptsBucket;
}

function key(ctx: PrebuiltOpContext, path: string): string {
  const clean = String(path).replace(/^\/+/, "");
  if (clean.includes("..")) throw new Error(`Path traversal rejected: ${path}`);
  return `${workspacePrefix(ctx.env)}${clean}`;
}

function reqStr(args: Record<string, unknown>, name: string): string {
  const v = args[name];
  if (typeof v !== "string" || v.length === 0) throw new Error(`'${name}' (string) is required`);
  return v;
}

function reqWorkspace(args: Record<string, unknown>, name: string): WorkspaceName {
  const v = args[name];
  if (v !== "r2" && v !== "container") throw new Error(`'${name}' must be 'r2' or 'container'`);
  return v;
}

async function readOne(ctx: PrebuiltOpContext, ws: WorkspaceName, path: string): Promise<string | null> {
  if (ws === "r2") {
    const obj = await bucket(ctx).get(key(ctx, path));
    return obj ? obj.text() : null;
  }
  if (!ctx.env.containerWorkspace) throw new Error("container workspace unavailable: TOOL_SANDBOX not configured");
  const { files } = await ctx.env.containerWorkspace.read([path]);
  return files[path] ?? null;
}

async function writeOne(ctx: PrebuiltOpContext, ws: WorkspaceName, path: string, content: string): Promise<void> {
  if (ws === "r2") {
    await bucket(ctx).put(key(ctx, path), content, { customMetadata: { updatedAt: Date.now().toString() } });
    return;
  }
  if (!ctx.env.containerWorkspace) throw new Error("container workspace unavailable: TOOL_SANDBOX not configured");
  await ctx.env.containerWorkspace.write({ [path]: content });
}

async function deleteOne(ctx: PrebuiltOpContext, ws: WorkspaceName, path: string): Promise<void> {
  if (ws === "r2") {
    await bucket(ctx).delete(key(ctx, path));
    return;
  }
  if (!ctx.env.containerWorkspace) throw new Error("container workspace unavailable: TOOL_SANDBOX not configured");
  await ctx.env.containerWorkspace.remove([path]);
}

/** Every R2 workspace key under this run's prefix, as {relativePath: content} — the bulk-read
 *  half of workspace.sync_to_container. Deliberately bounded (a container's disk and a single
 *  write() call both have real limits, unlike R2 itself): a workspace with more than
 *  SYNC_MAX_FILES or whose total content exceeds SYNC_MAX_TOTAL_BYTES reports what it skipped
 *  rather than silently truncating or failing outright. */
const SYNC_MAX_FILES = 500;
const SYNC_MAX_TOTAL_BYTES = 20_000_000;

async function readAllR2(
  ctx: PrebuiltOpContext,
  pathPrefix: string
): Promise<{ files: Record<string, string>; skipped_count: number; skipped_reason?: string }> {
  const prefix = key(ctx, pathPrefix);
  const wsPrefix = workspacePrefix(ctx.env);
  const files: Record<string, string> = {};
  let totalBytes = 0;
  let skippedCount = 0;
  let cursor: string | undefined;
  do {
    const listing = await bucket(ctx).list(cursor ? { prefix, cursor } : { prefix });
    for (const o of listing.objects) {
      if (o.key.endsWith("/.keep")) continue;
      if (Object.keys(files).length >= SYNC_MAX_FILES || totalBytes + o.size > SYNC_MAX_TOTAL_BYTES) {
        skippedCount++;
        continue;
      }
      const obj = await bucket(ctx).get(o.key);
      if (!obj) continue;
      const relativePath = o.key.slice(wsPrefix.length);
      const text = await obj.text();
      files[relativePath] = text;
      totalBytes += text.length;
    }
    cursor = listing.truncated ? listing.cursor : undefined;
  } while (cursor);
  return {
    files,
    skipped_count: skippedCount,
    ...(skippedCount > 0
      ? { skipped_reason: `over the ${SYNC_MAX_FILES}-file / ${SYNC_MAX_TOTAL_BYTES}-byte sync limit — sync a narrower 'path' prefix, or workspace.copy the specific files you need.` }
      : {}),
  };
}

export const workspace: PrebuiltScript = {
  name: "workspace",
  description:
    "Copy, move, or list files between the R2 workspace (always available, durable, small/text) " +
    "and the Tier-5 container's own local disk (large/binary/stateful-capable, but only persists " +
    "while that container stays warm — copy anything worth keeping back to R2 before finishing). " +
    "sync_to_container/sync_from_container bulk-copy EVERY file under a prefix in one call, for " +
    "when you need the whole project staged rather than one file at a time.",
  domain: "filesystem",
  requires_tier: 1,
  paramHints: {
    "workspace.sync_to_container": "path (string, optional prefix — omit to sync the whole R2 " +
      `workspace; bounded at ${SYNC_MAX_FILES} files / ${SYNC_MAX_TOTAL_BYTES} bytes total).`,
    "workspace.sync_from_container": "No arguments — copies every file the container currently " +
      "has back into the R2 workspace, at the SAME relative paths.",
  },
  operations: {
    async "workspace.sync_to_container"(args, ctx) {
      if (!ctx.env.containerWorkspace) throw new Error("container workspace unavailable: TOOL_SANDBOX not configured");
      const pathPrefix = typeof args["path"] === "string" ? (args["path"] as string) : "";
      const { files, skipped_count, skipped_reason } = await readAllR2(ctx, pathPrefix);
      const count = Object.keys(files).length;
      if (count > 0) await ctx.env.containerWorkspace.write(files);
      return {
        ok: true,
        synced_files_count: count,
        target: "container:/workspace",
        ...(skipped_count > 0 ? { skipped_count, skipped_reason } : {}),
      };
    },

    async "workspace.sync_from_container"(_args, ctx) {
      if (!ctx.env.containerWorkspace) throw new Error("container workspace unavailable: TOOL_SANDBOX not configured");
      const { files } = await ctx.env.containerWorkspace.read();
      const entries = Object.entries(files);
      for (const [path, content] of entries) {
        await bucket(ctx).put(key(ctx, path), content, { customMetadata: { updatedAt: Date.now().toString() } });
      }
      return { ok: true, synced_files_count: entries.length, target: "r2" };
    },
    async "workspace.list"(args, ctx) {
      const name = reqWorkspace(args, "name");
      if (name === "r2") {
        const prefix = key(ctx, typeof args["path"] === "string" ? (args["path"] as string) : "");
        const out: string[] = [];
        let cursor: string | undefined;
        do {
          const listing = await bucket(ctx).list(cursor ? { prefix, cursor } : { prefix });
          for (const o of listing.objects) out.push(o.key.slice(workspacePrefix(ctx.env).length));
          cursor = listing.truncated ? listing.cursor : undefined;
        } while (cursor);
        return { workspace: "r2", files: out };
      }
      if (!ctx.env.containerWorkspace) throw new Error("container workspace unavailable: TOOL_SANDBOX not configured");
      const { files } = await ctx.env.containerWorkspace.list();
      return { workspace: "container", files };
    },

    async "workspace.copy"(args, ctx) {
      const from = reqWorkspace(args, "from");
      const to = reqWorkspace(args, "to");
      const path = reqStr(args, "path");
      const destPath = typeof args["to_path"] === "string" ? (args["to_path"] as string) : path;
      if (from === to) throw new Error("'from' and 'to' must be different workspaces");
      const content = await readOne(ctx, from, path);
      if (content === null) throw new Error(`source file not found in ${from}: ${path}`);
      await writeOne(ctx, to, destPath, content);
      return { ok: true, from, to, path, to_path: destPath };
    },

    async "workspace.move"(args, ctx) {
      const from = reqWorkspace(args, "from");
      const to = reqWorkspace(args, "to");
      const path = reqStr(args, "path");
      const destPath = typeof args["to_path"] === "string" ? (args["to_path"] as string) : path;
      if (from === to) throw new Error("'from' and 'to' must be different workspaces");
      const content = await readOne(ctx, from, path);
      if (content === null) throw new Error(`source file not found in ${from}: ${path}`);
      await writeOne(ctx, to, destPath, content);
      await deleteOne(ctx, from, path);
      return { ok: true, from, to, path, to_path: destPath };
    },
  },
};
</file>

<file path="workers/agents/src/script-engine/agent-archetypes.ts">
/**
 * Agent archetype presets (AVOS plan step 5) — an OPT-IN validation layer for CUSTOM agent
 * creation (agent-templates.ts's customAgentToConfig), not a runtime override of every agent's
 * config.
 *
 * Why opt-in, and why not a runtime prune inside ScriptToolSurface/NaelaoAgentDO: the platform's
 * REAL capability firewall already exists and is already enforced structurally — every agent
 * definition (a fixed AGENT_TEMPLATES entry, a Launchpad core agent, a Space Assistant profile)
 * carries its OWN curated `config.scripts.prebuilt` list, and ScriptToolSurface builds its
 * operation map ONLY from that list (an op not on it is not merely gated, it does not exist to
 * call — see tool-surface.ts's own header). A SECOND, runtime archetype-based pruning layer that
 * silently overrides an agent's own declared config would be exactly the split-brain this
 * codebase's own convention repeatedly warns against (two authorities, one silently wins) — and
 * every FIXED template (AGENT_TEMPLATES) is already Naelao-curated and pre-vetted; there is
 * nothing to firewall there that its own script list doesn't already firewall.
 *
 * The REAL gap: `customAgentToConfig`'s `CustomAgentInput.prebuilt_scripts` accepts ANY string
 * list from an END USER with zero validation — a "Customer Support" custom agent could be handed
 * `code-exec`/`local-machine`/`workspace-admin` with no guardrail at all. THIS is where a
 * capability firewall earns its keep: at the moment a human is granting capabilities to a NEW,
 * user-authored agent, not as a runtime interceptor second-guessing every agent that already
 * exists. See createCustomAgent (workers/agents/src/index.ts) for the one call site.
 */

export type AgentArchetypeRole = "dev_operator" | "growth_operator" | "customer_support" | "architect_delegate";

export interface ArchetypePreset {
  role: AgentArchetypeRole;
  label: string;
  description: string;
  /** Every prebuilt script name a custom agent of this archetype may request. An allowlist
   *  (fail-closed on an unrecognized/new script), not a denylist — a newly-added prebuilt script
   *  is unavailable to every archetype until someone consciously classifies it, same posture as
   *  assistant-access.ts's own READ_SAFE_PREBUILT_OPS. r2-workspace/memory/notifications are
   *  always included by customAgentToConfig itself regardless of archetype (the universal
   *  baseline every agent gets — filesystem, memory, notifications), so they're omitted here.
   */
  allowedScripts: readonly string[];
}

export const ARCHETYPE_PRESETS: Record<AgentArchetypeRole, ArchetypePreset> = {
  dev_operator: {
    role: "dev_operator",
    label: "Dev / Operator",
    description: "Writes and runs code, reaches external tools over MCP — the highest-capability archetype.",
    allowedScripts: [
      "code-exec", "mcp-connector", "web-search", "knowledge-base", "workspace",
      "conversation", "project-journal", "artifacts", "schedule", "tasks", "sub-agent",
    ],
  },
  growth_operator: {
    role: "growth_operator",
    label: "Growth / Sales",
    description: "Qualifies leads, drafts outreach, reads the business's own revenue data — never moves money or runs code.",
    allowedScripts: [
      "web-search", "knowledge-base", "notifications", "business-email", "conversation",
      "project-journal", "commerce", "business-wallet", "revenue-tracker", "schedule", "tasks",
    ],
  },
  customer_support: {
    role: "customer_support",
    label: "Customer Support",
    description: "Answers from the knowledge base and hands off what it can't verify — the narrowest archetype: no code execution, no filesystem beyond the universal baseline, no local-machine or business-wallet access.",
    allowedScripts: [
      "knowledge-base", "conversation", "notifications", "business-email", "project-journal",
    ],
  },
  architect_delegate: {
    role: "architect_delegate",
    label: "Architect / Delegate",
    description: "Plans and delegates — spawns sub-agents and coordinates project threads/tasks, but never executes code or reaches the outside world directly itself.",
    allowedScripts: [
      "sub-agent", "project-coordination", "tasks", "project-journal", "conversation",
      "schedule", "knowledge-base",
    ],
  },
};

export function isKnownArchetype(value: unknown): value is AgentArchetypeRole {
  return typeof value === "string" && value in ARCHETYPE_PRESETS;
}

/**
 * Clamp a custom agent's requested prebuilt-script list to what its chosen archetype allows.
 * Returns BOTH the allowed subset and what was rejected — a silent narrowing with no signal back
 * to the person configuring the agent would just move the confusion from "an unrestricted agent"
 * to "an agent that mysteriously can't do what it was configured to do."
 */
export function clampScriptsToArchetype(
  archetype: AgentArchetypeRole,
  requestedScripts: string[]
): { allowed: string[]; rejected: string[] } {
  const preset = ARCHETYPE_PRESETS[archetype];
  const allowedSet = new Set(preset.allowedScripts);
  const allowed: string[] = [];
  const rejected: string[] = [];
  for (const script of requestedScripts) {
    if (allowedSet.has(script)) allowed.push(script);
    else rejected.push(script);
  }
  return { allowed, rejected };
}
</file>

<file path="workers/agents/src/script-engine/agent-config.ts">
/**
 * Agent configuration surface (spec §11). An agent in Naelao is defined ENTIRELY by four
 * files in R2 — no code changes, no DB rows. Change the files and reload the agent.
 *
 *   spaces/{spaceId}/agents/{agentId}/
 *     agents.md           ← identity, rules, behavioral + escalation constraints
 *     system-prompt.md    ← role, domain, tone, task framing
 *     scripts.json        ← which scripts load at startup
 *     skills.json         ← which SKILL.md knowledge docs are in context
 */

/** scripts.json (spec §11.2). */
export interface ScriptsConfig {
  /** Prebuilt platform scripts to enable (names from the catalogue). */
  prebuilt: string[];
  /** Space-level script names to load (installed by the builder/provisioner). */
  space_scripts?: string[];
  /** "auto" = load all of this agent's distilled scripts at startup (the default). */
  agent_scripts?: "auto" | string[];
  /** Observe script run at the start of each pass. */
  startup_observe: string;
  /** Optional: pre-boot a warm container (Code/Cowork profiles). */
  startup_container?: boolean;
}

/** skills.json (spec §11.3) — SKILL.md knowledge docs + per-skill config. */
export interface SkillsConfig {
  skills: Array<{
    name: string;
    tier: "platform" | "space" | "agent";
    config?: Record<string, unknown>;
  }>;
}

export interface AgentConfig {
  agentsMd: string;
  systemPrompt: string;
  scripts: ScriptsConfig;
  skills: SkillsConfig;
  /**
   * Structural HITL approval-gate allowlist (spec §11, appendix A1.16.1) — the action names
   * this agent must pause and request owner approval for before executing (loop.ts's
   * `gate_listed` mode). This is the enforced source of truth. `agents.md`'s
   * "# Approval Gates (HITL)" prose section is for the MODEL to read (so it knows to ask), not
   * for the runtime to parse — a prior version relied on parsing a `## requires_approval_for`
   * markdown heading that no agent-authoring path ever actually wrote, so nothing was ever
   * gated. Absent/undefined only for agents provisioned before this field existed; callers
   * MUST fall back to `parseRequiresApprovalFor(agentsMd)` in that case (see loop.ts).
   */
  requiresApprovalFor?: string[];
}

/** On-disk shape of scripts.json: ScriptsConfig plus the structural approval-gate list. Kept
 *  inside this existing JSON file rather than a fifth R2 file — an agent is still defined by
 *  exactly the four files (agents.md, system-prompt.md, scripts.json, skills.json). */
type PersistedScriptsConfig = ScriptsConfig & { requires_approval_for?: string[] };

function agentDir(spaceId: string, agentId: string): string {
  return `spaces/${spaceId}/agents/${agentId}`;
}

/** Load the four config files for an agent. Returns null when the agent is not provisioned. */
export async function loadAgentConfig(
  bucket: R2Bucket,
  spaceId: string,
  agentId: string
): Promise<AgentConfig | null> {
  const dir = agentDir(spaceId, agentId);
  const [agentsMd, systemPrompt, scriptsJson, skillsJson] = await Promise.all([
    bucket.get(`${dir}/agents.md`),
    bucket.get(`${dir}/system-prompt.md`),
    bucket.get(`${dir}/scripts.json`),
    bucket.get(`${dir}/skills.json`),
  ]);
  if (!scriptsJson || !systemPrompt) return null;

  const { requires_approval_for, ...scripts } = JSON.parse(await scriptsJson.text()) as PersistedScriptsConfig;

  return {
    agentsMd: agentsMd ? await agentsMd.text() : "",
    systemPrompt: await systemPrompt.text(),
    scripts,
    skills: skillsJson ? (JSON.parse(await skillsJson.text()) as SkillsConfig) : { skills: [] },
    ...(requires_approval_for ? { requiresApprovalFor: requires_approval_for } : {}),
  };
}

/** Write the four config files for an agent (used by the provisioner / profile install). */
export async function writeAgentConfig(
  bucket: R2Bucket,
  spaceId: string,
  agentId: string,
  config: AgentConfig
): Promise<void> {
  const dir = agentDir(spaceId, agentId);
  const persistedScripts: PersistedScriptsConfig = config.requiresApprovalFor
    ? { ...config.scripts, requires_approval_for: config.requiresApprovalFor }
    : config.scripts;
  await Promise.all([
    bucket.put(`${dir}/agents.md`, config.agentsMd),
    bucket.put(`${dir}/system-prompt.md`, config.systemPrompt),
    bucket.put(`${dir}/scripts.json`, JSON.stringify(persistedScripts, null, 2)),
    bucket.put(`${dir}/skills.json`, JSON.stringify(config.skills, null, 2)),
  ]);
}

/**
 * Live-reported bug: a business's Space Assistant claimed a real, shipped capability
 * (`thread.create`) "isn't supported" — the operation genuinely wasn't in `scripts.prebuilt` for
 * that specific agent, because `scripts.json` is written ONCE at provision time and nothing ever
 * re-syncs it when the code-level profile (profiles.ts) gains a new prebuilt script later. A
 * business provisioned before `project-coordination`/`business-diagnostics` were added to the
 * Space Assistant profile is permanently missing them — not a one-off, this affects every
 * already-provisioned business for every prebuilt added since. There is no builder-facing UI to
 * individually trim which prebuilt SCRIPTS an agent has (only per-ACTION approval policy), so a
 * script present in the current profile but absent from a persisted list is staleness, never an
 * intentional trim — safe to add, additive-only (never removes anything persisted), preserving
 * the existing order and appending only what's missing so a caller can skip a needless write when
 * nothing changed.
 */
export function mergeMissingPrebuilt(
  scripts: ScriptsConfig,
  additions: string[]
): { merged: ScriptsConfig; changed: boolean; added: string[] } {
  const existing = new Set(scripts.prebuilt);
  const added = additions.filter((name) => !existing.has(name));
  if (added.length === 0) return { merged: scripts, changed: false, added: [] };
  return { merged: { ...scripts, prebuilt: [...scripts.prebuilt, ...added] }, changed: true, added };
}

/** List the agentIds provisioned under a space. */
export async function listSpaceAgents(bucket: R2Bucket, spaceId: string): Promise<string[]> {
  const prefix = `spaces/${spaceId}/agents/`;
  const ids = new Set<string>();
  let cursor: string | undefined;
  do {
    const listing = await bucket.list(cursor ? { prefix, cursor } : { prefix });
    for (const o of listing.objects) {
      const id = o.key.slice(prefix.length).split("/")[0];
      if (id) ids.add(id);
    }
    cursor = listing.truncated ? listing.cursor : undefined;
  } while (cursor);
  return [...ids];
}
</file>

<file path="workers/agents/src/script-engine/assistant-access.ts">
/**
 * F-36 enforcement — the runtime half of the assistant per-user permission clamp.
 *
 * The clamp itself (what role an assistant EFFECTIVELY has in a project when acting on behalf
 * of user U — never more than U's own `project_members` role, further clamped by that row's
 * `assistant_mode`) is defined and computed in exactly one place: SpaceDO's
 * `resolveAssistantEffectiveRole` (workers/spaces/src/do/SpaceDO.ts), exposed over
 * `GET /spaces/:spaceId/projects/:projectId/assistant-access?user_id=U`. This module is the
 * agents-worker side that makes the clamp REAL at runtime — before this pass the clamp existed
 * but nothing in workers/agents ever consulted it, so an assistant acting for a `read_only`
 * or `none`-clamped user ran with full space-scoped authority anyway.
 *
 * Two enforcement pieces live here (both pure — the DO wires them):
 *
 * 1. `isReadSafeOperation` — what "read-only" means at the six-op script surface. A `viewer`
 *    effective role allows script.read / script.find and the prebuilt operations on the
 *    explicit allowlist below; it refuses script.create / update / delete, every stored
 *    (agent-authored) script — arbitrary code is assumed mutating — and any prebuilt op NOT
 *    on the list. Deliberately a small explicit allowlist over Naelao's own op names (the
 *    same posture as wallet.ts's THIRD_PARTY_PAYMENT_CREDENTIAL_NAMES): fail closed, so a new
 *    prebuilt op is write-gated until someone consciously classifies it as read-safe. This is
 *    enforced structurally in ScriptToolSurface (the maxTier precedent), not by prompt text.
 *
 * 2. `resolveAssistantApprovalPlan` — the approval-policy intersection. The space-wide
 *    `assistant_policy` (always_ask / yolo) was previously applied identically no matter WHO
 *    the assistant was acting for, so an owner flipping the space to `yolo` granted un-gated
 *    autonomy even to runs made on behalf of a viewer or a product end user. Now `yolo` only
 *    fully applies when the acting caller could self-authorize everything anyway (the space
 *    owner/admin — the roles that can edit the policy itself) or when there is NO human caller
 *    at all (cron / trigger / webhook wakes, which never set x-naelao-role: the autonomous
 *    operation the owner explicitly configured yolo FOR). Any other verified caller role
 *    (editor/viewer builders, product_end_user, agent API keys) downgrades yolo to the
 *    always_ask posture: everything gated except the policy's own auto_approved_actions.
 *    Fails closed by construction — an unrecognized role string downgrades.
 */

import type { ApprovalMode } from "./loop.js";

export type AssistantEffectiveRole = "owner" | "editor" | "viewer";

/**
 * Prebuilt operations a `viewer`-clamped run may execute: reads with no side effect beyond
 * observation. Everything else — including ops that LOOK read-adjacent but drive an external
 * effect (browser.navigate can submit a GET with side effects, mcp `call` invokes an external
 * tool, local.read_file reads a granting user's machine) — is refused under the clamp.
 */
export const READ_SAFE_PREBUILT_OPS: ReadonlySet<string> = new Set([
  // r2-workspace (bare op names)
  "read_file",
  "list_directory",
  "stat_file",
  // search_file was a pure read the same class as read_file/list_directory but was never added
  // here — found while adding the REPL-primitive reads below.
  "search_file",
  // Claude-Code-shaped REPL primitives (r2-workspace.ts) — Read/Grep/Glob are reads; Edit/Write
  // mutate and Bash executes, so neither is on this list.
  "Read",
  "Grep",
  "Glob",
  // file-manager (diff/history are reads; append/patch mutate)
  "file.diff",
  "file.history",
  // web-search (bare op names — SSRF-guarded reads of the public web via the knowledge worker)
  "search",
  "fetch_page",
  "extract_content",
  // knowledge-base
  "knowledge.search",
  // memory / fabric / wiki recall (remember/forget/record/upsert mutate)
  "memory.recall",
  "fabric.recall",
  "fabric.brief",
  "wiki.lookup",
  "wiki.search",
  // mcp-connector (bare op names — listing is read-safe; register/call are not)
  "list_servers",
  "list_tools",
  // status/list reads across the catalogue
  "lock.status",
  "workspace.list",
  "workflow.status",
  "project.list",
  "agent.list",
  "wallet.balance",
  "wallet.history",
  "wallet.check_bypass",
  "commerce.list_products",
  "commerce.get_order",
  "email.status",
  "storefront.status",
  "local.status",
  // tools.search/tools.describe (ScriptToolSurface, progressive tool disclosure) — pure metadata
  // lookups over whatever is already enabled, no side effect of any kind.
  "tools.search",
  "tools.describe",
  // tasks.ts (AVOS plan step 4) — listing the project's task DAG is a pure read; create/start/
  // complete/block are structural writes and stay off this list.
  "task.list",
  // plan.ts — the run-scoped checklist. Every plan op is safe-by-construction: it only organizes
  // THIS run's own plan state (no external side effect, no money, no outside reach), so even a
  // read-only-clamped run may use it to plan and track its own work.
  "plan.set",
  "plan.add_step",
  "plan.complete_step",
  "plan.status",
  "plan.clear",
]);

export function isReadSafeOperation(name: string): boolean {
  return READ_SAFE_PREBUILT_OPS.has(name);
}

/** Space-level roles that can edit the assistant policy itself — the only callers whose
 *  presence doesn't downgrade `yolo` (they could self-authorize any gated action anyway). */
const YOLO_SELF_AUTHORIZING_ROLES: ReadonlySet<string> = new Set(["owner", "admin"]);

export interface AssistantApprovalPlan {
  requiresApprovalFor: string[];
  approvalMode: ApprovalMode;
}

/**
 * Intersect the space-wide assistant policy with the verified acting caller's role
 * (`x-naelao-role`, set by naelao-router from verified claims; `undefined` for internal/system
 * wakes, which never set it). See the module doc — yolo applies fully only for system wakes
 * and owner/admin callers; everyone else keeps the always_ask posture.
 */
export function resolveAssistantApprovalPlan(
  policy: { approval_mode: "always_ask" | "yolo"; auto_approved_actions: string[] } | null,
  callerRole: string | undefined,
  /**
   * The caller's role in THIS business, when they're a product end user.
   *
   * Without this, an end user always downgraded yolo — which was right when a product_end_user
   * meant "a customer of the business", and wrong once they could be its owner. A business owner
   * who flipped their own business to autonomous still had every action gated, and there was no
   * approver but themself: the same owner-locked-out-of-their-own-business bug items 79 and 90
   * fixed at the route and UI layers, one layer deeper. Resolved server-side from
   * business_memberships, never client-supplied.
   */
  businessRole?: string | undefined
): AssistantApprovalPlan {
  const selfAuthorizing =
    callerRole === undefined ||
    YOLO_SELF_AUTHORIZING_ROLES.has(callerRole) ||
    // A plain member is still downgraded: yolo is the owner's choice about their own business,
    // not a grant to everyone who can talk to it.
    (callerRole === "product_end_user" && businessRole !== undefined && YOLO_SELF_AUTHORIZING_ROLES.has(businessRole));

  const yoloApplies = policy?.approval_mode === "yolo" && selfAuthorizing;
  if (yoloApplies) {
    return { requiresApprovalFor: [], approvalMode: "gate_listed" };
  }
  return {
    requiresApprovalFor: policy?.auto_approved_actions ?? [],
    approvalMode: "gate_unless_listed",
  };
}
</file>

<file path="workers/agents/src/script-engine/code-runner.ts">
/**
 * The concrete Execution Ladder backend (spec bottom appendix §8) — implements
 * `TieredCodeRunner` for tiers 2-5. Tier 1 (R2) is handled in-process by execution-ladder.ts
 * and never reaches here.
 *
 *   Tier 2 — V8 Isolate (CF Worker Loader): TS/JS + HTTP fetch. No filesystem, no native bins.
 *   Tier 3 — Tier 2 + best-effort ESM package resolution (fetched from a CDN at call time and
 *            injected as an extra module — there is no real "npm install" inside an isolate).
 *   Tier 4 — Tier 2 isolate with a `ctx.browser` capability proxied to the naelao-browser
 *            Worker (CF Browser Rendering). Agents never get raw CDP (spec §8 note).
 *   Tier 5 — ToolSandboxDO (CF Container, full Linux) generic /exec route.
 *
 * Stored script code is a TypeScript/JS module exporting a named `run`:
 *   export async function run(args, ctx) { ... return result; }
 * `ctx` always exposes `fetch`; Tier 4 additionally exposes `browser.navigate(...)`.
 *
 * §A1.17 Phase I — `ctx.mcp` (Code Mode, Tiers 2-4): when the host wires a `mcpHubWorker`
 * binding, every isolate ALSO gets `ctx.mcp.{call,list_servers,list_tools}`, looping back to the
 * SAME `naelao-mcp-hub` worker the `mcp-connector` prebuilt already uses — so ONE authored
 * script can deterministically chain several MCP servers (get data from A, act on B) instead of
 * that composition living only in the model-driven, one-op-per-turn reasoning loop. The isolate
 * never receives a credential: mcp-hub still resolves auth server-side exactly as it does for
 * the prebuilt path. What the isolate DOES receive is a short-lived (60s), tenant-scoped internal
 * token minted just before isolate construction — never the platform secret itself — so the
 * mcp-hub's `requireInternalHmac` gate is satisfied without widening what a compromised script
 * could do with it.
 *
 * The CF Worker Loader binding (`worker_loaders`) is a 2025 beta primitive — not yet in
 * @cloudflare/workers-types, so its shape is declared locally (same pattern ToolSandboxDO
 * uses for the Container runtime). When the binding is absent (older account / local dev
 * without it configured) tiers 2-4 degrade honestly to "unavailable", matching every other
 * optional binding in this engine (AI, Vectorize, MCP_HUB, ...).
 */

import type { TieredCodeRunner, ScriptRunResult, ExecutionTier } from "./types.js";
import { mintInternalToken } from "@naelao/http";

// ── CF Worker Loader binding (beta) — minimal local typing ─────────────────────────────

export interface WorkerLoaderModuleConfig {
  compatibilityDate: string;
  compatibilityFlags?: string[];
  mainModule: string;
  modules: Record<string, string>;
  /** Bindings visible to the dynamically loaded code as `env`. Passed by reference. */
  env?: Record<string, unknown>;
  /** Restrict outbound fetch from the loaded worker; null disables outbound entirely. */
  globalOutbound?: Fetcher | null;
}

export interface WorkerLoaderStub {
  getEntrypoint(name?: string, options?: { props?: Record<string, unknown> }): Fetcher;
}

export interface WorkerLoaderBinding {
  get(id: string, factory: () => WorkerLoaderModuleConfig | Promise<WorkerLoaderModuleConfig>): WorkerLoaderStub;
}

// ── Options the host (NaelaoAgentDO) supplies when constructing the runner ─────────────

export interface CodeRunnerOptions {
  /** The worker_loaders binding. Tiers 2-4 are unavailable without it. */
  loader?: WorkerLoaderBinding;
  /** naelao-browser service binding (Tier 4). */
  browserWorker?: Fetcher;
  /** naelao-mcp-hub service binding — powers Tiers 2-4's ctx.mcp (§A1.17 Phase I). */
  mcpHubWorker?: Fetcher;
  /** Used to mint short-lived internal tokens for the browser/mcp-hub loopbacks — never handed
   *  to the isolate directly. */
  platformSecret?: string;
  /** ToolSandboxDO namespace (Tier 5, the Phase K base per-project sandbox). */
  toolSandbox?: DurableObjectNamespace;
  /** §A1.17 Phase L: Container Marketplace image id -> its own DO namespace binding. Empty/absent
   *  today — every catalogue image ships `available:false` (see container-catalogue.ts) until a
   *  real Dockerfile + persistence strategy + wrangler binding lands for it. */
  containerImages?: Record<string, DurableObjectNamespace>;
  /** Per-call wall-clock timeout for isolate tiers (2-4). Default 15s. */
  isolateTimeoutMs?: number;
  /** Per-call wall-clock timeout for the container tier (5). Default 60s. */
  containerTimeoutMs?: number;
}

const DEFAULT_ISOLATE_TIMEOUT_MS = 15_000;
const DEFAULT_CONTAINER_TIMEOUT_MS = 60_000;
const ISOLATE_COMPAT_DATE = "2024-12-01";

/**
 * Execution Ladder auto-promotion (AVOS plan, step 3): a Tier 2-4 isolate has NO real OS, no
 * `npm`/`pip`, and (at Tier 2) no package resolution at all — Tier 3's own CDN-ESM-shim
 * (extractBarePackageImports, above) is already the isolate's best attempt at "install a
 * package," and Tier 4 adds only a browser proxy, not a filesystem. So a script whose failure is
 * genuinely "this isolate structurally cannot do that" (an unresolved import — the isolate has
 * no module the CDN shim could find, or Tier 2 didn't even try) is a real, deterministic signal
 * that Tier 5 (a real container: real npm/pip, real files) can plausibly succeed where the
 * isolate never could. Deliberately narrow, and deliberately does NOT include a plain execution
 * timeout: a script that's slow or genuinely stuck is not obviously fixed by a cold-starting
 * container with a longer (60s vs 15s) but still finite timeout — retrying there risks doubling
 * the wall-clock cost of something that was always going to fail, for no real capability gain.
 */
const ISOLATE_PROMOTION_ERROR_PATTERNS = [
  /cannot find module/i,
  /failed to resolve (specifier|module)/i,
  /no such module/i,
  /module not found/i,
];

/** Bare (non-relative) import specifiers a Tier-3 script wants resolved from a CDN. */
function extractBarePackageImports(code: string): string[] {
  const specs = new Set<string>();
  const importRe = /\bimport\s+(?:[\w*${},\s]+\s+from\s+)?["']([^"'.][^"']*)["']/g;
  let m: RegExpExecArray | null;
  while ((m = importRe.exec(code))) {
    const spec = m[1];
    if (spec && !spec.startsWith(".") && !spec.startsWith("naelao:")) specs.add(spec);
  }
  return [...specs];
}

// F10: the isolate previously handed scripts a raw, unguarded `fetch` — any Tier 2/3/4
// script could reach internal-only addresses (e.g. 169.254.169.254) with no SSRF check at
// all. This module runs as standalone JS text inside a CF Worker Loader isolate (no bundler,
// no imports beyond what's in `modules`), so the guard can't be pulled in from
// @naelao/security — it's inlined here and kept in sync with that package's logic by hand.
// `globalThis.fetch` is overridden (not just `ctx.fetch`) so a script that calls bare
// `fetch(...)` directly — bypassing the `ctx` convention — is still guarded.
const SSRF_GUARD_PRELUDE = `
const __realFetch = fetch;
const __SSRF_BLOCKED_RE = [/^localhost$/i, /^127\\./, /^0\\.0\\.0\\.0$/, /^::1$/, /^169\\.254\\./, /^10\\./, /^172\\.(1[6-9]|2\\d|3[01])\\./, /^192\\.168\\./, /^100\\.(6[4-9]|[7-9]\\d|1[01]\\d|12[0-7])\\./, /^fc00:/i, /^fd00:/i, /^fe80:/i, /^0\\./];
function __isBlockedHost(h) {
  return __SSRF_BLOCKED_RE.some((re) => re.test(h)) || h.endsWith(".internal") || h.endsWith(".local") || h.endsWith(".localhost");
}
async function __resolveIps(hostname) {
  try {
    const q = (type) => __realFetch("https://cloudflare-dns.com/dns-query?name=" + encodeURIComponent(hostname) + "&type=" + type, { headers: { accept: "application/dns-json" } }).then((r) => r.ok ? r.json() : null).catch(() => null);
    const [a, aaaa] = await Promise.all([q("A"), q("AAAA")]);
    const answers = [...((a && a.Answer) || []), ...((aaaa && aaaa.Answer) || [])];
    return answers.map((x) => x.data).filter(Boolean);
  } catch { return []; }
}
async function __ssrfGuardedFetch(...args) {
  const req = args[0];
  const rawUrl = typeof req === "string" ? req : (req && req.url) || "";
  let parsed;
  try { parsed = new URL(rawUrl); } catch { throw new Error("ssrf_blocked: invalid URL"); }
  if (parsed.protocol !== "http:" && parsed.protocol !== "https:") throw new Error("ssrf_blocked: protocol " + parsed.protocol + " not allowed");
  const hostname = parsed.hostname.toLowerCase();
  if (__isBlockedHost(hostname)) throw new Error("ssrf_blocked: host " + hostname + " not allowed");
  const resolved = await __resolveIps(hostname);
  if (resolved.some(__isBlockedHost)) throw new Error("ssrf_blocked: host " + hostname + " resolves to a blocked address");
  return __realFetch(...args);
}
globalThis.fetch = __ssrfGuardedFetch;
`;

/** Builds the single-file isolate module: SSRF guard prelude + user code + a fetch() harness. */
function buildIsolateModule(userCode: string): string {
  return `${SSRF_GUARD_PRELUDE}
${userCode}

export default {
  async fetch(request, env) {
    const { args } = await request.json();
    const ctx = { fetch: (...a) => __ssrfGuardedFetch(...a) };
    if (env.__BROWSER__) {
      ctx.browser = {
        navigate: async (req) => {
          const r = await env.__BROWSER__.fetch("http://browser/v1/browser/navigate", {
            method: "POST",
            headers: { "content-type": "application/json", "x-naelao-internal-token": env.__BROWSER_TOKEN__ || "" },
            body: JSON.stringify(req),
          });
          const body = await r.json();
          if (!r.ok) throw new Error("browser.navigate failed: " + (body && body.message ? body.message : r.status));
          return body;
        },
      };
    }
    if (env.__MCP_HUB__) {
      const mcpHeaders = () => ({
        "content-type": "application/json",
        "x-naelao-tenant-id": env.__MCP_TENANT__ || "",
        "x-naelao-user-id": env.__MCP_AGENT__ || "",
        "x-naelao-agent-id": env.__MCP_AGENT__ || "",
        "x-naelao-internal-token": env.__MCP_TOKEN__ || "",
      });
      const mcpFetch = async (path, init) => {
        const r = await env.__MCP_HUB__.fetch(new Request("http://mcp-hub/v1/spaces/" + env.__MCP_SPACE__ + path, {
          method: init.method,
          headers: mcpHeaders(),
          ...(init.body !== undefined ? { body: JSON.stringify(init.body) } : {}),
        }));
        const body = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error((body && body.message) || ("mcp-hub " + path + " failed: " + r.status));
        return body;
      };
      const resolveServerId = async (ref) => {
        const listed = await mcpFetch("/mcp-servers", { method: "GET" });
        const servers = (listed && listed.data) || [];
        const match = servers.find((s) => s.id === ref) || servers.find((s) => s.name === ref);
        if (!match) throw new Error("ctx.mcp: no registered server named '" + ref + "'");
        return match.id;
      };
      ctx.mcp = {
        list_servers: async () => {
          const listed = await mcpFetch("/mcp-servers", { method: "GET" });
          return listed.data || [];
        },
        list_tools: async (server) => {
          const id = await resolveServerId(server);
          return mcpFetch("/mcp-servers/" + id + "/tools", { method: "GET" });
        },
        call: async (server, tool, params) => {
          const id = await resolveServerId(server);
          return mcpFetch("/mcp-servers/" + id + "/tools/call", { method: "POST", body: { tool_name: tool, input: params || {} } });
        },
      };
    }
    if (typeof run !== "function") {
      return Response.json({ ok: false, error: "script must export an async function named 'run'" }, { status: 500 });
    }
    try {
      const result = await run(args, ctx);
      return Response.json({ ok: true, result });
    } catch (err) {
      return Response.json({ ok: false, error: String((err && err.message) || err) }, { status: 500 });
    }
  },
};
`;
}

/** Fetch a package's ESM bundle from esm.sh for Tier-3 best-effort npm resolution. */
async function fetchEsmModule(pkg: string): Promise<string | null> {
  try {
    const resp = await fetch(`https://esm.sh/${encodeURIComponent(pkg)}`, {
      headers: { accept: "application/javascript,text/javascript" },
    });
    if (!resp.ok) return null;
    return await resp.text();
  } catch {
    return null;
  }
}

async function runIsolate(
  opts: CodeRunnerOptions,
  params: {
    name: string;
    code: string;
    tier: ExecutionTier;
    args: Record<string, unknown>;
    spaceId: string;
    agentId: string;
    tenantId: string;
    // Widened to accept (and, on auto-promotion, forward) the same optional fields
    // runContainer expects — absent for the overwhelming majority of Tier 2-4 calls.
    projectId?: string;
  }
): Promise<ScriptRunResult> {
  const started = Date.now();
  if (!opts.loader) {
    return {
      ok: false,
      error: `Tier ${params.tier} is unavailable: no worker_loaders binding configured in this environment`,
      tier: params.tier,
      duration_ms: Date.now() - started,
      tokens_used: 0,
    };
  }

  const modules: Record<string, string> = { "main.js": buildIsolateModule(params.code) };

  // Tier 3: best-effort resolve bare-specifier imports from a CDN as extra virtual modules.
  if (params.tier === 3) {
    const pkgs = extractBarePackageImports(params.code);
    for (const pkg of pkgs) {
      const src = await fetchEsmModule(pkg);
      if (src) modules[pkg] = src;
    }
  }

  const env: Record<string, unknown> = {};
  if (params.tier === 4) {
    if (!opts.browserWorker) {
      return {
        ok: false,
        error: "Tier 4 is unavailable: no naelao-browser service binding configured",
        tier: params.tier,
        duration_ms: Date.now() - started,
        tokens_used: 0,
      };
    }
    env.__BROWSER__ = opts.browserWorker;
    env.__BROWSER_TOKEN__ = opts.platformSecret ?? "";
  }

  // ctx.mcp is available at every isolate tier (2-4) — Code Mode's core use case is fast,
  // pure-JS multi-MCP orchestration, not something that should require Tier 4. Mints a
  // short-lived (60s), tenant-scoped token here in real TS — the isolate only ever receives
  // the finished token string, never the platform secret itself.
  if (opts.mcpHubWorker) {
    env.__MCP_HUB__ = opts.mcpHubWorker;
    env.__MCP_TOKEN__ = await mintInternalToken(opts.platformSecret ?? "", params.tenantId);
    env.__MCP_TENANT__ = params.tenantId;
    env.__MCP_SPACE__ = params.spaceId;
    env.__MCP_AGENT__ = params.agentId;
  }

  // One isolate per (space, script, code revision) — never share isolates across spaces.
  // `loader.get(id, factory)` caches by id and does NOT re-invoke `factory` (so does not
  // refresh `env`) while a warm isolate for that id exists. That's fine for env values with no
  // expiry (browser token, static bindings) but would silently stale-out __MCP_TOKEN__ (60s
  // freshness window) if the isolate stayed warm longer than that. So ONLY when mcp-hub is
  // wired, fold a coarse time bucket into the id — well inside the token's freshness window —
  // forcing a fresh isolate (and a fresh token) periodically. Scripts that never touch ctx.mcp
  // keep the original stable id, so their isolate-reuse cache hit rate is unaffected.
  const mcpTimeBucket = opts.mcpHubWorker ? `:mcp${Math.floor(Date.now() / 45_000)}` : "";
  const lockId = `${params.spaceId}:${params.name}:${hashCode(params.code)}${mcpTimeBucket}`;

  try {
    const stub = opts.loader.get(lockId, () => ({
      compatibilityDate: ISOLATE_COMPAT_DATE,
      mainModule: "main.js",
      modules,
      env,
    }));
    const entrypoint = stub.getEntrypoint();

    const controller = new AbortController();
    const timeoutMs = opts.isolateTimeoutMs ?? DEFAULT_ISOLATE_TIMEOUT_MS;
    const timer = setTimeout(() => controller.abort(), timeoutMs);
    try {
      const resp = await entrypoint.fetch(
        new Request("http://script/run", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ args: params.args }),
          signal: controller.signal,
        })
      );
      const body = await resp.json<{ ok: boolean; result?: unknown; error?: string }>();
      return {
        ok: body.ok,
        ...(body.ok ? { output: body.result } : { error: body.error ?? `isolate returned ${resp.status}` }),
        tier: params.tier,
        duration_ms: Date.now() - started,
        tokens_used: 0,
      };
    } finally {
      clearTimeout(timer);
    }
  } catch (err) {
    const aborted = err instanceof Error && err.name === "AbortError";
    const errMsg = aborted ? `Tier ${params.tier} execution timed out` : String(err instanceof Error ? err.message : err);

    // Auto-promotion — see ISOLATE_PROMOTION_ERROR_PATTERNS's own doc for why only an unresolved-
    // import failure qualifies (never a timeout, which this branch also handles above but does
    // NOT match any of the patterns). No-op when Tier 5 itself isn't wired — the caller gets the
    // original isolate error, which is still more useful than a second "unavailable" on top of it.
    if (opts.toolSandbox && !aborted && ISOLATE_PROMOTION_ERROR_PATTERNS.some((p) => p.test(errMsg))) {
      console.warn(`[execution-ladder] auto-promoting '${params.name}' from Tier ${params.tier} to Tier 5 after: ${errMsg}`);
      const promoted = await runContainer(opts, {
        name: params.name,
        code: params.code,
        args: params.args,
        spaceId: params.spaceId,
        agentId: params.agentId,
        ...(params.projectId ? { projectId: params.projectId } : {}),
      });
      // A successful promotion's `output` is the script's own real return value — left exactly
      // as runContainer produced it, never annotated. A FAILED promotion gets the isolate's
      // original error folded in ahead of the container's own, so "why did this fail" reads as
      // one coherent story instead of only the second attempt's error with no trace of the first.
      if (promoted.ok) return promoted;
      return { ...promoted, error: `Tier ${params.tier} failed (${errMsg}); auto-promoted to Tier 5, which also failed: ${promoted.error ?? "unknown error"}` };
    }

    return {
      ok: false,
      error: errMsg,
      tier: params.tier,
      duration_ms: Date.now() - started,
      tokens_used: 0,
    };
  }
}

async function runContainer(
  opts: CodeRunnerOptions,
  params: { name: string; code: string; args: Record<string, unknown>; spaceId: string; agentId: string; projectId?: string; containerImage?: string }
): Promise<ScriptRunResult> {
  const started = Date.now();

  // §A1.17 Phase L: a script tagged with a Container Marketplace image routes to THAT image's
  // own binding, never the base sandbox — fails closed with a clear message when the image
  // isn't wired yet (every catalogue image ships unavailable today; see container-catalogue.ts).
  if (params.containerImage) {
    const namespace = opts.containerImages?.[params.containerImage];
    if (!namespace) {
      return {
        ok: false,
        error: `Container image '${params.containerImage}' is not available in this environment yet`,
        tier: 5,
        duration_ms: Date.now() - started,
        tokens_used: 0,
      };
    }
    // No live image binds a namespace yet (see the comment above), so this branch has no
    // reachable success path today — the addressing convention (per project, like Phase K's
    // base sandbox) is documented here for whichever image lands it first.
    const doId = namespace.idFromName(`slot:${params.containerImage}:${params.spaceId}:${params.projectId ?? "_assistant"}`);
    const stub = namespace.get(doId);
    return runContainerRequest(stub, opts, params, started);
  }

  if (!opts.toolSandbox) {
    return {
      ok: false,
      error: "Tier 5 is unavailable: no ToolSandboxDO (TOOL_SANDBOX) binding configured",
      tier: 5,
      duration_ms: Date.now() - started,
      tokens_used: 0,
    };
  }

  // §A1.17 Phase K: addressed per PROJECT (not per agent) so every thread's agent in the same
  // project shares one container + R2 workspace (spec §33b) — matches workspacePrefix()'s own
  // space/project scoping. "_assistant" is a fixed per-space slot for the Space Assistant
  // (projectId absent), analogous to workspacePrefix()'s space-scoped fallback.
  const doId = opts.toolSandbox.idFromName(`sandbox:${params.spaceId}:${params.projectId ?? "_assistant"}`);
  const stub = opts.toolSandbox.get(doId);
  return runContainerRequest(stub, opts, params, started);
}

async function runContainerRequest(
  stub: DurableObjectStub,
  opts: CodeRunnerOptions,
  params: { name: string; code: string; args: Record<string, unknown>; spaceId: string; agentId: string; projectId?: string },
  started: number
): Promise<ScriptRunResult> {
  const controller = new AbortController();
  const timeoutMs = opts.containerTimeoutMs ?? DEFAULT_CONTAINER_TIMEOUT_MS;
  const timer = setTimeout(() => controller.abort(), timeoutMs);
  try {
    const resp = await stub.fetch(
      new Request("http://sandbox/exec", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          name: params.name,
          code: params.code,
          args: params.args,
          spaceId: params.spaceId,
          ...(params.projectId ? { projectId: params.projectId } : {}),
        }),
        signal: controller.signal,
      })
    );
    const body = await resp.json<{ ok: boolean; result?: unknown; error?: string; logs?: string }>();
    return {
      ok: resp.ok && body.ok,
      ...(resp.ok && body.ok ? { output: body.result } : { error: body.error ?? `container returned ${resp.status}` }),
      tier: 5,
      duration_ms: Date.now() - started,
      tokens_used: 0,
    };
  } catch (err) {
    const aborted = err instanceof Error && err.name === "AbortError";
    return {
      ok: false,
      error: aborted ? "Tier 5 execution timed out" : String(err instanceof Error ? err.message : err),
      tier: 5,
      duration_ms: Date.now() - started,
      tokens_used: 0,
    };
  } finally {
    clearTimeout(timer);
  }
}

/** Cheap deterministic string hash (FNV-1a) — used only to key isolate reuse, not security. */
function hashCode(s: string): string {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 0x01000193);
  }
  return (h >>> 0).toString(16);
}

/** Builds the TieredCodeRunner the host (NaelaoAgentDO) wires into ScriptEngineEnv.codeRunner. */
export function buildCodeRunner(opts: CodeRunnerOptions): TieredCodeRunner {
  return {
    async run(params) {
      if (params.tier === 5) return runContainer(opts, params);
      if (params.tier === 2 || params.tier === 3 || params.tier === 4) return runIsolate(opts, params);
      return {
        ok: false,
        error: `Tier ${params.tier} has no codeRunner backend (Tier 1 must be handled in-process)`,
        tier: params.tier,
        duration_ms: 0,
        tokens_used: 0,
      };
    },
  };
}
