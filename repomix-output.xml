    const result = await env.PRODUCT_DB_REGISTRY.list({
      prefix: 'assistant:',
      limit: 1000,
      cursor
    });
    for (const key of result.keys) {
      await processAssistantHeartbeat(key.name);
    }
    cursor = result.cursor;
  } while (!result.list_complete);

