  id TEXT PRIMARY KEY,
  space_id TEXT NOT NULL,
  user_id TEXT NOT NULL, -- required, even in non-shared mode
  channel_type TEXT,
  channel_id TEXT, -- Slack channel ID, Discord guild ID, etc.
  created_at INTEGER NOT NULL DEFAULT (unixepoch('now')*1000),
  last_message_at INTEGER
)`;
this.sql`CREATE UNIQUE INDEX IF NOT EXISTS idx_sessions_channel_user
  ON sessions(channel_type, channel_id, user_id)`;

// Session lookup: unique per channel+user combination
async getOrCreateSession(
  channelType: string, channelId: string, userId: string
): Promise&lt;Session&gt; {
  return this.sql&lt;Session[]&gt;`
    INSERT OR IGNORE INTO sessions
      (id, space_id, user_id, channel_type, channel_id)
    VALUES (
      ${crypto.randomUUID()}, ${this.spaceId},
      ${userId}, ${channelType}, ${channelId}
    )
    RETURNING *
  `[0] ?? this.sql&lt;Session[]&gt;`
    SELECT * FROM sessions
    WHERE channel_type=${channelType}
      AND channel_id=${channelId}
      AND user_id=${userId}
  `[0];
}
```</p></div>
