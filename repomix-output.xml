      <!-- ======================== Operational &amp; Versioning ======================== -->
      <h2 style="margin-top:64px;margin-bottom:8px;">Operational &amp; Versioning</h2>
      <div class="bar"></div>

      <div id="G-OPE-01" style="margin:40px 0 0;padding:28px 0 0;border-top:1px solid var(--brd);">
        <div style="display:flex;align-items:baseline;gap:12px;margin-bottom:6px;">
          <span style="font-family:'DM Mono',monospace;font-size:10px;color:var(--or);background:rgba(232,105,42,.12);padding:2px 8px;border-radius:4px;">G-OPE-01</span>
          <h3 style="font-family:'Fraunces',serif;font-size:22px;font-weight:600;color:var(--hd);letter-spacing:-.01em;">Disaster Recovery — No Plan, No RTO, No RPO</h3>
        </div>
        <div class="box box-rd">
          <div class="box-lbl">The Gap</div>
          <p>Disaster Recovery — No Plan, No RTO, No RPO The entire spec assumes Cloudflare's infrastructure is always available. There is no specified disaster recovery plan, no defined Recovery Time Objective (RTO), no defined Recovery Point Objective (RPO), and no backup strategy for the three stateful systems: SpaceDO SQLite , R2 workspaces , and Vectorize indexes . For any enterprise customer, this is a hard procurement blocker before a contract is signed. Cloudflare's Durable Objects are globally distributed and survive most single-region failures. But DO SQLite storage is not replicated to customer-accessible backups. If a DO's SQLite database is corrupted — by a bad migration, a bug in schema…</p>
        </div>
        <div class="box box-gr" style="margin-top:12px;">
          <div class="box-lbl">Required Fix</div>
          <p>Required Mitigations — Must Specify Before Enterprise Sales // 1. Add to naelao-sweeper: daily SpaceDO → R2 backup // Cron: "0 3 * * *" (3am UTC daily — low traffic window) async function backupSpaceDO(spaceId: string, env: Env): Promise&lt;void&gt; { const spaceDO = getProductDO(spaceId, env); // Call a new SpaceDO method: exportSnapshot() // Returns: { tables: Record&lt;string, Row[]&gt;, exportedAt: string, schemaVersion: number } const snapshot = await spaceDO.fetch( new Request('http://space/export-snapshot') ).then(r =&gt; r.json()); const date = new Date().toISOString().split('T')[0]; const backupKey = `backups/${spaceId}/${date}/space-snapshot.json.gz`; // Compress and write to R2 — not naelao-workspace (product data) // but a separate naelao-backups bucket (write-once, lifecycle: 90 days) const…</p>
        </div>
        <pre style="background:var(--bg3);border:1px solid var(--brd);border-radius:8px;padding:16px;overflow-x:auto;margin-top:12px;"><code style="font-family:'DM Mono',monospace;font-size:11.5px;color:var(--cy);line-height:1.6;">// 1. Add to naelao-sweeper: daily SpaceDO → R2 backup
// Cron: &quot;0 3 * * *&quot; (3am UTC daily — low traffic window)
async function backupSpaceDO(spaceId: string, env: Env): Promise&lt;void&gt; {
  const spaceDO = getProductDO(spaceId, env);
  
  // Call a new SpaceDO method: exportSnapshot()
  // Returns: { tables: Record&lt;string, Row[]&gt;, exportedAt: string, schemaVersion: number }
  const snapshot = await spaceDO.fetch(
    new Request(&#x27;http://space/export-snapshot&#x27;)
  ).then(r =&gt; r.json());
  
  const date = new Date().toISOString().split(&#x27;T&#x27;)[0];
  const backupKey = `backups/${spaceId}/${date}/space-snapshot.json.gz`;
  
  // Compress and write to R2 — not naelao-workspace (product data)
  // but a separate naelao-backups bucket (write-once, lifecycle: 90 days)
  const compressed = await compressGzip(JSON.stringify(snapshot));
  await env.NAELAO_BACKUPS.put(backupKey, compressed, {
    customMetadata: { spaceId, exportedAt: snapshot.exportedAt, schemaVersion: String(snapshot.schemaVersion) }
  });
}

// 2. Enable R2 bucket versioning (add to infrastructure setup)
// wrangler.jsonc — naelao-workspace bucket config
// { &quot;bucket_name&quot;: &quot;naelao-workspace&quot;, &quot;versioning&quot;: true }
// This enables: env.NAELAO_WORKSPACE.list({ include: [&#x27;versions&#x27;] })
// Previous versions retained for 30 days before deletion

// 3. SpaceDO.exportSnapshot() — new method needed
exportSnapshot(): object {
  const tables = [&#x27;spaces&#x27;,&#x27;space_members&#x27;,&#x27;product_users&#x27;,&#x27;threads&#x27;,
                  &#x27;messages&#x27;,&#x27;agent_runs&#x27;,&#x27;billing&#x27;,&#x27;agent_definitions&#x27;];
  const result: Record&lt;string, unknown[]&gt; = {};
  for (const table of tables) {
    result[table] = [...this.db.exec(`SELECT * FROM ${table}`).rows];
  }
  return { tables: result, exportedAt: new Date().toISOString(),
           schemaVersion: CURRENT_SCHEMA_VERSION };
}</code></pre>
