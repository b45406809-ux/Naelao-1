    <h3>The Space Type Manifest</h3>
    <p>A Space Type is defined by a manifest file. This is how you create a new Space Type without touching platform
      code. The manifest declares what primitives are enabled, which agents are pre-installed, which skills come with
      it, and what the UI theme looks like.</p>
    <pre><code><span class="cm">// types/space-type-manifest.ts
// This is the interface a Space Type manifest must implement.
// Platform reads this to configure a new Space when it's created.</span>

export interface NaelaoSpaceTypeManifest {
  id: string;                    <span class="cm">// e.g., 'launchpad', 'sites', 'custom-ecommerce'</span>
  name: string;
  description: string;
  version: string;               <span class="cm">// semver</span>
  author: string;                <span class="cm">// 'naelao' for platform types, userId for community</span>

  <span class="cm">// Primitives enabled for this Space Type</span>
  primitives: {
    walletDO: boolean;           <span class="cm">// Enable WalletDO for agents in this space</span>
    workerDefinitions: boolean;  <span class="cm">// This space can host WorkerDefinitionDOs</span>
    miniAGI: boolean;            <span class="cm">// Enable MiniAGIDO for company intelligence layer</span>
    subSpaces: {
      enabled: boolean;
      maxDepth: number;          <span class="cm">// 1-3</span>
      allowedChildTypes: string[]; <span class="cm">// which space types sub-spaces can be</span>
    };
    collaborationFeatures: boolean; <span class="cm">// ProjectDO file locks, presence, activity feed</span>
    bootstrapMode: boolean;      <span class="cm">// Enable Bootstrap Mode for Verticals</span>
  };

  <span class="cm">// Pre-installed agents from marketplace</span>
  defaultAgents: Array&lt;{
    definitionId: string;        <span class="cm">// agent definition UUID from naelao marketplace</span>
    autoInstall: boolean;        <span class="cm">// install immediately on space creation</span>
    pinToUI: boolean;            <span class="cm">// show prominently in space UI</span>
  }&gt;;

  <span class="cm">// Pre-loaded skills from platform skills/ folder</span>
  defaultSkills: Array&lt;{
    skillId: string;
    tier: 1 | 2 | 3;            <span class="cm">// 1=platform, 2=space, 3=agent</span>
  }&gt;;

  <span class="cm">// MCP Apps auto-installed for this Space Type</span>
  defaultApps: string[];         <span class="cm">// array of app IDs from naelao-apps-registry</span>

  <span class="cm">// Dynamic Workflow templates pre-loaded in WorkflowRegistryDO</span>
  workflowTemplates: Array&lt;{
    id: string;
