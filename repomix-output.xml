═══════════════════════════════════════════════════════ -->
  <div class="sec" id="mini-agi">
    <span class="sec-ey">09 — Mini-AGI Space Type</span>
    <h2>Mini-AGI — Company-Level Intelligence Layer</h2>
    <div class="bar"></div>
    <p class="lead">The Mini-AGI Space Type is inspired by Jack Dorsey's idea that every company can now be a Mini-AGI.
      The concept: a company installs a Mini-AGI into their Space, and it becomes the intelligence layer for the entire
      organization — answering questions, routing tasks, managing data access, and coordinating agents across all
      sub-spaces.</p>

    <div class="box box-ye">
      <div class="box-lbl">The Core Idea (Sequoia / Jack Dorsey)</div>
      <p>Every company is now collecting data from every customer interaction, every employee action, every system
        event. A Mini-AGI is the layer that makes that data queryable and actionable by the whole company. The Mini-AGI
        at McKinsey can answer "What have our consultants learned about supply chain optimization in the last 6 months?"
        The Mini-AGI at Airbnb can answer "What are the top 3 host complaints this week in Southeast Asia?"</p>
      <p>The critical constraint: not everyone in the company should be able to ask every question. A sales rep
        shouldn't be able to query internal legal strategy. A contractor shouldn't see employee salary data. The
        Mini-AGI enforces these access controls per-question, per-user, per-data-domain.</p>
    </div>

    <h3>Mini-AGI Architecture</h3>
    <p>A Mini-AGI is a sub-space type that gets installed into an Enterprise or Team Space. Each Mini-AGI has a
      MiniAGIDO as its intelligence layer, plus data access controls that determine which users and sub-spaces can query
      which data domains.</p>

    <div class="arch">
      <div class="arch-t">Mini-AGI Data Access Control Flow</div>
      <div class="ar">
        <div class="ab ab-a">Company Member (any role)</div>
        <div class="aa">→ asks question →</div>
        <div class="ab ab-w">MiniAGIDO</div>
      </div>
      <div class="ar">
        <div class="ab ab-w">MiniAGIDO</div>
        <div class="aa">→ checks access matrix →</div>
        <div class="ab ab-g">Data Access Control Table</div>
      </div>
      <div class="ar">
        <div class="ab ab-g">Access Control Table</div>
        <div class="aa">→ grants access to →</div>
        <div class="ab ab-r">Permitted Data Domains in R2</div>
      </div>
      <div class="ar">
        <div class="ab ab-r">R2 Data</div>
        <div class="aa">→ queried by →</div>
        <div class="ab ab-w">MiniAGIDO (NaelaoAgentDO sub-agent)</div>
        <div class="aa">→ answers →</div>
        <div class="ab ab-a">Member</div>
      </div>
      <div class="arch-lbl">Members never access R2 directly. MiniAGIDO is the gatekeeper. Access is denied by default —
        must be explicitly granted per domain per role.</div>
    </div>

    <h3>MiniAGIDO — Complete Schema</h3>
    <pre><code><span class="cm">// durable-objects/mini-agi-do.ts
// The Mini-AGI intelligence layer for a company Space.
// One MiniAGIDO per Mini-AGI sub-space.
// Routes queries to the right data, enforces access controls.</span>

export class MiniAGIDO extends DurableObject {
  private async initSchema() {
    this.ctx.storage.sql.exec(`
      <span class="cm">-- Data domains: logical groups of company data</span>
      CREATE TABLE IF NOT EXISTS data_domains (
        id           TEXT PRIMARY KEY,
        name         TEXT NOT NULL,      <span class="cm">-- e.g., 'hr-data', 'sales-data', 'legal-docs'</span>
        description  TEXT NOT NULL,
        r2_prefix    TEXT NOT NULL,      <span class="cm">-- which R2 path prefix this domain covers</span>
        sensitivity  TEXT DEFAULT 'internal', <span class="cm">-- 'public'|'internal'|'confidential'|'restricted'</span>
        created_at   INTEGER DEFAULT (unixepoch('now') * 1000)
      );

      <span class="cm">-- Access control matrix: who can query which domain</span>
      CREATE TABLE IF NOT EXISTS access_grants (
        id           TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
        domain_id    TEXT NOT NULL REFERENCES data_domains(id),
        grantee_type TEXT NOT NULL,      <span class="cm">-- 'role'|'user'|'sub_space'</span>
        grantee_id   TEXT NOT NULL,      <span class="cm">-- role name, userId, or spaceId</span>
        access_level TEXT NOT NULL DEFAULT 'read', <span class="cm">-- 'read'|'query'|'write'|'admin'</span>
        granted_by   TEXT NOT NULL,      <span class="cm">-- userId of admin who granted this</span>
        expires_at   INTEGER,            <span class="cm">-- null = permanent</span>
        granted_at   INTEGER DEFAULT (unixepoch('now') * 1000)
      );
      CREATE INDEX IF NOT EXISTS idx_access ON access_grants(grantee_type, grantee_id, domain_id);

      <span class="cm">-- Query log: every query is logged for audit
      -- This is REQUIRED for compliance — do not make it optional</span>
      CREATE TABLE IF NOT EXISTS query_log (
        id           TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
        user_id      TEXT NOT NULL,
        query        TEXT NOT NULL,      <span class="cm">-- the natural language question</span>
        domains_accessed TEXT NOT NULL,  <span class="cm">-- JSON array of domain IDs queried</span>
        domains_denied   TEXT NOT NULL,  <span class="cm">-- JSON array of domains the user couldn't access</span>
        answer_given TEXT,               <span class="cm">-- the answer provided (truncated to 500 chars)</span>
        latency_ms   INTEGER,
        created_at   INTEGER DEFAULT (unixepoch('now') * 1000)
      );

      <span class="cm">-- Installed sub-spaces (Mini-AGI installed in which sub-spaces)</span>
      CREATE TABLE IF NOT EXISTS installations (
        sub_space_id TEXT PRIMARY KEY,
        installed_at INTEGER DEFAULT (unixepoch('now') * 1000),
        config       TEXT DEFAULT '{}'
      );
    `);
  }

  <span class="cm">// The core method: answer a question from a user
  // This enforces access controls before touching any data</span>
  async query(params: {
    userId: string;
    userRole: string;
    subSpaceId: string;
    question: string;
  }): Promise&lt;MiniAGIResponse&gt; {
    const startMs = Date.now();

    <span class="cm">// 1. Determine which data domains this question might need
    // Use LLM to classify the question — fast with haiku</span>
    const classification = await this.env.NAELAO_AI_GATEWAY.messages.create({
      model: 'claude-haiku-4-5',
      max_tokens: 200,
      messages: [{
        role: 'user',
        content: `You are a data domain classifier. Given this question, list the data domains it needs.
Available domains: ${this.getAvailableDomains()}
Question: "${params.question}"
Respond with JSON: {"domains": ["domain-id-1", "domain-id-2"]}`
      }]
    });
    
    const { domains: requiredDomains } = JSON.parse(
      classification.content[0].text ?? '{"domains": []}'
    );

    <span class="cm">// 2. Check access for each required domain</span>
    const accessResults = await this.checkAccess(
      params.userId, params.userRole, params.subSpaceId, requiredDomains
    );
    
    const grantedDomains = accessResults.filter(r => r.granted).map(r => r.domainId);
    const deniedDomains = accessResults.filter(r => !r.granted).map(r => r.domainId);

    if (grantedDomains.length === 0) {
      <span class="cm">// No access to any required domain</span>
      await this.logQuery(params, requiredDomains, deniedDomains, null, Date.now() - startMs);
      return {
        success: false,
        answer: "I don't have access to the data needed to answer that question.",
        accessDenied: true,
        deniedDomains
      };
    }

    <span class="cm">// 3. Fetch data from granted domains in R2</span>
    const domainData = await this.fetchDomainData(grantedDomains, params.question);

    <span class="cm">// 4. Generate answer using LLM with retrieved data</span>
    const answer = await this.env.NAELAO_AI_GATEWAY.messages.create({
      model: 'claude-sonnet-4-5',
      max_tokens: 1000,
      system: `You are the company's intelligence layer. Answer questions based ONLY on the provided data.
If the data doesn't contain enough information, say so clearly. Never make up information.
If some relevant data was not accessible (access denied), mention that limitation.`,
      messages: [{
        role: 'user',
        content: `Question: ${params.question}

Available data (you can only see data from domains the user has access to):
${domainData}

${deniedDomains.length > 0 ? `Note: Some data domains were not accessible to this user: ${deniedDomains.join(', ')}` : ''}`
      }]
    });

    const answerText = answer.content[0].text ?? 'Unable to generate answer.';
    
    <span class="cm">// 5. Log every query — REQUIRED for compliance</span>
    await this.logQuery(params, grantedDomains, deniedDomains, answerText, Date.now() - startMs);

    return {
      success: true,
      answer: answerText,
      accessDenied: false,
      deniedDomains,
      domainsQueried: grantedDomains
    };
  }

  private async checkAccess(
    userId: string,
    userRole: string,
    subSpaceId: string,
    domainIds: string[]
  ): Promise&lt;Array&lt;{ domainId: string; granted: boolean; reason: string }&gt;&gt; {
    return domainIds.map(domainId => {
      <span class="cm">// Check if any grant exists for this user+role+subspace on this domain</span>
      const grant = this.ctx.storage.sql.exec(`
        SELECT access_level FROM access_grants
        WHERE domain_id = ?
          AND (
            (grantee_type = 'role' AND grantee_id = ?) OR
            (grantee_type = 'user' AND grantee_id = ?) OR
            (grantee_type = 'sub_space' AND grantee_id = ?)
          )
          AND (expires_at IS NULL OR expires_at > ?)
        LIMIT 1
      `, domainId, userRole, userId, subSpaceId, Date.now()).one();

      return {
        domainId,
        granted: !!grant,
        reason: grant ? `Granted via ${(grant as any).access_level}` : 'No access grant found'
      };
    });
  }
}</code></pre>

