// 1. Validate tool name against the registry — never pass raw tool names to exec
function resolveContainerCommand(toolName: string): string {
  const toolDef = TOOL_TIERS[toolName];
  if (!toolDef) throw new Error(`Unknown tool: ${toolName}`);
  if (toolDef.tier !== &#x27;sandbox&#x27;) throw new Error(`Tool ${toolName} is not a sandbox-tier tool`);

  // Map tool name to the actual binary path (pre-approved list)
  const TOOL_COMMANDS: Record&lt;string, string&gt; = {
    &#x27;execute_python&#x27;: &#x27;/usr/bin/python3&#x27;,
    &#x27;execute_bash&#x27;:   &#x27;/usr/local/bin/safe-bash&#x27;,  // wrapper that blocks dangerous builtins
    &#x27;execute_node&#x27;:   &#x27;/usr/bin/node&#x27;,
    &#x27;run_tests&#x27;:      &#x27;/usr/local/bin/vitest&#x27;,
  };
  const cmd = TOOL_COMMANDS[toolName];
  if (!cmd) throw new Error(`No container command mapped for tool: ${toolName}`);
  return cmd;
}

// 2. Argument sanitisation per tool — not generic
function sanitizeArgs(toolName: string, rawArgs: Record&lt;string, unknown&gt;): string[] {
  switch (toolName) {
    case &#x27;execute_bash&#x27;: {
      // Bash gets a single -c &quot;script&quot; argument — never split into multiple args
      // The script content is already security-scanned by the 27-pattern scanner
      const script = String(rawArgs.code ?? rawArgs.command ?? &#x27;&#x27;);
      return [&#x27;-c&#x27;, script]; // safe — bash -c treats the script as a single unit
    }
    case &#x27;execute_python&#x27;: {
      const script = String(rawArgs.code ?? &#x27;&#x27;);
      // Write to a temp file, execute the file — never pass code via -c flag
      // -c with long scripts is fragile and argument-length-limited
      return [&#x27;-&#x27;]; // python reads from stdin — content piped separately
    }
    default:
      // For unknown tools: only allow string values with no flag-like patterns
      return Object.values(rawArgs)
        .map(v =&gt; String(v))
        .filter(v =&gt; !v.startsWith(&#x27;-&#x27;)); // reject anything that looks like a flag
  }
}</code></pre>
