function selectSpaceType(el){document.querySelectorAll('#sd-create .card').forEach(c=>{c.style.borderColor='var(--border)';c.style.background='var(--surface)'});el.style.borderColor='var(--accent)';el.style.background='var(--accent-dim)';}

