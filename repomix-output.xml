<file path="apps/shell/src/lib/productAccount.ts">
// End-user auth client, scoped to ONE product (spaceId) — ported from
// apps/portal/src/lib/productAccount.ts (Three-Tier Platform Model, Phase 6). A person could be
// signed into several different builder products in the same browser, so session state is keyed
// per spaceId, never global.

const API_URL = process.env.NEXT_PUBLIC_API_URL ?? "http://localhost:8787";

export interface ProductEndUser {
  end_user_id: string;
  session_token: string;
  expires_at: string;
  /** Security audit follow-up: signup's free-credit grant is deferred until email verification
   *  closes (prevents farming free compute with throwaway addresses) — true whenever the product
   *  has a signup allowance to protect, so the caller knows to show the "check your email" state. */
  email_verification_required?: boolean;
}

function storageKey(spaceId: string): string {
  return `naelao_product_session:${spaceId}`;
}

export function getProductSession(spaceId: string): ProductEndUser | null {
  if (typeof window === "undefined") return null;
  try {
    const raw = localStorage.getItem(storageKey(spaceId));
    return raw ? (JSON.parse(raw) as ProductEndUser) : null;
  } catch {
    return null;
  }
}

function storeProductSession(spaceId: string, session: ProductEndUser): void {
  try {
    localStorage.setItem(storageKey(spaceId), JSON.stringify(session));
  } catch {
    /* ignore */
  }
}

export function clearProductSession(spaceId: string): void {
  try {
    localStorage.removeItem(storageKey(spaceId));
  } catch {
    /* ignore */
  }
}

export function isSignedIn(spaceId: string): boolean {
  const session = getProductSession(spaceId);
  if (!session) return false;
  return new Date(session.expires_at) > new Date();
}

async function call<T>(path: string, body: unknown): Promise<T> {
  const res = await fetch(`${API_URL}${path}`, {
    method: "POST",
    headers: { "content-type": "application/json" },
    body: JSON.stringify(body),
  });
  if (!res.ok) {
    let message = `Request failed (${res.status})`;
    try {
      const b = (await res.json()) as { message?: string; error_code?: string };
      message = b.message ?? b.error_code ?? message;
    } catch {
      /* use default message */
    }
    throw new Error(message);
  }
  return res.json() as Promise<T>;
}

export async function signUp(
  spaceId: string,
  email: string,
  password: string,
  displayName?: string
): Promise<ProductEndUser> {
  const session = await call<ProductEndUser>(`/v1/spaces/${spaceId}/end-users/signup`, {
    email,
    password,
    ...(displayName ? { display_name: displayName } : {}),
  });
  storeProductSession(spaceId, session);
  return session;
}

export async function logIn(spaceId: string, email: string, password: string): Promise<ProductEndUser> {
  const session = await call<ProductEndUser>(`/v1/spaces/${spaceId}/end-users/login`, { email, password });
  storeProductSession(spaceId, session);
  return session;
}

export function logOut(spaceId: string): void {
  clearProductSession(spaceId);
}

/** Redeems a verification token — either from the emailed link's ?token= or pasted in by hand
 *  (the fallback path when the email couldn't carry a clickable link, or a link goes stale). */
export async function verifyEmail(spaceId: string, token: string): Promise<{ ok: boolean; message: string }> {
  return call(`/v1/spaces/${spaceId}/end-users/verify-email`, { token });
}

/** Always resolves with the same generic response whether or not the account exists/is already
 *  verified — mirrors the backend's own "never reveal account existence" contract. */
export async function resendVerification(spaceId: string, email: string): Promise<{ ok: boolean; message: string }> {
  return call(`/v1/spaces/${spaceId}/end-users/resend-verification`, { email });
}
</file>

<file path="apps/shell/src/lib/relativeTime.ts">
/** Short, human "when" for list rows. Deliberately coarse — a session list needs "2h ago", not a
 *  timestamp precise enough to read as data. */
export function relativeTime(iso: string): string {
  const then = new Date(iso).getTime();
  if (Number.isNaN(then)) return "";
  const mins = Math.floor((Date.now() - then) / 60_000);
  if (mins < 1) return "just now";
  if (mins < 60) return `${mins}m ago`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  if (days < 30) return `${days}d ago`;
  return new Date(iso).toLocaleDateString();
}
</file>

<file path="apps/shell/src/lib/roles.ts">
// Which business roles may change settings, in one place.
//
// This exists because of a real bug: the dashboard gated its assistant controls on
// `role === "admin"` exactly, while whoever CREATES a business is always inserted as `'owner'`
// (workers/spaces/src/business-routes.ts). The backend ranks owner(3) >= admin(2)
// (business-auth.ts's ROLE_RANK), so the server would happily have accepted the write — but the
// UI never offered it, and every business creator saw their own settings read-only.
//
// The lesson is that an exact-match role check silently drifts from a ranked one. So the rank is
// mirrored here, once, and every surface asks this rather than comparing strings itself.

export type BusinessRole = "viewer" | "member" | "admin" | "owner";

/** Mirrors workers/spaces/src/business-auth.ts's ROLE_RANK. Keep the two in step — a role added
 *  there but not here reads as "no access" in the UI, which fails safe but silently. */
const ROLE_RANK: Record<BusinessRole, number> = { viewer: 0, member: 1, admin: 2, owner: 3 };

export function roleAtLeast(role: string | null | undefined, minimum: BusinessRole): boolean {
  if (!role) return false;
  const rank = ROLE_RANK[role as BusinessRole];
  if (rank === undefined) return false;
  return rank >= ROLE_RANK[minimum];
}

/** Can this caller change the space's or an agent's configuration? The same floor
 *  `requireBusinessMembership({ PATCH: "admin" })` enforces server-side. `isBusinessSpace` is part
 *  of the question: on a product root (team mode) an end user is never more than a member, so
 *  those settings belong to the builder dashboard, not here. */
export function canManageSpaceSettings(isBusinessSpace: boolean, role: string | null | undefined): boolean {
  return isBusinessSpace && roleAtLeast(role, "admin");
}
</file>

