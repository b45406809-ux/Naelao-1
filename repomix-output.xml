    <h2>Agent Definition JSON — Complete Specification</h2>
    <div class="bar"></div>
    <p class="lead">Every agent in Naelao (platform agents, marketplace agents, SDK agents) is defined by a JSON
      document stored in SpaceDO SQLite. This section documents every field, its type, its validation rules, and the correct
      values for each agent tier.</p>

    <h3>Complete Agent Definition Schema</h3>
    <pre><code><span class="cm">// types/agent-definition.ts</span>
export interface AgentDefinition {
  <span class="cm">// Identity</span>
  id:           string;     <span class="cm">// UUID, generated on create</span>
  name:         string;     <span class="cm">// max 100 chars, human-readable</span>
  description:  string;     <span class="cm">// max 500 chars, shown in marketplace</span>
  version:      string;     <span class="cm">// semver: "1.0.0"</span>
  author:       string;     <span class="cm">// userId or "naelao" for platform agents</span>
  icon_url?:    string;     <span class="cm">// optional, shown in marketplace</span>

  <span class="cm">// LLM Configuration</span>
  model:        string;     <span class="cm">// model ID from getAvailableModels()</span>
  max_tokens?:  number;     <span class="cm">// max output tokens per turn, default 4096</span>
  temperature?: number;     <span class="cm">// 0.0-1.0, default 0.7</span>

  <span class="cm">// System Prompt</span>
  system_prompt: string;   <span class="cm">// the agent's base instructions, up to 100k chars</span>

  <span class="cm">// Skills and Capabilities</span>
  allowed_skills: string[]; <span class="cm">// skill names from platform/space/agent skill registry</span>
  mcp_configs?:  MCPConfig[]; <span class="cm">// external MCP server configurations</span>

  <span class="cm">// Execution Configuration</span>
  resource_tier: 'workspace' | 'isolate' | 'browser' | 'sandbox';
                            <span class="cm">// minimum tier this agent needs. workspace=cheapest, sandbox=most capable</span>

  <span class="cm">// Human-in-the-Loop</span>
  requires_approval_for?: string[]; <span class="cm">// action types requiring user approval before execution</span>
  max_iterations?:    number;   <span class="cm">// max agent loop iterations, default 50</span>
  timeout_ms?:        number;   <span class="cm">// max run duration, default 300000 (5 min)</span>

  <span class="cm">// Marketplace Configuration</span>
  marketplace_visible: boolean; <span class="cm">// false = private to author's space</span>
  price_usd_per_run?:  number; <span class="cm">// null = free, number = creator earns per run</span>
  supported_space_types: string[]; <span class="cm">// which space types can install this agent</span>

  <span class="cm">// For SDK Agents (deployed externally)</span>
  worker_url?:    string;   <span class="cm">// CF Worker URL for SDK agents</span>
  sdk_version?:   string;   <span class="cm">// minimum @naelao/agent-sdk version required</span>

  <span class="cm">// Metadata</span>
  created_at:   Date;
  updated_at:   Date;
  space_id?:    string;     <span class="cm">// null = global marketplace, set = space-private</span>
  status:       'active' | 'deprecated' | 'suspended';
}

<span class="cm">// Example: Complete Launchpad Fulfillment Agent definition</span>
export const LAUNCHPAD_FULFILLMENT_AGENT: AgentDefinition = {
  id:          'launchpad-fulfillment-v1',
  name:        'Fulfillment Agent',
  description: 'Automatically processes orders, delivers digital products, and handles receipts for Launchpad businesses.',
  version:     '1.2.0',
  author:      'naelao',
  icon_url:    'https://assets.naelao.dev/icons/fulfillment-agent.png',

  model:       'claude-haiku-4-5',  <span class="cm">// haiku for speed and cost on high-volume order processing</span>
  max_tokens:  1024,
  temperature: 0.3,                 <span class="cm">// low temperature — fulfillment should be deterministic</span>

  system_prompt: `You are an automated order fulfillment specialist for a digital business...`, <span class="cm">// see §11</span>

  allowed_skills: [
    'file-manager',   <span class="cm">// to read product files from R2</span>
    'api-caller',     <span class="cm">// to call Stripe API for payment verification</span>
