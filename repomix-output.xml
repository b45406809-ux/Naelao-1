    ol.nl {
      list-style: none;
      counter-reset: n;
      padding: 0;
      margin: 14px 0;
    }

    ol.nl li {
      counter-increment: n;
      padding: 9px 0 9px 42px;
      position: relative;
      font-size: 13.5px;
      color: var(--dim);
      border-bottom: 1px solid var(--brd);
      line-height: 1.62;
    }

    ol.nl li:last-child {
      border-bottom: none;
    }

    ol.nl li::before {
      content: counter(n);
      position: absolute;
      left: 0;
      top: 9px;
      width: 25px;
      height: 25px;
      background: var(--bg3);
      border: 1px solid var(--brd2);
      border-radius: 4px;
      font-family: 'DM Mono', monospace;
      font-size: 10.5px;
      color: var(--or);
      font-weight: 500;
      text-align: center;
      line-height: 25px;
    }

    /* ─── FLOW ────────────────────────────────────── */
    .flow {
      background: var(--bg2);
      border: 1px solid var(--brd);
      border-radius: 9px;
      padding: 22px;
      margin: 22px 0;
