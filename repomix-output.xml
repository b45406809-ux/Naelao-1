    <h3>Common Setup Errors and Fixes</h3>
    <table class="t">
      <thead>
        <tr>
          <th>Error Message</th>
          <th>Cause</th>
          <th>Fix</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="tl"><span class="mono">Error: Script startup exceeded CPU time limit</span></td>
          <td>Importing a Node.js-only package that does heavy work at import time</td>
          <td>Check all imports for Node.js-specific packages. Use <span class="ic">compatibility_flags:
              ["nodejs_compat"]</span> in wrangler.jsonc. Move heavy initialization inside request handlers, not at
            module level.</td>
        </tr>
        <tr>
          <td class="tl"><span class="mono">TypeError: Cannot read properties of undefined (reading 'get')</span></td>
          <td>Accessing a DO or binding that's not declared in wrangler.jsonc</td>
          <td>Verify the binding name in the TypeScript code matches the binding name in wrangler.jsonc exactly.
            Case-sensitive.</td>
        </tr>
        <tr>
          <td class="tl"><span class="mono">RLS policy violation: 0 rows returned</span></td>
          <td>Calling getProductDO() with a sub-space ID instead of the root space ID</td>
          <td>Add <span class="ic">.eq('space_id', spaceId)</span> to the query or use the withSpace() helper. Check the
            SpaceDO resolves to a different (possibly new) DO instance with an empty DB.</td>
        </tr>
        <tr>
          <td class="tl"><span class="mono">Error: Durable Object with that name not found</span></td>
          <td>DO class not declared in wrangler.jsonc durable_objects</td>
          <td>Add the class to wrangler.jsonc durable_objects.bindings array with the exact class name as exported.</td>
        </tr>
        <tr>
          <td class="tl"><span class="mono">vitest: FAIL — crypto.subtle is undefined</span></td>
          <td>Running tests in Node.js instead of workerd</td>
          <td>Verify vitest.config.ts uses <span class="ic">pool: '@cloudflare/vitest-pool-workers'</span>. Do NOT use
            default vitest config.</td>
        </tr>
        <tr>
          <td class="tl"><span class="mono">Error: R2 bucket not found</span></td>
          <td>Bucket name in wrangler.jsonc doesn't match the created bucket</td>
          <td>Run <span class="ic">npx wrangler r2 bucket list</span> to see actual bucket names. Must exactly match
            <span class="ic">bucket_name</span> in wrangler.jsonc.</td>
        </tr>
        <tr>
          <td class="tl"><span class="mono">Encryption error: Invalid key length</span></td>
          <td>NAELAO_MCP_ENCRYPTION_KEY is not exactly 32 bytes when decoded from base64</td>
          <td>Generate a new 32-byte key: <span class="ic">node -e "console.log(Buffer.from(crypto.getRandomValues(new
              Uint8Array(32))).toString('base64'))"</span></td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- ══════════════════════════════════════════════════════
     §35 — FINAL ARCHITECTURE PRINCIPLES
═══════════════════════════════════════════════════════ -->
  <div class="sep"></div>
  <div class="sec" id="final-principles">
    <span class="sec-ey">35 — Final Principles</span>
    <h2>Architecture Principles — The Rules That Never Break</h2>
    <div class="bar"></div>
    <p class="lead">These are the 10 inviolable rules of the Naelao architecture. If you find yourself breaking any of
      these to make something work, stop and reconsider your approach. Every one of these rules exists because violating
      it has caused a real production incident at a platform of comparable scale.</p>

    <div class="g2">
      <div class="card">
        <div class="card-lbl">Rule 1</div>
        <div class="card-title">Every DB query carries space_id</div>
        <p>No exceptions. If a query could theoretically return another tenant's data, it is a security vulnerability.
          withSpace() is the mechanism. RLS is the fallback. Both must be present.</p>
      </div>
      <div class="card bl">
        <div class="card-lbl">Rule 2</div>
        <div class="card-title">DOs use idFromName with spaceId prefix</div>
        <p>Never use newUniqueId() for DOs that hold business data. Never omit spaceId from the DO name. The name is the
          only isolation boundary for DOs — violate it and you have a data breach.</p>
      </div>
      <div class="card gr">
        <div class="card-lbl">Rule 3</div>
        <div class="card-title">WAL before execute, always</div>
        <p>Every tool execution must be wrapped in WAL.executeWithWAL(). If the DO crashes between WAL write and tool
          execution, the sweeper can replay. If you skip WAL, a crash loses work silently.</p>
      </div>
      <div class="card pu">
        <div class="card-lbl">Rule 4</div>
        <div class="card-title">Service Bindings, never fetch(), for internal calls</div>
        <p>Internal Worker-to-Worker calls use Service Bindings. fetch() between internal Workers adds 5-50ms latency
          unnecessarily. Service Bindings are same-process, essentially free.</p>
      </div>
      <div class="card tl">
        <div class="card-lbl">Rule 5</div>
        <div class="card-title">All secrets through naelao-credentials</div>
        <p>Agents never see raw API keys. Keys are encrypted at rest. Decrypted only in naelao-credentials Worker at
          request time. Injected into agent context without logging. Never in R2. Never in memory longer than one
          request.</p>
      </div>
      <div class="card am">
        <div class="card-lbl">Rule 6</div>
        <div class="card-title">Tests run in workerd, never Node.js</div>
        <p>@cloudflare/vitest-pool-workers from day one. If a test passes in Node.js but fails in workerd, it's the test
          that's wrong, not workerd. Workerd is production. Node.js is not.</p>
      </div>
      <div class="card rd">
        <div class="card-lbl">Rule 7</div>
        <div class="card-title">Scan all skills before loading</div>
        <p>The 27-pattern scanner plus LLM judge runs on every unverified skill and every agent-authored workflow before
          it is written to R2 or executed. ClawHavoc killed OpenClaw. It won't kill Naelao.</p>
      </div>
      <div class="card cy">
        <div class="card-lbl">Rule 8</div>
        <div class="card-title">One DynamicWorkflow binding covers all tenants</div>
        <p>Never add a second DynamicWorkflow binding. The spaceId in metadata is what determines which tenant's code
          runs. One binding, validated on every step dispatch.</p>
      </div>
    </div>

    <div class="g2">
      <div class="card">
        <div class="card-lbl">Rule 9</div>
        <div class="card-title">Memory is typed JSON, never flat Markdown</div>
        <p>Agent and assistant memory lives in DO SQLite as typed JSON with schema validation. The writeMemory() API
          rejects injection patterns. No arbitrary text enters the system prompt from memory.</p>
      </div>
      <div class="card bl">
        <div class="card-lbl">Rule 10</div>
        <div class="card-title">Containers are on-demand, R2 is the filesystem</div>
        <p>The container is temporary compute. R2 is permanent storage. A container that crashes or sleeps does not lose
          any data. Files persist in R2. The container just mounts them when it wakes. Design every agent feature with
          this in mind.</p>
      </div>
    </div>

    <div class="pull">"Naelao is Suna, rebuilt for the edge — where compute is on-demand, storage is permanent, and
      every architectural decision optimises for zero idle cost."</div>
  </div>

  <!-- ══════════════════════════════════════════════════════
     §36 — NAELAO-SWEEPER: COMPLETE SPEC
═══════════════════════════════════════════════════════ -->
  <div class="sep"></div>
  <div class="sec" id="naelao-sweeper">
    <span class="sec-ey">36 — Worker Deep Dive: naelao-sweeper</span>
    <h2>naelao-sweeper — The Heartbeat & Cleanup Cron</h2>
    <div class="bar"></div>
    <p class="lead">naelao-sweeper is a cron-triggered Worker that fires every 5 minutes. It is the operational backbone
      of the platform: it wakes Space Assistants for scheduled tasks, cleans up abandoned agent runs, reprocesses
      dead-letter queue messages, and monitors platform health. Without it, the platform slowly accumulates orphaned
      state and missed assistant heartbeats.</p>

    <h3>Why a Cron Worker Instead of DO Alarms for Heartbeats</h3>
    <p>DO Alarms are perfect for single-DO scheduling. But to wake <em>all active assistants</em> simultaneously every 5
      minutes, you need a central cron trigger. If you tried to coordinate this with individual DO alarms, each DO would
      drift on its own schedule and you'd have no single place to monitor or debug the heartbeat loop.</p>
    <p>The sweeper reads the list of active product SpaceDOs from KV (PRODUCT_DB_REGISTRY) once per invocation, then fans out heartbeat calls
      to each AssistantDO in parallel. The fan-out uses <span class="ic">Promise.allSettled()</span> so a single failing
      AssistantDO doesn't block the others.</p>

    <h3>Complete Implementation</h3>
    <pre><code><span class="cm">// workers/sweeper/index.ts
// Triggered every 5 minutes via CF Cron Trigger in wrangler.jsonc
// "*/5 * * * *"</span>

export default {
  async scheduled(event: ScheduledEvent, env: Env, ctx: ExecutionContext): Promise&lt;void&gt; {
    console.log('[NAELAO SWEEPER] Starting sweep at', new Date().toISOString());
    const spaceDO = getProductDO(rootSpaceId, env);  // SpaceDO replaces Hyperdrive

    <span class="cm">// Run all sweep tasks in parallel — each is independent</span>
    const results = await Promise.allSettled([
      sweepAssistantHeartbeats(db, env),
      sweepAbandonedAgentRuns(db, env),
      sweepExpiredFileLocks(db, env),
      sweepDeadLetterQueue(env),
      sweepStaleFineTuneJobs(db, env),
    ]);

    <span class="cm">// Log any failures — sweep failures are non-fatal but must be monitored</span>
    results.forEach((result, i) => {
      const taskNames = [
        'assistantHeartbeats', 'abandonedRuns',
        'fileLocks', 'deadLetterQueue', 'fineTuneJobs'
      ];
      if (result.status === 'rejected') {
        console.error(`[NAELAO SWEEPER] ${taskNames[i]} failed:`, result.reason);
        <span class="cm">// Log to Analytics Engine for monitoring dashboard</span>
        ctx.waitUntil(
          env.NAELAO_ANALYTICS_QUEUE.send({
            type: 'sweeper_task_failed',
            task: taskNames[i],
            error: String(result.reason),
            timestamp: Date.now()
          })
        );
      }
    });

    console.log('[NAELAO SWEEPER] Sweep complete');
  }
};

<span class="cm">// Task 1: Send heartbeat to all active Space Assistants
// "Active" = created in last 7 days OR had channel activity in last 30 days</span>
async function sweepAssistantHeartbeats(env: Env): Promise<void> {  // SpaceDO replaces db parameter
  const activeAssistants = await db.query(`
    SELECT DISTINCT sm.user_id, sm.space_id
    FROM space_members sm
    JOIN spaces s ON s.id = sm.space_id
    WHERE s.status = 'active'
      AND (
        sm.joined_at > NOW() - INTERVAL '7 days'
        OR EXISTS (
          SELECT 1 FROM threads t
          WHERE t.space_id = sm.space_id
            AND t.user_id = sm.user_id
            AND t.created_at > NOW() - INTERVAL '30 days'
        )
      )
    LIMIT 1000
  `);

  if (!activeAssistants.rows.length) return;

  <span class="cm">// Fan out — all assistants get their heartbeat in parallel
  // Promise.allSettled: one failure does not block others</span>
  await Promise.allSettled(
    activeAssistants.rows.map(async ({ user_id, space_id }) => {
      const doId = env.NAELAO_ASSISTANT_DO.idFromName(
        `assistant:${space_id}:${user_id}`
      );
      const assistantDO = env.NAELAO_ASSISTANT_DO.get(doId);

      try {
        const resp = await assistantDO.fetch(
          new Request('http://assistant/heartbeat', {
            method: 'POST',
            body: JSON.stringify({ spaceId: space_id, userId: user_id, timestamp: Date.now() })
          })
        );
        if (!resp.ok) {
          console.warn(`[SWEEPER] Heartbeat failed for ${space_id}:${user_id}: ${resp.status}`);
        }
      } catch (e) {
        <span class="cm">// Log but don't throw — next assistant must still get its heartbeat</span>
        console.error(`[SWEEPER] Heartbeat exception for ${space_id}:${user_id}:`, e);
      }
    })
  );

  console.log(`[SWEEPER] Sent heartbeats to ${activeAssistants.rows.length} assistants`);
}

<span class="cm">// Task 2: Find agent runs that have been 'running' for too long with no heartbeat
// These are abandoned runs from DO evictions that were not resumed</span>
async function sweepAbandonedAgentRuns(env: Env): Promise<void> {  // SpaceDO replaces db parameter
  <span class="cm">// Query for runs marked 'running' but with no heartbeat update in 10 minutes</span>
  const abandonedRuns = await db.query(`
    SELECT id, space_id, thread_id, project_id, user_id
    FROM agent_runs
    WHERE status = 'running'
      AND updated_at < NOW() - INTERVAL '10 minutes'
    LIMIT 100
  `);

  if (!abandonedRuns.rows.length) return;

  await Promise.allSettled(
    abandonedRuns.rows.map(async (run) => {
      const { id, space_id, thread_id, project_id, user_id } = run;

      <span class="cm">// Check if the AgentDO actually has an active fiber for this run
      // If it does, the run is still alive (DO just hasn't updated SpaceDO SQLite yet)</span>
      const doId = env.NAELAO_AGENT_DO.idFromName(
        `${space_id}:${project_id}:${thread_id}`
      );
      const agentDO = env.NAELAO_AGENT_DO.get(doId);

      const statusResp = await agentDO.fetch(
        new Request(`http://agent/fiber-status?runId=${id}`)
      ).catch(() => null);

      if (statusResp?.ok) {
        const { hasActiveFiber } = await statusResp.json() as { hasActiveFiber: boolean };
        if (hasActiveFiber) return; <span class="cm">// run is actually still alive</span>
      }

      <span class="cm">// Run is truly abandoned — mark as failed and notify user</span>
      await db.query(
        `UPDATE agent_runs SET status = 'failed', error_message = $1, updated_at = NOW()
         WHERE id = $2`,
        ['Run abandoned: lost connection to agent process', id]
      );

      await env.NAELAO_NOTIFICATIONS_QUEUE.send({
        type: 'run_failed',
        spaceId: space_id,
        userId: user_id,
        threadId: thread_id,
        runId: id,
        reason: 'abandoned'
      });

      <span class="cm">// Release concurrency slot</span>
      const concurrencyDO = env.NAELAO_CONCURRENCY_DO.get(
        env.NAELAO_CONCURRENCY_DO.idFromName(`concurrency:${space_id}:${user_id}`)
      );
      await concurrencyDO.fetch(new Request('http://concurrency/release', {
        method: 'POST',
        body: JSON.stringify({ runId: id })
      })).catch(() => {/* non-fatal */});
    })
  );

  console.log(`[SWEEPER] Processed ${abandonedRuns.rows.length} abandoned runs`);
}

<span class="cm">// Task 3: Release file locks that have exceeded their TTL
// Handles the case where an agent crashed mid-write and never released its lock</span>
async function sweepExpiredFileLocks(env: Env): Promise<void> {  // SpaceDO replaces db parameter
  <span class="cm">// Get all projects with potentially stale locks
  // (we don't know which ProjectDO has stale locks — they self-manage via DO Alarm)
  // The sweeper just triggers a cleanup check on recently active projects</span>
  const activeProjects = await db.query(`
    SELECT DISTINCT project_id, space_id
    FROM agent_runs
    WHERE status = 'failed'
      AND updated_at > NOW() - INTERVAL '15 minutes'
    LIMIT 50
  `);

  await Promise.allSettled(
    activeProjects.rows.map(async ({ project_id, space_id }) => {
      const projectDO = env.NAELAO_PROJECT_DO.get(
        env.NAELAO_PROJECT_DO.idFromName(`project:${space_id}:${project_id}`)
      );
      await projectDO.fetch(
        new Request('http://project/sweep-expired-locks', { method: 'POST' })
      ).catch(() => {/* non-fatal */});
    })
  );
}

<span class="cm">// Task 4: Re-queue messages from the dead letter queue
// Messages that failed 3 times land in naelao-dlq. Sweeper retries them after 1 hour.</span>
async function sweepDeadLetterQueue(env: Env): Promise<void> {
  <span class="cm">// CF Queues REST API to peek at the DLQ
  // Note: CF doesn't provide a native "re-queue from DLQ" API yet
  // We use the CF REST API to read and re-enqueue manually</span>
  try {
    const dlqMessages = await fetch(
      `https://api.cloudflare.com/client/v4/accounts/${env.NAELAO_ACCOUNT_ID}/queues/naelao-dlq/messages`,
      { headers: { Authorization: `Bearer ${env.CF_API_TOKEN}` } }
    ).then(r => r.json()) as { result: { body: string; id: string }[] };

    if (!dlqMessages.result?.length) return;

    <span class="cm">// Re-queue messages that are older than 1 hour
    // (give time for transient issues to resolve before retry)</span>
    for (const msg of dlqMessages.result.slice(0, 10)) {
      const body = JSON.parse(msg.body);
      await env.NAELAO_AGENT_QUEUE.send(body);
      console.log(`[SWEEPER] Re-queued DLQ message: ${msg.id}`);
    }
  } catch (e) {
    console.error('[SWEEPER] DLQ sweep failed:', e);
  }
}

<span class="cm">// Task 5: Check fine-tune jobs that have been pending for too long</span>
async function sweepStaleFineTuneJobs(env: Env): Promise<void> {  // SpaceDO replaces db parameter
  const staleJobs = await db.query(`
    SELECT id, space_id, job_id
    FROM fine_tune_jobs
    WHERE status = 'running'
      AND created_at < NOW() - INTERVAL '48 hours'
    LIMIT 20
  `);

  for (const { id, space_id, job_id } of staleJobs.rows) {
    const jobDO = env.NAELAO_FINETUNE_JOB.get(
      env.NAELAO_FINETUNE_JOB.idFromName(`ftjob:${space_id}:${job_id}`)
    );
    <span class="cm">// Ask the FinetuneJobDO to poll Together AI for current status</span>
    await jobDO.fetch(new Request('http://job/poll', { method: 'POST' }))
      .catch(() => {/* non-fatal */});
  }
}</code></pre>
