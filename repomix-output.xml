  <div class="sec" id="workflows">
    <span class="sec-ey">17 — Dynamic Workflows</span>
    <h2>Dynamic Workflows + runFiber() — Durable Execution</h2>
    <div class="bar"></div>
    <p class="lead">Naelao has two durable execution mechanisms that serve different purposes.
      <strong>runFiber()</strong> (Project Think SDK) is for keeping an agent session alive across browser disconnects —
      it lives inside the AgentDO. <strong>Dynamic Workflows</strong> (Cloudflare blog post, May 2026) is for
      multi-day/week automation that the agent authors and deploys — it lives in R2 and is dispatched by the
      naelao-workflows Worker Loader. Understanding the difference between these two is critical before implementing
      either.</p>

    <div class="g2">
      <div class="box box-tl">
        <div class="box-lbl">runFiber() — Agent Session Durability</div>
        <p><strong>Lives in:</strong> NaelaoAgentDO (Durable Object SQLite)</p>
        <p><strong>Duration:</strong> Minutes to hours. Tied to one agent session.</p>
        <p><strong>Who writes the code:</strong> Platform engineers (in agent-do.ts)</p>
        <p><strong>Triggered by:</strong> User enabling Background Mode for an agent run</p>
        <p><strong>Survives:</strong> Browser close, network drop, DO eviction, infrastructure restart</p>
        <p><strong>Cost while idle:</strong> $0 (DO hibernates between fiber steps)</p>
        <p><strong>Implementation:</strong> <span class="ic">this.runFiber('name', async (ctx) => {...})</span></p>
      </div>
      <div class="box box-pu">
        <div class="box-lbl">Dynamic Workflows — Agent-Authored Automation</div>
        <p><strong>Lives in:</strong> R2 (TypeScript source), dispatched by naelao-workflows Worker</p>
        <p><strong>Duration:</strong> Days, weeks, months. Runs independently of any user session.</p>
        <p><strong>Who writes the code:</strong> The AI agent at runtime (via workflow-creator skill)</p>
        <p><strong>Triggered by:</strong> Cron schedule, webhook, explicit agent call</p>
        <p><strong>Survives:</strong> Everything — infrastructure outages, months of dormancy</p>
        <p><strong>Cost while idle:</strong> $0 (Dynamic Worker sleeps between steps)</p>
        <p><strong>Implementation:</strong> Agent writes TypeScript to R2, naelao-workflows dispatches it</p>
      </div>
    </div>

    <h3>naelao-workflows Worker Loader — Complete Implementation</h3>
    <pre><code><span class="cm">// workers/workflows/index.ts
// This is the Dynamic Workflows Worker Loader.
// ONE wrangler.jsonc binding covers every workflow from every agent in every Space.
// The key insight: workflow code lives in R2, loaded at step execution time.
// New workflows become runnable the moment they're written to R2 — no deploy needed.

import {
  createDynamicWorkflowEntrypoint,
  DynamicWorkflowBinding,
  wrapWorkflowBinding,
} from '@cloudflare/dynamic-workflows';</span>

export { DynamicWorkflowBinding };

<span class="cm">// Cache for loaded workflow code (per Worker instance, not global)
// This prevents fetching from R2 on every step when the same workflow runs repeatedly</span>
const workflowCache = new Map&lt;string, { code: string; loadedAt: number }&gt;();
const CACHE_TTL_MS = 5 * 60 * 1000; <span class="cm">// 5 minutes</span>

async function loadWorkflowCode(
  workflowPath: string,
  env: Env
): Promise&lt;string&gt; {
  <span class="cm">// Check cache first</span>
  const cached = workflowCache.get(workflowPath);
  if (cached && Date.now() - cached.loadedAt &lt; CACHE_TTL_MS) {
    return cached.code;
  }

  <span class="cm">// Load from R2</span>
  const obj = await env.NAELAO_WORKSPACE.get(workflowPath);
  if (!obj) {
    throw new Error(`Workflow not found in R2: ${workflowPath}`);
  }

  const code = await obj.text();
  workflowCache.set(workflowPath, { code, loadedAt: Date.now() });
  return code;
}

<span class="cm">// THE single class that handles every workflow step for every tenant.
// CF creates one instance per step per workflow. 
// The loadRunner callback fires on EVERY step — this is where tenant isolation is enforced.</span>
export const DynamicWorkflow = createDynamicWorkflowEntrypoint&lt;Env&gt;(
  async ({ env, metadata }) =&gt; {
    const { spaceId, workflowPath, entrypoint } = metadata as WorkflowMetadata;

    <span class="cm">// SECURITY: Validate spaceId on every step dispatch — not just at workflow creation.
    // An attacker who can create a workflow in Space A cannot run it in Space B's context.
    // This check prevents cross-tenant workflow code execution.</span>
    if (!spaceId || !/^[0-9a-f-]{36}$/.test(spaceId)) {
      throw new Error(`Invalid spaceId in workflow metadata: ${spaceId}`);
    }

    <span class="cm">// Verify the workflowPath belongs to this space
    // (prevents a workflow from loading another space's code)</span>
    if (!workflowPath.startsWith(`spaces/${spaceId}/`)) {
      throw new Error(`Workflow path '${workflowPath}' does not belong to space '${spaceId}'`);
    }

    <span class="cm">// Load the workflow TypeScript from R2</span>
    const code = await loadWorkflowCode(workflowPath, env);

    <span class="cm">// Create a Dynamic Worker with the loaded code.
    // Bindings passed to the workflow code — it can use R2 and AI Gateway but NOT arbitrary CF APIs</span>
    const loader = env.NAELAO_DW_LOADER.get(
      env.NAELAO_DW_LOADER.idFromName(`workflow-loader:${spaceId}`)
    );

    const stub = await loader.fetch(new Request('http://loader/load', {
      method: 'POST',
      body: JSON.stringify({
        name: `workflow-${spaceId}-${workflowPath.split('/').pop()}`,
        code,
        bindings: {
          <span class="cm">// Inject platform services the workflow can use</span>
          WORKFLOWS: wrapWorkflowBinding({ workflowPath }),
          SPACE_ID: spaceId,
          R2_PREFIX: `spaces/${spaceId}/`,
          <span class="cm">// Note: we do NOT inject full env — only what the workflow needs</span>
        }
      })
    }));

    return stub.getEntrypoint(entrypoint ?? 'AgentWorkflow');
  }
);

<span class="cm">// HTTP handler for creating workflow instances</span>
export default {
  async fetch(request: Request, env: Env): Promise&lt;Response&gt; {
    const url = new URL(request.url);

    if (url.pathname === '/create' && request.method === 'POST') {
      const { spaceId, workflowPath, entrypoint, input, schedule } = await request.json();

      <span class="cm">// Validate space access</span>
      const authResp = await env.NAELAO_AUTH.fetch(new Request('http://auth/validate-space', {
        method: 'POST',
        body: JSON.stringify({ spaceId }),
        headers: { Authorization: request.headers.get('Authorization') ?? '' }
      }));
      if (!authResp.ok) return new Response('Forbidden', { status: 403 });

      <span class="cm">// Verify workflow TypeScript exists in R2 before creating instance</span>
      const workflowObj = await env.NAELAO_WORKSPACE.get(workflowPath);
      if (!workflowObj) {
        return Response.json({ error: `Workflow not found: ${workflowPath}` }, { status: 404 });
      }

      <span class="cm">// Create workflow instance</span>
      const workflowId = `naelao-wf-${spaceId.slice(0, 8)}-${Date.now()}`;
      const instance = await env.NAELAO_WORKFLOW.create({
        id: workflowId,
        params: {
          spaceId,
          workflowPath,
          entrypoint: entrypoint ?? 'AgentWorkflow',
          input,
          schedule
        }
      });

      <span class="cm">// Register in WorkflowRegistryDO for management/monitoring</span>
      const registryDO = env.NAELAO_WORKFLOW_REGISTRY_DO.get(
        env.NAELAO_WORKFLOW_REGISTRY_DO.idFromName(`wfreg:${spaceId}:global`)
      );
      await registryDO.fetch(new Request('http://registry/register', {
        method: 'POST',
        body: JSON.stringify({
          workflowId: await instance.id(),
          spaceId, workflowPath, schedule, createdAt: Date.now()
        })
      }));

      return Response.json({ workflowId: await instance.id(), status: 'created' });
    }

    return new Response('Not Found', { status: 404 });
  }
};</code></pre>

    <h3>wrangler.jsonc — Dynamic Workflow Binding</h3>
    <pre><code><span class="cm">// wrangler.jsonc — The entire Dynamic Workflow system uses ONE binding.
// This single binding covers every workflow from every agent in every Space.
// Never add more workflow bindings — one is all you need forever.</span>
{
  "workflows": [
    {
      "name": "naelao-dynamic-workflow",
      "binding": "NAELAO_WORKFLOW",
      "class_name": "DynamicWorkflow"
    }
  ]
}

<span class="cm">// That's it. One line. Handles all of this:
// - Daily PR summary for Space A's GitHub Manager skill
// - Weekly sales report for Space B's Launchpad
// - Fine-tuning poll loop for Space C's Vertical
// - Bootstrap Mode annotation batch processor for Space D
// All dispatched by the same DynamicWorkflow class, isolated by spaceId.</span></code></pre>

    <h3>Example Agent-Authored Workflow</h3>
    <p>This is what an agent generates when it uses the workflow-creator skill. The agent writes this TypeScript and the
      naelao-workflows Worker Loader runs it durably.</p>
    <pre><code><span class="cm">// Generated by agent. Stored in R2: spaces/{spaceId}/workflows/weekly-report.ts
// Agent wrote this in response to: "Create a workflow that sends me a weekly progress report every Friday at 5pm"</span>

import { WorkflowEntrypoint } from 'cloudflare:workers';

export class WeeklyReportWorkflow extends WorkflowEntrypoint {
  async run(event: WorkflowEvent, step: WorkflowStep): Promise&lt;void&gt; {
    const { spaceId } = event.payload;

    <span class="cm">// Step 1: Gather data (independently retried if it fails)</span>
    const projectData = await step.do('gather-projects', async () =&gt; {
      <span class="cm">// env.R2_PREFIX is injected by the Worker Loader — scoped to this Space</span>
      const files = await this.env.NAELAO_WORKSPACE.list({
        prefix: `spaces/${spaceId}/workspace/`
      });
      return {
        fileCount: files.objects.length,
        totalSize: files.objects.reduce((acc, f) =&gt; acc + (f.size ?? 0), 0)
      };
    });

    <span class="cm">// Step 2: Generate report with LLM</span>
    const report = await step.do('generate-report', async () =&gt; {
      const resp = await fetch(`https://app.naelao.dev/api/ai/complete`, {
        method: 'POST',
        headers: { 'X-Space-Id': spaceId, 'X-Internal-Token': this.env.NAELAO_INTERNAL_TOKEN },
        body: JSON.stringify({
          prompt: `Generate a brief weekly progress report. Data: ${JSON.stringify(projectData)}`
        })
      });
      const { text } = await resp.json();
      return text;
    });

    <span class="cm">// Step 3: Send to configured channels</span>
    await step.do('send-report', async () =&gt; {
      await fetch(`https://app.naelao.dev/api/spaces/${spaceId}/assistant/notify`, {
        method: 'POST',
        headers: { 'X-Internal-Token': this.env.NAELAO_INTERNAL_TOKEN },
        body: JSON.stringify({ message: report, channels: ['slack', 'email'] })
      });
    });

    <span class="cm">// Workflow complete — will re-trigger next Friday at 5pm via cron schedule</span>
    <span class="cm">// No explicit scheduling needed — naelao-workflows handles the cron trigger</span>
  }
}</code></pre>
