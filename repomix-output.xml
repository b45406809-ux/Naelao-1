  <!-- ══════════════════════════════════════════════════════
     §59 — MIGRATION FROM SUNA KORTIX: STEP BY STEP
═══════════════════════════════════════════════════════ -->
  <div class="sep"></div>
  <div class="sec" id="migration-guide">
    <span class="sec-ey">59 — Migration Guide</span>
    <h2>Migrating From Suna Kortix to Naelao — Complete Guide</h2>
    <div class="bar"></div>
    <p class="lead">If you are running a self-hosted Suna kortix instance and want to migrate your existing data and
      users to Naelao, this section documents the complete migration process. Data migration from PostgreSQL (Suna) to
      SpaceDO SQLite (Naelao) requires careful handling of space_id assignment — always pass spaceId to every DO method.</p>

    <h3>Phase 1 — Schema Migration</h3>
    <pre><code><span class="cm">-- migration/001_add_space_to_existing_data.sql
-- Run this BEFORE any application migration code
-- Creates a default space for all existing Suna kortix data</span>

BEGIN;

<span class="cm">-- Create a migration space for existing data</span>
INSERT INTO spaces (id, name, slug, type, admin_user_id, settings)
SELECT
  gen_random_uuid(),
  'Migrated Workspace',
  'migrated-workspace',
  'team',
  (SELECT id FROM auth.users ORDER BY created_at ASC LIMIT 1),  <span class="cm">-- first user becomes admin</span>
  '{"migrated": true, "migrationDate": "2026-05-01"}'::JSONB
RETURNING id AS migration_space_id;

<span class="cm">-- Store the migration space ID for use in subsequent queries</span>
DO $$
DECLARE
  v_migration_space_id UUID;
BEGIN
  SELECT id INTO v_migration_space_id FROM spaces WHERE slug = 'migrated-workspace';

  <span class="cm">-- Add all existing users as members of migration space</span>
  INSERT INTO space_members (space_id, user_id, role)
  SELECT v_migration_space_id, id, 'editor'
  FROM auth.users
  ON CONFLICT DO NOTHING;

  <span class="cm">-- Assign all existing threads to migration space</span>
  UPDATE threads SET space_id = v_migration_space_id WHERE space_id IS NULL;

  <span class="cm">-- Assign all existing projects to migration space</span>
  UPDATE projects SET space_id = v_migration_space_id WHERE space_id IS NULL;

  <span class="cm">-- Assign all existing agent_runs to migration space</span>
  UPDATE agent_runs SET space_id = v_migration_space_id WHERE space_id IS NULL;

  <span class="cm">-- Create credit record for migration space</span>
  INSERT INTO space_credits (space_id, balance_usd, billing_tier)
  VALUES (v_migration_space_id, 50.00, 'pro');  <span class="cm">-- generous starting credits for migrated users</span>
END $$;

COMMIT;

<span class="cm">-- Verify: no records without space_id</span>
SELECT
  'threads' as table_name, COUNT(*) as null_space_count
  FROM threads WHERE space_id IS NULL
UNION ALL SELECT
  'projects', COUNT(*) FROM projects WHERE space_id IS NULL
UNION ALL SELECT
  'agent_runs', COUNT(*) FROM agent_runs WHERE space_id IS NULL;
<span class="cm">-- All should return 0</span></code></pre>

    <h3>Phase 2 — File Migration (Docker FS → R2)</h3>
    <pre><code><span class="cm">#!/bin/bash
# migration/migrate-files.sh
# Migrates agent workspace files from Daytona/Docker to R2
# Requires: AWS CLI configured to talk to R2 (use S3-compatible endpoint)</span>

MIGRATION_SPACE_ID="your-migration-space-id-here"
R2_BUCKET="naelao-workspace"
R2_ENDPOINT="https://{ACCOUNT_ID}.r2.cloudflarestorage.com"

<span class="cm"># For each project, copy workspace files to R2 under the correct prefix</span>
while IFS=, read -r project_id local_path; do
  echo "Migrating project: $project_id"

  <span class="cm"># Convert local Docker path to R2 prefix</span>
  R2_PREFIX="spaces/${MIGRATION_SPACE_ID}/projects/${project_id}/workspace"

  <span class="cm"># Upload all files maintaining directory structure</span>
  aws s3 sync     "$local_path"     "s3://${R2_BUCKET}/${R2_PREFIX}"     --endpoint-url "${R2_ENDPOINT}"     --exclude "*.pyc"     --exclude "__pycache__/*"     --exclude ".git/*"     --delete

  echo "✓ Migrated $project_id: $(aws s3 ls s3://${R2_BUCKET}/${R2_PREFIX}/ --endpoint-url ${R2_ENDPOINT} --recursive | wc -l) files"

done &lt; migration/project-mappings.csv
<span class="cm"># project-mappings.csv format:
# project-uuid-1,/var/suna/projects/project-uuid-1/workspace
# project-uuid-2,/var/suna/projects/project-uuid-2/workspace</span></code></pre>

    <h3>Phase 3 — Worker/Service Cutover</h3>
    <pre><code><span class="cm">// migration/cutover-checklist.ts
// Run this script to verify everything is ready before switching DNS to Naelao

async function runCutoverChecks(): Promise&lt;void&gt; {
  const checks = [
    {
      name: 'Schema migration complete',
      check: async () =&gt; {
        const result = await db.query(
          "SELECT COUNT(*) FROM threads WHERE space_id IS NULL"
        );
        return parseInt(result.rows[0].count) === 0;
      }
    },
    {
      name: 'R2 file migration complete',
      check: async () =&gt; {
        const listing = await env.NAELAO_WORKSPACE.list({ prefix: 'spaces/' });
        return listing.objects.length > 0;
      }
    },
    {
      name: 'All 22 Workers deployed',
      check: async () =&gt; {
        const REQUIRED_WORKERS = [
          'naelao-router', 'naelao-auth', 'naelao-agents',
          <span class="cm">// ... all 22</span>
        ];
        <span class="cm">// Check via CF API that each Worker is deployed</span>
        return true; <span class="cm">// implement via wrangler list command</span>
      }
    },
    {
      name: 'Platform skills signed and in R2',
      check: async () =&gt; {
        const signaturesObj = await env.NAELAO_ASSETS.get('platform/skill-signatures.json');
        if (!signaturesObj) return false;
        const sigs = JSON.parse(await signaturesObj.text());
        return Object.keys(sigs).length === 13;
      }
    },
    {
      name: 'SpaceDO per-product isolation verified',
      check: async () =&gt; {
        const result = await db.query(
          "SELECT COUNT(*) FROM pg_tables WHERE schemaname='public' AND rowsecurity=false"
        );
        return parseInt(result.rows[0].count) === 0;
      }
    },
  ];

  for (const { name, check } of checks) {
    const passed = await check().catch(() =&gt; false);
    console.log(`${passed ? '✓' : '✗'} ${name}`);
    if (!passed) process.exit(1);
  }
  console.log('
✓ All cutover checks passed. Safe to redirect DNS to Naelao.');
}</span></code></pre>
  </div>

