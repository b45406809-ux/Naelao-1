<script>
// ── STATE ──
let sidebarOpen=true,switcherOpen=false,currentTheme='light',pendingTheme='light',currentBg='landscape-4',bgEnabled=false,pendingBg='landscape-4',pendingBgEnabled=false,bookmarked=false,moreNavOpen=false,threadPanelOpen=false;

// ── SHOW PAGE ──
const pages=['home','chat','agents','assistant','knowledge','marketplace','workflows','analytics','explore','settings','spaces','projects'];
function showPage(page){
  closeMobileSidebar(); // navigating always closes the mobile drawer
  // Hide all views
  ['home-view','chat-view','agents-view','assistant-view','knowledge-view','marketplace-view','workflows-view','analytics-view','explore-view','settings-view','spaces-view','projects-view'].forEach(id=>{
    const el=document.getElementById(id);
    if(el){el.style.display='none';}
  });
  document.getElementById('home-topbar').style.display='none';
  document.getElementById('topbar').style.display='none';

  if(page==='home'){
    document.getElementById('home-view').style.display='flex';
    document.getElementById('home-topbar').style.display='flex';
  } else if(page==='chat'){
    document.getElementById('chat-view').style.display='flex';
    document.getElementById('topbar').style.display='flex';
  } else {
    const target=document.getElementById(page+'-view');
    if(target)target.style.display='flex';
  }

  // update active nav
  pages.forEach(p=>document.getElementById('nav-'+p)?.classList.remove('active'));
  const navEl=document.getElementById('nav-'+page);
  if(navEl)navEl.classList.add('active');
  // keep "more" active for nested items
  const moreItems=['agents','knowledge','marketplace','workflows','analytics','explore','settings'];
  if(moreItems.includes(page)){
    document.getElementById('nav-more').classList.add('active');
  }
  // rebuild chart if navigating to analytics
  if(page==='analytics')setTimeout(buildChart,50);
}

function startNewChat(){openChat('new')}
function openChat(id){
  showPage('chat');
  const titles={assist:'Assistance request',poem:'Poem of the past',analytic:'Analytica Ideas',new:'New thread'};
  document.getElementById('chat-title-text').textContent=titles[id]||id;
  // Open thread panel on new chat
  const tp=document.getElementById('thread-panel');
  tp.classList.remove('hidden');
  threadPanelOpen=true;
  if(id==='new'){document.getElementById('messages').innerHTML='';setTimeout(()=>document.getElementById('chat-input').focus(),100);return;}
  loadSampleMessages(id);
}

function loadSampleMessages(id){
  const messages=document.getElementById('messages');
  messages.innerHTML='';
  const samples={
    assist:[{u:true,t:'Can you help me plan my day?'},{u:false,t:'Of course! I can help you organize your schedule. What are your main priorities for today?'}],
    poem:[{u:true,t:'Write a poem about the past'},{u:false,t:'<em>The days we lived have left their trace,<br>In shadows cast by memory\'s grace.<br>Each moment gone, yet somehow near,<br>In echoes only hearts can hear.</em>'},{u:true,t:'That\'s beautiful. Can you write another verse?'}],
    analytic:[{u:true,t:'Analyze these analytics ideas'},{u:false,t:'I\'d be happy to analyze your analytics ideas. Could you share the specific concepts or data you\'d like me to examine?'}]
  };
  const msgs=samples[id]||[];
  msgs.forEach(m=>{
    const row=document.createElement('div');
    row.className='msg-row'+(m.u?' user':'');
    if(m.u){row.innerHTML=`<div class="bubble user">${m.t}</div>`;}
    else{row.innerHTML=`<div class="ai-icon"><svg viewBox="0 0 16 16" fill="var(--bg)"><path d="M8 1L14 4.5V11.5L8 15L2 11.5V4.5L8 1Z"/></svg></div><div style="flex:1"><div class="bubble">${m.t}</div><div class="msg-actions"><button class="msg-action" onclick="showToast('Copied')"><svg viewBox="0 0 16 16" fill="none" stroke-width="1.5" stroke="currentColor"><rect x="5" y="5" width="8" height="8" rx="1"/><path d="M11 5V3H3V11H5"/></svg><span class="tooltip">Copy</span></button></div></div>`;}
    messages.appendChild(row);
  });
  scrollToBottom();
}

