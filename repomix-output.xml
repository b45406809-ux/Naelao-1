    <!-- ══════════════════════════════════════════════════════
     §75 — REMOTELOOP (INTERNAL REFERENCE)
═══════════════════════════════════════════════════════ -->
    <div class="sep"></div>
    <div class="sec" id="remoteloop">
      <span class="sec-ey">75 — Space Types Architecture</span>
      <h2>RemoteLoop — Platform-Internal Agent Execution</h2>
      <div class="bar"></div>
      <p class="lead"><code>RemoteLoop</code> is a <strong>Naelao-internal</strong> interface that allows certain
        Naelao-authored Space Types to delegate agent reasoning to a dedicated internal Worker while keeping tool
        execution and security enforcement inside the platform. It is the mechanism that makes Space Types like Mini-AGI
        and Legal Verticals possible — they need reasoning patterns the standard chat loop cannot express. It is not
        exposed to community developers. For the complete API specification, see <a href="#remoteloop-appendix">Appendix
          A8 — RemoteLoop</a>.</p>

      <div class="box box-am">
        <div class="box-lbl">Why RemoteLoop Is Not a Community Primitive</div>
        <p>A RemoteLoop Worker receives the full conversation history, user intent, and a live Scoped Token on every
          agent turn. Exposing this surface to arbitrary third-party code creates an unacceptable data exfiltration
          vector. Community developers who need custom reasoning should instead publish a <strong>Naelao App</strong>
          with a custom MCP server — the tool call boundary provides the necessary isolation. See <a
            href="#community-model">Community Contribution Model</a>.</p>
      </div>

      <h3>When Standard Loops Are Not Enough</h3>
      <p>The three built-in loop models cover the majority of Space Types:</p>
      <ul class="fl">
        <li><strong>chat</strong> — Single-turn or multi-turn conversational. The agent responds, waits. Standard Space,
          Developer Space.</li>
        <li><strong>content</strong> — Long-form generation with structured output. Sites, Documentation Verticals.</li>
        <li><strong>task</strong> — Autonomous tool-calling until a goal condition is met. Launchpad, Workers.</li>
      </ul>
      <p>Some Space Types require patterns none of these can express. Mini-AGI runs a <strong>recursive planner</strong>
        that spawns sub-agents and waits on futures. Legal Verticals runs a <strong>Tree-of-Thought</strong> search
        across case law before committing to any response. These are not loop variants — they are different
        computational models. RemoteLoop provides a clean delegation boundary so these Workers can be developed, tested,
        and deployed independently of the core platform.</p>

      <h3>The Three Invariants</h3>
      <p>Every RemoteLoop implementation, regardless of complexity, must honour three invariants enforced by
        <code>AgentDO</code> before and after delegation:</p>

      <table class="t">
        <thead>
          <tr>
            <th>Invariant</th>
            <th>Enforced By</th>
            <th>Detail</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="tl"><strong>Token Scope</strong></td>
            <td class="tk">AgentDO pre-flight</td>
            <td>The Scoped Token issued to the RemoteLoop Worker is bound to the exact <code>spaceId</code> and
              <code>agentId</code> of the current turn. It cannot be used to read another space's files, even if the
              Worker attempts it.</td>
          </tr>
          <tr>
            <td class="tl"><strong>Tool Gating</strong></td>
            <td class="tk">naelao-gateway</td>
            <td>Every tool call the Worker makes back to the Scoped API passes through the 27-pattern security scanner
              and the network allowlist for that Space Type. The Worker cannot call tools the Space Type manifest does
              not declare.</td>
          </tr>
          <tr>
            <td class="tl"><strong>Stream Integrity</strong></td>
            <td class="tk">AgentDO post-flight</td>
            <td>The token stream returned by the Worker is validated for encoding and size before being forwarded to the
              WebSocket. A Worker that returns malformed or oversized chunks is disconnected and the turn fails
              gracefully.</td>
          </tr>
        </tbody>
      </table>

      <h3>How AgentDO Chooses a Loop</h3>
      <p>On every agent turn, <code>AgentDO</code> reads the Space Type manifest from the
        <code>SpaceTypeRegistryDO</code> and checks for a <code>customLoopWorker</code> binding:</p>
      <pre><code><span class="cm">// workers/naelao-agent/src/AgentDO.ts (turn dispatch)</span>
async function dispatchTurn(ctx: TurnContext): Promise&lt;ReadableStream&gt; {
  const manifest = await ctx.spaceTypeRegistry.getManifest(ctx.spaceTypeId);

  if (manifest.customLoopWorker) {
    <span class="cm">// Delegate to the internal RemoteLoop Worker</span>
    return dispatchRemoteLoop(ctx, manifest.customLoopWorker);
  }

  <span class="cm">// Fall through to the built-in loop models</span>
  switch (manifest.agentEnvironment.loopModel) {
    case 'chat':    return runChatLoop(ctx);
    case 'content': return runContentLoop(ctx);
    case 'task':    return runTaskLoop(ctx);
    default:        return runChatLoop(ctx);
  }
}

async function dispatchRemoteLoop(
  ctx: TurnContext,
  workerBinding: string
): Promise&lt;ReadableStream&gt; {
  const scopedToken = await ctx.tokenIssuer.issue({
    spaceId: ctx.spaceId,
    agentId: ctx.agentId,
    ttlMs: 120_000,         <span class="cm">// 2-minute turn TTL</span>
    allowedTools: ctx.manifest.agentEnvironment.agentPermissions,
  });

  const loopWorker = ctx.env[workerBinding] as Fetcher;
  const response = await loopWorker.fetch('http://internal/turn', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      spaceId: ctx.spaceId,
      agentId: ctx.agentId,
      messages: ctx.messages,
      availableTools: ctx.toolManifest,
      scopedToken,
    }),
  });

  if (!response.ok || !response.body) {
    throw new AgentError('RemoteLoop worker failed', { status: response.status });
  }

  return response.body;
}</code></pre>

      <h3>Manifest Declaration</h3>
      <p>A Space Type that uses RemoteLoop declares it with a single field in its manifest. The value is the <strong>CF
          Worker binding name</strong> as declared in <code>wrangler.jsonc</code>:</p>
      <pre><code><span class="cm">// platform/manifests/mini-agi.json (excerpt)</span>
{
  "id": "mini-agi",
  "agentEnvironment": {
    "loopModel": "task",                      <span class="cm">// Fallback if customLoopWorker is absent</span>
    "customLoopWorker": "MINI_AGI_LOOP"       <span class="cm">// Worker binding name in wrangler.jsonc</span>
  }
}

<span class="cm">// wrangler.jsonc (naelao-agent Worker)</span>
{
  "services": [
    { "binding": "MINI_AGI_LOOP", "service": "naelao-mini-agi-loop" },
    { "binding": "LEGAL_LOOP",    "service": "naelao-legal-loop" }
  ]
}</code></pre>

      <h3>Failure Handling</h3>
      <p>RemoteLoop Workers run in the same Cloudflare infrastructure as the rest of Naelao, so network failures between
        them are rare but possible. <code>AgentDO</code> applies a fixed retry policy:</p>
      <ul class="fl">
        <li><strong>Timeout:</strong> 30 seconds for the initial response header. If the Worker does not begin streaming
          within 30s, the turn is cancelled and the user receives a graceful error message.</li>
        <li><strong>Stream drop:</strong> If the stream closes unexpectedly mid-turn, <code>AgentDO</code> records the
          partial output and surfaces it with a truncation notice. It does not retry a partial turn — the conversation
          state would be undefined.</li>
        <li><strong>Worker unavailable:</strong> If the binding itself is missing or the target Worker returns 503,
          <code>AgentDO</code> falls back to the manifest's <code>loopModel</code> and logs a
          <code>remoteloop_fallback</code> event to the analytics pipeline.</li>
      </ul>

      <div class="box box-bl">
        <div class="box-lbl">Current Internal RemoteLoop Workers</div>
        <p><strong>naelao-mini-agi-loop</strong> — Implements the recursive planner for Mini-AGI Spaces. Spawns
          sub-agent futures, aggregates results, maintains a working memory store in a KV namespace scoped to the turn.
        </p>
        <p><strong>naelao-legal-loop</strong> — Tree-of-Thought reasoning for Legal Verticals. Runs 3–5 parallel LLM
          branches, scores them against a legal-reasoning rubric, selects the highest-scoring branch, and streams only
          the winner.</p>
        <p><strong>naelao-research-loop</strong> — Iterative web research loop for the Research Verticals type.
          Decomposes a query into sub-questions, retrieves and ranks sources, synthesises a citation-backed answer.</p>
      </div>

      <div class="box box-or">
        <div class="box-lbl">For the Full RemoteLoop API Contract</div>
        <p>See <a href="#remoteloop-appendix">Appendix A8 — Custom Intelligence</a> for the complete
          <code>RemoteLoopRequest</code> / <code>RemoteLoopResponse</code> interfaces, the Scoped API endpoint
          reference, the streaming protocol, and worked examples of each internal loop Worker.</p>
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════
     §76 — SPACE TYPE VERSIONING & UPGRADES
═══════════════════════════════════════════════════════ -->
    <div class="sep"></div>
    <div class="sec" id="space-type-versioning">
      <span class="sec-ey">76 — Upgrades & Migrations</span>
      <h2>Space Type Versioning & Canary Rollouts</h2>
      <div class="bar"></div>
      <p class="lead">When Naelao engineers update a Space Type manifest (e.g., adding a new sidebar widget, changing a
        SpaceDO schema changes, or updating a required DO), existing spaces do not instantly break. Naelao enforces a strict
        SemVer upgrade protocol managed by the <code>SpaceTypeRegistryDO</code>. Because Naelao exclusively authors
        Space Types, the versioning and migration pipeline is fully internal — there is no third-party submission or
        review step.</p>

      <h3>Version Bump Protocol</h3>
      <table class="t">
        <thead>
          <tr>
            <th>Version Change</th>
            <th>Definition</th>
            <th>Upgrade Process</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="tl"><strong>Patch</strong> (1.0.0 → 1.0.1)</td>
            <td>Bug fixes in Worker code or manifest. No schema or UI changes.</td>
            <td>Automatic and instant. Worker routing transparently uses the new code.</td>
          </tr>
          <tr>
            <td class="tl"><strong>Minor</strong> (1.0.0 → 1.1.0)</td>
            <td>Added non-breaking UI slots, new non-destructive cron jobs, or new skills.</td>
            <td><strong>Canary Rollout:</strong> 5% of active spaces receive the update for 24 hours. If no spike in
              <code>error</code> events is detected by the Analytics Engine, rolled out to 100%.</td>
          </tr>
          <tr>
            <td class="tl"><strong>Major</strong> (1.0.0 → 2.0.0)</td>
            <td>SpaceDO schema changes (column additions/removals), required DO class renames, or breaking UI changes.</td>
            <td><strong>Opt-in only.</strong> Space Admins see an "Upgrade Available" banner. Clicking it triggers the
              internal <code>migrationEndpoint</code>.</td>
          </tr>
        </tbody>
      </table>

      <h3>SpaceTypeRegistryDO — Canary Rollout Engine</h3>
      <pre><code><span class="cm">// durable-objects/space-type-registry-do.ts
// Handles the canary rollout state machine for Minor version bumps.</span>

async function processCanaryRollouts(env: Env) {
  <span class="cm">// 1. Find minor versions currently in canary state</span>
  const canaries = this.ctx.storage.sql.exec(`
    SELECT type_id, version, canary_pct, published_at 
    FROM versions 
    WHERE stable = 0 AND change_type = 'minor'
  `).toArray();

  for (const canary of canaries) {
    const hoursSincePublish = (Date.now() - canary.published_at) / (1000 * 60 * 60);

    <span class="cm">// 2. Check CF Analytics Engine for errors on instances running this version</span>
    const errorRate = await checkErrorRateForVersion(canary.type_id, canary.version, env);

    if (errorRate > 0.05) {
      <span class="cm">// ERROR SPIKE DETECTED: Automatically rollback canary</span>
      this.ctx.storage.sql.exec(`
        UPDATE versions SET stable = -1 WHERE type_id = ? AND version = ?
      `, canary.type_id, canary.version);
      
      <span class="cm">// Downgrade the canary instances back to the last stable version</span>
      await rollbackInstances(canary.type_id, canary.version);
      
      <span class="cm">// Alert the developer</span>
      await env.NAELAO_NOTIFICATIONS_QUEUE.send({
        type: 'canary_failed',
        target: canary.type_id,
        reason: 'Error rate exceeded 5% threshold.'
      });
      continue;
    }

    <span class="cm">// 3. Progress the Canary if healthy</span>
    if (hoursSincePublish > 24 && canary.canary_pct === 5) {
      <span class="cm">// Bump to 20%</span>
      this.ctx.storage.sql.exec(`UPDATE versions SET canary_pct = 20 WHERE type_id = ? AND version = ?`, canary.type_id, canary.version);
    } else if (hoursSincePublish > 48) {
      <span class="cm">// 100% rollout - mark as stable</span>
      this.ctx.storage.sql.exec(`UPDATE versions SET stable = 1, canary_pct = 100 WHERE type_id = ? AND version = ?`, canary.type_id, canary.version);
      this.ctx.storage.sql.exec(`UPDATE space_types SET current_version = ? WHERE id = ?`, canary.version, canary.type_id);
    }
  }
}</code></pre>

      <h3>Major Version Migrations</h3>
      <p>For breaking changes (Major bumps), the manifest must declare a <code>migrationEndpoint</code> pointing to an
        internal Naelao Worker. When the Space Admin opts in, Naelao generates a Scoped Token and calls this endpoint.
        The internal migration Worker handles the data transformation atomically.</p>
      <pre><code><span class="cm">// Inside the Naelao internal migration Worker
// e.g., workers/space-type-migrations/legal-verticals.ts</span>
app.post('/migrate', async (req) =&gt; {
  const spaceId = req.headers.get('X-Space-Id');
  const token = req.headers.get('Authorization');
  const { fromVersion, toVersion } = await req.json();

  if (fromVersion === '1.0.0' && toVersion === '2.0.0') {
    <span class="cm">// Example: legal-verticals type adds a tax_rate column in v2.
    // Migration runs via the Naelao scoped query API.</span>
    await fetch('https://api.naelao.dev/v1/scoped/query', {
      method: 'POST',
      headers: { 'Authorization': token, 'X-Space-Id': spaceId },
      body: JSON.stringify({
        sql: `ALTER TABLE custom_invoices ADD COLUMN IF NOT EXISTS tax_rate REAL DEFAULT 0.0;`
      })
    });
    
    <span class="cm">// Migrate R2 files to new prefix structure</span>
    await fetch('https://api.naelao.dev/v1/scoped/r2/move', {
      method: 'POST',
      headers: { 'Authorization': token, 'X-Space-Id': spaceId },
      body: JSON.stringify({
        source: 'workspace/old-data/',
        destination: 'workspace/v2-data/'
      })
    });
  }

  return new Response(JSON.stringify({ success: true }));
});</code></pre>
    </div>

    <!-- ══════════════════════════════════════════════════════
     §77 — NAELAO APPS: CLI, PACKAGING & REGISTRY
═══════════════════════════════════════════════════════ -->
    <div class="sep"></div>
    <div class="sec" id="naelao-apps-registry">
      <span class="sec-ey">77 — Naelao Apps Economy</span>
      <h2>Naelao Apps — Packaging, CLI & AppRegistryDO</h2>
      <div class="bar"></div>
      <p class="lead">A Naelao App consists of an MCP Server (the intelligence) and UI Instructions (the interface). To
        make publishing frictionless, Naelao provides a CLI tool (<code>npx naelao app publish</code>). This section
        covers how apps are bundled, validated, and registered in the <code>AppRegistryDO</code>.</p>

      <h3>The App File Structure</h3>
      <p>A developer creating an app maintains a simple repository:</p>
      <pre><code>my-weather-app/
├── naelao-app.json       <span class="cm"># The App Manifest (Tools, Pricing, Permissions)</span>
├── src/
│   └── index.ts          <span class="cm"># The MCP Server Worker</span>
├── ui/
│   └── instructions.md   <span class="cm"># LLM instructions for Dynamic UI generation</span>
└── wrangler.toml         <span class="cm"># Standard CF Worker config</span></code></pre>

      <h3>What `npx naelao app publish` Actually Does</h3>
      <p>When the developer runs the CLI command, it performs a 4-step orchestration to ensure the app is secure, valid,
        and available globally.</p>

      <pre><code><span class="cm">// cli/src/commands/publish.ts (Inside the Naelao npm package)</span>

export async function publishApp(directory: string) {
  console.log("📦 Packaging Naelao App...");

  <span class="cm">// 1. Read and Validate Manifest locally</span>
  const manifestRaw = readFileSync(path.join(directory, 'naelao-app.json'), 'utf8');
  const manifest = AppManifestSchema.parse(JSON.parse(manifestRaw));

  <span class="cm">// 2. Deploy the Worker to Cloudflare</span>
  <span class="cm">// The MCP server runs on the developer's CF account, NOT Naelao's account.</span>
  <span class="cm">// This decentralizes compute costs for the MCP endpoints.</span>
  console.log("🚀 Deploying MCP Worker to Cloudflare...");
  execSync('npx wrangler deploy', { cwd: directory, stdio: 'inherit' });

  <span class="cm">// 3. Verify the MCP server is alive</span>
  console.log("🔍 Verifying MCP endpoints...");
  const mcpCheck = await fetch(`${manifest.mcpServer.workerUrl}/mcp/tools`);
  if (!mcpCheck.ok) throw new Error("MCP Server failed to respond with tools.");

  <span class="cm">// 4. Submit to Naelao App Registry</span>
  <span class="cm">// This calls the platform's naelao-apps-registry Worker</span>
  console.log("📝 Registering with Naelao Marketplace...");
  const uiInstructions = readFileSync(path.join(directory, manifest.ui.instructionsPath), 'utf8');
  
  const response = await fetch('https://api.naelao.dev/v1/registry/apps/publish', {
    method: 'POST',
    headers: { 'Authorization': `Bearer ${process.env.NAELAO_CLI_TOKEN}` },
    body: JSON.stringify({
      manifest,
      uiInstructions
    })
  });

  if (response.ok) {
    console.log("✅ App successfully published to the marketplace!");
  } else {
    console.error("❌ Publish failed:", await response.text());
  }
}</code></pre>

      <h3>AppRegistryDO — The Marketplace Database</h3>
      <p>The <code>naelao-apps-registry</code> Worker routes requests to the <code>AppRegistryDO</code>, which tracks
        app metadata, install counts, ratings, and triggers the UI instructions updates in R2.</p>

      <pre><code><span class="cm">// durable-objects/app-registry-do.ts</span>
export class AppRegistryDO extends DurableObject {
  private async initSchema() {
    this.ctx.storage.sql.exec(`
      CREATE TABLE IF NOT EXISTS apps (
        id              TEXT PRIMARY KEY,
        name            TEXT NOT NULL,
        version         TEXT NOT NULL,
        manifest        TEXT NOT NULL,    <span class="cm">-- JSON: Contains pricing and required permissions</span>
        worker_url      TEXT NOT NULL,    <span class="cm">-- The MCP server endpoint</span>
        status          TEXT DEFAULT 'active',
        install_count   INTEGER DEFAULT 0,
        published_at    INTEGER DEFAULT (unixepoch('now') * 1000)
      );

      <span class="cm">-- Tracks which Spaces have installed which Apps</span>
      CREATE TABLE IF NOT EXISTS installs (
        app_id          TEXT NOT NULL REFERENCES apps(id),
        space_id        TEXT NOT NULL,
        installed_at    INTEGER DEFAULT (unixepoch('now') * 1000),
        PRIMARY KEY (app_id, space_id)
      );
    `);
  }

  async handlePublish(payload: { manifest: AppManifest, uiInstructions: string }): Promise&lt;void&gt; {
    <span class="cm">// 1. Write metadata to SQLite</span>
    this.ctx.storage.sql.exec(`
      INSERT OR REPLACE INTO apps (id, name, version, manifest, worker_url)
      VALUES (?, ?, ?, ?, ?)
    `, payload.manifest.id, payload.manifest.name, payload.manifest.version, 
       JSON.stringify(payload.manifest), payload.manifest.mcpServer.workerUrl);

    <span class="cm">// 2. Write UI Instructions to the Global Assets R2 Bucket</span>
    <span class="cm">// The Dynamic Worker Loader reads from here when generating the UI iframe</span>
    await this.env.NAELAO_ASSETS.put(
      `apps/${payload.manifest.id}/ui/instructions.md`,
      payload.uiInstructions
    );
  }

  <span class="cm">// Called when a Space Admin clicks "Install App"</span>
  async handleInstall(appId: string, spaceId: string): Promise&lt;void&gt; {
    const app = this.ctx.storage.sql.exec('SELECT manifest FROM apps WHERE id = ?', appId).one();
    if (!app) throw new Error('App not found');
    
    const manifest = JSON.parse(app.manifest as string);

    <span class="cm">// Record the installation in the registry DO</span>
    this.ctx.storage.sql.exec(`INSERT INTO installs (app_id, space_id) VALUES (?, ?)`, appId, spaceId);
    this.ctx.storage.sql.exec(`UPDATE apps SET install_count = install_count + 1 WHERE id = ?`, appId);

    <span class="cm">// Register the app in the Space's SpaceDO SQLite so the space knows it's active</span>
    const spaceDO = getProductDO(this.rootSpaceId, this.env);  // SpaceDO replaces Hyperdrive
    await db.query(
      `INSERT INTO space_app_installs (space_id, app_id, worker_url, tool_permissions)
       VALUES ($1, $2, $3, $4)`,
      [spaceId, appId, manifest.mcpServer.workerUrl, JSON.stringify(manifest.permissions)]
    );

    <span class="cm">// Invalidate the MCP Hub cache for this space so agents immediately see the new tools</span>
    await this.env.NAELAO_MCP_HUB.fetch(new Request('http://mcp-hub/tools/invalidate', {
      method: 'POST',
      headers: { 'X-Space-Id': spaceId }
    }));
  }
}</code></pre>
    </div>

    <!-- ══════════════════════════════════════════════════════
     COMMUNITY MODEL — Apps vs Templates
═══════════════════════════════════════════════════════ -->
    <div class="sep"></div>
    <div class="sec" id="community-model">
      <span class="sec-ey">Community Model</span>
      <h2>Community Contribution Model — The Two Primitives</h2>
      <div class="bar"></div>
      <p class="lead">Naelao has a clear and deliberate split: <strong>Naelao exclusively authors Space Types</strong>
        (the operating environments). The community contributes through two well-defined primitives:
        <strong>Apps</strong> and <strong>Space Templates</strong>. This is not a limitation — it is a security and
        quality decision that keeps the platform's infrastructure stable while still enabling a rich ecosystem.</p>

      <div class="box box-or">
        <div class="box-lbl">Why Naelao Owns Space Types</div>
        <p>A Space Type defines the fundamental operating environment of a space: which DOs are provisioned, which
          SpaceDO schema version per product, what the agent loop model is, what the network policy is, what the external portal
          looks like. This is infrastructure — not content. Allowing community-authored Space Types would require
          trusting arbitrary code to run at provisioning time, arbitrary SpaceDO schema extensions against the
          database, and arbitrary RemoteLoop Workers receiving all user conversation data. The security surface is too
          large. The community instead extends Naelao through safer, well-isolated primitives.</p>
      </div>

      <h3>The Three-Layer Ecosystem</h3>
      <table class="t">
        <thead>
          <tr>
            <th>Layer</th>
            <th>Who Creates</th>
            <th>What It Is</th>
            <th>Complexity</th>
            <th>Revenue Model</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="tl"><strong>Space Types</strong></td>
            <td class="tk">Naelao only</td>
            <td>Operating environment: DOs, agent loop, network policy, UI shell, external portal</td>
            <td class="warn">Full platform infrastructure</td>
            <td>User subscriptions</td>
          </tr>
          <tr>
            <td class="tl"><strong>Apps</strong></td>
            <td class="tk">Community + Naelao</td>
            <td>MCP Server + UI Instructions. Installs into any Space. Runs on developer's CF account.</td>
            <td class="tc">Low — MCP Worker + JSON manifest</td>
            <td>Per-use micropayments or subscription add-on</td>
          </tr>
          <tr>
            <td class="tl"><strong>Space Templates</strong></td>
            <td class="tk">Community + Naelao</td>
            <td>Curated starting configuration within an existing Space Type: agents, apps, KB, cron jobs, assistant
              config</td>
            <td class="tc">Lowest — JSON + R2 content, no code</td>
            <td>One-time install fee or free</td>
          </tr>
        </tbody>
      </table>

      <h3>Decision Guide: App or Template?</h3>
      <ul class="fl">
        <li><strong>Build an App</strong> if you're adding new capabilities — new tools the agent can use, new UI
          panels, new data integrations, new automations triggered by external events.</li>
        <li><strong>Build a Template</strong> if you're adding new starting configurations — a pre-configured legal
          assistant for a Verticals space, a pre-built e-commerce setup for Launchpad, a starter blog setup for Sites.
        </li>
        <li><strong>You cannot build a Space Type</strong> — if what you want to do genuinely requires a new operating
          environment (custom DO, custom SpaceDO schema extension, custom agent loop), submit a feature request to Naelao. The
          team will evaluate whether a new platform Space Type is warranted.</li>
      </ul>

      <h3>App Architecture — What a Developer Controls</h3>
      <p>A Naelao App is a self-contained package that the developer deploys to their own Cloudflare account. Naelao
        never touches the developer's Worker code or data. The platform interacts with the App only through the MCP
        protocol boundary:</p>
      <pre><code><span class="cm">// A complete minimal Naelao App</span>
<span class="cm">// Developer deploys this to their OWN CF account</span>

<span class="cm">// 1. The manifest (submitted to the Naelao App Registry)</span>
{
  "id": "my-crm-connector",
  "name": "CRM Connector",
  "version": "1.0.0",
  "description": "Connects the agent to your CRM system",
  "author": { "name": "Acme Corp", "url": "https://acme.com" },

  "mcp": {
    "endpoint": "https://my-crm-mcp.acme-workers.workers.dev/mcp",
    "authScheme": "naelao-scoped-token"     <span class="cm">// Naelao passes its Scoped Token</span>
  },

  "tools": [
    {
      "name": "crm_get_contact",
      "description": "Look up a CRM contact by email",
      "inputSchema": { "type": "object", "properties": { "email": { "type": "string" } }, "required": ["email"] }
    },
    {
      "name": "crm_create_deal",
      "description": "Create a new deal in the CRM pipeline",
      "inputSchema": { "type": "object", "properties": { "contactId": { "type": "string" }, "value": { "type": "number" } }, "required": ["contactId", "value"] }
    }
  ],

  "ui": {
    "sidebarSlot": {
      "icon": "ti-address-book",
      "label": "CRM",
      "panelUrl": "https://my-crm-ui.acme-workers.workers.dev/panel"
    }
  },

  "pricing": {
    "model": "per-use",
    "pricePerCall": 0.001                    <span class="cm">// $0.001 per tool call via x402</span>
  }
}

<span class="cm">// 2. The MCP Worker (developer's CF Worker)</span>
export default {
  async fetch(request: Request, env: Env): Promise&lt;Response&gt; {
    const { tool, input, scopedToken } = await request.json();

    <span class="cm">// Validate the Naelao Scoped Token (optional but recommended)</span>
    await validateScopedToken(scopedToken, env.NAELAO_PUBLIC_KEY);

    <span class="cm">// Call the real CRM API using developer's own credentials</span>
    const result = await callCRMAPI(tool, input, env.CRM_API_KEY);

    return Response.json({ result });
  }
}</code></pre>

      <h3>Space Template Architecture — What a Developer Controls</h3>
      <p>A Space Template is pure configuration — JSON and R2 assets, no executable code. It describes a starting state
        for a Space of a particular type:</p>
      <pre><code><span class="cm">// A Space Template for a "Legal Research Assistant" built on Verticals</span>
{
  "id": "legal-research-starter",
  "name": "Legal Research Assistant",
  "version": "1.0.0",
  "targetSpaceType": "verticals",            <span class="cm">// Must match an existing platform Space Type</span>
  "description": "Pre-configured legal research assistant with case law KB",

  "agents": [
    {
      "name": "Legal Researcher",
      "systemPrompt": "You are a legal research assistant specialised in case law analysis...",
      "skills": ["web-search", "pdf-reader", "file-manager"],
      "executionTier": "container"
    }
  ],

  "apps": [
    { "appId": "westlaw-connector", "autoInstall": true },
    { "appId": "citation-formatter", "autoInstall": true }
  ],

  "knowledgeBase": {
    "documents": [
      { "name": "Citation Style Guide", "r2Key": "templates/legal-research-starter/citation-guide.pdf" },
      { "name": "Research Methodology", "r2Key": "templates/legal-research-starter/methodology.md" }
    ]
  },

  "assistantConfig": {
    "greeting": "I'm your legal research assistant. What case or statute should we examine?",
    "suggestedPrompts": [
      "Summarise recent Supreme Court decisions on...",
      "Find cases where courts have held that...",
      "Draft a research memo on..."
    ]
  }
}</code></pre>

      <h3>Revenue Flows</h3>
      <p>Community developers earn revenue through two mechanisms, both handled by Naelao's billing infrastructure so
        the developer never sees raw payment data:</p>

      <table class="t">
        <thead>
          <tr>
            <th>Mechanism</th>
            <th>How It Works</th>
            <th>Naelao Cut</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="tl"><strong>Per-use micropayments</strong></td>
            <td>Each tool call the agent makes to the App costs a developer-set amount in Naelao credits. Billed from
              the user's credit balance via the x402 rail. Developer receives 80% monthly.</td>
            <td>20%</td>
          </tr>
          <tr>
            <td class="tl"><strong>Subscription add-on</strong></td>
            <td>User pays a monthly flat fee to install the App. Processed through Naelao's billing provider. Developer
              receives 80% monthly.</td>
            <td>20%</td>
          </tr>
          <tr>
            <td class="tl"><strong>Template install fee</strong></td>
            <td>One-time credit charge when a user installs the template into their Space. Optional — developer can set
              price to 0.</td>
            <td>20%</td>
          </tr>
          <tr>
            <td class="tl"><strong>Free</strong></td>
            <td>Developer chooses no monetisation. Common for open-source apps and promotional templates.</td>
            <td>0%</td>
          </tr>
        </tbody>
      </table>

      <h3>Publishing Workflow</h3>
      <p>The path from code to listed App is intentional and short. Naelao reviews for security and quality, not for
        business model:</p>
      <ol class="fl">
        <li><strong>Submit manifest</strong> to <code>registry.naelao.dev/apps/submit</code> via the developer portal or
          CLI (<code>npx naelao publish</code>).</li>
        <li><strong>Automated scan:</strong> Naelao's CI fetches the declared MCP endpoint, calls each tool with fuzz
          inputs, and checks that the Worker does not exfiltrate the Scoped Token or make calls to undeclared domains.
        </li>
        <li><strong>Human review</strong> for Apps that declare <code>agentPermissions</code> beyond read-only, or that
          charge >$0.01 per call.</li>
        <li><strong>Listed in the App Registry</strong> within 48 hours of submission if automated checks pass.</li>
      </ol>

      <div class="box box-bl">
        <div class="box-lbl">What Gets Rejected</div>
        <p>Apps that proxy Scoped Tokens to third parties, that claim more tools in the manifest than the Worker
          exposes, that charge for tools that demonstrably do nothing, or that inject arbitrary HTML into the operator
          shell outside of a declared <code>panelUrl</code> slot. Templates that reference non-existent R2 assets or
          that target a Space Type that is not yet published.</p>
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════
     SPACE TEMPLATES — Community Contribution
═══════════════════════════════════════════════════════ -->
    <div class="sep"></div>
    <div class="sec" id="space-templates">
      <span class="sec-ey">Space Templates</span>
      <h2>Space Templates — Community-Authored Starting Configurations</h2>
      <div class="bar"></div>
      <p class="lead">A Space Template is a curated starting configuration that a community developer publishes for a
        specific Space Type. It contains no executable code — only JSON configuration, R2 content seeds, and references
        to existing Apps. When a user creates a new Space and selects a Template, the provisioner runs the Space Type
        first (Naelao infrastructure, fully trusted), then the template installer populates the space with the
        template's content (community content, safely sandboxed to R2 writes and SpaceDO method calls within the space's
        own prefix).</p>

      <div class="box box-gr">
        <div class="box-lbl">Security Model</div>
        <p>Template installation is safe because templates contain no code that executes at the platform level. The
          worst a malicious template can do is seed bad content into a user's space — which the user can see and delete.
          There is no path from template installation to platform infrastructure access, cross-tenant data access, or
          conversation data exfiltration. This is why templates have a lightweight review process compared to Apps.</p>
      </div>

      <h3>Space Template Format</h3>
      <pre><code><span class="cm">// naelao-template.json — The Template Manifest
// Stored in R2: naelao-assets/templates/{templateId}/manifest.json</span>

interface NaelaoSpaceTemplate {
  <span class="cm">// Identity</span>
  id:          string;           <span class="cm">// e.g. "legal-firm-starter"</span>
  name:        string;           <span class="cm">// e.g. "Legal Firm Starter Pack"</span>
  description: string;           <span class="cm">// max 500 chars</span>
  author:      string;           <span class="cm">// developer userId or 'naelao'</span>
  version:     string;           <span class="cm">// semver: "1.0.0"</span>
  icon_url?:   string;

  <span class="cm">// Which Space Type this template targets (REQUIRED — templates are type-specific)</span>
  targetSpaceType: string;       <span class="cm">// e.g. "verticals-legal", "launchpad", "developer"</span>

  <span class="cm">// Apps to install when this template is applied</span>
  apps: Array&lt;{
    appId:    string;            <span class="cm">// must exist in AppRegistryDO</span>
    required: boolean;           <span class="cm">// if true, space creation fails if app install fails</span>
  }&gt;;

  <span class="cm">// Agent definitions to create in the space</span>
  agents: AgentDefinition[];

  <span class="cm">// Knowledge base seed content (R2 paths relative to template bundle in naelao-assets)</span>
  knowledgeBase: Array&lt;{
    fileName:    string;         <span class="cm">// e.g. "legal-intake-guide.pdf"</span>
    r2SourceKey: string;         <span class="cm">// path in naelao-assets/templates/{id}/kb/</span>
    description: string;
  }&gt;;

  <span class="cm">// Assistant configuration</span>
  assistantConfig: {
    systemPromptOverride?: string;  <span class="cm">// override the default assistant prompt</span>
    initialMemory?: Array&lt;{         <span class="cm">// pre-seed typed memory (validated against MEMORY_SCHEMA)</span>
      key: string;
      category: 'fact' | 'preference' | 'task';
      value: Record&lt;string, unknown&gt;;
    }&gt;;
    cronJobs?: CronJob[];           <span class="cm">// pre-configured scheduled tasks</span>
  };

  <span class="cm">// Marketplace listing</span>
  marketplace: {
    visible:         boolean;
    priceUsdOneTime: number;     <span class="cm">// 0 = free. Developer earns 80% of this.</span>
    tags:            string[];   <span class="cm">// for discovery: ["legal", "starter", "professional"]</span>
  };
}</code></pre>

      <h3>Template Installation Flow</h3>
      <div class="flow">
        <div class="fstep">
          <div class="fn">1</div>
          <div class="ft"><strong>User selects template</strong> at Space creation. naelao-spaces Worker loads template
            manifest from <span class="ic">naelao-assets/templates/{id}/manifest.json</span>.</div>
        </div>
        <div class="fstep">
          <div class="fn">2</div>
          <div class="ft"><strong>Space Type provisioned first</strong> — standard Naelao provisioner runs for the
            target type. DOs, SpaceDO records, R2 prefixes all created by platform code. Template has no involvement at
            this step.</div>
        </div>
        <div class="fstep">
          <div class="fn">3</div>
          <div class="ft"><strong>Apps installed</strong> — AppRegistryDO's <span class="ic">handleInstall()</span> is
            called for each App in the template. If a required App fails to install, the template installation fails and
            the space is provisioned without template content (not rolled back — the space exists, just unconfigured).
          </div>
        </div>
        <div class="fstep">
          <div class="fn">4</div>
          <div class="ft"><strong>Agent definitions created</strong> — each AgentDefinition in the template is inserted
            into <span class="ic">agent_definitions</span> table with <span class="ic">space_id</span> set to the new
            space. Agents are private to this space.</div>
        </div>
        <div class="fstep">
          <div class="fn">5</div>
          <div class="ft"><strong>Knowledge base seeded</strong> — template KB files are copied from <span
              class="ic">naelao-assets</span> (read-only source) to <span
              class="ic">naelao-workspace/spaces/{spaceId}/knowledge/</span> and indexed via naelao-knowledge.</div>
        </div>
        <div class="fstep">
          <div class="fn">6</div>
          <div class="ft"><strong>Assistant configured</strong> — if <span class="ic">assistantConfig</span> is present,
            AssistantDO is called to write initial memory (validated through the standard <span
              class="ic">writeMemory()</span> schema) and register cron jobs.</div>
        </div>
      </div>

      <h3>Template Installer Implementation</h3>
      <pre><code><span class="cm">// workers/spaces/template-installer.ts
// Called after provisionSpace() completes successfully.
// Template installation is best-effort: failures seed warning logs but don't roll back the space.</span>

export async function installTemplate(params: {
  spaceId:    string;
  templateId: string;
  userId:     string;
  env:        Env;
}): Promise&lt;{ success: boolean; warnings: string[] }&gt; {

  const warnings: string[] = [];
  const { spaceId, templateId, userId, env } = params;

  <span class="cm">// Load template manifest</span>
  const manifestObj = await env.NAELAO_ASSETS.get(
    `templates/${templateId}/manifest.json`
  );
  if (!manifestObj) return { success: false, warnings: ['Template manifest not found'] };

  const template: NaelaoSpaceTemplate = JSON.parse(await manifestObj.text());

  <span class="cm">// Verify target type matches the space's provisioned type</span>
  const spaceDO = getProductDO(rootSpaceId, env);  // SpaceDO replaces Hyperdrive
  const space = await db.query(
    'SELECT space_type FROM spaces WHERE id = $1', [spaceId]
  );
  if (space.rows[0]?.space_type !== template.targetSpaceType) {
    return { success: false, warnings: [`Template targets ${template.targetSpaceType} but space is ${space.rows[0]?.space_type}`] };
  }

  <span class="cm">// Install Apps</span>
  const appRegistry = env.NAELAO_APP_REGISTRY_DO.get(
    env.NAELAO_APP_REGISTRY_DO.idFromName('global-app-registry')
  );
  for (const appRef of template.apps) {
    try {
      await appRegistry.fetch(new Request('http://registry/install', {
        method: 'POST',
        body: JSON.stringify({ appId: appRef.appId, spaceId })
      }));
    } catch (e) {
      if (appRef.required) {
        return { success: false, warnings: [`Required app ${appRef.appId} failed to install: ${e}`] };
      }
      warnings.push(`Optional app ${appRef.appId} failed: ${e}`);
    }
  }

  <span class="cm">// Create agent definitions</span>
  for (const agent of template.agents) {
    try {
      await db.query(
        `INSERT INTO agent_definitions (id, space_id, name, description, model, system_prompt,
           allowed_skills, resource_tier, marketplace_visible, status)
         VALUES (gen_random_uuid(), $1, $2, $3, $4, $5, $6, $7, false, 'active')`,
        [spaceId, agent.name, agent.description, agent.model,
         agent.system_prompt, agent.allowed_skills, agent.resource_tier]
      );
    } catch (e) {
      warnings.push(`Agent ${agent.name} failed to create: ${e}`);
    }
  }

  <span class="cm">// Seed knowledge base</span>
  for (const kbEntry of template.knowledgeBase) {
    try {
      <span class="cm">// Copy from naelao-assets (template source) to naelao-workspace (space instance)</span>
      const sourceObj = await env.NAELAO_ASSETS.get(kbEntry.r2SourceKey);
      if (!sourceObj) throw new Error('Source file not found in template bundle');

      await env.NAELAO_WORKSPACE.put(
        `spaces/${spaceId}/knowledge/${kbEntry.fileName}`,
        await sourceObj.arrayBuffer()
      );

      <span class="cm">// Trigger indexing via naelao-knowledge</span>
      await env.NAELAO_KNOWLEDGE.fetch(new Request('http://knowledge/index', {
        method: 'POST',
        body: JSON.stringify({ spaceId, fileName: kbEntry.fileName, description: kbEntry.description })
      }));
    } catch (e) {
      warnings.push(`KB file ${kbEntry.fileName} failed: ${e}`);
    }
  }

  <span class="cm">// Configure the Space Assistant</span>
  if (template.assistantConfig) {
    const assistantDoId = env.NAELAO_ASSISTANT_DO.idFromName(
      `assistant:${spaceId}:${userId}`
    );
    const assistantDO = env.NAELAO_ASSISTANT_DO.get(assistantDoId);

    <span class="cm">// Seed initial memory (goes through standard writeMemory() schema validation)</span>
    for (const mem of (template.assistantConfig.initialMemory ?? [])) {
      try {
        await assistantDO.fetch(new Request('http://assistant/memory/write', {
          method: 'POST',
          body: JSON.stringify({ key: mem.key, category: mem.category, value: mem.value })
        }));
      } catch (e) {
        warnings.push(`Memory seed ${mem.key} failed: ${e}`);
      }
    }

    <span class="cm">// Write cron jobs to R2</span>
    if (template.assistantConfig.cronJobs?.length) {
      await env.NAELAO_WORKSPACE.put(
        `spaces/${spaceId}/assistants/${userId}/cron-jobs.json`,
        JSON.stringify({
          jobs: template.assistantConfig.cronJobs,
          version: '1.0',
          updatedBy: 'template-installer',
          updatedAt: new Date().toISOString()
        })
      );
    }
  }

  <span class="cm">// Record the template install for marketplace analytics</span>
  await db.query(
    `INSERT INTO space_template_installs (space_id, template_id, installed_at)
     VALUES ($1, $2, NOW())`,
    [spaceId, templateId]
  );

  return { success: true, warnings };
}</code></pre>

