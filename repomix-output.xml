<span class="cm">// ── 2. USER MANAGEMENT ──────────────────────────────────────</span>
app.get('/users', async (c) =&gt; {
  const { search, limit = '50', offset = '0' } = c.req.query();
  const spaceDO = getProductDO(rootSpaceId, c.env);  // SpaceDO replaces Hyperdrive
  const { rows } = await db.query(
    `SELECT u.id, u.email, u.created_at, u.last_sign_in_at,
            p.display_name, p.banned, p.ban_reason, p.ban_expires_at,
            COUNT(DISTINCT s.id)::int AS space_count
     FROM auth.users u
     LEFT JOIN user_profiles p ON p.id = u.id
     LEFT JOIN spaces s ON s.owner_id = u.id
     WHERE ($1::text IS NULL OR u.email ILIKE '%'||$1||'%' OR p.display_name ILIKE '%'||$1||'%')
     GROUP BY u.id, u.email, u.created_at, u.last_sign_in_at, p.display_name, p.banned, p.ban_reason, p.ban_expires_at
     ORDER BY u.created_at DESC LIMIT $2 OFFSET $3`,
