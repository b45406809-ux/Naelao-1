          <td class="tn"><span class="mono">github.com/org/naelao</span></td>
          <td>package.json repository field</td>
        </tr>
        <tr>
          <td class="tl">Log prefix</td>
          <td><span class="mono">[SUNA]</span></td>
          <td class="tn"><span class="mono">[NAELAO]</span></td>
          <td>All console.log / structured log calls</td>
        </tr>
