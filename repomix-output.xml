    <h4>Layer 4 — CF Queue Message Validation</h4>
    <pre><code><span class="cm">// Every queue consumer must validate spaceId before processing.
// A bug in a producer that sends the wrong spaceId must not cause
// cross-tenant data processing in the consumer.</span>

<span class="cm">// workers/agents/index.ts — Queue consumer</span>
export default {
  async queue(batch: MessageBatch&lt;AgentRunMessage&gt;, env: Env): Promise&lt;void&gt; {
    for (const message of batch.messages) {
      const { spaceId, threadId, userId } = message.body;

      <span class="cm">// Validate spaceId format</span>
      if (!/^[0-9a-f-]{36}$/.test(spaceId)) {
        console.error('[NAELAO] Invalid spaceId in queue message, discarding:', message.id);
        message.ack(); <span class="cm">// ack to prevent infinite retry</span>
        continue;
      }

      <span class="cm">// Validate that this user is actually in this space (call naelao-auth)</span>
      const authResult = await env.NAELAO_AUTH.fetch(new Request('http://auth/validate-membership', {
        method: 'POST',
        body: JSON.stringify({ spaceId, userId })
      }));

      if (!authResult.ok) {
        console.error('[NAELAO] Space membership validation failed for queue message:', message.id);
        message.ack();
        continue;
      }

      <span class="cm">// Safe to process</span>
      try {
        await processAgentRun(message.body, env);
        message.ack();
      } catch (e) {
        console.error('[NAELAO] Agent run failed:', e);
        message.retry(); <span class="cm">// CF Queues will retry up to max_retries</span>
      }
    }
  }
};</code></pre>

