      <h3>The Knowledge-Graph Agent Loop</h3>
      <p>Standard RAG retrieves chunks of text based on vector similarity. The <code>knowledge-graph</code> loop is
        superior for expert domains: it retrieves explicit claims and relationships (e.g.,
        <code>[Drug_A] -> [Contraindicates] -> [Condition_B]</code>). The agent queries the
        <code>KnowledgeGraphDO</code> to traverse these relationships before answering.</p>

      <pre><code><span class="cm">// agentpress/loops/knowledge-graph.ts</span>

export async function executeKnowledgeGraphLoop(
  input: string,
  agentDO: NaelaoAgentDO,
  env: Env
): Promise&lt;string&gt; {
  
  <span class="cm">// 1. Entity Extraction</span>
  <span class="cm">// Agent extracts core entities from the user's query</span>
  const extraction = await agentDO.callLLM({
    messages: [{ role: 'user', content: `Extract core entities from: ${input}` }],
    model: 'claude-haiku-4-5',
    system: [{ type: 'text', text: 'Output JSON array of entity strings only.' }]
  });
  const entities = JSON.parse(extraction.content);

  <span class="cm">// 2. Graph Traversal (via Custom DO)</span>
  <span class="cm">// Query the KnowledgeGraphDO for subgraphs related to these entities</span>
  const kgDO = env.NAELAO_CUSTOM_DO.get(
    env.NAELAO_CUSTOM_DO.idFromName(`KnowledgeGraphDO:${agentDO.spaceId}`)
  );
  
  const graphResp = await kgDO.fetch(new Request('http://kg/traverse', {
    method: 'POST',
    body: JSON.stringify({ entities, depth: 2 })
  }));
  const subGraph = await graphResp.json();

  <span class="cm">// 3. Grounded Synthesis</span>
  <span class="cm">// The LLM generates an answer strictly bounded by the retrieved subgraph</span>
  const synthesis = await agentDO.callLLM({
    messages: [{ role: 'user', content: input }],
    model: 'claude-sonnet-4-5',
    system: [{ 
      type: 'text', 
      text: `You are an expert advisor. You must base your answer STRICTLY on the following verified claims from the knowledge graph. Do not use outside knowledge. Cite the claim IDs.\n\nGraph Data:\n${JSON.stringify(subGraph)}` 
    }]
  });

  return synthesis.content;
}</code></pre>

