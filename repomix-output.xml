  <div class="sec" id="naelao-threads-impl">
    <span class="sec-ey">28 — naelao-threads: Implementation</span>
    <h2>naelao-threads — Complete Implementation Reference</h2>
    <div class="bar"></div>
    <p class="lead">naelao-threads is the Worker responsible for every thread and message operation: creating threads,
      persisting messages, paginating history, streaming LLM tokens to the client, and managing the reconnect buffer. It
      seems simple but has several non-obvious implementation requirements that junior developers commonly get wrong.
    </p>

    <h3>Complete Thread Worker Implementation</h3>
    <pre><code><span class="cm">// workers/threads/index.ts
// naelao-threads Worker — all thread and message operations.
// Called via Service Binding from naelao-router.
// NEVER called directly from the browser — always through naelao-router.</span>

// No Supabase client import — data access is via SpaceDO Service Binding
// import { createClient } from '@supabase/supabase-js'; // REMOVED

export default {
  async fetch(request: Request, env: Env): Promise&lt;Response&gt; {
    const url = new URL(request.url);
    const spaceId = request.headers.get('X-Space-Id') ?? '';
    const userId  = request.headers.get('X-User-Id') ?? '';
    
    <span class="cm">// spaceId MUST be present — naelao-auth set it on the header
    // If it's missing, this request bypassed auth — reject it</span>
    if (!spaceId || !/^[0-9a-f-]{36}$/.test(spaceId)) {
      return new Response('Missing or invalid X-Space-Id header', { status: 400 });
    }

    const spaceDO = getProductDO(rootSpaceId, env);  // per-product SpaceDO

    const path = url.pathname;

    if (path === '/threads' &amp;&amp; request.method === 'POST')
      return createThread(request, spaceDO, spaceId, userId);
    
    if (path.match(/^\/threads\/[^/]+$/) &amp;&amp; request.method === 'GET')
      return getThread(url, spaceDO, spaceId);
    
    if (path.match(/^\/threads\/[^/]+\/messages$/) &amp;&amp; request.method === 'GET')
      return getMessages(url, spaceDO, spaceId);
    
    if (path.match(/^\/threads\/[^/]+\/messages$/) &amp;&amp; request.method === 'POST')
      return addMessage(request, url, db, spaceId, userId, env);
    
    if (path.match(/^\/threads\/[^/]+\/stream$/) &amp;&amp; request.method === 'GET')
      return openStreamConnection(url, db, spaceId, env);

    return new Response('Not Found', { status: 404 });
  }
};

async function createThread(
  request: Request,
  spaceDO: DurableObjectStub,  // SpaceDO replaces SupabaseClient
  spaceId: string,
  userId: string
): Promise&lt;Response&gt; {
  const { projectId, title, agentDefinitionId } = await request.json();

  <span class="cm">// Validate projectId belongs to this space (double check beyond RLS)</span>
  const { data: project } = await db
    .from('projects')
    .select('id')
    .eq('id', projectId)
    .eq('space_id', spaceId)  <span class="cm">// withSpace() pattern</span>
    .single();
  
  if (!project) {
    return Response.json({ error: 'Project not found in this space' }, { status: 404 });
  }

  const threadId = crypto.randomUUID();
  const { data: thread, error } = await db
    .from('threads')
    .insert({
      id: threadId,
      project_id: projectId,
      space_id: spaceId,          <span class="cm">// ALWAYS include space_id on insert</span>
      created_by: userId,
      title: title ?? 'New Thread',
      agent_definition_id: agentDefinitionId,
      status: 'active'
    })
    .select()
    .single();

  if (error) {
    return Response.json({ error: error.message }, { status: 500 });
  }

  return Response.json(thread, { status: 201 });
}

async function getMessages(
  url: URL,
  spaceDO: DurableObjectStub,  // SpaceDO replaces SupabaseClient
  spaceId: string
): Promise&lt;Response&gt; {
  const threadId = url.pathname.split('/')[2];
  const before = url.searchParams.get('before');  <span class="cm">// cursor-based pagination</span>
  const limit  = Math.min(parseInt(url.searchParams.get('limit') ?? '50'), 100);

  let query = db
    .from('messages')
    .select('*')
    .eq('thread_id', threadId)
    .eq('space_id', spaceId)    <span class="cm">// withSpace() equivalent</span>
    .order('created_at', { ascending: false })
    .limit(limit);

  if (before) {
    <span class="cm">// Cursor pagination — fetch messages BEFORE this timestamp
    // This is more efficient than offset pagination for chat history</span>
    query = query.lt('created_at', before);
  }

  const { data: messages, error } = await query;
  if (error) return Response.json({ error: error.message }, { status: 500 });

  return Response.json({
    messages: (messages ?? []).reverse(), <span class="cm">// reverse to chronological order</span>
    hasMore: (messages?.length ?? 0) === limit,
    nextCursor: messages?.[0]?.created_at ?? null
  });
}

async function openStreamConnection(
  url: URL,
  spaceDO: DurableObjectStub,  // SpaceDO replaces SupabaseClient
  spaceId: string,
  env: Env
): Promise&lt;Response&gt; {
  const threadId = url.pathname.split('/')[2];

  <span class="cm">// Verify thread belongs to this space before connecting to its AgentDO</span>
  const { data: thread } = await db
    .from('threads')
    .select('id, project_id, agent_definition_id')
    .eq('id', threadId)
    .eq('space_id', spaceId)
    .single();

  if (!thread) {
    return Response.json({ error: 'Thread not found in this space' }, { status: 404 });
  }

  <span class="cm">// Upgrade to WebSocket for streaming
  // naelao-threads proxies the WebSocket to the AgentDO
  // The client connects here; naelao-threads forwards to the DO</span>
  const upgradeHeader = url.searchParams.get('upgrade');
  if (upgradeHeader !== 'websocket') {
    <span class="cm">// If not WebSocket, return SSE stream (for clients that don't support WS)</span>
    return createSSEStream(thread, env, spaceId);
  }

  <span class="cm">// WebSocket — proxy to AgentDO</span>
  const agentDoId = env.NAELAO_AGENT_DO.idFromName(
    `${spaceId}:${thread.project_id}:${threadId}`
  );
  const agentDO = env.NAELAO_AGENT_DO.get(agentDoId);

  <span class="cm">// Forward the WebSocket upgrade request to the DO
  // The DO handles hibernation, buffering, and broadcasting</span>
  return agentDO.fetch(url.toString(), { headers: { Upgrade: 'websocket' } });
}

function createSSEStream(thread: Thread, env: Env, spaceId: string): Response {
  <span class="cm">// SSE (Server-Sent Events) for clients that prefer it over WebSocket
  // Less efficient for long sessions but simpler to implement in some frontends</span>
  const { readable, writable } = new TransformStream();
  const writer = writable.getWriter();
  const encoder = new TextEncoder();

  <span class="cm">// Connect to AgentDO via WebSocket internally and forward events as SSE</span>
  void (async () => {
    const agentDoId = env.NAELAO_AGENT_DO.idFromName(
      `${spaceId}:${thread.project_id}:${thread.id}`
    );
    const agentDO = env.NAELAO_AGENT_DO.get(agentDoId);
    const wsResp = await agentDO.fetch('http://agent/connect', {
      headers: { Upgrade: 'websocket' }
    });
    const ws = wsResp.webSocket!;
    ws.accept();
    ws.addEventListener('message', (evt) =&gt; {
      const data = encoder.encode(`data: ${evt.data}\n\n`);
      writer.write(data);
    });
    ws.addEventListener('close', () =&gt; writer.close());
  })();

  return new Response(readable, {
    headers: {
      'Content-Type': 'text/event-stream',
      'Cache-Control': 'no-cache',
      'Connection': 'keep-alive',
    }
  });
}</code></pre>

    <h3>Why Cursor Pagination (Not Offset) for Chat History</h3>
    <div class="box box-am">
      <div class="box-lbl">⚠ Common Junior Dev Mistake: Offset Pagination for Chat</div>
      <p>Using <span class="ic">LIMIT 50 OFFSET 100</span> for chat history seems intuitive but breaks in a real chat
        app. When a new message arrives while the user is scrolling up through history, all offsets shift. Messages skip
        or duplicate.</p>
      <p><strong>Correct approach:</strong> Cursor-based pagination using the <span class="ic">created_at</span>
        timestamp as the cursor. <span class="ic">WHERE created_at &lt; {cursor} ORDER BY created_at DESC LIMIT
          50</span>. The cursor is the timestamp of the oldest message the client has. New messages arriving don't
        affect this query at all.</p>
      <p>The <span class="ic">nextCursor</span> in the response is the <span class="ic">created_at</span> of the oldest
        message returned. The client sends this as the <span class="ic">before</span> parameter on the next request to
        load older messages.</p>
    </div>
  </div>

