<file path=".github/workflows/deploy-staging.yml">
name: Deploy to staging

on:
  push:
    branches: [main]

env:
  NODE_VERSION: "22"
  PNPM_VERSION: "9"

jobs:
  deploy-workers-staging:
    name: Deploy workers to staging
    runs-on: ubuntu-latest
    environment: staging
    concurrency: deploy-staging
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Run D1 migrations (staging)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
        run: |
          DB_ID="${{ vars.D1_DATABASE_ID_STAGING }}"
          for migration in infra/migrations/*.sql; do
            echo "Applying $migration..."
            npx wrangler d1 execute "$DB_ID" \
              --file="$migration" \
              --remote \
              --env=staging 2>&1 || true
          done

      - name: Deploy router worker (staging)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
        run: npx wrangler deploy --env=staging --config=workers/router/wrangler.toml

      - name: Deploy spaces worker (staging)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
        run: npx wrangler deploy --env=staging --config=workers/spaces/wrangler.toml

      - name: Deploy agents worker (staging)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
        run: npx wrangler deploy --env=staging --config=workers/agents/wrangler.toml

      - name: Deploy auth worker (staging)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
        run: npx wrangler deploy --env=staging --config=workers/auth/wrangler.toml

      - name: Deploy knowledge worker (staging)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
        run: npx wrangler deploy --env=staging --config=workers/knowledge/wrangler.toml

      - name: Deploy billing worker (staging)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
        run: npx wrangler deploy --env=staging --config=workers/billing/wrangler.toml

      - name: Deploy remaining workers (staging)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
        run: |
          # F-16: previously each failure was swallowed with `|| echo "non-fatal"`, so a
          # half-deployed platform still reported the job green. Now: track every failure, surface
          # a summary to the GitHub Actions run, and fail the step if ANY worker failed to deploy.
          failed=()
          for w in analytics marketplace threads assistant browser mini-agi channels security-gateway workflows ws-gateway; do
            if [ -f "workers/$w/wrangler.toml" ]; then
              echo "Deploying $w..."
              if ! npx wrangler deploy --env=staging --config="workers/$w/wrangler.toml"; then
                echo "❌ $w deploy failed"
                failed+=("$w")
              fi
            fi
          done
          if [ ${#failed[@]} -gt 0 ]; then
            echo "### ❌ Staging deploy: ${#failed[@]} worker(s) failed: ${failed[*]}" >> "$GITHUB_STEP_SUMMARY"
            exit 1
          fi
          echo "### ✅ Staging deploy: all secondary workers deployed" >> "$GITHUB_STEP_SUMMARY"

  deploy-dashboard-staging:
    name: Deploy dashboard to staging (CF Pages)
    runs-on: ubuntu-latest
    environment: staging
    concurrency: deploy-staging-pages
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build dashboard
        run: pnpm --filter @naelao/dashboard build
        env:
          NEXT_PUBLIC_API_URL: ${{ vars.API_URL_STAGING }}

      - name: Deploy to CF Pages (dashboard)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CF_PAGES_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
        run: |
          npx wrangler pages deploy apps/dashboard/.vercel/output/static \
            --project-name=naelao-dashboard-staging \
            --branch=main

  deploy-portal-staging:
    name: Deploy portal to staging (CF Pages)
    runs-on: ubuntu-latest
    environment: staging
    needs: [deploy-workers-staging]
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build portal
        run: pnpm --filter @naelao/portal build
        env:
          NEXT_PUBLIC_API_URL: ${{ vars.API_URL_STAGING }}

      - name: Deploy to CF Pages (portal)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CF_PAGES_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
        run: |
          npx wrangler pages deploy apps/portal/.vercel/output/static \
            --project-name=naelao-portal-staging \
            --branch=main

  deploy-marketplace-staging:
    name: Deploy marketplace-web to staging (CF Pages)
    runs-on: ubuntu-latest
    environment: staging
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build marketplace
        run: pnpm --filter @naelao/marketplace-web build
        env:
          NEXT_PUBLIC_API_URL: ${{ vars.API_URL_STAGING }}
          NEXT_PUBLIC_DASHBOARD_URL: ${{ vars.DASHBOARD_URL_STAGING }}

      - name: Deploy to CF Pages (marketplace)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CF_PAGES_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
        run: |
          npx wrangler pages deploy apps/marketplace-web/.vercel/output/static \
            --project-name=naelao-marketplace-staging \
            --branch=main

  deploy-widget-staging:
    name: Build and publish widget
    runs-on: ubuntu-latest
    environment: staging
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: pnpm

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build widget
        run: pnpm --filter @naelao/widget build

      - name: Upload widget to R2 (staging)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
        run: |
          npx wrangler r2 object put \
            naelao-static/widget/naelao-chat.js \
            --file=apps/widget/dist/naelao-chat.js \
            --content-type="application/javascript" \
            --cache-control="public, max-age=300"
</file>

<file path=".github/workflows/implement-full-plan.yml">
name: Implement full plan with rotating AI models

on:
  workflow_dispatch:
    inputs:
      start_phase:
        description: First Repomix phase (1-13)
        required: true
        default: "1"
      end_phase:
        description: Last Repomix phase (1-13)
        required: true
        default: "13"
      models:
        description: Comma-separated Gemini model rotation
        required: true
        default: "gemini-2.5-flash,gemini-2.5-flash-lite"
      max_turns_per_phase:
        description: Maximum patch/continuation turns per phase
        required: true
        default: "8"
      verify_command:
        description: Command run before each phase commit
        required: true
        default: "pnpm typecheck && pnpm test"

concurrency:
  group: implement-full-plan-${{ github.ref }}
  cancel-in-progress: false

permissions:
  contents: write
  pull-requests: write

jobs:
  implement:
    runs-on: ubuntu-latest
    timeout-minutes: 360
    env:
      GEMINI_API_KEYS: ${{ secrets.GEMINI_API_KEYS }}
      AI_MODELS: ${{ inputs.models }}
      MAX_TURNS_PER_PHASE: ${{ inputs.max_turns_per_phase }}
      PHASE_VERIFY_COMMAND: ${{ inputs.verify_command }}
      BRANCH_NAME: ai/full-plan-${{ github.run_id }}-${{ github.run_attempt }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: pnpm/action-setup@v4
        with:
          version: 9.12.0

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - name: Validate API key configuration
        run: test -n "$GEMINI_API_KEYS" || { echo "Repository secret GEMINI_API_KEYS is required" >&2; exit 1; }

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Create accumulator branch
        run: |
          git config user.name "naelao-plan-bot"
          git config user.email "naelao-plan-bot@users.noreply.github.com"
          git switch -c "$BRANCH_NAME"

      - name: Compile and verify self-contained prompts
        run: |
          node repomix/build-prompts.mjs
          node repomix/prepare-authority-context.mjs
          node repomix/verify-configs.mjs

      - name: Implement selected phases sequentially
        run: >-
          node run-phase.mjs
          --start "${{ inputs.start_phase }}"
          --end "${{ inputs.end_phase }}"
          --models "${{ inputs.models }}"
          --max-turns "${{ inputs.max_turns_per_phase }}"
          --verify "${{ inputs.verify_command }}"

      - name: Push accumulator branch
        run: git push --set-upstream origin "$BRANCH_NAME"

      - name: Upload model responses and patches
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: phase-runs-${{ github.run_id }}-${{ github.run_attempt }}
          path: .phase-runs/
          if-no-files-found: ignore
          retention-days: 14

      - name: Open pull request
        if: success()
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh pr create \
            --base "${GITHUB_REF_NAME}" \
            --head "$BRANCH_NAME" \
            --title "Implement plan phases ${{ inputs.start_phase }}-${{ inputs.end_phase }}" \
            --body-file <(cat <<'EOF'
          Automated sequential implementation using the self-contained Repomix phase prompts.

          - Start phase: ${{ inputs.start_phase }}
          - End phase: ${{ inputs.end_phase }}
          - Models: ${{ inputs.models }}
          - Verification before every phase commit: `${{ inputs.verify_command }}`

          Each phase was regenerated from the preceding committed accumulator state. Review every
          commit, migration, deployment binding, security boundary, and release-ledger update before
          merging.
          EOF
          )
</file>

<file path=".github/workflows/manual-cmd.yml">
name: Manual Command Runner

on:
  workflow_dispatch:
    inputs:
      command:
        description: 'Enter the command to run (e.g., npx repomix)'
        required: true
        type: string

jobs:
  run-command:
    runs-on: ubuntu-latest

    # Permission needed to push changes back to the repository
    permissions:
      contents: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          ref: ${{ github.ref }}

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Execute Custom Command
        env:
          USER_COMMAND: ${{ github.event.inputs.command }}
        run: |
          echo "Running: $USER_COMMAND"
          eval "$USER_COMMAND"

      - name: Commit and Push Changes
        run: |
          # Show modified/untracked files before staging (useful for debugging)
          echo "=== Git Status Before Staging ==="
          git status

          # Configure git with a generic GitHub Actions bot identity
          git config --local user.name "github-actions[bot]"
          git config --local user.email "41898282+github-actions[bot]@users.noreply.github.com"

          # Stage all changes (created, modified, or deleted files)
          git add -A

          # Only commit and push if there are actual changes to prevent workflow failure
          if ! git diff-index --quiet HEAD; then
            git commit -m "chore: automated changes from manual command [skip ci]"
            git push origin HEAD:${{ github.ref_name }}
          else
            echo "No changes detected. Skipping commit and push."
          fi
</file>

<file path=".github/workflows/pr-checks.yml">
name: PR checks

on:
  pull_request:
    branches: [main]

env:
  NODE_VERSION: "20"
  PNPM_VERSION: "9"

jobs:
  migration-safety:
    name: Migration safety check
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Check for destructive migration statements
        run: |
          FAILED=0
          CHANGED=$(git diff --name-only origin/main...HEAD -- 'infra/migrations/*.sql' 2>/dev/null || \
                    git diff --name-only HEAD~1 HEAD -- 'infra/migrations/*.sql' 2>/dev/null || true)
          if [ -z "$CHANGED" ]; then
            echo "No migration files changed."
            exit 0
          fi
          for f in $CHANGED; do
            if [ -f "$f" ]; then
              # Block DROP TABLE / DROP COLUMN / TRUNCATE on existing migrations
              if grep -iE '^\s*(DROP\s+TABLE|TRUNCATE|DROP\s+COLUMN)' "$f"; then
                echo "❌ Destructive statement found in $f — use ALTER TABLE RENAME for column changes"
                FAILED=1
              fi
              # Warn about migrations that modify existing tables without IF EXISTS guards
              if grep -iE '^\s*ALTER\s+TABLE' "$f" | grep -iv 'IF EXISTS'; then
                echo "⚠️  ALTER TABLE without IF EXISTS guard in $f — ensure backwards compatibility"
              fi
            fi
          done
          if [ "$FAILED" -eq 1 ]; then exit 1; fi
          echo "✅ Migration safety check passed"

  secret-scan:
    name: Secret scanning
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Detect hardcoded secrets
        run: |
          FAILED=0
          # Patterns that suggest hardcoded secrets
          PATTERNS=(
            'sk-[a-zA-Z0-9]{20,}'
            'AKIA[0-9A-Z]{16}'
            'AIza[0-9A-Za-z\-_]{35}'
            'ghp_[a-zA-Z0-9]{36}'
            'stripe_live.*sk_live'
            'password\s*=\s*["\x27][^"\x27]{8,}'
          )
          EXCLUDE='\.github/workflows|\.example|\.env\.example|test.*fixture|mock'
          for pattern in "${PATTERNS[@]}"; do
            MATCHES=$(git diff origin/main...HEAD -U0 2>/dev/null | grep '^+' | grep -v '^+++' | \
                      grep -iP "$pattern" | grep -vE "$EXCLUDE" | head -5 || true)
            if [ -n "$MATCHES" ]; then
              echo "⚠️  Possible secret pattern '$pattern' in diff:"
              echo "$MATCHES"
              FAILED=1
            fi
          done
          if [ "$FAILED" -eq 1 ]; then
            echo "❌ Potential secrets detected — use CF Workers Secrets, never hardcode"
            exit 1
          fi
          echo "✅ No hardcoded secrets detected"

  migration-order:
    name: Migration ordering check
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Verify migration file ordering
        run: |
          PREV=0
          for f in infra/migrations/*.sql; do
            NUM=$(basename "$f" | grep -oP '^\d+')
            if [ "$((10#$NUM))" -ne "$((PREV + 1))" ]; then
              echo "❌ Migration gap: expected $((PREV + 1)) but got $NUM (file: $f)"
              exit 1
            fi
            PREV="$((10#$NUM))"
          done
          echo "✅ Migration order is correct (1 through $PREV)"
</file>

