  <div class="sep"></div>
  <div class="sec" id="naelao-knowledge">
    <span class="sec-ey">31 — Worker Deep Dive: naelao-knowledge</span>
    <h2>naelao-knowledge — Knowledge Base & Semantic Search</h2>
    <div class="bar"></div>
    <p class="lead">The knowledge base is how users give agents persistent, searchable context about their projects.
      Think of it as Claude's "Project Instructions" but stored in R2 and indexed in Vectorize for semantic retrieval.
      Every agent run can reference knowledge documents even if they're too large to fit in the context window — the
      knowledge Worker retrieves the most relevant chunks.</p>

    <h3>How Knowledge Injection Works</h3>
    <ol class="nl">
      <li><strong>User uploads a document</strong> via the UI (PDF, DOCX, Markdown, plain text). Frontend calls POST
        /knowledge with the file. naelao-knowledge stores the raw file in R2 and chunks it into 512-token segments.</li>
      <li><strong>Embedding generation:</strong> Each chunk is passed to Cloudflare Vectorize (via Workers AI <span
          class="ic">@cf/baai/bge-base-en-v1.5</span> embedding model) to produce a 768-dimensional vector. Vectors
        stored in Vectorize index <span class="ic">naelao-kb-{spaceId}</span>.</li>
      <li><strong>At agent run start:</strong> ContextManager calls naelao-knowledge with the current user query.
        Knowledge Worker runs a vector similarity search (top-5 chunks by cosine similarity) and returns the most
        relevant chunks as text.</li>
      <li><strong>Context injection:</strong> The retrieved chunks are inserted into the system prompt in the
        knowledge_base block (the dynamic, uncached block) wrapped in XML: <span
          class="ic">&lt;knowledge&gt;...&lt;/knowledge&gt;</span>.</li>
    </ol>

    <h3>Complete Implementation</h3>
    <pre><code><span class="cm">// workers/knowledge/index.ts</span>
import { Hono } from 'hono';
const app = new Hono&lt;{ Bindings: Env }&gt;();

<span class="cm">// POST /knowledge — upload a document to the knowledge base</span>
app.post('/knowledge', async (c) =&gt; {
  const spaceId = c.get('spaceId');
  const projectId = c.req.query('projectId');
  const formData = await c.req.formData();
  const file = formData.get('file') as File | null;
  const name = formData.get('name') as string | null;

  if (!file) return c.json({ error: 'file is required' }, 400);
  if (!name)  return c.json({ error: 'name is required' }, 400);

  const docId = crypto.randomUUID();
  const fileExtension = file.name.split('.').pop()?.toLowerCase() ?? 'txt';

  <span class="cm">// 1. Store raw file in R2</span>
  const r2Path = projectId
    ? `spaces/${spaceId}/projects/${projectId}/knowledge/${docId}.${fileExtension}`
    : `spaces/${spaceId}/knowledge/${docId}.${fileExtension}`;

  await c.env.NAELAO_WORKSPACE.put(r2Path, file.stream(), {
    httpMetadata: { contentType: file.type },
    customMetadata: { name, docId, uploadedAt: Date.now().toString() }
  });

  <span class="cm">// 2. Extract text content based on file type</span>
  let textContent: string;
  const fileBuffer = await file.arrayBuffer();

  if (fileExtension === 'pdf') {
    textContent = await extractPdfText(fileBuffer, c.env);
  } else if (fileExtension === 'docx') {
    textContent = await extractDocxText(fileBuffer);
  } else {
    textContent = new TextDecoder().decode(fileBuffer);
  }

  <span class="cm">// 3. Chunk the text into 512-token segments with 50-token overlap
  // Overlap prevents important context from being cut at chunk boundaries</span>
  const chunks = chunkText(textContent, 512, 50);

  <span class="cm">// 4. Generate embeddings and store in Vectorize
  // Process in batches of 100 (Vectorize upsert limit)</span>
  const vectorBatches = [];
  for (let i = 0; i &lt; chunks.length; i += 100) {
    vectorBatches.push(chunks.slice(i, i + 100));
  }

  for (const batch of vectorBatches) {
    <span class="cm">// Generate embeddings via Workers AI</span>
    const embeddings = await c.env.AI.run('@cf/baai/bge-base-en-v1.5', {
      text: batch.map(chunk =&gt; chunk.text)
    });

    <span class="cm">// Upsert into Vectorize</span>
    const vectors = batch.map((chunk, idx) =&gt; ({
      id: `${docId}:chunk:${chunk.index}`,
      values: embeddings.data[idx],
      metadata: {
        spaceId, projectId: projectId ?? '',
        docId, docName: name,
        chunkIndex: chunk.index,
        text: chunk.text.slice(0, 1000), <span class="cm">// store first 1000 chars for retrieval</span>
        r2Path
      }
    }));

    await c.env.NAELAO_VECTORIZE.upsert(vectors);
  }

  <span class="cm">// 5. Record in SpaceDO SQLite via spaceDO.insertAgentRun()</span>
  await spaceDO.query(  // SpaceDO replaces direct Hyperdrive query
    `INSERT INTO knowledge_docs (id, space_id, project_id, name, r2_path, chunk_count, created_at)
     VALUES ($1, $2, $3, $4, $5, $6, NOW())`,
    [docId, spaceId, projectId ?? null, name, r2Path, chunks.length]
  );

  return c.json({ docId, name, chunkCount: chunks.length });
});

<span class="cm">// GET /knowledge/search — semantic search for relevant chunks</span>
app.get('/knowledge/search', async (c) =&gt; {
  const spaceId = c.get('spaceId');
  const { q, projectId, topK = '5' } = c.req.query();

  if (!q) return c.json({ error: 'q (query) is required' }, 400);

  <span class="cm">// Generate query embedding</span>
  const queryEmbedding = await c.env.AI.run('@cf/baai/bge-base-en-v1.5', {
    text: [q]
  });

  <span class="cm">// Build filter: must match spaceId, optionally match projectId</span>
  const filter: Record&lt;string, string&gt; = { spaceId };
  if (projectId) filter.projectId = projectId;

  <span class="cm">// Vector similarity search</span>
  const results = await c.env.NAELAO_VECTORIZE.query(
    queryEmbedding.data[0],
    {
      topK: parseInt(topK),
      filter,
      returnMetadata: 'all'
    }
  );

  <span class="cm">// Format for context injection</span>
  const chunks = results.matches.map(match =&gt; ({
    docName: match.metadata?.docName as string,
    text: match.metadata?.text as string,
    score: match.score,
    chunkIndex: match.metadata?.chunkIndex as number
  }));

  return c.json({ chunks, query: q });
});

<span class="cm">// Chunk text into segments of approximately `chunkTokens` tokens with `overlapTokens` overlap
// Simple whitespace-based tokenizer — good enough for chunking, not for billing</span>
function chunkText(
  text: string,
  chunkTokens: number,
  overlapTokens: number
): Array&lt;{ index: number; text: string }&gt; {
  const words = text.split(/\s+/).filter(w =&gt; w.length &gt; 0);
  const chunks: Array&lt;{ index: number; text: string }&gt; = [];

  let start = 0;
  let chunkIndex = 0;

  while (start &lt; words.length) {
    const end = Math.min(start + chunkTokens, words.length);
    const chunkText = words.slice(start, end).join(' ');
    chunks.push({ index: chunkIndex++, text: chunkText });

    if (end &gt;= words.length) break;
    start = end - overlapTokens; <span class="cm">// overlap: go back `overlapTokens` for next chunk</span>
  }

  return chunks;
}

export default app;</code></pre>

    <h3>Using Knowledge in Agent Context</h3>
    <pre><code><span class="cm">// agentpress/context-manager.ts — semantic knowledge retrieval at run start
// Called once per agent turn, not once per run.
// This allows knowledge retrieval to adapt to what the user just asked.</span>

async buildContextWithKnowledge(
  sessionId: string,
  latestUserMessage: string,
  spaceId: string,
  projectId: string,
  env: Env
): Promise&lt;{ system: TextBlockParam[]; messages: MessageParam[] }&gt; {

  <span class="cm">// Run semantic search against knowledge base in parallel with session loading
  // Don't await sequentially — these can happen at the same time</span>
  const [sessionMessages, knowledgeChunks] = await Promise.all([
    this.loadSessionMessages(sessionId),
    this.searchKnowledge(latestUserMessage, spaceId, projectId, env)
  ]);

  const knowledgeBlock = knowledgeChunks.length &gt; 0
    ? `&lt;knowledge_base&gt;
${knowledgeChunks.map(c =&gt;
        `&lt;doc name="${c.docName}" relevance="${c.score.toFixed(2)}"&gt;
${c.text}
&lt;/doc&gt;`
      ).join('
')}
&lt;/knowledge_base&gt;`
    : '';

  <span class="cm">// Build system prompt with knowledge injected LAST (dynamic, uncached)
  // Static blocks (systemPrompt, spaceContext, skills) come first for cache optimization</span>
  const system: TextBlockParam[] = [
    { type: 'text', text: this.opts.systemPrompt, cache_control: { type: 'ephemeral' } },
    { type: 'text', text: this.opts.spaceContext,  cache_control: { type: 'ephemeral' } },
    { type: 'text', text: this.opts.skillsXML,     cache_control: { type: 'ephemeral' } },
    <span class="cm">// Knowledge goes AFTER cached blocks — it changes per query, so no cache_control</span>
    ...(knowledgeBlock ? [{ type: 'text' as const, text: knowledgeBlock }] : [])
  ];

  const messages = this.truncateMessages(sessionMessages);
  return { system, messages };
}

private async searchKnowledge(
  query: string,
  spaceId: string,
  projectId: string,
  env: Env
): Promise&lt;KnowledgeChunk[]&gt; {
  try {
    const resp = await env.NAELAO_KNOWLEDGE.fetch(
      new Request(
        `http://knowledge/search?q=${encodeURIComponent(query)}&spaceId=${spaceId}&projectId=${projectId}&topK=5`
      )
    );
    const { chunks } = await resp.json() as { chunks: KnowledgeChunk[] };
    <span class="cm">// Filter out low-relevance chunks (score &lt; 0.7 usually means the knowledge isn't related)</span>
    return chunks.filter(c =&gt; c.score &gt; 0.7);
  } catch {
    <span class="cm">// Knowledge search failure is non-fatal — agent can still run without it</span>
    return [];
  }
}</code></pre>
  </div>

