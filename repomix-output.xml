          <h3>White-Label Portal Architecture</h3>

          <pre><code>// ─── naelao-router Worker ────────────────────────────────────────────────────
// File: workers/naelao-router/src/index.ts
// Sits in front of ALL product deployments. Every request to any Naelao-hosted
// product passes through this Worker before reaching the product frontend.

export default {
  async fetch(request: Request, env: Env): Promise&lt;Response&gt; {
    const hostname = request.headers.get('Host') ?? new URL(request.url).hostname;

    // 1. Resolve productId from hostname via KV
    // Key format: 'domain:{hostname}' → value: productId
    const productId = await env.DOMAIN_REGISTRY_KV.get(`domain:${hostname}`);
    if (!productId) return new Response('Not found', { status: 404 });

    // 2. Fetch product config from KV cache (TTL: 60 seconds)
    let productConfig = await env.PRODUCT_CONFIG_KV.get(`product-config:${productId}`, 'json');
    if (!productConfig) {
      const resp = await env.NAELAO_INTERNAL.fetch(`http://internal/products/${productId}/config`);
      productConfig = await resp.json();
      await env.PRODUCT_CONFIG_KV.put(`product-config:${productId}`, JSON.stringify(productConfig), { expirationTtl: 60 });
    }

    // 3. Inject product context into request headers (consumed by product frontend Worker)
    // NEVER pass the full product config — only the fields the frontend needs.
    // Other products' configs must never leak through shared headers.
    const augmentedRequest = new Request(request, {
      headers: {
        ...Object.fromEntries(request.headers.entries()),
        'X-Naelao-Product-Id': productId,
        'X-Naelao-Brand-Color': (productConfig as any).brandColor,
        'X-Naelao-Branding-Suppressed': (productConfig as any).suppressNaelaoBranding ? '1' : '0',
        'X-Naelao-Auth-Provider': (productConfig as any).authProvider,
        'X-Naelao-Feature-Flags': JSON.stringify((productConfig as any).featureFlags),
      }
    });

    // 4. Proxy to the product's CF Pages deployment (one Pages project per product)
    return env.PRODUCT_FRONTEND.fetch(augmentedRequest);
  }
}

// ─── getProductConfig() — server-side only ────────────────────────────────────
// File: apps/product-shell/src/lib/getProductConfig.ts
// Called in server components / getServerSideProps. Reads from request headers.
// NEVER called client-side. NEVER exposes other products' configs.
export function getProductConfig(request: Request): ProductConfig {
  const headers = request.headers;
  const productId = headers.get('X-Naelao-Product-Id');
  if (!productId) throw new Error('Missing product context — not routed through naelao-router');
  return {
    productId,
    brandColor: headers.get('X-Naelao-Brand-Color') ?? '#3B82F6',
    brandingSuppressed: headers.get('X-Naelao-Branding-Suppressed') === '1',
    authProvider: headers.get('X-Naelao-Auth-Provider') as ProductAuthProvider,
    featureFlags: JSON.parse(headers.get('X-Naelao-Feature-Flags') ?? '{}'),
  };
}</code></pre>

          <div class="box box-bl">
            <div class="box-lbl">CF Pages Deployment Strategy — One Project Per Product</div>
            <p>Each NaelaoProduct gets its own CF Pages project. The alternative — a single multi-tenant Pages project
              with runtime config injection — is rejected because: (1) a deployment bug in one product would affect all
              products, (2) CF Pages rollback is per-project, (3) builders may want different framework versions for
              their products, (4) CF Pages project isolation maps cleanly to the product isolation model. When a builder
              creates a new product, the Builder Dashboard API triggers a CF Pages project creation via the CF API,
              deploys the base product shell template, and links the custom domain. This is automated — the builder
              never touches CF dashboards directly.</p>
          </div>

          <h4>NAELAO_BRANDING_SUPPRESSED — What It Gates and What It Cannot Gate</h4>
          <p>When <code>suppressNaelaoBranding = true</code>, the following are removed: "Powered by Naelao" footer
            text, any Naelao logo marks, the Naelao help center link, and Naelao's product name in auth emails. The
            following are NEVER removed: legal terms of service attribution if required by the builder's plan tier, the
            Naelao data processing agreement reference in privacy policy boilerplate, and security contact information
            required by law. A builder cannot suppress legal disclosures. If they attempt to do so via CSS or custom
            code injection, the CF Worker layer enforces the disclosure text at the response level before it reaches the
            browser.</p>

          <h4>SSL Certificate Provisioning for Custom Domains</h4>
          <p>Custom domain SSL is handled via Cloudflare SSL for SaaS. When a builder POSTs to
            <code>/builder/products/{productId}/domain</code>, the Worker calls the CF API to add a custom hostname to
            the Naelao zone. CF issues the certificate automatically via Let's Encrypt. The builder verifies domain
            ownership by adding a DNS TXT record. Verification is polled every 60 seconds by the
            <code>naelao-domain-verifier</code> Cron Worker, which updates
            <code>products.custom_domain_verified = true</code> and writes the productId to
            <code>DOMAIN_REGISTRY_KV</code> once verified. The entire flow takes under 5 minutes for domains with
            standard TTLs.</p>

