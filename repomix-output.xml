```typescript
async detectSkillConflicts(skills: Skill[]): Promise&lt;Conflict[]&gt; {
  // Use a lightweight LLM call to detect instruction conflicts
  const conflicts = await this.llm([{
    role: 'system',
    content: 'Identify conflicting instructions in this skill set. Output JSON: [{skill1, skill2, conflict_description}]'
  }, {
    role: 'user',
    content: skills.map(s =&gt; `${s.id} (Tier ${s.tier}): ${s.instructions}`).join('\n---\n')
  }]);
  return JSON.parse(conflicts);
}

async buildSystemPrompt(skills: Skill[]): Promise&lt;string&gt; {
  const conflicts = await this.detectSkillConflicts(skills);
  if (conflicts.length &gt; 0) {
    // Log to Analytics Engine for admin review
    this.env.ANALYTICS.writeDataPoint({
      blobs: [JSON.stringify(conflicts), this.spaceId],
      indexes: ['skill_conflict']
    });
  }
  // Apply tier precedence explicitly in prompt
  return buildPromptWithPrecedenceComments(skills, conflicts);
}
```
