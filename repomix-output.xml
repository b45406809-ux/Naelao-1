        <div class="nav-item" id="nav-agents" onclick="showPage('agents')" style="padding-left:24px"><svg viewBox="0 0 16 16" fill="none" stroke-width="1.5" stroke="currentColor"><rect x="3" y="3" width="10" height="10" rx="2"/><circle cx="6" cy="7" r="1"/><circle cx="10" cy="7" r="1"/><path d="M6 10C6 10 7 11 10 10"/></svg><span class="sidebar-text">Agents</span></div>
        <div class="nav-item" id="nav-knowledge" onclick="showPage('knowledge')" style="padding-left:24px"><svg viewBox="0 0 16 16" fill="none" stroke-width="1.5" stroke="currentColor"><path d="M3 3H9L13 7V13H3V3Z"/><polyline points="9,3 9,7 13,7"/></svg><span class="sidebar-text">Knowledge</span></div>
        <div class="nav-item" id="nav-marketplace" onclick="showPage('marketplace')" style="padding-left:24px"><svg viewBox="0 0 16 16" fill="none" stroke-width="1.5" stroke="currentColor"><path d="M2 2H4L5.5 10H12.5L14 4H5"/><circle cx="7" cy="13" r="1"/><circle cx="11.5" cy="13" r="1"/></svg><span class="sidebar-text">Marketplace</span></div>
        <div class="nav-item" id="nav-workflows" onclick="showPage('workflows')" style="padding-left:24px"><svg viewBox="0 0 16 16" fill="none" stroke-width="1.5" stroke="currentColor"><circle cx="3" cy="4" r="1.5"/><circle cx="13" cy="4" r="1.5"/><circle cx="3" cy="12" r="1.5"/><circle cx="13" cy="12" r="1.5"/><line x1="4.5" y1="4" x2="11.5" y2="4"/><line x1="3" y1="5.5" x2="3" y2="10.5"/><line x1="4.5" y1="12" x2="11.5" y2="12"/></svg><span class="sidebar-text">Workflows</span></div>
        <div class="nav-item" id="nav-analytics" onclick="showPage('analytics')" style="padding-left:24px"><svg viewBox="0 0 16 16" fill="none" stroke-width="1.5" stroke="currentColor"><rect x="2" y="10" width="3" height="4"/><rect x="6.5" y="6" width="3" height="8"/><rect x="11" y="2" width="3" height="12"/></svg><span class="sidebar-text">Analytics</span></div>
