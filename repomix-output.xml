<file path="apps/shell/src/components/ApprovedActionsEditor.tsx">
"use client";

// A small add/remove editor for an approval policy's `auto_approved_actions` list — shared by the
// Dashboard's space-wide Configuration panel and the per-agent policy editor (AgentPolicyPanel),
// so "which tools never need to ask" is editable in both places rather than only a read-only list
// with no way to change it short of clicking "Always allow" on a live approval card.
//
// Live-reported gap: this used to be a free-text field with a single example placeholder, so the
// only way to discover what could BE approved was to guess a name or wait for a real approval card
// to teach you one. `catalogue` (built from GET .../assistant/capabilities, the same data the
// Skills tab already reads) makes every operation the agent could ever call browsable here —
// grouped by the prebuilt script that owns it, with that script's own description, so a bare name
// like "thread.send_message" reads as "the thing that lets me chat inside an existing thread"
// rather than an opaque string you'd have to already know to type.

import * as React from "react";

export interface OperationGroup {
  script: string;
  description: string;
  operations: string[];
}

export function ApprovedActionsEditor({
  actions,
  canEdit,
  busy,
  onAdd,
  onRemove,
  catalogue,
}: {
  actions: string[];
  canEdit: boolean;
  busy: boolean;
  onAdd: (action: string) => void;
  onRemove: (action: string) => void;
  /** Every operation the agent could call, grouped by owning script — lets someone browse and
   *  add rather than only type a name they already know. Omitted/undefined where no capabilities
   *  fetch is wired, or while it's still loading (falls back to the plain free-text field only). */
  catalogue?: OperationGroup[] | undefined;
}) {
  const [draft, setDraft] = React.useState("");
  const [browsing, setBrowsing] = React.useState(false);

  function submit() {
    const trimmed = draft.trim();
    if (!trimmed || actions.includes(trimmed)) return;
    onAdd(trimmed);
    setDraft("");
  }

  const approvedSet = React.useMemo(() => new Set(actions), [actions]);
  const totalOps = React.useMemo(() => (catalogue ?? []).reduce((n, g) => n + g.operations.length, 0), [catalogue]);

  return (
    <div>
      {actions.length === 0 ? (
        <div style={{ color: "var(--text3)", fontSize: 12 }}>Every action is confirmed before it happens.</div>
      ) : (
        <div style={{ display: "flex", flexWrap: "wrap", gap: 6, marginTop: 6 }}>
          {actions.map((a) => (
            <span
              key={a}
              style={{
                display: "inline-flex", alignItems: "center", gap: 5, fontSize: 11, fontFamily: "monospace",
                background: "var(--surface2)", border: "1px solid var(--border)", borderRadius: 999,
                padding: "2px 4px 2px 8px",
              }}
            >
              {a}
              {canEdit && (
                <button
                  type="button"
                  onClick={() => onRemove(a)}
                  disabled={busy}
                  title={`Stop auto-approving ${a}`}
                  style={{
                    border: "none", background: "transparent", color: "var(--text3)", cursor: "pointer",
                    fontSize: 13, lineHeight: 1, padding: "0 4px",
                  }}
                >
                  ×
                </button>
              )}
            </span>
          ))}
        </div>
      )}
      {canEdit && (
        <div style={{ display: "flex", gap: 6, marginTop: 8 }}>
          <input
            className="form-input"
            placeholder="e.g. web-search.search"
            value={draft}
            onChange={(e) => setDraft(e.target.value)}
            onKeyDown={(e) => {
              if (e.key === "Enter") {
                e.preventDefault();
                submit();
              }
            }}
            disabled={busy}
            style={{ flex: 1, fontSize: 11.5, fontFamily: "monospace" }}
          />
          <button type="button" className="btn btn-ghost btn-sm" onClick={submit} disabled={busy || !draft.trim()}>
            Add
          </button>
        </div>
      )}
      {canEdit && catalogue && catalogue.length > 0 && (
        <div style={{ marginTop: 8 }}>
          <button
            type="button"
            onClick={() => setBrowsing((v) => !v)}
            style={{
              background: "transparent", border: "none", color: "var(--accent)", cursor: "pointer",
              fontSize: 11.5, padding: 0,
            }}
          >
            {browsing ? "Hide" : `Browse all ${totalOps} available tools`}
          </button>
          {browsing && (
            <div style={{ marginTop: 6, maxHeight: 260, overflowY: "auto", border: "1px solid var(--border)", borderRadius: 8 }}>
              {catalogue.map((group) => (
                <div key={group.script} style={{ padding: "6px 8px", borderBottom: "1px solid var(--border)" }}>
                  <div style={{ fontSize: 11.5, fontWeight: 600, color: "var(--text)" }}>{group.script}</div>
                  <div style={{ fontSize: 10.5, color: "var(--text3)", lineHeight: 1.4, marginBottom: 4 }}>{group.description}</div>
                  <div style={{ display: "flex", flexWrap: "wrap", gap: 5 }}>
                    {group.operations.map((op) => {
                      const already = approvedSet.has(op);
                      return (
                        <button
                          key={op}
                          type="button"
                          disabled={busy || already}
                          onClick={() => onAdd(op)}
                          title={already ? "Already pre-approved" : `Pre-approve ${op}`}
                          style={{
                            fontSize: 10.5, fontFamily: "monospace", padding: "2px 7px", borderRadius: 999,
                            border: "1px solid var(--border)",
                            background: already ? "var(--surface2)" : "transparent",
                            color: already ? "var(--text3)" : "var(--text2)",
                            cursor: already ? "default" : "pointer",
                          }}
                        >
                          {already ? "✓ " : "+ "}{op}
                        </button>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      )}
    </div>
  );
}
</file>

<file path="apps/shell/src/components/AssistantDelegationCard.tsx">
"use client";

// The business assistant speaking INTO a project thread on the owner's behalf, plus whichever
// agent replied — rendered as ONE collapsible card rather than two adjacent left-aligned bubbles.
//
// Why: `thread.send_message` writes the assistant's turn and the target agent writes its own reply
// into the same transcript, so without grouping the thread reads as one speaker asking a question
// and then answering it. Worse, nothing distinguished the BUSINESS ASSISTANT (acting autonomously
// for the owner) from the project agent that actually does the work — which is exactly the
// distinction a person scanning the thread needs.
//
// Collapsed shows only who asked whom. Expanded shows the assistant's message and the reply.
// Deliberately the same visual language as the consult-subthread card (SubthreadEntry) — both are
// "a real exchange that happened alongside this conversation", just one visible and one private.

import * as React from "react";
import { Markdown } from "./Markdown";
import type { Message } from "@/lib/api";

function agentDisplayName(id?: string | null): string {
  if (!id) return "a project agent";
  return id
    .replace(/^launchpad-/, "")
    .replace(/-v\d+$/, "")
    .replace(/[-_]/g, " ")
    .replace(/\b\w/g, (ch) => ch.toUpperCase());
}

export function AssistantDelegationCard({
  request,
  reply,
}: {
  /** The assistant's own message (the one carrying metadata.assistant_delegation). */
  request: Message;
  /** The agent's reply, when it has arrived. Absent while still running, or for respond:false. */
  reply?: Message | undefined;
}) {
  const [open, setOpen] = React.useState(false);
  const delegation = request.metadata?.assistant_delegation;
  const who = agentDisplayName(delegation?.agent_id);
  const awaiting = delegation?.awaiting_reply !== false && !reply;

  // Inline styles rather than classes, matching SubthreadEntry (the consult card) exactly — the
  // two are siblings and should read as the same kind of object.
  return (
    <div style={{ border: "1px solid var(--border, #e5e7eb)", borderRadius: 8, margin: "6px 0 10px", overflow: "hidden" }}>
      <button
        type="button"
        onClick={() => setOpen((v) => !v)}
        aria-expanded={open}
        style={{
          display: "flex", alignItems: "center", gap: 8, width: "100%",
          padding: "8px 10px", background: "transparent", border: "none",
          cursor: "pointer", textAlign: "left", fontSize: 12, color: "var(--text2, #555)",
        }}
      >
        <span style={{ color: "var(--text3)" }} aria-hidden>{open ? "−" : "+"}</span>
        <span style={{ fontWeight: 600 }}>Business assistant → {who}</span>
        <span style={{ marginLeft: "auto", color: "var(--text3)" }}>
          {awaiting ? "waiting for a reply" : open ? "hide" : "show exchange"}
        </span>
      </button>
      {open && (
        <div style={{ padding: "0 10px 10px", fontSize: 12 }}>
          <div style={{ marginBottom: 10 }}>
            <div style={{ fontWeight: 600, color: "var(--text3)", marginBottom: 2 }}>
              Business assistant · on your behalf
            </div>
            <Markdown text={request.content} />
          </div>
          {reply ? (
            <div>
              <div style={{ fontWeight: 600, color: "var(--text3)", marginBottom: 2 }}>{who}</div>
              <Markdown text={reply.content} />
            </div>
          ) : (
            <div style={{ color: "var(--text3)", fontStyle: "italic" }}>
              {delegation?.awaiting_reply === false
                ? "Posted without asking for a reply."
                : "No reply yet."}
            </div>
          )}
        </div>
      )}
    </div>
  );
}

/**
 * Groups a transcript so an assistant-delegation message swallows the agent reply that follows it.
 *
 * Returns render instructions rather than mutating the list: each entry is either an ordinary
 * message or a delegation pair, so the caller keeps full control of bubble rendering for
 * everything else.
 */
export type RenderItem =
  | { kind: "message"; message: Message }
  | { kind: "delegation"; request: Message; reply?: Message };

export function groupDelegations(messages: Message[]): RenderItem[] {
  const out: RenderItem[] = [];
  for (let i = 0; i < messages.length; i++) {
    const m = messages[i]!;
    const delegation = m.metadata?.assistant_delegation;
    if (!delegation) {
      out.push({ kind: "message", message: m });
      continue;
    }
    // The reply is the next message, but only when it's genuinely the delegated agent answering
    // — not a person who typed in the meantime, and not another delegation. Anything else stays
    // its own bubble, so a card can never swallow an unrelated turn.
    const next = messages[i + 1];
    const isReply =
      !!next &&
      next.role === "assistant" &&
      !next.metadata?.assistant_delegation &&
      (!delegation.agent_id || !next.author_id || next.author_id === delegation.agent_id);
    if (isReply) {
      out.push({ kind: "delegation", request: m, reply: next });
      i++; // consumed
    } else {
      out.push({ kind: "delegation", request: m });
    }
  }
  return out;
}
