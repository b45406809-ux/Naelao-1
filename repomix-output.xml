      border-right: 1px solid var(--brd);
      white-space: nowrap;
      transition: color .15s, background .15s;
    }

    .navl:hover {
      color: var(--or);
      background: rgba(232, 105, 42, .05);
    }

    /* ─── HERO ────────────────────────────────────── */
    .hero {
      padding: 80px 0 60px;
      border-bottom: 1px solid var(--brd);
      margin-bottom: 64px;
