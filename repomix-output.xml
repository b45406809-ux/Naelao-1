    <!-- ══════════════════════════════════════════════════════
     §61 — SPACE TYPE ARCHITECTURE REWRITE (A1-A3)
═══════════════════════════════════════════════════════ -->
    <div class="sep"></div>
    <div class="sec" id="space-type-architecture">
      <span class="sec-ey">61 — Space Type Architecture</span>
      <h2>Space Types — Platform Instances, Not Configuration</h2>
      <div class="bar"></div>
      <p class="lead">The original Naelao design treated Space Types as configuration bundles — a manifest that installs
        default agents and skills. This is wrong. A Space Type is a <strong>platform definition</strong>. When a user
        creates a space and selects a type, they are spinning up an instance of a specific platform with its own agent
        architecture, execution environment, UI, backend systems, and permissions model. This section is the
        authoritative rewrite.</p>

      <div class="pull">"Naelao is the operating system. Space Types are the applications that run on it. A Standard
        space and a Launchpad space are as different from each other as a terminal and a spreadsheet app."</div>

      <h3>The Three Layers of Every Space Type</h3>
      <div class="g3">
        <div class="card">
          <div class="card-lbl">Layer 1 — Most Important</div>
          <div class="card-title">Agent Environment</div>
          <p>Defines how agents <em>work</em> inside this space type. Which execution tier is default. Container idle
            timeout. Always-loaded skills. Disabled skills. Agent loop model (chat loop, file-edit loop, knowledge-graph
            loop, task-completion loop). What the agent can access and what it cannot.</p>
          <p>A Cursor-like type: warm container always, file-edit loop. A CoWork-like type: no container,
            task-completion loop. An Excel-like type: spreadsheet engine, no bash. A Verticals type: knowledge-graph
            loop, long context, restricted network.</p>
        </div>
        <div class="card bl">
          <div class="card-lbl">Layer 2</div>
          <div class="card-title">Backend Infrastructure</div>
          <p>Which platform DOs are instantiated (WalletDO, MiniAGIDO, etc.), which custom DOs the space type brings,
            which Dynamic Workflows are registered, which cron jobs run, what SpaceDO schema version each product is on.</p>
          <p>Verticals: AutoResearchDO running nightly, KnowledgeGraphDO, benchmark system, fine-tuning pipeline.
            Standard: none of that. Idle cost for both is near zero — backend systems cost only when active.</p>
        </div>
        <div class="card gr">
          <div class="card-lbl">Layer 3</div>
          <div class="card-title">UI — Two Surfaces</div>
          <p><strong>Operator console</strong> at <span class="ic">naelao.app/spaces/{id}</span> — always Naelao-branded
            back-office. Apps inject panels into shell slots. Space type manifest defines sidebar, dashboard, hidden nav
            items.</p>
          <p><strong>External portal</strong> at <span class="ic">{slug}.naelao.com</span> — public-facing, zero Naelao
            chrome, custom domain support. Only for types with a public face (Launchpad storefront, Sites website,
            Workers marketplace, Verticals client portal).</p>
        </div>
      </div>

      <h3>Space Type Manifest v2 — Complete Interface</h3>
      <p>The old manifest was thin. This is the complete manifest that captures all three layers.</p>
      <pre><code><span class="cm">// types/space-type-manifest-v2.ts
// Every space type — platform or community — must implement this interface.
// The platform reads this manifest to provision, operate, and deprovision a space instance.</span>

export interface NaelaoSpaceTypeManifestV2 {
  <span class="cm">// ── Identity ─────────────────────────────────────────</span>
  id:          string;          <span class="cm">// e.g. 'launchpad', 'verticals', 'com.creator.my-type'</span>
  name:        string;
  description: string;
  version:     string;          <span class="cm">// semver. Minor = auto-upgrade. Major = opt-in migration.</span>
  author:      'naelao' | string; <span class="cm">// userId for community types</span>
  icon:        string;          <span class="cm">// URL to 128x128 icon</span>
  tags:        string[];        <span class="cm">// for marketplace search</span>

  <span class="cm">// ── Layer 1: Agent Environment ────────────────────────</span>
  agentEnvironment: {
    defaultExecutionTier: 'workspace' | 'isolate' | 'browser' | 'sandbox';
    containerIdleTimeoutMs: number;   <span class="cm">// 0 = no container. -1 = never idle (always warm).</span>
    loopModel: AgentLoopModel;
    alwaysLoadedSkills: string[];     <span class="cm">// skill IDs always in context, regardless of user config</span>
    disabledSkills:     string[];     <span class="cm">// skills agents in this type CANNOT use</span>
    networkPolicy: 'open' | 'restricted' | 'none';
    networkAllowlist?: string[];      <span class="cm">// if restricted: only these domains allowed</span>
    memorySchemaOverride?: JSONSchema; <span class="cm">// override agent_memory schema for this type</span>
    maxContextTokens:  number;        <span class="cm">// context window limit for this type</span>
    agentPermissions:  string[];      <span class="cm">// e.g. ['wallet_spend', 'external_deploy', 'read_cross_space']</span>
    <span class="cm">// Note: customLoopWorker (RemoteLoop) is reserved for Naelao platform types only.</span>
    <span class="cm">// Community developers requiring custom agent reasoning should use the Apps SDK</span>
    <span class="cm">// and publish an App with a custom MCP server instead.</span>
  };

  <span class="cm">// ── Layer 2: Backend Infrastructure ──────────────────</span>
  backend: {
    platformDOs: PlatformDOConfig[];      <span class="cm">// which platform DOs to instantiate on provision</span>
    spaceDoInitHook?: string;             <span class="cm">// optional SpaceDO.initSpaceType() hook name for this space type</span>
    workflowTemplates: WorkflowTemplate[];
    cronJobs: CronJobDeclaration[];       <span class="cm">// declared cron work that runs for this type</span>
    r2Prefixes: string[];                 <span class="cm">// which R2 sub-prefixes to initialize on provision</span>
    resourceBudget: ResourceBudget;       <span class="cm">// REQUIRED — defines per-instance compute limits</span>
  };

  <span class="cm">// ── Layer 3: UI ───────────────────────────────────────</span>
  ui: {
    operatorShell: {
      sidebarItems:    SidebarItem[];     <span class="cm">// what shows in the left nav</span>
      dashboardWidgets:string[];          <span class="cm">// app IDs that inject dashboard widgets</span>
      hiddenCoreItems: string[];          <span class="cm">// hide default Naelao nav: 'threads'|'projects'|'marketplace'</span>
      defaultView:     string;            <span class="cm">// which sidebar item opens by default</span>
      theme?:          ThemeConfig;
    };
    externalPortal?: {
      enabled:      boolean;
      deploymentType: 'cf-pages' | 'dynamic-worker';
      templateId:   string;              <span class="cm">// which portal template to use</span>
      defaultSlug:  string;              <span class="cm">// {defaultSlug}.naelao.com</span>
      customDomain: boolean;             <span class="cm">// allow custom domain configuration</span>
      authModel:    'public' | 'customer-auth' | 'gated';
    };
  };

  <span class="cm">// ── Provisioning Lifecycle ────────────────────────────</span>
  lifecycle: {
    provisionerWorker?:   string;        <span class="cm">// URL called after platform provisioning, for custom setup</span>
    deprovisionerWorker?: string;        <span class="cm">// URL called before platform deprovisioning</span>
    migratorWorker?:      string;        <span class="cm">// required if version is a major bump</span>
    healthCheckUrl?:      string;        <span class="cm">// platform polls this to verify instance health</span>
  };

  <span class="cm">// ── Marketplace & Economics ───────────────────────────</span>
  marketplace: {
    visible:          boolean;
    minimumNaelaoPlan:'free'|'maker'|'pro'|'team'|'enterprise';
    priceUsdPerMonth: number;            <span class="cm">// 0 = free. Creator gets 80% of this.</span>
    trialDays:        number;
    capabilities:     string[];          <span class="cm">// declared capabilities for user review before install</span>
  };
}

<span class="cm">// Agent loop models — defines how the agent processes each turn</span>
export type AgentLoopModel =
  | 'chat'           <span class="cm">// default: user message → LLM → tool calls → response</span>
  | 'file-edit'      <span class="cm">// cursor-like: user intent → read files → edit files → verify → respond</span>
  | 'knowledge-graph'<span class="cm">// verticals: query → graph traversal → verify → respond</span>
  | 'task-completion'<span class="cm">// cowork-like: task assigned → decompose → execute → deliver</span>
  | 'content'        <span class="cm">// sites: research → draft → review → publish</span>
  | 'remote'         <span class="cm">// custom: delegate to customLoopWorker</span>
  ;

export interface ResourceBudget {
  maxDOsPerInstance:       number;   <span class="cm">// how many custom DOs this type creates per space</span>
  maxR2WritesPerDay:       number;
  maxContainerHoursPerDay: number;
  maxLLMTokensPerDay:      number;
  maxCronJobsPerInstance:  number;
  maxWorkflowsPerInstance: number;
}</code></pre>

