ALTER TABLE finetune_jobs ADD COLUMN attempt_count INTEGER DEFAULT 0;
ALTER TABLE finetune_jobs ADD COLUMN metrics TEXT;            -- JSON: { loss, accuracy }
ALTER TABLE finetune_jobs ADD COLUMN estimated_completion_at INTEGER;
ALTER TABLE finetune_jobs ADD COLUMN cost_micro_cents INTEGER DEFAULT 0;
-- And enforce valid states (recreate with CHECK if not present):
