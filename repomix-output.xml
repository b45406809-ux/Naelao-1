                  right={m.category}
                />
              ))}
            </div>
          )}
        </Panel>

        <Panel title="Scheduled work" count={crons.length}>
          {crons.length === 0 ? (
            <Empty>Nothing scheduled. Ask the assistant to do something on a recurring basis and it will appear here.</Empty>
