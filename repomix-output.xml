function closeFileEditor(){
  document.getElementById('file-editor-overlay').style.display='none';
}

// ── CHAT INPUT ──
function autoResize(el){el.style.height='auto';el.style.height=Math.min(el.scrollHeight,160)+'px'}
function handleKey(e,inputId){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();inputId==='home-input'?sendFromHome():sendMessage();}}
function insertPrompt(txt){document.getElementById('home-input').value=txt+' ';document.getElementById('home-input').focus();}
function scrollToBottom(){
  const ca=document.getElementById('chat-area');
  if(ca){ca.scrollTop=ca.scrollHeight;}
  document.getElementById('scroll-down')?.classList.remove('visible');
}

// Show "scroll down" button when user scrolls up in chat
document.addEventListener('DOMContentLoaded',()=>{
  const ca=document.getElementById('chat-area');
  if(ca){
    ca.addEventListener('scroll',()=>{
      const btn=document.getElementById('scroll-down');
      if(!btn)return;
      const distFromBottom=ca.scrollHeight-ca.scrollTop-ca.clientHeight;
      btn.classList.toggle('visible',distFromBottom>120);
    });
  }
});

function sendFromHome(){
  const inp=document.getElementById('home-input');
  const txt=inp.value.trim();
  if(!txt)return;
  showPage('chat');
  document.getElementById('chat-title-text').textContent=txt.slice(0,40)+(txt.length>40?'…':'');
  const tp=document.getElementById('thread-panel');
  tp.classList.remove('hidden');
  threadPanelOpen=true;
  document.getElementById('messages').innerHTML='';
  appendMsg(txt,true);
  inp.value='';autoResize(inp);
  simulateAIReply();
}

function sendMessage(){
  const inp=document.getElementById('chat-input');
  const txt=inp.value.trim();
  if(!txt)return;
  appendMsg(txt,true);
  inp.value='';inp.style.height='auto';
  simulateAIReply();
}

function sendAssistantMsg(){
  const inp=document.getElementById('assistant-input');
  const txt=inp.value.trim();
  if(!txt)return;
  const msgs=document.getElementById('assistant-messages');
  const row=document.createElement('div');
  row.className='msg-row user';row.innerHTML=`<div class="bubble user">${txt}</div>`;
  msgs.appendChild(row);msgs.scrollTop=msgs.scrollHeight;
  inp.value='';autoResize(inp);
  setTimeout(()=>{
    const r=document.createElement('div');r.className='msg-row';
    r.innerHTML=`<div class="ai-icon"><svg viewBox="0 0 16 16"><path d="M8 1L14 4.5V11.5L8 15L2 11.5V4.5L8 1Z" fill="var(--bg)"/></svg></div><div style="flex:1"><div class="bubble">I understand. Let me look into that for you and take action shortly.</div></div>`;
    msgs.appendChild(r);msgs.scrollTop=msgs.scrollHeight;
  },900);
}

function appendMsg(txt,isUser){
  const msgs=document.getElementById('messages');
  const row=document.createElement('div');
  row.className='msg-row'+(isUser?' user':'');
  if(isUser){row.innerHTML=`<div class="bubble user">${txt}</div>`;}
  else{row.innerHTML=`<div class="ai-icon"><svg viewBox="0 0 16 16" fill="var(--bg)"><path d="M8 1L14 4.5V11.5L8 15L2 11.5V4.5L8 1Z"/></svg></div><div style="flex:1"><div class="bubble">${txt}</div></div>`;}
  msgs.appendChild(row);scrollToBottom();
}

let aiReplies=['I understand your request. Let me work on that for you.','That\'s a great question! Here\'s what I found…','I\'ve analyzed the information and here are my thoughts:','Working on it! I\'ll break this down step by step.'];
let replyIdx=0;
function simulateAIReply(){
  const msgs=document.getElementById('messages');
  const typing=document.createElement('div');
  typing.className='msg-row';typing.innerHTML='<div class="ai-icon"><svg viewBox="0 0 16 16" fill="var(--bg)"><path d="M8 1L14 4.5V11.5L8 15L2 11.5V4.5L8 1Z"/></svg></div><div style="flex:1"><div class="bubble"><div class="typing-indicator"><div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div></div></div></div>';
  msgs.appendChild(typing);scrollToBottom();
  setTimeout(()=>{
    typing.remove();
    appendMsg(aiReplies[replyIdx%aiReplies.length],false);
    replyIdx++;
  },1200);
}

// ── THEME ──
function toggleThemeQuick(){
  const isDark=document.documentElement.dataset.theme==='dark';
  currentTheme=isDark?'light':'dark';
  applyTheme(currentTheme);
}
function selectTheme(t){pendingTheme=t;updateThemeSelection();}
function applyTheme(t){document.documentElement.dataset.theme=t;}
function updateThemeSelection(){
  ['sys','light','dark'].forEach(t=>document.getElementById('theme-'+t)?.classList.remove('selected'));
  const map={light:'theme-light',dark:'theme-dark',system:'theme-sys'};
  document.getElementById(map[currentTheme]||'theme-light')?.classList.add('selected');
}

// ── MODAL ──
function openModal(){
  document.getElementById('modal-overlay').classList.add('open');
  pendingTheme=currentTheme;pendingBg=currentBg;pendingBgEnabled=bgEnabled;
  updateThemeSelection();
  document.getElementById('bg-toggle').classList.toggle('on',bgEnabled);
  document.getElementById('bg-toggle2').classList.toggle('on',bgEnabled);
