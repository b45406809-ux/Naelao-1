      <span class="sec-ey">79 — Worker Deep Dive: naelao-notifications</span>
      <h2>naelao-notifications — Omnichannel Alerting & VAPI</h2>
      <div class="bar"></div>
      <p class="lead">The <code>naelao-notifications</code> Worker is a pure Queue Consumer. It handles asynchronous
        delivery of alerts, digests, and approval requests across all supported channels. By offloading this to a queue,
        the AgentDO never blocks waiting for an SMTP server or APNs gateway to respond.</p>

      <h3>Supported Channels & Integrations</h3>
      <table class="t">
        <thead>
          <tr>
            <th>Channel</th>
            <th>Provider</th>
            <th>Primary Use Case</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="tl"><strong>Email</strong></td>
            <td>Resend API</td>
            <td>Daily analytics digests, billing invoices, offline alerts.</td>
          </tr>
          <tr>
            <td class="tl"><strong>Push (Mobile)</strong></td>
            <td>FCM / APNs</td>
            <td>Real-time <code>waitForApproval()</code> human-in-the-loop requests.</td>
          </tr>
          <tr>
            <td class="tl"><strong>Chat</strong></td>
            <td>Slack / Discord Webhooks</td>
            <td>Space Assistant updates, CI/CD deployment alerts.</td>
          </tr>
          <tr>
            <td class="tl"><strong>Voice (New)</strong></td>
            <td>VAPI (Voice AI)</td>
            <td>Critical escalations (e.g., Server down, massive Stripe refund request). Agent physically calls the
              Space Admin.</td>
          </tr>
        </tbody>
      </table>

      <h3>Complete Implementation</h3>
      <pre><code><span class="cm">// workers/notifications/index.ts
// Queue consumer for `naelao-notifications`</span>

export default {
  async queue(batch: MessageBatch&lt;NotificationPayload&gt;, env: Env) {
    <span class="cm">// Process messages concurrently, but catch errors to prevent the whole batch from failing</span>
    await Promise.allSettled(
      batch.messages.map(async (msg) =&gt; {
        try {
          await processNotification(msg.body, env);
          msg.ack();
        } catch (error) {
          console.error(`Notification failed: ${msg.id}`, error);
          msg.retry(); <span class="cm">// Will retry up to max_retries before going to DLQ</span>
        }
      })
    );
  }
};

async function processNotification(payload: NotificationPayload, env: Env) {
  <span class="cm">// 1. Idempotency Check</span>
  <span class="cm">// Prevent double-sending emails if CF Queues delivers the message twice (at-least-once delivery)</span>
  const idempotencyKey = `notif_lock:${payload.id}`;
  const alreadySent = await env.NAELAO_CONFIG_KV.get(idempotencyKey);
  if (alreadySent) return;

  const deliveries: Promise&lt;any&gt;[] = [];

  <span class="cm">// 2. Route to requested channels</span>
  if (payload.channels.includes('email')) {
    deliveries.push(sendEmail(payload, env));
  }
  
  if (payload.channels.includes('push')) {
    deliveries.push(sendPushNotification(payload, env));
  }

  if (payload.channels.includes('voice') && payload.priority === 'critical') {
    deliveries.push(triggerVapiCall(payload, env));
  }

  <span class="cm">// Wait for all requested deliveries</span>
  await Promise.all(deliveries);

  <span class="cm">// Lock for 24 hours to ensure idempotency</span>
  await env.NAELAO_CONFIG_KV.put(idempotencyKey, 'sent', { expirationTtl: 86400 });

  <span class="cm">// Log success to Analytics Engine</span>
  await env.NAELAO_ANALYTICS_QUEUE.send({
    type: 'notification_sent',
    spaceId: payload.spaceId,
    channels: payload.channels,
    timestamp: Date.now()
  });
}

<span class="cm">// ── VAPI Integration (Voice AI Escalation) ──</span>
<span class="cm">// If a Launchpad storefront agent gets a $10,000 refund request, it can trigger a voice call</span>
<span class="cm">// to the store owner's cell phone to wake them up and ask for verbal approval.</span>

async function triggerVapiCall(payload: NotificationPayload, env: Env) {
  <span class="cm">// Fetch the user's phone number from SpaceDO SQLite</span>
  const spaceDO = getProductDO(rootSpaceId, env);  // SpaceDO replaces Hyperdrive
  const user = await db.query('SELECT phone FROM user_profiles WHERE id = $1', [payload.userId]);
  if (!user.rows[0]?.phone) return;

  const response = await fetch('https://api.vapi.ai/call/phone', {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${env.VAPI_API_KEY}`,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      phoneNumberId: env.VAPI_PHONE_NUMBER_ID,
      customer: { number: user.rows[0].phone },
      assistant: {
        firstMessage: `Hello. I am your Naelao Space Assistant. I am calling because there is a critical alert in your workspace: ${payload.message}. Do you want me to approve or reject this action?`,
        model: {
          provider: "anthropic",
          model: "claude-3-haiku-20240307",
          systemPrompt: "You are the user's AI assistant. Keep responses very brief. If they say approve, thank them and end the call. If reject, confirm and end the call."
        }
      }
    })
  });

  if (!response.ok) throw new Error("VAPI call failed");
}</code></pre>
