    localPath: { type: &#x27;string&#x27; },
    r2Path: { type: &#x27;string&#x27; },
  },
  handler: async ({ localPath, r2Path }, env) =&gt; {
    // 1. Read from local machine via tunnel
    const result = await localTunnelDO.execOnLocal({
      tool: &#x27;read_file_local&#x27;,
      params: { path: localPath, encoding: &#x27;base64&#x27; }
    });
    if (result.error) return result;

    // 2. Write to R2 workspace
    const bytes = Uint8Array.from(atob(result.contentBase64), c =&gt; c.charCodeAt(0));
    await env.NAELAO_WORKSPACE.put(`spaces/${spaceId}/workspace/${r2Path}`, bytes);
    return { success: true, r2Path };
  }
}
// Neither tool is in the spec. The local agent and cloud workspace are currently isolated.</code></pre>
