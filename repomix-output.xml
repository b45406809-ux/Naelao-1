<span class="cm">// ── 4. EMERGENCY AGENT KILL SWITCH ──────────────────────────
// Immediately halts all running agents for a space or platform-wide.
// Used during incidents: model hallucination loops, billing runaway, security breach.</span>
app.post('/emergency/kill-agents', async (c) =&gt; {
  const { scope, spaceId, reason } = await c.req.json(); <span class="cm">// scope: 'space' | 'platform'</span>
  const adminEmail = c.get('adminEmail' as any);
  const spaceDO = getProductDO(rootSpaceId, c.env);  // SpaceDO replaces Hyperdrive

  if (scope === 'platform') {
    <span class="cm">// Nuclear option: set a KV flag that every AgentDO checks at the top of its run loop</span>
    await c.env.NAELAO_CONFIG_KV.put('emergency:kill-all-agents', JSON.stringify({
      active: true, reason, triggeredBy: adminEmail, triggeredAt: new Date().toISOString()
    }), { expirationTtl: 3600 }); <span class="cm">// Auto-expire after 1 hr to prevent permanent lockout</span>
    const { rows } = await db.query(
      `UPDATE agent_runs SET status='emergency_halted', completed_at=NOW() WHERE status='running' RETURNING id`
    );
    await c.env.NAELAO_ANALYTICS_QUEUE.send({ type: 'emergency_platform_halt', reason, adminEmail, runsCancelled: rows.length });
    return c.json({ success: true, scope: 'platform', runsCancelled: rows.length, autoExpireAt: new Date(Date.now() + 3600_000).toISOString() });
  }

  if (scope === 'space' &amp;&amp; spaceId) {
    const { rows } = await db.query(
      `UPDATE agent_runs SET status='emergency_halted', completed_at=NOW() WHERE space_id=$1 AND status='running' RETURNING id`,
      [spaceId]
    );
    await c.env.NAELAO_CONFIG_KV.put(`emergency:kill-space:${spaceId}`, JSON.stringify({ active: true, reason, triggeredBy: adminEmail }), { expirationTtl: 3600 });
    return c.json({ success: true, scope: 'space', spaceId, runsCancelled: rows.length });
  }

  return c.json({ error: 'scope must be "platform" or "space" with spaceId' }, 400);
});

app.post('/emergency/clear-kill-switch', async (c) =&gt; {
  const { scope, spaceId } = await c.req.json();
  if (scope === 'platform') {
