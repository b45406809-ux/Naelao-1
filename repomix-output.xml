await env.KV.put(notifId, "1", { expirationTtl: 86400 });

// Critical alerts (billing threshold, security event): 7-day TTL
await env.KV.put(notifId, "1", { expirationTtl: 7 * 86400 });

// Admin resend: provide a force-resend endpoint that deletes the lock
// POST /api/notifications/{notifId}/resend
async function adminResend(notifId: string, env: Env) {
  await env.KV.delete(notifId);
  await env.NAELAO_NOTIFICATIONS_QUEUE.send({ ...originalPayload, notifId });
