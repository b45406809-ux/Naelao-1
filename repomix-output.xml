        <h3>Routing Architecture</h3>
        <p><code>*.naelao.app</code> points to the <code>naelao-portal-router</code> Worker via a Cloudflare wildcard
          DNS record. On every request, the router performs a KV lookup to resolve the hostname to a Space ID, then
          dispatches to the portal's Isolate:</p>

        <pre><code><span class="cm">// workers/naelao-portal-router/src/index.ts</span>
export default {
  async fetch(request: Request, env: Env): Promise&lt;Response&gt; {
    const host = request.headers.get('Host') ?? '';

    <span class="cm">// Step 1: Resolve hostname → spaceId</span>
    const routeKey = `portal:host:${host}`;
    const route = await env.PORTAL_ROUTES.get(routeKey, 'json') as PortalRoute | null;

    if (!route) {
      return new Response('Portal not found', { status: 404 });
    }

    <span class="cm">// Step 2: Check if Space is active and portal is enabled</span>
    if (!route.enabled) {
      return new Response(route.disabledMessage ?? 'This portal is offline', { status: 503 });
    }

    <span class="cm">// Step 3: Check cache (static-first strategy)</span>
    const cacheKey = new Request(`https://cache.internal/${route.spaceId}${new URL(request.url).pathname}`);
    const cached = await caches.default.match(cacheKey);
    if (cached) return cached;

    <span class="cm">// Step 4: Dispatch to the portal Isolate via Dynamic Worker Loader</span>
    const portalWorker = env.DYNAMIC_LOADER.get(
      env.DYNAMIC_LOADER.idFromName(`portal:${route.spaceId}`)
    );

    const portalRequest = new Request(request.url, {
      method:  request.method,
      headers: new Headers({
        ...Object.fromEntries(request.headers),
        'X-Naelao-Space-Id':   route.spaceId,
        'X-Naelao-Portal-Token': route.scopedToken,  <span class="cm">// Read-only, space-scoped</span>
      }),
      body: request.body,
    });

    const response = await portalWorker.fetch(portalRequest);

    <span class="cm">// Step 5: Cache cacheable responses at the edge</span>
    if (response.headers.get('Cache-Control')?.includes('max-age')) {
      await caches.default.put(cacheKey, response.clone());
    }

    return response;
  }
};

interface PortalRoute {
  spaceId:        string;
  enabled:        boolean;
  disabledMessage?: string;
  scopedToken:    string;   <span class="cm">// Pre-issued read-only token, refreshed every 5 min by naelao-sweeper</span>
  deploymentR2Key: string;  <span class="cm">// Path to the portal artifact in R2</span>
}</code></pre>

        <h3>KV Route Table — How Hostnames Are Registered</h3>
        <p>When the provisioner creates a portal-enabled Space, it writes three KV entries: one for the platform
          subdomain, a placeholder for the custom domain (filled when the user connects one), and a reverse lookup for
          the slug uniqueness check:</p>

        <pre><code><span class="cm">// workers/naelao-provisioner/src/portal.ts</span>
export async function provisionExternalPortal(
  spaceId: string,
  slug: string,
  env: Env
): Promise&lt;void&gt; {
  <span class="cm">// Validate slug uniqueness</span>
  const existing = await env.PORTAL_ROUTES.get(`portal:slug:${slug}`);
  if (existing) throw new Error(`Slug "${slug}" is already taken`);

  const platformHost = `${slug}.naelao.app`;

  <span class="cm">// Issue a long-lived read-only portal token (rotated every 5 min by sweeper)</span>
  const scopedToken = await issueScopedToken({
    spaceId,
    permissions: ['workspace_read', 'knowledge_read'],
    ttlMs: 5 * 60 * 1000,
    env,
  });

  const route: PortalRoute = {
    spaceId,
    enabled: true,
    scopedToken,
    deploymentR2Key: `portals/${spaceId}/current/index.js`,
  };

  await Promise.all([
    env.PORTAL_ROUTES.put(`portal:host:${platformHost}`, JSON.stringify(route)),
    env.PORTAL_ROUTES.put(`portal:slug:${slug}`, spaceId),
    env.PORTAL_ROUTES.put(`portal:space:${spaceId}`, platformHost),
  ]);
}</code></pre>

        <h3>The @naelao/portal-sdk</h3>
        <p>Portal code — generated by the agent or written by the user — accesses Space data through the
          <code>@naelao/portal-sdk</code>. The SDK reads the Scoped Token injected by the router and uses it to make
          authenticated reads against the Scoped API. It never exposes the token to the browser:</p>

        <pre><code><span class="cm">// A portal generated by the agent for a Launchpad e-commerce Space</span>
<span class="cm">// Deployed to: portals/{spaceId}/current/index.ts</span>
import { createPortal } from '@naelao/portal-sdk';

const portal = createPortal({
  auth: 'platform-injected',  <span class="cm">// Token injected by naelao-portal-router header</span>
});

export default {
  async fetch(req: Request): Promise&lt;Response&gt; {
    const url = new URL(req.url);

    <span class="cm">// Read product data from the Space's SpaceDO SQLite DB</span>
    const products = await portal.db.query&lt;Product[]&gt;(
      'SELECT id, name, price, stock, image_r2_key FROM products WHERE stock > 0 ORDER BY name'
    );

    <span class="cm">// Serve product images directly from R2 (zero egress fee)</span>
    if (url.pathname.startsWith('/images/')) {
      const key = url.pathname.slice(1);
      const image = await portal.r2.get(key);
      if (!image) return new Response('Not found', { status: 404 });
      return new Response(image.body, {
        headers: { 'Content-Type': image.httpMetadata?.contentType ?? 'image/jpeg' }
      });
    }

    <span class="cm">// Render storefront HTML</span>
    return new Response(renderStorefront(products), {
      headers: {
        'Content-Type': 'text/html; charset=utf-8',
        'Cache-Control': 'public, max-age=60, stale-while-revalidate=300',
      }
    });
  }
}

interface Product { id: string; name: string; price: number; stock: number; image_r2_key: string; }

function renderStorefront(products: Product[]): string {
  return `<!doctype html><html>... ${products.map(p => `<div class="product">...</div>`).join('')} ...</html>`;
}</code></pre>

        <h3>Custom Domain Flow</h3>
        <p>When a user connects a custom domain, the Naelao agent walks them through the DNS step, then calls the
          Cloudflare for SaaS API to provision the custom hostname. SSL is issued automatically by Cloudflare's
          certificate authority within minutes:</p>

        <pre><code><span class="cm">// workers/naelao-spaces/src/custom-domain.ts</span>
export async function attachCustomDomain(
  spaceId: string,
  customHostname: string,
  env: Env
): Promise&lt;{ verificationRecord: string }&gt; {
  <span class="cm">// Register with CF for SaaS</span>
  const cfResponse = await fetch(
    `https://api.cloudflare.com/client/v4/zones/${env.CF_ZONE_ID}/custom_hostnames`,
    {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${env.CF_API_TOKEN}`, 'Content-Type': 'application/json' },
      body: JSON.stringify({
        hostname: customHostname,
        ssl: { method: 'txt', type: 'dv', settings: { min_tls_version: '1.2' } },
      }),
    }
  );
  const { result } = await cfResponse.json() as any;

  <span class="cm">// Add the custom hostname to the KV route table</span>
  const existingRoute = await env.PORTAL_ROUTES.get(`portal:space:${spaceId}`, 'json') as PortalRoute;
  await env.PORTAL_ROUTES.put(
    `portal:host:${customHostname}`,
    JSON.stringify({ ...existingRoute })
  );

  <span class="cm">// Return the TXT record the user needs to add</span>
  return {
    verificationRecord: result.ssl.txt_record.value,
  };
}</code></pre>

        <h3>Static-First Caching Strategy</h3>
        <p>Portal performance is critical — a slow storefront loses customers. The router implements a static-first
          strategy that makes most portal requests cost zero compute:</p>
        <ul class="fl">
          <li><strong>Cache-Control propagation:</strong> If the portal's <code>fetch()</code> handler sets
            <code>Cache-Control: max-age=60</code>, the router caches that response at the CF edge for 60 seconds.
            Subsequent requests for that URL are served from cache — no Isolate invocation, no Scoped API call, no cost.
          </li>
          <li><strong>Cache invalidation on deploy:</strong> When the agent deploys a new version of the portal artifact
            to R2, <code>naelao-sweeper</code> purges the cache for that Space's portal hostname via the CF Cache Purge
            API.</li>
          <li><strong>Stale-while-revalidate:</strong> Portals should set <code>stale-while-revalidate=300</code>. Users
            always get a fast cached response; the cache refreshes in the background. Only first-hit after a cache miss
            hits the Isolate.</li>
        </ul>

        <div class="box box-gr">
          <div class="box-lbl">Security: What the Portal Isolate Cannot Do</div>
          <p>Portal Workers run in Tier 2 Isolates with no direct CF bindings. They cannot call
            <code>env.AGENT_DO</code>, <code>env.R2</code>, or any other platform binding. The <em>only</em> way a
            portal reads data is through the <code>@naelao/portal-sdk</code>, which uses the read-only Scoped Token
            injected by the router. The token is bound to a single <code>spaceId</code> and grants only
            <code>workspace_read</code> and <code>knowledge_read</code> — never write permissions. A compromised portal
            artifact cannot exfiltrate other users' data, modify Space state, or trigger agent runs.</p>
        </div>
      </div>

      <!-- ══════════════════════════════════════════════════════
     A7 — Operator Shell Slot System
═══════════════════════════════════════════════════════ -->
      <div class="sep"></div>
      <div class="sec" id="operator-shell-slots">
        <span class="sec-ey">A7 — UI Orchestration</span>
        <h2>Operator Shell Slot System — The App Injection Pattern</h2>
        <div class="bar"></div>
        <p class="lead">The Naelao Operator Console is a "Shell" that provides core services (Auth, WebSocket,
          Navigation, Agent Chat) while leaving named "Slots" for Space Apps and Space Types to inject their own UIs. To
          ensure security and prevent CSS/JS leakage between apps and the host shell, every injected panel runs in a
          sandboxed <code>&lt;iframe&gt;</code> on a dedicated origin: <code>ui.naelao.app</code>.</p>

        <div class="pull">"The shell is the stage; the apps are the performers. Neither can break the other's
          environment."</div>

        <h3>The Slot Architecture</h3>
        <p>The Space Type manifest and installed App manifests declare which app IDs mount into which slots. The Shell
          reads all active slot declarations on startup and renders the appropriate iframes. Slot declarations are
          merged and de-conflicted by <code>UIOrchestrationDO</code>:</p>

        <table class="t">
          <thead>
            <tr>
              <th>Slot Name</th>
              <th>Location</th>
              <th>Dimensions</th>
              <th>Typical Use Case</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="tl"><code>sidebar</code></td>
              <td>Left navigation rail, below core nav items</td>
              <td>48px × 48px icon; expands to 240px panel on click</td>
              <td>Custom navigation links, resource counts, notifications</td>
            </tr>
            <tr>
              <td class="tl"><code>main-content</code></td>
              <td>Primary content area, replaces thread/project view</td>
              <td>Full width × full height (minus shell chrome)</td>
              <td>Custom dashboards, code editors, data grids, video</td>
            </tr>
            <tr>
              <td class="tl"><code>dashboard-widget</code></td>
              <td>Home screen card grid</td>
              <td>1–3 column grid cells, 200px min-height</td>
              <td>Revenue charts, agent status, pending task counts</td>
            </tr>
            <tr>
              <td class="tl"><code>drawer</code></td>
              <td>Slide-out panel from the right edge</td>
              <td>380px wide × full height</td>
              <td>Contextual settings, file history, agent logs, detail views</td>
            </tr>
            <tr>
              <td class="tl"><code>header-action</code></td>
              <td>Action buttons in the top header bar</td>
              <td>36px × 36px icon button</td>
              <td>Quick actions, global search, sync triggers</td>
            </tr>
            <tr>
              <td class="tl"><code>context-menu</code></td>
              <td>Right-click context menu additions</td>
              <td>Variable — menu items only</td>
              <td>Custom actions on files, threads, agents</td>
            </tr>
          </tbody>
        </table>

        <h3>Manifest Declaration</h3>
        <p>An App declares its slot requirements in its manifest. A Space Type manifest can also declare slot pre-fills
          — slots that are populated from the Space Type itself, not from an installed App:</p>
        <pre><code><span class="cm">// App manifest: declares the sidebar slot and a dashboard widget</span>
{
  "id": "crm-connector",
  "ui": {
    "slots": [
      {
        "slot": "sidebar",
        "icon": "ti-address-book",
        "label": "CRM",
        "panelUrl": "https://crm-ui.acme.workers.dev/panel",
        "badge": {
          "type": "count",
          "dataSource": "tool:crm_get_pending_count"  <span class="cm">// Agent calls this tool to get the badge number</span>
        }
      },
      {
        "slot": "dashboard-widget",
        "title": "CRM Pipeline",
        "widgetUrl": "https://crm-ui.acme.workers.dev/widget",
        "gridColumns": 2
      }
    ]
  }
}

<span class="cm">// Space Type manifest: pre-fills main-content with a custom dashboard</span>
{
  "id": "mini-agi",
  "ui": {
    "operatorShell": {
      "defaultView": "custom-dashboard",
      "sidebarSlots": [
        { "slot": "sidebar", "appId": "naelao-mini-agi-console", "position": "top" }
      ],
      "dashboardWidgets": [
        { "slot": "dashboard-widget", "appId": "naelao-mini-agi-status", "gridColumns": 3 }
      ],
      "hiddenCoreItems": ["new-thread-button"]  <span class="cm">// Mini-AGI hides the standard thread UI</span>
    }
