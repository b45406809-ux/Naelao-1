<file path="apps/shell/src/app/p/[slug]/(shell)/approvals/page.tsx">
"use client";

export const runtime = "edge";

// Approvals — the things your agents are waiting on you for.
//
// A gated action opens a request and does NOT run: the agent parks it, carries on with the rest
// of the task, and picks that action back up the moment it's answered. Until this page existed
// there was no way to answer one from the product, so every parked action simply sat there until
// it expired — the whole feature was real end to end except the one step that needs a person.

import * as React from "react";
import { Button, Badge, Card, CardTitle, CardDesc, useToast, Toast } from "@naelao/ui";
import { useProductAuth } from "@/lib/auth-provider";
import { useProduct } from "@/lib/product-context";
import { useActiveSpace } from "@/lib/active-space-context";
import {
  listAllApprovals,
  listMyBusinesses,
  approveAction,
  rejectAction,
  type PendingApprovalWithBusiness,
} from "@/lib/api";

/** Arguments are shown, not hidden behind a name: approving "commerce.payout" without seeing the
 *  amount and destination is not an informed decision. */
function readableParams(raw: string): string {
  try {
    const parsed = JSON.parse(raw) as Record<string, unknown>;
    const entries = Object.entries(parsed);
    if (entries.length === 0) return "";
    return entries.map(([k, v]) => `${k}: ${typeof v === "string" ? v : JSON.stringify(v)}`).join("\n");
  } catch {
    return raw;
  }
}

function timeLeft(expiresAt: number): string {
  const ms = expiresAt - Date.now();
  if (ms <= 0) return "expired";
  const hours = Math.floor(ms / 3_600_000);
  if (hours >= 1) return `${hours}h left`;
  const mins = Math.max(1, Math.floor(ms / 60_000));
  return `${mins}m left`;
}

export default function ApprovalsPage() {
  const { session } = useProductAuth();
  const product = useProduct();
  // Kept for "jump to this business" on an item card — no longer used to SCOPE the list itself.
  // See listAllApprovals's own header: an approval is per-business, and only checking whichever
  // one happens to be active is the exact bug this page exists to not have.
  const { setActiveSpace } = useActiveSpace();
  const { toast, show } = useToast();
  const [items, setItems] = React.useState<PendingApprovalWithBusiness[]>([]);
  const [loading, setLoading] = React.useState(true);
  const [failed, setFailed] = React.useState(false);
  const [busyId, setBusyId] = React.useState<string | null>(null);

  const creds = session ? { sessionToken: session.session_token, endUserId: session.end_user_id } : null;

  const refresh = React.useCallback(async () => {
    if (!creds) return;
    setLoading(true);
    try {
      const businesses = await listMyBusinesses(product.space_id, creds);
      setItems(await listAllApprovals(product.space_id, product.product_name, businesses, creds));
      setFailed(false);
    } catch {
      // Distinct from "nothing pending" — telling someone there's nothing to approve when the
      // list simply failed to load is how a payout quietly never happens.
      setFailed(true);
    } finally {
      setLoading(false);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [product.space_id, product.product_name, session]);

  React.useEffect(() => {
    void refresh();
  }, [refresh]);

  async function decide(approval: PendingApprovalWithBusiness, approve: boolean) {
    if (!creds) return;
    setBusyId(approval.id);
    try {
      // The approval's OWN business, not whatever happens to be active in the switcher right now
      // — see listAllApprovals's header for why that distinction is the whole point of this page.
      if (approve) await approveAction(approval.business_id, approval.id, creds);
      else await rejectAction(approval.business_id, approval.id, "Declined by the owner", creds);
      show(approve ? "Approved — the agent is picking it back up now." : "Declined.");
      await refresh();
    } catch (err) {
      show(err instanceof Error ? err.message : "Couldn't record that");
    } finally {
      setBusyId(null);
    }
  }

  return (
    <div className="page-view">
      <div className="page-header">
        <div className="page-title">Approvals</div>
        <div className="page-subtitle">
          Actions your agents have paused on until you say yes. Nothing here has run.
        </div>
      </div>

      {loading ? (
        <p style={{ color: "var(--text3)", fontSize: 13 }}>Loading…</p>
      ) : failed ? (
        <div style={{ display: "flex", alignItems: "center", gap: 12, fontSize: 13 }}>
          <span style={{ color: "#dc2626" }} role="alert">
            Couldn&rsquo;t load your approvals — this is a loading problem, not an empty list.
          </span>
          <Button variant="secondary" onClick={() => void refresh()}>
            Retry
          </Button>
        </div>
      ) : items.length === 0 ? (
        <p style={{ color: "var(--text3)", fontSize: 13 }}>
          Nothing waiting on you. Your agents will ask here before doing anything that spends money
          or touches the outside world.
        </p>
      ) : (
        <div style={{ display: "flex", flexDirection: "column", gap: 12 }}>
          {items.map((a) => {
            const params = readableParams(a.tool_input);
            return (
              <Card key={a.id}>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", gap: 12 }}>
                  <div style={{ minWidth: 0 }}>
                    <button
                      type="button"
                      onClick={() => setActiveSpace(a.business_id, a.business_name)}
                      style={{
                        border: "none", background: "none", padding: 0, cursor: "pointer",
                        fontSize: 11, letterSpacing: "0.03em", textTransform: "uppercase",
                        color: "var(--accent)", marginBottom: 4, display: "block",
                      }}
                      title="Switch to this business"
                    >
                      {a.business_name}
                    </button>
                    <CardTitle>{a.tool_name}</CardTitle>
                    <CardDesc>{a.action_description}</CardDesc>
                  </div>
                  <Badge color="amber">{timeLeft(a.expires_at)}</Badge>
                </div>

                {params && (
                  <pre
                    style={{
                      marginTop: 10,
                      padding: "10px 12px",
                      borderRadius: 8,
                      background: "var(--surface2, #f6f7f9)",
                      fontSize: 12,
                      whiteSpace: "pre-wrap",
                      wordBreak: "break-word",
                      maxHeight: 180,
                      overflowY: "auto",
                    }}
                  >
                    {params}
                  </pre>
                )}

                <div style={{ display: "flex", gap: 8, marginTop: 12 }}>
                  <Button onClick={() => void decide(a, true)} disabled={busyId === a.id}>
                    {busyId === a.id ? "Saving…" : "Approve"}
                  </Button>
                  <Button variant="secondary" onClick={() => void decide(a, false)} disabled={busyId === a.id}>
                    Decline
                  </Button>
                </div>
              </Card>
            );
          })}
        </div>
      )}
      <Toast toast={toast} />
    </div>
  );
}
</file>

<file path="apps/shell/src/app/p/[slug]/(shell)/connectors/page.tsx">
"use client";

export const runtime = "edge";

// Sidebar → More → Connectors: the app store for the active business.
//
// This page used to lead with a hand-written list of about a dozen connectors (X/Twitter through
// Meta Ads) with the real directory — several thousand apps across Composio and Pipedream — hidden
// behind a "Browse all apps" button. That inverted the truth: the small list is our RECOMMENDATION,
// the directory is what the platform can actually reach. So there is now one grid, ordered by what
// people genuinely use most (Composio's own `sort_by=usage`, not a ranking we invented), with the
// curated entries merged in and marked rather than given their own section.
//
// Both sources render through the same AppCard, with the provider's real logo when it sends one.

import * as React from "react";
import { Button, FormInput, useToast, Toast } from "@naelao/ui";
import { useProductAuth } from "@/lib/auth-provider";
import { useActiveSpace } from "@/lib/active-space-context";
import {
  getConnectorStatus,
  getConnectorDirectory,
  connectorProvider,
  type ConnectorInfo,
  type DirectoryApp,
} from "@/lib/api";
import {
  startConnectorConnect,
  startDirectoryConnect,
  submitManualConnectorKey,
  consumeConnectorReturnMarker,
} from "@/lib/connectorActions";
import { AppCard, type AppCardModel } from "@/components/AppCard";

type Tab = "popular" | "connected" | "az";

const TABS: Array<{ key: Tab; label: string }> = [
  { key: "popular", label: "Most used" },
  { key: "connected", label: "Connected" },
  { key: "az", label: "A–Z" },
];

const PAGE_SIZE = 60;

export default function ConnectorsPage() {
  const { activeSpaceId } = useActiveSpace();
  const { session } = useProductAuth();
  const { toast, show } = useToast();
  const creds = session ? { sessionToken: session.session_token, endUserId: session.end_user_id } : null;

  const [connectors, setConnectors] = React.useState<ConnectorInfo[]>([]);
  const [loading, setLoading] = React.useState(true);
  const [query, setQuery] = React.useState("");
  const [tab, setTab] = React.useState<Tab>("popular");
  const [busyId, setBusyId] = React.useState<string | null>(null);
  const [manualKeyFor, setManualKeyFor] = React.useState<ConnectorInfo | null>(null);
  const [manualKeyValue, setManualKeyValue] = React.useState("");

  const [directory, setDirectory] = React.useState<DirectoryApp[] | null>(null);
  const [directoryNote, setDirectoryNote] = React.useState<string | null>(null);
  const [directoryLoading, setDirectoryLoading] = React.useState(false);
  const [directoryCursor, setDirectoryCursor] = React.useState<string | null>(null);

  const refresh = React.useCallback(async () => {
    if (!creds) return;
    setLoading(true);
    try {
      setConnectors(await getConnectorStatus(activeSpaceId, creds));
    } catch {
      show("Couldn't load your connected apps");
    } finally {
      setLoading(false);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [activeSpaceId, session]);

  React.useEffect(() => {
    void refresh();
  }, [refresh]);

  // Land back here after any redirect-based connect flow (hosted Composio/Pipedream, or a bespoke
  // OAuth app) — every flow marks `${id}_connected=1` / `${id}_oauth_error=` on return.
  React.useEffect(() => {
    if (connectors.length === 0) return;
    let touched = false;
    for (const c of connectors) {
      const marker = consumeConnectorReturnMarker(c.id);
      if (!marker) continue;
      touched = true;
      show(marker.error ? `${c.name} connection failed: ${marker.error}` : `${c.name} connected.`);
    }
    if (touched) void refresh();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [connectors.length]);

  /** `append` continues from the last cursor; otherwise this starts a fresh page or search. */
  const loadDirectory = React.useCallback(
    async (append = false) => {
      if (!creds) return;
      setDirectoryLoading(true);
      try {
        const page = await getConnectorDirectory(activeSpaceId, creds, {
          q: query.trim() || undefined,
          limit: PAGE_SIZE,
          sort: tab === "az" ? "name" : "popular",
          ...(append && directoryCursor ? { cursor: directoryCursor } : {}),
        });
        // Anything we already ship a purpose-built connector for is represented by that connector's
        // own card, which carries real declared operations — listing it twice would offer a generic
        // brokered connection alongside the better one.
        const fresh = page.apps.filter((a) => !a.curated_as);
        setDirectory((prev) => {
          if (!append || !prev) return fresh;
          // Both providers can offer the same app, and a later page can repeat one the merge
          // already emitted — dedupe on arrival rather than rendering it twice.
          const seen = new Set(prev.map((a) => a.slug));
          return [...prev, ...fresh.filter((a) => !seen.has(a.slug))];
        });
        setDirectoryCursor(page.next_cursor ?? null);
        const off = page.providers.filter((p) => !p.available);
        setDirectoryNote(
          off.length === page.providers.length
            ? "The app directory isn't switched on for this platform yet."
            : off.length > 0
              ? `${off.map((p) => p.provider).join(" and ")} is unavailable right now, so this list is incomplete.`
              : null
        );
      } catch (err) {
        if (!append) setDirectory([]);
        setDirectoryNote(err instanceof Error ? err.message : "Couldn't load the app directory.");
      } finally {
        setDirectoryLoading(false);
      }
      // eslint-disable-next-line react-hooks/exhaustive-deps
    },
    [activeSpaceId, session, query, tab, directoryCursor]
  );

  // Deliberately NOT a dependency on `loadDirectory` itself: that callback closes over
  // `directoryCursor`, so depending on it would re-fire this every time a page was appended and
  // restart from the beginning. The ref keeps the latest implementation without the identity churn.
  const loadDirectoryRef = React.useRef(loadDirectory);
  loadDirectoryRef.current = loadDirectory;

  // The grid is directory-backed from the first render — there is no "browse" step to opt into.
  // A search re-runs it server-side (thousands of apps; a client-side filter over one page would
  // report "no results" for anything not on it), debounced so typing doesn't fire per keystroke.
  React.useEffect(() => {
    if (tab === "connected") return;
    const q = query.trim();
    const timer = setTimeout(
      () => {
        setDirectoryCursor(null);
        void loadDirectoryRef.current(false);
      },
      q ? 300 : 0
    );
    return () => clearTimeout(timer);
  }, [query, tab, activeSpaceId]);

  async function handleConnect(model: AppCardModel) {
    if (!creds) return;
    const curated = connectors.find((c) => c.id === model.id);
    setBusyId(model.id);
    try {
      if (curated) {
        const { needsManualKey } = await startConnectorConnect(activeSpaceId, creds, curated, window.location.href);
        if (needsManualKey) {
          setManualKeyFor(curated);
          setManualKeyValue("");
          setBusyId(null);
        }
      } else {
        await startDirectoryConnect(activeSpaceId, creds, model.id, window.location.href);
      }
      // Hosted/OAuth flows: the browser is already navigating away, leave the button busy.
    } catch (err) {
      show(err instanceof Error ? err.message : `Failed to start connecting ${model.name}`);
      setBusyId(null);
    }
  }

  async function handleManualSubmit() {
    if (!creds || !manualKeyFor || !manualKeyValue.trim()) return;
    const id = manualKeyFor.id;
    setBusyId(id);
    try {
      await submitManualConnectorKey(activeSpaceId, creds, id, manualKeyValue.trim());
      setManualKeyFor(null);
      setManualKeyValue("");
      await refresh();
    } catch (err) {
      show(err instanceof Error ? err.message : "Failed to connect");
    } finally {
      setBusyId(null);
    }
  }

  const available = connectors.filter((c) => c.status === "available");
  const comingSoon = connectors.filter((c) => c.status === "coming_soon");

  const curatedCards: AppCardModel[] = React.useMemo(
    () =>
      available.map((c) => ({
        id: c.id,
        name: c.name,
        description: c.summary,
        logo: c.logo,
        provider: connectorProvider(c),
        connected: Boolean(c.connected),
        recommended: true,
        personal: c.scope_model === "user",
      })),
    [available]
  );

  const directoryCards: AppCardModel[] = React.useMemo(
    () =>
      (directory ?? []).map((a) => ({
        id: a.id,
        name: a.name,
        description: a.description || a.categories.slice(0, 3).join(" · ") || "Connect it and your assistant can use it.",
        logo: a.logo,
        provider: a.provider,
        connected: false,
        recommended: false,
      })),
    [directory]
  );

  // A local filter over the curated cards only — the directory half is already filtered
  // server-side by the same query, so filtering it again here would do nothing but risk
  // disagreeing with what the server matched on.
  const q = query.trim().toLowerCase();
  const matchingCurated = q
    ? curatedCards.filter((c) => c.name.toLowerCase().includes(q) || c.description.toLowerCase().includes(q))
    : curatedCards;

  const cards: AppCardModel[] =
    tab === "connected"
      ? curatedCards.filter((c) => c.connected)
      : // Recommended and already-connected apps lead; the ranked directory follows. Both halves
        // are then rendered as one continuous grid, so the boundary isn't a visible wall.
        [...matchingCurated.filter((c) => c.connected), ...matchingCurated.filter((c) => !c.connected), ...directoryCards];

  const connectedCount = curatedCards.filter((c) => c.connected).length;

  if (loading) return <div className="page-view">Loading…</div>;

  return (
    <div className="page-view">
      <div className="page-header">
        <div className="page-title">Apps</div>
        <div className="page-subtitle">
          Everything your assistant and project agents can reach. Most connect by signing in on the
          app&apos;s own page — there is no API key to hunt down.
        </div>
      </div>

      <div className="search-bar">
        <svg viewBox="0 0 16 16" fill="none" strokeWidth={1.5} stroke="currentColor">
          <circle cx="7" cy="7" r="4.5" />
          <line x1="10.5" y1="10.5" x2="14" y2="14" />
        </svg>
        <input
          type="text"
          placeholder="Search thousands of apps — Gmail, Airtable, Shopify, Jira…"
          value={query}
          onChange={(e) => setQuery(e.target.value)}
        />
      </div>

      <div className="marketplace-filters">
        {TABS.map((t) => (
          <button
            key={t.key}
            type="button"
            className={`filter-tab${tab === t.key ? " active" : ""}`}
            onClick={() => setTab(t.key)}
          >
            {t.label}
            {t.key === "connected" && connectedCount > 0 ? ` · ${connectedCount}` : ""}
          </button>
        ))}
        {directoryLoading && (
          <span style={{ fontSize: 12, color: "var(--text3)" }}>Loading…</span>
        )}
      </div>

      {directoryNote && tab !== "connected" && (
        <p style={{ color: "var(--text3)", fontSize: 12.5, marginBottom: 12 }}>{directoryNote}</p>
      )}

      {manualKeyFor && (
        <div className="settings-block" style={{ marginBottom: 16 }}>
          <div className="settings-row" style={{ flexWrap: "wrap", gap: 8 }}>
            <div>
              <div className="settings-row-label">Connect {manualKeyFor.name}</div>
              <div className="settings-row-sub">This one needs a key from your own {manualKeyFor.name} account.</div>
            </div>
            <div style={{ display: "flex", gap: 8, flexWrap: "wrap", alignItems: "center" }}>
              <FormInput
                type="password"
                placeholder={`${manualKeyFor.name} API key`}
                value={manualKeyValue}
                onChange={(e) => setManualKeyValue(e.target.value)}
                style={{ minWidth: 240 }}
              />
              <Button size="sm" onClick={handleManualSubmit} disabled={busyId === manualKeyFor.id || !manualKeyValue.trim()}>
                {busyId === manualKeyFor.id ? "Connecting…" : "Connect"}
              </Button>
              <button
                type="button"
                className="btn btn-secondary btn-sm"
                onClick={() => { setManualKeyFor(null); setManualKeyValue(""); }}
              >
                Cancel
              </button>
            </div>
          </div>
        </div>
      )}

      {cards.length === 0 ? (
        <p style={{ color: "var(--text3)", fontSize: 13, marginBottom: 24 }}>
          {tab === "connected"
            ? "Nothing connected yet. Pick an app from Most used to get started."
            : directoryLoading
              ? "Searching…"
              : `No apps match "${query.trim()}".`}
        </p>
      ) : (
        <div className="app-grid">
          {cards.map((c) => (
            <AppCard key={c.id} app={c} busy={busyId === c.id} onConnect={() => void handleConnect(c)} />
          ))}
        </div>
      )}

      {tab !== "connected" && directoryCursor && (
        <div style={{ marginTop: 16, textAlign: "center" }}>
          <Button size="sm" onClick={() => void loadDirectory(true)} disabled={directoryLoading}>
            {directoryLoading ? "Loading…" : "Show more apps"}
          </Button>
        </div>
      )}

      {tab !== "connected" && comingSoon.length > 0 && (
        <>
          <div className="section-label" style={{ marginTop: 28 }}>Not ready yet</div>
          <div className="app-grid">
            {comingSoon.map((c) => (
              <div key={c.id} className="app-card" style={{ cursor: "default", opacity: 0.55 }}>
                <div className="app-card-header">
                  <div className="app-card-initial">{c.name.slice(0, 1)}</div>
                  <div style={{ minWidth: 0 }}>
                    <div className="app-card-name">{c.name}</div>
                    <div className="app-card-publisher">Coming soon</div>
                  </div>
                </div>
                <div className="app-card-desc">{c.summary}</div>
              </div>
            ))}
          </div>
        </>
      )}

      <Toast toast={toast} />
    </div>
  );
}
</file>

<file path="apps/shell/src/app/p/[slug]/(shell)/dashboard/assistant/page.tsx">
"use client";

export const runtime = "edge";

// Assistant settings — every configuration for the space's own assistant, on one page with room
// to explain itself.
//
// Why this exists as its own page: these controls used to live in a ~320px dashboard tile
// alongside eight other tiles, where "Autonomy" was two unlabelled buttons and the four real
// approval modes were collapsed into a binary. Someone looking for "where do I change what my
// assistant is allowed to do" had no page to land on. The dashboard tile stays, but as a summary
// that links here.
//
// Everything writes through the same already-built, membership-gated routes the dashboard tile
// used (assistant-policy, model-config) — no new backend surface.

import * as React from "react";
import Link from "next/link";
import { Badge } from "@naelao/ui";
import { ALLOWED_MODELS, DEFAULT_WORKING_MODEL, capabilityForModel, effortOptionsForModel, isValidEffortLevel } from "@naelao/billing-core";
import { useProduct } from "@/lib/product-context";
import { useSessionCredentials } from "@/lib/auth-provider";
import { useActiveSpace } from "@/lib/active-space-context";
import {
  getAssistantPolicy,
  updateAssistantPolicy,
  updateModelConfig,
  getShellManifest,
  getAssistantCapabilities,
  listMyBusinesses,
  listScheduledJobs,
  listAssistantChannels,
  type AssistantPolicy,
  type AssistantCapabilities,
  type ScheduledJob,
  type ChannelLink,
  type Business,
} from "@/lib/api";
import { modelLabel } from "@/components/ModelSelector";
import { ApprovedActionsEditor } from "@/components/ApprovedActionsEditor";
import { ByokKeysPanel } from "@/components/ByokKeysPanel";
import { SettingsSection, SettingsRow } from "@/components/SettingsSection";
import { ChannelConnect } from "@/components/ChannelConnect";
import { canManageSpaceSettings } from "@/lib/roles";

type ApprovalMode = AssistantPolicy["approval_mode"];

/** The four real modes SpaceDO stores, described in terms of what actually happens — not the
 *  internal names. The dashboard tile only ever offered two of these. */
const MODES: { id: ApprovalMode; title: string; desc: string }[] = [
  {
    id: "always_ask",
    title: "Ask me first",
    desc: "Checks with you before anything that spends money, sends a message, or changes how the business is set up. Reading and looking things up never needs asking.",
  },
  {
    id: "gate_unless_listed",
    title: "Ask unless pre-approved",
    desc: "Like the above, but anything on your pre-approved list below goes through without asking.",
  },
  {
    id: "gate_listed",
    title: "Only ask for listed actions",
    desc: "The reverse: it acts freely except for the specific actions you list below, which always come to you.",
  },
  {
    id: "yolo",
    title: "Fully autonomous",
    desc: "Never asks. It will spend, send and change things on its own. Best once you've watched it work for a while.",
  },
];

export default function AssistantSettingsPage() {
  const product = useProduct();
  const creds = useSessionCredentials();
  const { activeSpaceId, activeSpaceName, isBusinessSpace } = useActiveSpace();

  const [policy, setPolicy] = React.useState<AssistantPolicy | null>(null);
  const [model, setModel] = React.useState<string | null>(null);
  const [effort, setEffort] = React.useState<string | null>(null);
  const [business, setBusiness] = React.useState<Business | null>(null);
  const [capabilities, setCapabilities] = React.useState<AssistantCapabilities | null>(null);
  const [crons, setCrons] = React.useState<ScheduledJob[]>([]);
  const [channels, setChannels] = React.useState<ChannelLink[]>([]);
  const [loading, setLoading] = React.useState(true);
  const [saving, setSaving] = React.useState(false);
  const [error, setError] = React.useState<string | null>(null);
  const [saved, setSaved] = React.useState<string | null>(null);

  React.useEffect(() => {
    if (!creds || !activeSpaceId) return;
    let cancelled = false;
    setLoading(true);
    const settle = <T,>(p: Promise<T>, set: (v: T) => void) =>
      p.then((v) => { if (!cancelled) set(v); }).catch(() => {});

    const calls = [
      settle(getAssistantPolicy(activeSpaceId, creds), setPolicy),
      settle(getShellManifest(activeSpaceId, creds), (m) => { setModel(m.model ?? null); setEffort(m.effort ?? null); }),
      settle(getAssistantCapabilities(activeSpaceId, creds), setCapabilities),
      settle(listScheduledJobs(activeSpaceId, creds), setCrons),
      settle(listAssistantChannels(activeSpaceId, creds), setChannels),
    ];
    if (isBusinessSpace) {
      calls.push(
        settle(listMyBusinesses(product.space_id, creds).then((l) => l.find((b) => b.id === activeSpaceId) ?? null), setBusiness)
      );
    }
    Promise.allSettled(calls).finally(() => { if (!cancelled) setLoading(false); });
    return () => { cancelled = true; };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [creds, activeSpaceId, isBusinessSpace, product.space_id]);

  const canEdit = canManageSpaceSettings(isBusinessSpace, business?.role);

  function flash(message: string) {
    setSaved(message);
    window.setTimeout(() => setSaved((cur) => (cur === message ? null : cur)), 2500);
  }

  async function savePolicy(patch: Partial<AssistantPolicy>, message: string) {
    if (!activeSpaceId || !creds) return;
    setSaving(true);
    setError(null);
    try {
      setPolicy(await updateAssistantPolicy(activeSpaceId, creds, patch));
      flash(message);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Couldn't save that");
    } finally {
      setSaving(false);
    }
  }

  async function saveModel(next: string) {
    if (!activeSpaceId || !creds) return;
    setSaving(true);
    setError(null);
    try {
      // A level valid for the previous model may not exist on the new one's own ladder — drop it
      // rather than carry over blindly, same rule as the chat dock's own model switch.
      const nextEffort = effort && isValidEffortLevel(next, effort) ? effort : undefined;
      const res = await updateModelConfig(activeSpaceId, creds, next, nextEffort);
      setModel(res.model);
      if (res.effort) setEffort(res.effort);
      else if (!nextEffort) setEffort(null);
      flash("Model updated");
    } catch (err) {
      setError(err instanceof Error ? err.message : "Couldn't change the model");
    } finally {
      setSaving(false);
    }
  }

  async function saveEffort(next: string) {
    if (!activeSpaceId || !creds) return;
    setSaving(true);
    setError(null);
    try {
      const res = await updateModelConfig(activeSpaceId, creds, activeModel, next);
      setEffort(res.effort ?? next);
      flash("Effort updated");
    } catch (err) {
      setError(err instanceof Error ? err.message : "Couldn't change the effort setting");
    } finally {
      setSaving(false);
    }
  }

  if (!creds) return null;

  const activeModel = model ?? DEFAULT_WORKING_MODEL;
  const listLabel =
    policy?.approval_mode === "gate_listed"
      ? "Actions that always need your approval"
      : "Actions it never needs to ask about";

  return (
    <div className="page-view">
      <div className="page-header">
        <div style={{ fontSize: 12, marginBottom: 6 }}>
          <Link href={`/p/${product.slug}/dashboard`} style={{ color: "var(--text3)", textDecoration: "none" }}>
            Dashboard
          </Link>
          <span style={{ color: "var(--text3)" }}> / Assistant</span>
        </div>
        <div className="page-title">Assistant settings</div>
        <div className="page-subtitle">
          How the assistant for {activeSpaceName ?? product.product_name} behaves — what it may do on its own, and which
          model it thinks with.
        </div>
      </div>

      {loading && <p style={{ fontSize: 12.5, color: "var(--text3)" }}>Loading…</p>}

      {!canEdit && !loading && (
        <div
          style={{
            padding: "10px 14px", borderRadius: "var(--radius-sm)", border: "1px solid var(--border)",
            background: "var(--surface2)", fontSize: 12.5, color: "var(--text2)", marginBottom: 18,
          }}
        >
          {isBusinessSpace
            ? "You can see these settings but not change them — that needs the owner or an admin of this business."
            : "This space's assistant is configured by its owner in the builder dashboard."}
        </div>
      )}

      <SettingsSection
        title="What it can do without asking"
        desc="The assistant always asks before something irreversible unless you tell it otherwise. Pick how much rope it gets."
      >
        <div style={{ display: "grid", gap: 8 }}>
          {MODES.map((mode) => {
            const active = policy?.approval_mode === mode.id;
            return (
              <button
                key={mode.id}
                type="button"
                className={`dock-row${active ? " active" : ""}`}
                style={{ width: "100%", textAlign: "left", cursor: canEdit ? "pointer" : "default", background: active ? "var(--surface2)" : "transparent", fontFamily: "inherit" }}
                disabled={!canEdit || saving || active}
                onClick={() => void savePolicy({ approval_mode: mode.id }, `Switched to "${mode.title}"`)}
              >
                <div className="dock-row-main">
                  <div className="dock-row-title">{mode.title}</div>
                  <div className="dock-row-desc" style={{ whiteSpace: "normal", lineHeight: 1.5 }}>{mode.desc}</div>
                </div>
                <div className="dock-row-action">
                  {active ? <Badge color="green">Current</Badge> : canEdit ? <span className="dock-pill">Use this</span> : null}
                </div>
              </button>
            );
          })}
        </div>
      </SettingsSection>

      <SettingsSection
        title={listLabel}
        desc={
          policy?.approval_mode === "gate_listed"
            ? "Everything else runs without interrupting you. Add an action name exactly as it appears on an approval request."
            : "Add an action here and the assistant stops asking about it. The name is shown on every approval request — copy it from there."
        }
      >
        <ApprovedActionsEditor
          actions={policy?.auto_approved_actions ?? []}
          canEdit={canEdit}
          busy={saving}
          catalogue={capabilities?.prebuilts.map((p) => ({ script: p.name, description: p.description, operations: p.operations }))}
          onAdd={(a) => void savePolicy({ auto_approved_actions: [...(policy?.auto_approved_actions ?? []), a] }, `Added ${a}`)}
          onRemove={(a) => void savePolicy({ auto_approved_actions: (policy?.auto_approved_actions ?? []).filter((x) => x !== a) }, `Removed ${a}`)}
        />
      </SettingsSection>

      <SettingsSection title="Model" desc="What the assistant thinks with. A bigger model reasons better and costs more per message.">
        <div style={{ display: "grid", gap: 6 }}>
          {ALLOWED_MODELS.map((m) => {
            const cap = capabilityForModel(m);
            const active = m === activeModel;
            return (
              <div key={m} className={`dock-row${active ? " active" : ""}`}>
                <div className="dock-row-main">
                  <div className="dock-row-title">{modelLabel(m)}</div>
                  <div className="dock-row-desc">
                    {cap.reasoningLevels.length > 0
                      ? `Adjustable reasoning effort — ${cap.reasoningLevels.join(", ")}`
                      : "No configurable reasoning mode"}
                  </div>
                </div>
                <div className="dock-row-action">
                  {active ? (
                    <Badge color="green">In use</Badge>
                  ) : canEdit ? (
                    <button type="button" className="dock-pill" disabled={saving} onClick={() => void saveModel(m)}>
                      Use this
                    </button>
                  ) : null}
                </div>
              </div>
            );
          })}
        </div>
        <p style={{ fontSize: 11.5, color: "var(--text3)", marginTop: 10, lineHeight: 1.6 }}>
          This is the business-wide default. You can also pick a different model for one conversation from the bar
          under the message box — that choice only affects that chat.
        </p>
      </SettingsSection>

      <SettingsSection
        title="Effort"
        desc="How far this business's default model is allowed to reach for help. If it delegates work to another agent, this caps how expensive that can get — see each option below."
      >
        <div style={{ display: "flex", gap: 6, marginBottom: 8 }}>
          {effortOptionsForModel(activeModel).map((opt) => {
            const active = (effort ?? "low") === opt.level;
            return (
              <button
                key={opt.level}
                type="button"
                className={`dock-pill${active ? " on" : ""}`}
                style={{ flex: 1, justifyContent: "center", padding: "8px 0" }}
                disabled={!canEdit || saving || active}
                onClick={() => void saveEffort(opt.level)}
              >
                {opt.label}
              </button>
            );
          })}
        </div>
        <p style={{ fontSize: 11.5, color: "var(--text3)", lineHeight: 1.6 }}>
          {effortOptionsForModel(activeModel).find((o) => o.level === (effort ?? "low"))?.description}
        </p>
      </SettingsSection>

      <SettingsSection
        title="Your own AI keys"
        desc="Bring your own Google AI Studio (Gemini) or Groq key so this business runs on your own free/paid quota instead of the shared platform allowance. Optional — leave blank to keep using the platform's."
      >
        {creds && activeSpaceId ? (
          <ByokKeysPanel spaceId={activeSpaceId} creds={creds} canEdit={canEdit} />
        ) : null}
      </SettingsSection>

      <SettingsSection
        title="Where it can be reached"
        desc="Channels customers can message the assistant on, besides this app."
      >
        {creds && activeSpaceId ? (
          <ChannelConnect
            spaceId={activeSpaceId}
            session={creds}
            channels={channels}
            canManage={canEdit}
            onChanged={() => {
              void listAssistantChannels(activeSpaceId, creds).then(setChannels).catch(() => undefined);
            }}
          />
        ) : (
          <p style={{ fontSize: 12.5, color: "var(--text3)" }}>Loading…</p>
        )}
      </SettingsSection>

      <SettingsSection title="Recurring work" desc="Things it does on a schedule without being asked.">
        {crons.length === 0 ? (
          <p style={{ fontSize: 12.5, color: "var(--text3)" }}>
            Nothing scheduled. Ask the assistant to do something regularly — &ldquo;review revenue every Monday&rdquo; — and it
            will appear here.
          </p>
        ) : (
          crons.map((j) => (
            <SettingsRow key={j.id} label={j.name || j.id} sub={j.last_run_at ? `Last ran ${new Date(j.last_run_at).toLocaleString()}` : "Hasn't run yet"}>
              <Badge color={j.enabled ? "green" : "amber"}>{j.enabled ? j.cron_expression : "Paused"}</Badge>
            </SettingsRow>
          ))
        )}
      </SettingsSection>

      <SettingsSection title="What it can do" desc="Built-in abilities, plus skills it has written for itself while working.">
        <SettingsRow label="Built-in scripts" sub="Shipped with the platform — email, commerce, web search, the wallet, and more.">
          <span style={{ fontSize: 13, color: "var(--text2)" }}>{capabilities?.prebuilt_count ?? "…"}</span>
        </SettingsRow>
        <SettingsRow label="Learned skills" sub="Written by the assistant itself as it solves things. These build up with use.">
          <span style={{ fontSize: 13, color: "var(--text2)" }}>{capabilities?.skill_count ?? "…"}</span>
        </SettingsRow>
        <div style={{ marginTop: 10 }}>
          <Link href={`/p/${product.slug}/agents`} style={{ fontSize: 12.5, color: "var(--accent)", textDecoration: "none" }}>
            Configure individual agents →
          </Link>
        </div>
      </SettingsSection>

      {error && <p style={{ fontSize: 12.5, color: "#dc2626", marginTop: 12 }}>{error}</p>}
      {saved && <p style={{ fontSize: 12.5, color: "var(--text3)", marginTop: 12 }}>{saved}</p>}
    </div>
  );
}
</file>

<file path="apps/shell/src/app/p/[slug]/(shell)/dashboard/page.tsx">
"use client";

export const runtime = "edge";

// The Dashboard — a merged BUSINESS dashboard + ASSISTANT dashboard for whichever space is
// currently active (formerly two separate surfaces: this page used to be assistant-only, and a
// business's key numbers only lived buried in its own /spaces/:id management page). Renamed from
// "Assistant" and moved to the top of the sidebar, above Discover, since it's the first thing
// worth seeing when you open a business.
//
// Built on the real design system (Card/CardLabel/CardValue, .section-label, .settings-block/
// .settings-row) rather than one-off inline styling, so it reads consistently with the rest of
// the shell instead of as a bolted-on panel.
//
// Every panel is a read-only consumer of an already-built endpoint; nothing here fabricates a
// number it cannot actually read. Deep management (invites, payout destinations, connecting
// apps, adding products) stays on the business's own /spaces/:id page — this is an overview with
// a link there, not a re-implementation of it.
//
// Authoring — writing a skill, editing the system prompt — is deliberately NOT here. Those are
// builder operations against the operator's own accumulated work, and the end-user shell is a
// structurally different population; the builder dashboard is where that belongs.

import * as React from "react";
import Link from "next/link";
import { Card, CardLabel, CardValue, CardSub, Badge, type BadgeColor } from "@naelao/ui";
import { ALLOWED_MODELS, effortOptionsForModel, isValidEffortLevel } from "@naelao/billing-core";
import { useProduct } from "@/lib/product-context";
import { useSessionCredentials } from "@/lib/auth-provider";
import { useActiveSpace } from "@/lib/active-space-context";
import {
  getAssistantPolicy,
  updateAssistantPolicy,
  updateModelConfig,
  getAssistantMemory,
  getAssistantCapabilities,
  listScheduledJobs,
  listAssistantChannels,
  listAssistantFiles,
  listSessions,
  listAgentDefinitions,
  getMe,
  listMyBusinesses,
  getShellManifest,
  listBusinessMembers,
  getBusinessWalletBalance,
  getBusinessWalletTransactions,
  getBusinessRevenue,
  listBusinessOrders,
  getConnectorStatus,
  listApprovals,
  getBusinessAnalytics,
  type AssistantPolicy,
  type MemoryFact,
  type AssistantCapabilities,
  type ScheduledJob,
  type ChannelLink,
  type WorkspaceFile,
  type SessionSummary,
  type AgentDefinitionSummary,
  type ProductUserMe,
  type Business,
  type WhopWalletBalance,
  type WhopWalletTransaction,
  type RevenueSummary,
  type LaunchpadOrder,
  type ConnectorInfo,
  type PendingApproval,
  type BusinessAnalytics,
} from "@/lib/api";
import { relativeTime } from "@/lib/relativeTime";
import { ApprovedActionsEditor } from "@/components/ApprovedActionsEditor";
import { canManageSpaceSettings } from "@/lib/roles";

/** Same curated allowlist + default the dashboard's own Configuration tab picker uses — kept as
 *  a parallel copy rather than a new shared export (this codebase's own precedent for a small
 *  duplicated label map, e.g. mcp-hub/credentials each holding their own token helper — see
 *  item 58). An id with no entry falls back to the id itself. */
const DEFAULT_MODEL = "@cf/meta/llama-3.3-70b-instruct-fp8-fast";
const MODEL_LABELS: Record<string, string> = {
  "claude-haiku-4-5-20251001": "Haiku — needs Anthropic on the gateway",
  "claude-sonnet-4-6": "Sonnet — needs Anthropic on the gateway",
  "claude-opus-4-8": "Opus — needs Anthropic on the gateway",
  "@cf/meta/llama-3.3-70b-instruct-fp8-fast": "Llama 3.3 70B — balanced default",
  "@cf/meta/llama-4-scout-17b-16e-instruct": "Llama 4 Scout — fast",
  "@cf/openai/gpt-oss-120b": "GPT-OSS 120B — most capable",
  "@cf/openai/gpt-oss-20b": "GPT-OSS 20B — cheap",
  "@cf/qwen/qwen3-30b-a3b-fp8": "Qwen3 30B",
  "@cf/mistralai/mistral-small-3.1-24b-instruct": "Mistral Small",
  "@cf/ibm-granite/granite-4.0-h-micro": "Granite Micro — cheapest",
  "@cf/google/gemma-4-26b-a4b-it": "Gemma 4 26B",
  "@cf/zai-org/glm-4.7-flash": "GLM 4.7 Flash",
  "@cf/zai-org/glm-5.2": "GLM 5.2",
  "@cf/nvidia/nemotron-3-120b-a12b": "Nemotron 3 120B",
  "@cf/moonshotai/kimi-k2.6": "Kimi K2.6",
  "@cf/moonshotai/kimi-k2.7-code": "Kimi K2.7 Code",
  "google-ai-studio/gemini-flash-lite-latest": "Gemini Flash-Lite — needs a Google AI Studio key",
  "google-ai-studio/gemini-flash-latest": "Gemini Flash — needs a Google AI Studio key",
  "google-ai-studio/gemini-pro-latest": "Gemini Pro — needs a Google AI Studio key",
};

function centsToDisplay(cents: number, currency = "USD"): string {
  return new Intl.NumberFormat("en-US", { style: "currency", currency, minimumFractionDigits: 2 }).format(cents / 100);
}

function walletBadge(status: WhopWalletBalance["status"] | undefined): BadgeColor {
  if (status === "active") return "green";
  if (status === "awaiting_kyc" || status === "pending") return "amber";
  if (status === "error") return "red";
  return "blue";
}

function pctChange(n: number | null): string {
  if (n === null) return "";
  const sign = n > 0 ? "↑" : n < 0 ? "↓" : "→";
  return `${sign} ${Math.abs(n)}% vs prior period`;
}

type AnalyticsWindow = "7d" | "30d" | "90d";

// A KPI tile — the real @naelao/ui Card, non-interactive (no hover/click affordance; these are
// numbers to read, not buttons).
function Stat({
  label,
  value,
  sub,
  badge,
  href,
}: {
  label: string;
  value: string;
  sub?: string | undefined;
  badge?: { color: BadgeColor; text: string } | undefined;
  /** When set, the whole tile becomes a real link (e.g. "Waiting on you" -> /approvals) — only
   *  worth doing for a number that has somewhere useful to go, never every tile. */
  href?: string | undefined;
}) {
  const body = (
    <Card interactive={Boolean(href)}>
      <CardLabel>{label}</CardLabel>
      <CardValue>{value}</CardValue>
      {badge ? (
        <div style={{ marginTop: 4 }}>
          <Badge color={badge.color}>{badge.text}</Badge>
        </div>
      ) : sub ? (
        <CardSub>{sub}</CardSub>
      ) : null}
    </Card>
  );
  return href ? <Link href={href} style={{ textDecoration: "none", color: "inherit" }}>{body}</Link> : body;
}

function SectionHeading({ children, action }: { children: React.ReactNode; action?: React.ReactNode }) {
  return (
    <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", margin: "26px 0 12px" }}>
      <div className="section-label" style={{ margin: 0 }}>{children}</div>
      {action}
    </div>
  );
}

// A boxed list panel — the .settings-block/.settings-row pattern used everywhere else in the
// shell (business detail, settings), with a small header row added so it can carry a title +
// count the way the rest of this dashboard's tiles do.
function Panel({
  title,
  count,
  children,
}: {
  title: string;
  count?: number | undefined;
  children: React.ReactNode;
}) {
  return (
    <div className="settings-block" style={{ marginBottom: 0 }}>
      <div className="settings-row" style={{ borderBottom: "1px solid var(--border)" }}>
        <div className="settings-row-label" style={{ marginBottom: 0 }}>
          {title}
          {count !== undefined && <span style={{ color: "var(--text3)", fontWeight: 400, marginLeft: 6 }}>{count}</span>}
        </div>
      </div>
      <div style={{ padding: "8px 16px 12px", fontSize: 12.5, color: "var(--text2)" }}>{children}</div>
    </div>
  );
}

function Empty({ children }: { children: React.ReactNode }) {
  return <div style={{ color: "var(--text3)", fontSize: 12, padding: "4px 0" }}>{children}</div>;
}

function Row({ left, right }: { left: React.ReactNode; right?: React.ReactNode | undefined }) {
  return (
    <div style={{ display: "flex", alignItems: "center", gap: 8, padding: "4px 0" }}>
      <div style={{ flex: 1, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{left}</div>
      {right !== undefined && <div style={{ color: "var(--text3)", fontSize: 11, flexShrink: 0 }}>{right}</div>}
    </div>
  );
}

const panelGrid: React.CSSProperties = {
  display: "grid",
  gridTemplateColumns: "repeat(auto-fill, minmax(320px, 1fr))",
  gap: 14,
};

export default function DashboardPage() {
  const product = useProduct();
  const creds = useSessionCredentials();
  const { activeSpaceId, activeSpaceName, isBusinessSpace } = useActiveSpace();

  // Assistant dashboard state (unchanged from the prior standalone page).
  const [policy, setPolicy] = React.useState<AssistantPolicy | null>(null);
  const [capabilities, setCapabilities] = React.useState<AssistantCapabilities | null>(null);
  const [memory, setMemory] = React.useState<MemoryFact[]>([]);
  const [crons, setCrons] = React.useState<ScheduledJob[]>([]);
  const [channels, setChannels] = React.useState<ChannelLink[]>([]);
  const [files, setFiles] = React.useState<WorkspaceFile[]>([]);
  const [sessions, setSessions] = React.useState<SessionSummary[]>([]);
  const [agents, setAgents] = React.useState<AgentDefinitionSummary[]>([]);

  // Business dashboard state — only fetched/rendered when the active space is a real business.
  const [me, setMe] = React.useState<ProductUserMe | null>(null);
  const [business, setBusiness] = React.useState<Business | null>(null);
  const [wallet, setWallet] = React.useState<WhopWalletBalance | null>(null);
  const [walletTx, setWalletTx] = React.useState<WhopWalletTransaction[]>([]);
  const [hasCommerce, setHasCommerce] = React.useState(false);
  const [revenue, setRevenue] = React.useState<RevenueSummary | null>(null);
  const [orders, setOrders] = React.useState<LaunchpadOrder[]>([]);
  const [members, setMembers] = React.useState<{ end_user_id: string; role: string }[]>([]);
  const [connectors, setConnectors] = React.useState<ConnectorInfo[]>([]);
  const [approvals, setApprovals] = React.useState<PendingApproval[]>([]);
  const [currentModel, setCurrentModel] = React.useState<string | null>(null);
  const [currentEffort, setCurrentEffort] = React.useState<string | null>(null);

  // Analytics — the same real GET /business-analytics rollup the dedicated /analytics page reads,
  // embedded here so the headline numbers don't need a navigation away from the overview. Fetched
  // on its own effect (keyed on the window toggle too) so switching 7d/30d/90d doesn't re-trigger
  // the whole page's "Loading…" flag or re-fetch every other panel.
  const [analytics, setAnalytics] = React.useState<BusinessAnalytics | null>(null);
  const [analyticsWindow, setAnalyticsWindow] = React.useState<AnalyticsWindow>("7d");
  const [analyticsLoading, setAnalyticsLoading] = React.useState(true);
  const [analyticsError, setAnalyticsError] = React.useState(false);

  const [loading, setLoading] = React.useState(true);
  const [savingPolicy, setSavingPolicy] = React.useState(false);
  const [savingModel, setSavingModel] = React.useState(false);
  const [controlError, setControlError] = React.useState<string | null>(null);

  React.useEffect(() => {
    if (!creds || !activeSpaceId) return;
    let cancelled = false;
    setLoading(true);
    // Each panel settles independently: one unavailable endpoint must not blank the whole page.
    const settle = <T,>(p: Promise<T>, set: (v: T) => void) =>
      p.then((v) => { if (!cancelled) set(v); }).catch(() => {});

    const calls: Promise<unknown>[] = [
      settle(getAssistantPolicy(activeSpaceId, creds), setPolicy),
      settle(getAssistantCapabilities(activeSpaceId, creds), setCapabilities),
      settle(getAssistantMemory(activeSpaceId, creds), setMemory),
      settle(listScheduledJobs(activeSpaceId, creds), setCrons),
      settle(listAssistantChannels(activeSpaceId, creds), setChannels),
      settle(listAssistantFiles(activeSpaceId, creds), setFiles),
      settle(listSessions(activeSpaceId, creds), setSessions),
      settle(listAgentDefinitions(activeSpaceId, creds), setAgents),
      // The PRODUCT root, never the active business. A ProductUserDO instance is one per
      // (productId × endUserId), so asking for "me" scoped to a business 404s — which is exactly
      // why "Your credits" sat at "…" forever inside a business. Credits belong to the person at
      // product level; they are not per-business.
      settle(getMe(product.space_id, creds), setMe),
      settle(listApprovals(activeSpaceId, creds), setApprovals),
      // Always fetched (not just for a business): this is where the configured model lives for
      // any space, and it's what previously silently defaulted to an unreachable Claude id with
      // no visible control anywhere (item 79).
      getShellManifest(activeSpaceId, creds)
        .then((m) => {
          if (cancelled) return;
          setCurrentModel(m.model ?? null);
          setCurrentEffort(m.effort ?? null);
          const commerce = m.ui.sidebar_items.some((item) => item.id === "revenue");
          setHasCommerce(commerce);
          if (!commerce || !isBusinessSpace) return;
          return Promise.all([
            settle(getBusinessRevenue(activeSpaceId, creds), setRevenue),
            settle(listBusinessOrders(activeSpaceId, creds), setOrders),
          ]).then(() => undefined);
        })
        .catch(() => {}),
    ];

    if (isBusinessSpace) {
      calls.push(
        settle(
          listMyBusinesses(product.space_id, creds).then((list) => list.find((b) => b.id === activeSpaceId) ?? null),
          setBusiness
        ),
        settle(getBusinessWalletBalance(activeSpaceId, creds), setWallet),
        settle(getBusinessWalletTransactions(activeSpaceId, creds, 6), setWalletTx),
        settle(listBusinessMembers(activeSpaceId, creds), setMembers),
        settle(getConnectorStatus(activeSpaceId, creds), setConnectors)
      );
    } else {
      setBusiness(null);
      setWallet(null);
      setWalletTx([]);
      setHasCommerce(false);
      setRevenue(null);
      setOrders([]);
      setMembers([]);
      setConnectors([]);
    }

    Promise.allSettled(calls).finally(() => { if (!cancelled) setLoading(false); });

    return () => { cancelled = true; };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [creds, activeSpaceId, isBusinessSpace, product.space_id]);

  const [analyticsRetryTick, setAnalyticsRetryTick] = React.useState(0);
  React.useEffect(() => {
    if (!creds || !activeSpaceId) return;
    let cancelled = false;
    setAnalyticsLoading(true);
    setAnalyticsError(false);
    getBusinessAnalytics(activeSpaceId, creds, analyticsWindow)
      .then((v) => { if (!cancelled) setAnalytics(v); })
      .catch(() => { if (!cancelled) setAnalyticsError(true); })
      .finally(() => { if (!cancelled) setAnalyticsLoading(false); });
    return () => { cancelled = true; };
  }, [creds, activeSpaceId, analyticsWindow, analyticsRetryTick]);

  // item 79: the guided/autonomous toggle and model picker are real writes, not display-only —
  // gated to the same floor requireBusinessMembership enforces server-side. A plain member (or a
  // non-business/team-mode space, where an end user is never more than "member") sees the same
  // panel read-only. Ranked, not exact-match — see lib/roles.ts for why that distinction is what
  // this pass was reported for.
  const canManageAssistant = canManageSpaceSettings(isBusinessSpace, business?.role);

  async function setAutonomy(autonomous: boolean) {
    if (!activeSpaceId || !creds) return;
    setSavingPolicy(true);
    setControlError(null);
    try {
      const next = await updateAssistantPolicy(activeSpaceId, creds, { approval_mode: autonomous ? "yolo" : "always_ask" });
      setPolicy(next);
    } catch (err) {
      setControlError(err instanceof Error ? err.message : "Couldn't update autonomy");
    } finally {
      setSavingPolicy(false);
    }
  }

  async function addApprovedAction(action: string) {
    if (!activeSpaceId || !creds || !policy) return;
    setSavingPolicy(true);
    setControlError(null);
    try {
      const next = await updateAssistantPolicy(activeSpaceId, creds, {
        auto_approved_actions: [...policy.auto_approved_actions, action],
      });
      setPolicy(next);
    } catch (err) {
      setControlError(err instanceof Error ? err.message : "Couldn't update the allowlist");
    } finally {
      setSavingPolicy(false);
    }
  }

  async function removeApprovedAction(action: string) {
    if (!activeSpaceId || !creds || !policy) return;
    setSavingPolicy(true);
    setControlError(null);
    try {
      const next = await updateAssistantPolicy(activeSpaceId, creds, {
        auto_approved_actions: policy.auto_approved_actions.filter((a) => a !== action),
      });
      setPolicy(next);
    } catch (err) {
      setControlError(err instanceof Error ? err.message : "Couldn't update the allowlist");
    } finally {
      setSavingPolicy(false);
    }
  }

  async function setModel(model: string) {
    if (!activeSpaceId || !creds) return;
    setSavingModel(true);
    setControlError(null);
    try {
      const keepEffort = currentEffort && isValidEffortLevel(model, currentEffort) ? currentEffort : undefined;
      const next = await updateModelConfig(activeSpaceId, creds, model, keepEffort);
      setCurrentModel(next.model);
      setCurrentEffort(next.effort ?? keepEffort ?? null);
    } catch (err) {
      setControlError(err instanceof Error ? err.message : "Couldn't update the model");
    } finally {
      setSavingModel(false);
    }
  }

  async function setEffort(effort: string) {
    if (!activeSpaceId || !creds) return;
    setSavingModel(true);
    setControlError(null);
    try {
      const next = await updateModelConfig(activeSpaceId, creds, currentModel ?? DEFAULT_MODEL, effort);
      setCurrentEffort(next.effort ?? effort);
    } catch (err) {
      setControlError(err instanceof Error ? err.message : "Couldn't update the effort setting");
    } finally {
      setSavingModel(false);
    }
  }

  if (!creds) return null;

  const modeLabel =
    policy?.approval_mode === "yolo"
      ? "Autonomous"
      : policy?.approval_mode === "gate_unless_listed"
        ? "Guided"
        : policy?.approval_mode === "gate_listed"
          ? "Mostly autonomous"
          : policy?.approval_mode === "always_ask"
            ? "Asks before acting"
            : "—";
  const isAutonomous = policy?.approval_mode === "yolo";

  const heading = isBusinessSpace ? (business?.name ?? activeSpaceName ?? "Business") : (activeSpaceName ?? product.product_name);
  const connectedApps = connectors.filter((c) => c.connected).length;
  const availableApps = connectors.filter((c) => c.status === "available").length;

  return (
    <div className="page-view">
      <div className="page-header" style={{ display: "flex", alignItems: "flex-start", justifyContent: "space-between", gap: 12, flexWrap: "wrap" }}>
        <div>
          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
            <div className="page-title" style={{ marginBottom: 0 }}>{heading}</div>
            {isBusinessSpace && business && (
              <Badge color={business.space_status === "active" ? "green" : "amber"}>{business.space_status}</Badge>
            )}
          </div>
          <div className="page-subtitle">
            {isBusinessSpace
              ? `Your role: ${business?.role ?? "…"} — the assistant is always on and works across every project here.`
              : "Always on. Works across every project in this space, and can be reached over your connected channels."}
          </div>
        </div>
        <div style={{ display: "flex", gap: 8, flexShrink: 0 }}>
          {isBusinessSpace && (
            <Link href={`/p/${product.slug}/spaces/${activeSpaceId}`} className="btn btn-secondary" style={{ textDecoration: "none" }}>
              Manage business
            </Link>
          )}
          <Link href={`/p/${product.slug}/new`} className="btn btn-primary" style={{ textDecoration: "none" }}>
            Talk to the assistant
          </Link>
        </div>
      </div>

      {loading && <div style={{ fontSize: 12.5, color: "var(--text3)", marginBottom: 14 }}>Loading…</div>}

      {/* KPI row — the numbers worth seeing at a glance. */}
      <div style={{ ...panelGrid, gridTemplateColumns: "repeat(auto-fit, minmax(160px, 1fr))", marginBottom: 8 }}>
        <Stat label="Your credits" value={me ? String(me.credits_balance) : "…"} />
        {isBusinessSpace && (
          <Stat
            label="Wallet balance"
            value={wallet ? centsToDisplay(wallet.balance_cents ?? 0, wallet.currency) : "…"}
            badge={
              wallet && wallet.status !== "active"
                ? { color: walletBadge(wallet.status), text: wallet.status.replace("_", " ") }
                : undefined
            }
          />
        )}
        {isBusinessSpace && hasCommerce && (
          <Stat
            label={`Revenue (${revenue?.period ?? "this month"})`}
            value={revenue ? centsToDisplay(revenue.net_cents, revenue.currency) : "…"}
            sub={revenue ? `${revenue.order_count} order${revenue.order_count === 1 ? "" : "s"}` : undefined}
          />
        )}
        {isBusinessSpace && (
          <Stat label="Members" value={String(members.length)} href={`/p/${product.slug}/spaces/${activeSpaceId}`} />
        )}
        {isBusinessSpace && (
          <Stat
            label="Connected apps"
            value={String(connectedApps)}
            sub={availableApps > 0 ? `of ${availableApps} available` : undefined}
            href={`/p/${product.slug}/connectors`}
          />
        )}
        <Stat
          label="Waiting on you"
          value={String(approvals.length)}
          badge={approvals.length > 0 ? { color: "amber", text: "Needs a decision" } : undefined}
          href={approvals.length > 0 ? `/p/${product.slug}/approvals` : undefined}
        />
      </div>

      {/* Analytics — the same real GET /business-analytics rollup the dedicated /analytics page
          renders, embedded here so credit usage, run success, and background activity are visible
          without leaving the overview. */}
      <SectionHeading
        action={
          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
            <div style={{ display: "flex", gap: 4 }}>
              {(["7d", "30d", "90d"] as AnalyticsWindow[]).map((w) => (
                <button
                  key={w}
                  type="button"
                  className="btn btn-ghost btn-sm"
                  style={analyticsWindow === w ? { background: "var(--accent-dim)", color: "var(--accent)", borderColor: "var(--accent)" } : undefined}
                  onClick={() => setAnalyticsWindow(w)}
                >
                  {w}
                </button>
              ))}
            </div>
            <Link href={`/p/${product.slug}/analytics`} style={{ fontSize: 12, color: "var(--accent)", textDecoration: "none" }}>
              Full page →
            </Link>
          </div>
        }
      >
        Analytics
      </SectionHeading>

      {analyticsLoading && !analytics && <div style={{ fontSize: 12.5, color: "var(--text3)", marginBottom: 10 }}>Loading…</div>}
      {analyticsError && (
        <div style={{ fontSize: 12.5, color: "#dc2626", marginBottom: 10 }}>
          Couldn&apos;t load analytics.{" "}
          <button type="button" className="btn btn-ghost btn-sm" onClick={() => setAnalyticsRetryTick((t) => t + 1)}>
            Retry
          </button>
        </div>
      )}

      {analytics && (
        <>
          <div className="grid-4" style={{ marginBottom: 20 }}>
            <div className="card" style={{ cursor: "default" }}>
              <div className="card-label">Credits used</div>
              <div className="card-value">{analytics.credits.used.toLocaleString()}</div>
              {analytics.credits.vs_prior_period !== null && (
                <div className="card-sub" style={{ color: analytics.credits.vs_prior_period > 0 ? "#16a34a" : "#dc2626" }}>
                  {pctChange(analytics.credits.vs_prior_period)}
                </div>
              )}
            </div>
            <div className="card" style={{ cursor: "default" }}>
              <div className="card-label">Agent runs</div>
              <div className="card-value">{analytics.runs.total.toLocaleString()}</div>
              <div className="card-sub">Across {analytics.by_agent.length} agent{analytics.by_agent.length === 1 ? "" : "s"}</div>
            </div>
            <div className="card" style={{ cursor: "default" }}>
              <div className="card-label">Success rate</div>
              <div className="card-value">{analytics.runs.success_rate !== null ? `${Math.round(analytics.runs.success_rate * 100)}%` : "—"}</div>
              <div className="card-sub">{analytics.runs.failed} failed of {analytics.runs.total}</div>
            </div>
            <div className="card" style={{ cursor: "default" }}>
              <div className="card-label">Tokens used</div>
              <div className="card-value">{analytics.tokens_used >= 1000 ? `${(analytics.tokens_used / 1000).toFixed(1)}k` : analytics.tokens_used}</div>
              <div className="card-sub">This period</div>
            </div>
          </div>

          <div className="card" style={{ cursor: "default", padding: "16px 18px 12px", marginBottom: 14 }}>
            <div style={{ fontSize: 12, fontWeight: 600, color: "var(--text2)", marginBottom: 10 }}>
              Credit usage — last {analytics.window_days} days
            </div>
            {analytics.daily.every((d) => d.credits === 0) ? (
              <div style={{ color: "var(--text3)", fontSize: 12, padding: "16px 0", textAlign: "center" }}>No activity yet in this window.</div>
            ) : (
              <div style={{ display: "flex", alignItems: "flex-end", gap: 3, height: 76 }}>
                {analytics.daily.map((d) => {
                  const maxCredits = Math.max(1, ...analytics.daily.map((x) => x.credits));
                  return (
                    <div key={d.day} title={`${d.day}: ${d.credits} credits, ${d.runs} runs`} style={{ flex: 1, display: "flex", flexDirection: "column", alignItems: "center" }}>
                      <div
                        style={{
                          width: "100%",
                          borderRadius: 3,
                          background: "var(--accent)",
                          opacity: d.credits > 0 ? 1 : 0.15,
                          height: Math.max(2, (d.credits / maxCredits) * 68),
                        }}
                      />
                    </div>
                  );
                })}
              </div>
            )}
          </div>

          {/* Structure + heartbeats — pulled out of a buried settings-block into real stat tiles.
              The assistant wakes on its own via heartbeats/crons whether or not anyone is watching;
              this is what makes that background work (and when it's failing) actually visible,
              alongside how much workspace (projects/threads) it's operating across. */}
          <div style={{ fontSize: 11.5, fontWeight: 600, color: "var(--text3)", letterSpacing: "0.04em", textTransform: "uppercase", margin: "0 0 8px" }}>
            Background activity — heartbeats &amp; workspace
          </div>
          <div className="grid-4" style={{ marginBottom: 10 }}>
            <div className="card" style={{ cursor: "default" }}>
              <div className="card-label">Projects</div>
              <div className="card-value">{analytics.structure.projects}</div>
              <div className="card-sub">Workspaces in this business</div>
            </div>
            <div className="card" style={{ cursor: "default" }}>
              <div className="card-label">Threads</div>
              <div className="card-value">{analytics.structure.threads}</div>
              <div className="card-sub">Across all projects</div>
            </div>
            <div className="card" style={{ cursor: "default" }}>
              <div className="card-label">Heartbeats — did work</div>
