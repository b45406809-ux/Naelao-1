    <span style="font-family:'DM Mono',monospace;font-size:11px;background:#E8692A22;color:#E8692A;border:1px solid #E8692A44;padding:4px 10px;border-radius:4px;">14 HIGH</span>
    <span style="font-family:'DM Mono',monospace;font-size:11px;background:#EAB30822;color:#EAB308;border:1px solid #EAB30844;padding:4px 10px;border-radius:4px;">5 MEDIUM</span>
  </div>
