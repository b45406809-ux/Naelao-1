Code
<span class="cm">-- Versioning: Every manifest revision is immutable</span>
CREATE TABLE IF NOT EXISTS manifest_versions (
  type_id         TEXT NOT NULL REFERENCES space_types(id),
  version         TEXT NOT NULL,    <span class="cm">-- SemVer string</span>
  manifest_json   TEXT NOT NULL,    <span class="cm">-- The full NaelaoSpaceTypeManifestV2</span>
  change_log      TEXT,
  canary_percent  INTEGER DEFAULT 0, <span class="cm">-- 0-100 for rollout control</span>
  published_at    INTEGER DEFAULT (unixepoch('now') * 1000),
  PRIMARY KEY (type_id, version)
);

<span class="cm">-- Developer Earnings (Micropayment ledger for type creators)</span>
CREATE TABLE IF NOT EXISTS registry_earnings (
  id              TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
  author_id       TEXT NOT NULL,
  amount_usd      REAL NOT NULL,
  source_space_id TEXT NOT NULL,
  processed_at    INTEGER DEFAULT (unixepoch('now') * 1000)
);
`);
}</code></pre>
        <div class="box box-pu">
          <div class="box-lbl">The Canary Rollout Protocol</div>
          <p>Naelao supports <strong>Canary Provisioning</strong> for Space Types. When a community developer pushes a
            "Minor" version (v1.1.0), the Registry DO updates the <code>canary_percent</code> to 5%. For the next 24
            hours, only 5% of new Spaces created with that Type will use the new manifest. The
            <code>naelao-analytics</code> Worker monitors these canary instances for 4xx/5xx spikes. If healthy, the
            registry auto-promotes to 100%.</p>
        </div>
        <h3>Registering a Type — The Security Handshake</h3>
        <pre><code><span class="cm">// Called by naelao-admin after passing the 31-pattern scanner</span>
async registerType(params: { manifest: ManifestV2, authorId: string }) {
<span class="cm">// Validate author authority</span>
if (params.manifest.id.startsWith('naelao.') &amp;&amp; params.authorId !== 'naelao') {
throw new Error('Forbidden: Reserved namespace');
}
<span class="cm">// Store manifest in SQLite</span>
this.ctx.storage.sql.exec(INSERT INTO manifest_versions (type_id, version, manifest_json) VALUES (?, ?, ?),
params.manifest.id, params.manifest.version, JSON.stringify(params.manifest)
);
<span class="cm">// Update KV cache for high-speed read access in naelao-spaces</span>
await this.env.NAELAO_CONFIG_KV.put(
manifest:${params.manifest.id}:${params.manifest.version},
JSON.stringify(params.manifest)
);
}</code></pre>
