      color: var(--mt);
      line-height: 1.58;
    }

    .cve-fix strong {
      color: var(--gr);
    }

    /* ─── SPEC GRID ───────────────────────────────── */
    .sg {
      display: grid;
      grid-template-columns: 190px 1fr;
      gap: 0;
      border: 1px solid var(--brd);
      border-radius: 8px;
      overflow: hidden;
      margin: 14px 0;
    }

    .sk {
      background: var(--bg3);
      padding: 9px 13px;
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      color: var(--or);
      border-bottom: 1px solid var(--brd);
      font-weight: 500;
