═══════════════════════════════════════════════════════ -->
  <div class="sep"></div>
  <div class="sec" id="concurrency-do">
    <span class="sec-ey">28 — DO Deep Dive: ConcurrencyDO</span>
    <h2>ConcurrencyDO — Rate Limiting & Run Gating</h2>
    <div class="bar"></div>
    <p class="lead">ConcurrencyDO is a small but critical Durable Object. It enforces how many agent runs a user can
      have active simultaneously. Without it, a single user could consume all available containers and block everyone
      else. This section covers the complete implementation including the circuit breaker pattern for protecting
      downstream services.</p>

    <h3>Complete ConcurrencyDO Implementation</h3>
    <pre><code><span class="cm">// durable-objects/concurrency-do.ts
// One per (spaceId, userId) pair.
// ID: idFromName(`concurrency:${spaceId}:${userId}`)
// Enforces concurrent run limits per billing tier.</span>

const TIER_LIMITS: Record&lt;string, number&gt; = {
  free:       1,   <span class="cm">// 1 concurrent run</span>
  maker:      3,   <span class="cm">// 3 concurrent runs</span>
  pro:        10,  <span class="cm">// 10 concurrent runs</span>
  team:       25,  <span class="cm">// 25 concurrent runs</span>
  enterprise: 100, <span class="cm">// 100 concurrent runs</span>
};

export class ConcurrencyDO extends DurableObject {
  private async initSchema() {
    this.ctx.storage.sql.exec(`
      CREATE TABLE IF NOT EXISTS active_runs (
        run_id      TEXT PRIMARY KEY,
        thread_id   TEXT NOT NULL,
        started_at  INTEGER NOT NULL DEFAULT (unixepoch('now') * 1000),
        heartbeat   INTEGER NOT NULL DEFAULT (unixepoch('now') * 1000),
        mode        TEXT NOT NULL DEFAULT 'foreground'  <span class="cm">-- foreground|background</span>
      );

      CREATE TABLE IF NOT EXISTS config (
        key   TEXT PRIMARY KEY,
        value TEXT NOT NULL
      );

      INSERT OR IGNORE INTO config VALUES ('billing_tier', 'free');
    `);
  }

  async checkAndReserve(params: {
    runId: string;
    threadId: string;
    billingTier: string;
    mode: 'foreground' | 'background';
  }): Promise&lt;{ allowed: boolean; activeCount: number; limit: number }&gt; {

    <span class="cm">// Clean up expired runs first (runs with no heartbeat for &gt;5 minutes)
    // This prevents phantom runs from blocking the user indefinitely</span>
    const staleThreshold = Date.now() - 5 * 60 * 1000; <span class="cm">// 5 minutes</span>
    this.ctx.storage.sql.exec(
      'DELETE FROM active_runs WHERE heartbeat &lt; ?', staleThreshold
    );

    const limit = TIER_LIMITS[params.billingTier] ?? TIER_LIMITS.free;
    const activeCount = this.ctx.storage.sql
      .exec('SELECT COUNT(*) as c FROM active_runs')
      .one()?.c as number ?? 0;

    if (activeCount &gt;= limit) {
      return { allowed: false, activeCount, limit };
    }

    <span class="cm">// Reserve a slot for this run</span>
    this.ctx.storage.sql.exec(
      'INSERT INTO active_runs (run_id, thread_id, mode) VALUES (?, ?, ?)',
      params.runId, params.threadId, params.mode
    );

    <span class="cm">// Set an alarm to auto-release this slot if heartbeat stops
    // The agent must call heartbeat() every 2 minutes to keep the slot</span>
    await this.ctx.storage.setAlarm(Date.now() + 5 * 60 * 1000);

    return { allowed: true, activeCount: activeCount + 1, limit };
  }

  <span class="cm">// Called by AgentDO every 2 minutes during an active run</span>
  async heartbeat(runId: string): Promise&lt;void&gt; {
    this.ctx.storage.sql.exec(
      'UPDATE active_runs SET heartbeat = ? WHERE run_id = ?',
      Date.now(), runId
    );
  }

  <span class="cm">// Called when a run completes (successfully or with error)</span>
  async releaseSlot(runId: string): Promise&lt;void&gt; {
    this.ctx.storage.sql.exec(
      'DELETE FROM active_runs WHERE run_id = ?', runId
    );
  }

  <span class="cm">// Called by DO Alarm when a slot hasn't had a heartbeat for 5 minutes</span>
  async alarm(): Promise&lt;void&gt; {
    const staleThreshold = Date.now() - 5 * 60 * 1000;
    const staleRuns = this.ctx.storage.sql
      .exec('SELECT run_id FROM active_runs WHERE heartbeat &lt; ?', staleThreshold)
      .toArray();

    if (staleRuns.length &gt; 0) {
      this.ctx.storage.sql.exec(
        'DELETE FROM active_runs WHERE heartbeat &lt; ?', staleThreshold
      );
      <span class="cm">// Log to analytics for monitoring</span>
      for (const run of staleRuns) {
        console.warn(`[NAELAO] Auto-released stale run slot: ${run.run_id}`);
      }
    }

    <span class="cm">// Set next alarm if there are still active runs</span>
    const remaining = this.ctx.storage.sql
      .exec('SELECT COUNT(*) as c FROM active_runs').one()?.c as number ?? 0;
    if (remaining &gt; 0) {
      await this.ctx.storage.setAlarm(Date.now() + 5 * 60 * 1000);
    }
  }

  async getStatus(): Promise&lt;{ activeRuns: unknown[]; limit: number; billingTier: string }&gt; {
    const billingTier = this.ctx.storage.sql
      .exec("SELECT value FROM config WHERE key = 'billing_tier'")
      .one()?.value as string ?? 'free';

    const activeRuns = this.ctx.storage.sql
      .exec('SELECT * FROM active_runs ORDER BY started_at')
      .toArray();

    return { activeRuns, limit: TIER_LIMITS[billingTier], billingTier };
  }
}</code></pre>
