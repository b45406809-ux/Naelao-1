export function parseTraceparent(header: string): Partial&lt;TraceContext&gt; | null {
  const parts = header.split(&#x27;-&#x27;);
  if (parts.length &lt; 4 || parts[0] !== &#x27;00&#x27;) return null;
  return { traceId: parts[1], spanId: parts[2] };
