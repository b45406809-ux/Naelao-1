app.get('/audit/:spaceId', async (c) =&gt; {
  const { spaceId } = c.req.param();
  const { eventType, limit = '100', startTs, endTs } = c.req.query();

  const conditions = [`index1 = '${spaceId}'`];
  if (eventType) conditions.push(`blob1 = '${eventType}'`);
  if (startTs)   conditions.push(`timestamp &gt;= toDateTime(${startTs})`);
  if (endTs)     conditions.push(`timestamp &lt;= toDateTime(${endTs})`);

  const query = `SELECT timestamp, blob1 AS event_type, blob2 AS actor_id, blob3 AS details, double1 AS amount
    FROM naelao_analytics WHERE ${conditions.join(' AND ')} ORDER BY timestamp DESC LIMIT ${parseInt(limit)}`;

  const resp = await fetch(`https://api.cloudflare.com/client/v4/accounts/${c.env.NAELAO_ACCOUNT_ID}/analytics_engine/sql`, {
    method: 'POST', headers: { 'Authorization': `Bearer ${c.env.CF_API_TOKEN}` }, body: query
  });
  return c.json(await resp.json());
});

