      <div class="box box-or">
        <div class="box-lbl">Architecture Decision: Naelao Owns Space Types</div>
        <p><strong>Space Types are exclusively authored by Naelao.</strong> Community developers do not create Space
          Types. This decision eliminates the entire class of risks associated with community-authored infrastructure:
          arbitrary provisioner code, third-party RemoteLoop Workers receiving all user conversation data, community
          SpaceDO schema changes against the per-product database, and complex multi-tenant security review pipelines.</p>
        <p>The community contributes through two clean, safe primitives: <strong>Apps</strong> (MCP Servers + UI,
          running on the developer's own Cloudflare account) and <strong>Space Templates</strong> (curated configuration
          bundles with no executable code). Together these create a rich ecosystem without exposing platform
          infrastructure to third-party code.</p>
      </div>

      <p>For the complete community model, see <a href="#community-model">Community Contribution Model</a> and <a
          href="#space-templates">Space Templates</a>. For the App publishing system, see <a
          href="#naelao-apps-registry">Naelao Apps Economy</a>.</p>

      <h3>Scoped Token — Retained for Internal Use</h3>
      <p>The Scoped Token mechanism (short-lived HMAC-signed tokens granting per-space R2 and DB access) is still used
        internally — by RemoteLoop Workers within Naelao-authored Space Types, and by the external portal SDK (<span
          class="ic">@naelao/portal-sdk</span>). It is not exposed to community developers as a general integration
        mechanism.</p>

      <pre><code><span class="cm">// shared/scoped-token.ts — INTERNAL USE ONLY
// Used by: RemoteLoop (Naelao platform types), @naelao/portal-sdk (external portals)
// NOT used by: community Apps (use MCP OAuth instead), Space Templates (no code)</span>

export interface ScopedToken {
  spaceId:     string;
  typeId:      string;
  permissions: string[];    <span class="cm">// subset of declared capabilities from manifest</span>
  expiresAt:   number;      <span class="cm">// short-lived: 5 minutes</span>
  signature:   string;      <span class="cm">// HMAC-SHA256 signed by platform key</span>
}

export async function generateScopedToken(params: {
  spaceId:     string;
  typeId:      string;
  permissions: string[];
  env:         Env;
}): Promise&lt;string&gt; {
  const token: Omit&lt;ScopedToken, 'signature'&gt; = {
    spaceId:     params.spaceId,
    typeId:      params.typeId,
    permissions: params.permissions,
    expiresAt:   Date.now() + 5 * 60 * 1000
  };
  const payload = JSON.stringify(token);
  const key = await crypto.subtle.importKey(
    'raw',
    new TextEncoder().encode(params.env.NAELAO_INTERNAL_TOKEN),
    { name: 'HMAC', hash: 'SHA-256' },
    false, ['sign']
  );
  const sig = await crypto.subtle.sign('HMAC', key, new TextEncoder().encode(payload));
  const signature = btoa(String.fromCharCode(...new Uint8Array(sig)));
  return btoa(JSON.stringify({ ...token, signature }));
}</code></pre>

