#!/usr/bin/env node
// Drive the real Product Shell as a signed-in end user — type a message, send it, watch what
// happens — and screenshot the result. The interactive sibling of shell-screenshot.mjs.
//
// Why not Playwright: this sandbox routes all egress through a MITM proxy that Chromium cannot
// negotiate TLS through (every navigation dies with ERR_CONNECTION_RESET, with or without
// --proxy-server, Playwright's own proxy option, or --disable-http2 — all tried). Cloudflare's
// Browser Rendering REST API runs a real headless Chrome inside Cloudflare's network and is
// reached over an ordinary authenticated HTTPS POST, which the proxy handles fine.
//
// The typing is real DOM interaction, not an API call: React tracks a controlled <textarea>'s
// value through its own descriptor, so setting `.value` directly is invisible to it — the native
// setter has to be called on the prototype and an `input` event dispatched, exactly as a keystroke
// does. Enter is a real KeyboardEvent so the component's own onKeyDown handler runs.
//
// Usage:
//   source .cf-credentials.local
//   node infra/scripts/shell-interact.mjs --url https://naelao-shell.pages.dev/p/launchpad/new \
//     --session-space <productSpaceId> --session-json ./session.json \
//     --type "hello there" [--wait 60000] [--out shot.png]

import fs from "node:fs";

function parseArgs(argv) {
  const out = {};
  for (let i = 0; i < argv.length; i++) {
    if (argv[i].startsWith("--")) { out[argv[i].slice(2)] = argv[i + 1]; i++; }
  }
  return out;
}

/** Runs inside the page. Kept as a plain string so it survives JSON transport unmangled. */
function buildInjector({ sessionKey, sessionValue, text, typeDelayMs }) {
  return `
    (function () {
      try { localStorage.setItem(${JSON.stringify(sessionKey)}, ${JSON.stringify(sessionValue)}); } catch (e) {}
      window.__naelaoLog = [];
      var t0 = Date.now();
      var log = function (m) { window.__naelaoLog.push("+" + (Date.now() - t0) + "ms " + m); };
      log("injected, url=" + location.href);

      // Record every API call the app makes and how it went. Without this a failure shows up only
      // as a message on screen with no way to tell WHICH request produced it.
      var origFetch = window.fetch;
      window.fetch = function (input, init) {
        var url = typeof input === "string" ? input : (input && input.url) || String(input);
        var method = (init && init.method) || (input && input.method) || "GET";
        return origFetch.apply(this, arguments).then(function (res) {
          if (url.indexOf("/v1/") !== -1) log("FETCH " + res.status + " " + method + " " + url.replace(/https?:\\/\\/[^/]+/, ""));
          return res;
        }, function (err) {
          log("FETCH ERROR " + method + " " + url + " :: " + err);
          throw err;
        });
      };

      // Surface the log inside the DOM so the /content response carries it back.
      setInterval(function () {
        var el = document.getElementById("__naelao_probe");
        if (!el) {
          el = document.createElement("pre");
          el.id = "__naelao_probe";
          el.setAttribute("style", "position:fixed;left:-99999px;top:0");
          document.body.appendChild(el);
        }
        el.textContent = "PROBE_START\\n" + window.__naelaoLog.join("\\n") + "\\nPROBE_END";
      }, 1000);

      // React owns the value of a controlled input through its own property descriptor, so a plain
      // assignment is invisible to it. Go through the prototype's native setter and fire the same
      // 'input' event a keystroke produces.
      function setReactValue(el, value) {
        var proto = Object.getPrototypeOf(el);
        var desc = Object.getOwnPropertyDescriptor(proto, "value");
        if (desc && desc.set) desc.set.call(el, value); else el.value = value;
        el.dispatchEvent(new Event("input", { bubbles: true }));
      }

      function findBox() {
        return document.querySelector("textarea.msg-input") || document.querySelector("textarea");
      }

      var tries = 0;
      var iv = setInterval(function () {
        tries++;
        var box = findBox();
        if (!box) { if (tries > 40) { clearInterval(iv); log("NO TEXTAREA FOUND after " + tries); } return; }
        clearInterval(iv);
        log("found textarea after " + tries + " polls");
        box.focus();
        setReactValue(box, ${JSON.stringify(text)});
        log("typed: " + box.value.slice(0, 60));
        setTimeout(function () {
          var evt = new KeyboardEvent("keydown", { key: "Enter", code: "Enter", keyCode: 13, which: 13, bubbles: true, cancelable: true });
          box.dispatchEvent(evt);
          log("pressed Enter");
          // Belt and braces: if the handler didn't fire, click the real send button.
          setTimeout(function () {
            var btn = document.querySelector("button.send-btn");
            if (btn && !btn.disabled) { btn.click(); log("clicked send-btn as fallback"); }
          }, 1200);
        }, ${typeDelayMs});
      }, 250);
    })();
  `;
}

async function main() {
  const args = parseArgs(process.argv.slice(2));
  const accountId = process.env.CLOUDFLARE_ACCOUNT_ID;
  const apiToken = process.env.CLOUDFLARE_API_TOKEN;
  if (!accountId || !apiToken) {
    console.error("Set CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN (`source .cf-credentials.local`)");
    process.exit(1);
  }
  if (!args.url || !args["session-space"] || !args["session-json"]) {
    console.error("Usage: --url <page> --session-space <spaceId> --session-json <path> [--type <text>] [--wait ms] [--out file.png]");
    process.exit(1);
  }

  const session = JSON.parse(fs.readFileSync(args["session-json"], "utf8"));
  const injector = buildInjector({
    sessionKey: `naelao_product_session:${args["session-space"]}`,
    sessionValue: JSON.stringify(session),
    text: args.type ?? "",
    typeDelayMs: Number(args["type-delay"] ?? 800),
  });

  const base = `https://api.cloudflare.com/client/v4/accounts/${accountId}/browser-rendering`;
  const headers = { authorization: `Bearer ${apiToken}`, "content-type": "application/json" };
  // domcontentloaded, not networkidle0: the session has to land in localStorage BEFORE the app
  // hydrates, or the shell's own auth guard bounces to /login first.
  const common = {
    url: args.url,
    viewport: { width: Number(args.width ?? 1400), height: Number(args.height ?? 950) },
    gotoOptions: { waitUntil: "domcontentloaded", timeout: 45000 },
    addScriptTag: [{ content: injector }],
    waitForTimeout: Number(args.wait ?? 45000),
  };

  // The rendered text tells you what actually happened; the screenshot shows how it looked.
  const contentRes = await fetch(`${base}/content`, {
    method: "POST",
    headers,
    body: JSON.stringify(common),
  });
  const contentJson = await contentRes.json().catch(() => ({}));
  if (!contentRes.ok || contentJson.success === false) {
    console.error("content failed:", contentRes.status, JSON.stringify(contentJson).slice(0, 600));
  } else {
    const html = contentJson.result ?? "";
    const text = html
      .replace(/<script[\s\S]*?<\/script>/g, " ")
      .replace(/<style[\s\S]*?<\/style>/g, " ")
      .replace(/<[^>]+>/g, "\n")
      .replace(/&nbsp;/g, " ")
      .replace(/\n{2,}/g, "\n")
      .trim();
    console.log("--- VISIBLE TEXT ---");
    console.log(text.slice(-4000));
    fs.writeFileSync(args["text-out"] ?? "/tmp/shell-interact-text.txt", text);
  }

  const shotRes = await fetch(`${base}/screenshot`, {
    method: "POST",
    headers,
    body: JSON.stringify({ ...common, screenshotOptions: { fullPage: false } }),
  });
  if (!shotRes.ok) {
    console.error("screenshot failed:", shotRes.status, (await shotRes.text()).slice(0, 400));
    process.exit(1);
  }
  const out = args.out ?? "shell-interact.png";
  fs.writeFileSync(out, Buffer.from(await shotRes.arrayBuffer()));
  console.log("screenshot →", out);
}

main().catch((e) => { console.error(e); process.exit(1); });
</file>

<file path="infra/scripts/shell-mobile-check.mjs">
#!/usr/bin/env node
// Verify the mobile off-canvas sidebars actually open, at a real phone viewport, via Cloudflare
// Browser Rendering (Playwright can't TLS-handshake through this sandbox's proxy — see
// shell-screenshot.mjs's own header). Takes a "closed" screenshot, then an "after click"
// screenshot for each --click selector given, in one script per call so state (the session,
// React's mount) survives between them.
//
// Usage:
//   source .cf-credentials.local
//   node infra/scripts/shell-mobile-check.mjs --url <page> --session-space <id> --session-json <path> \
//     --click 'button.mobile-menu-btn' --out-before before.png --out-after after.png [--wait 6000]

import fs from "node:fs";

function parseArgs(argv) {
  const out = {};
  for (let i = 0; i < argv.length; i++) {
    if (argv[i].startsWith("--")) { out[argv[i].slice(2)] = argv[i + 1]; i++; }
  }
  return out;
}

function buildInjector({ sessionKey, sessionValue, activeSpaceKey, activeSpaceValue, clickSelector, clickDelayMs, targetUrl }) {
  return `
    (function () {
      try { localStorage.setItem(${JSON.stringify(sessionKey)}, ${JSON.stringify(sessionValue)}); } catch (e) {}
      ${activeSpaceKey ? `try { sessionStorage.setItem(${JSON.stringify(activeSpaceKey)}, ${JSON.stringify(activeSpaceValue)}); } catch (e) {}` : ""}

      // addScriptTag lands after domcontentloaded, which is a RACE against React hydrating and
      // AuthProvider reading localStorage: win it and the page renders signed in, lose it and the
      // app has already bounced to /login before the session existed. Same shot, same session,
      // different outcome run to run — which silently screenshots the wrong page and reads exactly
      // like a broken product. The session is written by the time we get here either way, so if we
      // find ourselves on /login just go back to the page that was asked for; the reload picks the
      // session up. The flag makes this strictly once, so a genuinely-unauthenticated session can
      // never turn into a redirect loop.
      try {
        var iv2 = setInterval(function () {
          if (!/\\/login(\\?|$)/.test(location.pathname + location.search)) return;
          clearInterval(iv2);
          if (sessionStorage.getItem("__naelao_relogin")) return;
          sessionStorage.setItem("__naelao_relogin", "1");
          location.href = ${JSON.stringify(targetUrl)};
        }, 150);
        setTimeout(function () { clearInterval(iv2); }, 8000);
      } catch (e) {}

      window.__naelaoClicked = false;
      ${clickSelector ? `
      var tries = 0;
      var iv = setInterval(function () {
        tries++;
        var el = document.querySelector(${JSON.stringify(clickSelector)});
        if (el) {
          clearInterval(iv);
          setTimeout(function () { el.click(); window.__naelaoClicked = true; }, ${clickDelayMs});
        } else if (tries > 60) {
          clearInterval(iv);
        }
      }, 200);
      ` : ""}
    })();
  `;
}

async function shoot({ base, headers, url, width, height, session, sessionSpace, activeSpaceId, clickSelector, clickDelayMs, wait, out }) {
  const injector = buildInjector({
    sessionKey: `naelao_product_session:${sessionSpace}`,
    sessionValue: JSON.stringify(session),
    activeSpaceKey: activeSpaceId ? `naelao:active-space:${sessionSpace}` : undefined,
    activeSpaceValue: activeSpaceId ? JSON.stringify({ id: activeSpaceId, name: null }) : undefined,
    clickSelector,
    clickDelayMs,
    targetUrl: url,
  });
  const body = {
    url,
    viewport: { width, height, isMobile: true, hasTouch: true },
    gotoOptions: { waitUntil: "domcontentloaded", timeout: 45000 },
    addScriptTag: [{ content: injector }],
    waitForTimeout: wait,
  };
  const res = await fetch(`${base}/screenshot`, { method: "POST", headers, body: JSON.stringify(body) });
  if (!res.ok) {
    console.error(`screenshot failed for ${out}:`, res.status, (await res.text()).slice(0, 400));
    return;
  }
  fs.writeFileSync(out, Buffer.from(await res.arrayBuffer()));
  console.log(`wrote ${out}`);
}

async function main() {
  const args = parseArgs(process.argv.slice(2));
  const accountId = process.env.CLOUDFLARE_ACCOUNT_ID;
  const apiToken = process.env.CLOUDFLARE_API_TOKEN;
  if (!accountId || !apiToken) {
    console.error("Set CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN (`source .cf-credentials.local`)");
    process.exit(1);
  }
  if (!args.url || !args["session-space"] || !args["session-json"]) {
    console.error("Usage: --url <page> --session-space <id> --session-json <path> [--click <selector>] --out-before <f> [--out-after <f>] [--wait ms]");
    process.exit(1);
  }
  const session = JSON.parse(fs.readFileSync(args["session-json"], "utf8"));
  const base = `https://api.cloudflare.com/client/v4/accounts/${accountId}/browser-rendering`;
  const headers = { authorization: `Bearer ${apiToken}`, "content-type": "application/json" };
  const width = Number(args.width ?? 390);
  const height = Number(args.height ?? 844);
  const wait = Number(args.wait ?? 6000);

  await shoot({
    base, headers, url: args.url, width, height,
    session, sessionSpace: args["session-space"], activeSpaceId: args["active-space-id"],
    wait,
    out: args["out-before"] ?? "mobile-before.png",
  });

  if (args.click) {
    await shoot({
      base, headers, url: args.url, width, height,
      session, sessionSpace: args["session-space"], activeSpaceId: args["active-space-id"],
      clickSelector: args.click,
      clickDelayMs: Number(args["click-delay"] ?? 1500),
      wait: wait + Number(args["click-delay"] ?? 1500) + 1500,
      out: args["out-after"] ?? "mobile-after.png",
    });
  }
}

main().catch((e) => { console.error(e); process.exit(1); });
</file>

<file path="infra/scripts/shell-screenshot.mjs">
#!/usr/bin/env node
// Real E2E visual verification for apps/shell (and any other page), without a local browser.
//
// The sandboxed dev environment's MITM proxy breaks Playwright/Puppeteer's TLS handshake
// (documented in CLAUDE.md item 66's own postmortem) — this sidesteps that entirely by using
// Cloudflare's own Browser Rendering REST API (a real headless Chromium, run by Cloudflare, hit
// over a plain authenticated HTTPS POST — the same transport every other CF API call in this
// project already uses successfully).
//
// To also verify an AUTHENTICATED page: sign up/log in a real end user via the live
// product-end-user API first (POST /v1/spaces/:spaceId/end-users/{signup,login}), then pass the
// resulting session as --session-space/--session-json — this injects it into localStorage under
// the exact key apps/shell/src/lib/productAccount.ts reads (`naelao_product_session:{spaceId}`)
// via the REST API's `addScriptTag`, then navigates back to the requested URL (NOT reload —
// the unauthenticated first load has usually already bounced to /login by then).
//
// Usage:
//   source .cf-credentials.local
//   node infra/scripts/shell-screenshot.mjs --url https://naelao-shell.pages.dev/p/launchpad \
//     [--session-space 457a2b3a-96f1-46f1-8143-00a64f48f03d] [--session-json ./session.json] \
//     [--out screenshot.png] [--width 1280] [--height 900] [--wait 5000]

function parseArgs(argv) {
  const out = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith("--")) {
      out[a.slice(2)] = argv[i + 1];
      i++;
    }
  }
  return out;
}

async function main() {
  const args = parseArgs(process.argv.slice(2));
  const accountId = process.env.CLOUDFLARE_ACCOUNT_ID;
  const apiToken = process.env.CLOUDFLARE_API_TOKEN;
  if (!accountId || !apiToken) {
    console.error("Set CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN (e.g. `source .cf-credentials.local`)");
    process.exit(1);
  }
  if (!args.url) {
    console.error("Usage: node shell-screenshot.mjs --url <page-url> [--session-space <spaceId> --session-json <path>] [--out <file.png>]");
    process.exit(1);
  }

  const body = {
    url: args.url,
    viewport: { width: Number(args.width ?? 1280), height: Number(args.height ?? 900) },
    gotoOptions: { waitUntil: "networkidle0", timeout: 30000 },
    waitForTimeout: Number(args.wait ?? 3000),
  };

  if (args["session-space"] && args["session-json"]) {
    const fs = await import("node:fs");
    const session = JSON.parse(fs.readFileSync(args["session-json"], "utf8"));
    const key = `naelao_product_session:${args["session-space"]}`;
    // Navigate to the target URL explicitly rather than reload(). The first (unauthenticated)
    // load of any shell page redirects to /login, so by the time this script runs the browser is
    // usually no longer ON the requested page — reload() would then re-render /login (which,
    // now authenticated, bounces to Home), silently screenshotting the wrong page.
    const js = `
      localStorage.setItem(${JSON.stringify(key)}, ${JSON.stringify(JSON.stringify(session))});
      setTimeout(function() { window.location.href = ${JSON.stringify(args.url)}; }, 200);
    `;
    body.addScriptTag = [{ content: js }];
    body.waitForTimeout = Number(args.wait ?? 5000); // extra time for the reload + re-mount
  }

  const res = await fetch(
    `https://api.cloudflare.com/client/v4/accounts/${accountId}/browser-rendering/screenshot`,
    {
      method: "POST",
      headers: { Authorization: `Bearer ${apiToken}`, "Content-Type": "application/json" },
      body: JSON.stringify(body),
    }
  );

  if (!res.ok || res.headers.get("content-type") !== "image/png") {
    const text = await res.text();
    console.error(`Screenshot failed (${res.status}): ${text.slice(0, 500)}`);
    process.exit(1);
  }

  const buf = Buffer.from(await res.arrayBuffer());
  const outPath = args.out ?? "screenshot.png";
  const fs = await import("node:fs");
  fs.writeFileSync(outPath, buf);
  console.log(`Wrote ${outPath} (${buf.length} bytes)`);
}

main().catch((err) => {
  console.error(err);
  process.exit(1);
});
</file>

<file path="infra/scripts/start-dev.sh">
#!/usr/bin/env bash
set -euo pipefail

echo "Starting Naelao development environment..."

# Check dependencies
command -v pnpm >/dev/null 2>&1 || { echo "pnpm is required. Install: npm i -g pnpm@9"; exit 1; }
command -v wrangler >/dev/null 2>&1 || { echo "wrangler is required. Install: npm i -g wrangler"; exit 1; }

# Install dependencies if needed
if [ ! -d "node_modules" ]; then
  echo "Installing dependencies..."
  pnpm install
fi

echo "Starting workers in parallel..."
# Use concurrently or simple background processes
(cd workers/auth && wrangler dev --port 8787) &
AUTH_PID=$!

(cd workers/spaces && wrangler dev --port 8788) &
SPACES_PID=$!

(cd workers/router && wrangler dev --port 8080) &
ROUTER_PID=$!

echo "Workers starting:"
echo "  Auth:   http://localhost:8787"
echo "  Spaces: http://localhost:8788"
echo "  Router: http://localhost:8080 (entry point)"

# Wait for all background processes
trap "kill $AUTH_PID $SPACES_PID $ROUTER_PID 2>/dev/null" EXIT INT TERM
wait
</file>

