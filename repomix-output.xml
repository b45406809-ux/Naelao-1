          <h3>The Security Scanner Pipeline (5 Gates)</h3>
          <div class="arch">
            <div class="arch-t">Security Scanner: 5 Gates — All Must Pass</div>
            <div class="ar">
              <div class="ab ab-a">Gate 1: Manifest Schema Validation</div>
              <div class="aa">→</div>
              <div class="ab ab-c">Gate 2: DO Permission Audit</div>
              <div class="aa">→</div>
              <div class="ab ab-d">Gate 3: Network Policy Check</div>
              <div class="aa">→</div>
              <div class="ab ab-e">Gate 4: Data Access Scope Audit</div>
              <div class="aa">→</div>
              <div class="ab ab-a">Gate 5: Wrangler Binding Diff</div>
