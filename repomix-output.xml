  <div class="sec" id="artifacts">
    <span class="sec-ey">18 — Artifacts</span>
    <h2>Artifacts — Dynamic Worker Loader (Claude-Style)</h2>
    <div class="bar"></div>
    <p class="lead">Artifacts are live, interactive outputs the agent creates for the user — HTML pages, React
      components, data charts, document viewers. They use Cloudflare's Dynamic Worker Loader: V8 isolates that start in
      under 5 milliseconds, serve HTTP natively, and scale globally without any container management.</p>

    <h3>Why Dynamic Workers Instead of Containers for Artifacts</h3>
    <p>The core question when implementing artifacts is: why not use the container (SandboxDO) to serve the artifact?
      Three reasons:</p>
    <ol class="nl">
      <li><strong>Speed:</strong> V8 isolates start in &lt;5ms. Containers take 2-3 seconds. For a user clicking a link
        to see an artifact, 5ms vs 3000ms is the difference between "feels instant" and "feels broken".</li>
      <li><strong>Scale:</strong> V8 isolates scale horizontally to millions of concurrent requests automatically.
        Containers are single-tenant by design. An artifact viewed by 10,000 people simultaneously needs V8, not
        containers.</li>
      <li><strong>Cost:</strong> V8 isolates charge only for CPU time. A chart that takes 10ms to render costs 0.0000003
        cents. A container that starts, serves one request, and stops costs 100x more even for the same computation.
      </li>
    </ol>
    <p>The constraint is that artifact code must be TypeScript/JavaScript. This is fine for all the artifact types
      Naelao supports: HTML, React, charts (Recharts/D3), and document viewers (DOCX/PDF → HTML conversion is done by a
      container, but the viewer itself is a V8 isolate).</p>

    <h3>spin_artifact() — Complete Implementation</h3>
    <pre><code><span class="cm">// workers/artifact/index.ts
// The naelao-artifact Worker handles all artifact creation.
// Called by NaelaoAgentDO via Service Binding when agent uses the artifact-builder skill.</span>

export default {
  async fetch(request: Request, env: Env): Promise&lt;Response&gt; {
    const url = new URL(request.url);

    if (url.pathname === '/create' &amp;&amp; request.method === 'POST') {
      return this.createArtifact(request, env);
    }
    if (url.pathname === '/list') {
      return this.listArtifacts(request, env);
    }
    if (url.pathname.startsWith('/delete/')) {
      return this.deleteArtifact(request, env, url.pathname.slice('/delete/'.length));
    }
    return new Response('Not Found', { status: 404 });
  },

  async createArtifact(request: Request, env: Env): Promise&lt;Response&gt; {
    const {
      spaceId,
      name,       <span class="cm">// e.g., 'sales-dashboard', 'q1-report'</span>
      code,       <span class="cm">// TypeScript/HTML code to run as the artifact</span>
      type,       <span class="cm">// 'html' | 'react' | 'chart' | 'document-viewer'</span>
      agentId,
      description
    } = await request.json();

    <span class="cm">// Step 1: Validate artifact name</span>
    if (!/^[a-z0-9-]+$/.test(name)) {
      return Response.json({
        error: 'Artifact name must be lowercase alphanumeric with hyphens only'
      }, { status: 400 });
    }

    <span class="cm">// Step 2: Security scan the code BEFORE writing to R2 or loading
    // This is the most important step — never skip it</span>
    const scanResult = await scanArtifactCode(code, env);
    if (!scanResult.safe) {
      return Response.json({
        error: `Artifact code rejected by security scanner: ${scanResult.reason}`,
        category: scanResult.category
      }, { status: 400 });
    }

    <span class="cm">// Step 3: Store source in R2 (permanent source-of-record)</span>
    const timestamp = Date.now();
    const artifactKey = `spaces/${spaceId}/artifacts/${name}/v${timestamp}/source.ts`;
    const metaKey = `spaces/${spaceId}/artifacts/${name}/meta.json`;

    await env.NAELAO_ASSETS.put(artifactKey, code, {
      customMetadata: {
        type, agentId, description, createdAt: timestamp.toString()
      }
    });

    <span class="cm">// Update metadata (points to latest version)</span>
    await env.NAELAO_ASSETS.put(metaKey, JSON.stringify({
      name, type, description, spaceId, agentId,
      latestVersion: timestamp,
      createdAt: timestamp,
      updatedAt: timestamp
    }));

    <span class="cm">// Step 4: Load into Dynamic Worker Loader
    // This is what creates the live preview URL</span>
    const artifactCode = this.wrapArtifactCode(code, type, name, spaceId);

    const loaderDO = env.NAELAO_DW_LOADER.get(
      env.NAELAO_DW_LOADER.idFromName(`artifact-loader:${spaceId}`)
    );

    const loadResult = await loaderDO.fetch(new Request('http://loader/load', {
      method: 'POST',
      body: JSON.stringify({
        name: `artifact-${spaceId.slice(0, 8)}-${name}`,
        code: artifactCode,
        bindings: {}  <span class="cm">// artifacts get no bindings — they are sandboxed</span>
      })
    }));

    const { previewUrl } = await loadResult.json() as { previewUrl: string };

    <span class="cm">// Step 5: Store preview URL in KV for quick retrieval</span>
    await env.NAELAO_CONFIG_KV.put(
      `artifact-url:${spaceId}:${name}`,
      previewUrl,
      { expirationTtl: 24 * 60 * 60 } <span class="cm">// URL cached for 24h, then regenerated on access</span>
    );

    return Response.json({
      success: true,
      artifactId: name,
      previewUrl,
      sourceKey: artifactKey,
      version: timestamp
    });
  },

  <span class="cm">// Wraps user-provided code in a safe serving harness
  // The harness adds: Content-Type headers, CORS, error boundary, etc.</span>
  wrapArtifactCode(code: string, type: string, name: string, spaceId: string): string {
    if (type === 'html') {
      <span class="cm">// For HTML artifacts: the code IS the HTML, serve it directly</span>
      return `
export default {
  fetch() {
    const html = \`${code.replace(/`/g, '\\`')}\`;
    return new Response(html, {
      headers: {
        'Content-Type': 'text/html; charset=utf-8',
        'X-Frame-Options': 'SAMEORIGIN',   // only allow in Naelao iframe
        'Content-Security-Policy': "default-src 'self' 'unsafe-inline'; img-src * data:;"
      }
    });
  }
}`;
    }

    if (type === 'react') {
      <span class="cm">// For React artifacts: wrap in a minimal React app serving harness</span>
      return `
import { renderToString } from 'react-dom/server';
${code}

export default {
  fetch(request) {
    const html = renderToString(&lt;App /&gt;);
    const fullHtml = \`&lt;!DOCTYPE html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset="UTF-8"&gt;&lt;/head&gt;&lt;body&gt;\${html}&lt;/body&gt;&lt;/html&gt;\`;
    return new Response(fullHtml, {
      headers: { 'Content-Type': 'text/html; charset=utf-8' }
    });
  }
}`;
    }

    <span class="cm">// Default: assume code exports a fetch handler directly</span>
    return code;
  }
};

<span class="cm">// Artifact-specific security scan — stricter than skill scanner
// Artifacts run in user's browser context — higher risk than background skills</span>
async function scanArtifactCode(
  code: string,
  env: Env
): Promise&lt;{ safe: boolean; reason?: string; category?: string }&gt; {
  const ARTIFACT_BLOCKED_PATTERNS = [
    { pattern: /localStorage/g,           description: 'localStorage access (data persistence)' },
    { pattern: /sessionStorage/g,         description: 'sessionStorage access' },
    { pattern: /document\.cookie/g,       description: 'Cookie access' },
    { pattern: /window\.opener/g,         description: 'window.opener (tab hijacking)' },
    { pattern: /window\.parent/g,         description: 'window.parent (iframe escaping)' },
    { pattern: /top\.location/g,          description: 'Frame busting attempt' },
    { pattern: /\bfetch\s*\(\s*['"][^'"]+naelao/g, description: 'Naelao API call from artifact (not allowed)' },
    ...BLOCKED_PATTERNS <span class="cm">// all 27 skill patterns plus the artifact-specific ones above</span>
  ];

  for (const check of ARTIFACT_BLOCKED_PATTERNS) {
    if (check.pattern.test(code)) {
      check.pattern.lastIndex = 0;
      return { safe: false, reason: check.description, category: 'artifact-security' };
    }
    check.pattern.lastIndex = 0;
  }

  return { safe: true };
}</code></pre>

