async preWarmIfNeeded() {
  const idleSlot = this.pool.find(s =&gt; s.status === 'idle');
  if (idleSlot) return; // already warm
  if (this.pool.length &gt;= this.maxContainers) return; // pool full

  // Pre-warm the most common container type for this assistant
  const mostUsed = await this.getMostUsedContainerType();
  const slot = await this.createContainer(mostUsed);
  slot.status = 'idle';
  this.pool.push(slot);
  console.log(`Pre-warmed ${mostUsed} container for ${this.agentId}`);
}
```
